{
  "_note": "加卡入口 —— 整页(或本页)只此一个按钮,§8.1a。由 tools/infosource/mk_addbtn.py 生成,别手改:这个按钮要在所有信息源里长得一样。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#1F128F66|#296FE8BE",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "id": "plus",
        "type": "txt",
        "x": "16pt",
        "y": "0pt",
        "w": "-1",
        "h": "{parent.h}",
        "alignmentV": "1",
        "maxLines": "1",
        "text": "＋",
        "fontSize": "19pt",
        "typeface": "System-Bold",
        "textColor": "#128F66|#6FE8BE"
      },
      {
        "id": "t",
        "type": "txt",
        "x": "{plus.r}+10pt",
        "y": "15pt",
        "w": "{parent.w}-{plus.r}-26pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.addBtnT}",
        "fontSize": "13.5pt",
        "typeface": "System-Bold",
        "textColor": "#128F66|#6FE8BE"
      },
      {
        "id": "s",
        "type": "txt",
        "x": "{plus.r}+10pt",
        "y": "{t.b}+2pt",
        "w": "{parent.w}-{plus.r}-26pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.addBtnS}",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B"
      }
    ],
    "i18n": {
      "zh-CN": {
        "addBtnT": "添加组件",
        "addBtnS": "在面板里挑，确认后加到仪表盘"
      },
      "en-US": {
        "addBtnT": "Add widgets",
        "addBtnS": "Pick in the panel, then confirm"
      }
    }
  }
}
