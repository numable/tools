{
  "version": 2,
  "title": "今天 · 小",
  "sub": "今天记了没有",
  "i18n": {
    "en-US": {
      "title": "Today · tiny",
      "sub": "Logged today or not"
    }
  },
  "layout": 11,
  "params": {},
  "ai": {
    "shows": "服药记录今天的状态（已记/未服/待记/休息）与周期第几天（一格小组件）"
  },
  "events": {
    "onClick": "@[file://flow/mark-today.af]"
  },
  "_note_jobs": "同 today / mini:长按 →「添加提醒」→ xJob/dose.xjob,参数全由用户在同意面板里填。",
  "jobs": [
    {
      "id": "dose",
      "params": {}
    }
  ],
  "canvas": {
    "source": "@[file://rc/today11.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/w.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "_noteEvents": "同 today:整卡点击 → mark-today.af(没记就记下并留撤销,记过了才打开包)。"
}
