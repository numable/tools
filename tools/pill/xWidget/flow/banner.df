{"version":1,"_note":"信息源页海报专用(tools/banner/dyn_personal.py 生成,不要手改),组件不用。","actions":[{"id":"start","action":"data.get","params":{"key":"start","default":""}},{"id":"active","action":"data.get","params":{"key":"active","default":21}},{"id":"rest","action":"data.get","params":{"key":"rest","default":7}},{"id":"taken","action":"data.get","params":{"key":"taken","default":"_"}},{"id":"skipped","action":"data.get","params":{"key":"skipped","default":"_"}},{"op":"set","props":{"key":"_b","value":"1"},"_note":"⚠️ 请求屏障(勿删):request 之后紧邻的节点读不到响应(晚一拍合并)。"},{"op":"set","props":{"key":"s0","value":"${start}"}},{"op":"set","props":{"key":"hasPlan","value":"$[if::(gt::(length::(${s0}),0),1,0)]"}},{"op":"set","props":{"key":"sd","value":"$[findNotEmpty::(${s0},2026-01-01)]"}},{"op":"set","props":{"key":"cycle","value":"$[calc::(${active}+${rest})]"}},{"op":"set","props":{"key":"startMs","value":"$[parseDate::(${sd},yyyy-MM-dd)]"}},{"op":"set","props":{"key":"todayStr","value":"$[formatDate::(${@time.nowMs},yyyy-MM-dd)]"}},{"op":"set","props":{"key":"todayMs","value":"$[parseDate::(${todayStr},yyyy-MM-dd)]"}},{"op":"set","props":{"key":"offset","value":"$[round::(calc::((${todayMs}-${startMs})/86400000))]"}},{"op":"set","props":{"key":"curPack","value":"$[if::(lt::(${offset},0),0,floor::(calc::(${offset}/${cycle})))]"}},{"op":"set","props":{"key":"baseOff","value":"$[calc::(${curPack}*${cycle})]"}},{"op":"set","props":{"key":"baseMs","value":"$[calc::(${startMs}+${baseOff}*86400000+43200000)]"},"_note":"正午锚点(同 w.df)。"},{"op":"set","props":{"key":"todayIdx","value":"$[round::(calc::(${offset}-${baseOff}))]"}},{"op":"set","props":{"key":"todayNo","value":"$[round::(calc::(${todayIdx}+1))]"}},{"op":"set","props":{"key":"future","value":"$[if::(lt::(${offset},0),1,0)]"}},{"op":"set","props":{"key":"emp","value":"$[if::(eq::(${hasPlan},1),0,1)]"},"_note":"没设过计划 → 空态:按默认方案(21+7)画一圈全未到的环,不标今天(2026-10-08 改判,原为退回静态图)。"},{"op":"set","props":{"key":"todayIdx","value":"$[if::(eq::(${hasPlan},1),${todayIdx},-1)]"},"_note":"空态下没有「今天」:−1 让每段都落在「还没到 / 停药期」。"},{"op":"set","props":{"key":"tag","value":"$[connect::(_,${todayStr},_)]"}},{"op":"set","props":{"key":"tState","value":"$[if::(contains::(${taken},${tag}),1,if::(contains::(${skipped},${tag}),2,0))]"}},{"op":"set","props":{"key":"isRest","value":"$[if::(lt::(${offset},0),0,if::(lt::(${todayIdx},${active}),0,1))]"}},{"op":"set","props":{"key":"stKind","value":"$[if::(eq::(${tState},1),1,if::(eq::(${tState},2),2,if::(eq::(${isRest},1),4,3)))]"},"_note":"1 已服 / 2 记为未服 / 3 还没记 / 4 停药期(照 w.df 的 stKind,计划未开始的那一态海报不画)。"},{"op":"set","props":{"key":"toRest","value":"$[round::(calc::(${active}-${todayIdx}))]"}},{"op":"set","props":{"key":"toNew","value":"$[round::(calc::(${cycle}-${todayIdx}))]"}},{"op":"set","props":{"key":"pkind","value":"$[if::(eq::(${isRest},1),3,if::(gt::(${rest},0),1,2))]"},"_note":"1 = N 天后进入停药期 · 2 = N 天后开新盒(rest=0 的连续方案)· 3 = 停药期里,N 天后开新盒(照 w.df)。"},{"op":"set","props":{"key":"nDays","value":"$[if::(eq::(${pkind},1),${toRest},${toNew})]"}},{"op":"set","props":{"key":"ringOk","value":"$[if::(le::(${cycle},42),1,0)]"}},{"op":"set","props":{"key":"ok","value":"$[if::(and::(eq::(${hasPlan},1),eq::(${future},0)),1,0)]"},"_note":"没设过计划 / 起始日在未来 → 静态图(合法空态)。"},{"op":"set","props":{"key":"RO","value":["258.0 65.0","258.8 65.0","259.6 65.0","260.5 65.1","261.3 65.1","262.1 65.2","262.9 65.3","263.7 65.4","264.5 65.5","265.4 65.6","266.2 65.7","267.0 65.9","267.8 66.0","268.6 66.2","269.4 66.4","270.2 66.6","271.0 66.8","271.7 67.1","272.5 67.3","273.3 67.6","274.1 67.8","274.8 68.1","275.6 68.4","276.4 68.7","277.1 69.1","277.9 69.4","278.6 69.8","279.3 70.1","280.1 70.5","280.8 70.9","281.5 71.3","282.2 71.7","282.9 72.1","283.6 72.6","284.3 73.0","285.0 73.5","285.6 74.0","286.3 74.5","286.9 75.0","287.6 75.5","288.2 76.0","288.8 76.5","289.4 77.1","290.1 77.6","290.6 78.2","291.2 78.8","291.8 79.4","292.4 79.9","292.9 80.6","293.5 81.2","294.0 81.8","294.5 82.4","295.0 83.1","295.5 83.7","29