        "value": "$[calc::(${e3_0}+${e3_1}+${e3_2}+${e3_3}+${e3_4}+${e3_5}+${e3_6}+${e3_7}+${e3_8}+${e3_9}+${e3_10}+${e3_11}+${e3_12}+${e3_13}+${e3_14}+${e3_15}+${e3_16}+${e3_17}+${e3_18}+${e3_19}+${e3_20}+${e3_21}+${e3_22}+${e3_23}+${e3_24}+${e3_25}+${e3_26}+${e3_27})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ok3",
        "value": "$[if::(eq::(${hasPlan},1),if::(ge::(calc::(${curPack}-3),0),if::(gt::(${E3},0),1,0),0),0)]"
      },
      "_note": "这一盒存在(计划已开始且不早于起始日)且有应记天数才出。"
    },
    {
      "op": "set",
      "props": {
        "key": "r3",
        "value": "$[if::(eq::(${ok3},1),round::(calc::(${T3}*100/${E3})),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "x3",
        "value": "$[parseNumber::(max::(calc::(3+findNotEmpty::(${r3},0)/100*144.0),3),0.0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "sw",
        "value": "$[parseNumber::(calc::(findNotEmpty::(${r0},0)*3.6),0.0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "at",
        "value": "$[formatDate::(${@time.nowMs},MM-dd)]"
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "hasPlan",
          "curPack",
          "T0",
          "S0",
          "E0",
          "ok0",
          "r0",
          "x0",
          "T1",
          "S1",
          "E1",
          "ok1",
          "r1",
          "x1",
          "T2",
          "S2",
          "E2",
          "ok2",
          "r2",
          "x2",
          "T3",
          "S3",
          "E3",
          "ok3",
          "r3",
          "x3",
          "sw",
          "at"
        ]
      }
    }
  ]
}
