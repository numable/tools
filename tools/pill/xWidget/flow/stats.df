{
  "_note": "记录率(stats 卡)。本盒 + 前三盒服药期里「已服用」的天数占比。生成器 gen_pill_stats.py。",
  "version": 1,
  "actions": [
    {
      "id": "start",
      "action": "data.get",
      "params": {
        "key": "start",
        "default": ""
      }
    },
    {
      "id": "active",
      "action": "data.get",
      "params": {
        "key": "active",
        "default": 21
      }
    },
    {
      "id": "rest",
      "action": "data.get",
      "params": {
        "key": "rest",
        "default": 7
      }
    },
    {
      "id": "taken",
      "action": "data.get",
      "params": {
        "key": "taken",
        "default": "_"
      }
    },
    {
      "id": "skipped",
      "action": "data.get",
      "params": {
        "key": "skipped",
        "default": "_"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_b",
        "value": "1"
      },
      "_note": "⚠️ 请求/并发屏障(勿删):request 与 concurrent 之后**紧邻**的节点读不到响应(晚一拍合并,memory [[actionflow-concurrent-late-merge]])。删掉它 → 下面所有 index:: 静默取空 → 卡渲一片 `--`,而流仍报 success。"
    },
    {
      "op": "set",
      "props": {
        "key": "s0",
        "value": "${start}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hasPlan",
        "value": "$[if::(gt::(length::(${s0}),0),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "sd",
        "value": "$[findNotEmpty::(${s0},2026-01-01)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cycle",
        "value": "$[calc::(${active}+${rest})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "startMs",
        "value": "$[parseDate::(${sd},yyyy-MM-dd)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "todayMs",
        "value": "$[parseDate::(formatDate::(${@time.nowMs},yyyy-MM-dd),yyyy-MM-dd)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "offset",
        "value": "$[round::(calc::((${todayMs}-${startMs})/86400000))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "curPack",
        "value": "$[if::(lt::(${offset},0),-1,floor::(calc::(${offset}/${cycle})))]"
      },
      "_note": "与 w.df 同式;计划还没开始 = -1(本卡整张走「没有数据」)。"
    },
    {
      "op": "set",
      "props": {
        "key": "todayIdx",
        "value": "$[calc::(${offset}-max::(${curPack},0)*${cycle})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tk",
        "value": "${taken}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "sk",
        "value": "${skipped}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pb0",
        "value": "$[calc::((calc::(${curPack}-0))*${cycle})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lim0",
        "value": "$[if::(eq::(0,0),min::(calc::(${todayIdx}+1),${active}),${active})]"
      },
      "_note": "本盒只数到今天(含);往期整段服药期。"
    },
    {
      "op": "set",
      "props": {
        "key": "e0_0",
        "value": "$[if::(lt::(0,${lim0}),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "g0_0",
        "value": "$[connect::(_,formatDate::(calc::(${startMs}+(${pb0}+0)*86400000+43200000),yyyy-MM-dd),_)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t0_0",
        "value": "$[if::(eq::(${e0_0},1),if::(contains::(${tk},${g0_0}),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0_0",
        "value": "$[if::(eq::(${e0_0},1),if::(contains::(${sk},${g0_0}),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "e0_1",
        "value": "$[if::(lt::(1,${lim0}),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "g0_1",
        "value": "$[connect::(_,formatDate::(calc::(${startMs}+(${pb0}+1)*86400000+43200000),yyyy-MM-dd),_)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t0_1",
        "value": "$[if::(eq::(${e0_1},1),if::(contains::(${tk},${g0_1}),1,0),0)]"
      }
    },
