{
  "_note": "记录率(42,v33 新增)。整卡点击与另外三张同一个 mark-today.af(没记就记,记过了进包)。",
  "version": 2,
  "title": "记录率",
  "sub": "本盒与前三盒各记了几成",
  "i18n": {
    "en-US": {
      "title": "Log rate",
      "sub": "How complete this pack and the last three are"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "服药记录本盒与前三盒各自的记录率，以及已记几天、共几天"
  },
  "events": {
    "onClick": "@[file://flow/mark-today.af]"
  },
  "jobs": [
    {
      "id": "dose",
      "params": {}
    }
  ],
  "canvas": {
    "source": "@[file://rc/stats.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/stats.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  }
}
