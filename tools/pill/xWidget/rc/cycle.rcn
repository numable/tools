              "leftB": "5pt",
              "rightT": "5pt",
              "rightB": "5pt"
            }
          },
          {
            "type": "txt",
            "x": "182pt",
            "y": "40pt",
            "w": "{parent.w}-198pt",
            "h": "84pt",
            "text": "${@i18n.needSetup}",
            "fontSize": "15pt",
            "textColor": "#0E1116|#F3F4F6",
            "alignmentV": "1",
            "maxLines": "3"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "${hasPlan}"
        },
        "react": [
          {
            "type": "op",
            "action": "for",
            "props": {
              "count": "${cycle}",
              "index": "_i"
            },
            "react": [
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_row",
                  "value": "$[floor::(calc::(${_i}/7))]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_col",
                  "value": "$[calc::(${_i}-${_row}*7)]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_x",
                  "value": "$[calc::(16+${_col}*22)]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_y",
                  "value": "$[calc::(40+${_row}*22)]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_ms",
                  "value": "$[calc::(${baseMs}+${_i}*86400000)]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_d",
                  "value": "$[formatDate::(${_ms},yyyy-MM-dd)]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_tag",
                  "value": "$[connect::(_,${_d},_)]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_isT",
                  "value": "$[if::(contains::(${taken},${_tag}),1,0)]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_isS",
                  "value": "$[if::(contains::(${skipped},${_tag}),1,0)]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_un",
                  "value": "$[if::(eq::(calc::(${_isT}+${_isS}),0),1,0)]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_isB",
                  "value": "$[if::(ge::(${_i},${active}),1,0)]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_unA",
                  "value": "$[calc::(${_un}*(1-${_isB}))]"
                }
              },
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_unB",
                  "value": "$[calc::(${_un}*${_isB})]"
                }
              },
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "${_isT}"
                },
                "react": [
                  {
                    "type": "layer",
                    "x": "${_x}pt",
                    "y": "${_y}pt",
                    "w": "18pt",
                    "h": "18pt",
                    "bgColor": "#128F66|#6FE8BE",
                    "cornerRadius": {
                      "leftT": "5pt",
                      "leftB": "5pt",
                      "rightT": "5pt",
                      "rightB": "5pt"
                    }
                  }
                ]
              },
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "${_isS}"
                },
                "react": [
                  {
                    "type": "layer",
                    "x": "${_x}pt",
                    "y": "${_y}pt",
                    "w": "18pt",
                    "h": "18pt",
                    "bgColor": "#6B7280|#5A5C63",
                    "cornerRadius": {
                      "leftT": "5pt",
                      "leftB": "5pt",
                      "rightT": "5pt",
                      "rightB": "5pt"
                    }
                  }
                ]
              },
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "${_unA}"
                },
                "react": [
                  {
                    "type": "layer",
                    "x": "${_x}pt",
                    "y": "${_y}pt",
                    "w": "18pt",
                    "h": "18pt",
                    "bgColor": "#F5F6F8|#1B1D22",
                    "cornerRadius": {
                      "leftT": "5pt",
                      "leftB": "5pt",
                      "rightT": "5pt",
                      "rightB": "5pt"
                    }
                  }
                ]
              },
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "${_unB}"
                },
                "react": [
                  {
                    "type": "layer",
                    "x": "${_x}pt",
                    "y": "${_y}pt",
                    "w": "18pt",
                    "h": "18pt",
                    "bgColor": "#00FFFFFF|#00000000",
                    "cornerRadius": {
                      "leftT": "5pt",
                      "leftB": "5pt",
                      "rightT": "5pt",
                      "rightB": "5pt"
                    },
                    "borderColor": "#B7BEC8|#4A525C",
                    "borderWidth": "1pt"
                  }
                ]
              },
              {
                "_note": "今天:外扩 2pt 的圈。x 最小 16-2=14,不会被裁。",
                "type": "op",
                "action": "if",
                "props": {
                  "val": "$[if::(eq::(${_i},${todayIdx}),1,0)]"
                },
                "react": [
                  {
                    "_note": "外扩圈的 x/y 先落地(G32):尺寸串里的 $[方法] 一旦求空就是裸 \"pt\",StaticCanvas 整卡布局失败。",
                    "type": "op",
                    "action": "set",
                    "props": {
                      "key": "_ox",
                      "value": "$[findNotEmpty::(calc::(${_x}-2),${_x})]"
                    }
                  },
                  {
                    "type": "op",
                    "action": "set",
                    "props": {
                      "key": "_oy",
                      "value": "$[findNotEmpty::(calc::(${_y}-2),${_y})]"
                    }
                  },
                  {
                    "type": "layer",
                    "x": "${_ox}pt",
                    "y": "${_oy}pt",
                    "w": "22pt",
                    "h": "22pt",
                    "bgColor": "#00000000|#00000000",
                    "cornerRadius": {
                      "leftT": "7pt",
                      "leftB": "7pt",
                      "rightT": "7pt",
                      "rightB": "7pt"
                    },
                    "borderColor": "#128F66|#6FE8BE",
                    "borderWidth": "2pt"
                  }
                ]
              }
            ]
          },
          {
            "_note": "右侧文字块全用 {parent.w} 锚点,不对卡宽做假设。",
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[eq::(${stKind},1)]"
            },
            "react": [
              {
                "type": "txt",
                "x": "182pt",
                "y": "42pt",
                "w": "{parent.w}-198pt",
                "h": "-1",
                "text": "${@i18n.stTaken}",
                "fontSize": "15pt",
                "typeface": "System-Bold",
                "textColor": "#128F66|#6FE8BE",
                "maxLines": "2"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[eq::(${stKind},2)]"
            },
            "react": [
              {
                "type": "txt",
                "x": "182pt",
                "y": "42pt",
                "w": "{parent.w}-198pt",
                "h": "-1",
                "text": "${@i18n.stSkipped}",
                "fontSize": "15pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#A0A2A8",
                "maxLines": "2"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[eq::(${stKind},3)]"
            },
            "react": [
              {
                "type": "txt",
                "x": "182pt",
                "y": "42pt",
                "w": "{parent.w}-198pt",
                "h": "-1",
                "text": "${@i18n.stNone}",
                "fontSize": "15pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6",
                "maxLines": "2"
              }
            ]
          },
          {
            "_note": "④ 还没记 · 停药期。以前这一天和「忘了记」共用同一句「今天还没记」,\n而停药日占了整个周期的四分之一。判据 stKind 由 flow/w.df 统一算(三张卡同一份)。",
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[eq::(${stKind},4)]"
            },
            "react": [
              {
                "type": "txt",
                "x": "182pt",
                "y": "42pt",
                "w": "{parent.w}-198pt",
                "h": "-1",
                "text": "${@i18n.stRest}",
                "fontSize": "15pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#A0A2A8",
                "maxLines": "1"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[eq::(${future},0)]"
            },
            "react": [
              {
                "type": "txt",
                "x": "182pt",
                "y": "76pt",
                "w": "{parent.w}-198pt",
                "h": "-1",
                "text": "$[connect::(${@i18n.dayPre},${todayNo},${@i18n.dayPost})]",
                "fontSize": "11pt",
                "textColor": "#6B7280|#8E939B",
                "maxLines": "1"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "${future}"
            },
            "react": [
              {
                "type": "txt",
                "x": "182pt",
                "y": "76pt",
                "w": "{parent.w}-198pt",
                "h": "-1",
                "text": "${@i18n.notStarted}",
                "fontSize": "11pt",
                "textColor": "#6B7280|#8E939B",
                "maxLines": "1"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[eq::(${pkind},1)]"
            },
            "react": [
              {
                "id": "nx1",
                "type": "txt",
                "x": "182pt",
                "y": "94pt",
                "w": "{parent.w}-198pt",
                "h": "-1",
                "text": "${@i18n.phA}$[findNotEmpty::(${nDays},--)]${@i18n.nxBreak}",
                "fontSize": "10.5pt",
                "textColor": "#6B7280|#8E939B",
                "maxLines": "1"
              }
            ],
            "_note": "「我在周期的哪儿 · 下一个转折点什么时候到」(2026-09-09 加)——这是本包唯一真正的问题,而整盒点阵只画得出「哪几天记了」。\n⚠️ 上一行 `第 N 天 · 09-09` 是**日期锚**(标准 §4.4),原样不动;腾位靠把两行图例整体下移 10pt(104/122 → 114/132),卡底仍余 15pt。\n⚠️ 一行不是两行:右列净宽 `{parent.w}-198pt`(338 档 = 140pt),en 最长的一句 `Pills · 14 d to new pack` 在 10.5pt 下约 130pt —— 再大一档就要被截。\n⚠️ 三档由 flow 的 `pkind` 单一判据切(含 rest=0 的连续方案那一支),RCN 这边不再用布尔乘法拼一遍。"
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[eq::(${pkind},2)]"
            },
            "react": [
              {
                "id": "nx2",
                "type": "txt",
                "x": "182pt",
                "y": "94pt",
                "w": "{parent.w}-198pt",
                "h": "-1",
                "text": "${@i18n.phA}$[findNotEmpty::(${nDays},--)]${@i18n.nxPack}",
                "fontSize": "10.5pt",
                "textColor": "#6B7280|#8E939B",
                "maxLines": "1"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[eq::(${pkind},3)]"
            },
            "react": [
              {
                "id": "nx3",
                "type": "txt",
                "x": "182pt",
                "y": "94pt",
                "w": "{parent.w}-198pt",
                "h": "-1",
                "text": "${@i18n.phR}$[findNotEmpty::(${nDays},--)]${@i18n.nxPack}",
                "fontSize": "10.5pt",
                "textColor": "#6B7280|#8E939B",
                "maxLines": "1"
              }
            ]
          },
          {
            "_note": "微型图例:小卡上没有解释文字的空间,但「灰=记了没吃」和「淡=还没记」的区别\n是这张卡全部的信息量,不能只靠颜色自证。",
            "type": "layer",
            "x": "182pt",
            "y": "114pt",
            "w": "10pt",
            "h": "10pt",
            "bgColor": "#128F66|#6FE8BE",
            "cornerRadius": {
              "leftT": "3pt",
              "leftB": "3pt",
              "rightT": "3pt",
              "rightB": "3pt"
            }
          },
          {
            "type": "txt",
            "x": "197pt",
            "y": "113pt",
            "w": "{parent.w}-213pt",
            "h": "-1",
            "text": "${@i18n.lgTaken}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          },
          {
            "type": "layer",
            "x": "182pt",
            "y": "132pt",
            "w": "10pt",
            "h": "10pt",
            "bgColor": "#6B7280|#5A5C63",
            "cornerRadius": {
              "leftT": "3pt",
              "leftB": "3pt",
              "rightT": "3pt",
              "rightB": "3pt"
            }
          },
          {
            "type": "txt",
            "x": "197pt",
            "y": "131pt",
            "w": "{parent.w}-213pt",
            "h": "-1",
            "text": "${@i18n.lgSkipped}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      }
    ],
    "i18n": {
