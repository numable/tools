{
  "version": 2,
  "title": "本盒余量 · 小",
  "sub": "这一盒还剩几片 · 几天后停药",
  "i18n": {
    "en-US": {
      "title": "Pack left · tiny",
      "sub": "Pills left in this pack · days to the break"
    }
  },
  "layout": 11,
  "params": {},
  "ai": {
    "shows": "服药记录本盒还剩几片与已用比例细轨,几天后停药或开新盒;停药期显示停药第几天(一格小组件)"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/pack11.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/w.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "_note": "2026-10-08 新增。只读组件:点开首页看整盒点阵(不走 mark-today.af —— 这张不回答「今天记了没」,点它记一笔会是意外)。"
}
