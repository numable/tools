{
  "_note": "首页的「添加组件」:四个单城市组件默认用「我的城市」第一个(列表最上面那一行),加好后长按可换城市;\n「我的城市」两个组件不带参数,跟随整份列表。\n⚠️ 候选先结构化 op:set 落成数组,再整体交给 widget.pick(§8.1a 纪律 1)。",
  "version": 1,
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "id": "saved",
      "action": "data.get",
      "params": {
        "key": "cities",
        "default": []
      }
    },
    {
      "_note": "屏障(勿删):request / data.get 之后紧邻的节点读不到结果(晚一拍),隔一个空 set 再用。",
      "op": "set",
      "props": {
        "key": "_b",
        "value": "1"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "c0",
        "value": "$[index::(${saved},0)]"
      }
    },
    {
      "_note": "屏障(勿删):request / data.get 之后紧邻的节点读不到结果(晚一拍),隔一个空 set 再用。",
      "op": "set",
      "props": {
        "key": "_b2",
        "value": "1"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lat",
        "value": "${c0.lat}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lon",
        "value": "${c0.lon}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "city",
        "value": "${c0.name}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "picks",
        "value": [
          {
            "id": "now",
            "params": {
              "lat": "${lat}",
              "lon": "${lon}",
              "city": "${city}"
            }
          },
          {
            "id": "parts",
            "params": {
              "lat": "${lat}",
              "lon": "${lon}",
              "city": "${city}"
            }
          },
          {
            "id": "trend",
            "params": {
              "lat": "${lat}",
              "lon": "${lon}",
              "city": "${city}"
            }
          },
          {
            "id": "outlook",
            "params": {
              "lat": "${lat}",
              "lon": "${lon}",
              "city": "${city}"
            }
          },
          {
            "id": "cities"
          },
          {
            "id": "cities6"
          }
        ]
      }
    },
    {
      "action": "widget.pick",
      "params": {
        "items": "${picks}"
      }
    }
  ]
}
