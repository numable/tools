{
  "_note": "管理页(H5)的标准切换:写 data.aqStd → 刷新本包全部组件。首页由 open-city.af 在关页后软重载。",
  "version": 1,
  "actions": [
    {
      "_note": "入参先落地:方法参数里的 ${} 看不见 flow 入参(§9.5 #3)。",
      "op": "set",
      "props": {
        "key": "sIn",
        "value": "${s}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "sv",
        "value": "$[if::(eq::(${sIn},us),us,cn)]"
      }
    },
    {
      "action": "data.set",
      "params": {
        "key": "aqStd",
        "value": "${sv}"
      }
    },
    {
      "action": "widget.refresh",
      "params": {
        "scope": "bundle"
      }
    }
  ]
}
