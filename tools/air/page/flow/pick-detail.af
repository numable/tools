{
  "_note": "详情页的「添加这个城市的组件」。",
  "version": 1,
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "op": "set",
      "props": {
        "key": "lat",
        "value": "${lat}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lon",
        "value": "${lon}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "city",
        "value": "${city}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "picks",
        "value": [
          {
            "id": "now",
            "params": {
              "lat": "${lat}",
              "lon": "${lon}",
              "city": "${city}"
            }
          },
          {
            "id": "parts",
            "params": {
              "lat": "${lat}",
              "lon": "${lon}",
              "city": "${city}"
            }
          },
          {
            "id": "trend",
            "params": {
              "lat": "${lat}",
              "lon": "${lon}",
              "city": "${city}"
            }
          },
          {
            "id": "outlook",
            "params": {
              "lat": "${lat}",
              "lon": "${lon}",
              "city": "${city}"
            }
          }
        ]
      }
    },
    {
      "action": "widget.pick",
      "params": {
        "items": "${picks}"
      }
    }
  ]
}
