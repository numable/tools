{
  "_note": "引导屏的常用城市:点一下直接成为「我的城市」第一个(此刻列表为空,所以直接写一个单元素数组)。\n城市坐标放在文案表里:中文环境给国内城市,英文环境给国际城市。",
  "version": 1,
  "i18n": {
    "zh-CN": {
      "n1": "北京",
      "a1": "39.9042",
      "o1": "116.4074",
      "n2": "上海",
      "a2": "31.2222",
      "o2": "121.4581",
      "n3": "广州",
      "a3": "23.1291",
      "o3": "113.2644",
      "n4": "成都",
      "a4": "30.5728",
      "o4": "104.0668",
      "n5": "西安",
      "a5": "34.3416",
      "o5": "108.9398",
      "n6": "香港",
      "a6": "22.3193",
      "o6": "114.1694",
      "loading": "正在获取空气数据…"
    },
    "en-US": {
      "n1": "New York",
      "a1": "40.7128",
      "o1": "-74.0060",
      "n2": "London",
      "a2": "51.5074",
      "o2": "-0.1278",
      "n3": "Delhi",
      "a3": "28.6139",
      "o3": "77.2090",
      "n4": "Tokyo",
      "a4": "35.6762",
      "o4": "139.6503",
      "n5": "Paris",
      "a5": "48.8566",
      "o5": "2.3522",
      "n6": "Los Angeles",
      "a6": "34.0522",
      "o6": "-118.2437",
      "loading": "Getting air quality…"
    }
  },
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "op": "set",
      "props": {
        "key": "ki",
        "value": "$[parseNumber::(${k},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "name",
        "value": "$[if::(eq::(${ki},1),${@i18n.n1},if::(eq::(${ki},2),${@i18n.n2},if::(eq::(${ki},3),${@i18n.n3},if::(eq::(${ki},4),${@i18n.n4},if::(eq::(${ki},5),${@i18n.n5},${@i18n.n6})))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lat",
        "value": "$[if::(eq::(${ki},1),${@i18n.a1},if::(eq::(${ki},2),${@i18n.a2},if::(eq::(${ki},3),${@i18n.a3},if::(eq::(${ki},4),${@i18n.a4},if::(eq::(${ki},5),${@i18n.a5},${@i18n.a6})))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lon",
        "value": "$[if::(eq::(${ki},1),${@i18n.o1},if::(eq::(${ki},2),${@i18n.o2},if::(eq::(${ki},3),${@i18n.o3},if::(eq::(${ki},4),${@i18n.o4},if::(eq::(${ki},5),${@i18n.o5},${@i18n.o6})))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "okLat",
        "value": "$[length::(${lat})]"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "$[gt::(${okLat},0)]"
      },
      "items": [
        {
          "op": "set",
          "props": {
            "key": "one",
            "value": [
              {
                "lat": "${lat}",
                "lon": "${lon}",
                "name": "${name}",
                "where": ""
              }
            ]
          }
        },
        {
          "action": "data.set",
          "params": {
            "key": "cities",
            "value": "${one}"
          }
        },
        {
          "action": "ui.showLoading",
          "params": {
            "text": "${@i18n.loading}"
          }
        },
        {
          "action": "xpage.reloadPage"
        },
        {
          "action": "ui.hideLoading"
        }
      ]
    }
  ]
}
