{
  "_note": "打开城市管理页;回来后软重载首页(没有 onVisible,只能由打开它的这条流接着 reload)。",
  "version": 1,
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "action": "startPageForResult",
      "params": {
        "page": "/city",
        "container": "page"
      },
      "interactive": true
    },
    {
      "action": "xpage.patchState",
      "params": {
        "reval": 1
      }
    },
    {
      "action": "xpage.reloadPage"
    }
  ]
}
