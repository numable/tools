{
  "routes": [
    {
      "path": "/",
      "type": "xpage",
      "entry": "xpage/home.xpage"
    },
    {
      "path": "/detail",
      "type": "xpage",
      "entry": "xpage/detail.xpage",
      "title": "空气质量",
      "i18n": {
        "en-US": {
          "title": "Air quality"
        }
      },
      "_note": "标题是静态 B 表字段,填不进运行期的城市名;城市名由页内大字负责。"
    },
    {
      "path": "/city",
      "entry": "html/city/index.html",
      "title": "我的城市",
      "i18n": {
        "en-US": {
          "title": "My cities"
        }
      }
    },
    {
      "path": "/pick",
      "entry": "html/pick/index.html",
      "title": "选择城市",
      "i18n": {
        "en-US": {
          "title": "Choose a City"
        }
      },
      "_note": "组件参数编辑页(.xwidget events.onEdit → 裸 path `/pick`)。"
    }
  ]
}
