{
  "_note": "标准切换(分段控件,整行宽)。切换 = set-std.af:写 data.aqStd → 刷新本包组件 → 首页软重载。\n选中的那段白底(深色是抬亮一档的灰),未选中的只有字;std 缺失(首帧)两段都不选。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "12pt",
          "leftB": "12pt",
          "rightT": "12pt",
          "rightB": "12pt"
        }
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${std},cn)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "3pt+({parent.w}-6pt)*0/2",
            "y": "3pt",
            "w": "({parent.w}-6pt)/2",
            "h": "{parent.h}-6pt",
            "alignmentH": "1",
            "alignmentV": "1",
            "maxLines": "1",
            "text": "${@i18n.segCn}",
            "fontSize": "13.5pt",
            "typeface": "System-Bold",
            "cornerRadius": {
              "leftT": "9pt",
              "leftB": "9pt",
              "rightT": "9pt",
              "rightB": "9pt"
            },
            "events": {
              "onClick": {
                "flow": "@[file://page/flow/set-std.af]",
                "params": {
                  "s": "cn"
                }
              }
            },
            "textColor": "#0E1116|#F3F4F6",
            "bgColor": "#FFFFFF|#3A3F48"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${std},cn),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "3pt+({parent.w}-6pt)*0/2",
            "y": "3pt",
            "w": "({parent.w}-6pt)/2",
            "h": "{parent.h}-6pt",
            "alignmentH": "1",
            "alignmentV": "1",
            "maxLines": "1",
            "text": "${@i18n.segCn}",
            "fontSize": "13.5pt",
            "typeface": "System-Bold",
            "cornerRadius": {
              "leftT": "9pt",
              "leftB": "9pt",
              "rightT": "9pt",
              "rightB": "9pt"
            },
            "events": {
              "onClick": {
                "flow": "@[file://page/flow/set-std.af]",
                "params": {
                  "s": "cn"
                }
              }
            },
            "textColor": "#6B7280|#8E939B",
            "bgColor": "#00000000"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${std},us)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "3pt+({parent.w}-6pt)*1/2",
            "y": "3pt",
            "w": "({parent.w}-6pt)/2",
            "h": "{parent.h}-6pt",
            "alignmentH": "1",
            "alignmentV": "1",
            "maxLines": "1",
            "text": "${@i18n.segUs}",
            "fontSize": "13.5pt",
            "typeface": "System-Bold",
            "cornerRadius": {
              "leftT": "9pt",
              "leftB": "9pt",
              "rightT": "9pt",
              "rightB": "9pt"
            },
            "events": {
              "onClick": {
                "flow": "@[file://page/flow/set-std.af]",
                "params": {
                  "s": "us"
                }
              }
            },
            "textColor": "#0E1116|#F3F4F6",
            "bgColor": "#FFFFFF|#3A3F48"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${std},us),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "3pt+({parent.w}-6pt)*1/2",
            "y": "3pt",
            "w": "({parent.w}-6pt)/2",
            "h": "{parent.h}-6pt",
            "alignmentH": "1",
            "alignmentV": "1",
            "maxLines": "1",
            "text": "${@i18n.segUs}",
            "fontSize": "13.5pt",
            "typeface": "System-Bold",
            "cornerRadius": {
              "leftT": "9pt",
              "leftB": "9pt",
              "rightT": "9pt",
              "rightB": "9pt"
            },
            "events": {
              "onClick": {
                "flow": "@[file://page/flow/set-std.af]",
                "params": {
                  "s": "us"
                }
              }
            },
            "textColor": "#6B7280|#8E939B",
            "bgColor": "#00000000"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "segCn": "中国标准",
        "segUs": "美国标准"
      },
      "en-US": {
        "segCn": "China",
        "segUs": "US"
      }
    }
  }
}
