{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#0A000000|#12FFFFFF",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "type": "txt",
        "x": "16pt",
        "y": "0pt",
        "w": "{parent.w}-60pt",
        "h": "{parent.h}",
        "maxLines": "1",
        "text": "${@i18n.manageT}",
        "fontSize": "13.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "alignmentV": "1"
      },
      {
        "type": "txt",
        "x": "{parent.w}-44pt",
        "y": "0pt",
        "w": "28pt",
        "h": "{parent.h}",
        "maxLines": "1",
        "text": "›",
        "fontSize": "17pt",
        "textColor": "#6B7280|#8E939B",
        "lineBreak": "0",
        "alignmentV": "1",
        "alignmentH": "2"
      }
    ],
    "i18n": {
      "zh-CN": {
        "manageT": "管理城市"
      },
      "en-US": {
        "manageT": "Manage cities"
      }
    }
  }
}
