{
  "_note": "数据说明:按当前标准(中国 / 美国)二选一;拆成短段落,减少长句折行时标点落在行首。",
  "rc": {
    "cells": [
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${std},us)]"
        },
        "react": [
          {
            "id": "us_src",
            "type": "txt",
            "x": "2pt",
            "y": "0pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_home_src}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          },
          {
            "id": "us_us",
            "type": "txt",
            "x": "2pt",
            "y": "{us_src.b}+8pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_home_us}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          },
          {
            "id": "us_end",
            "type": "txt",
            "x": "2pt",
            "y": "{us_us.b}+8pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_home_end}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${std},cn)]"
        },
        "react": [
          {
            "id": "cn_src",
            "type": "txt",
            "x": "2pt",
            "y": "0pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_home_src}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          },
          {
            "id": "cn_cn",
            "type": "txt",
            "x": "2pt",
            "y": "{cn_src.b}+8pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_home_cn}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          },
          {
            "id": "cn_end",
            "type": "txt",
            "x": "2pt",
            "y": "{cn_cn.b}+8pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_home_end}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "f_home_cn": "现在用的是中国 HJ 633-2012 标准，由每小时的浓度计算，每小时更新。可以在页面顶部换成美国标准。",
        "f_home_end": "城市列表默认只保存在这台设备上。",
        "f_home_src": "数据来源：Open-Meteo 空气质量接口，哥白尼大气监测服务 CAMS 的模型估算值。它不是监测站实测，可能与附近站点的读数有出入。",
        "f_home_us": "现在用的是美国 EPA 标准（US AQI），每小时更新。可以在页面顶部换成中国标准。"
      },
      "en-US": {
        "f_home_cn": "You're seeing China's HJ 633-2012 index, computed from hourly concentrations and updated hourly. Switch to the US standard at the top of this page.",
        "f_home_end": "Your city list stays on this device by default.",
        "f_home_src": "Source: Open-Meteo Air Quality API, model estimates from the Copernicus Atmosphere Monitoring Service (CAMS) on an 11 km grid. They are not station readings and can differ from nearby monitors.",
        "f_home_us": "You're seeing the US EPA AQI, updated hourly. Switch to China's standard at the top of this page."
      }
    }
  }
}
