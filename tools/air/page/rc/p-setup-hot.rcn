{
  "_note": "常用城市:点一下直接加入「我的城市」。中文环境给国内城市,英文环境给国际城市。",
  "rc": {
    "cells": [
      {
        "type": "txt",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.suHot}",
        "fontSize": "11.5pt",
        "textColor": "#6B7280|#8E939B",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "id": "c1",
        "type": "txt",
        "x": "({parent.w}+10pt)*0/3",
        "y": "22pt",
        "w": "({parent.w}+10pt)/3-10pt",
        "h": "38pt",
        "alignmentH": "1",
        "alignmentV": "1",
        "maxLines": "1",
        "text": "${@i18n.suC1}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "19pt",
          "leftB": "19pt",
          "rightT": "19pt",
          "rightB": "19pt"
        },
        "events": {
          "onClick": {
            "flow": "@[file://page/flow/setup-hot.af]",
            "params": {
              "k": "1"
            }
          }
        }
      },
