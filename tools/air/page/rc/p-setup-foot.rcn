{
  "rc": {
    "cells": [
      {
        "type": "txt",
        "x": "2pt",
        "y": "0pt",
        "w": "{parent.w}-4pt",
        "h": "-1",
        "maxLines": "3",
        "text": "${@i18n.suFoot}",
        "fontSize": "10.5pt",
        "textColor": "#9AA0A6|#6B7078",
        "lineSpacing": "3pt",
        "lineBreak": "1"
      }
    ],
    "i18n": {
      "zh-CN": {
        "suFoot": "数据来源：Open-Meteo（开放数据，无需密钥）。城市列表默认只保存在这台设备上。城市检索结果含 OpenStreetMap 数据（© OSM 贡献者）。"
      },
      "en-US": {
        "suFoot": "Source: Open-Meteo (open data, no API key). Your city list stays on your devices. City search results include data from OpenStreetMap (© OSM contributors)."
      }
    }
  }
}
