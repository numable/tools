{
  "_note": "数据说明:按当前标准(中国 / 美国)二选一;拆成短段落,减少长句折行时标点落在行首。",
  "rc": {
    "cells": [
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${std},us)]"
        },
        "react": [
          {
            "id": "us_src",
            "type": "txt",
            "x": "2pt",
            "y": "0pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_detail_src}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          },
          {
            "id": "us_us",
            "type": "txt",
            "x": "2pt",
            "y": "{us_src.b}+8pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_detail_us}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          },
          {
            "id": "us_endUs",
            "type": "txt",
            "x": "2pt",
            "y": "{us_us.b}+8pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_detail_endUs}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${std},cn)]"
        },
        "react": [
          {
            "id": "cn_src",
            "type": "txt",
            "x": "2pt",
            "y": "0pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_detail_src}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          },
          {
            "id": "cn_cn",
            "type": "txt",
            "x": "2pt",
            "y": "{cn_src.b}+8pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_detail_cn}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          },
          {
            "id": "cn_endCn",
            "type": "txt",
            "x": "2pt",
            "y": "{cn_cn.b}+8pt",
            "w": "{parent.w}-4pt",
            "h": "-1",
            "maxLines": "6",
            "text": "${@i18n.f_detail_endCn}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "lineSpacing": "3pt",
            "lineBreak": "1"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "f_detail_cn": "按中国 HJ 633-2012 标准，用每小时的浓度计算：PM2.5 和 PM10 对照 24 小时分段，其余对照 1 小时分段。0–50 优，51–100 良，101–150 轻度污染，151–200 中度污染，201–300 重度污染，300 以上严重污染。",
        "f_detail_endCn": "可以在首页顶部换成美国标准。建议只作日常参考，不是医疗建议。",
        "f_detail_endUs": "可以在首页顶部换成中国标准。建议只作日常参考，不是医疗建议。",
        "f_detail_src": "数据来源：Open-Meteo 空气质量接口，CAMS 模型，约 11 公里网格，每小时更新。这是模型估算值，不是监测站实测。",
        "f_detail_us": "按美国 EPA 标准 US AQI：0–50 优，51–100 良，101–150 对敏感人群不健康，151–200 不健康，201–300 非常不健康，301 以上危险。"
      },
      "en-US": {
        "f_detail_cn": "China's HJ 633-2012 index, computed from hourly concentrations (PM2.5 and PM10 against the 24-hour table, the rest against the 1-hour table): 0–50 excellent, 51–100 good, 101–150 light, 151–200 moderate, 201–300 heavy, 300+ severe pollution.",
        "f_detail_endCn": "You can switch to the US standard at the top of the home page. Tips are for everyday reference only, not medical advice.",
        "f_detail_endUs": "You can switch to China's standard at the top of the home page. Tips are for everyday reference only, not medical advice.",
        "f_detail_src": "Source: Open-Meteo Air Quality API, CAMS model on an 11 km grid, updated hourly. These are model estimates, not station readings.",
        "f_detail_us": "US EPA AQI: 0–50 good, 51–100 moderate, 101–150 unhealthy for sensitive groups, 151–200 unhealthy, 201–300 very unhealthy, 301+ hazardous."
      }
    }
  }
}
