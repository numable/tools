{
  "_note": "紫外线:现在与未来 24 小时峰值(WHO 五档),≥ 3 提醒防晒。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "cornerRadius": {
          "leftT": "16pt",
          "leftB": "16pt",
          "rightT": "16pt",
          "rightB": "16pt"
        }
      },
      {
        "type": "txt",
        "x": "16pt",
        "y": "16pt",
        "w": "{parent.w}-32pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.uvT}",
        "fontSize": "15pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "16pt",
        "y": "46pt",
        "w": "({parent.w}-32pt)/2",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.uvNow}",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ok},1),if::(eq::(${uvLv},1),1,0),0)]"
        },
        "react": [
          {
            "type": "richText",
            "x": "16pt",
            "y": "64pt",
            "w": "({parent.w}-32pt)/2",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "$[findNotEmpty::(${uvNow},--)]",
                "fontSize": "26pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
