{
  "_note": "未来 48 小时逐时 AQI(柱按档位着色,细线是 50 / 100 两条档位线)。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "cornerRadius": {
          "leftT": "16pt",
          "leftB": "16pt",
          "rightT": "16pt",
          "rightB": "16pt"
        }
      },
      {
        "type": "txt",
        "x": "16pt",
        "y": "16pt",
        "w": "{parent.w}-32pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.d48T}",
        "fontSize": "15pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "16pt",
        "y": "42pt",
        "w": "{parent.w}-32pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.d48S}",
        "fontSize": "11.5pt",
        "textColor": "#6B7280|#8E939B",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${trendKey},worse)]"
        },
        "react": [
          {
            "id": "tr_worse",
            "type": "txt",
            "x": "{parent.w}-16pt-{tr_worse.w}",
            "y": "18pt",
            "w": "-1",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.tw}",
            "fontSize": "12.5pt",
            "textColor": "#0E1116|#F3F4F6",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
