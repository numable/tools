{
  "rc": {
    "cells": [
      {
        "id": "t",
        "type": "txt",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.suT}",
        "fontSize": "22pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "0pt",
        "y": "{t.b}+8pt",
        "w": "{parent.w}",
        "h": "-1",
        "maxLines": "3",
        "text": "${@i18n.suS}",
        "fontSize": "13pt",
        "textColor": "#6B7280|#8E939B",
        "lineSpacing": "4pt",
        "lineBreak": "1"
      }
    ],
    "i18n": {
      "zh-CN": {
        "suS": "添加后，这里会显示它现在的空气质量、接下来 24 小时的走势和出门建议。",
        "suT": "先添加一个城市"
      },
      "en-US": {
        "suS": "Once you add one, you'll see its air quality now, the next 24 hours and what to do before heading out.",
        "suT": "Add a city to start"
      }
    }
  }
}
