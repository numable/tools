{
  "_note": "未来 24 小时(42):逐时 AQI 柱按档位着色,圆点 = 最差时段。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "srcDot",
        "type": "layer",
        "x": "14pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#1B8EB0|#58C6E8",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "type": "txt",
        "x": "{parent.w}-114pt",
        "y": "15pt",
        "w": "100pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.asof} $[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "lineBreak": "0",
        "alignmentH": "2"
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "23pt",
        "y": "12pt",
        "w": "{parent.w}-140pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${city},--)]",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "hide": "$[if::(eq::(findNotEmpty::(${city},__none__),__none__),1,0)]"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${city},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "23pt",
            "y": "17pt",
            "w": "{parent.w}-140pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "13pt",
            "textColor": "#0E1116|#F3F4F6",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${trendKey},worse)]"
        },
