{
  "_note": "现在的空气(11 · 微档):城市 · AQI · 档位短名。AQI 最多 3 位,恒 20pt。数据 aq.df(与 22 档同一条)。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "srcDot",
        "type": "layer",
        "x": "8pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#1B8EB0|#58C6E8",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${city},--)]",
        "fontSize": "10pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "hide": "$[if::(eq::(findNotEmpty::(${city},__none__),__none__),1,0)]"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${city},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "17pt",
            "y": "10.7pt",
            "w": "43pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "10pt",
            "textColor": "#0E1116|#F3F4F6",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${aqi},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "id": "num",
            "type": "richText",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "${aqi}",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "$[findNotEmpty::(${lvI},#0E1116|#F3F4F6)]"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${aqi},__none__),__none__),1,0)]"
        },
        "react": [
