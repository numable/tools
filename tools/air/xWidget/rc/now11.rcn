            "x": "8pt",
            "y": "28pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "20pt",
            "textColor": "#0E1116|#F3F4F6",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
