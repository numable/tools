          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "_note": "PM2.5 前的圆点 = 这一项自己的档位色(2026-10-08 评审:浓度不带单位也不标档位,读不出高低)。"
      },
      {
        "type": "txt",
        "x": "88pt",
        "y": "38pt",
        "w": "60pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.pm25s} $[findNotEmpty::(${pm25},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "lineBreak": "0",
        "_note": "不带 μg/m³:68pt 放不下「PM2.5 123.4 μg/m³」(rcnrender 实测截成「μg/…」)。单位在详情页。"
