{
  "_note": "现在的空气 · 一行(21):城市 + 时效锚(HH:mm)· AQI + 档位短名 + PM2.5 浓度。数据 aq.df。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "srcDot",
        "type": "layer",
        "x": "10pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#1B8EB0|#58C6E8",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "at",
        "type": "txt",
        "x": "113pt",
        "y": "10.5pt",
        "w": "35pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "lineBreak": "0",
        "alignmentH": "2"
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "90pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${city},--)]",
        "fontSize": "11pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "hide": "$[if::(eq::(findNotEmpty::(${city},__none__),__none__),1,0)]"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${city},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "19pt",
            "y": "13.1pt",
            "w": "90pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "11pt",
            "textColor": "#0E1116|#F3F4F6",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${aqi},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "id": "num",
            "type": "richText",
            "x": "10pt",
            "y": "24pt",
            "w": "66pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "${aqi}",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "$[findNotEmpty::(${lvI},#0E1116|#F3F4F6)]"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "9pt",
                "textColor": "#6B7280|#8E939B"
              },
              {
                "text": "${@i18n.aqi}",
                "fontSize": "9pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${aqi},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "id": "numE",
            "type": "txt",
            "x": "10pt",
            "y": "30pt",
            "w": "66pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "20pt",
            "textColor": "#0E1116|#F3F4F6",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${lk},1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "80pt",
            "y": "24pt",
            "w": "68pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.ss1}",
            "fontSize": "10pt",
            "textColor": "#12713A|#5BE39A",
            "typeface": "System-Bold",
