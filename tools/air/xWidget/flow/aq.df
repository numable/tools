    {
      "_note": "时效锚的时刻:这趟真取了就是现在(与写进 pack 的 ts 同值),命中缓存就是那份缓存取回的时刻。",
      "op": "set",
      "props": {
        "key": "updTs",
        "value": "$[if::(eq::(${doNet},1),${nowMs},${boxTs})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "updMs",
        "value": "$[parseNumber::(findNotEmpty::(${updTs},0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "updDay",
        "value": "$[formatDate::(${updMs},yyyyMMdd)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "todayDay",
        "value": "$[formatDate::(${@time.nowMs},yyyyMMdd)]"
      }
    },
    {
      "_note": "时效锚的文字:取回这份数据的时刻,本机时间;当天 HH:mm、跨天 MM-dd HH:mm(card-design-system §3)。\n⚠️ formatDate 喂空串会渲成 epoch(「01-01 08:00」);没有时间戳时求出 null(`_nil` 从不赋值)→ 键不进输出,锚整个不画。",
      "op": "set",
      "props": {
        "key": "upd",
        "value": "$[if::(gt::(${updMs},0),if::(eq::(${updDay},${todayDay}),formatDate::(${updMs},HH:mm),formatDate::(${updMs},MM-dd HH:mm)),${_nil})]"
      }
    },
