              }
            },
            {
              "op": "set",
              "props": {
                "key": "a_co",
                "value": "$[parseNumber::(calc::((floor::(calc::(1/100*min::(max::(findNotEmpty::(${resp.current.carbon_monoxide},-1),0),5000)+1/100*(min::(max::(findNotEmpty::(${resp.current.carbon_monoxide},-1),5000),10000)-5000)+1/500*(min::(max::(findNotEmpty::(${resp.current.carbon_monoxide},-1),10000),35000)-10000)+1/500*(min::(max::(findNotEmpty::(${resp.current.carbon_monoxide},-1),35000),60000)-35000)+1/300*(min::(max::(findNotEmpty::(${resp.current.carbon_monoxide},-1),60000),90000)-60000)+1/300*(min::(max::(findNotEmpty::(${resp.current.carbon_monoxide},-1),90000),120000)-90000)+1/300*(min::(max::(findNotEmpty::(${resp.current.carbon_monoxide},-1),120000),150000)-120000)+0.999999))+1)*min::(1,calc::(findNotEmpty::(${resp.current.carbon_monoxide},-1)+1))-1),0)]"
              }
            },
            {
              "_note": "HJ 633 式(2):AQI = 各项分指数的最大值。",
              "op": "set",
              "props": {
                "key": "aqi",
                "value": "$[max::(${a_pm25},${a_pm10},${a_o3},${a_no2},${a_so2},${a_co})]"
              }
            },
            {
              "_note": "逐时 AQI:这一小时六项分指数的最大值;PM2.5 缺值 = 整小时缺(-1)。\n一整个 AQI(六项分指数取最大)写成**一条**表达式:(max(IAQI…) + 1) × 在场 − 1,\n在场 = min(1, PM2.5 浓度 + 1) —— 浓度 ≥ 0 时为 1,缺值哨兵 -1 时为 0 → 整体得 -1(缺值)。仍然没有 if。\n⚠️ 为什么非要挤成一条、浓度也不先落地:web 引擎每执行一个节点的开销与流里已有的键数成正比(O(键数²))。\n逐项落地(浓度 → 分指数 → 取最大)一小时 13 个键,48 小时 600+ 个键,aq.df 单跑 9.5 秒;只把浓度用纯取值落地\n(288 个键)也要多 3 秒以上;合成一条、浓度在表达式里直接寻址,48 个键,实测只比美国标准多 ~0.2 秒。",
              "op": "set",
              "props": {
                "key": "v0",
                "value": "$[parseNumber::(calc::((max::(floor::(calc::(10/7*min::(max::(findNotEmpty::(${resp.hourly.pm2_5[0]},-1),0),35)+5/4*(min::(max::(findNotEmpty::(${resp.hourly.pm2_5[0]},-1),35),75)-35)+5/4*(min::(max::(findNotEmpty::(${resp.hourly.pm2_5[0]},-1),75),115)-75)+10/7*(min::(max::(findNotEmpty::(${resp.hourly.pm2_5[0]},-1),115),150)-115)+(min::(max::(findNotEmpty::(${resp.hourly.pm2_5[0]},-1),150),250)-150)+(min::(max::(findNotEmpty::(${resp.hourly.pm2_5[0]},-1),250),350)-250)+2/3*(min::(max::(findNotEmpty::(${resp.hourly.pm2_5[0]},-1),350),500)-350)+0.999999)),floor::(calc::(min::(max::(findNotEmpty::(${resp.hourly.pm10[0]},-1),0),50)+1/2*(min::(max::(findNotEmpty::(${resp.hourly.pm10[0]},-1),50),150)-50)+1/2*(min::(max::(findNotEmpty::(${resp.hourly.pm10[0]},-1),150),250)-150)+1/2*(min::(max::(findNotEmpty::(${resp.hourly.pm10[0]},-1),250),350)-250)+10/7*(min::(max::(findNotEmpty::(${resp.hourly.pm10[0]},-1),350),420)-350)+5/4*(min::(max::(findNotEmpty::(${resp.hourly.pm10[0]},-1),420),500)-420)+(min::(max::(findNotEmpty::(${resp.hourly.pm10[0]},-1),500),600)-500)+0.999999)),floor::(calc::(5/16*min::(max::(findNotEmpty::(${resp.hourly.ozone[0]},-1),0),160)+5/4*(min::(max::(findNotEmpty::(${resp.hourly.ozone[0]},-1),160),200)-160)+1/2*(min::(max::(findNotEmpty::(${resp.hourly.ozone[0]},-1),200),300)-200)+1/2*(min::(max::(findNotEmpty::(${resp.hourly.ozone[0]},-1),300),400)-300)+1/4*(min::(max::(findNotEmpty::(${resp.hourly.ozone[0]},-1),400),800)-400)+1/2*(min::(max::(findNotEmpty::(${resp.hourly.ozone[0]},-1),800),1000)-800)+1/2*(min::(max::(findNotEmpty::(${resp.hourly.ozone[0]},-1),1000),1200)-1000)+0.999999)),floor::(calc::(1/2*min::(max::(findNotEmpty::(${resp.hourly.nitrogen_dioxide[0]},-1),0),100)+1/2*(min::(max::(findNotEmpty::(${resp.hourly.nitrogen_dioxide[0]},-1),100),200)-100)+1/10*(min::(max::(findNotEmpty::(${resp.hourly.nitrogen_dioxide[0]},-1),200),700)-200)+1/10*(min::(max::(findNotEmpty::(${resp.hourly.nitrogen_dioxide[0]},-1),700),1200)-700)+5/57*(min::(max::(findNotEmpty::(${resp.hourly.nitrogen_dioxide[0]},-1),1200),2340)-1200)+2/15*(min::(max::(findNotEmpty::(${resp.hourly.nitrogen_dioxide[0]},-1),2340),3090)-2340)+2/15*(min::(max::(findNotEmpty::(${resp.hourly.nitrogen_dioxide[0]},-1),3090),3840)-3090)+0.999999)),floor::(calc::(1/3*min::(max::(findNotEmpty::(${resp.hourly.sulphur_dioxide[0]},-1),0),150)+1/7*(min::(max::(findNotEmpty::(${resp.hourly.sulphur_dioxide[0]},-1),150),500)-150)+1/3*(min::(max::(findNotEmpty::(${resp.hourly.sulphur_dioxide[0]},-1),500),650)-500)+1/3*(min::(max::(findNotEmpty::(${resp.hourly.sulphur_dioxide[0]},-1),650),800)-650)+1/8*(min::(max::(findNotEmpty::(${resp.hourly.sulphur_dioxide[0]},-1),800),1600)-800)+1/5*(min::(max::(findNotEmpty::(${resp.hourly.sulphur_dioxide[0]},-1),1600),2100)-1600)+5/26*(min::(max::(findNotEmpty::(${resp.hourly.sulphur_dioxide[0]},-1),2100),2620)-2100)+0.999999)),floor::(calc::(1/100*min::(max::(findNotEmpty::(${resp.hourly.carbon_monoxide[0]},-1),0),5000)+1/100*(min::(max::(findNotEmpty::(${resp.hourly.carbon_monoxide[0]},-1),5000),10000)-5000)+1/500*(min::(max::(findNotEmpty::(${resp.hourly.carbon_monoxide[0]},-1),10000),35000)-10000)+1/500*(min::(max::(findNotEmpty::(${resp.hourly.carbon_monoxide[0]},-1),35000),60000)-35000)+1/300*(min::(max::(findNotEmpty::(${resp.hourly.carbon_monoxide[0]},-1),60000),90000)-60000)+1/300*(min::(max::(findNotEmpty::(${resp.hourly.carbon_monoxide[0]},-1),90000),120000)-90000)+1/300*(min::(max::(findNotEmpty::(${resp.hourly.carbon_monoxide[0]},-1),120000),150000)-120000)+0.999999)))+1)*min::(1,calc::(findNotEmpty::(${resp.hourly.pm2_5[0]},-1)+1))-1),0)]"
