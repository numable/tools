{
  "_note": "未来 24 小时(42)。",
  "version": 2,
  "title": "未来 24 小时",
  "sub": "逐时 AQI · 最差时段",
  "i18n": {
    "en-US": {
      "title": "Next 24 hours",
      "sub": "Hourly AQI and the worst hour"
    }
  },
  "layout": 42,
  "params": {
    "lat": "auto",
    "lon": "auto",
    "city": "auto"
  },
  "ai": {
    "shows": "一座城市未来 24 小时逐时 AQI 走势、最高最低时段，以及接下来变好还是变差",
    "params": {
      "city": {
        "kind": "auto",
        "group": [
          "city",
          "lat",
          "lon"
        ],
        "hint": "要换城市就三个一起填：city 写城市名，lat / lon 写这座城市的十进制纬度、经度（如东京 35.68 / 139.69，纽约 40.71 / -74.01）；只填 city 不生效。对坐标没把握就三个都留 auto（国内显示上海、海外显示纽约，装上后用户长按「编辑」换城市）"
      }
    }
  },
  "events": {
    "_note": "onClick 带上这个组件自己的坐标去详情页(只能引用外壳 ⊕ 实例 params;城市名由宿主编码,包里不再 urlEncode)。\nonEdit 是**裸路由 path**(逐字匹配 router.json),写成 numable:// 形态会开出空白页。",
    "onClick": "/detail?lat=${lat}&lon=${lon}&city=${city}",
    "onEdit": "/pick"
  },
  "canvas": {
    "source": "@[file://rc/trend.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/aq.df]",
        "params": {
          "lat": "${lat}",
          "lon": "${lon}",
          "city": "${city}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "1800"
      ]
    }
  }
}
