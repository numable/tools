{
  "version": 2,
  "title": "点赞前两篇",
  "sub": "2 篇 · 带点赞条",
  "i18n": {
    "en-US": {
      "title": "Top two",
      "sub": "2 papers with upvote bars"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "Hugging Face 当天点赞前 2 篇 AI 论文（英文原标题），带机构、点赞数与点赞条"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/top3.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。各组件各绑各的 flow(槽数不同,空槽键会被当成取数失败)。",
        "flow": "@[file://flow/top3.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "600"
      ]
    }
  }
}
