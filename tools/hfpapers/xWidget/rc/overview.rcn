{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FDFBF7\\,#F9F5E8)@90|linear(#15171A\\,#191A1A\\,#201F1A)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#C08C00|#FFD21E",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.b_overview}",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "10pt",
        "y": "10.5pt",
        "w": "138pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "big",
        "type": "richText",
        "x": "10pt",
        "y": "25pt",
        "w": "84pt",
        "h": "-1",
        "maxLines": "1",
        "spans": [
          {
            "text": "$[findNotEmpty::(${vsum},--)]",
            "fontSize": "17pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "text": "${@i18n.nbsp}",
            "fontSize": "8pt"
          },
          {
            "text": "${@i18n.ovU}",
            "fontSize": "9.5pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "id": "ovS",
        "type": "txt",
        "x": "10pt",
        "y": "45pt",
        "w": "84pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.ovS}",
        "fontSize": "8.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "axis",
        "type": "layer",
        "x": "98pt",
        "y": "51pt",
        "w": "50pt",
        "h": "1pt",
        "bgColor": "#E4E7EC|#262A31"
      },
      {
        "id": "mb0",
        "type": "line",
        "points": "[5,24.5,5,$[findNotEmpty::(${my0},24.5)]]",
        "lineWidth": "5pt",
        "lineCap": "round",
        "strokeColor": "#C08C00|#FFD21E",
        "hide": "$[if::(if::(eq::(findNotEmpty::(${my0},__none__),__none__),0,1),0,1)]",
        "x": "98pt",
        "y": "24pt",
        "w": "50pt",
        "h": "28pt"
      },
      {
        "id": "mb1",
        "type": "line",
        "points": "[15,24.5,15,$[findNotEmpty::(${my1},24.5)]]",
        "lineWidth": "5pt",
        "lineCap": "round",
        "strokeColor": "#E3B53C|#FFE27A",
        "hide": "$[if::(if::(eq::(findNotEmpty::(${my1},__none__),__none__),0,1),0,1)]",
        "x": "98pt",
        "y": "24pt",
        "w": "50pt",
        "h": "28pt"
      },
      {
        "id": "mb2",
        "type": "line",
        "points": "[25,24.5,25,$[findNotEmpty::(${my2},24.5)]]",
        "lineWidth": "5pt",
        "lineCap": "round",
        "strokeColor": "#E3B53C|#FFE27A",
        "hide": "$[if::(if::(eq::(findNotEmpty::(${my2},__none__),__none__),0,1),0,1)]",
        "x": "98pt",
        "y": "24pt",
        "w": "50pt",
        "h": "28pt"
      },
      {
        "id": "mb3",
        "type": "line",
        "points": "[35,24.5,35,$[findNotEmpty::(${my3},24.5)]]",
        "lineWidth": "5pt",
        "lineCap": "round",
        "strokeColor": "#E3B53C|#FFE27A",
        "hide": "$[if::(if::(eq::(findNotEmpty::(${my3},__none__),__none__),0,1),0,1)]",
        "x": "98pt",
        "y": "24pt",
        "w": "50pt",
        "h": "28pt"
      },
      {
        "id": "mb4",
        "type": "line",
        "points": "[45,24.5,45,$[findNotEmpty::(${my4},24.5)]]",
        "lineWidth": "5pt",
        "lineCap": "round",
        "strokeColor": "#E3B53C|#FFE27A",
        "hide": "$[if::(if::(eq::(findNotEmpty::(${my4},__none__),__none__),0,1),0,1)]",
        "x": "98pt",
        "y": "24pt",
        "w": "50pt",
        "h": "28pt"
      }
    ],
    "i18n": {
      "zh-CN": {
        "ovU": "赞",
        "ovS": "前 5 篇合计",
        "b_overview": "今日论文",
        "nbsp": " "
      },
      "en-US": {
        "ovU": "upvotes",
        "ovS": "top 5 combined",
        "b_overview": "Papers today",
        "nbsp": " "
      }
    },
    "_note": "生成器 tools/infosource/gen_headlines.py(21 今日论文,复用 list.df)。"
  }
}
