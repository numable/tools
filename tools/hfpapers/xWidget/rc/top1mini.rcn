{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FDFBF7\\,#F9F5E8)@90|linear(#15171A\\,#191A1A\\,#201F1A)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#C08C00|#FFD21E",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.b_top1}",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "10pt",
        "y": "10.5pt",
        "w": "138pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "title",
        "type": "txt",
        "x": "10pt",
        "y": "24pt",
        "w": "138pt",
        "h": "-1",
        "maxLines": "2",
        "lineSpacing": "2pt",
        "text": "$[findNotEmpty::(${tm0},--)]",
        "fontSize": "11.5pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      }
    ],
    "i18n": {
      "zh-CN": {
        "b_top1": "点赞最多"
      },
      "en-US": {
        "b_top1": "Top paper"
      }
    },
    "_note": "生成器 tools/infosource/gen_headlines.py(21 迷你,复用 top1.df)。"
  }
}
