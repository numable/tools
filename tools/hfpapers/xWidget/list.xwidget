{
  "version": 2,
  "title": "每日论文",
  "sub": "5 篇 · 每篇带点赞条",
  "i18n": {
    "en-US": {
      "title": "Daily papers",
      "sub": "5 papers, each with an upvote bar"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "Hugging Face 当天点赞前 5 篇 AI 论文（英文原标题），每篇带机构、点赞数与点赞条"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/list.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。各组件各绑各的 flow(槽数不同,空槽键会被当成取数失败)。",
        "flow": "@[file://flow/list.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "600"
      ]
    }
  }
}
