{
  "version": 2,
  "title": "点赞最多",
  "sub": "1 篇 · 当天点赞最多",
  "i18n": {
    "en-US": {
      "title": "Top paper",
      "sub": "The most upvoted paper of the day"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "Hugging Face 当天点赞最多的一篇 AI 论文（英文原标题），带点赞数、占前 5 篇点赞的比例与机构"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/top1.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。各组件各绑各的 flow(槽数不同,空槽键会被当成取数失败)。",
        "flow": "@[file://flow/top1.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "600"
      ]
    }
  }
}
