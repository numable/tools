{
  "version": 2,
  "title": "点赞最多",
  "sub": "迷你 · 当天点赞最多的论文",
  "i18n": {
    "en-US": {
      "title": "Top paper",
      "sub": "Mini · the day's most upvoted paper"
    }
  },
  "layout": 21,
  "params": {},
  "ai": {
    "shows": "Hugging Face 当天点赞最多那篇 AI 论文的英文标题（一行迷你）"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/top1mini.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。本组件与「top1」同问同源,复用 top1.df(零新增请求)。",
        "flow": "@[file://flow/top1.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "600"
      ]
    }
  }
}
