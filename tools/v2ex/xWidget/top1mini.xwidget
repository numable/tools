{
  "version": 2,
  "title": "最热主题",
  "sub": "迷你 · 全站最热主题的标题",
  "i18n": {
    "en-US": {
      "title": "Top topic",
      "sub": "Mini · the hottest topic's title"
    }
  },
  "layout": 21,
  "params": {},
  "ai": {
    "shows": "V2EX 全站最热主题的标题（一行迷你）"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/top1mini.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。本组件与「top1」同问同源,复用 top1.df(零新增请求)。",
        "flow": "@[file://flow/top1.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
