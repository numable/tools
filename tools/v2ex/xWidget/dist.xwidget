{
  "version": 2,
  "title": "热帖节点",
  "sub": "最热主题按节点归类",
  "i18n": {
    "en-US": {
      "title": "Hot nodes",
      "sub": "Hot topics grouped by node"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "V2EX 全站最热主题按节点归类，前几个节点各有几帖，带条形图"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/dist.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。各组件各绑各的 flow(槽数不同,空槽键会被当成取数失败)。",
        "flow": "@[file://flow/dist.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
