{
  "version": 2,
  "title": "最热主题",
  "sub": "1 条 · 全站最热",
  "i18n": {
    "en-US": {
      "title": "Top topic",
      "sub": "The hottest topic now"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "V2EX 全站最热的一个主题（中文标题），带回复数、节点、发布多久与每小时回复数"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/top1.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。各组件各绑各的 flow(槽数不同,空槽键会被当成取数失败)。",
        "flow": "@[file://flow/top1.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
