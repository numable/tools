{
  "version": 2,
  "title": "最热前两条",
  "sub": "2 条 · 带回复数条",
  "i18n": {
    "en-US": {
      "title": "Top two",
      "sub": "2 topics with reply bars"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "V2EX 全站最热前 2 个主题（中文标题），带节点、回复数、发布多久与回复数条"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/top3.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。各组件各绑各的 flow(槽数不同,空槽键会被当成取数失败)。",
        "flow": "@[file://flow/top3.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
