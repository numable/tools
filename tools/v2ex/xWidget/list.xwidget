{
  "version": 2,
  "title": "最热",
  "sub": "5 条 · 每条带回复数条",
  "i18n": {
    "en-US": {
      "title": "Hot topics",
      "sub": "5 topics, each with a reply bar"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "V2EX 全站最热前 5 个主题（中文标题），每条带节点、回复数、发布多久与回复数条"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/list.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。各组件各绑各的 flow(槽数不同,空槽键会被当成取数失败)。",
        "flow": "@[file://flow/list.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
