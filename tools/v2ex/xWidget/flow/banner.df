{"version":1,"_note":"信息源页海报专用(tools/banner/dyn_news.py),组件不用。","actions":[{"action":"request","id":"resp","params":{"url":"https://www.v2ex.com/api/topics/hot.json","method":"GET","formatType":"json"}},{"op":"set","props":{"key":"_b","value":"1"},"_note":"⚠️ 请求屏障(勿删):request 之后紧邻的节点读不到响应(晚一拍合并)。"},{"op":"set","props":{"key":"_fail","value":"$[if::(gt::(length::(${resp[0].title}),0),0,1)]"}},{"op":"if","props":{"val":"${_fail}"},"items":[{"action":"error","params":{"errorMsg":"v2ex_unreachable"}}]},{"op":"set","props":{"key":"reNL","value":"([^\r\n])[ \t]*[\r\n]+[ \t]*([^\r\n])"},"_note":"标题清洗:换行折成一个空格(照 v2ex 组件流)。"},{"op":"set","props":{"key":"rpNL","value":"$1 $2"}},{"op":"set","props":{"key":"at","value":"$[formatDate::(${@time.nowMs},HH:mm)]"},"_note":"榜单没有数据时间字段,用取数时刻作时间锚。"},{"op":"set","props":{"key":"t0","value":"$[replaceAll::(replaceAll::(${resp[0].title},${reNL},${rpNL}),${reNL},${rpNL})]"}},{"op":"set","props":{"key":"s0","value":"$[parseNumber::(${resp[0].replies},0)]"}},{"op":"set","props":{"key":"g0","value":"$[if::(startsWith::(${@app.language},zh),${resp[0].node.title},findNotEmpty::(${resp[0].node.title_alternative},${resp[0].node.title}))]"},"_note":"节点名:中文界面用中文名,其余用英文名(照组件流 g0)。"},{"op":"set","props":{"key":"t1","value":"$[replaceAll::(replaceAll::(${resp[1].title},${reNL},${rpNL}),${reNL},${rpNL})]"}},{"op":"set","props":{"key":"s1","value":"$[parseNumber::(${resp[1].replies},0)]"}},{"op":"set","props":{"key":"g1","value":"$[if::(startsWith::(${@app.language},zh),${resp[1].node.title},findNotEmpty::(${resp[1].node.title_alternative},${resp[1].node.title}))]"},"_note":"节点名:中文界面用中文名,其余用英文名(照组件流 g0)。"},{"op":"set","props":{"key":"t2","value":"$[replaceAll::(replaceAll::(${resp[2].title},${reNL},${rpNL}),${reNL},${rpNL})]"}},{"op":"set","props":{"key":"s2","value":"$[parseNumber::(${resp[2].replies},0)]"}},{"op":"set","props":{"key":"g2","value":"$[if::(startsWith::(${@app.language},zh),${resp[2].node.title},findNotEmpty::(${resp[2].node.title_alternative},${resp[2].node.title}))]"},"_note":"节点名:中文界面用中文名,其余用英文名(照组件流 g0)。"},{"op":"set","props":{"key":"t3","value":"$[replaceAll::(replaceAll::(${resp[3].title},${reNL},${rpNL}),${reNL},${rpNL})]"}},{"op":"set","props":{"key":"s3","value":"$[parseNumber::(${resp[3].replies},0)]"}},{"op":"set","props":{"key":"g3","value":"$[if::(startsWith::(${@app.language},zh),${resp[3].node.title},findNotEmpty::(${resp[3].node.title_alternative},${resp[3].node.title}))]"},"_note":"节点名:中文界面用中文名,其余用英文名(照组件流 g0)。"},{"op":"set","props":{"key":"ok","value":"$[if::(gt::(length::(${t0}),0),1,0)]"}},{"action":"resultFilter","params":{"keys":["ok","at","t0","s0","g0","t1","s1","g1","t2","s2","g2","t3","s3","g3"]}}]}
