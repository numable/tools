      }
    },
    {
      "op": "set",
      "props": {
        "key": "a3",
        "value": "$[round::(if::(lt::(${am3},60),${am3},if::(lt::(${am3},2880),floor::(calc::(${am3}/60)),floor::(calc::(${am3}/1440)))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "u3",
        "value": "$[if::(lt::(${am3},60),1,if::(lt::(${am3},2880),2,3))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "r4",
        "value": "$[replaceAll::(replaceAll::(${resp[4].title},${reNL},${rpNL}),${reNL},${rpNL})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t4L",
        "value": "$[length::(${r4})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t4N",
        "value": "$[length::(replaceAll::(${r4},${reAs},))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t4W",
        "value": "$[round::(calc::(${t4L}+${t4N}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t4K",
        "value": "$[round::(min::(floor::(calc::(${t4L}*80/max::(${t4W},1))),${t4L}))]"
      },
      "_note": "截到第几个字:按本条的平均字宽把预算折成字数。round 是为了 Android 上 floor 返回 double。"
    },
    {
      "op": "set",
      "props": {
        "key": "t4",
        "value": "$[if::(gt::(${t4W},80),connect::(replaceAll::(subString::(${r4},0,${t4K}),${reTp},),…),${r4})]"
      },
      "_note": "超出 80 个宽度单位才截:按词退一格、剥句尾标点、补「…」(线上宿主的文本节点出不了省略号)。"
    },
    {
      "op": "set",
      "props": {
        "key": "l4",
        "value": "$[if::(le::(${t4W},36),1,2)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "s4",
        "value": "${resp[4].replies}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "gr4",
        "value": "$[if::(startsWith::(${@app.language},zh),${resp[4].node.title},findNotEmpty::(${resp[4].node.title_alternative},${resp[4].node.title}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "g4L",
        "value": "$[length::(${gr4})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "g4N",
        "value": "$[length::(replaceAll::(${gr4},${reAs},))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "g4W",
        "value": "$[round::(calc::(${g4L}+${g4N}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "g4K",
        "value": "$[round::(min::(floor::(calc::(${g4L}*24/max::(${g4W},1))),${g4L}))]"
      },
      "_note": "截到第几个字:按本条的平均字宽把预算折成字数。round 是为了 Android 上 floor 返回 double。"
    },
    {
      "op": "set",
      "props": {
        "key": "g4",
        "value": "$[if::(gt::(${g4W},24),connect::(replaceAll::(replaceAll::(subString::(${gr4},0,${g4K}),${reTl},),${reTp},),…),${gr4})]"
      },
      "_note": "超出 24 个宽度单位才截:按词退一格、剥句尾标点、补「…」(线上宿主的文本节点出不了省略号)。"
    },
    {
      "op": "set",
      "props": {
        "key": "b4",
        "value": "$[parseNumber::(max::(calc::(findNotEmpty::(${s4},0)*1.25*70.0/(findNotEmpty::(${s4},0)+${vmax}/4)),6),0.0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "am4",
        "value": "$[max::(floor::(calc::((${tzNow}/1000-${resp[4].created})/60)),1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "a4",
        "value": "$[round::(if::(lt::(${am4},60),${am4},if::(lt::(${am4},2880),floor::(calc::(${am4}/60)),floor::(calc::(${am4}/1440)))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "u4",
        "value": "$[if::(lt::(${am4},60),1,if::(lt::(${am4},2880),2,3))]"
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "at",
          "t0",
          "l0",
          "s0",
          "g0",
          "b0",
          "a0",
          "u0",
          "t1",
          "l1",
          "s1",
          "g1",
          "b1",
          "a1",
          "u1",
          "t2",
          "l2",
          "s2",
          "g2",
          "b2",
          "a2",
          "u2",
          "t3",
          "l3",
          "s3",
          "g3",
          "b3",
          "a3",
          "u3",
          "t4",
          "l4",
          "s4",
          "g4",
          "b4",
          "a4",
          "u4"
        ]
      }
    }
  ]
}
