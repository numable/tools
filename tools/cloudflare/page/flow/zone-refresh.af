{
  "_note": "下拉刷新 = 整页穿透:zone.df 当前键 + 三块 Canvas 键同删。生成器 gen_cloudflare.py。",
  "version": 1,
  "actions": [
    {
      "_note": "点下去先震一下:RCN 没有按压态,重载要 ~250ms 才有画面变化(G22)。",
      "action": "ui.haptic"
    },
    {
      "id": "curKey",
      "action": "data.get",
      "params": {
        "key": "c.cf.zone._cur",
        "default": ""
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k",
        "value": "${curKey}"
      }
    },
    {
      "_note": "空键 = zone.df 还没跑完过一次(盘上也没有缓存),不删也照样是真取数。",
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${k}),0),1,0)]"
      },
      "items": [
        {
          "action": "data.remove",
          "params": {
            "key": "${k}"
          }
        },
        {
          "action": "data.remove",
          "params": {
            "key": "$[connect::(${k},_t)]"
          }
        },
        {
          "action": "data.remove",
          "params": {
            "key": "$[connect::(${k},_c)]"
          }
        },
        {
          "action": "data.remove",
          "params": {
            "key": "$[connect::(${k},_m)]"
          }
        }
      ]
    },
    {
      "_note": "无条件重载。⚠️ `onRefresh` 一旦声明就完全接管下拉,这句漏了就永远刷不动。",
      "action": "xpage.reloadPage"
    }
  ]
}
