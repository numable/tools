{
  "_note": "首页加卡:六张卡**全都无参数** —— 「Cloudflare 现在怎么样」对每个用户是同一个答案,不需要先选对象(§8.1 的分类判据)。\n⚠️ 不落盘:落盘只发生在面板里的原生按钮上,所以流里别接「已添加」。",
  "version": 1,
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "op": "set",
      "props": {
        "key": "picks",
        "value": [
          {
            "id": "regions"
          },
          {
            "id": "incidents"
          },
          {
            "id": "status"
          },
          {
            "id": "edge"
          },
          {
            "id": "next"
          },
          {
            "id": "board"
          }
        ]
      }
    },
    {
      "action": "widget.pick",
      "params": {
        "items": "${picks}"
      }
    }
  ]
}
