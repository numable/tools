{
  "_note": "zone 详情页加卡:四张卡**各带这个 zone 的 id/name**(§8.1 判据:要先指定对象的卡挂详情页)。\n⚠️ `${zoneId}` / `${zoneName}` 由节点 events 的 params 传入(页面 ambient scope 的路由 query)。",
  "version": 1,
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "op": "set",
      "props": {
        "key": "picks",
        "value": [
          {
            "id": "traffic",
            "params": {
              "zoneId": "${zoneId}",
              "zoneName": "${zoneName}"
            }
          },
          {
            "id": "mix",
            "params": {
              "zoneId": "${zoneId}",
              "zoneName": "${zoneName}"
            }
          },
          {
            "id": "cache",
            "params": {
              "zoneId": "${zoneId}",
              "zoneName": "${zoneName}"
            }
          },
          {
            "id": "trend",
            "params": {
              "zoneId": "${zoneId}",
              "zoneName": "${zoneName}"
            }
          }
        ]
      }
    },
    {
      "action": "widget.pick",
      "params": {
        "items": "${picks}"
      }
    }
  ]
}
