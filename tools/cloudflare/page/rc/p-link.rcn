{
  "_note": "外链官方状态页。⚠️ 箭头是**内联矢量**(Phosphor arrow-up-right,MIT,viewBox 0 0 256 256),不是 `↗` 字符 —— 字符图标在四端字体里渲不渲得出来纯属运气,而且静默留白(§4.2b,github 包踩过)。",
  "rc": {
    "cells": [
      { "id": "bg", "type": "layer", "x": "0pt", "y": "0pt", "w": "{parent.w}", "h": "{parent.h}",
        "cornerRadius": { "leftT": "14pt", "leftB": "14pt", "rightT": "14pt", "rightB": "14pt" },
        "bgColor": "#FFFFFF|#15171A" },
      { "id": "t", "type": "txt", "x": "14pt", "y": "20pt", "w": "{parent.w}-52pt", "h": "-1",
        "text": "${@i18n.open}", "fontSize": "13pt", "typeface": "System-Bold",
        "textColor": "#F38020|#FBAD41", "maxLines": "1" },
      { "id": "arrow", "type": "path", "x": "{parent.w}-32pt", "y": "19pt", "w": "14pt", "h": "14pt",
        "d": "M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z",
        "viewBox": "0 0 256 256", "fillColor": "#F38020|#FBAD41" }
    ],
    "i18n": {
      "zh-CN": { "open": "打开官方状态页" },
      "en-US": { "open": "Open the official status page" }
    }
  }
}
