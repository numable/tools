{
  "_note": "页面块:由 gen_cloudflare.py 从同名组件卡派生(卡底换页面卡),与卡同源、改卡即改块。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "id": "srcdot",
        "type": "layer",
        "x": "14pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#F38020|#FBAD41"
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "23pt",
        "y": "12pt",
        "w": "{parent.w}-97pt",
        "h": "-1",
        "text": "${@i18n.t24}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "{parent.w}-60pt",
        "y": "15pt",
        "w": "46pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "alignmentH": "2",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),0,1)]"
        },
        "react": [
          {
            "id": "bigE",
            "type": "txt",
            "x": "14pt",
            "y": "43.8pt",
            "w": "100pt",
            "h": "-1",
            "text": "--",
            "fontSize": "26pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ready},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "id": "stN",
            "type": "txt",
            "x": "14pt",
            "y": "72pt",
            "w": "{parent.w}-28pt",
            "h": "-1",
            "text": "${@i18n.unbound}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ready},__none__),__none__),0,if::(eq::(${ready},1),0,1))]"
        },
        "react": [
          {
            "id": "stF",
            "type": "txt",
            "x": "14pt",
            "y": "72pt",
            "w": "{parent.w}-28pt",
            "h": "-1",
            "text": "${@i18n.failed}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),1,0)]"
        },
        "react": [
          {
            "id": "big",
            "type": "richText",
            "x": "14pt",
            "y": "36pt",
            "w": "{parent.w}-150pt",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "$[findNotEmpty::(${curS},--)]",
                "fontSize": "26pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "4pt"
              },
              {
                "text": "${@i18n.reqU}",
                "fontSize": "11pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          },
          {
            "id": "thrW",
            "type": "txt",
            "x": "{parent.w}-134pt",
            "y": "44pt",
            "w": "120pt",
            "h": "-1",
            "text": "${@i18n.thr}$[findNotEmpty::(${thrS},--)] · ${@i18n.peak}$[findNotEmpty::(${pkS},--)]",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "alignmentH": "2"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),if::(eq::(findNotEmpty::(${chg},__none__),__none__),0,1),0)]"
        },
        "react": [
          {
            "id": "triW",
            "type": "path",
            "x": "14pt",
            "y": "67pt",
            "w": "8pt",
            "h": "5.28pt",
            "d": "$[if::(eq::(${up},1),M128 64 L240 192 L16 192 Z,M128 192 L16 64 L240 64 Z)]",
            "viewBox": "0 0 256 256",
            "fillColor": "#6B7280|#8E939B"
          },
          {
            "id": "chgW",
            "type": "txt",
            "x": "25pt",
