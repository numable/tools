{
  "_note": "两个列表各自的空态。⚠️「没有进行中的事件」是**好消息**、不是取数失败,所以文案不能写成「暂无数据」那种坏味道 —— 这一条正是整个包最常见的状态。",
  "rc": {
    "cells": [
      { "id": "bg", "type": "layer", "x": "0pt", "y": "0pt", "w": "{parent.w}", "h": "{parent.h}",
        "cornerRadius": { "leftT": "14pt", "leftB": "14pt", "rightT": "14pt", "rightB": "14pt" },
        "bgColor": "#FFFFFF|#15171A" },
      {
        "type": "op", "action": "if", "props": { "val": "$[if::(eq::(${k},inc),1,0)]" },
        "react": [
          { "type": "txt", "x": "14pt", "y": "24.5pt", "w": "{parent.w}-28pt", "h": "-1",
            "text": "${@i18n.noInc}", "fontSize": "12pt", "alignmentH": "1",
            "textColor": "#6B7280|#8E939B", "maxLines": "1" }
        ]
      },
      {
        "type": "op", "action": "if", "props": { "val": "$[if::(eq::(${k},maint),1,0)]" },
        "react": [
          { "type": "txt", "x": "14pt", "y": "24.5pt", "w": "{parent.w}-28pt", "h": "-1",
            "text": "${@i18n.noMaint}", "fontSize": "12pt", "alignmentH": "1",
            "textColor": "#6B7280|#8E939B", "maxLines": "1" }
        ]
      }
    ],
    "i18n": {
      "zh-CN": { "noInc": "当前没有进行中的事件", "noMaint": "暂无计划维护" },
      "en-US": { "noInc": "No open incidents right now", "noMaint": "No scheduled maintenance" }
    }
  }
}
