{
  "_note": "首页「我的域名」的一行 → 点进 /zone。状态点用 Cloudflare 的 zone `status`(active/pending/moved…),不是我们编的档位。",
  "rc": {
    "cells": [
      { "id": "bg", "type": "layer", "x": "0pt", "y": "0pt", "w": "{parent.w}", "h": "{parent.h}",
        "cornerRadius": { "leftT": "14pt", "leftB": "14pt", "rightT": "14pt", "rightB": "14pt" },
        "bgColor": "#FFFFFF|#15171A" },
      { "id": "dot", "type": "layer", "x": "14pt", "y": "16pt", "w": "8pt", "h": "8pt",
        "cornerRadius": { "leftT": "4pt", "leftB": "4pt", "rightT": "4pt", "rightB": "4pt" },
        "bgColor": "$[if::(eq::(${st},active),#1FC77D|#1FC77D,#F38020|#FBAD41)]" },
      { "id": "n", "type": "txt", "x": "30pt", "y": "15pt", "w": "{parent.w}-60pt", "h": "-1",
        "text": "$[findNotEmpty::(${n},--)]", "fontSize": "13pt", "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6", "maxLines": "1" },
      { "id": "sub", "type": "txt", "x": "30pt", "y": "36pt", "w": "{parent.w}-60pt", "h": "-1",
        "text": "$[findNotEmpty::(${st},--)] · $[findNotEmpty::(${pl},--)]", "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B", "maxLines": "1" },
      { "id": "caret", "type": "path", "x": "{parent.w}-28pt", "y": "23pt", "w": "14pt", "h": "14pt",
        "d": "M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z",
        "viewBox": "0 0 256 256", "fillColor": "#6B7280|#8E939B" }
    ],
    "i18n": { "zh-CN": {}, "en-US": {} }
  }
}
