{
  "_note": "一条进行中事件。行首圆点的颜色由 Statuspage 的 `impact` 一条嵌套表达式产出(§4.5 第 2 条),不为每档各摞一个 op:if。\n⚠️ 事件标题是**数据**,恒英文原样显示 —— 标准 §6「数据本身不本地化」(A 路线)。要本地化就得把 locale 做成显式取数输入,本包不做。",
  "rc": {
    "cells": [
      { "id": "bg", "type": "layer", "x": "0pt", "y": "0pt", "w": "{parent.w}", "h": "{parent.h}",
        "cornerRadius": { "leftT": "14pt", "leftB": "14pt", "rightT": "14pt", "rightB": "14pt" },
        "bgColor": "#FFFFFF|#15171A" },
      { "id": "dot", "type": "layer", "x": "14pt", "y": "15pt", "w": "8pt", "h": "8pt",
        "cornerRadius": { "leftT": "4pt", "leftB": "4pt", "rightT": "4pt", "rightB": "4pt" },
        "bgColor": "$[if::(eq::(${imp},critical),#FF5C4D|#FF5C4D,if::(eq::(${imp},major),#FF5C4D|#FF5C4D,if::(eq::(${imp},minor),#F38020|#FBAD41,#6B7280|#8E939B)))]" },
      { "id": "n", "type": "txt", "x": "30pt", "y": "14.5pt", "w": "{parent.w}-44pt", "h": "-1",
        "text": "$[findNotEmpty::(${n},--)]", "fontSize": "13pt", "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6", "maxLines": "1" },
      { "id": "d", "type": "txt", "x": "30pt", "y": "35.5pt", "w": "{parent.w}-44pt", "h": "-1",
        "text": "${@i18n.updated} $[findNotEmpty::(${d},--)]", "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B", "maxLines": "1" }
    ],
    "i18n": {
      "zh-CN": { "updated": "更新于" },
      "en-US": { "updated": "Updated" }
    }
  }
}
