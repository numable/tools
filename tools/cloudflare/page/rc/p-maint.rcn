{
  "_note": "一条计划维护。命中你自己边缘节点时:左边缘一道源色短竖线 + 右侧「你的节点」标记(与 board 卡的行逐字同形 —— 首页与卡片同源,§4.2b 末段)。\n⚠️ 竖线 y 从 18 到 42,落在 14pt 圆角之外的直边段上。\n⚠️ 时间恒标 UTC,理由见 flow/next.df。",
  "rc": {
    "cells": [
      { "id": "bg", "type": "layer", "x": "0pt", "y": "0pt", "w": "{parent.w}", "h": "{parent.h}",
        "cornerRadius": { "leftT": "14pt", "leftB": "14pt", "rightT": "14pt", "rightB": "14pt" },
        "bgColor": "#FFFFFF|#15171A" },
      {
        "type": "op", "action": "if", "props": { "val": "$[if::(eq::(${hit},1),1,0)]" },
        "react": [
          { "type": "layer", "x": "0pt", "y": "18pt", "w": "3pt", "h": "24pt",
            "cornerRadius": { "leftT": "1.5pt", "leftB": "1.5pt", "rightT": "1.5pt", "rightB": "1.5pt" },
            "bgColor": "#F38020|#FBAD41" },
          { "type": "txt", "x": "{parent.w}-86pt", "y": "16.5pt", "w": "72pt", "h": "-1",
            "text": "${@i18n.yours}", "fontSize": "10pt", "typeface": "System-Bold",
            "alignmentH": "2", "textColor": "#F38020|#FBAD41", "maxLines": "1" }
        ]
      },
      { "id": "n", "type": "txt", "x": "14pt", "y": "15pt", "w": "{parent.w}-104pt", "h": "-1",
        "text": "$[findNotEmpty::(${n},--)]", "fontSize": "13pt", "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6", "maxLines": "1" },
      { "id": "d", "type": "txt", "x": "14pt", "y": "36pt", "w": "{parent.w}-28pt", "h": "-1",
        "text": "$[findNotEmpty::(${d},--)] $[findNotEmpty::(${t},--)] UTC", "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B", "maxLines": "1" }
    ],
    "i18n": {
      "zh-CN": { "yours": "你的节点" },
      "en-US": { "yours": "Your PoP" }
    }
  }
}
