        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mTotal},--),--),0,1)]"
        },
        "react": [
          {
            "id": "n1",
            "type": "txt",
            "x": "8pt+({parent.w}-16pt)/3",
            "y": "88pt",
            "w": "({parent.w}-16pt)/3",
            "h": "-1",
            "text": "$[findNotEmpty::(${mTotal},--)]",
            "fontSize": "26pt",
            "alignmentH": "1",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mTotal},--),--),1,0)]"
        },
        "react": [
