{
  "rc": {
    "cells": [
      {
        "id": "brand",
        "type": "txt",
        "x": "0pt",
        "y": "3pt",
        "w": "{parent.w}-90pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "24pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "_note": "y=3:txt 盒顶 = 字形 ink 顶,下移 3pt 让标题 ink 中线对齐 26pt 高的时效锚中线(锚提到负 y 会被画布顶边裁掉)。"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "{parent.w}-{at.w}",
        "y": "0pt",
        "w": "-1",
        "h": "26pt",
        "alignmentV": "1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "12pt",
        "typeface": "System",
        "textColor": "#6B7280|#8E939B",
        "bgColor": "#0E0E1116|#14F3F4F6",
        "paddingLeft": "26pt",
        "paddingRight": "10pt",
        "cornerRadius": {
          "leftT": "13pt",
          "leftB": "13pt",
          "rightT": "13pt",
          "rightB": "13pt"
        },
        "_note": "时效锚(page-design-system §1.1)—— 由 tools/infosource/mk_anchor.py rcn_nodes() 生成,改规格改那里。",
        "events": {
          "onClick": "@[file://page/flow/refresh.af]"
        }
      },
      {
        "id": "atIc",
        "type": "path",
        "x": "{at.x}+8pt",
        "y": "{at.y}+6.5pt",
        "w": "13pt",
        "h": "13pt",
        "viewBox": "0 0 256 256",
        "d": "M224,48V96a8,8,0,0,1-8,8H168a8,8,0,0,1,0-16h28.69L182.06,73.37a79.56,79.56,0,0,0-56.13-23.43h-.45A79.52,79.52,0,0,0,69.59,72.71,8,8,0,0,1,58.41,61.27a96,96,0,0,1,135,.79L208,76.69V48a8,8,0,0,1,16,0ZM186.41,183.29a80,80,0,0,1-112.47-.66L59.31,168H88a8,8,0,0,0,0-16H40a8,8,0,0,0-8,8v48a8,8,0,0,0,16,0V179.31l14.63,14.63A95.43,95.43,0,0,0,130,222.06h.53a95.36,95.36,0,0,0,67.07-27.33,8,8,0,0,0-11.18-11.44Z",
        "fillColor": "#6B7280|#8E939B"
      },
      {
        "id": "chip",
        "type": "layer",
        "x": "0pt",
        "y": "34pt",
        "w": "{parent.w}",
        "h": "32pt",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        },
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "14pt",
        "y": "46pt",
        "w": "8pt",
        "h": "8pt",
        "cornerRadius": {
          "leftT": "4pt",
          "leftB": "4pt",
          "rightT": "4pt",
          "rightB": "4pt"
        },
        "bgColor": "$[if::(eq::(${lv},0),#1FC77D|#1FC77D,if::(eq::(${lv},1),#F38020|#FBAD41,if::(eq::(${lv},2),#F38020|#FBAD41,if::(eq::(${lv},3),#FF5C4D|#FF5C4D,#6B7280|#8E939B))))]"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${lv},0),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "30pt",
            "y": "44pt",
            "w": "{parent.w}-44pt",
            "h": "-1",
            "text": "${@i18n.stOk}",
            "fontSize": "13pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${lv},1),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "30pt",
            "y": "44pt",
            "w": "{parent.w}-44pt",
            "h": "-1",
            "text": "${@i18n.stMaint}",
            "fontSize": "13pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${lv},2),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "30pt",
            "y": "44pt",
            "w": "{parent.w}-44pt",
            "h": "-1",
            "text": "${@i18n.stMinor}",
            "fontSize": "13pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${lv},3),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "30pt",
            "y": "44pt",
            "w": "{parent.w}-44pt",
            "h": "-1",
            "text": "${@i18n.stMajor}",
            "fontSize": "13pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(ge::(findNotEmpty::(${lv},-1),0),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "30pt",
            "y": "44pt",
            "w": "{parent.w}-44pt",
            "h": "-1",
            "text": "${@i18n.stUnknown}",
            "fontSize": "13pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "id": "tile0",
        "type": "layer",
        "x": "0pt",
        "y": "74pt",
        "w": "({parent.w}-16pt)/3",
        "h": "72pt",
        "cornerRadius": {
          "leftT": "12pt",
          "leftB": "12pt",
          "rightT": "12pt",
          "rightB": "12pt"
        },
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${nInc},--),--),0,1)]"
        },
        "react": [
          {
            "id": "n0",
            "type": "txt",
            "x": "0pt",
            "y": "88pt",
            "w": "({parent.w}-16pt)/3",
            "h": "-1",
            "text": "$[findNotEmpty::(${nInc},--)]",
            "fontSize": "26pt",
            "alignmentH": "1",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${nInc},--),--),1,0)]"
        },
        "react": [
          {
            "id": "n0E",
            "type": "txt",
            "x": "0pt",
            "y": "95.75pt",
            "w": "({parent.w}-16pt)/3",
            "h": "-1",
            "text": "--",
            "fontSize": "26pt",
            "alignmentH": "1",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1"
          }
        ]
      },
      {
        "id": "l0",
        "type": "txt",
        "x": "0pt",
        "y": "122pt",
        "w": "({parent.w}-16pt)/3",
        "h": "-1",
        "text": "${@i18n.openIncidents}",
        "fontSize": "11pt",
        "alignmentH": "1",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "id": "tile1",
        "type": "layer",
        "x": "8pt+({parent.w}-16pt)/3",
        "y": "74pt",
        "w": "({parent.w}-16pt)/3",
        "h": "72pt",
        "cornerRadius": {
          "leftT": "12pt",
          "leftB": "12pt",
          "rightT": "12pt",
          "rightB": "12pt"
        },
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "type": "op",
