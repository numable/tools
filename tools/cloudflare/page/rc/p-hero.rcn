      {
        "id": "l1",
        "type": "txt",
        "x": "8pt+({parent.w}-16pt)/3",
        "y": "122pt",
        "w": "({parent.w}-16pt)/3",
        "h": "-1",
        "text": "${@i18n.planned}",
        "fontSize": "11pt",
        "alignmentH": "1",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "id": "tile2",
        "type": "layer",
        "x": "16pt+2*({parent.w}-16pt)/3",
        "y": "74pt",
        "w": "({parent.w}-16pt)/3",
        "h": "72pt",
        "cornerRadius": {
          "leftT": "12pt",
          "leftB": "12pt",
          "rightT": "12pt",
          "rightB": "12pt"
        },
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${colo},--),--),0,1)]"
        },
        "react": [
          {
            "_note": "整页唯一上源色的那个数:你自己的边缘节点 —— 这是这一页里跟「你」有关的唯一结论(§4.2a 第 2 条)。",
            "id": "n2",
            "type": "txt",
            "x": "16pt+2*({parent.w}-16pt)/3",
            "y": "88pt",
            "w": "({parent.w}-16pt)/3",
            "h": "-1",
            "text": "$[findNotEmpty::(${colo},--)]",
            "fontSize": "26pt",
            "alignmentH": "1",
            "typeface": "System-Bold",
            "textColor": "#F38020|#FBAD41",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${colo},--),--),1,0)]"
        },
        "react": [
          {
            "_note": "整页唯一上源色的那个数:你自己的边缘节点 —— 这是这一页里跟「你」有关的唯一结论(§4.2a 第 2 条)。",
            "id": "n2E",
            "type": "txt",
            "x": "16pt+2*({parent.w}-16pt)/3",
            "y": "95.75pt",
            "w": "({parent.w}-16pt)/3",
            "h": "-1",
            "text": "--",
            "fontSize": "26pt",
            "alignmentH": "1",
            "typeface": "System-Bold",
            "textColor": "#F38020|#FBAD41",
            "maxLines": "1"
          }
        ]
      },
      {
        "id": "l2",
        "type": "txt",
        "x": "16pt+2*({parent.w}-16pt)/3",
        "y": "122pt",
        "w": "({parent.w}-16pt)/3",
        "h": "-1",
        "text": "${@i18n.yourPop}",
        "fontSize": "11pt",
        "alignmentH": "1",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      }
    ],
    "_i18nNote": "页头三段(§1):大标题 + 右上角带底胶囊(时效锚)+ 副标那一行 = 状态 chip。\n原来副标是一句描述 + 数据来源,已删 —— 来源在页脚说,状态由 chip 说。",
    "i18n": {
      "zh-CN": {
        "brand": "Cloudflare 状态哨",
        "openIncidents": "进行中事件",
        "planned": "计划维护",
        "yourPop": "你的节点",
        "stOk": "运行正常",
        "stMaint": "维护中",
        "stMinor": "局部异常",
        "stMajor": "服务故障",
        "stUnknown": "状态未知"
      },
      "en-US": {
        "brand": "Cloudflare Watch",
        "openIncidents": "Open incidents",
        "planned": "Planned",
        "yourPop": "Your PoP",
        "stOk": "Operational",
        "stMaint": "Maintenance",
        "stMinor": "Partial outage",
        "stMajor": "Major outage",
        "stUnknown": "Unknown"
      }
    }
