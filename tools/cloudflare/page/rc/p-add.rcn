      {
        "id": "tag",
        "type": "txt",
        "x": "221pt",
        "y": "30.5pt",
        "w": "26pt",
        "h": "-1",
        "text": "${tag}",
        "fontSize": "11pt",
        "alignmentH": "2",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "id": "btnBg",
        "type": "txt",
        "x": "{parent.w}-78pt",
        "y": "19pt",
        "w": "64pt",
        "h": "28pt",
        "text": "${@i18n.add}",
        "fontSize": "12pt",
        "typeface": "System-Bold",
        "alignmentH": "1",
        "textColor": "#FFFFFF|#FFFFFF",
        "maxLines": "1",
        "alignmentV": "1",
        "bgColor": "#F38020|#FBAD41",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      }
    ],
    "i18n": {
      "zh-CN": {
        "add": "＋ 添加",
        "statusT": "Cloudflare 状态",
        "statusD": "全局服务状态 + 进行中事件数",
        "edgeT": "我的边缘节点",
        "edgeD": "你正连着哪个数据中心",
        "nextT": "下一场维护",
        "nextD": "时间 · 时长 · 影响组件",
        "boardT": "维护日程",
        "boardD": "状态条 + 最近 5 场,命中你的节点会标出来",
        "trafficT": "今日流量",
        "trafficD": "这个域名今天的请求数与访客",
        "cacheT": "缓存效果",
        "cacheD": "近 7 天命中率 · 请求数 · 已缓存 MB",
        "trendT": "请求趋势",
        "trendD": "近 30 天每日请求柱状图"
      },
      "en-US": {
        "add": "+ Add",
        "statusT": "Cloudflare status",
        "statusD": "Global status + open incident count",
        "edgeT": "My edge PoP",
        "edgeD": "Which data center you're connected to",
        "nextT": "Next maintenance",
        "nextD": "Time · duration · components",
        "boardT": "Maintenance board",
        "boardD": "Status bar + next 5, yours highlighted",
        "trafficT": "Requests today",
        "trafficD": "Today's requests and visitors for this zone",
        "cacheT": "Cache",
        "cacheD": "7-day hit rate · requests · cached MB",
        "trendT": "Request trend",
        "trendD": "Daily requests over the last 30 days"
