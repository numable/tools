{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        },
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${k},status),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "14pt",
            "y": "13pt",
            "w": "{parent.w}-130pt",
            "h": "-1",
            "text": "${@i18n.statusT}",
            "fontSize": "14pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1"
          },
          {
            "type": "txt",
            "x": "14pt",
            "y": "34pt",
            "w": "{parent.w}-130pt",
            "h": "-1",
            "text": "${@i18n.statusD}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${k},edge),1,0)]"
