{
  "_note": "首页上「连接我的 Cloudflare 账号」入口(→ /settings)。两态:未配置=引导,已配置=状态。\n⚠️ 页面拿到的只有 `hasToken` 布尔,拿不到令牌本体(§3.6 实现纪律第 1 条)—— 所以这里能画的也只有「配没配」。\n⚠️ 箭头是内联矢量(Phosphor caret-right),不是 `›` 字符(§4.2b)。",
  "rc": {
    "cells": [
      { "id": "bg", "type": "layer", "x": "0pt", "y": "0pt", "w": "{parent.w}", "h": "{parent.h}",
        "cornerRadius": { "leftT": "14pt", "leftB": "14pt", "rightT": "14pt", "rightB": "14pt" },
        "bgColor": "#FFFFFF|#15171A" },
      { "id": "t", "type": "txt", "x": "14pt", "y": "15.5pt", "w": "{parent.w}-52pt", "h": "-1",
        "text": "${@i18n.title}", "fontSize": "14pt", "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6", "maxLines": "1" },
      {
        "type": "op", "action": "if", "props": { "val": "$[if::(eq::(${hasToken},1),0,1)]" },
        "react": [
          { "type": "txt", "x": "14pt", "y": "36.5pt", "w": "{parent.w}-52pt", "h": "-1",
            "text": "${@i18n.off}", "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B", "maxLines": "1" }
        ]
      },
      {
        "type": "op", "action": "if", "props": { "val": "$[if::(eq::(${hasToken},1),1,0)]" },
        "react": [
          { "type": "txt", "x": "14pt", "y": "36.5pt", "w": "{parent.w}-52pt", "h": "-1",
            "text": "${@i18n.on}", "fontSize": "11pt",
            "textColor": "#F38020|#FBAD41", "maxLines": "1" }
        ]
      },
      { "id": "caret", "type": "path", "x": "{parent.w}-28pt", "y": "24pt", "w": "14pt", "h": "14pt",
        "d": "M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z",
        "viewBox": "0 0 256 256", "fillColor": "#6B7280|#8E939B" }
    ],
    "i18n": {
      "zh-CN": { "title": "我的 Cloudflare 账号", "off": "可选 · 连接后可看你自己的域名", "on": "已连接 · 只读令牌存在本机" },
      "en-US": { "title": "My Cloudflare account", "off": "Optional — connect to see your own zones", "on": "Connected · read-only token on this device" }
    }
  }
}
