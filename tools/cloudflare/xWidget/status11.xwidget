{
  "_note": "Cloudflare 状态 · 11 微档(2026-10-04)。无参数(同 22 档 status),复用 status.df。",
  "version": 2,
  "title": "Cloudflare 状态",
  "sub": "一格 · 此刻正常吗、几起进行中事件",
  "i18n": {
    "en-US": {
      "title": "Cloudflare status",
      "sub": "Is it up right now, and how many open incidents"
    }
  },
  "layout": 11,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/status11.rcn]",
    "depends": [
      "@[file://flow/status.df]"
    ],
    "refresh": {
      "interval": [
        "120"
      ]
    }
  },
  "ai": {
    "shows": "Cloudflare 此刻是否正常与进行中事件数(一格小号)"
  }
}
