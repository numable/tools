{
  "_note": "近 14 天事故(42)。无参数、公开数据。生成器 gen_cloudflare.py。",
  "version": 2,
  "title": "近 14 天事故",
  "sub": "逐日事故数 · 进行中 · 平均恢复用时",
  "i18n": {
    "en-US": {
      "title": "Incidents · 14 days",
      "sub": "Daily count, open and time to resolve"
    }
  },
  "layout": 42,
  "params": {},
  "events": {
