{
  "_note": "下一场维护 · 21 迷你(2026-10-04)。无参数(同 42 档 next),复用 next.df。",
  "version": 2,
  "title": "下一场维护",
  "sub": "迷你 · 最近一场计划维护的日期、时刻与时长",
  "i18n": {
    "en-US": {
      "title": "Next maintenance",
      "sub": "Mini · date, start time and length of the next one"
    }
  },
  "layout": 21,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/nextmini.rcn]",
    "depends": [
      "@[file://flow/next.df]"
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "Cloudflare 最近一场计划维护的日期、开始时刻(UTC)与时长(一行)"
  }
}
