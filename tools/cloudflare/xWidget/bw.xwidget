{
  "_note": "带宽与缓存(22)。需要一个域名。复用 cache.df。生成器 gen_cloudflare.py。",
  "version": 2,
  "title": "带宽与缓存",
  "sub": "近 7 天流量 · 已缓存占比",
  "i18n": {
    "en-US": {
      "title": "Bandwidth & cache",
      "sub": "7-day bandwidth and how much was cached"
    }
  },
  "layout": 22,
  "params": {
    "zoneId": "",
    "zoneName": ""
  },
  "events": {
    "onClick": "/zone?zoneId=${zoneId}&zoneName=${zoneName}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/bw.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/cache.df]",
        "params": {
          "zoneId": "${zoneId}",
          "zoneName": "${zoneName}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "900"
      ]
    }
  },
  "ai": {
    "shows": "某个域名近 7 天总流量(字节)与其中已缓存的占比、请求命中率;需绑 Cloudflare 令牌",
    "params": {
      "zoneId": {
        "kind": "account",
        "group": [
          "zoneId",
          "zoneName"
        ],
        "hint": "用户 Cloudflare 账号里的域名(Zone)ID;留空 = 账号里第一个域名,装上后用户可在编辑页换"
      },
      "zoneName": {
        "kind": "account",
        "hint": "与 zoneId 配套的域名,只用于显示"
      }
    }
  }
}
