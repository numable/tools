{
  "_note": "维护日程(44)。顶条 = 全局状态 + 进行中事件数;下面 5 行 = 正在进行的维护(橙点 + 几点结束)+ 即将开始的(本地时间 · 时长)。取数失败(状态未知)时首行写 --,不写「暂无计划维护」。生成器 gen_cloudflare.py。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FFFBF8\\,#FEF3EB)@90|linear(#15171A\\,#191A1B\\,#211F1C)@90"
      },
      {
        "id": "srcdot",
        "type": "layer",
        "x": "14pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#F38020|#FBAD41"
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "23pt",
        "y": "12pt",
        "w": "{parent.w}-97pt",
        "h": "-1",
        "text": "${@i18n.bBrand}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "{parent.w}-60pt",
        "y": "15pt",
        "w": "46pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "alignmentH": "2",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "id": "stBar",
        "type": "layer",
        "x": "14pt",
        "y": "36pt",
        "w": "{parent.w}-28pt",
        "h": "32pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "10pt",
          "leftB": "10pt",
          "rightT": "10pt",
          "rightB": "10pt"
        }
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "24pt",
        "y": "48pt",
        "w": "8pt",
        "h": "8pt",
        "cornerRadius": {
          "leftT": "4.0pt",
          "leftB": "4.0pt",
          "rightT": "4.0pt",
          "rightB": "4.0pt"
        },
        "bgColor": "$[if::(eq::(${lv},0),#1FC77D|#1FC77D,if::(eq::(${lv},1),#F38020|#FBAD41,if::(eq::(${lv},2),#F38020|#FBAD41,if::(eq::(${lv},3),#FF5C4D|#FF5C4D,#6B7280|#8E939B))))]"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${lv},0),1,0)]"
        },
        "react": [
          {
            "id": "st0",
            "type": "txt",
            "x": "38pt",
            "y": "46.5pt",
            "w": "150pt",
            "h": "-1",
            "text": "${@i18n.stOk}",
            "fontSize": "12pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${lv},1),1,0)]"
        },
        "react": [
          {
            "id": "st1",
            "type": "txt",
            "x": "38pt",
            "y": "46.5pt",
            "w": "150pt",
            "h": "-1",
            "text": "${@i18n.stMaint}",
            "fontSize": "12pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${lv},2),1,0)]"
        },
        "react": [
          {
            "id": "st2",
            "type": "txt",
            "x": "38pt",
            "y": "46.5pt",
            "w": "150pt",
            "h": "-1",
            "text": "${@i18n.stMinor}",
            "fontSize": "12pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${lv},3),1,0)]"
        },
        "react": [
          {
            "id": "st3",
            "type": "txt",
            "x": "38pt",
            "y": "46.5pt",
            "w": "150pt",
            "h": "-1",
            "text": "${@i18n.stMajor}",
            "fontSize": "12pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(ge::(findNotEmpty::(${lv},-1),0),0,1)]"
        },
        "react": [
          {
            "id": "stU",
            "type": "txt",
            "x": "38pt",
            "y": "46.5pt",
            "w": "150pt",
            "h": "-1",
            "text": "${@i18n.stUnknown}",
            "fontSize": "12pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "id": "incs",
        "type": "txt",
        "x": "{parent.w}-186pt",
        "y": "47pt",
        "w": "162pt",
        "h": "-1",
        "text": "${@i18n.openIncidents} $[findNotEmpty::(${nInc},--)]",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "alignmentH": "2"
      },
      {
        "type": "op",
        "action": "forEach",
        "props": {
          "items": "${rows}",
          "key": "_it",
          "index": "_i"
        },
        "react": [
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(lt::(${_i},findNotEmpty::(${total},0)),1,0)]"
            },
            "react": [
              {
                "type": "op",
                "action": "set",
                "props": {
                  "key": "_y",
                  "value": "$[calc::(78+${_i}*54)]"
                }
              },
              {
                "type": "layer",
                "x": "14pt",
                "y": "${_y}pt",
                "w": "{parent.w}-28pt",
                "h": "48pt",
                "bgColor": "#E7E9EE|#20232A",
                "cornerRadius": {
                  "leftT": "10pt",
                  "leftB": "10pt",
                  "rightT": "10pt",
                  "rightB": "10pt"
                }
              },
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "$[if::(eq::(${_it.hit},1),1,0)]"
                },
                "react": [
                  {
                    "type": "layer",
                    "x": "14pt",
                    "y": "${_y}pt+12pt",
                    "w": "3pt",
                    "h": "24pt",
                    "bgColor": "#F38020|#FBAD41",
                    "cornerRadius": {
                      "leftT": "1.5pt",
                      "leftB": "1.5pt",
                      "rightT": "1.5pt",
                      "rightB": "1.5pt"
                    }
                  },
                  {
                    "id": "yours",
                    "type": "txt",
                    "x": "{parent.w}-96pt",
                    "y": "${_y}pt+11pt",
                    "w": "72pt",
                    "h": "-1",
                    "text": "${@i18n.yours}",
                    "fontSize": "10pt",
                    "textColor": "#F38020|#FBAD41",
                    "maxLines": "1",
                    "alignmentH": "2"
                  }
                ]
              },
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "$[if::(eq::(${_it.act},1),1,0)]"
                },
                "react": [
                  {
                    "type": "layer",
                    "x": "24pt",
                    "y": "${_y}pt+14pt",
                    "w": "7pt",
                    "h": "7pt",
                    "bgColor": "#F38020|#FBAD41",
                    "cornerRadius": {
                      "leftT": "3.5pt",
                      "leftB": "3.5pt",
                      "rightT": "3.5pt",
                      "rightB": "3.5pt"
                    }
                  },
                  {
                    "id": "nA",
                    "type": "txt",
                    "x": "36pt",
                    "y": "${_y}pt+10pt",
                    "w": "{parent.w}-136pt",
                    "h": "-1",
                    "text": "$[findNotEmpty::(${_it.n},--)]",
                    "fontSize": "12pt",
                    "textColor": "#0E1116|#F3F4F6",
                    "maxLines": "1",
                    "typeface": "System-Bold"
                  },
                  {
                    "id": "dA",
                    "type": "txt",
                    "x": "24pt",
                    "y": "${_y}pt+30pt",
                    "w": "{parent.w}-48pt",
                    "h": "-1",
                    "text": "$[findNotEmpty::(${_it.d},--)]",
                    "fontSize": "10pt",
                    "textColor": "#F38020|#FBAD41",
                    "maxLines": "1"
                  }
                ]
              },
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "$[if::(eq::(${_it.act},1),0,1)]"
                },
                "react": [
                  {
                    "id": "nU",
                    "type": "txt",
                    "x": "24pt",
                    "y": "${_y}pt+10pt",
                    "w": "{parent.w}-124pt",
                    "h": "-1",
                    "text": "$[findNotEmpty::(${_it.n},--)]",
                    "fontSize": "12pt",
                    "textColor": "#0E1116|#F3F4F6",
                    "maxLines": "1",
                    "typeface": "System-Bold"
                  },
                  {
                    "id": "dU",
                    "type": "txt",
                    "x": "24pt",
                    "y": "${_y}pt+30pt",
                    "w": "{parent.w}-48pt",
                    "h": "-1",
                    "text": "$[findNotEmpty::(${_it.d},--)]",
                    "fontSize": "10pt",
                    "textColor": "#6B7280|#8E939B",
                    "maxLines": "1"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(lt::(findNotEmpty::(${total},0),2),1,0)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "14pt",
            "y": "132pt",
            "w": "{parent.w}-28pt",
            "h": "48pt",
            "bgColor": "#EEF0F4|#252930",
            "cornerRadius": {
              "leftT": "10pt",
              "leftB": "10pt",
              "rightT": "10pt",
              "rightB": "10pt"
            }
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(lt::(findNotEmpty::(${total},0),3),1,0)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "14pt",
            "y": "186pt",
            "w": "{parent.w}-28pt",
            "h": "48pt",
            "bgColor": "#EEF0F4|#252930",
            "cornerRadius": {
              "leftT": "10pt",
              "leftB": "10pt",
              "rightT": "10pt",
              "rightB": "10pt"
            }
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(lt::(findNotEmpty::(${total},0),4),1,0)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "14pt",
            "y": "240pt",
            "w": "{parent.w}-28pt",
            "h": "48pt",
            "bgColor": "#EEF0F4|#252930",
            "cornerRadius": {
              "leftT": "10pt",
              "leftB": "10pt",
              "rightT": "10pt",
              "rightB": "10pt"
            }
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(lt::(findNotEmpty::(${total},0),5),1,0)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "14pt",
            "y": "294pt",
            "w": "{parent.w}-28pt",
            "h": "48pt",
            "bgColor": "#EEF0F4|#252930",
            "cornerRadius": {
              "leftT": "10pt",
              "leftB": "10pt",
              "rightT": "10pt",
              "rightB": "10pt"
            }
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(ge::(findNotEmpty::(${total},0),1),0,1)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "14pt",
            "y": "78pt",
            "w": "{parent.w}-28pt",
            "h": "48pt",
            "bgColor": "#E7E9EE|#20232A",
            "cornerRadius": {
              "leftT": "10pt",
              "leftB": "10pt",
              "rightT": "10pt",
              "rightB": "10pt"
            }
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(ge::(findNotEmpty::(${lv},-1),0),1,0)]"
            },
            "react": [
              {
                "id": "noMaint",
                "type": "txt",
                "x": "24pt",
                "y": "95pt",
                "w": "{parent.w}-48pt",
                "h": "-1",
                "text": "${@i18n.noMaint}",
                "fontSize": "11pt",
                "textColor": "#6B7280|#8E939B",
                "maxLines": "1"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(ge::(findNotEmpty::(${lv},-1),0),0,1)]"
            },
            "react": [
              {
                "id": "noData",
                "type": "txt",
                "x": "24pt",
                "y": "95pt",
                "w": "{parent.w}-48pt",
                "h": "-1",
                "text": "--",
                "fontSize": "11pt",
                "textColor": "#6B7280|#8E939B",
                "maxLines": "1"
              }
            ]
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "noMaint": "暂无计划维护",
        "bBrand": "维护日程",
        "openIncidents": "进行中事件",
        "yours": "你的节点",
        "stOk": "运行正常",
        "stMaint": "维护中",
        "stMinor": "局部异常",
        "stMajor": "服务故障",
        "stUnknown": "状态未知"
      },
      "en-US": {
        "noMaint": "No scheduled maintenance",
        "bBrand": "Maintenance",
        "openIncidents": "Open incidents",
        "yours": "Your PoP",
        "stOk": "Operational",
        "stMaint": "Maintenance",
        "stMinor": "Partial outage",
        "stMajor": "Major outage",
        "stUnknown": "Unknown"
      }
    }
  }
}
