{
  "_note": "下一场维护(21)。左 = 节点三字码(SYD),右 = 本地开始时间与时长。数据 = next.df。生成器 gen_cloudflare.py。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FFFBF8\\,#FEF3EB)@90|linear(#15171A\\,#191A1B\\,#211F1C)@90"
      },
      {
        "id": "srcdot",
        "type": "layer",
        "x": "10pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#F38020|#FBAD41"
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "90pt",
        "h": "-1",
        "text": "${@i18n.mBrandS}",
        "fontSize": "11pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "113pt",
        "y": "10.5pt",
        "w": "35pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "alignmentH": "2"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mT},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "id": "code",
            "type": "txt",
            "x": "10pt",
            "y": "26pt",
            "w": "56pt",
            "h": "-1",
            "text": "$[findNotEmpty::(${mC},${mT})]",
            "fontSize": "17pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          },
          {
            "id": "when",
            "type": "txt",
            "x": "62pt",
            "y": "26pt",
            "w": "86pt",
            "h": "-1",
            "text": "${mSD} ${mST}",
            "fontSize": "10pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold",
            "alignmentH": "2"
          },
          {
            "id": "dur",
            "type": "txt",
            "x": "62pt",
            "y": "40pt",
            "w": "86pt",
            "h": "-1",
            "text": "$[if::(startsWith::(${@app.language},zh),${mY} · ${mH} 小时,${mY} · ${mH} h)]",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "alignmentH": "2"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mT},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(eq::(${ok},1),1,0)]"
            },
            "react": [
              {
                "id": "noneT",
                "type": "txt",
                "x": "10pt",
                "y": "30pt",
                "w": "138pt",
                "h": "-1",
                "text": "${@i18n.noMaint}",
                "fontSize": "11pt",
                "textColor": "#6B7280|#8E939B",
                "maxLines": "1"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(eq::(${ok},1),0,1)]"
            },
            "react": [
              {
                "id": "codeE",
                "type": "txt",
                "x": "10pt",
                "y": "31pt",
                "w": "56pt",
                "h": "-1",
                "text": "--",
                "fontSize": "17pt",
                "textColor": "#0E1116|#F3F4F6",
                "maxLines": "1",
                "typeface": "System-Bold"
              }
            ]
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "mBrandS": "下一场维护",
        "noMaint": "暂无计划维护"
      },
      "en-US": {
        "mBrandS": "Maintenance",
        "noMaint": "No scheduled maintenance"
      }
    }
  }
}
