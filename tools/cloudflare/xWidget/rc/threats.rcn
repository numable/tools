{
  "_note": "威胁拦截(22)。近 24 小时 Cloudflare 拦下的请求数 + 占请求比例 + 逐小时柱(红)。数据 = traffic.df 已在查的 sum.threats,零新增请求。生成器 gen_cloudflare.py。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FFFBF8\\,#FEF3EB)@90|linear(#15171A\\,#191A1B\\,#211F1C)@90"
      },
      {
        "id": "srcdot",
        "type": "layer",
        "x": "12pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
