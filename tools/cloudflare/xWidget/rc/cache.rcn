{
  "_note": "缓存 · 近 7 天(42)。左:请求命中率环;右:请求数 / 流量两条对比条,各标已缓存的量与占比。未连接 / 取不到:环与轨照画、值位 --,第一条下面写一行状态。生成器 gen_cloudflare.py。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FFFBF8\\,#FEF3EB)@90|linear(#15171A\\,#191A1B\\,#211F1C)@90"
      },
      {
        "id": "srcdot",
        "type": "layer",
        "x": "14pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#F38020|#FBAD41"
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "23pt",
        "y": "12pt",
        "w": "{parent.w}-97pt",
        "h": "-1",
        "text": "$[if::(eq::(findNotEmpty::(${zname},__none__),__none__),${@i18n.cacheT},${zname} · ${@i18n.cacheT})]",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "{parent.w}-60pt",
        "y": "15pt",
        "w": "46pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "alignmentH": "2",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "id": "ringTBg",
        "type": "arc",
        "startAngle": "0",
        "sweepAngle": "360",
        "useCenter": "0",
        "lineWidth": "10.0pt",
        "strokeColor": "#D6DAE1|#2C313A",
        "x": "14pt",
        "y": "42pt",
        "w": "96pt",
        "h": "96pt"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),1,0)]"
        },
        "react": [
          {
            "id": "ring",
            "type": "arc",
            "startAngle": "-90",
            "sweepAngle": "$[findNotEmpty::(${sweep},0)]",
            "useCenter": "0",
            "lineWidth": "10.0pt",
            "lineCap": "round",
            "strokeColor": "#F38020|#FBAD41",
            "x": "14pt",
            "y": "42pt",
            "w": "96pt",
            "h": "96pt"
          }
        ]
      },
      {
        "id": "rv",
        "type": "richText",
        "x": "14pt",
        "y": "72pt",
        "w": "96pt",
        "h": "-1",
        "maxLines": "1",
        "alignmentH": "1",
        "spans": [
          {
            "text": "$[findNotEmpty::(${rateS},--)]",
            "fontSize": "22pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "text": "%",
            "fontSize": "12pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "id": "rl",
        "type": "txt",
        "x": "14pt",
        "y": "100pt",
        "w": "96pt",
        "h": "-1",
        "text": "${@i18n.hit}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "alignmentH": "1"
      },
      {
        "id": "l0",
        "type": "txt",
        "x": "132pt",
        "y": "47pt",
        "w": "90pt",
        "h": "-1",
        "text": "${@i18n.reqs}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "id": "v0",
        "type": "txt",
        "x": "{parent.w}-114pt",
        "y": "47pt",
        "w": "100pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${reqS},--)]",
        "fontSize": "12pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "alignmentH": "2"
      },
      {
        "id": "tr0",
        "type": "line",
        "x": "132pt",
        "y": "63pt",
        "w": "192.0pt",
        "h": "8.0pt",
        "points": "[4.0,4.0,188.0,4.0]",
        "lineWidth": "8.0pt",
        "lineCap": "round",
        "strokeColor": "#D6DAE1|#2C313A"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),1,0)]"
        },
        "react": [
          {
            "id": "b0",
            "type": "line",
            "x": "132pt",
            "y": "63pt",
            "w": "192.0pt",
            "h": "8.0pt",
            "points": "[4.0,4.0,$[findNotEmpty::(${xr},4.0)],4.0]",
            "lineWidth": "8.0pt",
            "lineCap": "round",
            "strokeColor": "#F38020|#FBAD41",
            "hide": "$[if::(gt::(findNotEmpty::(${rate},0),0),0,1)]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),1,0)]"
        },
        "react": [
          {
            "id": "c0",
            "type": "txt",
            "x": "132pt",
            "y": "75pt",
            "w": "{parent.w}-146pt",
            "h": "-1",
            "text": "${@i18n.cachedA}$[findNotEmpty::(${cacS},--)] · $[findNotEmpty::(${rateS},--)]%",
            "fontSize": "9.5pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ready},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "id": "stN",
            "type": "txt",
            "x": "132pt",
            "y": "75pt",
            "w": "{parent.w}-146pt",
            "h": "-1",
            "text": "${@i18n.unbound}",
            "fontSize": "9.5pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ready},__none__),__none__),0,if::(eq::(${ready},1),0,1))]"
        },
        "react": [
          {
            "id": "stF",
            "type": "txt",
            "x": "132pt",
            "y": "75pt",
            "w": "{parent.w}-146pt",
            "h": "-1",
            "text": "${@i18n.failed}",
            "fontSize": "9.5pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "id": "l1",
        "type": "txt",
        "x": "132pt",
        "y": "95pt",
        "w": "90pt",
        "h": "-1",
        "text": "${@i18n.bw}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "id": "v1",
        "type": "txt",
        "x": "{parent.w}-114pt",
        "y": "95pt",
        "w": "100pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${bytS},--)]",
        "fontSize": "12pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "alignmentH": "2"
      },
      {
        "id": "tr1",
        "type": "line",
        "x": "132pt",
        "y": "111pt",
        "w": "192.0pt",
        "h": "8.0pt",
        "points": "[4.0,4.0,188.0,4.0]",
        "lineWidth": "8.0pt",
        "lineCap": "round",
        "strokeColor": "#D6DAE1|#2C313A"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),1,0)]"
        },
        "react": [
          {
            "id": "b1",
            "type": "line",
            "x": "132pt",
            "y": "111pt",
            "w": "192.0pt",
            "h": "8.0pt",
            "points": "[4.0,4.0,$[findNotEmpty::(${xb},4.0)],4.0]",
            "lineWidth": "8.0pt",
            "lineCap": "round",
            "strokeColor": "#F38020|#FBAD41",
            "hide": "$[if::(gt::(findNotEmpty::(${brate},0),0),0,1)]"
          }
        ]
      },
      {
        "id": "c1",
        "type": "txt",
        "x": "132pt",
        "y": "123pt",
        "w": "{parent.w}-146pt",
        "h": "-1",
        "text": "${@i18n.cachedA}$[findNotEmpty::(${cbyS},--)] · $[findNotEmpty::(${brateS},--)]%",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      }
    ],
    "i18n": {
      "zh-CN": {
        "cacheT": "缓存 · 近 7 天",
        "hit": "命中",
        "reqs": "请求",
        "bw": "流量",
        "cachedA": "已缓存 ",
        "unbound": "还没连接 Cloudflare 账号",
        "failed": "暂时取不到数据"
      },
      "en-US": {
        "cacheT": "Cache · 7 days",
        "hit": "Hit",
        "reqs": "Requests",
        "bw": "Bandwidth",
        "cachedA": "Cached ",
        "unbound": "Cloudflare account not connected",
        "failed": "Couldn't get data right now"
      }
    }
  }
}
