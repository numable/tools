{
  "_note": "带宽与缓存(22)。大字 = 近 7 天流量,条 = 其中已缓存的占比,底行 = 请求命中率。数据 = cache.df(零新增请求)。生成器 gen_cloudflare.py。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FFFBF8\\,#FEF3EB)@90|linear(#15171A\\,#191A1B\\,#211F1C)@90"
      },
      {
        "id": "srcdot",
        "type": "layer",
        "x": "12pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#F38020|#FBAD41"
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "21pt",
        "y": "11pt",
        "w": "{parent.w}-66pt",
        "h": "-1",
        "text": "$[if::(eq::(findNotEmpty::(${zname},__none__),__none__),${@i18n.bwT},${zname})]",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "{parent.w}-48pt",
        "y": "14pt",
        "w": "36pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "alignmentH": "2"
      },
      {
        "id": "lab",
        "type": "txt",
        "x": "12pt",
        "y": "33pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${@i18n.bwSub}",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),1,0)]"
        },
        "react": [
          {
            "id": "big",
            "type": "richText",
            "x": "12pt",
            "y": "50pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "$[findNotEmpty::(${bytN},--)]",
                "fontSize": "28pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "5pt"
              },
              {
                "text": "$[findNotEmpty::(${bytU},)]",
                "fontSize": "13pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),0,1)]"
        },
        "react": [
          {
            "id": "bigE",
            "type": "txt",
            "x": "12pt",
            "y": "58.5pt",
            "w": "100pt",
            "h": "-1",
            "text": "--",
            "fontSize": "28pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "id": "tr",
        "type": "line",
        "x": "12pt",
        "y": "94pt",
        "w": "134.0pt",
        "h": "8.0pt",
        "points": "[4.0,4.0,130.0,4.0]",
        "lineWidth": "8.0pt",
        "lineCap": "round",
        "strokeColor": "#D6DAE1|#2C313A"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),1,0)]"
        },
        "react": [
          {
            "id": "bar",
            "type": "line",
            "x": "12pt",
            "y": "94pt",
            "w": "134.0pt",
            "h": "8.0pt",
            "points": "[4.0,4.0,$[findNotEmpty::(${xb22},4.0)],4.0]",
            "lineWidth": "8.0pt",
            "lineCap": "round",
            "strokeColor": "#F38020|#FBAD41",
            "hide": "$[if::(gt::(findNotEmpty::(${brate},0),0),0,1)]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),1,0)]"
        },
        "react": [
          {
            "id": "c0",
            "type": "txt",
            "x": "12pt",
            "y": "109pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${@i18n.cachedA}$[findNotEmpty::(${cbyS},--)] · $[findNotEmpty::(${brateS},--)]%",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ready},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "id": "stN",
            "type": "txt",
            "x": "12pt",
            "y": "109pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${@i18n.unbound}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ready},__none__),__none__),0,if::(eq::(${ready},1),0,1))]"
        },
        "react": [
          {
            "id": "stF",
            "type": "txt",
            "x": "12pt",
            "y": "109pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${@i18n.failed}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ready},1),1,0)]"
        },
        "react": [
          {
            "id": "c1",
            "type": "txt",
            "x": "12pt",
            "y": "132pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${@i18n.hitReqA}$[findNotEmpty::(${rateS},--)]%",
            "fontSize": "9.5pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "cachedA": "已缓存 ",
        "unbound": "还没连接 Cloudflare 账号",
        "failed": "暂时取不到数据",
        "bwT": "带宽与缓存",
        "bwSub": "近 7 天流量",
        "hitReqA": "请求命中 ",
        "nbsp": " "
      },
      "en-US": {
        "cachedA": "Cached ",
        "unbound": "Cloudflare account not connected",
        "failed": "Couldn't get data right now",
        "bwT": "Bandwidth & cache",
        "bwSub": "Bandwidth · 7 days",
        "hitReqA": "Request hit rate ",
        "nbsp": " "
      }
    }
  }
}
