{
  "_note": "下一场维护(42)。主行 = 「三字码 城市」,副行 = 本地开始时间 · 时长;三块 tile:几小时后开始 / 进行中场数 / 待维护场数。取数失败主行写 --,成功但没有维护写「暂无计划维护」。生成器 gen_cloudflare.py。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FFFBF8\\,#FEF3EB)@90|linear(#15171A\\,#191A1B\\,#211F1C)@90"
      },
      {
        "id": "srcdot",
        "type": "layer",
        "x": "14pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#F38020|#FBAD41"
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "23pt",
        "y": "12pt",
        "w": "{parent.w}-97pt",
        "h": "-1",
        "text": "${@i18n.mBrand}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "{parent.w}-60pt",
        "y": "15pt",
        "w": "46pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "alignmentH": "2",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mT},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "id": "name",
            "type": "txt",
            "x": "14pt",
            "y": "34pt",
            "w": "{parent.w}-28pt",
            "h": "-1",
            "text": "${mT}",
            "fontSize": "16pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          },
          {
            "id": "sub",
            "type": "txt",
            "x": "14pt",
            "y": "60pt",
            "w": "{parent.w}-28pt",
            "h": "-1",
            "text": "$[if::(startsWith::(${@app.language},zh),${mSD} ${mST} 开始 · ${mH} 小时,Starts ${mSD} ${mST} · ${mH} h)]",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mT},__none__),__none__),if::(eq::(${ok},1),1,0),0)]"
        },
        "react": [
          {
            "id": "none",
            "type": "txt",
            "x": "14pt",
            "y": "34pt",
            "w": "{parent.w}-28pt",
            "h": "-1",
            "text": "${@i18n.noMaint}",
            "fontSize": "16pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mT},__none__),__none__),if::(eq::(${ok},1),0,1),0)]"
        },
        "react": [
          {
            "id": "nameE",
            "type": "txt",
            "x": "14pt",
            "y": "39pt",
            "w": "{parent.w}-28pt",
            "h": "-1",
            "text": "--",
            "fontSize": "16pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
