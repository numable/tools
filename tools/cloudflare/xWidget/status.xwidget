{
  "_note": "全局状态灯(22)。本包四张卡全部**无参数** —— 「Cloudflare 现在怎么样」对每个用户是同一个答案,不需要先选对象。所以四张卡都挂首页的「可加到桌面」区,也都不需要 onEdit(标准 §8.1 的分类判据)。",
  "version": 2,
  "title": "Cloudflare 状态",
  "sub": "全局服务状态 · 进行中事件",
  "i18n": {
    "en-US": {
      "title": "Cloudflare status",
      "sub": "Global service status · active incidents"
    }
  },
  "layout": 22,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/status.rcn]",
    "depends": [
      "@[file://flow/status.df]"
    ],
    "refresh": {
      "interval": [
        "120"
      ]
    }
  },
  "ai": {
    "shows": "Cloudflare 全局服务状态与进行中事件数"
  }
}
