{
  "_note": "我的边缘节点(22)。主数值 = IATA 三字码,恒三字符、正好占满单指标卡的视觉重心(标准 §4.3)。",
  "version": 2,
  "title": "我的边缘节点",
  "sub": "你正连着哪个 Cloudflare 数据中心",
  "i18n": {
    "en-US": {
      "title": "My edge node",
      "sub": "Which Cloudflare data center you are on"
    }
  },
  "layout": 22,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/edge.rcn]",
    "depends": [
      "@[file://flow/edge.df]"
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "用户此刻连着的 Cloudflare 数据中心(IATA 三字码)"
  }
}
