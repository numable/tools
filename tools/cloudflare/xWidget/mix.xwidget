{
  "_note": "流量构成(44)。需要一个域名。生成器 gen_cloudflare.py。",
  "version": 2,
  "title": "流量构成",
  "sub": "近 7 天状态码分布与访客来源",
  "i18n": {
    "en-US": {
      "title": "Traffic mix",
      "sub": "Response codes and top countries, 7 days"
    }
  },
  "layout": 44,
  "params": {
    "zoneId": "",
    "zoneName": ""
  },
  "events": {
    "onClick": "/zone?zoneId=${zoneId}&zoneName=${zoneName}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/mix.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/mix.df]",
        "params": {
          "zoneId": "${zoneId}",
          "zoneName": "${zoneName}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "1800"
      ]
    }
  },
  "ai": {
    "shows": "某个域名近 7 天响应状态码分布(2xx–5xx)与访客来源国家前五;需绑 Cloudflare 令牌",
    "params": {
      "zoneId": {
        "kind": "account",
        "group": [
          "zoneId",
          "zoneName"
        ],
        "hint": "用户 Cloudflare 账号里的域名(Zone)ID;留空 = 账号里第一个域名,装上后用户可在编辑页换"
      },
      "zoneName": {
        "kind": "account",
        "hint": "与 zoneId 配套的域名,只用于显示"
      }
    }
  }
}
