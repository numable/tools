{
  "_note": "缓存效果(42)。需要一个域名。生成器 gen_cloudflare.py。",
  "version": 2,
  "title": "缓存效果",
  "sub": "近 7 天命中率 · 请求与流量",
  "i18n": {
    "en-US": {
      "title": "Cache performance",
      "sub": "7-day hit rate for requests and bandwidth"
    }
  },
  "layout": 42,
  "params": {
    "zoneId": "",
    "zoneName": ""
  },
  "events": {
    "onClick": "/zone?zoneId=${zoneId}&zoneName=${zoneName}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/cache.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/cache.df]",
        "params": {
          "zoneId": "${zoneId}",
          "zoneName": "${zoneName}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "900"
      ]
    }
  },
  "ai": {
    "shows": "某个域名近 7 天缓存命中率,请求与流量里已缓存的量和占比;需绑 Cloudflare 令牌",
    "params": {
      "zoneId": {
        "kind": "account",
        "group": [
          "zoneId",
          "zoneName"
        ],
        "hint": "用户 Cloudflare 账号里的域名(Zone)ID;留空 = 账号里第一个域名,装上后用户可在编辑页换"
      },
      "zoneName": {
        "kind": "account",
        "hint": "与 zoneId 配套的域名,只用于显示"
      }
    }
  }
}
