{
  "_note": "威胁拦截(22)。需要一个域名。复用 traffic.df。生成器 gen_cloudflare.py。",
  "version": 2,
  "title": "威胁拦截",
  "sub": "近 24 小时拦截数 · 逐小时柱",
  "i18n": {
    "en-US": {
      "title": "Threats blocked",
      "sub": "Blocked requests over the last 24 hours"
    }
  },
  "layout": 22,
  "params": {
    "zoneId": "",
    "zoneName": ""
  },
  "events": {
    "onClick": "/zone?zoneId=${zoneId}&zoneName=${zoneName}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/threats.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/traffic.df]",
        "params": {
          "zoneId": "${zoneId}",
          "zoneName": "${zoneName}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "某个域名近 24 小时被 Cloudflare 拦截的威胁请求数、占请求比例与逐小时柱;需绑 Cloudflare 令牌",
    "params": {
      "zoneId": {
        "kind": "account",
        "group": [
          "zoneId",
          "zoneName"
        ],
        "hint": "用户 Cloudflare 账号里的域名(Zone)ID;留空 = 账号里第一个域名,装上后用户可在编辑页换"
      },
      "zoneName": {
        "kind": "account",
        "hint": "与 zoneId 配套的域名,只用于显示"
      }
    }
  }
}
