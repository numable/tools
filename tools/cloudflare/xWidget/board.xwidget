{
  "_note": "维护日程看板(44)。命中你自己边缘节点的那一行标源色点。",
  "version": 2,
  "title": "维护日程",
  "sub": "状态条 + 最近 5 场计划维护",
  "i18n": {
    "en-US": {
      "title": "Maintenance board",
      "sub": "Status bar + next 5 scheduled maintenances"
    }
  },
  "layout": 44,
  "params": {},
  "events": {
    "onClick": "numable://self",
    "_note": "点整卡 → 进本包首页看全貌。⚠️ 原先写的是 `numable://self/widget/board`,那条路由的实际行为是**弹「添加这张卡」的面板** —— 对一张已经在仪表盘上的卡毫无意义,且该路由已于 2026-08-23 废除(doc/bridge-action-deeplink-review.md B4)。"
  },
  "canvas": {
    "source": "@[file://rc/board.rcn]",
    "depends": [
      "@[file://flow/board.df]"
    ],
    "refresh": {
      "interval": [
        "120"
      ]
    }
  },
  "ai": {
    "shows": "Cloudflare 全局状态条与最近 5 场计划维护,标出命中用户所连节点的那场"
  }
}
