          }
        },
        {
          "op": "set",
          "props": {
            "key": "w7",
            "value": "$[if::(lt::(7,findNotEmpty::(${n},0)),if::(lt::(${a7},24),1,0),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "v7",
            "value": "$[if::(lt::(7,findNotEmpty::(${n},0)),if::(ge::(${a7},24),if::(lt::(${a7},48),1,0),0),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "q8",
            "value": "$[findNotEmpty::(${g[8].sum.requests},0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "a8",
            "value": "$[round::(calc::((${p0}-calc::(parseDate::(subString::(${g[8].dimensions.datetime},0,10),yyyy-MM-dd)+subString::(${g[8].dimensions.datetime},11,13)*3600000+subString::(${g[8].dimensions.datetime},14,16)*60000))/3600000))]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "w8",
            "value": "$[if::(lt::(8,findNotEmpty::(${n},0)),if::(lt::(${a8},24),1,0),0)]"
