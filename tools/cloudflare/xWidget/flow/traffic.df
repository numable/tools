          "props": {
            "key": "a5",
            "value": "$[round::(calc::((${p0}-calc::(parseDate::(subString::(${g[5].dimensions.datetime},0,10),yyyy-MM-dd)+subString::(${g[5].dimensions.datetime},11,13)*3600000+subString::(${g[5].dimensions.datetime},14,16)*60000))/3600000))]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "w5",
            "value": "$[if::(lt::(5,findNotEmpty::(${n},0)),if::(lt::(${a5},24),1,0),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "v5",
            "value": "$[if::(lt::(5,findNotEmpty::(${n},0)),if::(ge::(${a5},24),if::(lt::(${a5},48),1,0),0),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "q6",
            "value": "$[findNotEmpty::(${g[6].sum.requests},0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "a6",
            "value": "$[round::(calc::((${p0}-calc::(parseDate::(subString::(${g[6].dimensions.datetime},0,10),yyyy-MM-dd)+subString::(${g[6].dimensions.datetime},11,13)*3600000+subString::(${g[6].dimensions.datetime},14,16)*60000))/3600000))]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "w6",
            "value": "$[if::(lt::(6,findNotEmpty::(${n},0)),if::(lt::(${a6},24),1,0),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "v6",
            "value": "$[if::(lt::(6,findNotEmpty::(${n},0)),if::(ge::(${a6},24),if::(lt::(${a6},48),1,0),0),0)]"
          }
        },
        {
