          "props": {
            "key": "_pack",
            "value": {
              "ts": "${@time.nowMs}",
              "T": "${T}",
              "O": "${O}",
              "M": "${M}",
              "I": "${I}",
              "pctOn": "${pctOn}",
              "worst": "${worst}",
              "mxI": "${mxI}",
              "sT": "${sT}",
              "sD": "${sD}",
              "at": "${at}",
              "t_as": "${t_as}",
