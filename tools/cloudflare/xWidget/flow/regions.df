          }
        },
        {
          "op": "set",
          "props": {
            "key": "worst",
            "value": "$[if::(gt::(${mxI},0),if::(eq::(${i_as},${mxI}),1,if::(eq::(${i_eu},${mxI}),2,if::(eq::(${i_na},${mxI}),3,if::(eq::(${i_la},${mxI}),4,if::(eq::(${i_af},${mxI}),5,if::(eq::(${i_me},${mxI}),6,if::(eq::(${i_oc},${mxI}),7,0))))))),0)]"
          },
          "_note": "异常最多的洲(1..7),没有异常 = 0。并列取行序靠前的(规模更大的洲)。"
        },
        {
          "op": "set",
          "props": {
            "key": "reST",
            "value": "\"group_id\":\"1km35smx8p41\""
