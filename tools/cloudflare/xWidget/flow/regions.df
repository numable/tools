            "value": "$[max::(calc::(${sT}-${sO}),0)]"
          },
          "_note": "产品服务里「不是 operational」的项数(降级 / 局部故障 / 维护都算,状态页上它们一律标黄)。"
        },
        {
          "op": "set",
          "props": {
            "key": "at",
            "value": "$[formatDate::(${@time.nowMs},HH:mm)]"
          }
        },
        {
