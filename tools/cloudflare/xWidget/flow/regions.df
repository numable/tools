            "value": "$[max::(calc::(${t_eu}-${o_eu}-${m_eu}),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "xo_eu",
            "value": "$[parseNumber::(max::(calc::(4.0+(${o_eu}/max::(${t_eu},1))*166.0),4.0),0.0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "xm_eu",
            "value": "$[parseNumber::(max::(calc::(4.0+((${o_eu}+${m_eu})/max::(${t_eu},1))*166.0),4.0),0.0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "xa_eu",
            "value": "$[parseNumber::(max::(calc::(4.0+(min::(${t_eu},1))*166.0),4.0),0.0)]"
          }
        },
        {
          "op": "set",
          "props": {
