        "value": "$[if::(eq::(${_hasColo},1),if::(contains::(${_b4nm},${colo}),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rows",
        "value": [
          {
            "n": "${b0T}",
            "d": "${_b0L}",
            "act": "${_b0a}",
            "hit": "${_b0h}"
          },
          {
            "n": "${b1T}",
            "d": "${_b1L}",
            "act": "${_b1a}",
            "hit": "${_b1h}"
          },
          {
            "n": "${b2T}",
            "d": "${_b2L}",
            "act": "${_b2a}",
            "hit": "${_b2h}"
          },
          {
            "n": "${b3T}",
            "d": "${_b3L}",
            "act": "${_b3a}",
            "hit": "${_b3h}"
          },
          {
            "n": "${b4T}",
            "d": "${_b4L}",
            "act": "${_b4a}",
            "hit": "${_b4h}"
          }
        ]
      },
      "_note": "定长 5 槽(不透传 33KB 原始维护对象)。多余槽位字段为空,渲染层按 total 截断。"
    },
    {
      "op": "set",
      "props": {
        "key": "at",
        "value": "$[formatDate::(${_now},HH:mm)]"
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "lv",
          "nInc",
          "total",
          "rows",
          "colo",
          "at"
        ]
      }
    }
  ]
}
