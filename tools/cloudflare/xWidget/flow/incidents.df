          }
        },
        {
          "op": "set",
          "props": {
            "key": "dk12",
            "value": "$[formatDate::(calc::(${@time.nowMs}-12*86400000),yyyy-MM-dd)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "c12",
            "value": "$[calc::(length::(split::(${cj},${dk12}))-1)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "k12",
            "value": "$[if::(ge::(parseDate::(${dk12},yyyy-MM-dd),${oldMs}),1,0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "dk13",
            "value": "$[formatDate::(calc::(${@time.nowMs}-13*86400000),yyyy-MM-dd)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "c13",
            "value": "$[calc::(length::(split::(${cj},${dk13}))-1)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "k13",
            "value": "$[if::(ge::(parseDate::(${dk13},yyyy-MM-dd),${oldMs}),1,0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "n14",
            "value": "$[calc::(${c0}+${c1}+${c2}+${c3}+${c4}+${c5}+${c6}+${c7}+${c8}+${c9}+${c10}+${c11}+${c12}+${c13})]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "mx",
            "value": "$[max::(${c0},${c1},${c2},${c3},${c4},${c5},${c6},${c7},${c8},${c9},${c10},${c11},${c12},${c13},1)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "fromMs",
            "value": "$[parseDate::(${dk13},yyyy-MM-dd)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "MONE",
            "value": [
              "Jan",
              "Feb",
              "Mar",
              "Apr",
              "May",
              "Jun",
              "Jul",
              "Aug",
              "Sep",
              "Oct",
              "Nov",
              "Dec"
            ]
          }
        },
        {
          "op": "set",
          "props": {
            "key": "d13Iso",
            "value": "${dk13}"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "d13Mo",
            "value": "$[parseNumber::(subString::(${d13Iso},5,7),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "d13Dy",
            "value": "$[parseNumber::(subString::(${d13Iso},8,10),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "d13Me",
            "value": "$[index::(${MONE},calc::(${d13Mo}-1))]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "d13Z",
            "value": "${d13Mo}月${d13Dy}日"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "d13E",
            "value": "${d13Me} ${d13Dy}"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "d13",
            "value": "$[if::(eq::(length::(${d13Iso}),10),if::(startsWith::(${@app.language},zh),${d13Z},${d13E}),)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "bh0",
            "value": "$[if::(gt::(${c0},0),max::(round::(calc::(${c0}*70.0/${mx})),4),2)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "by0",
            "value": "$[findNotEmpty::(calc::(126.0-${bh0}),124.0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "bh1",
            "value": "$[if::(gt::(${c1},0),max::(round::(calc::(${c1}*70.0/${mx})),4),2)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "by1",
            "value": "$[findNotEmpty::(calc::(126.0-${bh1}),124.0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "bh2",
            "value": "$[if::(gt::(${c2},0),max::(round::(calc::(${c2}*70.0/${mx})),4),2)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "by2",
