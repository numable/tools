            "value": "$[calc::(length::(split::(${cj},${dk4}))-1)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "k4",
            "value": "$[if::(ge::(parseDate::(${dk4},yyyy-MM-dd),${oldMs}),1,0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "dk5",
            "value": "$[formatDate::(calc::(${@time.nowMs}-5*86400000),yyyy-MM-dd)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "c5",
            "value": "$[calc::(length::(split::(${cj},${dk5}))-1)]"
          }
        },
        {
          "op": "set",
