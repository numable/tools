          }
        },
        {
          "op": "set",
          "props": {
            "key": "w0",
            "value": "$[if::(ge::(parseDate::(subString::(${inc.incidents[0].created_at},0,10),yyyy-MM-dd),${fromMs}),1,0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "j0",
            "value": "$[if::(eq::(${w0},1),if::(or::(eq::(${inc.incidents[0].impact},major),eq::(${inc.incidents[0].impact},critical)),1,0),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "o0",
            "value": "$[if::(eq::(findNotEmpty::(${inc.incidents[0].id},__none__),__none__),0,if::(eq::(findNotEmpty::(${inc.incidents[0].resolved_at},__none__),__none__),1,0))]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "r0",
            "value": "$[if::(eq::(${w0},1),if::(eq::(${o0},0),if::(eq::(findNotEmpty::(${inc.incidents[0].id},__none__),__none__),0,1),0),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "u0",
            "value": "$[if::(eq::(${r0},1),calc::((calc::(parseDate::(subString::(${inc.incidents[0].resolved_at},0,10),yyyy-MM-dd)+subString::(${inc.incidents[0].resolved_at},11,13)*3600000+subString::(${inc.incidents[0].resolved_at},14,16)*60000)-calc::(parseDate::(subString::(${inc.incidents[0].created_at},0,10),yyyy-MM-dd)+subString::(${inc.incidents[0].created_at},11,13)*3600000+subString::(${inc.incidents[0].created_at},14,16)*60000))/3600000),0)]"
          }
        },
        {
