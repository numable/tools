{
  "_note": "全球数据中心(44)。无参数、公开数据,挂首页。生成器 gen_cloudflare.py。",
  "version": 2,
  "title": "全球数据中心",
  "sub": "七大洲节点健康 · 正常 / 维护 / 异常",
  "i18n": {
    "en-US": {
      "title": "Global data centers",
      "sub": "Node health across 7 regions"
    }
  },
  "layout": 44,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/regions.rcn]",
    "depends": [
      "@[file://flow/regions.df]"
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "Cloudflare 七大洲数据中心健康度:正常、计划维护、异常各占多少"
  }
}
