{
  "_note": "下一场计划维护(42)。时间恒标 UTC,理由见 flow/next.df 的说明。",
  "version": 2,
  "title": "下一场维护",
  "sub": "最近一场计划维护 · 时间与时长",
  "i18n": {
    "en-US": {
      "title": "Next maintenance",
      "sub": "Nearest scheduled maintenance · time and duration"
    }
  },
  "layout": 42,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/next.rcn]",
    "depends": [
      "@[file://flow/next.df]"
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "Cloudflare 最近一场计划维护的日期、开始时刻(UTC)与时长"
  }
}
