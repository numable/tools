                          "where": "${s5w}"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "_note": "搜到 0 条。⚠️ 条件里带着 `sQ`(有没有跑过一次检索):只有「真的搜过、且真的返回 0 条」才说没找到。请求失败时 `patchState` 压根不执行,`sQ` 停在旧值 —— 「没连上」不会被写成「没这个城市」(§7.2 的同一条纪律)。",
                "op": "if",
                "props": {
                  "cond": "$[if::(eq::(${sQ},1),if::(eq::(${sN},0),1,0),0)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "suNone",
                    "h": "30pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-setup-none.rcn]"
                    }
                  }
                ]
              },
              {
                "_note": "常用城市:一点即完成。有检索结果时收起 —— 用户已经在用搜索框了,再摆一排别的城市只是噪声。",
                "op": "if",
                "props": {
                  "cond": "$[if::(eq::(${sQ},1),0,1)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "suHot",
