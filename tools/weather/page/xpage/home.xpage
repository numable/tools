                            "city": "${r4n}"
                          }
                        }
                      ]
                    },
                    "events": {
                      "onClick": "/detail?lat=${r4lat}&lon=${r4lon}&city=${r4q}"
                    }
                  }
                ]
              },
              {
                "_note": "第 5 行。",
                "op": "if",
                "props": {
                  "cond": "$[if::(ge::(${n},5),1,0)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "row5",
                    "h": "76pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-row.rcn]",
                      "_note": "第 5 行的取数,同上。",
                      "depends": [
                        {
                          "flow": "@[file://page/flow/detail.df]",
                          "params": {
                            "lat": "${r5lat}",
                            "lon": "${r5lon}",
                            "city": "${r5n}"
                          }
                        }
                      ]
                    },
                    "events": {
                      "onClick": "/detail?lat=${r5lat}&lon=${r5lon}&city=${r5q}"
                    }
                  }
                ]
              },
              {
                "_note": "第 6 行。",
                "op": "if",
                "props": {
                  "cond": "$[if::(ge::(${n},6),1,0)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "row6",
                    "h": "76pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-row.rcn]",
                      "_note": "第 6 行的取数,同上。",
                      "depends": [
                        {
                          "flow": "@[file://page/flow/detail.df]",
                          "params": {
                            "lat": "${r6lat}",
                            "lon": "${r6lon}",
                            "city": "${r6n}"
                          }
                        }
                      ]
                    },
                    "events": {
                      "onClick": "/detail?lat=${r6lat}&lon=${r6lon}&city=${r6q}"
                    }
                  }
                ]
              },
              {
                "_note": "第 7 行。",
                "op": "if",
                "props": {
                  "cond": "$[if::(ge::(${n},7),1,0)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "row7",
                    "h": "76pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-row.rcn]",
                      "_note": "第 7 行的取数,同上。",
                      "depends": [
                        {
                          "flow": "@[file://page/flow/detail.df]",
                          "params": {
                            "lat": "${r7lat}",
                            "lon": "${r7lon}",
                            "city": "${r7n}"
                          }
                        }
                      ]
                    },
                    "events": {
                      "onClick": "/detail?lat=${r7lat}&lon=${r7lon}&city=${r7q}"
                    }
                  }
                ]
              },
              {
                "_note": "第 8 行。",
                "op": "if",
                "props": {
                  "cond": "$[if::(ge::(${n},8),1,0)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "row8",
                    "h": "76pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-row.rcn]",
                      "_note": "第 8 行的取数,同上。",
                      "depends": [
                        {
                          "flow": "@[file://page/flow/detail.df]",
                          "params": {
                            "lat": "${r8lat}",
                            "lon": "${r8lon}",
                            "city": "${r8n}"
                          }
                        }
                      ]
                    },
                    "events": {
                      "onClick": "/detail?lat=${r8lat}&lon=${r8lon}&city=${r8q}"
                    }
                  }
                ]
              },
              {
                "type": "Canvas",
                "id": "manage",
                "h": "52pt",
                "_note": "管理城市 → `/city`(增删/排序)。**放在加卡按钮之上** —— 先管内容,再谈把它放到哪儿。\n⚠️ v49 首版漏了这个入口:老首页那条 chip 条右端的 ＋/⋯ 随 chip 条一起删了,\n   于是用户看得见 8 座城市却没有一个地方能删掉其中一座。\n⚠️ v55:不能写成 `\"onClick\": \"/city\"` 的导航串 —— 常规压栈返回时首页是栈里的旧实例、`home.df` 不重跑,\n   新加的城市要下拉才出来。走 open-city.af 的 for-result 续体,返回即 `reloadPage`。",
                "canvas": {
                  "source": "@[file://page/rc/p-manage.rcn]"
                },
                "events": {
                  "onClick": "@[file://page/flow/open-city.af]"
                }
              },
              {
                "type": "Canvas",
                "id": "addbtn",
                "h": "56pt",
                "canvas": {
                  "source": "@[file://page/rc/p-addbtn.rcn]"
                },
                "events": {
                  "onClick": {
                    "flow": "@[file://page/flow/pick.af]",
                    "params": {}
                  }
                },
                "_note": "加卡入口 —— 整页只此一个(§8.1a),版式由 tools/infosource/mk_addbtn.py 统一产出。\n⚠️ 它加的是**排在第一的城市**的卡(v66 起;此前读隐形的 `data.cityIdx`,已退役):列表页上没有「当前城市」这回事,第一座是谁由用户在 /city 里上移/下移决定。\n要加别座城市的卡,进那座城市的详情页,页脚那个按钮点名了城市(p-foot-detail.rcn)。"
              },
              {
                "type": "Canvas",
                "id": "foot",
                "h": "92pt",
                "canvas": {
                  "source": "@[file://page/rc/p-foot-home.rcn]"
                }
              }
            ]
          }
        ]
      },
      {
        "_note": "未就绪态引导屏(G25 §7.1)—— 一个城市都没有时的整页替身。\n五条硬约束怎么满足的:① 不是空页、也不只是一句提示;② 这个包只差**一步**,所以刻意不做编号步骤(编号是给多步流程用的,把一步拆成三步是给自己加戏);③ 每一步都可执行 —— 搜索框输入即搜、常用城市一点即完成;④ 「直达配置入口」在这个包就是搜索框本身(第 4 条说的凭证面板对它不适用:它没有凭证);⑤ 边界写在页脚:数据来源 + 城市只存本机。\n⚠️ 完成后**不再要一次确认** —— setup-pick / setup-hot 落盘后直接 `reloadPage`,`n` 变成 1,这一整块收起、正常首页出现。\n⚠️ root 的 padding 是 0(整页天空要铺到最顶),所以这一屏自带内边距,顶部让位读 `@contentInset.top`(容器 chrome 恒浮动、不替页面 inset)。",
        "op": "if",
        "props": {
          "cond": "$[if::(ge::(${n},1),0,1)]"
        },
        "items": [
          {
            "type": "container",
            "id": "setup",
            "layout": "list",
            "direction": "vertical",
            "gap": "12pt",
            "padding": "16pt",
            "paddingTop": "${@contentInset.top}pt",
            "paddingBottom": "${@contentInset.bottom}pt",
            "items": [
              {
                "type": "Canvas",
                "id": "suHero",
                "h": "78pt",
                "canvas": {
                  "source": "@[file://page/rc/p-setup-hero.rcn]"
                }
              },
              {
                "type": "Canvas",
                "id": "suSec",
                "h": "22pt",
                "canvas": {
                  "source": "@[file://page/rc/p-setup-sec.rcn]"
                }
              },
              {
                "_note": "搜索框 = absolute 容器里叠两层:RCN 画底(圆角 + 明暗双分支),`input` 节点只管「文本编辑 + 键盘 + 光标」(xpage-input-node.md §1「裸能力,不是控件」)。\n⚠️ `input` 左右各留 14pt —— 它自己没有 padding 属性,不留就贴着圆角边起字。\n⚠️ `changeDebounce` 交给节点属性(300ms),流里不再自己防抖:每敲一个字母打一次地理编码接口既慢又浪费。",
                "type": "container",
                "id": "sbox",
                "layout": "absolute",
                "h": "48pt",
                "items": [
                  {
                    "type": "Canvas",
                    "id": "sbg",
                    "x": "0pt",
                    "y": "0pt",
                    "w": "{parent.w}",
                    "h": "48pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-setup-sbg.rcn]"
                    }
                  },
                  {
                    "type": "input",
                    "id": "kw",
                    "x": "14pt",
                    "y": "0pt",
                    "w": "{parent.w}-28pt",
                    "h": "48pt",
                    "props": {
                      "bindKey": "kw",
                      "hint": "${@i18n.su_ph}",
                      "hintColor": "#9AA0A6|#8E939B",
                      "inputType": "text",
                      "returnKey": "search",
                      "fontSize": 16,
                      "color": "#0E1116|#F3F4F6",
                      "caretColor": "#128F66|#6FE8BE",
                      "autocorrect": false,
                      "autocapitalize": "none",
                      "clearButton": true,
                      "changeDebounce": 500
                    },
                    "events": {
                      "onChange": "@[file://page/flow/setup-search.af]"
                    },
                    "_note": "⚠️ 防抖 500ms(原 300)。这一页**没有 JS,也就没有请求序号守卫** —— 而三路检索的耗时\n   差得很远(open-meteo 两路 ~0.8s,补 OSM 那一路 2s 上下),先发的慢请求会晚于\n   后发的快请求回来、把正确结果覆盖掉(H5 那两页实测过:打「长」→350ms→「长沙」,\n   最后停在屏幕上的是搜「长」的结果)。\n   AF 侧没法领号(`xpage.patchState` 是写、拿不到「现在输入框里是什么」),\n   只能把防抖拉到**正常打字间隔之上**:500ms > 350ms,中途那个半截词就不会单独发出去。\n   配合 setup-search.af 里的「单字不搜」,竞态窗口基本关掉。"
                  }
                ]
              },
              {
                "_note": "第 1 条结果。整行可点 —— 事件挂在**这个 XPage 节点**上而不是 cell 上(cell 上挂事件时文字盖在底板上、只有底板收得到点击,点正中央没反应)。\n⚠️ 行文字走**节点 params**、坐标走**节点 events.params**,两者都在节点作用域求值(与 crypto/forex 首页那几行 `params: {k1: \"${k1}\"}` 同一条路)。\n⚠️ 五个槽位是**静态字面下标**:VParser 的下标寻址只认字面数字,`${s[${i}]}` 会静默求空。",
                "op": "if",
                "props": {
                  "cond": "$[if::(gt::(length::(${s1n}),0),1,0)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "hit1",
                    "h": "52pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-setup-hit.rcn]"
                    },
                    "params": {
                      "hn": "${s1n}",
                      "hw": "${s1w}"
                    },
                    "events": {
                      "onClick": {
                        "flow": "@[file://page/flow/setup-pick.af]",
                        "params": {
                          "lat": "${s1lat}",
                          "lon": "${s1lon}",
                          "name": "${s1n}",
                          "where": "${s1w}"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "_note": "第 2 条。",
                "op": "if",
                "props": {
                  "cond": "$[if::(gt::(length::(${s2n}),0),1,0)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "hit2",
                    "h": "52pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-setup-hit.rcn]"
                    },
                    "params": {
                      "hn": "${s2n}",
                      "hw": "${s2w}"
                    },
                    "events": {
                      "onClick": {
                        "flow": "@[file://page/flow/setup-pick.af]",
                        "params": {
                          "lat": "${s2lat}",
                          "lon": "${s2lon}",
                          "name": "${s2n}",
                          "where": "${s2w}"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "_note": "第 3 条。",
                "op": "if",
                "props": {
                  "cond": "$[if::(gt::(length::(${s3n}),0),1,0)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "hit3",
                    "h": "52pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-setup-hit.rcn]"
                    },
                    "params": {
                      "hn": "${s3n}",
                      "hw": "${s3w}"
                    },
                    "events": {
                      "onClick": {
                        "flow": "@[file://page/flow/setup-pick.af]",
                        "params": {
                          "lat": "${s3lat}",
                          "lon": "${s3lon}",
                          "name": "${s3n}",
                          "where": "${s3w}"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "_note": "第 4 条。",
                "op": "if",
                "props": {
                  "cond": "$[if::(gt::(length::(${s4n}),0),1,0)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "hit4",
                    "h": "52pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-setup-hit.rcn]"
                    },
                    "params": {
                      "hn": "${s4n}",
                      "hw": "${s4w}"
                    },
                    "events": {
                      "onClick": {
                        "flow": "@[file://page/flow/setup-pick.af]",
                        "params": {
                          "lat": "${s4lat}",
                          "lon": "${s4lon}",
                          "name": "${s4n}",
                          "where": "${s4w}"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "_note": "第 5 条。",
                "op": "if",
                "props": {
                  "cond": "$[if::(gt::(length::(${s5n}),0),1,0)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "hit5",
                    "h": "52pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-setup-hit.rcn]"
                    },
                    "params": {
