                      ]
                    },
                    "events": {
                      "onClick": "/detail?lat=${r3lat}&lon=${r3lon}&city=${r3q}"
                    }
                  }
                ]
              },
              {
                "_note": "第 4 行。",
                "op": "if",
                "props": {
                  "cond": "$[if::(ge::(${n},4),1,0)]"
                },
                "items": [
                  {
                    "type": "Canvas",
                    "id": "row4",
                    "h": "76pt",
                    "canvas": {
                      "source": "@[file://page/rc/p-row.rcn]",
                      "_note": "第 4 行的取数,同上。",
                      "depends": [
                        {
                          "flow": "@[file://page/flow/detail.df]",
                          "params": {
