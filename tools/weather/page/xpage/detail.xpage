      "w_aq4": "中度污染",
      "w_aq5": "重度污染",
      "w_aq6": "严重污染",
      "w_sunT": "日出日落",
      "w_rise": "日出",
      "w_set": "日落",
      "w_dayA": "白昼 ",
      "w_dayH": " 小时 ",
      "w_dayM": " 分",
      "w_uv": "紫外线 ",
      "w_uv1": "弱",
      "w_uv2": "中等",
      "w_uv3": "强",
      "w_uv4": "很强",
      "w_uv5": "极强",
      "w_toSet": "距日落 ",
      "w_toRise": "距日出 ",
      "w_hA": " 小时 ",
      "w_mA": " 分",
      "feels": "体感",
      "hum": "湿度",
      "wind": "风速",
      "pop": "降水",
      "vis": "能见度",
      "prs": "气压",
      "foot": "数据来源：Open-Meteo（开放气象数据，无需密钥）。天气实况每 5 分钟刷新一次，数据在你的设备上直接获取。",
      "add_pre": "＋ 添加 ",
      "add_post": " 的天气组件",
      "w_h24P": "未来 24 小时",
      "w_rainNone": "24 小时内降水概率都不高",
      "w_rainA": "预计 ",
      "w_rainB": " 点起可能下雨 · ",
      "w_rainNow": "正在下雨 · 降水概率 ",
      "w_hr": "时",
      "high": "高",
      "low": "低",
      "cond_clear": "晴",
      "cond_partly": "多云",
      "cond_cloudy": "阴",
      "cond_fog": "雾",
      "cond_drizzle": "小雨",
      "cond_rain": "雨",
      "cond_snow": "雪",
      "cond_thunder": "雷阵雨",
      "rain_none": "12 小时内无雨",
      "rain_now": "正在下雨",
      "rain_pre": "从 ",
