            "w": "28pt",
            "h": "-1",
            "text": "${tmaxS}°",
            "fontSize": "10pt",
            "textColor": "#FFFFFF|#FFFFFF",
            "maxLines": "1",
            "typeface": "System-Bold",
            "alignmentH": "1"
          },
          {
