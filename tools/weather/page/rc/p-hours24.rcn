{
  "_note": "详情页块(182pt):未来 24 小时。数据与图表几何同 hours 卡(sky24.df),外壳是详情页统一版式(页面底色 + 玻璃卡 + 标题行)。生成器 gen_weather_more.py,别手改。",
  "rc": {
    "cells": [
      {
        "type": "op",
        "action": "set",
        "props": {
          "key": "_sky",
          "value": "$[findNotEmpty::(${sky},overcast)]"
        }
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},clear)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "#4C5F6A|#2E4149"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},overcast)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "#535A5F|#3D4348"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},rain)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "#3D4951|#2C383F"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},snow)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "#61666A|#47505A"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},night)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "#17202B|#101720"
          }
        ]
      },
      {
        "id": "card",
        "type": "layer",
        "x": "16pt",
        "y": "0pt",
        "w": "{parent.w}-32pt",
        "h": "166pt",
        "bgColor": "#2EFFFFFF|#1FFFFFFF",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "30pt",
        "y": "14pt",
        "w": "130pt",
        "h": "-1",
        "text": "${@i18n.w_h24P}",
        "fontSize": "11.5pt",
        "textColor": "#D6FFFFFF|#CCFFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${rCase},__none__),__none__),0,if::(eq::(${rCase},0),1,0))]"
        },
        "react": [
          {
            "id": "c0",
            "type": "txt",
            "x": "{parent.w}-240pt",
            "y": "14pt",
            "w": "210pt",
            "h": "-1",
            "text": "${@i18n.w_rainNone}",
            "fontSize": "11.5pt",
            "textColor": "#D6FFFFFF|#CCFFFFFF",
            "maxLines": "1",
            "alignmentH": "2"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(findNotEmpty::(${rCase},0),1)]"
        },
        "react": [
          {
            "id": "c1",
            "type": "txt",
            "x": "{parent.w}-240pt",
            "y": "14pt",
            "w": "210pt",
            "h": "-1",
            "text": "${@i18n.w_rainA}${rH}${@i18n.w_rainB}${rP}%",
            "fontSize": "11.5pt",
            "textColor": "#D6FFFFFF|#CCFFFFFF",
            "maxLines": "1",
            "alignmentH": "2"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(findNotEmpty::(${rCase},0),2)]"
        },
        "react": [
          {
            "id": "c2",
            "type": "txt",
            "x": "{parent.w}-240pt",
            "y": "14pt",
            "w": "210pt",
            "h": "-1",
            "text": "${@i18n.w_rainNow}${rP}%",
            "fontSize": "11.5pt",
            "textColor": "#D6FFFFFF|#CCFFFFFF",
            "maxLines": "1",
            "alignmentH": "2"
          }
        ]
      },
      {
        "id": "div",
        "type": "layer",
        "x": "30pt",
        "y": "36pt",
        "w": "{parent.w}-60pt",
        "h": "1pt",
        "bgColor": "#26FFFFFF|#1FFFFFFF"
      },
      {
        "id": "curve",
        "type": "curves",
        "x": "({parent.w}-310pt)/2",
        "y": "59.0pt",
        "w": "310.0pt",
        "h": "49.0pt",
        "points": "[$[findNotEmpty::(${pts},0\\,999\\,1\\,999)]]",
        "lineWidth": "2pt",
        "lineCap": "round",
        "lineJoin": "round",
        "strokeColor": "#FFFFFF|#FFFFFF",
        "coverageColor": "linear(#40FFFFFF\\,#00FFFFFF)@90|linear(#33FFFFFF\\,#00FFFFFF)@90"
      },
      {
        "id": "pbase",
        "type": "layer",
        "x": "({parent.w}-310pt)/2",
        "y": "136.0pt",
        "w": "310.0pt",
        "h": "1pt",
        "bgColor": "#59FFFFFF|#4DFFFFFF"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${tmaxS},__none__),__none__),0,1)]"
        },
