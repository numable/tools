{
  "rc": {
    "cells": [
      {
        "id": "t",
        "type": "txt",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "1",
        "text": "${@i18n.su_t}",
        "fontSize": "22pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "s",
        "type": "txt",
        "x": "0pt",
        "y": "{t.b}+8pt",
        "w": "{parent.w}",
        "h": "-1",
        "maxLines": "2",
        "lineBreak": "1",
        "lineSpacing": "4pt",
        "text": "${@i18n.su_s}",
        "fontSize": "13pt",
        "textColor": "#6B7280|#8E939B"
      }
    ],
    "i18n": {
      "zh-CN": {
        "su_t": "先选一个城市",
        "su_s": "选好城市后，这里会显示实况、逐时和五日预报。"
      },
      "en-US": {
        "su_t": "Pick a city to start",
        "su_s": "Once you pick one, you'll see current conditions, the next 12 hours and a 5-day forecast."
      }
    }
  },
  "_note": "未就绪态第一屏(G25 §7.1):不是「暂无数据」,是「差一步、这一步这么做、做完得到什么」。刻意**不做编号步骤** —— 这个包只差选一个城市,把一步拆成三步是给自己加戏。"
}
