{
  "rc": {
    "cells": [
      {
        "type": "op",
        "action": "set",
        "props": {
          "key": "_sky",
          "value": "$[findNotEmpty::(${sky},overcast)]"
        }
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},clear)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "#4C5F6A|#2E4149"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},overcast)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "#535A5F|#3D4348"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},rain)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "#3D4951|#2C383F"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},snow)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "#61666A|#47505A"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},night)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "#17202B|#101720"
          }
        ]
      },
      {
        "type": "layer",
        "x": "16pt",
        "y": "0pt",
        "w": "({parent.w}-40pt)/2",
        "h": "72pt",
        "bgColor": "#2EFFFFFF|#1FFFFFFF",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "type": "txt",
        "x": "16pt+14pt",
        "y": "0pt+14pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "${@i18n.feels}",
        "fontSize": "10.5pt",
        "textColor": "#D6FFFFFF|#CCFFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "txt",
        "x": "16pt+14pt",
        "y": "0pt+36pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${feels},--)]°",
        "fontSize": "22pt",
        "textColor": "#FFFFFF|#FFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "layer",
        "x": "16pt+({parent.w}-40pt)/2+8pt",
        "y": "0pt",
        "w": "({parent.w}-40pt)/2",
        "h": "72pt",
        "bgColor": "#2EFFFFFF|#1FFFFFFF",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "type": "txt",
        "x": "16pt+({parent.w}-40pt)/2+8pt+14pt",
        "y": "0pt+14pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "${@i18n.hum}",
        "fontSize": "10.5pt",
        "textColor": "#D6FFFFFF|#CCFFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "txt",
        "x": "16pt+({parent.w}-40pt)/2+8pt+14pt",
        "y": "0pt+36pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${hum},--)]%",
        "fontSize": "22pt",
        "textColor": "#FFFFFF|#FFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "layer",
        "x": "16pt",
        "y": "80pt",
        "w": "({parent.w}-40pt)/2",
        "h": "72pt",
        "bgColor": "#2EFFFFFF|#1FFFFFFF",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "type": "txt",
        "x": "16pt+14pt",
        "y": "80pt+14pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "${@i18n.wind} $[findNotEmpty::(${wu},km/h)]",
        "fontSize": "10.5pt",
        "textColor": "#D6FFFFFF|#CCFFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "txt",
        "x": "16pt+14pt",
        "y": "80pt+36pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${wind},--)]",
        "fontSize": "22pt",
        "textColor": "#FFFFFF|#FFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "layer",
        "x": "16pt+({parent.w}-40pt)/2+8pt",
        "y": "80pt",
        "w": "({parent.w}-40pt)/2",
        "h": "72pt",
        "bgColor": "#2EFFFFFF|#1FFFFFFF",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "type": "txt",
        "x": "16pt+({parent.w}-40pt)/2+8pt+14pt",
        "y": "80pt+14pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "${@i18n.pop}",
        "fontSize": "10.5pt",
        "textColor": "#D6FFFFFF|#CCFFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "txt",
        "x": "16pt+({parent.w}-40pt)/2+8pt+14pt",
        "y": "80pt+36pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${pop},--)]%",
        "fontSize": "22pt",
        "textColor": "#FFFFFF|#FFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "layer",
        "x": "16pt",
        "y": "160pt",
        "w": "({parent.w}-40pt)/2",
        "h": "72pt",
        "bgColor": "#2EFFFFFF|#1FFFFFFF",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "type": "txt",
        "x": "16pt+14pt",
        "y": "160pt+14pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "${@i18n.vis} $[findNotEmpty::(${vu},km)]",
        "fontSize": "10.5pt",
        "textColor": "#D6FFFFFF|#CCFFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "txt",
        "x": "16pt+14pt",
        "y": "160pt+36pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${vis},--)]",
        "fontSize": "22pt",
        "textColor": "#FFFFFF|#FFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "layer",
        "x": "16pt+({parent.w}-40pt)/2+8pt",
        "y": "160pt",
        "w": "({parent.w}-40pt)/2",
        "h": "72pt",
        "bgColor": "#2EFFFFFF|#1FFFFFFF",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "type": "txt",
        "x": "16pt+({parent.w}-40pt)/2+8pt+14pt",
        "y": "160pt+14pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "${@i18n.prs} hPa",
        "fontSize": "10.5pt",
        "textColor": "#D6FFFFFF|#CCFFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "txt",
        "x": "16pt+({parent.w}-40pt)/2+8pt+14pt",
        "y": "160pt+36pt",
        "w": "({parent.w}-40pt)/2-28pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${prs},--)]",
        "fontSize": "22pt",
        "textColor": "#FFFFFF|#FFFFFF",
        "maxLines": "1",
        "typeface": "System-Bold"
      }
    ],
    "i18n": {
      "zh-CN": {
        "feels": "体感",
        "hum": "湿度",
        "wind": "风速",
        "pop": "降水",
        "vis": "能见度",
        "prs": "气压"
      },
      "en-US": {
        "feels": "Feels",
        "hum": "Humidity",
        "wind": "Wind",
        "pop": "Rain",
        "vis": "Visibility",
        "prs": "Pressure"
      }
    }
  },
  "_note": "首页详情 2×3 玻璃格。tile 底板画在 op:if 之外 —— 任何数据形态(含全空)都留得住版式(G9)。\n2026-10-08:第三行原是「日出 / 日落」,与上方「日出日落」块重复,换成能见度与气压(同一次请求多取两个 current 字段,零新增请求)。"
}