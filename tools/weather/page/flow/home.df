        "key": "r4n",
        "value": "${c3.name}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "r4w",
        "value": "${c3.where}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "r4q",
        "value": "$[urlEncode::(${c3.name})]"
      }
    },
    {
      "op": "set",
