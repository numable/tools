      }
    },
    {
      "op": "set",
      "props": {
        "key": "r5q",
        "value": "$[urlEncode::(${c4.name})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "r6lat",
        "value": "${c5.lat}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "r6lon",
        "value": "${c5.lon}"
      }
    },
    {
      "op": "set",
