{
  "_note": "现在(11)。手写真源;rc 由 now.rcn 的天空底 / 图标派生。onClick / onEdit 照抄 now.xwidget:onClick 带上本组件自己的坐标去详情页(只能引用外壳 ⊕ 实例 params,城市名由宿主编码);onEdit 是裸路由 path。",
  "version": 2,
  "title": "现在",
  "sub": "一格 · 气温、天况与今日高低",
  "i18n": {
    "en-US": {
      "title": "Now",
      "sub": "Tiny · temperature, sky and today's range"
    }
  },
  "layout": 11,
  "params": {
    "lat": "auto",
    "lon": "auto",
    "city": "auto"
  },
  "ai": {
    "shows": "一座城市此刻的气温、天况与今日最高最低（一格小组件）",
    "params": {
      "city": {
        "kind": "auto",
        "group": [
          "city",
          "lat",
          "lon"
        ],
        "hint": "要换城市就三个一起填：city 写城市名，lat / lon 写这座城市的十进制纬度、经度（如东京 35.68 / 139.69，纽约 40.71 / -74.01）；只填 city 不生效。对坐标没把握就三个都留 auto（国内显示上海、海外显示纽约，装上后用户长按「编辑」换城市）"
      }
    }
  },
  "events": {
    "onClick": "/detail?lat=${lat}&lon=${lon}&city=${city}",
    "onEdit": "/pick"
  },
  "canvas": {
    "source": "@[file://rc/now11.rcn]",
    "depends": [
      {
        "_note": "与 now.xwidget 同一条绑定:lat / lon / city 三个键都要显式传(city 不传则城市名恒渲 --)。",
        "flow": "@[file://flow/weather.df]",
        "params": {
          "lat": "${lat}",
          "lon": "${lon}",
          "city": "${city}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
