{
  "_note": "日出日落(22)。v62 新增。单城市卡,参数与点击同 now。",
  "version": 2,
  "title": "日出日落",
  "sub": "太阳轨迹 · 白昼时长 · 紫外线",
  "i18n": {
    "en-US": {
      "title": "Sunrise & sunset",
      "sub": "Sun path, daylight and UV"
    }
  },
  "layout": 22,
  "params": {
    "lat": "auto",
    "lon": "auto",
    "city": "auto"
  },
  "ai": {
    "shows": "一座城市今天的日出日落时刻、太阳轨迹、白昼时长、距日落或日出多久与紫外线强度",
    "params": {
      "city": {
        "kind": "auto",
        "group": [
          "city",
          "lat",
          "lon"
        ],
        "hint": "要换城市就三个一起填：city 写城市名，lat / lon 写这座城市的十进制纬度、经度（如东京 35.68 / 139.69，纽约 40.71 / -74.01）；只填 city 不生效。对坐标没把握就三个都留 auto（国内显示上海、海外显示纽约，装上后用户长按「编辑」换城市）"
      }
    }
  },
  "events": {
    "onClick": "/detail?lat=${lat}&lon=${lon}&city=${city}",
    "onEdit": "/pick"
  },
  "canvas": {
    "source": "@[file://rc/sun.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/sky24.df]",
        "params": {
          "lat": "${lat}",
          "lon": "${lon}",
          "city": "${city}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "900"
      ]
    }
  }
}
