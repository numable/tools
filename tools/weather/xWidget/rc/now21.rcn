      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${rainNow},1),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "68pt",
            "y": "38pt",
            "w": "80pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "fontSize": "9pt",
            "textColor": "#B3FFFFFF|#A6FFFFFF",
            "text": "${@i18n.rainNow}"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${rainNow},1),0,if::(eq::(${rainFlag},1),1,0))]"
        },
        "react": [
          {
            "type": "txt",
            "x": "68pt",
            "y": "38pt",
            "w": "80pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "fontSize": "9pt",
            "textColor": "#B3FFFFFF|#A6FFFFFF",
            "text": "${@i18n.rainPre}${rainAt}${@i18n.rainPost}"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${rainNow},1),0,if::(eq::(${rainFlag},1),0,1))]"
        },
        "react": [
          {
            "type": "txt",
            "x": "68pt",
            "y": "38pt",
            "w": "80pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "fontSize": "9pt",
            "textColor": "#B3FFFFFF|#A6FFFFFF",
