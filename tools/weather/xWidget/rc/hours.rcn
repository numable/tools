            "id": "mxDot",
            "type": "line",
            "x": "14.0pt",
            "y": "57.0pt",
            "w": "310.0pt",
            "h": "49.0pt",
            "points": "[$[findNotEmpty::(${mxX},-99)],$[findNotEmpty::(${mxY},-99)],$[findNotEmpty::(${mxX},-99)],$[findNotEmpty::(${mxY},-99)]]",
