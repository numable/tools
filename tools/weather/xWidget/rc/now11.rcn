            "h": "{parent.h}",
            "bgColor": "linear(#101A2E\\,#1C2A44\\,#33465F)@90|linear(#0A1220\\,#141F33\\,#25344A)@90"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_decor},glow)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "radial(#8CFFFFFF\\,#00FFFFFF)@0.8\\,0.16\\,0.6|radial(#66FFFFFF\\,#00FFFFFF)@0.8\\,0.16\\,0.6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_decor},fog)]"
