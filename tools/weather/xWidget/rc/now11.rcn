{
  "_note": "现在(11 · 微档,card-design-system §8.2):城市 / 气温 / 天况图标 + 今日高低。无时效锚(微档放不下,点进去看)。天空底、图标 path、色值都取自 now.rcn,与 22 档并排是一套。数据 = weather.df,不新增请求。",
  "rc": {
    "cells": [
      {
        "type": "op",
        "action": "set",
        "props": {
          "key": "_skyNote",
          "value": "0"
        }
      },
      {
        "type": "op",
        "action": "set",
        "props": {
          "key": "_sky",
          "value": "$[findNotEmpty::(${sky},overcast)]"
        }
      },
      {
        "type": "op",
        "action": "set",
        "props": {
          "key": "_decor",
          "value": "$[findNotEmpty::(${decor},fog)]"
        }
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},clear)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "linear(#2F7FC4\\,#6FB4E0\\,#A9D2EC)@90|linear(#1F5C90\\,#487F9E\\,#6E9AB0)@90"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
