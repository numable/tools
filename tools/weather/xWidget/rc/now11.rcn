            "h": "{parent.h}",
            "bgColor": "linear(#3E5A73\\,#5C7B93\\,#89A3B5)@90|linear(#2A3F52\\,#42596C\\,#647D8C)@90"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},snow)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
