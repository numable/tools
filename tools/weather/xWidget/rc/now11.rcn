        ]
      },
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#00000000\\,#4D000000)@90|linear(#00000000\\,#59000000)@90"
      },
      {
        "id": "srcDot",
        "type": "layer",
        "x": "8pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
