            "h": "{parent.h}",
            "bgColor": "linear(#7C93A8\\,#A8BCCB\\,#D6E3EC)@90|linear(#586A7A\\,#7B8D9B\\,#9FB0BC)@90"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},night)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
