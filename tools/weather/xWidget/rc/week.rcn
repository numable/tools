            "type": "txt",
            "x": "14pt",
            "y": "38pt",
            "w": "{parent.w}-90pt",
            "h": "-1",
            "text": "${@i18n.wk_calm}",
            "fontSize": "11.5pt",
            "textColor": "#FFFFFF|#FFFFFF",
