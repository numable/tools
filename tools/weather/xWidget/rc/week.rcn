              "val": "$[eq::(${wkToday},0)]"
            },
            "react": [
              {
                "type": "txt",
                "x": "14pt",
                "y": "38pt",
                "w": "{parent.w}-90pt",
                "h": "-1",
                "text": "${wkDate}${@i18n.wk_wet_d}",
                "fontSize": "11.5pt",
                "textColor": "#FFFFFF|#FFFFFF",
                "maxLines": "1",
                "typeface": "System-Bold"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
