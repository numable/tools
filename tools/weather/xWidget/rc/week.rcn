            "w": "{parent.w}",
            "h": "{parent.h}",
            "d": "M276.0 18.4m-1.3 0a1.3 1.3 0 102.6 0a1.3 1.3 0 10-2.6 0M326.7 345.6m-1.3 0a1.3 1.3 0 102.6 0a1.3 1.3 0 10-2.6 0",
