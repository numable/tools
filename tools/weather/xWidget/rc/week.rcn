        }
      },
      {
        "type": "layer",
        "x": "14pt",
        "y": "197pt",
        "w": "{parent.w}-28pt",
        "h": "40pt",
        "bgColor": "#2EFFFFFF|#1FFFFFFF",
        "cornerRadius": {
          "leftT": "12pt",
          "leftB": "12pt",
          "rightT": "12pt",
          "rightB": "12pt"
        }
      },
      {
        "type": "layer",
        "x": "14pt",
        "y": "244pt",
        "w": "{parent.w}-28pt",
        "h": "40pt",
        "bgColor": "#2EFFFFFF|#1FFFFFFF",
        "cornerRadius": {
          "leftT": "12pt",
          "leftB": "12pt",
          "rightT": "12pt",
          "rightB": "12pt"
        }
      },
      {
        "_note": "五行:forEach 走 daily.time,横向按字面下标取。温度条的起止按**全周区间**折算,不是绝对温标 —— 绝对阈值会让热带城市整周一片橙。",
        "type": "op",
        "action": "forEach",
        "props": {
          "items": "${daily.time}",
          "key": "_d",
          "index": "_i"
        },
        "react": [
          {
            "type": "op",
            "action": "set",
            "props": {
              "key": "_y",
              "value": "$[calc::(56+(${_i}-${pd})*47)]"
            },
            "_note": "⚠️ `past_days=1` 之后 daily 的第 0 项是**昨天**,forEach 会多跑一轮。行序按 `_i - pd` 排,并且下面整块绘制包在 `_i >= pd` 里 —— 少了那道门,第 6 行会落到 y=271 压住底部三块统计 tile。"
          },
          {
            "type": "op",
            "action": "set",
            "props": {
              "key": "_hi",
              "value": "$[parseNumber::(get::(${daily},temperature_2m_max[${_i}]),0)]"
            }
          },
          {
            "type": "op",
            "action": "set",
            "props": {
              "key": "_lo",
              "value": "$[parseNumber::(get::(${daily},temperature_2m_min[${_i}]),0)]"
            }
          },
          {
            "type": "op",
            "action": "set",
            "props": {
              "key": "_code",
              "value": "$[parseNumber::(get::(${daily},weather_code[${_i}]),0)]"
            }
          },
          {
            "type": "op",
            "action": "set",
            "props": {
              "key": "_g",
              "value": "$[if::(le::(${_code},0),clear,if::(le::(${_code},2),partly,if::(le::(${_code},3),cloudy,if::(le::(${_code},48),fog,if::(le::(${_code},57),drizzle,if::(le::(${_code},67),rain,if::(le::(${_code},77),snow,if::(le::(${_code},82),rain,if::(le::(${_code},86),snow,thunder)))))))))]"
            }
          },
          {
            "type": "op",
            "action": "set",
            "props": {
              "key": "_bx",
              "value": "$[calc::(132+128*(${_lo}-${_tn})/${_ts})]"
            }
          },
          {
            "type": "op",
            "action": "set",
            "props": {
              "key": "_bw",
              "value": "$[if::(gt::(calc::(128*(${_hi}-${_lo})/${_ts}),10),calc::(128*(${_hi}-${_lo})/${_ts}),10)]"
            }
          },
          {
            "type": "op",
            "action": "set",
            "props": {
              "key": "_c1",
              "value": "$[if::(le::(${_lo},0),#6FA8DC,if::(le::(${_lo},12),#5AA9E0,if::(le::(${_lo},22),#7FB6D8,if::(le::(${_lo},30),#E8A15C,#E0714B))))]"
            }
          },
          {
            "type": "op",
            "action": "set",
            "props": {
              "key": "_c2",
              "value": "$[if::(le::(${_hi},0),#6FA8DC,if::(le::(${_hi},12),#5AA9E0,if::(le::(${_hi},22),#7FB6D8,if::(le::(${_hi},30),#E8A15C,#E0714B))))]"
            }
          },
          {
            "_note": "只画预报日:`_i < pd` 的那一轮是昨天(`past_days=1` 带进来的),整行不画。\n⚠️ **所有** op:set 必须留在这道门**外面**、所有绘制节点必须在**里面**。第一版把门开在`_c1/_c2` 两个 set 之后 —— 那两个 set 原本就写在绘制节点中间 —— 于是行底板、日期、图标、低温标签、灰轨这 13 个节点全落在门外,昨天那一轮照画,在结论行下面渗出半行「23° + 一条灰轨」的鬼影(v64 前的几何:y=84+(0−1)×37=47)。dfrun 绿、lint 绿、geom_audit 也绿 —— 只有 tools/rcnrender 实拍看得见。",
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[ge::(${_i},${pd})]"
            },
            "react": [
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "$[eq::(${_i},${pd})]"
                },
                "react": [
                  {
                    "type": "txt",
                    "x": "24pt",
                    "y": "${_y}pt+15pt",
                    "w": "54pt",
                    "h": "-1",
                    "text": "${@i18n.today}",
                    "fontSize": "11.5pt",
                    "textColor": "#FFFFFF|#FFFFFF",
                    "maxLines": "1"
                  }
                ]
              },
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "$[gt::(${_i},${pd})]"
                },
                "react": [
                  {
                    "type": "txt",
                    "x": "24pt",
                    "y": "${_y}pt+15pt",
                    "w": "54pt",
                    "h": "-1",
                    "text": "$[findNotEmpty::(index::(${dlab},${_i}),--)]",
                    "fontSize": "11.5pt",
                    "textColor": "#FFFFFF|#FFFFFF",
                    "maxLines": "1"
                  }
                ]
              },
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "$[eq::(${_g},clear)]"
                },
                "react": [
                  {
                    "type": "path",
                    "x": "80pt",
                    "y": "${_y}pt+12pt",
                    "w": "16pt",
                    "h": "16pt",
                    "d": "M12 7.6a4.4 4.4 0 100 8.8 4.4 4.4 0 100-8.8M12 1.6v2.6M12 19.8v2.6M4.65 4.65l1.84 1.84M17.51 17.51l1.84 1.84M1.6 12h2.6M19.8 12h2.6M4.65 19.35l1.84-1.84M17.51 6.49l1.84-1.84",
                    "viewBox": "0 0 24 24",
                    "strokeColor": "#FFFFFF|#FFFFFF",
                    "lineWidth": "1.6pt",
                    "lineCap": "round",
                    "lineJoin": "round"
                  }
                ]
              },
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "$[eq::(${_g},partly)]"
                },
                "react": [
                  {
                    "type": "path",
                    "x": "80pt",
                    "y": "${_y}pt+12pt",
                    "w": "16pt",
                    "h": "16pt",
                    "d": "M8.8 6.2a3.4 3.4 0 014.9 2.2M8.8 1.9v2M3.6 4.1l1.4 1.4M1.9 9.3h2M6.5 18.6h9.9a3.6 3.6 0 000-7.2 5.6 5.6 0 00-10.8 1.5 3 3 0 00.9 5.7z",
                    "viewBox": "0 0 24 24",
