{
  "rc": {
    "cells": [
      {
        "type": "op",
        "action": "set",
        "props": {
          "key": "_skyNote",
          "value": "0"
        }
      },
      {
        "type": "op",
        "action": "set",
        "props": {
          "key": "_sky",
          "value": "$[findNotEmpty::(${sky},overcast)]"
        }
      },
      {
        "type": "op",
        "action": "set",
        "props": {
          "key": "_decor",
          "value": "$[findNotEmpty::(${decor},fog)]"
        }
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},clear)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "linear(#2F7FC4\\,#6FB4E0\\,#A9D2EC)@90|linear(#1F5C90\\,#487F9E\\,#6E9AB0)@90"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(${_sky},overcast)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "bgColor": "linear(#6B7E8E\\,#93A5B2\\,#B9C6CF)@90|linear(#4A5763\\,#6A7783\\,#8A96A0)@90"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
