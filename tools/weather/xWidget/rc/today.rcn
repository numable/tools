        "react": [
          {
            "type": "path",
            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "d": "M13.8 25.9m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M60.9 38.3m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M122.8 34.4m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M174.6 30.9m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M209.8 25.6m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M244.0 27.3m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M309.6 35.1m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M33.8 65.5m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M93.8 72.6m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M127.2 76.5m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M184.5 70.2m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M235.3 66.2m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M264.0 65.8m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M329.6 80.2m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M29.0 118.4m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M81.6 110.8m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M122.4 112.9m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M174.1 107.1m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M211.1 109.5m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M261.1 117.9m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0M298.1 114.2m-2.4 0a2.4 2.4 0 104.8 0a2.4 2.4 0 10-4.8 0",
