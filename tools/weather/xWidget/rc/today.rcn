            "x": "0pt",
            "y": "0pt",
            "w": "{parent.w}",
            "h": "{parent.h}",
            "d": "M16.0 32.9l-4 11M61.5 30.3l-4 11M104.6 29.7l-4 11M153.5 23.2l-4 11M189.0 33.6l-4 11M227.0 24.7l-4 11M277.6 25.7l-4 11M324.9 34.2l-4 11M49.6 59.8l-4 11M75.0 70.1l-4 11M123.9 66.7l-4 11M161.1 66.4l-4 11M214.2 67.3l-4 11M253.1 65.3l-4 11M291.1 68.5l-4 11M329.1 68.1l-4 11M12.6 107.9l-4 11M55.6 96.9l-4 11M97.9 99.4l-4 11M144.3 96.9l-4 11M183.1 96.7l-4 11M239.6 106.9l-4 11M275.9 109.8l-4 11M320.7 97.6l-4 11M42.0 145.6l-4 11M82.5 140.9l-4 11M114.7 141.6l-4 11M169.5 145.3l-4 11M201.6 148.7l-4 11M258.1 139.4l-4 11M286.9 144.2l-4 11M327.4 139.3l-4 11",
            "viewBox": "0 0 338 158",
            "strokeColor": "#73BFD8EA|#66BFD8EA",
            "lineWidth": "1.1pt",
