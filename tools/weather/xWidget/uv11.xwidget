{
  "_note": "紫外线(11)。2026-10-08 新增,数据走 sky24.df(与 sun / hours 同一条),零新增请求。参数与点击同 now。",
  "version": 2,
  "title": "紫外线",
  "sub": "微 · 今日紫外线峰值与档位",
  "i18n": {
    "en-US": {
      "title": "UV index",
      "sub": "Tiny · today's peak UV and level"
    }
  },
  "layout": 11,
  "params": {
    "lat": "auto",
    "lon": "auto",
    "city": "auto"
  },
  "ai": {
    "shows": "一座城市今天的紫外线峰值与强弱档位（最小的方块）",
    "params": {
      "city": {
        "kind": "auto",
        "group": [
          "city",
          "lat",
          "lon"
        ],
        "hint": "要换城市就三个一起填：city 写城市名，lat / lon 写这座城市的十进制纬度、经度（如东京 35.68 / 139.69，纽约 40.71 / -74.01）；只填 city 不生效。对坐标没把握就三个都留 auto（国内显示上海、海外显示纽约，装上后用户长按「编辑」换城市）"
      }
    }
  },
  "events": {
    "onClick": "/detail?lat=${lat}&lon=${lon}&city=${city}",
    "onEdit": "/pick"
  },
  "canvas": {
    "source": "@[file://rc/uv11.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/sky24.df]",
        "params": {
          "lat": "${lat}",
          "lon": "${lon}",
          "city": "${city}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "900"
      ]
    }
  }
}
