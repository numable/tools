{
  "_note": "未来 24 小时(42)。v62 由 12 小时温度柱重做成曲线 + 降水概率柱,数据改走 sky24.df。onClick/onEdit 与另外几张单城市卡同规(见 now.xwidget 的注释)。",
  "version": 2,
  "title": "未来 24 小时",
  "sub": "气温曲线 · 逐时降水概率",
  "i18n": {
    "en-US": {
      "title": "Next 24 hours",
      "sub": "Temperature curve and hourly rain chance"
    }
  },
  "layout": 42,
  "params": {
    "lat": "auto",
    "lon": "auto",
    "city": "auto"
  },
  "ai": {
    "shows": "一座城市未来 24 小时的逐时气温曲线与降水概率，以及几点起可能下雨",
    "params": {
      "city": {
        "kind": "auto",
        "group": [
          "city",
          "lat",
          "lon"
        ],
        "hint": "要换城市就三个一起填：city 写城市名，lat / lon 写这座城市的十进制纬度、经度（如东京 35.68 / 139.69，纽约 40.71 / -74.01）；只填 city 不生效。对坐标没把握就三个都留 auto（国内显示上海、海外显示纽约，装上后用户长按「编辑」换城市）"
      }
    }
  },
  "events": {
    "onClick": "/detail?lat=${lat}&lon=${lon}&city=${city}",
    "onEdit": "/pick"
  },
  "canvas": {
    "source": "@[file://rc/hours.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/sky24.df]",
        "params": {
          "lat": "${lat}",
          "lon": "${lon}",
          "city": "${city}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "900"
      ]
    }
  }
}
