{
  "_note": "空气质量(22)。v62 新增。单城市卡,参数与点击同 now。",
  "version": 2,
  "title": "空气质量",
  "sub": "AQI 仪表 · PM2.5 / PM10",
  "i18n": {
    "en-US": {
      "title": "Air quality",
      "sub": "AQI gauge with PM2.5 / PM10"
    }
  },
  "layout": 22,
  "params": {
    "lat": "auto",
    "lon": "auto",
    "city": "auto"
  },
  "ai": {
    "shows": "一座城市此刻的空气质量 AQI 仪表与档位，以及 PM2.5、PM10 浓度",
    "params": {
      "city": {
        "kind": "auto",
        "group": [
          "city",
          "lat",
          "lon"
        ],
        "hint": "要换城市就三个一起填：city 写城市名，lat / lon 写这座城市的十进制纬度、经度（如东京 35.68 / 139.69，纽约 40.71 / -74.01）；只填 city 不生效。对坐标没把握就三个都留 auto（国内显示上海、海外显示纽约，装上后用户长按「编辑」换城市）"
      }
    }
  },
  "events": {
    "onClick": "/detail?lat=${lat}&lon=${lon}&city=${city}",
    "onEdit": "/pick"
  },
  "canvas": {
    "source": "@[file://rc/air.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/air.df]",
        "params": {
          "lat": "${lat}",
          "lon": "${lon}",
          "city": "${city}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "1800"
      ]
    }
  }
}
