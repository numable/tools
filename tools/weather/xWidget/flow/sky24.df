      "props": {
        "key": "srM",
        "value": "$[calc::(subString::(${resp.daily.sunrise[0]},11,13)*60+subString::(${resp.daily.sunrise[0]},14,16))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ssM",
        "value": "$[calc::(subString::(${resp.daily.sunset[0]},11,13)*60+subString::(${resp.daily.sunset[0]},14,16))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "srS",
        "value": "$[subString::(${resp.daily.sunrise[0]},11,16)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ssS",
        "value": "$[subString::(${resp.daily.sunset[0]},11,16)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "sr2S",
        "value": "$[subString::(${resp.daily.sunrise[1]},11,16)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "sPh",
        "value": "$[if::(lt::(${nowM},${srM}),0,if::(ge::(${nowM},${ssM}),2,1))]"
      },
      "_note": "0 = 日出前 / 1 = 白天 / 2 = 日落后。"
    },
    {
      "op": "set",
      "props": {
        "key": "fr",
        "value": "$[if::(eq::(${sPh},1),calc::((${nowM}-${srM})/max::(calc::(${ssM}-${srM}),1)),if::(eq::(${sPh},2),1,0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "dlM",
        "value": "$[round::(calc::(findNotEmpty::(${resp.daily.daylight_duration[0]},0)/60))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "dlH",
        "value": "$[floor::(calc::(${dlM}/60))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "dlm",
        "value": "$[calc::(${dlM}-${dlH}*60)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "toM",
        "value": "$[if::(eq::(${sPh},1),calc::(${ssM}-${nowM}),if::(eq::(${sPh},0),calc::(${srM}-${nowM}),calc::(1440-${nowM}+calc::(subString::(${resp.daily.sunrise[1]},11,13)*60+subString::(${resp.daily.sunrise[1]},14,16)))))]"
      },
      "_note": "日出前 / 日落后 → 距下一次日出;白天 → 距日落。"
    },
    {
      "op": "set",
      "props": {
        "key": "toH",
        "value": "$[floor::(calc::(${toM}/60))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tom",
        "value": "$[calc::(${toM}-${toH}*60)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "uvNow",
        "value": "$[parseNumber::(findNotEmpty::(${resp.current.uv_index},0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "uvMax",
        "value": "$[parseNumber::(findNotEmpty::(${resp.daily.uv_index_max[0]},0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "uvLv",
        "value": "$[if::(lt::(${uvMax},3),1,if::(lt::(${uvMax},6),2,if::(lt::(${uvMax},8),3,if::(lt::(${uvMax},11),4,5))))]"
      },
      "_note": "按今日最大 UV 分档(WHO 五档)。"
    },
    {
      "op": "set",
      "props": {
        "key": "spA",
        "value": [
          "$[parseNumber::(calc::(134.0*calc::(${fr}*0/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*0/15)*(1-calc::(${fr}*0/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*1/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*1/15)*(1-calc::(${fr}*1/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*2/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*2/15)*(1-calc::(${fr}*2/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*3/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*3/15)*(1-calc::(${fr}*3/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*4/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*4/15)*(1-calc::(${fr}*4/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*5/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*5/15)*(1-calc::(${fr}*5/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*6/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*6/15)*(1-calc::(${fr}*6/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*7/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*7/15)*(1-calc::(${fr}*7/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*8/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*8/15)*(1-calc::(${fr}*8/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*9/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*9/15)*(1-calc::(${fr}*9/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*10/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*10/15)*(1-calc::(${fr}*10/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*11/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*11/15)*(1-calc::(${fr}*11/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*12/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*12/15)*(1-calc::(${fr}*12/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*13/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*13/15)*(1-calc::(${fr}*13/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*14/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*14/15)*(1-calc::(${fr}*14/15))),0.0)]",
          "$[parseNumber::(calc::(134.0*calc::(${fr}*15/15)),0.0)]",
          "$[parseNumber::(calc::(50.0-44.0*4*calc::(${fr}*15/15)*(1-calc::(${fr}*15/15))),0.0)]"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "sp",
        "value": "$[join::(${spA},\\,)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "sunX",
        "value": "$[parseNumber::(calc::(134.0*${fr}),0.0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "sunY",
        "value": "$[parseNumber::(calc::(50.0-44.0*4*${fr}*(1-${fr})),0.0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "at",
        "value": "$[formatDate::(${@time.nowMs},HH:mm)]"
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "city",
          "sky",
          "night",
          "pts",
          "mxLY",
          "mnLY",
          "mxX",
          "mxY",
          "mnX",
          "mnY",
          "mxLX",
          "mnLX",
          "tmaxS",
          "tminS",
          "rCase",
          "rP",
          "rH",
          "pMax",
          "hh0",
          "hh6",
          "hh12",
          "hh18",
          "srS",
          "ssS",
          "sr2S",
          "sPh",
          "fr",
          "dlH",
          "dlm",
          "toH",
          "tom",
          "uvNow",
          "uvMax",
          "uvLv",
          "sp",
          "sunX",
          "sunY",
          "at",
          "ph0",
          "py0",
          "ph1",
          "py1",
          "ph2",
          "py2",
          "ph3",
          "py3",
          "ph4",
          "py4",
          "ph5",
          "py5",
          "ph6",
          "py6",
          "ph7",
          "py7",
          "ph8",
          "py8",
          "ph9",
          "py9",
          "ph10",
          "py10",
          "ph11",
          "py11",
          "ph12",
          "py12",
          "ph13",
          "py13",
          "ph14",
          "py14",
          "ph15",
