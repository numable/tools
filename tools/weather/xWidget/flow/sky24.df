{
  "_note": "未来 24 小时 + 日照(hours / sun 卡与详情页块共用)。生成器 gen_weather_more.py。入参 lat/lon/city(显式携参槽;组件默认 `auto`,见 kit/wxenv.py)。",
  "version": 1,
  "i18n": {
    "zh-CN": {
      "autoCn": "上海",
      "autoUs": "纽约"
    },
    "en-US": {
      "autoCn": "Shanghai",
      "autoUs": "New York"
    }
  },
  "actions": [
    {
      "_note": "wxenv.auto_city:组件默认参数是哨兵 `auto`(doc/overseas-first.md §3)—— 城市不写进 .xwidget,在这里按 cnd 兜底:国内默认上海,海外默认纽约。用户选过城市就是真坐标,原样用。",
      "op": "set",
      "props": {
        "key": "_latIn",
        "value": "${lat}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_lonIn",
        "value": "${lon}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_cityRaw",
        "value": "${city}"
      }
    },
    {
      "_note": "国内默认判据(doc/overseas-first.md §1,逐字照抄):地区 cn,或地区未知且界面中文 → 1。",
      "op": "set",
      "props": {
        "key": "cnd",
        "value": "$[if::(eq::(${@app.region},cn),1,if::(eq::(${@app.region},overseas),0,if::(startsWith::(${@app.language},zh),1,0)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_auto",
        "value": "$[if::(eq::(${_latIn},auto),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lat",
        "value": "$[if::(eq::(${_auto},1),if::(eq::(${cnd},1),31.2222,40.7128),${_latIn})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lon",
        "value": "$[if::(eq::(${_auto},1),if::(eq::(${cnd},1),121.4581,-74.0060),${_lonIn})]"
      }
    },
    {
      "_note": "城市名走本文件 A 表(按 App 语言);宿主没注入 @i18n 时退回英文。",
      "op": "set",
      "props": {
        "key": "city",
        "value": "$[if::(eq::(${_auto},1),if::(eq::(${cnd},1),findNotEmpty::(${@i18n.autoCn},Shanghai),findNotEmpty::(${@i18n.autoUs},New York)),${_cityRaw})]"
      }
    },
    {
      "_note": "wxenv.unit_acts:温度单位设置 `data.wxUnit` = c / f(doc/overseas-first.md §7)。管理页「我的城市」里切换;没设过 → 按系统地区(@app.country)缺省。",
      "id": "_wxu",
      "action": "data.get",
      "params": {
        "key": "wxUnit",
        "default": ""
      }
    },
    {
      "_note": "读取屏障(勿删):data.get 之后紧邻的节点读不到结果。",
      "op": "set",
      "props": {
        "key": "_bu",
        "value": "1"
      }
    },
    {
      "_note": "缺省按国家:US / LR / MM / BS / BZ / KY / PW / FM / MH → f(华氏),其余(含 country 为空 = 未知)→ c。",
      "op": "set",
      "props": {
        "key": "unit",
        "value": "$[if::(eq::(${_wxu},f),f,if::(eq::(${_wxu},c),c,if::(or::(eq::(${@app.country},US),or::(eq::(${@app.country},LR),or::(eq::(${@app.country},MM),or::(eq::(${@app.country},BS),or::(eq::(${@app.country},BZ),or::(eq::(${@app.country},KY),or::(eq::(${@app.country},PW),or::(eq::(${@app.country},FM),eq::(${@app.country},MH))))))))),f,c)))]"
      }
    },
    {
      "_note": "拼到 Open-Meteo URL 末尾;摄氏时为空,URL 与此前逐字相同。",
      "op": "set",
      "props": {
        "key": "uq",
        "value": "$[if::(eq::(${unit},f),&temperature_unit=fahrenheit&wind_speed_unit=mph,)]"
      }
    },
    {
      "_note": "风速单位文案(渲染层拼在「风速」后面)。",
      "op": "set",
      "props": {
        "key": "wu",
        "value": "$[if::(eq::(${unit},f),mph,km/h)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_lat",
        "value": "${lat}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_lon",
        "value": "${lon}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_cacheIn",
        "value": "${cache}"
      },
      "_note": "入参先落地(§9.5 #3:方法参数里的 ${} 看不见 flow 入参)。"
    },
    {
      "op": "set",
      "props": {
        "key": "_cache",
        "value": "$[parseNumber::(${_cacheIn},0)]"
      },
      "_note": "1 = 详情页(读缓存);组件不传 = 0。"
    },
    {
      "op": "set",
      "props": {
        "key": "t0",
        "value": "${@time.nowMs}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ckey",
        "value": "$[connect::(c.s24.,${_lat},_,${_lon})]"
      }
    },
    {
      "id": "hitc",
      "action": "data.get",
      "params": {
        "key": "${ckey}",
        "default": {}
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hitTs",
        "value": "$[if::(eq::(findNotEmpty::(${hitc.u},c),${unit}),parseNumber::(${hitc.ts},0),0)]"
      },
      "_note": "缓存里记着取数时的温度单位;与现在的单位不同 = 当没缓存,重取(切了 °C / °F 不会贴出另一种单位的数)。"
    },
    {
      "_note": "页面有缓存 → 整段跳过(连接都不建);组件 / 无缓存 → 真取数,取到了才写。",
      "op": "if",
      "props": {
        "val": "$[if::(eq::(${_cache},1),if::(gt::(${hitTs},0),0,1),1)]"
      },
      "items": [
        {
          "id": "n_resp",
          "action": "request",
          "params": {
            "url": "https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code,is_day,uv_index&hourly=temperature_2m,precipitation_probability&daily=sunrise,sunset,daylight_duration,uv_index_max&timezone=auto&forecast_days=2&forecast_hours=24${uq}",
            "method": "GET",
            "formatType": "json"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "_b",
            "value": "1"
          },
          "_note": "⚠️ 请求/并发屏障(勿删):request 与 concurrent 之后**紧邻**的节点读不到响应(晚一拍合并,memory [[actionflow-concurrent-late-merge]])。删掉它 → 下面所有 index:: 静默取空 → 卡渲一片 `--`,而流仍报 success。"
        },
        {
          "op": "if",
          "props": {
            "val": "$[gt::(length::(${n_resp.current.time}),0)]"
          },
          "items": [
            {
              "op": "set",
              "props": {
                "key": "pack",
                "value": {
                  "ts": "${@time.nowMs}",
                  "u": "${unit}",
                  "resp": "${n_resp}"
                }
              }
            },
            {
              "action": "data.set",
              "params": {
                "key": "${ckey}",
                "value": "${pack}"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "box",
      "action": "data.get",
      "params": {
        "key": "${ckey}",
        "default": {}
      }
    },
    {
      "op": "set",
      "props": {
        "key": "resp",
        "value": "${box.resp}"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(if::(eq::(${_cache},1),1,if::(ge::(parseNumber::(${box.ts},0),${t0}),1,0)),0,1)]"
      },
      "items": [
        {
          "action": "error",
          "params": {
            "errorMsg": "weather_unreachable"
          }
        }
      ],
      "_note": "组件模式:回读到的不是这一轮写的 = 这轮没取到。"
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${resp.current.time}),0),0,1)]"
      },
      "items": [
        {
          "action": "error",
          "params": {
            "errorMsg": "weather_unreachable"
          }
        }
      ],
      "_note": "取数失败 → 抛错终止流,平台据此回落上次成功数据(G26/§7.2)"
    },
    {
      "op": "set",
      "props": {
        "key": "code",
        "value": "${resp.current.weather_code}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "night",
        "value": "$[if::(eq::(${resp.current.is_day},1),0,1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "group",
        "value": "$[if::(le::(${code},0),clear,if::(le::(${code},2),partly,if::(le::(${code},3),cloudy,if::(le::(${code},48),fog,if::(le::(${code},57),drizzle,if::(le::(${code},67),rain,if::(le::(${code},77),snow,if::(le::(${code},82),rain,if::(le::(${code},86),snow,thunder)))))))))]"
      },
      "_note": "WMO 天气码归组,与 weather.df 同式。"
    },
    {
      "op": "set",
      "props": {
        "key": "sky",
        "value": "$[if::(eq::(${night},1),night,if::(or::(eq::(${group},clear),eq::(${group},partly)),clear,if::(eq::(${group},snow),snow,if::(or::(eq::(${group},cloudy),eq::(${group},fog)),overcast,rain))))]"
      },
      "_note": "天空档:与 weather.df 同式(夜恒 night)。"
    },
    {
      "op": "set",
      "props": {
        "key": "t0",
        "value": "$[index::(${resp.hourly.temperature_2m},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t1",
        "value": "$[index::(${resp.hourly.temperature_2m},1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t2",
        "value": "$[index::(${resp.hourly.temperature_2m},2)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t3",
        "value": "$[index::(${resp.hourly.temperature_2m},3)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t4",
        "value": "$[index::(${resp.hourly.temperature_2m},4)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t5",
        "value": "$[index::(${resp.hourly.temperature_2m},5)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t6",
        "value": "$[index::(${resp.hourly.temperature_2m},6)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t7",
        "value": "$[index::(${resp.hourly.temperature_2m},7)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t8",
        "value": "$[index::(${resp.hourly.temperature_2m},8)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t9",
        "value": "$[index::(${resp.hourly.temperature_2m},9)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t10",
        "value": "$[index::(${resp.hourly.temperature_2m},10)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t11",
        "value": "$[index::(${resp.hourly.temperature_2m},11)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t12",
        "value": "$[index::(${resp.hourly.temperature_2m},12)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t13",
        "value": "$[index::(${resp.hourly.temperature_2m},13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t14",
        "value": "$[index::(${resp.hourly.temperature_2m},14)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t15",
        "value": "$[index::(${resp.hourly.temperature_2m},15)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t16",
        "value": "$[index::(${resp.hourly.temperature_2m},16)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t17",
        "value": "$[index::(${resp.hourly.temperature_2m},17)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t18",
        "value": "$[index::(${resp.hourly.temperature_2m},18)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t19",
        "value": "$[index::(${resp.hourly.temperature_2m},19)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t20",
        "value": "$[index::(${resp.hourly.temperature_2m},20)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t21",
        "value": "$[index::(${resp.hourly.temperature_2m},21)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t22",
        "value": "$[index::(${resp.hourly.temperature_2m},22)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "t23",
        "value": "$[index::(${resp.hourly.temperature_2m},23)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tmax",
        "value": "$[max::(${t0},${t1},${t2},${t3},${t4},${t5},${t6},${t7},${t8},${t9},${t10},${t11},${t12},${t13},${t14},${t15},${t16},${t17},${t18},${t19},${t20},${t21},${t22},${t23})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tmin",
        "value": "$[min::(${t0},${t1},${t2},${t3},${t4},${t5},${t6},${t7},${t8},${t9},${t10},${t11},${t12},${t13},${t14},${t15},${t16},${t17},${t18},${t19},${t20},${t21},${t22},${t23})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lo",
        "value": "$[calc::(${tmin}-0.5)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hi",
        "value": "$[max::(calc::(${tmax}+0.5),calc::(${tmin}+2))]"
      },
      "_note": "上下各留半度;全天温差 <1.5° 时撑到 2°,免得一条几乎平的线被拉成锯齿。"
    },
    {
      "op": "set",
      "props": {
        "key": "tArr",
        "value": [
          "${t0}",
          "${t1}",
          "${t2}",
          "${t3}",
          "${t4}",
          "${t5}",
          "${t6}",
          "${t7}",
          "${t8}",
          "${t9}",
          "${t10}",
          "${t11}",
          "${t12}",
          "${t13}",
          "${t14}",
          "${t15}",
          "${t16}",
          "${t17}",
          "${t18}",
          "${t19}",
          "${t20}",
          "${t21}",
          "${t22}",
          "${t23}"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pts_a",
        "value": [
          "0.0",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},0)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "13.2",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},1)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "26.4",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},2)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "39.7",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},3)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "52.9",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},4)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "66.1",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},5)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "79.3",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},6)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "92.5",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},7)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "105.7",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},8)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "119.0",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},9)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "132.2",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},10)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "145.4",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},11)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "158.6",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},12)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "171.8",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},13)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "185.0",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},14)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "198.3",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},15)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "211.5",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},16)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "224.7",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},17)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "237.9",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},18)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "251.1",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},19)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "264.3",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},20)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "277.6",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},21)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "290.8",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},22)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]",
          "304.0",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${tArr},23)-${lo})/(${hi}-${lo})))*37.0+6.0),0.0),999)]"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pts",
        "value": "$[join::(${pts_a},\\,)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "mxI",
