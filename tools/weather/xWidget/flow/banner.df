{"version":1,"_note":"信息源页海报专用(tools/banner/dyn_daily.py),组件不用。","actions":[{"_note":"温度单位:与组件流(cities.df / weather.df)同一条规则 —— 用户设置 data.wxUnit 优先,否则按 @app.country。","id":"_wxu","action":"data.get","params":{"key":"wxUnit","default":""}},{"op":"set","props":{"key":"_bu","value":"1"},"_note":"读取屏障(勿删):data.get 之后紧邻的节点读不到结果。"},{"op":"set","props":{"key":"unit","value":"$[if::(eq::(${_wxu},f),f,if::(eq::(${_wxu},c),c,if::(or::(eq::(${@app.country},US),or::(eq::(${@app.country},LR),or::(eq::(${@app.country},MM),or::(eq::(${@app.country},BS),or::(eq::(${@app.country},BZ),or::(eq::(${@app.country},KY),or::(eq::(${@app.country},PW),or::(eq::(${@app.country},FM),eq::(${@app.country},MH))))))))),f,c)))]"}},{"op":"set","props":{"key":"uq","value":"$[if::(eq::(${unit},f),&temperature_unit=fahrenheit,)]"}},{"op":"set","props":{"key":"cnd","value":"$[if::(eq::(${@app.region},cn),1,if::(eq::(${@app.region},overseas),0,if::(startsWith::(${@app.language},zh),1,0)))]"},"_note":"国内默认判据(dynkit.CND):国内五城从北到南,海外五城按时区东→西。"},{"op":"set","props":{"key":"ucn","value":"https://api.open-meteo.com/v1/forecast?current=temperature_2m,weather_code,is_day&timezone=auto&latitude=45.8038,39.9042,31.2304,30.5728,23.1291&longitude=126.5349,116.4074,121.4737,104.0668,113.2644${uq}"}},{"op":"set","props":{"key":"uov","value":"https://api.open-meteo.com/v1/forecast?current=temperature_2m,weather_code,is_day&timezone=auto&latitude=-33.8688,35.6762,48.8566,51.5072,40.7128&longitude=151.2093,139.6503,2.3522,-0.1276,-74.006${uq}"}},{"op":"set","props":{"key":"url","value":"$[if::(eq::(${cnd},1),${ucn},${uov})]"}},{"action":"request","id":"resp","params":{"url":"${url}","method":"GET","formatType":"json"}},{"op":"set","props":{"key":"_b","value":"1"},"_note":"⚠️ 请求屏障(勿删):request 之后紧邻的节点读不到响应(晚一拍合并)。"},{"op":"set","props":{"key":"_fail","value":"$[if::(gt::(length::(${resp}),4),0,1)]"}},{"op":"if","props":{"val":"${_fail}"},"items":[{"action":"error","params":{"errorMsg":"weather_unreachable"}}]},{"op":"set","props":{"key":"at","value":"$[formatDate::(${@time.nowMs},HH:mm)]"},"_note":"接口的时间是各城当地时间,海报右上统一写取数时刻(本机时间)。"},{"op":"set","props":{"key":"_x0","value":"$[index::(${resp},0)]"}},{"op":"set","props":{"key":"tp0","value":"$[if::(eq::(findNotEmpty::(${_x0.current.temperature_2m},__n),__n),,parseNumber::(${_x0.current.temperature_2m},0))]"}},{"op":"set","props":{"key":"_cd0","value":"${_x0.current.weather_code}"}},{"op":"set","props":{"key":"_nt0","value":"$[if::(eq::(${_x0.current.is_day},0),1,0)]"},"_note":"is_day 由服务端按该城自己的时区给(timezone=auto)。"},{"op":"set","props":{"key":"gp0","value":"$[if::(le::(${_cd0},0),clear,if::(le::(${_cd0},2),partly,if::(le::(${_cd0},3),cloudy,if::(le::(${_cd0},48),fog,if::(le::(${_cd0},57),drizzle,if::(le::(${_cd0},67),rain,if::(le::(${_cd0},77),snow,if::(le::(${_cd0},82),rain,if::(le::(${_cd0},86),snow,thunder)))))))))]"},"_note":"天况码 → 天况组:与 cities.df 的 gp0 逐字同式。"},{"op":"set","props":{"key":"ic0","value":"$[if::(eq::(${_nt0},1),if::(eq::(${gp0},clear),clear_night,if::(eq::(${gp0},partly),partly_night,${gp0})),${gp0})]"}},{"op":"set","props":{"key":"tm0","value":"$[subString::(${_x0.current.time},11,16)]"},"_note":"当地时间 HH:mm(current.time 是该城当地时刻,15 分钟取整)。"},{"op":"set","props":{"key":"_hr0","value":"$[parseNumber::(subString::(${_x0.current.time},11,13),0)]"}},{"op":"set","props":{"key":"_tc0","value":"$[if::(eq::(${unit},f),calc::((${_x0.current.temperature_2m}-32)/1.8),${_x0.current.temperature_2m})]"},"_note":"配色按摄氏度分档(华氏先换回摄氏)。"},{"op":"set","props":{"key":"k0","value":"$[if::(eq::(${cnd},1),if::(le::(${_tc0},5),0,if::(le::(${_tc0},12),1,if::(le::(${_tc0},18),2,if::(le::(${_tc0},24),3,4)))),if::(eq::(${_nt0},1),if::(or::(ge::(${_hr0},21),lt::(${_hr0},5)),0,1),if::(and::(ge::(${_hr0},10),lt::(${_hr0},16)),4,3)))]"},"_note":"栏底色档位 0–4(深→浅):国内按气温(≤5 / ≤12 / ≤18 / ≤24 / 更高);海外按昼夜(深夜 0、夜 1、白天 3、正午前后 4)。"},{"op":"set","props":{"key":"_x1","value":"$[index::(${resp},1)]"}},{"op":"set","props":{"key":"tp1","value":"$[if::(eq::(findNotEmpty: