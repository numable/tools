        "value": "$[if::(eq::(${_nt1},1),night,if::(or::(eq::(${gp1},clear),eq::(${gp1},partly)),clear,if::(eq::(${gp1},snow),snow,if::(or::(eq::(${gp1},cloudy),eq::(${gp1},fog)),overcast,rain))))]"
