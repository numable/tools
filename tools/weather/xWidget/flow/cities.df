        "value": "$[if::(le::(${_cd2},0),clear,if::(le::(${_cd2},2),partly,if::(le::(${_cd2},3),cloudy,if::(le::(${_cd2},48),fog,if::(le::(${_cd2},57),drizzle,if::(le::(${_cd2},67),rain,if::(le::(${_cd2},77),snow,if::(le::(${_cd2},82),rain,if::(le::(${_cd2},86),snow,thunder)))))))))]"
      }
    },
