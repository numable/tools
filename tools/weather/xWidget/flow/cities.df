        "value": "$[if::(eq::(${_nt2},1),night,if::(or::(eq::(${gp2},clear),eq::(${gp2},partly)),clear,if::(eq::(${gp2},snow),snow,if::(or::(eq::(${gp2},cloudy),eq::(${gp2},fog)),overcast,rain))))]"
