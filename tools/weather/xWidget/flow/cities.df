        "key": "gp1",
        "value": "$[if::(le::(${_cd1},0),clear,if::(le::(${_cd1},2),partly,if::(le::(${_cd1},3),cloudy,if::(le::(${_cd1},48),fog,if::(le::(${_cd1},57),drizzle,if::(le::(${_cd1},67),rain,if::(le::(${_cd1},77),snow,if::(le::(${_cd1},82),rain,if::(le::(${_cd1},86),snow,thunder)))))))))]"
