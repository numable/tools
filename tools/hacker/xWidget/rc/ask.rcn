        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "_note": "时效锚(card-design-system §3):右上角 / 9pt / 次级 / 右对齐 / 当天 HH:mm。"
