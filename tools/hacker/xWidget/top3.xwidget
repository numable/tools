{
  "version": 2,
  "title": "榜前两条",
  "sub": "2 条 · 按每小时得分排",
  "i18n": {
    "en-US": {
      "title": "Top two",
      "sub": "2 stories, ranked by points per hour"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "Hacker News 首页前 2 条（英文原标题），带得分、评论数、发布多久与每小时得分热度条"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/top3.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸 `@[file://…df]` 字符串绑定**传空入参**,卡片渲一片 `--` 且不报错。本包三张卡各有各的槽数,故各绑各的 flow —— 用同一条流靠 `n` 参数控制条数,只显示 1 条时另外 5 槽的 key 会**空**,而空 key 在验收台与真机上都是「取数坏了」的信号。",
        "flow": "@[file://flow/top3.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
