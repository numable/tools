{
  "version": 2,
  "title": "Show HN",
  "sub": "5 条 · 两天内网友做出来的东西",
  "i18n": {
    "en-US": {
      "title": "Show HN",
      "sub": "5 things people shipped in the last 48h"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "Hacker News 两天内最热的 5 条 Show HN 作品（英文原标题），带得分、评论数与热度条"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/show.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸 `@[file://…df]` 字符串绑定**传空入参**,卡片渲一片 `--` 且不报错。本卡与热榜卡同版式但**不同内容流** —— Show HN 是「别人做出来的东西」,与「新闻」是两个消费场景。",
        "flow": "@[file://flow/show.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    },
    "_note": "刷新比热榜卡慢一档:48 小时窗里按得分排的前五条,半小时内几乎不会变位次(§5「刷新是成本决策」)。"
  }
}
