{
  "version": 2,
  "title": "讨论最热",
  "sub": "1 条 · 24 小时内评论最多",
  "i18n": {
    "en-US": {
      "title": "Most discussed",
      "sub": "1 story with the most comments in 24h"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "Hacker News 24 小时内评论最多的一条（英文原标题），带评论数、得分与发布多久"
  },
  "events": {
    "onClick": "numable://self/page/story?id=${id0}&c=${c0}"
  },
  "canvas": {
    "source": "@[file://rc/talk.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸 `@[file://…df]` 字符串绑定**传空入参**,卡片渲一片 `--` 且不报错。本卡与另外四张各绑各的 flow —— 它问的是**另一个问题**(评论最多,不是得分最高),连数据源的查询窗口都不同(24 小时全站 vs 当前首页)。",
        "flow": "@[file://flow/talk.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
