{
  "version": 2,
  "title": "此刻榜首",
  "sub": "迷你 · 此刻最烧那条的标题",
  "i18n": {
    "en-US": {
      "title": "Top right now",
      "sub": "Mini · headline of the hottest story"
    }
  },
  "layout": 21,
  "params": {},
  "ai": {
    "shows": "Hacker News 此刻榜首那条的英文标题（一行迷你）"
  },
  "events": {
    "onClick": "numable://self/page/story?id=${id0}&c=${c0}"
  },
  "canvas": {
    "source": "@[file://rc/top1mini.rcn]",
    "depends": [
      {
        "_note": "21 迷你与 22 此刻榜首同问同答,复用 top1.df(1 槽,零新增请求);onClick 照抄 top1 —— 点进去就是这条的讨论页。",
        "flow": "@[file://flow/top1.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
