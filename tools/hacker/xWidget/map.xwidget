{
  "_note": "热度地图(44,v36):散点图,生成器 gen_hacker.py。",
  "version": 2,
  "title": "热度地图",
  "sub": "首页 30 条 · 上榜时长 × 得分 × 评论",
  "i18n": {
    "en-US": {
      "title": "Heat map",
      "sub": "Front page 30: age × points × comments"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "Hacker News 首页 30 条的散点图：上榜时长 × 得分 × 评论数，并标出上升最快的一条"
