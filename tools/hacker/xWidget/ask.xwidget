{
  "_note": "Ask HN(44,v36):与 Show HN 同版式、同 48 小时窗,生成器 gen_hacker.py。",
  "version": 2,
  "title": "Ask HN",
  "sub": "5 条 · 两天内大家在问的问题",
  "i18n": {
    "en-US": {
      "title": "Ask HN",
      "sub": "5 questions people asked in the last 48h"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "Hacker News 两天内最热的 5 条 Ask HN 提问（英文原标题），带得分、评论数与热度条"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/ask.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/ask.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "600"
      ]
    }
  }
}
