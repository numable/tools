{"version":1,"_note":"信息源页海报专用(tools/banner/dyn_news.py),组件不用。","actions":[{"action":"request","id":"resp","params":{"url":"https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=10&attributesToRetrieve=title,points,num_comments&attributesToHighlight=none","method":"GET","formatType":"json"}},{"op":"set","props":{"key":"_b","value":"1"},"_note":"⚠️ 请求屏障(勿删):request 之后紧邻的节点读不到响应(晚一拍合并)。"},{"op":"set","props":{"key":"_fail","value":"$[if::(gt::(length::(${resp.hits}),0),0,1)]"}},{"op":"if","props":{"val":"${_fail}"},"items":[{"action":"error","params":{"errorMsg":"hn_unreachable"}}]},{"op":"set","props":{"key":"reNL","value":"([^\r\n])[ \t]*[\r\n]+[ \t]*([^\r\n])"},"_note":"标题清洗:换行折成一个空格(照 v2ex 组件流)。"},{"op":"set","props":{"key":"rpNL","value":"$1 $2"}},{"op":"set","props":{"key":"at","value":"$[formatDate::(${@time.nowMs},HH:mm)]"},"_note":"榜单没有数据时间字段,用取数时刻作时间锚。"},{"op":"set","props":{"key":"t0","value":"$[replaceAll::(replaceAll::(${resp.hits[0].title},${reNL},${rpNL}),${reNL},${rpNL})]"}},{"op":"set","props":{"key":"p0","value":"$[parseNumber::(${resp.hits[0].points},0)]"}},{"op":"set","props":{"key":"c0","value":"$[parseNumber::(${resp.hits[0].num_comments},0)]"}},{"op":"set","props":{"key":"pmax","value":"$[max::(calc::(max::(pluck::(${resp.hits},points))),1)]"},"_note":"下限 1:防除零让条高变非数。"},{"op":"set","props":{"key":"hb0","value":"$[connect::(219.5\\,,parseNumber::(calc::(172-max::(calc::(findNotEmpty::(${resp.hits[0].points},0)/${pmax}*40),2)),0.0),\\,219.5\\,172)]"}},{"op":"set","props":{"key":"hb1","value":"$[connect::(229.5\\,,parseNumber::(calc::(172-max::(calc::(findNotEmpty::(${resp.hits[1].points},0)/${pmax}*40),2)),0.0),\\,229.5\\,172)]"}},{"op":"set","props":{"key":"hb2","value":"$[connect::(239.5\\,,parseNumber::(calc::(172-max::(calc::(findNotEmpty::(${resp.hits[2].points},0)/${pmax}*40),2)),0.0),\\,239.5\\,172)]"}},{"op":"set","props":{"key":"hb3","value":"$[connect::(249.5\\,,parseNumber::(calc::(172-max::(calc::(findNotEmpty::(${resp.hits[