{
  "_note": "链接来源(dom 卡):首页 30 条按域名聚合取前 5。生成器 gen_hacker.py。",
  "version": 1,
  "actions": [
    {
      "action": "request",
      "id": "resp",
      "params": {
        "url": "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=30&attributesToRetrieve=url,points,objectID&attributesToHighlight=none",
        "method": "GET",
        "formatType": "json"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_b",
        "value": "1"
      },
      "_note": "⚠️ 请求/并发屏障(勿删):request 与 concurrent 之后**紧邻**的节点读不到响应(晚一拍合并,memory [[actionflow-concurrent-late-merge]])。删掉它 → 下面所有 index:: 静默取空 → 卡渲一片 `--`,而流仍报 success。"
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${resp.hits}),0),0,1)]"
      },
      "items": [
        {
          "action": "error",
          "params": {
            "errorMsg": "hn_unreachable"
          }
        }
      ],
      "_note": "取数失败 → 抛错终止流,平台据此回落上次成功数据(G26/§7.2)"
    },
    {
      "op": "set",
      "props": {
        "key": "at",
        "value": "$[formatDate::(${@time.nowMs},HH:mm)]"
      },
      "_note": "榜单没有「数据时间」字段,用取数时刻兜底(标准 §4.4)。"
    },
    {
      "op": "set",
      "props": {
        "key": "reHost",
        "value": "^https?://(www[.])?"
      },
      "_note": "剥协议与 www.,再按 / 切取第一段 = 域名。⚠️ 正则先落地成键再传(括号会被方法参数解析器吃掉)。"
    },
    {
      "op": "set",
      "props": {
        "key": "dm",
        "value": [
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[0].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[1].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[2].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[3].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[4].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[5].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[6].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[7].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[8].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[9].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[10].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[11].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[12].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[13].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[14].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[15].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[16].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[17].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[18].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[19].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[20].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[21].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[22].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[23].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[24].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[25].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[26].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[27].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[28].url},),${reHost},),/),0))]",
          "$[toLowerCase::(index::(split::(replaceAll::(findNotEmpty::(${resp.hits[29].url},),${reHost},),/),0))]"
        ]
      },
      "_note": "逐条的域名;没有 url 的站内帖为空(不计)。"
    },
    {
      "op": "set",
      "props": {
        "key": "dRx",
        "value": "[^a-z0-9~@]"
      },
      "_note": "键里的正则特殊字符(`.` `+` …)统一换成 `_`,blob 与候选两边同换。"
    },
    {
      "op": "set",
      "props": {
        "key": "dSg",
        "value": [
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},0),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},1),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},2),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},3),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},4),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},5),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},6),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},7),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},8),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},9),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},10),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},11),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},12),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},13),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},14),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},15),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},16),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},17),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},18),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},19),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},20),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},21),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},22),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},23),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},24),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},25),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},26),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},27),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},28),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,index::(${dm},29),~)),${dRx},_)]"
        ]
      },
      "_note": "逐条的「~域名~」段。"
    },
    {
      "op": "set",
      "props": {
        "key": "dBl",
        "value": "$[connect::(@,join::(${dSg},),@)]"
      },
      "_note": "全部段拼成一串;两端 `@` 哨兵不能省(split 丢首尾空段)。"
    },
    {
      "op": "set",
      "props": {
        "key": "dCk",
        "value": [
          "$[replaceAll::(toLowerCase::(index::(${dm},0)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},1)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},2)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},3)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},4)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},5)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},6)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},7)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},8)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},9)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},10)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},11)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},12)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},13)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},14)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},15)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},16)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},17)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},18)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},19)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},20)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},21)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},22)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},23)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},24)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},25)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},26)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},27)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},28)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(index::(${dm},29)),${dRx},_)]"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "dLb",
        "value": [
          "$[findNotEmpty::(index::(${dm},0),)]",
          "$[findNotEmpty::(index::(${dm},1),)]",
          "$[findNotEmpty::(index::(${dm},2),)]",
          "$[findNotEmpty::(index::(${dm},3),)]",
          "$[findNotEmpty::(index::(${dm},4),)]",
          "$[findNotEmpty::(index::(${dm},5),)]",
          "$[findNotEmpty::(index::(${dm},6),)]",
          "$[findNotEmpty::(index::(${dm},7),)]",
          "$[findNotEmpty::(index::(${dm},8),)]",
          "$[findNotEmpty::(index::(${dm},9),)]",
          "$[findNotEmpty::(index::(${dm},10),)]",
          "$[findNotEmpty::(index::(${dm},11),)]",
          "$[findNotEmpty::(index::(${dm},12),)]",
          "$[findNotEmpty::(index::(${dm},13),)]",
          "$[findNotEmpty::(index::(${dm},14),)]",
          "$[findNotEmpty::(index::(${dm},15),)]",
          "$[findNotEmpty::(index::(${dm},16),)]",
          "$[findNotEmpty::(index::(${dm},17),)]",
          "$[findNotEmpty::(index::(${dm},18),)]",
          "$[findNotEmpty::(index::(${dm},19),)]",
          "$[findNotEmpty::(index::(${dm},20),)]",
          "$[findNotEmpty::(index::(${dm},21),)]",
          "$[findNotEmpty::(index::(${dm},22),)]",
          "$[findNotEmpty::(index::(${dm},23),)]",
          "$[findNotEmpty::(index::(${dm},24),)]",
          "$[findNotEmpty::(index::(${dm},25),)]",
          "$[findNotEmpty::(index::(${dm},26),)]",
          "$[findNotEmpty::(index::(${dm},27),)]",
          "$[findNotEmpty::(index::(${dm},28),)]",
          "$[findNotEmpty::(index::(${dm},29),)]"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "dCt",
        "value": [
          "$[if::(eq::(findNotEmpty::(index::(${dCk},0),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},0),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},1),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},1),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},2),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},2),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},3),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},3),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},4),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},4),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},5),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},5),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},6),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},6),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},7),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},7),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},8),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},8),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},9),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},9),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},10),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},10),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},11),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},11),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},12),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},12),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},13),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},13),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},14),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},14),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},15),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},15),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},16),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},16),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},17),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},17),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},18),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},18),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},19),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},19),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},20),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},20),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},21),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},21),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},22),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},22),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},23),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},23),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},24),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},24),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},25),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},25),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},26),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},26),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},27),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},27),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},28),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},28),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},29),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},29),~)))-1))]"
        ]
      },
      "_note": "每个候选出现了几次;空候选记 -1。"
    },
    {
      "op": "set",
      "props": {
        "key": "dCh",
        "value": "@"
      },
      "_note": "已选中的键「~a~~b~」:后一轮把它们排除掉(contains 一次判完,不必逐个比)。"
    },
    {
      "op": "set",
      "props": {
        "key": "dM0",
        "value": "$[max::(${dCt})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "dI0s",
        "value": [
          "$[if::(eq::(index::(${dCt},0),${dM0}),0,999)]",
          "$[if::(eq::(index::(${dCt},1),${dM0}),1,999)]",
          "$[if::(eq::(index::(${dCt},2),${dM0}),2,999)]",
          "$[if::(eq::(index::(${dCt},3),${dM0}),3,999)]",
          "$[if::(eq::(index::(${dCt},4),${dM0}),4,999)]",
          "$[if::(eq::(index::(${dCt},5),${dM0}),5,999)]",
          "$[if::(eq::(index::(${dCt},6),${dM0}),6,999)]",
          "$[if::(eq::(index::(${dCt},7),${dM0}),7,999)]",
          "$[if::(eq::(index::(${dCt},8),${dM0}),8,999)]",
          "$[if::(eq::(index::(${dCt},9),${dM0}),9,999)]",
          "$[if::(eq::(index::(${dCt},10),${dM0}),10,999)]",
          "$[if::(eq::(index::(${dCt},11),${dM0}),11,999)]",
          "$[if::(eq::(index::(${dCt},12),${dM0}),12,999)]",
          "$[if::(eq::(index::(${dCt},13),${dM0}),13,999)]",
          "$[if::(eq::(index::(${dCt},14),${dM0}),14,999)]",
          "$[if::(eq::(index::(${dCt},15),${dM0}),15,999)]",
