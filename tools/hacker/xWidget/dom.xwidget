{
  "_note": "链接来源(42,2026-10-08):首页 30 条按域名聚合取前 5。rc / df 由生成器 gen_hacker.py 产出,本文件手写。",
  "version": 2,
  "title": "链接来源",
  "sub": "首页 30 条的链接都指向哪儿",
  "i18n": {
    "en-US": {
      "title": "Top domains",
      "sub": "Where the front page 30 link to"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "Hacker News 首页 30 条按链接域名归类，前 5 个域名各占几条（条形图）"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/dom.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/dom.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
