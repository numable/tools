{
  "version": 2,
  "title": "热榜",
  "sub": "5 条 · 每条带热度条",
  "i18n": {
    "en-US": {
      "title": "Front page",
      "sub": "5 stories, each with a heat bar"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "Hacker News 热榜前 5 条（英文原标题），带得分、评论数、每小时得分热度条与 24 小时新上榜数"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/list.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸 `@[file://…df]` 字符串绑定**传空入参**,卡片渲一片 `--` 且不报错。本包三张卡各有各的槽数,故各绑各的 flow —— 用同一条流靠 `n` 参数控制条数,只显示 1 条时另外 5 槽的 key 会**空**,而空 key 在验收台与真机上都是「取数坏了」的信号。",
        "flow": "@[file://flow/list.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
