{
  "version": 2,
  "title": "此刻榜首",
  "sub": "1 条 · 此刻最烧的那条",
  "i18n": {
    "en-US": {
      "title": "Top right now",
      "sub": "1 story, the hottest right now"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "Hacker News 此刻榜首一条（英文原标题）：得分、评论数、发布多久与每小时得分"
  },
  "events": {
    "onClick": "numable://self/page/story?id=${id0}&c=${c0}"
  },
  "canvas": {
    "source": "@[file://rc/top1.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸 `@[file://…df]` 字符串绑定**传空入参**,卡片渲一片 `--` 且不报错。本包三张卡各有各的槽数,故各绑各的 flow —— 用同一条流靠 `n` 参数控制条数,只显示 1 条时另外 5 槽的 key 会**空**,而空 key 在验收台与真机上都是「取数坏了」的信号。",
        "flow": "@[file://flow/top1.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
