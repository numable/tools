{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FCFBFE\\,#F7F3FD)@90|linear(#15171A\\,#191920\\,#201E2A)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12.0pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#8250DF|#A371F7",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "21.0pt",
        "y": "11pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.b_latest}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "12.0pt",
        "y": "14pt",
        "w": "134.0pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${at},)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "_note": "没有数据(取数失败且无旧数据)时不画右上锚:一个 `--` 时刻读起来像坏了(2026-10-08)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ls},l),1,0)]"
        },
        "react": [
          {
            "id": "nm",
            "type": "txt",
            "x": "12.0pt",
            "y": "38pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "2",
            "lineSpacing": "2pt",
            "text": "$[findNotEmpty::(${rows[0].nm},--)]",
            "fontSize": "16pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "id": "ow",
            "type": "txt",
            "x": "12.0pt",
            "y": "{nm.b}+2pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "$[findNotEmpty::(${rows[0].ow},)]",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B"
          },
          {
            "id": "vS",
            "type": "txt",
            "x": "12.0pt",
            "y": "98pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[if::(eq::(${rows[0].st},o),${rows[0].tv},if::(eq::(${rows[0].st},n),${@i18n.noVer},--))]",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#8250DF|#A371F7",
            "hide": "$[if::(eq::(if::(eq::(${rows[0].st},o),if::(le::(length::(${rows[0].tv}),9),1,if::(le::(length::(${rows[0].tv}),14),2,3)),1),1),0,1)]"
          },
          {
            "id": "vM",
            "type": "txt",
            "x": "12.0pt",
            "y": "101pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[if::(eq::(${rows[0].st},o),${rows[0].tv},if::(eq::(${rows[0].st},n),${@i18n.noVer},--))]",
            "fontSize": "15pt",
            "typeface": "System-Bold",
            "textColor": "#8250DF|#A371F7",
            "hide": "$[if::(eq::(if::(eq::(${rows[0].st},o),if::(le::(length::(${rows[0].tv}),9),1,if::(le::(length::(${rows[0].tv}),14),2,3)),1),2),0,1)]"
          },
          {
            "id": "vL",
            "type": "txt",
            "x": "12.0pt",
            "y": "103pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[if::(eq::(${rows[0].st},o),${rows[0].tv},if::(eq::(${rows[0].st},n),${@i18n.noVer},--))]",
            "fontSize": "12pt",
            "typeface": "System-Bold",
            "textColor": "#8250DF|#A371F7",
            "hide": "$[if::(eq::(if::(eq::(${rows[0].st},o),if::(le::(length::(${rows[0].tv}),9),1,if::(le::(length::(${rows[0].tv}),14),2,3)),1),3),0,1)]"
          },
          {
            "id": "mN",
            "type": "txt",
            "x": "12.0pt",
            "y": "133pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "$[findNotEmpty::(${rows[0].a},--)]${@i18n.sp}$[if::(eq::(${rows[0].u},1),${@i18n.uM},if::(eq::(${rows[0].u},2),${@i18n.uH},if::(eq::(${rows[0].u},3),${@i18n.uD},if::(eq::(${rows[0].u},4),${@i18n.uMo},if::(eq::(${rows[0].u},5),${@i18n.uY},)))))] $[if::(eq::(${rows[0].pr},y),${@i18n.preS},)]",
            "fontSize": "10pt",
            "textColor": "#8250DF|#A371F7",
            "hide": "$[if::(eq::(${rows[0].st},o),if::(eq::(${rows[0].w},y),0,1),1)]",
            "_note": "48 小时内发布:这一行用源色(「新」的信号);其余用次色。两格 hide 二选一(表达式挑不了双分支色)。"
          },
          {
            "id": "mO",
            "type": "txt",
            "x": "12.0pt",
            "y": "133pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "$[findNotEmpty::(${rows[0].a},--)]${@i18n.sp}$[if::(eq::(${rows[0].u},1),${@i18n.uM},if::(eq::(${rows[0].u},2),${@i18n.uH},if::(eq::(${rows[0].u},3),${@i18n.uD},if::(eq::(${rows[0].u},4),${@i18n.uMo},if::(eq::(${rows[0].u},5),${@i18n.uY},)))))] $[if::(eq::(${rows[0].pr},y),${@i18n.preS},)]",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "hide": "$[if::(eq::(${rows[0].st},o),if::(eq::(${rows[0].w},y),1,0),1)]"
          },
          {
            "id": "mF",
            "type": "txt",
            "x": "12.0pt",
            "y": "133pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.fail}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "hide": "$[if::(eq::(${rows[0].st},f),0,1)]"
          }
        ],
        "_note": "有关注:最近发版的那一个仓库。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ls},e),1,0)]"
        },
        "react": [
          {
            "id": "eT",
            "type": "txt",
            "x": "12.0pt",
            "y": "44pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "2",
            "text": "${@i18n.emptyT}",
            "fontSize": "13pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "id": "eS",
            "type": "txt",
            "x": "12.0pt",
            "y": "{eT.b}+6pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "3",
            "text": "${@i18n.emptyS}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ls},l),0,if::(eq::(${ls},e),0,1))]"
        },
        "react": [
          {
            "id": "sN",
            "type": "txt",
            "x": "12.0pt",
            "y": "38pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "14pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          },
          {
            "id": "sV",
            "type": "txt",
            "x": "12.0pt",
            "y": "95pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          }
        ],
        "_note": "取数失败且没有旧数据:骨架 + `--`(G9)。"
      }
    ],
    "i18n": {
      "zh-CN": {
        "b_latest": "最近发布",
        "noVer": "暂无版本",
        "fail": "取不到",
        "emptyT": "还没有关注的项目",
        "emptyS": "点开添加 GitHub 上的开源项目",
        "preS": "· 预发布",
        "uM": "分钟前",
        "uH": "小时前",
        "uD": "天前",
        "uMo": "个月前",
        "uY": "年前",
        "sp": " "
      },
      "en-US": {
        "b_latest": "Latest",
        "noVer": "No releases",
        "fail": "Unavailable",
        "emptyT": "No repos yet",
        "emptyS": "Tap to add GitHub repos",
        "preS": "· Pre-release",
        "uM": "m ago",
        "uH": "h ago",
        "uD": "d ago",
        "uMo": "mo ago",
        "uY": "y ago",
        "sp": ""
      }
    },
    "i18nEmptyOk": [
      "sp"
    ],
    "_note": "生成器 tools/infosource/gen_releases.py。sp = 数字与单位之间的间隔:中文 NBSP(在串中间、两层 trim 都够不着),英文紧排为空。"
  }
}
