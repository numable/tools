{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FCFBFE\\,#F7F3FD)@90|linear(#15171A\\,#191920\\,#201E2A)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#8250DF|#A371F7",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.b_week}",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "v",
        "type": "txt",
        "x": "8pt",
        "y": "22pt",
        "w": "54pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(${ls},l),findNotEmpty::(${wk},--),--)]",
        "fontSize": "20pt",
        "typeface": "System-Bold",
        "textColor": "#8250DF|#A371F7"
      },
      {
        "id": "u",
        "type": "txt",
        "x": "8pt",
        "y": "46pt",
        "w": "54pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "${@i18n.wkOf}$[findNotEmpty::(${n},--)]${@i18n.wkU}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(${ls},l),0,1)]"
      },
      {
        "id": "ue",
        "type": "txt",
        "x": "8pt",
        "y": "46pt",
        "w": "54pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "${@i18n.wkE}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(${ls},e),0,1)]"
      }
    ],
    "i18n": {
      "zh-CN": {
        "b_week": "本周新版",
        "wkOf": "/ ",
        "wkU": " 个项目",
        "wkE": "还没关注"
      },
      "en-US": {
        "b_week": "7 days",
        "wkOf": "of ",
        "wkU": " repos",
        "wkE": "No repos"
      }
    },
    "_note": "生成器 tools/infosource/gen_releases.py(11 微,复用 board.df)。"
  }
}
