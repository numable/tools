{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FCFBFE\\,#F7F3FD)@90|linear(#15171A\\,#191920\\,#201E2A)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#8250DF|#A371F7",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.b_latest}",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "10pt",
        "y": "10.5pt",
        "w": "138pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${at},)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ls},l),1,0)]"
        },
        "react": [
          {
            "id": "nm",
            "type": "txt",
            "x": "10pt",
            "y": "26pt",
            "w": "138pt",
            "h": "-1",
            "maxLines": "1",
            "text": "$[findNotEmpty::(${rows[0].nm},--)]",
            "fontSize": "15pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "id": "vS",
            "type": "txt",
            "x": "10pt",
            "w": "84pt",
            "y": "44pt",
            "h": "13pt",
            "alignmentV": "1",
            "maxLines": "1",
            "text": "${rows[0].tv}",
            "fontSize": "10pt",
            "typeface": "System-Bold",
            "textColor": "#8250DF|#A371F7",
            "hide": "$[if::(eq::(${rows[0].st},o),if::(gt::(length::(${rows[0].tv}),11),1,0),1)]"
          },
          {
            "id": "vL",
            "type": "txt",
            "x": "10pt",
            "w": "138pt",
            "y": "44pt",
            "h": "13pt",
            "alignmentV": "1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${rows[0].tv}",
            "fontSize": "10pt",
            "typeface": "System-Bold",
            "textColor": "#8250DF|#A371F7",
            "hide": "$[if::(eq::(${rows[0].st},o),if::(gt::(length::(${rows[0].tv}),11),0,1),1)]"
          },
          {
            "id": "vX",
            "type": "txt",
            "x": "10pt",
            "w": "138pt",
            "y": "44pt",
            "h": "13pt",
            "alignmentV": "1",
            "maxLines": "1",
            "text": "$[if::(eq::(${rows[0].st},o),${rows[0].tv},if::(eq::(${rows[0].st},n),${@i18n.noVer},--))]",
            "fontSize": "10pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B",
            "hide": "$[if::(eq::(${rows[0].st},o),1,0)]",
            "_note": "暂无版本(仓库在、一个 tag 都没有)/ `--`(这个仓库取不到)。"
          },
          {
            "id": "ag",
            "type": "txt",
            "x": "10pt",
            "w": "138pt",
            "y": "44pt",
            "h": "13pt",
            "alignmentV": "1",
            "maxLines": "1",
            "alignmentH": "2",
            "text": "$[findNotEmpty::(${rows[0].a},--)]${@i18n.sp}$[if::(eq::(${rows[0].u},1),${@i18n.uM},if::(eq::(${rows[0].u},2),${@i18n.uH},if::(eq::(${rows[0].u},3),${@i18n.uD},if::(eq::(${rows[0].u},4),${@i18n.uMo},if::(eq::(${rows[0].u},5),${@i18n.uY},)))))]",
            "fontSize": "9.5pt",
            "textColor": "#6B7280|#8E939B",
            "hide": "$[if::(eq::(${rows[0].st},o),if::(gt::(length::(${rows[0].tv}),11),1,0),1)]"
          }
        ],
        "_note": "有关注:最近发版的那一个仓库。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ls},l),0,1)]"
        },
        "react": [
          {
            "id": "sN",
            "type": "txt",
            "x": "10pt",
            "y": "26pt",
            "w": "138pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "15pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          },
          {
            "id": "sV",
            "type": "txt",
            "x": "10pt",
            "w": "138pt",
            "y": "44pt",
            "h": "13pt",
            "alignmentV": "1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "10pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          }
        ],
        "_note": "没关注任何项目 / 取数失败 / 还没取过:结构照画、值位 `--`(§5;迷你档放不下 22 那两行引导)。"
      }
    ],
    "i18n": {
      "zh-CN": {
        "b_latest": "最近发布",
        "noVer": "暂无版本",
        "uM": "分钟前",
        "uH": "小时前",
        "uD": "天前",
        "uMo": "个月前",
        "uY": "年前",
        "sp": " "
      },
      "en-US": {
        "b_latest": "Latest",
        "noVer": "No releases",
        "uM": "m ago",
        "uH": "h ago",
        "uD": "d ago",
        "uMo": "mo ago",
        "uY": "y ago",
        "sp": ""
      }
    },
    "i18nEmptyOk": [
      "sp"
    ],
    "_note": "生成器 tools/infosource/gen_releases.py(21 迷你,复用 board.df)。sp = 数字与单位之间的间隔:中文 NBSP,英文为空。"
  }
}
