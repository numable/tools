{
  "_note": "生成器 tools/infosource/gen_releases.py。三个组件 + 「新版本提醒」取数段共用。组件 .df **不缓存**(G23 契约 5)。只取 tag 名 / 链接 / 时间,发布说明一律不读(§3.13)。",
  "version": 1,
  "actions": [
    {
      "op": "set",
      "props": {
        "key": "tzNow",
        "value": "${@time.nowMs}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzLf",
        "value": "$[formatDate::(${tzNow},yyyy-MM-dd HH:mm)]"
      },
      "_note": "此刻的**本机**年月日时分。pattern 只用纯 token + `-` `:` 空格(跨端安全子集,G4c)。"
    },
    {
      "op": "set",
      "props": {
        "key": "tzY",
        "value": "$[subString::(${tzLf},0,4)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzMo",
        "value": "$[subString::(${tzLf},5,7)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzD",
        "value": "$[subString::(${tzLf},8,10)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzH",
        "value": "$[subString::(${tzLf},11,13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzMi",
        "value": "$[subString::(${tzLf},14,16)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzAdj",
        "value": "$[if::(le::(${tzMo},2),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzYoe",
        "value": "$[calc::(${tzY}-2000-${tzAdj})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzMp",
        "value": "$[calc::(${tzMo}-3+12*${tzAdj})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzDb",
        "value": "$[floor::(calc::((153*${tzMp}+2)/5))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzQ4",
        "value": "$[floor::(calc::(${tzYoe}/4))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzDays",
        "value": "$[calc::(11017+${tzYoe}*365+${tzQ4}+${tzDb}+${tzD}-1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzE",
        "value": "$[calc::(${tzDays}*86400000+${tzH}*3600000+${tzMi}*60000)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzMin",
        "value": "$[calc::(floor::(calc::(${tzNow}/60000))*60000)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzO",
        "value": "$[round::(calc::(${tzE}-${tzMin}))]"
      },
      "_note": "本机时区偏移(毫秒):东八区 = 28800000。round 是为了 Android 上 calc 返回 double 时不带 .0。"
    },
    {
      "op": "set",
      "props": {
        "key": "reId",
        "value": "Repository/[0-9]+/"
      },
      "_note": "tag 名在 `<id>tag:github.com,2008:Repository/<数字>/<tag 名></id>` 里 —— 按这段切。"
    },
    {
      "op": "set",
      "props": {
        "key": "rePre",
        "value": "[0-9][-._+]?(alpha|beta|rc|canary|nightly|preview|pre|dev|next|snapshot|insiders|experimental)|[0-9](a|b)[0-9]|[0-9][-.]m[0-9]"
      },
      "_note": "预发布判据(对小写 tag 名),见生成器头注。"
    },
    {
      "op": "set",
      "props": {
        "key": "reDig",
        "value": "[0-9]"
      },
      "_note": "不含数字的 tag(nightly / stable / latest)是会移动的指针,不是版本 —— 一律当预发布。"
    },
    {
      "op": "set",
      "props": {
        "key": "reHd",
        "value": "href=\"https://github.com/"
      },
      "_note": "feed 头部第一个 href = 仓库**正名**(改名仓库 301 之后的那个名字)。"
    },
    {
      "id": "lst",
      "action": "data.get",
      "params": {
        "key": "rl_list",
        "default": []
      },
      "_note": "关注列表 [{o, r}] 由首页写进 data.rl_list;组件与提醒自己读 —— 用户在首页增删,组件自动跟上。没存过 = 空列表(不替用户关注任何仓库),组件渲空态。"
    },
    {
      "op": "set",
      "props": {
        "key": "_bl",
        "value": "1"
      },
      "_note": "⚠️ 请求/并发屏障(勿删):request 与 concurrent 之后**紧邻**的节点读不到响应(晚一拍合并,memory [[actionflow-concurrent-late-merge]])。删掉它 → 下面所有 index:: 静默取空 → 卡渲一片 `--`,而流仍报 success。"
    },
    {
      "op": "set",
      "props": {
        "key": "n",
        "value": "$[min::(length::(${lst}),8)]"
      },
      "_note": "关注数,封顶 8(首页同一上限)。"
    },
    {
      "op": "set",
      "props": {
        "key": "ls",
        "value": "$[if::(gt::(${n},0),l,e)]"
      },
      "_note": "列表态,**字符串**枚举:l = 有关注 / e = 空列表。渲染层按它三分(第三态 = 键缺失 = 取数失败 / 还没取过)。不用 `n` 判:`eq::(空,0)` 在 VParser 里为真,取数失败会被画成「还没有关注的项目」。"
    },
    {
      "op": "set",
      "props": {
        "key": "o0",
        "value": "${lst[0].o}"
      },
      "_note": "第 0 槽:入参先落地成键,方法参数里才看得见(§9.5 #3)。"
    },
    {
      "op": "set",
      "props": {
        "key": "r0",
        "value": "${lst[0].r}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "h0",
        "value": "$[if::(gt::(length::(${r0}),0),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rl0",
        "value": "$[toLowerCase::(${r0})]"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "${h0}"
      },
      "items": [
        {
          "id": "x0",
          "action": "request",
          "params": {
            "url": "https://github.com/${o0}/${r0}/tags.atom",
            "method": "GET",
            "formatType": "string",
            "timeout": "10000",
            "header": {
              "User-Agent": "Numable-releases/1 (+https://numable.app)",
              "Accept": "application/atom+xml"
            }
          }
        }
      ]
    },
    {
      "op": "set",
      "props": {
        "key": "_b0",
        "value": "1"
      },
      "_note": "⚠️ 请求/并发屏障(勿删):request 与 concurrent 之后**紧邻**的节点读不到响应(晚一拍合并,memory [[actionflow-concurrent-late-merge]])。删掉它 → 下面所有 index:: 静默取空 → 卡渲一片 `--`,而流仍报 success。"
    },
    {
      "op": "set",
      "props": {
        "key": "rm0",
        "value": "^(v?[0-9]|${rl0}[-@]?v?[0-9])"
      },
      "_note": "「主线」tag 判据(2026-10-08):`v1.2` / `1.2` / `<仓库名>@1.2` / `<仓库名>-v1.2` / `go1.2`。monorepo(withastro/astro)的 feed 里混着一串子包 tag(`@astrojs/netlify@8.2.8`),用户关注 withastro/astro 想看的是 astro 本身 —— 先挑主线正式版,没有再退回任意正式版,再退回第一条(标预发布)。"
    },
    {
      "op": "set",
      "props": {
        "key": "g0",
        "value": "$[split::(${x0},<entry>)]"
      },
      "_note": "按 `<entry>` 切:第 0 段是 feed 头部,条目从第 1 段起。"
    },
    {
      "op": "set",
      "props": {
        "key": "Q0",
        "value": {
          "ok": "$[if::(contains::(${x0},<feed),1,0)]",
          "ne": "$[calc::(length::(${g0})-1)]",
          "cn": "$[index::(split::(index::(split::(${x0},${reHd}),1),/releases),0)]",
          "bits": "$[connect::(if::(matches::(index::(split::(index::(split::(${g0[1]},${reId}),1),</id>),0),${reDig}),if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[1]},${reId}),1),</id>),0)),${rePre}),p,if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[1]},${reId}),1),</id>),0)),${rm0}),s,t)),p),if::(matches::(index::(split::(index::(split::(${g0[2]},${reId}),1),</id>),0),${reDig}),if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[2]},${reId}),1),</id>),0)),${rePre}),p,if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[2]},${reId}),1),</id>),0)),${rm0}),s,t)),p),if::(matches::(index::(split::(index::(split::(${g0[3]},${reId}),1),</id>),0),${reDig}),if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[3]},${reId}),1),</id>),0)),${rePre}),p,if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[3]},${reId}),1),</id>),0)),${rm0}),s,t)),p),if::(matches::(index::(split::(index::(split::(${g0[4]},${reId}),1),</id>),0),${reDig}),if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[4]},${reId}),1),</id>),0)),${rePre}),p,if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[4]},${reId}),1),</id>),0)),${rm0}),s,t)),p),if::(matches::(index::(split::(index::(split::(${g0[5]},${reId}),1),</id>),0),${reDig}),if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[5]},${reId}),1),</id>),0)),${rePre}),p,if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[5]},${reId}),1),</id>),0)),${rm0}),s,t)),p),if::(matches::(index::(split::(index::(split::(${g0[6]},${reId}),1),</id>),0),${reDig}),if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[6]},${reId}),1),</id>),0)),${rePre}),p,if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[6]},${reId}),1),</id>),0)),${rm0}),s,t)),p),if::(matches::(index::(split::(index::(split::(${g0[7]},${reId}),1),</id>),0),${reDig}),if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[7]},${reId}),1),</id>),0)),${rePre}),p,if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[7]},${reId}),1),</id>),0)),${rm0}),s,t)),p),if::(matches::(index::(split::(index::(split::(${g0[8]},${reId}),1),</id>),0),${reDig}),if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[8]},${reId}),1),</id>),0)),${rePre}),p,if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[8]},${reId}),1),</id>),0)),${rm0}),s,t)),p),if::(matches::(index::(split::(index::(split::(${g0[9]},${reId}),1),</id>),0),${reDig}),if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[9]},${reId}),1),</id>),0)),${rePre}),p,if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[9]},${reId}),1),</id>),0)),${rm0}),s,t)),p),if::(matches::(index::(split::(index::(split::(${g0[10]},${reId}),1),</id>),0),${reDig}),if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[10]},${reId}),1),</id>),0)),${rePre}),p,if::(matches::(toLowerCase::(index::(split::(index::(split::(${g0[10]},${reId}),1),</id>),0)),${rm0}),s,t)),p))]"
        }
      },
      "_note": "ok = 取到了 feed(404 / 断网时 request 失败、原文为空);ne = 条目数(没有任何 tag 的仓库是 0);cn = 仓库正名;bits = 前 10 条各自是 预发布(p)/ 主线正式版(s)/ 其它正式版(t,monorepo 子包)。同一节点里的值互不可见,故都只引前面落地过的键。"
    },
    {
      "op": "set",
      "props": {
        "key": "fs0",
        "value": "$[length::(index::(split::(${Q0.bits},s),0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ft0",
        "value": "$[length::(index::(split::(${Q0.bits},t),0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0",
        "value": "$[if::(lt::(${fs0},${Q0.ne}),calc::(${fs0}+1),if::(lt::(${ft0},${Q0.ne}),calc::(${ft0}+1),1))]"
      },
      "_note": "选中的段号:主线正式版 → 其它正式版 → 第一条(标预发布)。"
    },
    {
      "op": "set",
      "props": {
        "key": "sg0",
        "value": "$[index::(${g0},${k0})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "F0",
        "value": {
          "tag": "$[index::(split::(index::(split::(${sg0},${reId}),1),</id>),0)]",
          "href": "$[index::(split::(index::(split::(${sg0},href=\\\"),1),\\\"),0)]",
          "iso": "$[index::(split::(index::(split::(${sg0},<updated>),1),</updated>),0)]",
          "pre": "$[if::(lt::(${fs0},${Q0.ne}),0,if::(lt::(${ft0},${Q0.ne}),0,1))]"
        }
      },
      "_note": "tag 取 `<id>` 里的原始名(`<title>` 是 Release 标题);href = 条目链接(已 URL 编码,monorepo 的 @ / 斜杠都在里面);iso = `<updated>`,UTC。**`<content>`(提交 / 发布说明)从不读取**(§3.13)。"
    },
    {
      "op": "set",
      "props": {
        "key": "iso0",
        "value": "${F0.iso}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "m0",
        "value": "$[if::(gt::(length::(${iso0}),0),calc::(parseDate::(subString::(${iso0},0,10),yyyy-MM-dd)+${tzO}+subString::(${iso0},11,13)*3600000+subString::(${iso0},14,16)*60000+subString::(${iso0},17,19)*1000),0)]"
      },
      "_note": "UTC 时刻:该日期的本机零点(parseDate)+ 时区偏移 = UTC 零点,再加时分秒。日期部分只用 `yyyy-MM-dd`(跨端安全子集,G4c)。"
    },
    {
      "op": "remove",
      "props": {
        "key": "x0"
      }
    },
    {
      "op": "remove",
      "props": {
        "key": "g0"
      }
    },
    {
      "op": "remove",
      "props": {
        "key": "sg0"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "mm0",
        "value": "$[if::(eq::(${h0},1),${m0},-1)]"
      },
      "_note": "排序键的原料:没关注的槽 = −1(垫底)。先落地成键再进 calc(经 if:: 出来的数直接喂 calc 会算偏)。"
    },
    {
      "op": "set",
      "props": {
        "key": "v0",
        "value": "$[calc::(${mm0}*16+15)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "st0",
        "value": "$[if::(eq::(${Q0.ok},1),if::(gt::(length::(${F0.tag}),0),o,n),f)]"
      },
      "_note": "行状态:o = 有版本 / n = 仓库在但一个 tag 都没有 / f = 取不到(404 或网络)。"
    },
    {
      "op": "set",
      "props": {
        "key": "cx0",
        "value": "$[findNotEmpty::(${Q0.cn},${o0}/${r0})]"
      },
      "_note": "显示名:优先 feed 给的正名(改名仓库跟着变),取不到时用关注列表里存的名字。"
    },
    {
      "op": "set",
      "props": {
        "key": "am0",
        "value": "$[max::(floor::(calc::((${tzNow}-${m0})/60000)),1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "a0",
        "value": "$[round::(if::(lt::(${am0},60),${am0},if::(lt::(${am0},1440),floor::(calc::(${am0}/60)),if::(lt::(${am0},86400),floor::(calc::(${am0}/1440)),if::(lt::(${am0},1051200),floor::(calc::(${am0}/43200)),floor::(calc::(${am0}/525600)))))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "u0",
        "value": "$[if::(lt::(${am0},60),1,if::(lt::(${am0},1440),2,if::(lt::(${am0},86400),3,if::(lt::(${am0},1051200),4,5))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rp0",
        "value": "^${rl0}[-@]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tv0",
        "value": "$[index::(split::(replaceAll::(${F0.tag},${rp0},),/),round::(calc::(length::(split::(${F0.tag},/))-1)))]"
      },
      "_note": "显示用版本号:去掉「仓库名@ / 仓库名-」前缀(行首已经是项目名,`astro astro@7.3.5` 说两遍),monorepo 子包取最后一段(`@astrojs/netlify@8.2.8` → `netlify@8.2.8`)。提醒与链接仍用完整 tag。"
    },
    {
      "op": "set",
      "props": {
        "key": "x0",
        "value": "$[if::(eq::(${st0},o),round::(calc::(150.0*(1-min::(calc::(${am0}/1440),30)/30))),-99)]"
      },
      "_note": "42 时间轴上的横坐标(轨内局部 pt):今天在右端,30 天前在左端,更早钉在左端;没有版本 = 画到框外。"
    },
    {
      "op": "set",
      "props": {
        "key": "wn0",
        "value": "$[if::(eq::(${h0},1),if::(eq::(${st0},o),if::(lt::(${am0},10080),1,0),0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "R0",
        "value": {
          "nm": "$[index::(split::(${cx0},/),1)]",
          "ow": "$[index::(split::(${cx0},/),0)]",
          "tg": "${F0.tag}",
          "tv": "${tv0}",
          "x": "${x0}",
          "pr": "$[if::(eq::(${F0.pre},1),y,n)]",
          "st": "${st0}",
          "w": "$[if::(eq::(${st0},o),if::(lt::(${am0},2880),y,n),n)]",
          "a": "${a0}",
          "u": "${u0}"
        }
      },
      "_note": "这一槽的渲染行(字段见 ROW_FIELDS)。w = 48 小时内发布 → 行首源色点。"
    },
    {
      "op": "set",
      "props": {
        "key": "j0",
        "value": "-"
      },
      "_note": "提醒判定段的入参(按**关注顺序**,不按发布时间):没关注 = `-`。"
    },
    {
      "op": "if",
      "props": {
        "val": "${h0}"
      },
      "items": [
        {
          "op": "set",
          "props": {
            "key": "mS0",
            "value": "$[parseNumber::(${m0},0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "j0",
            "value": "${cx0}~${F0.tag}~${mS0}~${Q0.ok}"
          },
          "_note": "「正名~tag~毫秒~取到了没有」。用模板串内插不用 connect::(tag 可能含逗号;内插不经参数切分)。毫秒过 parseNumber(…,0):Android 上 calc 的大数会渲成 1.79E12。`~` 是 git 禁用于 ref 名的字符,不会撞 tag。"
        }
      ]
    },
    {
      "op": "set",
      "props": {
        "key": "o1",
        "value": "${lst[1].o}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "r1",
        "value": "${lst[1].r}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "h1",
        "value": "$[if::(gt::(length::(${r1}),0),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rl1",
        "value": "$[toLowerCase::(${r1})]"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "${h1}"
