{
  "version": 2,
  "title": "关注列表",
  "sub": "全部关注的项目 · 按发布时间排序",
  "i18n": {
    "en-US": {
      "title": "Watchlist",
      "sub": "All repos you follow, newest release first"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "用户关注的全部 GitHub 开源项目，各自最新版本号与发布了多久，按发布时间排序"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/board.rcn]",
    "depends": [
      {
        "_note": "三个组件共用一条取数流、同一份入参(空):关注列表由流自己从 data.rl_list 读。",
        "flow": "@[file://flow/board.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "每轮 = 关注数 N(≤8)个请求。发布一周几次,15 分钟一查足够;更密只是白耗(生成器头注「请求量」)。",
      "interval": [
        "900"
      ]
    }
  },
  "_note_jobs": "长按 →「添加提醒」:关注的项目发布新版本时提醒。",
  "jobs": [
    {
      "id": "new"
    }
  ]
}
