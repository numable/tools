{
  "version": 2,
  "title": "最近发布",
  "sub": "关注的项目里最近发版的那一个",
  "i18n": {
    "en-US": {
      "title": "Latest release",
      "sub": "The most recent release among repos you follow"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "用户关注的 GitHub 项目里最近发版的那一个：项目名、版本号、是否预发布、发布了多久"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/latest.rcn]",
    "depends": [
      {
        "_note": "三个组件共用一条取数流、同一份入参(空):关注列表由流自己从 data.rl_list 读。",
        "flow": "@[file://flow/board.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "每轮 = 关注数 N(≤8)个请求。发布一周几次,15 分钟一查足够;更密只是白耗(生成器头注「请求量」)。",
      "interval": [
        "900"
      ]
    }
  },
  "_note_jobs": "长按 →「添加提醒」:关注的项目发布新版本时提醒。",
  "jobs": [
    {
      "id": "new"
    }
  ]
}
