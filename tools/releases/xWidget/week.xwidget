{
  "version": 2,
  "title": "本周新版本",
  "sub": "微 · 7 天内发了新版的项目数",
  "i18n": {
    "en-US": {
      "title": "New this week",
      "sub": "Micro · repos with a release in the last 7 days"
    }
  },
  "layout": 11,
  "params": {},
  "ai": {
    "shows": "用户关注的 GitHub 项目里 7 天内发了新版本的有几个（一个数）"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/week.rcn]",
    "depends": [
      {
        "_note": "三个组件共用一条取数流、同一份入参(空):关注列表由流自己从 data.rl_list 读。",
        "flow": "@[file://flow/board.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "每轮 = 关注数 N(≤8)个请求。发布一周几次,15 分钟一查足够;更密只是白耗(生成器头注「请求量」)。",
      "interval": [
        "900"
      ]
    }
  },
  "_note_jobs": "长按 →「添加提醒」:关注的项目发布新版本时提醒。",
  "jobs": [
    {
      "id": "new"
    }
  ]
}
