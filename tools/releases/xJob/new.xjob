{
  "_note_gen": "tools/infosource/gen_releases.py",
  "_note": "**动态提醒(按 tag 去重、首跑只建基线、不补报)**。无参数:一条提醒管住全部关注的仓库。取数段复用组件的 board.df(同一份入参,同一次机会里与组件共享那一轮取数);判定段 xJob/flow/new.df。取不到 = 不知道 = 不响、不动基线(board.df 在一个都取不到时抛错,平台据此判未知)。message 标题是静态句(同意面板的预览只拿 params 代入,标题里放变量会预览成半句话),正文 detail = 命中的「仓库 版本」,中英同形(名字与版本号不翻译)。",
  "version": 1,
  "id": "new",
  "title": "新版本提醒",
  "sub": "关注的项目发布新版本时提醒你",
  "i18n": {
    "en-US": {
      "title": "New release alert",
      "sub": "Get notified when a repo you follow ships a new version",
      "message": {
        "title": "A repo you follow has a new release",
        "body": "${detail}"
      }
    }
  },
  "task": {
    "depends": [
      {
        "flow": "@[file://xWidget/flow/board.df]",
        "params": {}
      }
    ],
    "then": {
      "flow": "@[file://xJob/flow/new.df]",
      "params": {
        "j0": "${j0}",
        "j1": "${j1}",
        "j2": "${j2}",
        "j3": "${j3}",
        "j4": "${j4}",
        "j5": "${j5}",
        "j6": "${j6}",
        "j7": "${j7}"
      }
    },
    "refresh": {
      "_note": "15 分钟检查一次(免费档由平台钳到 30 分钟;只在打开应用或桌面放着小组件时才有检查机会)。",
      "interval": [
        "900"
      ]
    }
  },
  "alert": {
    "level": "normal",
    "message": {
      "title": "关注的项目发布了新版本",
      "body": "${detail}"
    }
  }
}
