{
  "version": 2,
  "title": "热门前两条",
  "sub": "2 条 · 带热度条",
  "i18n": {
    "en-US": {
      "title": "Top two",
      "sub": "2 stories with score bars"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "Lobsters 热门前 2 条（英文原标题），带标签、得分、发布多久与得分热度条"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/top3.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。各组件各绑各的 flow(槽数不同,空槽键会被当成取数失败)。",
        "flow": "@[file://flow/top3.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
