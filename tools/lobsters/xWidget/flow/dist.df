          "$[findNotEmpty::(${resp[23].tags[1]},)]",
          "$[findNotEmpty::(${resp[24].tags[1]},)]"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "dCt",
        "value": [
          "$[if::(eq::(findNotEmpty::(index::(${dCk},0),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},0),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},1),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},1),~)))-1))]",
          "$[if::(eq::(findNotEmpty::(index::(${dCk},2),__none__),__none__),-1,calc::(length::(split::(${dBl},connect::(~,index::(${dCk},2),~)))-1))]",
