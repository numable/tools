{
  "_note": "生成器 tools/infosource/gen_headlines.py(lobsters 聚合)。只取标签 / 节点与数字,不进标题与正文。",
  "version": 1,
  "actions": [
    {
      "op": "set",
      "props": {
        "key": "tzNow",
        "value": "${@time.nowMs}"
      }
    },
    {
      "action": "request",
      "id": "resp",
      "params": {
        "url": "https://lobste.rs/hottest.json",
        "method": "GET",
        "formatType": "json"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_b",
        "value": "1"
      },
      "_note": "⚠️ 请求/并发屏障(勿删):request 与 concurrent 之后**紧邻**的节点读不到响应(晚一拍合并,memory [[actionflow-concurrent-late-merge]])。删掉它 → 下面所有 index:: 静默取空 → 卡渲一片 `--`,而流仍报 success。"
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${resp[0].title}),0),0,1)]"
      },
      "items": [
        {
          "action": "error",
          "params": {
            "errorMsg": "lobsters_unreachable"
          }
        }
      ],
      "_note": "取数失败 → 抛错终止流,平台据此回落上次成功数据(G26/§7.2)"
    },
    {
      "op": "set",
      "props": {
        "key": "at",
        "value": "$[formatDate::(${tzNow},HH:mm)]"
      },
      "_note": "榜单没有「数据时间」字段,用取数时刻兜底(标准 §4.4)。"
    },
    {
      "op": "set",
      "props": {
        "key": "dRx",
        "value": "[^a-z0-9~@]"
      },
      "_note": "键里的正则特殊字符(`.` `+` …)统一换成 `_`,blob 与候选两边同换。"
    },
    {
      "op": "set",
      "props": {
        "key": "dSg",
        "value": [
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[0].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[1].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[2].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[3].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[4].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[5].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[6].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[7].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[8].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[9].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[10].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[11].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[12].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[13].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[14].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[15].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[16].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[17].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[18].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[19].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[20].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[21].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[22].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[23].tags},~~),~)),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(connect::(~,join::(${resp[24].tags},~~),~)),${dRx},_)]"
        ]
      },
      "_note": "每条的标签段「~rust~~programming~」(一条可以有多个标签)。候选 = 每条的前两个标签。"
    },
    {
      "op": "set",
      "props": {
        "key": "dBl",
        "value": "$[connect::(@,join::(${dSg},),@)]"
      },
      "_note": "全部段拼成一串;两端 `@` 哨兵不能省(split 丢首尾空段)。"
    },
    {
      "op": "set",
      "props": {
        "key": "dCk",
        "value": [
          "$[replaceAll::(toLowerCase::(${resp[0].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[1].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[2].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[3].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[4].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[5].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[6].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[7].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[8].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[9].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[10].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[11].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[12].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[13].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[14].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[15].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[16].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[17].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[18].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[19].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[20].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[21].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[22].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[23].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[24].tags[0]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[0].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[1].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[2].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[3].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[4].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[5].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[6].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[7].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[8].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[9].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[10].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[11].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[12].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[13].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[14].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[15].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[16].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[17].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[18].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[19].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[20].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[21].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[22].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[23].tags[1]}),${dRx},_)]",
          "$[replaceAll::(toLowerCase::(${resp[24].tags[1]}),${dRx},_)]"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "dLb",
        "value": [
          "$[findNotEmpty::(${resp[0].tags[0]},)]",
          "$[findNotEmpty::(${resp[1].tags[0]},)]",
          "$[findNotEmpty::(${resp[2].tags[0]},)]",
          "$[findNotEmpty::(${resp[3].tags[0]},)]",
