{
  "version": 2,
  "title": "此刻榜首",
  "sub": "迷你 · 热门榜首的标题",
  "i18n": {
    "en-US": {
      "title": "Top now",
      "sub": "Mini · the top story's headline"
    }
  },
  "layout": 21,
  "params": {},
  "ai": {
    "shows": "Lobsters 热门榜首那条的英文标题（一行迷你）"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/top1mini.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。本组件与「top1」同问同源,复用 top1.df(零新增请求)。",
        "flow": "@[file://flow/top1.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
