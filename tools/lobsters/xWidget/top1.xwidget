{
  "version": 2,
  "title": "此刻榜首",
  "sub": "1 条 · 热门榜首",
  "i18n": {
    "en-US": {
      "title": "Top now",
      "sub": "The top story right now"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "Lobsters 热门榜首一条（英文原标题），带得分、评论数、标签、发布多久与每小时得分"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/top1.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。各组件各绑各的 flow(槽数不同,空槽键会被当成取数失败)。",
        "flow": "@[file://flow/top1.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
