{
  "version": 2,
  "title": "热门",
  "sub": "5 条 · 每条带热度条",
  "i18n": {
    "en-US": {
      "title": "Hottest",
      "sub": "5 stories, each with a score bar"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "Lobsters 热门前 5 条（英文原标题），每条带标签、得分、发布多久与得分热度条"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/list.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。各组件各绑各的 flow(槽数不同,空槽键会被当成取数失败)。",
        "flow": "@[file://flow/list.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
