{
  "version": 2,
  "title": "热门标签",
  "sub": "热门榜里最多的 5 个标签",
  "i18n": {
    "en-US": {
      "title": "Hot tags",
      "sub": "The 5 most common tags on the hot list"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "Lobsters 热门榜 25 条里出现最多的 5 个标签，带条数与条形图（今天这里在聊什么）"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/dist.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸字符串绑定传空入参。各组件各绑各的 flow(槽数不同,空槽键会被当成取数失败)。",
        "flow": "@[file://flow/dist.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
