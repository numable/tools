{
  "version": 1,
  "_note": "PyPI 发布记录:p = `rss/project/<包>/releases.xml`(约 10KB,带发布时间);也用来判断包名是否存在(不存在时 404)。\n通用「原样取回」流:入参 p = host 之后的路径(含查询串),响应原文交给 H5 页用 JS 解析。host 写死在 URL 字面量里(G3 能静态认出),页面拿它打不到别的域(同 crypto/okx.df)。",
  "_lintCache": "exempt",
  "_noteCache": "首屏缓存在 H5 页里做(G23 三态:页面把解析后的精简模型写进 data.c.ps.*,带结构版本与时间戳,先渲旧数据再后台校新)。本流只负责原样取回,搜索类调用更不该缓存。",
  "actions": [
    {
      "op": "set",
      "props": {
        "key": "pIn",
        "value": "${p}"
      },
      "_note": "⚠️ 入参落地(勿删):URL 与方法参数里的 ${} 看不见 flow 入参。"
    },
    {
      "id": "r",
      "action": "request",
      "params": {
        "url": "https://pypi.org/${pIn}",
        "method": "GET",
        "formatType": "string",
        "header": {
          "User-Agent": "Numable-pkgstats/1 (+https://numable.app)",
          "Accept": "application/rss+xml"
        },
        "timeout": "12000"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_b",
        "value": "1"
      },
      "_note": "请求屏障(勿删):request 之后紧邻的节点读不到响应。"
    },
    {
      "op": "set",
      "props": {
        "key": "raw",
        "value": "$[findNotEmpty::(${r},)]"
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "raw"
        ]
      }
    }
  ]
}
