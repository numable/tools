{
  "version": 2,
  "title": "关注列表",
  "sub": "关注的开源包 · 近 7 天下载与较上周",
  "i18n": {
    "en-US": {
      "title": "Watchlist",
      "sub": "Your packages · 7-day downloads and change"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "用户关注的开源包列表，每个开源包近 7 天下载量与较上周涨跌"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/board.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/board.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "三个源都是日更(npm / pypistats / crates.io 的逐日统计按天出),一小时一刷只为「新的一天出数了能跟上」,更密是白打接口。",
      "interval": [
        "3600"
      ]
    }
  },
  "_note": "无参数组件:关注列表由包自己从 data.ps_list 读,用户在包里增删、调顺序,组件自动跟上。"
}
