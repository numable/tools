            "type": "txt",
            "x": "14.0pt",
            "y": "122pt",
            "w": "-1",
            "h": "-1",
            "alignmentH": "1",
            "maxLines": "1",
            "text": "$[if::(eq::(findNotEmpty::(${kind},s),d),${@i18n.pushedS},if::(eq::(findNotEmpty::(${kind},s),b),${@i18n.latest},${@i18n.latest}))] ${verV}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
