        "react": [
          {
            "id": "spAxis",
            "type": "line",
            "points": "[0,77.0,144.0,77.0]",
            "lineWidth": "1pt",
            "strokeColor": "#1A0E1116|#1AF3F4F6",
            "x": "180pt",
            "y": "34pt",
            "w": "144.0pt",
            "h": "78.0pt"
          },
          {
            "id": "sp",
            "type": "line",
            "points": "[$[findNotEmpty::(${p42},0\\,999\\,1\\,999)]]",
            "lineWidth": "1.8pt",
            "lineCap": "round",
            "lineJoin": "round",
            "strokeColor": "#B4329B|#EE7FD6",
            "coverageColor": "linear(#4AB4329B\\,#00B4329B)@90|linear(#4AEE7FD6\\,#00EE7FD6)@90",
            "x": "180pt",
            "y": "34pt",
            "w": "144.0pt",
            "h": "78.0pt",
            "_note": "折线本体 + coverageColor 渐变面积。coverageColor 与 bgColor 走同一个 paint 构建器,所以面积可以是渐变、不必是平涂;它也能脱离可见描边单独存在(水印卡就是这么用的)。"
          },
          {
            "id": "spHalo",
            "type": "line",
            "points": "[137.99,$[findNotEmpty::(${y42},-99)],138.0,$[findNotEmpty::(${y42},-99)]]",
