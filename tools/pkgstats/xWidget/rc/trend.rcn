            "text": "${@i18n.y1L} $[if::(startsWith::(${@app.language},zh),findNotEmpty::(${y1Z},--),findNotEmpty::(${y1E},--))]",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${hasV},1),1,0)]"
