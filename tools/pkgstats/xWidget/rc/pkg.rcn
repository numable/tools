{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FDFBFD\\,#FAF2F9)@90|linear(#15171A\\,#1A191E\\,#221D26)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12.0pt",
        "y": "{nm.y}+({nm.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#B4329B|#EE7FD6",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "_note": "源色身份点(组件设计系统 §2):每个组件恰好一次,y 锚在组件名的实测框上。"
      },
      {
        "id": "nm",
        "type": "txt",
        "x": "21.0pt",
        "y": "11pt",
        "w": "88pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${p},${@i18n.noPkg})]",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "12.0pt",
        "y": "14pt",
        "w": "{parent.w}-24.0pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${endM},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "_note": "数据时间锚 = 数据截至日(MM-DD),不是取数时刻 —— 三个源都滞后 1~4 天,写取数时刻是在骗人。"
      },
      {
        "id": "lab",
        "type": "txt",
        "x": "12.0pt",
        "y": "31pt",
        "w": "134pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${ecoL},--)] · ${@i18n.wk7}",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "num",
        "type": "txt",
        "x": "12.0pt",
        "y": "46pt",
        "w": "134pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(startsWith::(${@app.language},zh),findNotEmpty::(${wkZ},--),findNotEmpty::(${wkE},--))]",
        "fontSize": "34pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "hide": "$[if::(eq::(if::(startsWith::(${@app.language},zh),findNotEmpty::(${wkZ},--),findNotEmpty::(${wkE},--)),--),1,0)]"
      },
      {
        "id": "numE",
        "type": "txt",
        "x": "12.0pt",
        "y": "57.25pt",
        "w": "134pt",
        "h": "-1",
        "maxLines": "1",
        "text": "--",
        "fontSize": "34pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "hide": "$[if::(eq::(if::(startsWith::(${@app.language},zh),findNotEmpty::(${wkZ},--),findNotEmpty::(${wkE},--)),--),0,2)]"
      },
      {
        "id": "tri",
        "type": "path",
        "x": "12.0pt",
        "y": "94pt",
        "w": "8pt",
        "h": "5.3pt",
        "d": "$[if::(eq::(${up},1),M128 64 L240 192 L16 192 Z,M128 192 L16 64 L240 64 Z)]",
        "viewBox": "0 0 256 256",
        "fillColor": "$[if::(eq::(${flat},1),#9AA0A6|#8E939B,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6|#8E939B,if::(eq::(${up},1),if::(eq::(${up},1),#B4329B|#EE7FD6,#B45309|#F5A524),if::(eq::(${up},0),if::(eq::(${up},1),#B4329B|#EE7FD6,#B45309|#F5A524),#9AA0A6|#8E939B))))]",
        "hide": "$[if::(eq::(if::(eq::(${flat},1),0,if::(eq::(findNotEmpty::(${up},__none__),__none__),0,if::(eq::(${up},1),1,if::(eq::(${up},0),1,0)))),1),0,1)]"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${flat},1),0,if::(eq::(findNotEmpty::(${up},__none__),__none__),0,if::(eq::(${up},1),1,if::(eq::(${up},0),1,0))))]"
        },
        "react": [
          {
            "id": "chg",
            "type": "txt",
            "x": "24.0pt",
            "y": "90pt",
            "w": "122.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${chgT} ${@i18n.vsWk}",
            "fontSize": "11pt",
            "typeface": "System-Bold",
            "textColor": "$[if::(eq::(${flat},1),#9AA0A6|#8E939B,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6|#8E939B,if::(eq::(${up},1),if::(eq::(${up},1),#B4329B|#EE7FD6,#B45309|#F5A524),if::(eq::(${up},0),if::(eq::(${up},1),#B4329B|#EE7FD6,#B45309|#F5A524),#9AA0A6|#8E939B))))]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${flat},1),1,0)]"
        },
        "react": [
          {
            "id": "chgF",
            "type": "txt",
            "x": "12.0pt",
            "y": "90pt",
            "w": "134pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.flatMsg}",
            "fontSize": "11pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${flat},1),0,if::(eq::(if::(eq::(${flat},1),0,if::(eq::(findNotEmpty::(${up},__none__),__none__),0,if::(eq::(${up},1),1,if::(eq::(${up},0),1,0)))),1),0,1))]"
        },
        "react": [
          {
            "id": "chgN",
            "type": "txt",
            "x": "12.0pt",
            "y": "90pt",
            "w": "134pt",
            "h": "-1",
            "maxLines": "1",
            "text": "-- ${@i18n.vsWk}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "id": "spAxis",
        "type": "line",
        "points": "[0,29.0,134.0,29.0]",
        "lineWidth": "1pt",
        "strokeColor": "#1A0E1116|#1AF3F4F6",
        "x": "12.0pt",
        "y": "114pt",
        "w": "134.0pt",
        "h": "30.0pt"
      },
      {
        "id": "sp",
        "type": "line",
        "points": "[$[findNotEmpty::(${p22},0\\,999\\,1\\,999)]]",
        "lineWidth": "1.8pt",
        "lineCap": "round",
        "lineJoin": "round",
        "strokeColor": "#B4329B|#EE7FD6",
        "coverageColor": "linear(#4AB4329B\\,#00B4329B)@90|linear(#4AEE7FD6\\,#00EE7FD6)@90",
        "x": "12.0pt",
        "y": "114pt",
        "w": "134.0pt",
        "h": "30.0pt",
        "_note": "折线本体 + coverageColor 渐变面积。coverageColor 与 bgColor 走同一个 paint 构建器,所以面积可以是渐变、不必是平涂;它也能脱离可见描边单独存在(水印卡就是这么用的)。"
      },
      {
        "id": "spHalo",
        "type": "line",
        "points": "[129.99,$[findNotEmpty::(${y22},-99)],130.0,$[findNotEmpty::(${y22},-99)]]",
        "lineWidth": "8.0pt",
        "lineCap": "round",
        "strokeColor": "#2EB4329B|#2EEE7FD6",
        "x": "12.0pt",
        "y": "114pt",
        "w": "134.0pt",
        "h": "30.0pt"
      },
      {
        "id": "spRing",
        "type": "line",
        "points": "[129.99,$[findNotEmpty::(${y22},-99)],130.0,$[findNotEmpty::(${y22},-99)]]",
        "lineWidth": "5.3pt",
        "lineCap": "round",
        "strokeColor": "#FFFFFF|#15171A",
        "x": "12.0pt",
        "y": "114pt",
        "w": "134.0pt",
        "h": "30.0pt"
      },
      {
        "id": "spDot",
        "type": "line",
        "points": "[129.99,$[findNotEmpty::(${y22},-99)],130.0,$[findNotEmpty::(${y22},-99)]]",
        "lineWidth": "3.6pt",
        "lineCap": "round",
        "strokeColor": "#B4329B|#EE7FD6",
        "x": "12.0pt",
        "y": "114pt",
        "w": "134.0pt",
        "h": "30.0pt"
      }
    ],
    "i18n": {
      "zh-CN": {
        "wk7": "近 7 天下载",
        "vsWk": "较上周",
        "flatMsg": "与上周持平",
        "noPkg": "还没选包"
      },
      "en-US": {
        "wk7": "7-day downloads",
        "vsWk": "vs prev week",
        "flatMsg": "Flat vs prev week",
        "noPkg": "No package"
      }
    }
  }
}
