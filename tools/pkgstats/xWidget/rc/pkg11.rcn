{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FDFBFD\\,#FAF2F9)@90|linear(#15171A\\,#1A191E\\,#221D26)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8pt",
        "y": "{nm.y}+({nm.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#B4329B|#EE7FD6",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "nm",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${p},${@i18n.noPkg11})]",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "_note": "没选包时名字位写状态(「还没选包」),不写 `--`(card-design-system §1 / §5)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,if::(startsWith::(${@app.language},zh),if::(eq::(findNotEmpty::(${w11Z},--),--),0,1),0))]"
        },
        "react": [
          {
            "id": "num",
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${w11Z}",
            "fontSize": "${vfZ}pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,if::(if::(startsWith::(${@app.language},zh),0,1),if::(eq::(findNotEmpty::(${wkE},--),--),0,1),0))]"
        },
        "react": [
          {
            "id": "num",
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${wkE}",
            "fontSize": "${vfE}pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,if::(eq::(if::(startsWith::(${@app.language},zh),findNotEmpty::(${w11Z},--),findNotEmpty::(${wkE},--)),--),1,0))]"
        },
        "react": [
          {
            "id": "numE",
            "type": "txt",
            "x": "8pt",
            "y": "28pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "--",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ],
        "_note": "取不到数:字面量 20pt 的「--」(数据驱动字号在空数据下是裸 pt,会让整张组件渲不出来)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,if::(eq::(${flat},1),0,if::(eq::(findNotEmpty::(${up},__none__),__none__),0,if::(eq::(${up},1),1,if::(eq::(${up},0),1,0)))))]"
        },
        "react": [
          {
            "id": "chg",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${chgT}",
            "fontSize": "9pt",
            "typeface": "System-Bold",
            "textColor": "$[if::(eq::(${flat},1),#9AA0A6|#8E939B,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6|#8E939B,if::(eq::(${up},1),if::(eq::(${up},1),#B4329B|#EE7FD6,#B45309|#F5A524),if::(eq::(${up},0),if::(eq::(${up},1),#B4329B|#EE7FD6,#B45309|#F5A524),#9AA0A6|#8E939B))))]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,if::(eq::(${flat},1),1,0))]"
        },
        "react": [
          {
            "id": "chgF",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${@i18n.flatS}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,if::(eq::(findNotEmpty::(${kind},s),s),if::(eq::(${flat},1),0,if::(eq::(if::(eq::(${flat},1),0,if::(eq::(findNotEmpty::(${up},__none__),__none__),0,if::(eq::(${up},1),1,if::(eq::(${up},0),1,0)))),1),0,1)),0))]"
        },
        "react": [
          {
            "id": "chgN",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "--",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,if::(eq::(findNotEmpty::(${kind},s),s),0,1))]"
        },
        "react": [
          {
            "id": "alt",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[if::(eq::(findNotEmpty::(${kind},s),d),${@i18n.a11D},if::(eq::(findNotEmpty::(${kind},s),b),${@i18n.a11B},--))]",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ],
        "_note": "Docker / Homebrew 没有较上周:底行写主值是什么(累计拉取 / 近 30 天)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),1,0)]"
        },
        "react": [
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(startsWith::(${@app.language},zh),1,0)]"
            },
            "react": [
              {
                "id": "offT",
                "type": "txt",
                "x": "8pt",
                "y": "24pt",
                "w": "54pt",
                "h": "-1",
                "maxLines": "2",
                "text": "${@i18n.offS}",
                "fontSize": "11pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(startsWith::(${@app.language},zh),0,1)]"
            },
            "react": [
              {
                "id": "offE",
                "type": "txt",
                "x": "8pt",
                "y": "24pt",
                "w": "54pt",
                "h": "-1",
                "maxLines": "3",
                "text": "${@i18n.offS}",
                "fontSize": "10pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ],
        "_note": "大陆(@app.region = cn)不提供 Docker Hub:流不取数、kind=o。整卡只留包名与这句状态,用户的关注 / 组件参数不动。"
      }
    ],
    "i18n": {
      "zh-CN": {
        "flatS": "持平",
        "noPkg11": "还没选包",
        "a11D": "累计拉取",
        "a11B": "近 30 天",
        "offS": "当前地区不提供"
      },
      "en-US": {
        "flatS": "Flat",
        "noPkg11": "None",
        "a11D": "pulls",
        "a11B": "30 days",
        "offS": "Not in your region"
      }
    }
  }
}
