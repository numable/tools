{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FDFBFD\\,#FAF2F9)@90|linear(#15171A\\,#1A191E\\,#221D26)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{nm.y}+({nm.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#B4329B|#EE7FD6",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "nm",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "90pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${p},${@i18n.noPkg})]",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "_note": "没选包时名字位写状态(「还没选包」),不写 `--`(card-design-system §1 / §5)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,1)]"
        },
        "react": [
          {
            "id": "at",
            "type": "txt",
            "x": "113pt",
            "y": "10.5pt",
            "w": "35pt",
            "h": "-1",
            "alignmentH": "2",
            "maxLines": "1",
            "text": "$[findNotEmpty::(${endM},--)]",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,1)]"
        },
        "react": [
          {
            "id": "num",
            "type": "richText",
            "x": "10pt",
            "y": "27pt",
            "w": "84pt",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "$[if::(startsWith::(${@app.language},zh),findNotEmpty::(${wkZ},--),findNotEmpty::(${wkE},--))]",
                "fontSize": "16.5pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "20pt"
              },
              {
                "text": "$[if::(eq::(findNotEmpty::(${kind},s),d),${@i18n.perPull},if::(eq::(findNotEmpty::(${kind},s),b),${@i18n.per30},${@i18n.perWk}))]",
                "fontSize": "9pt",
                "textColor": "#6B7280|#8E939B"
              }
            ],
            "hide": "$[if::(eq::(if::(startsWith::(${@app.language},zh),findNotEmpty::(${wkZ},--),findNotEmpty::(${wkE},--)),--),1,0)]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,1)]"
        },
        "react": [
          {
            "id": "numE",
            "type": "richText",
            "x": "10pt",
            "y": "32.5pt",
            "w": "84pt",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "$[if::(startsWith::(${@app.language},zh),findNotEmpty::(${wkZ},--),findNotEmpty::(${wkE},--))]",
                "fontSize": "16.5pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "20pt"
              },
              {
                "text": "$[if::(eq::(findNotEmpty::(${kind},s),d),${@i18n.perPull},if::(eq::(findNotEmpty::(${kind},s),b),${@i18n.per30},${@i18n.perWk}))]",
                "fontSize": "9pt",
                "textColor": "#6B7280|#8E939B"
              }
            ],
            "hide": "$[if::(eq::(if::(startsWith::(${@app.language},zh),findNotEmpty::(${wkZ},--),findNotEmpty::(${wkE},--)),--),0,2)]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,if::(eq::(findNotEmpty::(${kind},s),s),1,0))]"
        },
        "react": [
          {
            "id": "spAxis",
            "type": "line",
            "points": "[0,23.0,58.0,23.0]",
            "lineWidth": "1pt",
            "strokeColor": "#1A0E1116|#1AF3F4F6",
            "x": "90pt",
            "y": "22pt",
            "w": "58.0pt",
            "h": "24.0pt"
          },
          {
            "id": "sp",
            "type": "line",
            "points": "[$[findNotEmpty::(${p21},0\\,999\\,1\\,999)]]",
            "lineWidth": "1.8pt",
            "lineCap": "round",
            "lineJoin": "round",
            "strokeColor": "#B4329B|#EE7FD6",
            "coverageColor": "linear(#4AB4329B\\,#00B4329B)@90|linear(#4AEE7FD6\\,#00EE7FD6)@90",
            "x": "90pt",
            "y": "22pt",
            "w": "58.0pt",
            "h": "24.0pt",
            "_note": "折线本体 + coverageColor 渐变面积。coverageColor 与 bgColor 走同一个 paint 构建器,所以面积可以是渐变、不必是平涂;它也能脱离可见描边单独存在(水印卡就是这么用的)。"
          },
          {
            "id": "spHalo",
            "type": "line",
            "points": "[53.99,$[findNotEmpty::(${y21},-99)],54.0,$[findNotEmpty::(${y21},-99)]]",
            "lineWidth": "8.0pt",
            "lineCap": "round",
            "strokeColor": "#2EB4329B|#2EEE7FD6",
            "x": "90pt",
            "y": "22pt",
            "w": "58.0pt",
            "h": "24.0pt"
          },
          {
            "id": "spRing",
            "type": "line",
            "points": "[53.99,$[findNotEmpty::(${y21},-99)],54.0,$[findNotEmpty::(${y21},-99)]]",
            "lineWidth": "5.3pt",
            "lineCap": "round",
            "strokeColor": "#FFFFFF|#15171A",
            "x": "90pt",
            "y": "22pt",
            "w": "58.0pt",
            "h": "24.0pt"
          },
          {
            "id": "spDot",
            "type": "line",
            "points": "[53.99,$[findNotEmpty::(${y21},-99)],54.0,$[findNotEmpty::(${y21},-99)]]",
            "lineWidth": "3.6pt",
            "lineCap": "round",
            "strokeColor": "#B4329B|#EE7FD6",
            "x": "90pt",
            "y": "22pt",
            "w": "58.0pt",
            "h": "24.0pt"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,if::(eq::(findNotEmpty::(${kind},s),d),1,0))]"
        },
        "react": [
          {
            "id": "mkD",
            "type": "txt",
            "x": "90pt",
            "y": "24pt",
            "w": "58pt",
            "h": "-1",
            "alignmentH": "2",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${@i18n.starL}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          },
          {
            "id": "mvD",
            "type": "txt",
            "x": "90pt",
            "y": "36pt",
            "w": "58pt",
            "h": "-1",
            "alignmentH": "2",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[if::(startsWith::(${@app.language},zh),findNotEmpty::(${stZ},--),findNotEmpty::(${stE},--))]",
            "fontSize": "11pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ],
        "_note": "没有逐日数据就不画走势线:右侧换成一个附加数(Docker 星标 / Homebrew 近 1 年安装)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),0,if::(eq::(findNotEmpty::(${kind},s),b),1,0))]"
        },
        "react": [
          {
            "id": "mkB",
            "type": "txt",
            "x": "90pt",
            "y": "24pt",
            "w": "58pt",
            "h": "-1",
            "alignmentH": "2",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${@i18n.y1L}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          },
          {
            "id": "mvB",
            "type": "txt",
            "x": "90pt",
            "y": "36pt",
            "w": "58pt",
            "h": "-1",
            "alignmentH": "2",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[if::(startsWith::(${@app.language},zh),findNotEmpty::(${y1Z},--),findNotEmpty::(${y1E},--))]",
            "fontSize": "11pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${kind},s),o),1,0)]"
        },
        "react": [
          {
            "id": "offT",
            "type": "txt",
            "x": "10pt",
            "y": "29pt",
            "w": "138pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${@i18n.offS}",
            "fontSize": "12pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          }
        ],
        "_note": "大陆(@app.region = cn)不提供 Docker Hub:流不取数、kind=o。整卡只留包名与这句状态,用户的关注 / 组件参数不动。"
      }
    ],
    "i18n": {
      "zh-CN": {
        "perWk": "/周",
        "noPkg": "还没选包",
        "starL": "星标",
        "y1L": "近 1 年",
        "perPull": "累计",
        "per30": "/30天",
        "offS": "当前地区不提供",
        "nbsp": " "
      },
      "en-US": {
        "perWk": "/wk",
        "noPkg": "No package",
        "starL": "Stars",
        "y1L": "1 year",
        "perPull": "pulls",
        "per30": "/30d",
        "offS": "Not in your region",
        "nbsp": " "
      }
    }
  }
}
