{
  "version": 2,
  "title": "周下载 · 一行",
  "sub": "迷你 · 近 7 天下载与 30 天走势",
  "i18n": {
    "en-US": {
      "title": "Weekly downloads · strip",
      "sub": "Mini · 7-day downloads and the 30-day shape"
    }
  },
  "layout": 21,
  "params": {
    "eco": "npm",
    "pkg": "react"
  },
  "ai": {
    "shows": "一个开源包近 7 天下载量与 30 天下载走势线（一行迷你）",
    "params": {
      "eco": {
        "kind": "enum",
        "values": {
          "npm": "npm(JavaScript / Node.js)",
          "pypi": "PyPI(Python)",
          "crates": "crates.io(Rust)"
        }
      },
      "pkg": {
        "kind": "value",
        "group": [
          "eco",
          "pkg"
        ],
        "format": "eco 所选生态里开源包的名字：npm 原样照写（全小写，scoped 包带 @scope/，如 @vue/cli）；PyPI / crates.io 不分大小写。不确定名字就用默认值",
        "examples": [
          "react",
          "@vue/cli",
          "requests",
          "serde"
        ]
      }
    }
  },
  "events": {
    "onClick": "/pkg?eco=${eco}&name=${pkg}",
    "onEdit": "/pick?eco=${eco}&pkg=${pkg}",
    "_note": "点组件进这个包的详情页(参数名与首页行跳转同一条路由);长按编辑进「选择包」页 /pick,写回走 xbridge.updateParams。"
  },
  "canvas": {
    "source": "@[file://rc/pkgmini.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/pkg.df]",
        "params": {
          "eco": "${eco}",
          "pkg": "${pkg}",
          "ver": "0"
        }
      }
    ],
    "refresh": {
      "_note": "三个源都是日更(npm / pypistats / crates.io 的逐日统计按天出),一小时一刷只为「新的一天出数了能跟上」,更密是白打接口。",
      "interval": [
        "3600"
      ]
    }
  }
}
