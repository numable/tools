    {
      "op": "set",
      "props": {
        "key": "w11Z",
        "value": "$[if::(eq::(findNotEmpty::(${wk},__none__),__none__),${wkZ},if::(ge::(${wk},10000000),connect::(if::(lt::(calc::(${wk}/100000000),1),parseNumber::(calc::(round::(calc::(calc::(${wk}/100000000)*100))/100),0.##),if::(lt::(calc::(${wk}/100000000),10),parseNumber::(calc::(round::(calc::(calc::(${wk}/100000000)*10))/10),0.#),parseNumber::(round::(calc::(${wk}/100000000)),0))),${uY}),if::(ge::(${wk},10000),connect::(if::(lt::(calc::(${wk}/10000),1),parseNumber::(calc::(round::(calc::(calc::(${wk}/10000)*100))/100),0.##),if::(lt::(calc::(${wk}/10000),10),parseNumber::(calc::(round::(calc::(calc::(${wk}/10000)*10))/10),0.#),parseNumber::(round::(calc::(${wk}/10000)),0))),${uW}),parseNumber::(round::(${wk}),0))))]"
      },
      "_note": "中文 11 微档主值:两位有效数字,≥ 1000 万记成「0.33亿」(比「3300万」窄)。先 round 再 parseNumber(网页引擎 parseNumber 是截断)。"
    },
    {
      "op": "set",
      "props": {
        "key": "reDg",
        "value": "[^0-9]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "reDt",
        "value": "[^.]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "reLt",
        "value": "[^A-Za-z]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "reAs",
        "value": "[ -~]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ewvfZ",
        "value": "$[calc::(length::(replaceAll::(${w11Z},${reDg},))*0.64+length::(replaceAll::(${w11Z},${reDt},))*0.3+length::(replaceAll::(${w11Z},${reAs},))*1.0+length::(replaceAll::(${w11Z},${reLt},))*0.85)]"
      },
      "_note": "估算墨迹宽(em)。"
    },
    {
      "op": "set",
      "props": {
        "key": "vfZ",
        "value": "$[if::(le::(calc::(${ewvfZ}*20),50),20,if::(le::(calc::(${ewvfZ}*17),51),17,if::(le::(calc::(${ewvfZ}*15),52),15,13)))]"
      },
      "_note": "字号:放得进 54pt 宽(留 2–4pt 余量)的最大一档。"
    },
    {
      "op": "set",
      "props": {
        "key": "ewvfE",
        "value": "$[calc::(length::(replaceAll::(${wkE},${reDg},))*0.64+length::(replaceAll::(${wkE},${reDt},))*0.3+length::(replaceAll::(${wkE},${reAs},))*1.0+length::(replaceAll::(${wkE},${reLt},))*0.85)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "vfE",
        "value": "$[if::(le::(calc::(${ewvfE}*20),50),20,if::(le::(calc::(${ewvfE}*17),51),17,if::(le::(calc::(${ewvfE}*15),52),15,13)))]"
      }
    },
