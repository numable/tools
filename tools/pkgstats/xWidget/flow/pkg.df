        "value": "$[if::(eq::(${ok},1),formatDate::(calc::(parseDate::(${endD},yyyy-MM-dd)-29*86400000),yyyy-MM-dd),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "startDMo",
        "value": "$[parseNumber::(subString::(${startIso},5,7),0)]"
      },
      "_note": "窗口起点的月日,给 44 柱图左下角的轴标。"
    },
    {
      "op": "set",
      "props": {
        "key": "startDDy",
        "value": "$[parseNumber::(subString::(${startIso},8,10),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "startDMe",
        "value": "$[index::(${MONE},calc::(${startDMo}-1))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "startDZ",
        "value": "${startDMo}月${startDDy}日"
      }
