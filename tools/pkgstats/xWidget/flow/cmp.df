          "params": {
            "url": "https://pypistats.org/api/packages/$[toLowerCase::(${n1})]/overall",
            "method": "GET",
            "queryParams": {
              "mirrors": "false"
            },
            "formatType": "json",
            "timeout": "10000"
          }
        }
