        "key": "m1",
        "value": "$[if::(eq::(${has1},1),if::(eq::(${c1},1),0,if::(eq::(${y1},1),0,1)),0)]"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "${m1}"
      },
      "items": [
        {
          "id": "rN1",
          "action": "request",
          "params": {
            "url": "https://api.npmjs.org/downloads/range/last-year/${n1}",
            "method": "GET",
            "formatType": "json",
            "timeout": "10000"
