{
 "_note": "启动读(零网络):关注的仓库。首页先拿它备好「添加」面板的已加状态,再去跑 home.df。",
 "version": 1,
 "actions": [
  {
   "id": "slots",
   "action": "data.get",
   "params": {
    "key": "gh_slots",
    "default": []
   }
  },
  {
   "op": "set",
   "props": {
    "key": "_b",
    "value": "1"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "list",
    "value": "${slots}"
   }
  },
  {
   "action": "resultFilter",
   "params": {
    "keys": [
     "list"
    ]
   }
  }
 ]
}