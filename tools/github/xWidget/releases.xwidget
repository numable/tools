{
  "version": 2,
  "title": "新版本",
  "sub": "关注仓库最近发布的版本",
  "i18n": {
    "en-US": {
      "title": "Releases",
      "sub": "Latest releases of repos you watch"
    }
  },
  "layout": 42,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/releases.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/repos.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "发布 / 贡献是天级变化,更密的刷新买不到新信息。",
      "interval": [
        "3600"
      ]
    }
  },
  "_note_noEdit": "无 onEdit:内容由令牌的主人与首页维护的关注位决定,组件本身没有可编辑的参数。",
  "ai": {
    "shows": "关注仓库最近发布的版本号与发布时间"
  }
}
