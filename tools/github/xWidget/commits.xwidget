{
  "version": 2,
  "title": "最近提交",
  "sub": "你名下仓库里最新的几次提交",
  "i18n": {
    "en-US": {
      "title": "Recent commits",
      "sub": "The latest commits across repos you own"
    }
  },
  "layout": 44,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/commits.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/activity.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "提交数按天切,30 分钟一刷足够看到「今天」在涨;更密只是白跑。",
      "interval": [
        "1800"
      ]
    }
  },
  "_note_noEdit": "无 onEdit:内容由令牌的主人与首页维护的关注位决定,组件本身没有可编辑的参数。",
  "ai": {
    "shows": "用户名下仓库最近的几次提交,以及近 7 天提交总数"
  }
}
