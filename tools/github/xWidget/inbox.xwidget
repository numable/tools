{
  "version": 2,
  "title": "待我处理",
  "sub": "等你 review 的 PR、要处理的 PR 与指派给你的 issue",
  "i18n": {
    "en-US": {
      "title": "Waiting on you",
      "sub": "Reviews, PRs that need you, and assigned issues"
    }
  },
  "layout": 44,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "_note_jobs": "长按 → 「添加提醒」。只挂与这张卡内容相关的规则(reviews = 点名请你 review;ci = 关注仓库 CI 失败)—— 长按「年度贡献」弹出「CI 失败提醒」是答非所问(审查)。",
  "jobs": [
    {
      "id": "reviews",
      "params": {}
    }
  ],
  "canvas": {
    "source": "@[file://rc/inbox.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/todo.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "一条 GraphQL = 1 点,配额 5000 点/小时;全包的卡都挂上 10 分钟一刷也只用几十点/小时。",
      "interval": [
        "600"
      ]
    }
  },
  "_note_noEdit": "无 onEdit:内容由令牌的主人与首页维护的关注位决定,组件本身没有可编辑的参数。",
  "ai": {
    "shows": "等用户 review 的 PR、需要用户处理的自己的 PR,以及指派给用户的 issue 列表"
  }
}
