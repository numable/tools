{
  "version": 2,
  "title": "年度贡献",
  "sub": "GitHub 个人页口径：只算关联到账号的提交与 PR、issue",
  "i18n": {
    "en-US": {
      "title": "Contributions",
      "sub": "Your last year, straight from GitHub"
    }
  },
  "layout": 42,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/contrib.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/contrib.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "发布 / 贡献是天级变化,更密的刷新买不到新信息。",
      "interval": [
        "3600"
      ]
    }
  },
  "_note_noEdit": "无 onEdit:内容由令牌的主人与首页维护的关注位决定,组件本身没有可编辑的参数。",
  "ai": {
    "shows": "过去一年的 GitHub 贡献日历与总贡献数,与个人主页同源"
  }
}
