{
  "version": 2,
  "title": "我的 PR",
  "sub": "你打开的 PR 有几个 · 最要紧的那条状态",
  "i18n": {
    "en-US": {
      "title": "My PRs",
      "sub": "How many PRs you have open, and the most urgent status"
    }
  },
  "layout": 11,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/prs11.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/todo.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "一条 GraphQL = 1 点,配额 5000 点/小时;全包的卡都挂上 10 分钟一刷也只用几十点/小时。",
      "interval": [
        "600"
      ]
    }
  },
  "_note_noEdit": "无 onEdit:内容由令牌的主人与首页维护的关注位决定,组件本身没有可编辑的参数。",
  "ai": {
    "shows": "用户打开着的 PR 个数,颜色与底行是其中最要紧那条的状态(冲突 / CI 未通过 / 可合并…)(一格小号)"
  }
}
