{
  "version": 2,
  "title": "今天提交",
  "sub": "你名下仓库今天、昨天各几次提交",
  "i18n": {
    "en-US": {
      "title": "Today",
      "sub": "Commits today and yesterday in repos you own"
    }
  },
  "layout": 22,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/today.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/activity.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "提交数按天切,30 分钟一刷足够看到「今天」在涨;更密只是白跑。",
      "interval": [
        "1800"
      ]
    }
  },
  "_note_noEdit": "无 onEdit:内容由令牌的主人与首页维护的关注位决定,组件本身没有可编辑的参数。",
  "ai": {
    "shows": "用户名下仓库今天与昨天各有几次提交"
  }
}
