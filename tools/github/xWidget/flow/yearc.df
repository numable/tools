),0),0))]"}},{"op":"set","props":{"key":"streak","value":"$[if::(gt::(${_s0},0),${_s0},${_s1})]"},"_note":"当前连续天数:从今天往回数连续有提交的天;今天还没提交就从昨天起算。"},{"op":"set","props":{"key":"tday","value":"$[if::(gt::(findNotEmpty::(index::(${T},0),0),0),1,0)]"},"_note":"今天有没有提交。"},{"op":"set","props":{"key":"z0","value":"$[findNotEmpty::(index::(${T},0),0)]"}},{"op":"set","props":{"key":"z1","value":"$[findNotEmpty::(index::(${T},1),0)]"}},{"op":"set","props":{"key":"z2","value":"$[findNotEmpty::(index::(${T},2),0)]"}},{"op":"set","props":{"key":"z3","value":"$[findNotEmpty::(index::(${T},3),0)]"}},{"op":"set","props":{"key":"z4","value":"$[findNotEmpty::(index::(${T},4),0)]"}},{"op":"set","props":{"key":"z5","value":"$[findNotEmpty::(index::(${T},5),0)]"}},{"op":"set","props":{"key":"z6","value":"$[findNotEmpty::(index::(${T},6),0)]"}},{"op":"set","props":{"key":"z7","value":"$[findNotEmpty::(index::(${T},7),0)]"}},{"op":"set","props":{"key":"z8","value":"$[findNotEmpty::(index::(${T},8),0)]"}},{"op":"set","props":{"key":"z9","value":"$[findNotEmpty::(index::(${T},9),0)]"}},{"op":"set","props":{"key":"z10","value":"$[findNotEmpty::(index::(${T},10),0)]"}},{"op":"set","props":{"key":"z11","value":"$[findNotEmpty::(index::(${T},11),0)]"}},{"op":"set","props":{"key":"z12","value":"$[findNotEmpty::(index::(${T},12),0)]"}},{"op":"set","props":{"key":"z13","value":"$[findNotEmpty::(index::(${T},13),0)]"}},{"op":"set","props":{"key":"total","value":"$[parseNumber::(sum::(${T}),0)]"}},{"op":"set","props":{"key":"totalS","value":"$[parseNumber::(sum::(${T}),#\\,##0)]"}},{"op":"set","props":{"key":"at","value":"$[formatDate::(${t0},HH:mm)]"}},{"action":"resultFilter","params":{"keys":["ok","login","total","totalS","act","streak","tday","heat","part","at","z0","z1","z2","z3","z4","z5","z6","z7","z8","z9","z10","z11","z12","z13"]}}]}
