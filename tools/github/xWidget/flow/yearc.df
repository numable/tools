200000),yyyy-MM-dd)]","$[formatDate::(calc::(${E0}-364*86400000+43200000),yyyy-MM-dd)]","$[formatDate::(calc::(${E0}-365*86400000+43200000),yyyy-MM-dd)]","$[formatDate::(calc::(${E0}-366*86400000+43200000),yyyy-MM-dd)]","$[formatDate::(calc::(${E0}-367*86400000+43200000),yyyy-MM-dd)]","$[formatDate::(calc::(${E0}-368*86400000+43200000),yyyy-MM-dd)]","$[formatDate::(calc::(${E0}-369*86400000+43200000),yyyy-MM-dd)]","$[formatDate::(calc::(${E0}-370*86400000+43200000),yyyy-MM-dd)]"]},"_note":"371 个本地日期打包成**一个**节点(一天一个键是 371 个节点,每个节点都要复制一遍数据域)。"},{"op":"set","props":{"key":"_yb","value":"1"},"_note":"⚠️ 请求/并发屏障(勿删):request 与 concurrent 之后**紧邻**的节点读不到响应(晚一拍合并,memory [[actionflow-concurrent-late-merge]])。删掉它 → 下面所有 index:: 静默取空 → 卡渲一片 `--`,而流仍报 success。"},{"op":"set","props":{"key":"hdr","value":{"Accept":"application/json","Content-Type":"application/json","User-Agent":"Numable"}}},{"op":"set","props":{"key":"body","value":"{\"query\": \"query{viewer{login repositories(first:6,orderBy:{field:PUSHED_AT,direction:DESC},ownerAffiliations:[OWNER],isFork:false,isArchived:false){nodes{nameWithOwner}} }}\"}"}},{"_note":"GraphQL 出错恒返 200、错误在 errors[] 里;没绑 / 令牌失效时是 401。两种情况下 data.viewer 都取不到 → 下面 ok=0,不会假绿。","id":"q","action":"request","params":{"url":"https://api.github.com/graphql","method":"POST","header":"${hdr}","body":"${body}","formatType":"json","credential":"gh"}},{"op":"set","props":{"key":"_b","value":"1"},"_note":"⚠️ 请求/并发屏障(勿删):request 与 concurrent 之后**紧邻**的节点读不到响应(晚一拍合并,memory [[actionflow-concurrent-late-merge]])。删掉它 → 下面所有 index:: 静默取空 → 卡渲一片 `--`,而流仍报 success。"},{"op":"set","props":{"key":"login","value":"${q.data.viewer.login}"}},{"op":"set","props":{"key":"ok","value":"$[if::(or::(eq::(connect::(k,${login}),k)),0,1)]"},"_note":"判据是 **viewer 有没有回来**,不是任何计数:待办恰好全是 0 是好消息,拿计数判会把「今天很干净」误判成「没取到」。⚠️ 用 `connect::(k,…)` 哨兵拼串再比 —— `eq` 是数字化比较,`eq::(0,)` 恒真(todo.df 2026-08-26 栽过)。\n⚠️ 还要求本条流用到的每一段都回来了(need):GraphQL 部分超时会只让某几个 search 为 null、viewer 照常返回 —— 只看 viewer 会把「没取到」渲成「都处理完了」,提醒也会判假而不是未知(2026-09-25 审查实证)。"},{"_note":"取数失败出口:viewer 没回来 = 这一轮什么都不可信(401 / 断网 / GraphQL 整体出错)。抛错让宿主走失败态 —— 不落封面、回落上次成功的数据、提醒判「未知」不响;报成功就会拿一份全空的数据盖掉好数据。⚠️ 「列表为空」是成功,不在这里判。errorMsg 是诊断串,只进运行日志,写英文。","op":"if","props":{"val":"$[if::(eq::(${ok},1),0,1)]"},"items":[{"action":"error","params":{"errorMsg":"github graphql: viewer missing (auth or network)"}}]},{"op":"set","props":{"key":"DAYS","value":"d0:history(since:\\\"${Y[0]}T00:00:00${TZ}\\\"){totalCount} d1:history(since:\\\"${Y[1]}T00:00:00${TZ}\\\",until:\\\"${Y[0]}T00:00:00${TZ}\\\"){totalCount} d2:history(since:\\\"${Y[2]}T00:00:00${TZ}\\\",until:\\\"${Y[1]}T00:00:00${TZ}\\\"){totalCount} d3:history(since:\\\"${Y[3]}T00:00:00${TZ}\\\",until:\\\"${Y[2]}T00:00:00${TZ}\\\"){totalCount} d4:history(since:\\\"${Y[4]}T00:00:00${TZ}\\\",until:\\\"${Y[3]}T00:00:00${TZ}\\\"){totalCount} d5:history(since:\\\"${Y[5]}T00:00:00${TZ}\\\",until:\\\"${Y[4]}T00:00:00${TZ}\\\"){totalCount} d6:history(since:\\\"${Y[6]}T00:00:00${TZ}\\\",until:\\\"${Y[5]}T00:00:00${TZ}\\\"){totalCount} d7:history(since:\\\"${Y[7]}T00:00:00${TZ}\\\",until:\\\"${Y[6]}T00:00:00${TZ}\\\"){totalCount} d8:history(since:\\\"${Y[8]}T00:00:00${TZ}\\\",until:\\\"${Y[7]}T00:00:00${TZ}\\\"){totalCount} d9:history(since:\\\"${Y[9]}T00:00:00${TZ}\\\",until:\\\"${Y[8]}T00:00:00${TZ}\\\"){totalCount} d10:history(since:\\\"${Y[10]}T00:00:00${TZ}\\\",until:\\\"${Y[9]}T00:00:00${TZ}\\\"){totalCount} d11:history(since:\\\"${Y[11]}T00:00:00${TZ}\\\",until:\\\"${Y[10]}T00:00:00${TZ}\\\"){totalCount} d12:history(since:\\\"${Y[12]}T00:00:00${TZ}\\\",until:\\\"${Y[11]}T00:00:00${TZ}\\\"){totalCount} d13:history(since:\\\"${Y[13]}T00:00:00${TZ}\\\",until:\\\"${Y[12]}T00:00:00${TZ}\\\"){totalCount} d14:history(since:\\\"${Y[14]}T00:00:00${TZ}\\\",until:\\\"${Y[13]}T00:00:00${TZ}\\\"){totalCount} d15:history(since:\\\"${Y[15]}T00:00:00${TZ}\\\",until:\\\"${Y[14]}T00:00:00${TZ}\\\"){totalCount} d16:history(since:\\\"${Y[16]}T00:00:00${TZ}\\\",until:\\\"${Y[15]}T00: