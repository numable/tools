{
  "version": 2,
  "title": "年度提交",
  "sub": "过去一年每天几次提交 · 你名下最近推送的仓库",
  "i18n": {
    "en-US": {
      "title": "Yearly commits",
      "sub": "Commits per day over the last year, across repos you own"
    }
  },
  "layout": 42,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/yearc.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/yearc.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "发布 / 贡献是天级变化,更密的刷新买不到新信息。",
      "interval": [
        "3600"
      ]
    }
  },
  "_note_noEdit": "无 onEdit:内容由令牌的主人与首页维护的关注位决定,组件本身没有可编辑的参数。",
  "ai": {
    "shows": "过去一年每天的提交数日历与总数,统计用户名下最近推送的 6 个仓库"
  }
}
