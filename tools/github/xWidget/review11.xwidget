{
  "version": 2,
  "title": "待评审",
  "sub": "等你 review 的 PR 有几个 · 最早的开了几天",
  "i18n": {
    "en-US": {
      "title": "Review requests",
      "sub": "PRs waiting for your review, and the oldest"
    }
  },
  "layout": 11,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "_note_jobs": "长按 → 「添加提醒」。只挂与这张卡内容相关的规则(reviews = 点名请你 review;ci = 关注仓库 CI 失败)—— 长按「年度贡献」弹出「CI 失败提醒」是答非所问(审查)。",
  "jobs": [
    {
      "id": "reviews",
      "params": {}
    }
  ],
  "canvas": {
    "source": "@[file://rc/review11.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/todo.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "一条 GraphQL = 1 点,配额 5000 点/小时;全包的卡都挂上 10 分钟一刷也只用几十点/小时。",
      "interval": [
        "600"
      ]
    }
  },
  "_note_noEdit": "无 onEdit:内容由令牌的主人与首页维护的关注位决定,组件本身没有可编辑的参数。",
  "ai": {
    "shows": "等用户 review 的 PR 有几个,最早的已开了几天(一格小号)"
  }
}
