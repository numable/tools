{
  "version": 2,
  "title": "连续提交",
  "sub": "从今天往回连续有提交的天数 · 近 14 天打卡",
  "i18n": {
    "en-US": {
      "title": "Commit streak",
      "sub": "Days in a row with commits, plus the last 14 days"
    }
  },
  "layout": 22,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/streak.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/yearc.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "发布 / 贡献是天级变化,更密的刷新买不到新信息。",
      "interval": [
        "3600"
      ]
    }
  },
  "_note_noEdit": "无 onEdit:内容由令牌的主人与首页维护的关注位决定,组件本身没有可编辑的参数。",
  "ai": {
    "shows": "用户名下仓库从今天往回连续有提交的天数,与近 14 天每天有没有提交的打卡点阵"
  }
}
