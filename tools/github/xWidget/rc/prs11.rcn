{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#F9FCFA\\,#EEF8F0)@90|linear(#15171A\\,#161B1B\\,#18221E)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#2DA44E|#3FB950",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.my11}",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${my11},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "id": "num",
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${my11}",
            "fontSize": "${myF}pt",
            "typeface": "System-Bold",
            "textColor": "$[if::(eq::(findNotEmpty::(${ok},0),1),if::(eq::(${myW},0),#8E939B,if::(eq::(${myW},1),#E5534B,if::(eq::(${myW},2),#E5534B,if::(eq::(${myW},3),#C4870E,if::(eq::(${myW},4),#8E939B,if::(eq::(${myW},5),#2DA44E,if::(eq::(${myW},6),#C4870E,if::(eq::(${myW},7),#8E939B,if::(eq::(${myW},8),#4493F8,#A371F7))))))))),#8E939B)]"
          }
        ],
        "_note": "字号 `${myF}pt` 是数据驱动尺寸:只在有值时画(空数据走下面的字面量「--」)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${my11},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "id": "numE",
            "type": "txt",
            "x": "8pt",
            "y": "28pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "--",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#9AA0A6|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),gt::(findNotEmpty::(${nMy},0),0),0)]"
        },
        "react": [
          {
            "id": "st",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "$[if::(eq::(${myW},1),${@i18n.sConf},if::(eq::(${myW},2),${@i18n.sFail},if::(eq::(${myW},3),${@i18n.sChg},if::(eq::(${myW},4),${@i18n.sDraft},if::(eq::(${myW},5),${@i18n.sReady},if::(eq::(${myW},6),${@i18n.sRun},if::(eq::(${myW},7),${@i18n.sWait},if::(eq::(${myW},8),${@i18n.tRv},${@i18n.tAs}))))))))]",
            "fontSize": "9pt",
            "textColor": "$[if::(eq::(findNotEmpty::(${ok},0),1),if::(eq::(${myW},0),#8E939B,if::(eq::(${myW},1),#E5534B,if::(eq::(${myW},2),#E5534B,if::(eq::(${myW},3),#C4870E,if::(eq::(${myW},4),#8E939B,if::(eq::(${myW},5),#2DA44E,if::(eq::(${myW},6),#C4870E,if::(eq::(${myW},7),#8E939B,if::(eq::(${myW},8),#4493F8,#A371F7))))))))),#8E939B)]",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),eq::(findNotEmpty::(${nMy},0),0),0)]"
        },
        "react": [
          {
            "id": "none",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.my11none}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),0,1)]"
        },
        "react": [
          {
            "id": "subE",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "lineBreak": "0"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "sConf": "有冲突",
        "sFail": "CI 未通过",
        "sChg": "需修改",
        "sDraft": "草稿",
        "sReady": "可合并",
        "sRun": "CI 运行中",
        "sWait": "等待 review",
        "tRv": "等你 review",
        "tAs": "指派给你",
        "my11": "我的 PR",
        "my11none": "没有打开的"
      },
      "en-US": {
        "sConf": "Conflict",
        "sFail": "CI failed",
        "sChg": "Changes",
        "sDraft": "Draft",
        "sReady": "Ready",
        "sRun": "CI running",
        "sWait": "In review",
        "tRv": "Review",
        "tAs": "Assigned",
        "my11": "My PRs",
        "my11none": "none open"
      }
    }
  }
}
