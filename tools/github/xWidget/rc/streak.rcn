        "y": "121.0pt",
        "w": "14.0pt",
        "h": "14.0pt",
        "bgColor": "$[if::(ge::(findNotEmpty::(${z0},0),40),#1A7F37|#56D364,if::(ge::(findNotEmpty::(${z0},0),15),#3FA45E|#2EA043,if::(ge::(findNotEmpty::(${z0},0),5),#7FCE97|#1D6E2C,if::(ge::(findNotEmpty::(${z0},0),1),#BFE6C9|#12421F,#E7E9EE|#20232A))))]",
        "cornerRadius": {
          "leftT": "4pt",
          "leftB": "4pt",
