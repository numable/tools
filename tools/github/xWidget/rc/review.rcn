{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#F9FCFA\\,#EEF8F0)@90|linear(#15171A\\,#161B1B\\,#18221E)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12.0pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#2DA44E|#3FB950",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "21.0pt",
        "y": "11pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.review}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "12.0pt",
        "y": "14pt",
        "w": "134.0pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "lineBreak": "0"
      },
      {
        "id": "num",
        "type": "txt",
        "x": "12.0pt",
        "y": "30pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${nRv},--)]",
        "fontSize": "34pt",
        "typeface": "System-Bold",
        "textColor": "$[if::(eq::(findNotEmpty::(${ok},0),1),if::(gt::(findNotEmpty::(${nRv},0),0),#4493F8,#2DA44E),#8E939B)]",
        "hide": "$[if::(eq::(findNotEmpty::(${nRv},--),--),1,0)]",
        "lineBreak": "0"
      },
      {
        "id": "numE",
        "type": "txt",
        "x": "12.0pt",
        "y": "40.25pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "--",
        "fontSize": "34pt",
        "typeface": "System-Bold",
        "textColor": "$[if::(eq::(findNotEmpty::(${ok},0),1),if::(gt::(findNotEmpty::(${nRv},0),0),#4493F8,#2DA44E),#8E939B)]",
        "hide": "$[if::(eq::(findNotEmpty::(${nRv},--),--),0,2)]",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),gt::(findNotEmpty::(${nRv},0),0),0)]"
        },
        "react": [
          {
            "id": "old",
            "type": "txt",
            "x": "12.0pt",
            "y": "{num.b}+6pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.rvOld} ${roD} ${@i18n.rvOldB}",
            "fontSize": "10pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "hide": "$[if::(gt::(findNotEmpty::(${roD},0),0),0,2)]",
            "lineBreak": "0"
          },
          {
            "id": "new",
            "type": "txt",
            "x": "12.0pt",
            "y": "{num.b}+6pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.rvNew}",
            "fontSize": "10pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "hide": "$[if::(gt::(findNotEmpty::(${roD},0),0),2,0)]",
            "lineBreak": "0"
          },
          {
            "id": "s0",
            "type": "txt",
            "x": "12.0pt",
            "y": "{parent.h}-12pt-{s0.h}",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${roR}",
            "fontSize": "8.5pt",
            "textColor": "#6B7280|#8E939B",
            "lineBreak": "0"
          },
          {
            "id": "t0",
            "type": "txt",
            "x": "12.0pt",
            "y": "{s0.y}-4pt-{t0.h}",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "2",
            "lineSpacing": "2pt",
            "text": "${roT}",
            "fontSize": "10.5pt",
            "textColor": "#0E1116|#F3F4F6",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),0,1)]"
        },
        "react": [
          {
            "id": "ub",
            "type": "txt",
            "x": "12.0pt",
            "y": "70pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.unbound}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),eq::(findNotEmpty::(${nRv},0),0),0)]"
        },
        "react": [
          {
            "id": "eT",
            "type": "txt",
            "x": "12.0pt",
            "y": "{num.b}+6pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.rvE}",
            "fontSize": "11pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "lineBreak": "0"
          },
          {
            "id": "eH",
            "type": "txt",
            "x": "12.0pt",
            "y": "{eT.b}+4pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "2",
            "lineSpacing": "2pt",
            "text": "${@i18n.rvEH}",
            "fontSize": "9.5pt",
            "textColor": "#6B7280|#8E939B",
            "lineBreak": "0"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "review": "待评审",
        "rvOld": "最早的已开",
        "rvOldB": "天",
        "rvNew": "都是今天开的",
        "rvE": "没人在等你",
        "rvEH": "有人点名请你 review 时会显示在这里",
        "unbound": "还没连接 GitHub 账号"
      },
      "en-US": {
        "review": "Reviews",
        "rvOld": "Oldest open for",
        "rvOldB": "days",
        "rvNew": "All opened today",
        "rvE": "No one is waiting",
        "rvEH": "Reviews requested from you show up here",
        "unbound": "GitHub account not connected"
      }
    }
  }
}
