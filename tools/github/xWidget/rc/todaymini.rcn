{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#F9FCFA\\,#EEF8F0)@90|linear(#15171A\\,#161B1B\\,#18221E)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#2DA44E|#3FB950",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "90pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.today}",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "lineBreak": "0"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "113pt",
        "y": "10.5pt",
        "w": "35pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(findNotEmpty::(${ok},0),1)]"
        },
        "react": [
          {
            "id": "num",
            "type": "richText",
            "x": "10pt",
            "y": "27pt",
            "w": "78pt",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "$[findNotEmpty::(${D0},--)]",
                "fontSize": "16.5pt",
                "typeface": "System-Bold",
                "textColor": "$[if::(eq::(findNotEmpty::(${ok},0),1),#2DA44E,#8E939B)]"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "20pt"
              },
              {
                "text": "${@i18n.ydS} $[findNotEmpty::(${D1},--)]",
                "fontSize": "9pt",
                "textColor": "#6B7280|#8E939B"
              }
            ],
            "lineBreak": "0"
          },
          {
            "id": "b0",
            "type": "layer",
            "x": "140.9pt",
            "y": "${my0}pt",
            "w": "6pt",
            "h": "${mh0}pt",
            "bgColor": "#2DA44E|#3FB950",
            "cornerRadius": {
              "leftT": "1.5pt",
              "leftB": "1.5pt",
              "rightT": "1.5pt",
              "rightB": "1.5pt"
            }
          },
          {
            "id": "b1",
            "type": "layer",
            "x": "132.6pt",
            "y": "${my1}pt",
            "w": "6pt",
            "h": "${mh1}pt",
            "bgColor": "#9BD8AE|#2A6B3C",
            "cornerRadius": {
              "leftT": "1.5pt",
              "leftB": "1.5pt",
              "rightT": "1.5pt",
              "rightB": "1.5pt"
            }
          },
          {
            "id": "b2",
            "type": "layer",
            "x": "124.3pt",
            "y": "${my2}pt",
            "w": "6pt",
            "h": "${mh2}pt",
            "bgColor": "#9BD8AE|#2A6B3C",
            "cornerRadius": {
              "leftT": "1.5pt",
              "leftB": "1.5pt",
              "rightT": "1.5pt",
              "rightB": "1.5pt"
            }
          },
          {
            "id": "b3",
            "type": "layer",
            "x": "116.0pt",
            "y": "${my3}pt",
            "w": "6pt",
            "h": "${mh3}pt",
            "bgColor": "#9BD8AE|#2A6B3C",
            "cornerRadius": {
              "leftT": "1.5pt",
              "leftB": "1.5pt",
              "rightT": "1.5pt",
              "rightB": "1.5pt"
            }
          },
          {
            "id": "b4",
            "type": "layer",
            "x": "107.7pt",
            "y": "${my4}pt",
            "w": "6pt",
            "h": "${mh4}pt",
            "bgColor": "#9BD8AE|#2A6B3C",
            "cornerRadius": {
              "leftT": "1.5pt",
              "leftB": "1.5pt",
              "rightT": "1.5pt",
              "rightB": "1.5pt"
            }
          },
          {
            "id": "b5",
            "type": "layer",
            "x": "99.4pt",
            "y": "${my5}pt",
            "w": "6pt",
            "h": "${mh5}pt",
            "bgColor": "#9BD8AE|#2A6B3C",
            "cornerRadius": {
              "leftT": "1.5pt",
              "leftB": "1.5pt",
              "rightT": "1.5pt",
              "rightB": "1.5pt"
            }
          },
          {
            "id": "b6",
            "type": "layer",
            "x": "91.1pt",
            "y": "${my6}pt",
            "w": "6pt",
            "h": "${mh6}pt",
            "bgColor": "#9BD8AE|#2A6B3C",
            "cornerRadius": {
              "leftT": "1.5pt",
              "leftB": "1.5pt",
              "rightT": "1.5pt",
              "rightB": "1.5pt"
            }
          }
        ],
        "_note": "柱高 / 柱顶是数据驱动尺寸,只在 ok 时画(没有数据时裸 pt 会让整张组件渲不出来)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),0,1)]"
        },
        "react": [
          {
            "id": "numE",
            "type": "txt",
            "x": "10pt",
            "y": "32pt",
            "w": "78pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "16.5pt",
            "typeface": "System-Bold",
            "textColor": "#9AA0A6|#8E939B",
            "lineBreak": "0"
          },
