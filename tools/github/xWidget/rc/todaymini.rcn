            }
          }
        ],
        "_note": "没有数据时:值位「--」(下移到数字中线)+ 一排 3pt 占位柱。"
      }
    ],
    "i18n": {
      "zh-CN": {
        "today": "今天提交",
        "ydS": "昨天",
        "nbsp": " "
      },
      "en-US": {
        "today": "Today",
        "ydS": "Yest.",
