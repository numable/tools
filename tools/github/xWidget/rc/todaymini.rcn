              "rightT": "1.5pt",
              "rightB": "1.5pt"
            }
          },
          {
            "id": "z5",
            "type": "layer",
            "x": "99.4pt",
            "y": "43pt",
            "w": "6pt",
            "h": "3pt",
            "bgColor": "#E7E9EE|#20232A",
            "cornerRadius": {
              "leftT": "1.5pt",
              "leftB": "1.5pt",
              "rightT": "1.5pt",
