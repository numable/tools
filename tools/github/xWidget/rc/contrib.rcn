{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#F9FCFA\\,#EEF8F0)@90|linear(#15171A\\,#161B1B\\,#18221E)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "14.0pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#2DA44E|#3FB950",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "23.0pt",
        "y": "12pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(connect::(k,${handle}),k),${@i18n.brand},connect::(@,${handle}))]",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "14.0pt",
        "y": "15pt",
        "w": "310pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(findNotEmpty::(${ok},0),1)]"
        },
        "react": [
          {
            "type": "op",
            "action": "forEach",
            "props": {
              "items": "${heat}",
              "key": "_it",
              "index": "_i"
            },
            "react": [
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "$[if::(eq::(connect::(k,${_it.m}),k),0,1)]"
                },
                "react": [
                  {
                    "type": "txt",
                    "x": "14pt+${_i}*({parent.w}-28pt)/53",
                    "y": "31pt",
                    "w": "30pt",
                    "h": "-1",
                    "maxLines": "1",
                    "text": "${_it.m}",
                    "fontSize": "8.5pt",
                    "textColor": "#6B7280|#8E939B",
                    "lineBreak": "0"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "forEach",
        "props": {
          "items": "${heat}",
          "key": "_it",
          "index": "_i"
        },
        "react": [
          {
            "type": "op",
            "action": "set",
            "props": {
              "key": "_c",
              "value": "$[calc::(${_i}-0)]"
            }
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[ge::(${_it.d0},0)]"
            },
            "react": [
              {
                "type": "layer",
                "x": "14pt+${_c}*({parent.w}-28pt)/53",
                "y": "44pt+0*({parent.w}-28pt)/53",
                "w": "({parent.w}-28pt)/53-1.4pt",
                "h": "({parent.w}-28pt)/53-1.4pt",
                "cornerRadius": {
                  "leftT": "1.4pt",
                  "leftB": "1.4pt",
                  "rightT": "1.4pt",
                  "rightB": "1.4pt"
                },
                "bgColor": "$[if::(ge::(${_it.d0},10),#1A7F37|#56D364,if::(ge::(${_it.d0},6),#3FA45E|#2EA043,if::(ge::(${_it.d0},3),#7FCE97|#1D6E2C,if::(ge::(${_it.d0},1),#BFE6C9|#12421F,#E7E9EE|#20232A))))]"
              }
            ]
          }
        ],
        "_note": "第 r 行 = 周日+r;d = -1 是窗口外的天,不画。RCN 没有嵌套 forEach,7 行 = 7 个 forEach。"
      },
