{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#F9FCFA\\,#EEF8F0)@90|linear(#15171A\\,#161B1B\\,#18221E)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#2DA44E|#3FB950",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.rv11}",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${rv11},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "id": "num",
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${rv11}",
            "fontSize": "${rvF}pt",
            "typeface": "System-Bold",
            "textColor": "$[if::(eq::(findNotEmpty::(${ok},0),1),if::(gt::(findNotEmpty::(${nRv},0),0),#4493F8,#2DA44E),#8E939B)]"
          }
        ],
        "_note": "字号 `${rvF}pt` 是数据驱动尺寸:只在有值时画,空数据走下面的字面量 20pt「--」(裸 pt 会让整张组件渲不出来)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${rv11},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "id": "numE",
            "type": "txt",
            "x": "8pt",
            "y": "28pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "--",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#9AA0A6|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),if::(gt::(findNotEmpty::(${nRv},0),0),if::(gt::(findNotEmpty::(${roD},0),0),1,0),0),0)]"
        },
        "react": [
          {
            "id": "old",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.o11A} ${roD}${@i18n.o11B}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),if::(gt::(findNotEmpty::(${nRv},0),0),if::(gt::(findNotEmpty::(${roD},0),0),0,1),0),0)]"
        },
        "react": [
          {
            "id": "new",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.new11}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),eq::(findNotEmpty::(${nRv},0),0),0)]"
        },
        "react": [
          {
            "id": "none",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.none11}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),0,1)]"
        },
        "react": [
          {
            "id": "subE",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "lineBreak": "0"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "rv11": "待评审",
        "o11A": "最早",
        "o11B": " 天",
        "new11": "今天开的",
        "none11": "没人在等"
      },
      "en-US": {
        "rv11": "Reviews",
        "o11A": "oldest",
        "o11B": "d",
        "new11": "new today",
        "none11": "all clear"
      }
    }
  }
}
