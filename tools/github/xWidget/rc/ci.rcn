        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "lineBreak": "0"
      },
      {
        "id": "fb",
        "type": "txt",
        "x": "{brand.r}+6pt",
        "y": "13.5pt",
