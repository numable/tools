{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#F9FCFA\\,#EEF8F0)@90|linear(#15171A\\,#161B1B\\,#18221E)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "14.0pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#2DA44E|#3FB950",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "23.0pt",
        "y": "12pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.ci}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
