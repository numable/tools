        "bgColor": "#E7E9EE|#20232A",
        "paddingLeft": "6.0pt",
        "paddingRight": "6.0pt",
        "paddingTop": "1.5pt",
        "paddingBottom": "1.5pt",
        "cornerRadius": {
          "leftT": "8.5pt",
          "leftB": "8.5pt",
          "rightT": "8.5pt",
          "rightB": "8.5pt"
        },
        "hide": "$[if::(eq::(findNotEmpty::(${hasS},1),1),2,0)]"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
