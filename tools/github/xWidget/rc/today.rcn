{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#F9FCFA\\,#EEF8F0)@90|linear(#15171A\\,#161B1B\\,#18221E)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12.0pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#2DA44E|#3FB950",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "21.0pt",
        "y": "11pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.today}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "12.0pt",
        "y": "14pt",
        "w": "134.0pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "lineBreak": "0"
      },
      {
        "id": "num",
        "type": "txt",
        "x": "12.0pt",
        "y": "30pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${D0},--)]",
        "fontSize": "34pt",
        "typeface": "System-Bold",
        "textColor": "$[if::(eq::(findNotEmpty::(${ok},0),1),#2DA44E,#8E939B)]",
        "hide": "$[if::(eq::(findNotEmpty::(${D0},--),--),1,0)]",
        "lineBreak": "0"
      },
      {
        "id": "numE",
        "type": "txt",
        "x": "12.0pt",
        "y": "40.25pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "--",
        "fontSize": "34pt",
        "typeface": "System-Bold",
        "textColor": "$[if::(eq::(findNotEmpty::(${ok},0),1),#2DA44E,#8E939B)]",
        "hide": "$[if::(eq::(findNotEmpty::(${D0},--),--),0,2)]",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[eq::(findNotEmpty::(${ok},0),1)]"
        },
        "react": [
          {
            "id": "yd",
            "type": "txt",
            "x": "12.0pt",
            "y": "{num.b}+6pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.yday} ${D1} · ${@i18n.week7} ${wk}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "lineBreak": "0"
          },
          {
            "id": "b0",
            "type": "layer",
            "x": "130.9pt",
