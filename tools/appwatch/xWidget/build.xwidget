{
 "_note": "v54 并入原 tf(TestFlight 22)。bundleId 空 = 团队最新的那个构建(老实例无参数,语义不变)。",
 "version": 2,
 "title": "最新构建",
 "sub": "构建处理进度 + TestFlight 测试员与近 7 天反馈",
 "i18n": {
  "en-US": {
   "title": "Latest build",
   "sub": "Build processing + TestFlight testers and 7-day feedback"
  }
 },
 "layout": 42,
 "params": {
  "appId": ""
 },
 "events": {
  "onClick": "/app?appId=${appId}&country=",
  "onEdit": "/edit?w=asc&appId=${appId}",
  "_noteClick": "单对象组件点击带对象参数进详情页。`id=&n=` / `app=&n=` 两个空值键刻意写上,保证页面判空拿到的是空串而不是「键缺席 → ${} 原样透传」([[xpage-pitfalls]])。bundleId 为空 = 账号里按名字排第一个的 App,页面流用同一条规则解析,点进去看到的就是组件上那一个。"
 },
 "canvas": {
  "source": "@[file://rc/build.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/build.df]",
    "params": {
     "appId": "${appId}",
     "_preview": "${_preview}"
    }
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "最新构建的处理进度、TestFlight 测试员数与近 7 天新反馈;需接入 App Store Connect",
  "params": {
   "appId": {
    "kind": "account",
    "hint": "用户 App Store Connect 账号里某个 App 的 Apple ID;留空 = 整个账号最新的那个构建"
   }
  }
 }
}
