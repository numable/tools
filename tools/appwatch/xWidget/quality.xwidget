{
 "_note": "v54 新增(§4.6)。perfPowerMetrics 每天才更新一次,6 小时刷一次足够。",
 "version": 2,
 "title": "性能变化",
 "sub": "新版本的启动、卡顿、内存和终止，和上一版比",
 "i18n": {
  "en-US": {
   "title": "Performance",
   "sub": "Launch, hangs, memory and terminations vs the last version"
  }
 },
 "layout": 42,
 "params": {
  "appId": ""
 },
 "events": {
  "onClick": {
   "flow": "@[file://flow/open-app.af]",
   "params": {
    "appId": "${appId}",
    "k": "n",
    "to": "app"
   }
  },
  "onEdit": "/edit?w=asc&appId=${appId}",
  "_noteClick": "点击走 open-app.af:appId 有值照旧带它;留空时组件流自己挑了一个 App(build = 最新构建所属 App,其余 = 账号里按名字排第一个),流把挑中的记进 wpick.n,点进去就是组件上那一个(onClick 串引用不到流输出)。"
 },
 "canvas": {
  "source": "@[file://rc/quality.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/quality.df]",
    "params": {
     "appId": "${appId}",
     "_preview": "${_preview}"
    }
   }
  ],
  "refresh": {
   "interval": [
    "21600"
   ]
  }
 },
 "ai": {
  "shows": "最新版本的启动耗时、卡顿、内存峰值、前台终止,与上一版对比;需接入 App Store Connect",
  "params": {
   "appId": {
    "kind": "account",
    "hint": "用户 App Store Connect 账号里某个 App 的 Apple ID;留空 = 账号里按名字排第一个的 App"
   }
  }
 }
}
