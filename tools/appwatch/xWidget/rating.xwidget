{
  "version": 2,
  "title": "评分",
  "sub": "App 评分与评分数",
  "i18n": {
    "en-US": {
      "title": "Rating",
      "sub": "App rating and review count"
    }
  },
  "layout": 22,
  "params": {
    "_note": "appId 空 = 我关注的第一个 App(流在取数时回落,组件首行照实显示是谁)。想固定盯某一个:长按组件「编辑参数」(/edit)选,或从详情页的「添加组件」加(带参数)。",
    "appId": "",
    "country": ""
  },
  "events": {
    "onClick": "/app?appId=${appId}&country=${country}",
    "onEdit": "/edit?w=app&appId=${appId}&country=${country}"
  },
  "canvas": {
    "source": "@[file://rc/rating.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/app.df]",
        "params": {
          "appId": "${appId}",
          "country": "${country}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "某个 App 在 App Store 的评分与评分数,以及今天的变化",
    "params": {
      "appId": {
        "kind": "value",
        "format": "App Store 数字 Apple ID(apps.apple.com 链接里 id 后面那串数字),任意公开 App 都可以",
        "hint": "留空 = 用户关注列表里的第一个 App;不确知 ID 就留空,别猜",
        "examples": [
          "414478124",
          "389801252",
          "835599320"
        ]
      },
      "country": {
        "kind": "auto",
        "format": "两位 App Store 地区码,大写,如 US / CN / JP / GB / DE",
        "hint": "留空 = 关注列表的地区设置(没设过:国内用户 CN、其余 US);用户点名地区时才填"
      }
    }
  }
}
