{"_note":"经营组件点击只接收实例 appId；空值为账号合计。未接入去接入页，缺供应商编号去设置。","version":1,"actions":[{"id":"csq","action":"credential.state","params":{"id":"asc"}},{"id":"v","action":"data.get","params":{"key":"vendor","default":""}},{"op":"set","props":{"key":"b","value":"${appId}"},"_note":"入参落地(勿删)。"},{"op":"set","props":{"key":"hk","value":"$[if::(eq::(${csq.state},bound),1,0)]"}},{"op":"set","props":{"key":"hv","value":"$[if::(gt::(length::(${v}),0),1,0)]"}},{"op":"set","props":{"key":"to","value":"$[if::(eq::(${hk},0),connect,if::(eq::(${hv},0),settings,sales))]"},"_note":"合并包:没绑密钥 → 接入页;绑了没填编号 → 设置;都有 → 经营明细。"},{"op":"if","props":{"val":"$[if::(eq::(${to},connect),1,0)]"},"items":[{"action":"nav.open","params":{"url":"numable://01KZD9PY65Y9341817EEV4VT31/page/connect"}}]},{"op":"if","props":{"val":"$[if::(eq::(${to},settings),1,0)]"},"items":[{"action":"nav.open","params":{"url":"numable://01KZD9PY65Y9341817EEV4VT31/page/settings"}}]},{"op":"if","props":{"val":"$[if::(eq::(${to},sales),1,0)]"},"items":[{"action":"nav.open","params":{"url":"numable://01KZD9PY65Y9341817EEV4VT31/page/sales?id=${b}"}}]}]}
