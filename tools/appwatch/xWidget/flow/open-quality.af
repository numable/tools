{"_note":"组件字符串点击入口；只读取实例 appId 与对应自动选择记录，缺对象时进入接入页。","version":1,"actions":[{"op":"set","props":{"key":"aIn","value":"${appId}"},"_note":"入参落地(勿删)。"},{"op":"set","props":{"key":"kIn","value":"n"}},{"op":"set","props":{"key":"toIn","value":"app"}},{"id":"pk","action":"data.get","params":{"key":"wpick.${kIn}","default":""}},{"op":"set","props":{"key":"id","value":"$[findNotEmpty::(${aIn},${pk})]"},"_note":"兼作 data.get 之后的屏障。"},{"op":"if","props":{"val":"$[gt::(length::(${id}),0)]"},"items":[{"op":"if","props":{"val":"$[if::(eq::(${toIn},reviews),1,0)]"},"items":[{"action":"nav.open","params":{"url":"numable://01KZD9PY65Y9341817EEV4VT31/page/reviews?appId=${id}&country="}}]},{"op":"if","props":{"val":"$[if::(eq::(${toIn},reviews),0,1)]"},"items":[{"action":"nav.open","params":{"url":"numable://01KZD9PY65Y9341817EEV4VT31/page/app?appId=${id}&country="}}]}]},{"op":"if","props":{"val":"$[eq::(length::(${id}),0)]"},"items":[{"action":"nav.open","params":{"url":"numable://01KZD9PY65Y9341817EEV4VT31/page/connect"}}]}]}
