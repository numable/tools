{
 "_note": "v54 修 onClick:原来传 `bundleId`,而 /reviews 只读 `app` / `b` → 点进去是空页。",
 "version": 2,
 "title": "评论分析",
 "sub": "星级分布 · 每周评论数 · 差评与待回复",
 "i18n": {
  "en-US": {
   "title": "Review insights",
   "sub": "Star mix, weekly volume, low ratings and replies"
  }
 },
 "layout": 44,
 "params": {
  "appId": ""
 },
 "events": {
  "onClick": {
   "flow": "@[file://flow/open-app.af]",
   "params": {
    "appId": "${appId}",
    "k": "n",
    "to": "reviews"
   }
  },
  "onEdit": "/edit?w=asc&appId=${appId}",
  "_noteClick": "点击走 open-app.af:appId 有值照旧带它;留空时组件流自己挑了一个 App(build = 最新构建所属 App,其余 = 账号里按名字排第一个),流把挑中的记进 wpick.n,点进去就是组件上那一个(onClick 串引用不到流输出)。"
 },
 "jobs": [
  {
   "id": "bad-review",
   "params": {
    "appId": "${appId}"
   }
  }
 ],
 "canvas": {
  "source": "@[file://rc/insights.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/insights.df]",
    "params": {
     "appId": "${appId}",
     "_preview": "${_preview}"
    }
   }
  ],
  "refresh": {
   "interval": [
    "1800"
   ]
  }
 },
 "ai": {
  "shows": "最近评论的星级分布、近 12 周每周评论数、差评与待回复数;需接入 App Store Connect",
  "params": {
   "appId": {
    "kind": "account",
    "hint": "用户 App Store Connect 账号里某个 App 的 Apple ID;留空 = 账号里按名字排第一个的 App"
   }
  }
 }
}
