{
  "version": 2,
  "title": "版本（小）",
  "sub": "当前审核步骤，或线上版本和发布时间",
  "i18n": {
    "en-US": {
      "title": "Version (small)",
      "sub": "Current review step, or the live version"
    }
  },
  "layout": 22,
  "params": {
    "_note": "appId 空 = 我关注的第一个 App(流在取数时回落,组件首行照实显示是谁)。想固定盯某一个:长按组件「编辑参数」(/edit)选,或从详情页的「添加组件」加(带参数)。",
    "appId": "",
    "country": ""
  },
  "events": {
    "onClick": "/app?appId=${appId}&country=${country}",
    "onEdit": "/edit?w=app&appId=${appId}&country=${country}"
  },
  "canvas": {
    "source": "@[file://rc/versionmini.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/vstatus.df]",
        "params": {
          "appId": "${appId}"
        },
        "_note": "私有分支(审核阶梯):只对确认在账号里的 App 发请求;排在前,重名键由公开流胜出。"
      },
      {
        "flow": "@[file://flow/app.df]",
        "params": {
          "appId": "${appId}",
          "country": "${country}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "jobs": [
    {
      "id": "review-state",
      "params": {}
    },
    {
      "id": "rival-release",
      "params": {}
    }
  ],
  "_note": "双源组件(appstore-merged §5):自己的 App 且已接入 → 五步审核阶梯 + 分阶段发布(原 ASC status);否则 → 线上版本号 · 发布时间 · 更新说明(原 appwatch version)。",
  "ai": {
    "shows": "自己已接入的 App 显示当前审核步骤;其他 App 显示线上版本号与发布于几天前",
    "params": {
      "appId": {
        "kind": "value",
        "format": "App Store 数字 Apple ID(apps.apple.com 链接里 id 后面那串数字),任意公开 App 都可以",
        "hint": "留空 = 用户关注列表里的第一个 App;不确知 ID 就留空,别猜",
        "examples": [
          "414478124",
          "389801252",
          "835599320"
        ]
      },
      "country": {
        "kind": "auto",
        "format": "两位 App Store 地区码,大写,如 US / CN / JP / GB / DE",
        "hint": "留空 = 关注列表的地区设置(没设过:国内用户 CN、其余 US);用户点名地区时才填"
      }
    }
  }
}
