{
 "_note": "近 12 个月(2026-10-10 新增):月报按月落盘(原币种),财务报表按财年月落盘;平时每次刷新 0 个请求,冷启动 12 + 4 个分两批并发。一小时刷一次与 trend 同节奏,只为新月份 / 新一期财务报表出炉时能及时补上。",
 "version": 2,
 "title": "近 12 个月",
 "sub": "每月下载与收益走势、同比，和 Apple 确认的实收",
 "i18n": {
  "en-US": {
   "title": "Last 12 months",
   "sub": "Monthly downloads and proceeds, year over year, and what Apple has confirmed"
  }
 },
 "layout": 44,
 "params": {
  "appId": ""
 },
 "events": {
  "onClick": {
   "flow": "@[file://flow/open-sales.af]",
   "params": {
    "bid": "${appId}"
   }
  },
  "onEdit": "/edit?w=biz&appId=${appId}",
  "_noteClick": "经营组件:没填供应商编号 → /settings;填了 → /sales?b=(同一个对象)。`/edit?w=biz` 让编辑页第一项写「账号合计」而不是「跟随账号」(两组空 appId 语义不同)。"
 },
 "canvas": {
  "source": "@[file://rc/months.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/months.df]",
    "params": {
     "appId": "${appId}",
     "_preview": "${_preview}"
    }
   }
  ],
  "refresh": {
   "interval": [
    "3600"
   ]
  }
 },
 "ai": {
  "shows": "近 12 个月每月下载与收益走势、同比、Apple 最近 3 期实收;需接入 App Store Connect",
  "params": {
   "appId": {
    "kind": "account",
    "hint": "用户 App Store Connect 账号里某个 App 的 Apple ID;留空 = 账号里所有 App 合计"
   }
  }
 }
}
