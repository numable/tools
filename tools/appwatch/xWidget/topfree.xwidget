{
  "_note": "genre = App Store 分类 id,空 = 全部分类(/edit 可选)。",
  "version": 2,
  "title": "免费榜",
  "sub": "App Store 免费榜前 6,可选分类",
  "i18n": {
    "en-US": {
      "title": "Top Free",
      "sub": "App Store top 6 free apps, by category"
    }
  },
  "layout": 44,
  "params": {
    "genre": ""
  },
  "events": {
    "onClick": "numable://self",
    "onEdit": "/edit?w=chart&genre=${genre}"
  },
  "canvas": {
    "source": "@[file://rc/topfree.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/topfree.df]",
        "params": {
          "genre": "${genre}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "1800"
      ]
    }
  },
  "ai": {
    "shows": "App Store 免费榜前 6 名,可按分类;国内用户看中国区,其余看美区",
    "params": {
      "genre": {
        "kind": "enum",
        "values": {
          "": "全部分类",
          "6014": "游戏",
          "6007": "效率",
          "6005": "社交",
          "6016": "娱乐",
          "6008": "摄影与录像",
          "6015": "财务",
          "6017": "教育",
          "6013": "健康健美",
          "6012": "生活",
          "6024": "购物",
          "6002": "工具",
          "6011": "音乐"
        }
      }
    }
  }
}
