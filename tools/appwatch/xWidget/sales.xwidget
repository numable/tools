{
 "_note": "v55 经营组(appstore-infosources-v2 §5)。bundleId 空 = 账号合计(与发布 / 声音组件「空 = 账号第一个 App」不同)。一小时刷一次:日报一天一张、按天落盘,平时每次刷新 0–1 个请求。",
 "version": 2,
 "title": "下载",
 "sub": "那天的首次下载，和前 7 天比",
 "i18n": {
  "en-US": {
   "title": "Downloads",
   "sub": "First-time downloads for the day vs the prior 7 days"
  }
 },
 "layout": 22,
 "params": {
  "appId": ""
 },
 "events": {
  "onClick": {
   "flow": "@[file://flow/open-sales.af]",
   "params": {
    "bid": "${appId}"
   }
  },
  "onEdit": "/edit?w=biz&appId=${appId}",
  "_noteClick": "经营组件:没填供应商编号 → /settings;填了 → /sales?b=(同一个对象)。`/edit?w=biz` 让编辑页第一项写「账号合计」而不是「跟随账号」(两组空 appId 语义不同)。"
 },
 "canvas": {
  "source": "@[file://rc/sales.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/sales.df]",
    "params": {
     "appId": "${appId}",
     "_preview": "${_preview}"
    }
   }
  ],
  "refresh": {
   "interval": [
    "3600"
   ]
  }
 },
 "ai": {
  "shows": "某天的首次下载量、较前 7 天中位数与 7 天迷你柱;需接入 App Store Connect",
  "params": {
   "appId": {
    "kind": "account",
    "hint": "用户 App Store Connect 账号里某个 App 的 Apple ID;留空 = 账号里所有 App 合计"
   }
  }
 }
}
