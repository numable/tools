{
 "_note": "2026-10-08 新增(card-design-system §8.2):与 insights 同一条流,零新增请求。",
 "version": 2,
 "title": "待回复评论",
 "sub": "还没回复的评论数和差评数",
 "i18n": {
  "en-US": {
   "title": "Reviews to reply",
   "sub": "Unanswered reviews and low ratings"
  }
 },
 "layout": 11,
 "params": {
  "appId": ""
 },
 "events": {
  "onClick": {
   "flow": "@[file://flow/open-app.af]",
   "params": {
    "appId": "${appId}",
    "k": "n",
    "to": "reviews"
   }
  },
  "onEdit": "/edit?w=asc&appId=${appId}",
  "_noteClick": "点击走 open-app.af:appId 有值照旧带它;留空时组件流自己挑了一个 App(build = 最新构建所属 App,其余 = 账号里按名字排第一个),流把挑中的记进 wpick.n,点进去就是组件上那一个(onClick 串引用不到流输出)。"
 },
 "canvas": {
  "source": "@[file://rc/pending.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/insights.df]",
    "params": {
     "appId": "${appId}"
    }
   }
  ],
  "refresh": {
   "interval": [
    "1800"
   ]
  }
 },
 "ai": {
  "shows": "某个 App 还没回复的评论数与最近 200 条里的差评数(一格小号);需接入 App Store Connect",
  "params": {
   "appId": {
    "kind": "account",
    "hint": "用户 App Store Connect 账号里某个 App 的 Apple ID;留空 = 账号里按名字排第一个的 App"
   }
  }
 }
}
