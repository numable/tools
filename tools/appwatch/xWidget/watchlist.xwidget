{
  "version": 2,
  "title": "我的 App 总览",
  "sub": "关注列表 · 评分与版本",
  "i18n": {
    "en-US": {
      "title": "My apps overview",
      "sub": "Watchlist · ratings and versions"
    }
  },
  "layout": 44,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/watchlist.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/wdl.df]",
        "params": {},
        "_note": "那天下载(私有,凭证闸住;没接入零请求)。输出 sst / adl / AS,与 watchlist.df 不撞键。"
      },
      {
        "flow": "@[file://flow/watchlist.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "jobs": [
    {
      "id": "rival-release",
      "params": {}
    }
  ],
  "_note": "watchlist 吸收原 ASC fleet(appstore-merged §5):「我的」行加标记;已接入且经营区正常时再带锚点日下载。 ",
  "ai": {
    "shows": "用户关注的 App 列表:各自的评分与最近更新;自己的 App 另带那天下载量"
  }
}
