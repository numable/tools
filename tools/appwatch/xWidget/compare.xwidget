{
  "_note": "「我的 App」= 关注列表里点了 ★ 的那个(/manage);竞品 = 关注列表里其余的前两个。点击走 open-compare.af:有「我的 App」进它的详情页,没有就进管理页去标记。",
  "version": 2,
  "title": "竞品对比",
  "sub": "我的 App 与两个关注对象并排",
  "i18n": {
    "en-US": {
      "title": "Vs competitors",
      "sub": "My app side by side with two watched apps"
    }
  },
  "layout": 42,
  "params": {},
  "events": {
    "onClick": "@[file://flow/open-compare.af]"
  },
  "canvas": {
    "source": "@[file://rc/compare.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/compare.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "1800"
      ]
    }
  },
  "ai": {
    "shows": "用户标星的「我的 App」与关注列表里两个竞品并排比评分、评分数与更新时间"
  }
}
