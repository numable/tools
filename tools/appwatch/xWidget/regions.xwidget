{
  "_note": "点击进详情页时把四个地区一并带过去,详情页的分区块与组件看的是同一组地区。",
  "version": 2,
  "title": "分区评分",
  "sub": "四个地区的评分对比",
  "i18n": {
    "en-US": {
      "title": "Ratings by region",
      "sub": "Compare ratings across four storefronts"
    }
  },
  "layout": 42,
  "params": {
    "_note": "appId 空 = 我关注的第一个 App(流在取数时回落,组件首行照实显示是谁)。想固定盯某一个:长按组件「编辑参数」(/edit)选,或从详情页的「添加组件」加(带参数)。 r1..r4 = 四个地区码(/edit 可改;空 = 按国内默认判据取缺省)。",
    "appId": "",
    "r1": "",
    "r2": "",
    "r3": "",
    "r4": ""
  },
  "events": {
    "onClick": "/app?appId=${appId}&r1=${r1}&r2=${r2}&r3=${r3}&r4=${r4}",
    "onEdit": "/edit?w=regions&appId=${appId}&r1=${r1}&r2=${r2}&r3=${r3}&r4=${r4}"
  },
  "canvas": {
    "source": "@[file://rc/regions.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/regions.df]",
        "params": {
          "appId": "${appId}",
          "r1": "${r1}",
          "r2": "${r2}",
          "r3": "${r3}",
          "r4": "${r4}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "同一个 App 在四个地区的评分与评分数并排对比",
    "params": {
      "appId": {
        "kind": "value",
        "format": "App Store 数字 Apple ID(apps.apple.com 链接里 id 后面那串数字),任意公开 App 都可以",
        "hint": "留空 = 用户关注列表里的第一个 App;不确知 ID 就留空,别猜",
        "examples": [
          "414478124",
          "389801252",
          "835599320"
        ]
      },
      "r1": {
        "kind": "auto",
        "format": "两位 App Store 地区码,大写,如 US / GB / JP / DE / CN",
        "hint": "四个地区各自独立,留空的按缺省补:海外 US/GB/JP/DE,国内 CN/US/JP/GB"
      },
      "r2": {
        "kind": "auto",
        "format": "两位 App Store 地区码,大写,如 US / GB / JP / DE / CN"
      },
      "r3": {
        "kind": "auto",
        "format": "两位 App Store 地区码,大写,如 US / GB / JP / DE / CN"
      },
      "r4": {
        "kind": "auto",
        "format": "两位 App Store 地区码,大写,如 US / GB / JP / DE / CN"
      }
    }
  }
}
