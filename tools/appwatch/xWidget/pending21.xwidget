{
 "_note": "2026-10-08 新增(card-design-system §8.1):与 insights 同一条流,零新增请求。",
 "version": 2,
 "title": "待回复评论 · 一行",
 "sub": "某个 App 还没回复的评论数和差评数",
 "i18n": {
  "en-US": {
   "title": "Reviews to reply (row)",
   "sub": "An app's unanswered reviews and low ratings"
  }
 },
 "layout": 21,
 "params": {
  "appId": ""
 },
 "events": {
  "onClick": "/reviews?appId=${appId}&country=",
  "onEdit": "/edit?w=asc&appId=${appId}",
  "_noteClick": "单对象组件点击带对象参数进详情页。`id=&n=` / `app=&n=` 两个空值键刻意写上,保证页面判空拿到的是空串而不是「键缺席 → ${} 原样透传」([[xpage-pitfalls]])。bundleId 为空 = 账号里按名字排第一个的 App,页面流用同一条规则解析,点进去看到的就是组件上那一个。"
 },
 "canvas": {
  "source": "@[file://rc/pending21.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/insights.df]",
    "params": {
     "appId": "${appId}"
    }
   }
  ],
  "refresh": {
   "interval": [
    "1800"
   ]
  }
 },
 "ai": {
  "shows": "某个 App 还没回复的评论数与差评数(一行);需接入 App Store Connect",
  "params": {
   "appId": {
    "kind": "account",
    "hint": "用户 App Store Connect 账号里某个 App 的 Apple ID;留空 = 账号里按名字排第一个的 App"
   }
  }
 }
}
