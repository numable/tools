)]"}}},{"op":"set","props":{"key":"CF","value":{"a":"$[floor::(calc::((153*${CY.m}+2)/5))]","b":"$[floor::(calc::(${CY.y}/4))]","c":"$[floor::(calc::(${CY.y}/100))]","d":"$[floor::(calc::(${CY.y}/400))]"}}},{"op":"set","props":{"key":"ld","value":"$[calc::(${LW.D}+${CF.a}+365*${CY.y}+${CF.b}-${CF.c}+${CF.d}-2472633)]"}},{"op":"set","props":{"key":"off","value":"$[calc::((${ld}-${fl})*86400000+${LW.h}*3600000+${LW.i}*60000-(${now}-${fl}*86400000))]"}},{"op":"set","props":{"key":"DAYS","value":[{"i":0,"d":"$[formatDate::(calc::((${Ld}-0)*86400000+43200000-(${off})),yyyy-MM-dd)]"}]}},{"op":"set","props":{"key":"nOk","value":0}},{"op":"set","props":{"key":"n403","value":0}},{"op":"set","props":{"key":"nBad","value":0}},{"op":"set","props":{"key":"nUnk","value":0}},{"op":"set","props":{"key":"n404","value":0}},{"op":"set","props":{"key":"ofs","value":0}},{"op":"set","props":{"key":"stop","value":0}},{"op":"set","props":{"key":"fxAny","value":"${ZM}"}},{"op":"set","props":{"key":"fxD","value":""}},{"op":"set","props":{"key":"vendor","value":"${v}"}},{"op":"set","props":{"key":"it","value":{"d":"${DAYS[0].d}"}}},{"op":"set","props":{"key":"q","value":[]}},{"op":"if","props":{"val":"$[if::(eq::(${csB},1),1,0)]"},"items":[{"id":"q","action":"request","params":{"url":"https://api.appstoreconnect.apple.com/v1/salesReports?filter%5Bfrequency%5D=DAILY&filter%5BreportType%5D=SALES&filter%5BreportSubType%5D=SUMMARY&filter%5BvendorNumber%5D=${vendor}&filter%5BreportDate%5D=${it.d}","method":"GET","formatType":"tsv","columns":["Units"],"header":{"Accept":"application/a-gzip"},"credential":"asc"}}]},{"op":"set","props":{"key":"_bq","value":"1"}},{"op":"set","props":{"key":"em","value":""}},{"action":"concurrent","items":[{"op":"set","props":{"key":"em","value":"${@q.errorMsg}"}}]},{"op":"set","props":{"key":"_cq","value":"1"}},{"op":"set","props":{"key":"code","value":"$[if::(gt::(length::(${q}),0),200,if::(matches::(${em},${SRX.a}),404,if::(matches::(${em},${SRX.b}),403,if::(matches::(${em},${SRX.c}),400,if::(matches::(${em},${SRX.d}),500,0)))))]"}},{"op":"set","props":{"key":"q","value":[]}},{"action":"resultFilter","params":{"keys":["code","useS","csB"]}}]}
