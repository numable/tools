{"_note":"经营组件的点击:没填供应商编号 → 设置页;填了 → 经营明细(带同一个对象)。⚠️ nav.open 的 numable:// 写包自己的 ULID,不写 self(桌面小组件回放那条路没有「当前包」上下文)。生成器 gen_asc.py。","version":1,"actions":[{"id":"csq","action":"credential.state","params":{"id":"asc"}},{"id":"v","action":"data.get","params":{"key":"vendor","default":""}},{"op":"set","props":{"key":"b","value":"${bid}"},"_note":"入参落地(勿删)。"},{"op":"set","props":{"key":"hk","value":"$[if::(eq::(${csq.state},bound),1,0)]"}},{"op":"set","props":{"key":"hv","value":"$[if::(gt::(length::(${v}),0),1,0)]"}},{"op":"set","props":{"key":"to","value":"$[if::(eq::(${hk},0),connect,if::(eq::(${hv},0),settings,sales))]"},"_note":"合并包:没绑密钥 → 接入页;绑了没填编号 → 设置;都有 → 经营明细。"},{"op":"if","props":{"val":"$[if::(eq::(${to},connect),1,0)]"},"items":[{"action":"nav.open","params":{"url":"numable://01KZD9PY65Y9341817EEV4VT31/page/connect"}}]},{"op":"if","props":{"val":"$[if::(eq::(${to},settings),1,0)]"},"items":[{"action":"nav.open","params":{"url":"numable://01KZD9PY65Y9341817EEV4VT31/page/settings"}}]},{"op":"if","props":{"val":"$[if::(eq::(${to},sales),1,0)]"},"items":[{"action":"nav.open","params":{"url":"numable://01KZD9PY65Y9341817EEV4VT31/page/sales?id=${b}"}}]}]}
