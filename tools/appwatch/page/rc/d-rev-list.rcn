{"_note":"评论分组卡(v42):一张卡装一组评论(10 条一组,g=组号),行间 inset 细分割线;详情页 g=0、lim=5、more=1 时底部再带一行「查看全部 N 条评论 ›」(整卡在 XPage 层可点)。行的 y/h/作者行偏移全由 reviews.df 算好(y=组内累计,ay=75/91),RCN forEach 里只做「${变量}pt」定位 —— 循环内 id 重复不能用 {c.b} 锚,坐标里的加法也一律先 op:set 算成裸变量。取代 v40 的「每条一张卡」:五张 10pt 间距的独立卡读不出「这是一组」。","rc":{"cells":[{"id":"bg","type":"layer","x":"0pt","y":"0pt","w":"{parent.w}","h":"{parent.h}","bgColor":"#FFFFFF|#15171A","cornerRadius":{"leftT":"14pt","leftB":"14pt","rightT":"14pt","rightB":"14pt"}},{"type":"op","action":"set","props":{"key":"_n","value":"$[findNotEmpty::(${rvN},0)]"}},{"type":"op","action":"set","props":{"key":"_g0","value":"$[calc::(findNotEmpty::(${g},0)*10)]"}},{"type":"op","action":"set","props":{"key":"_lim","value":"$[findNotEmpty::(${lim},30)]"}},{"type":"op","action":"forEach","props":{"items":"${rvList}","key":"_it","index":"_i"},"react":[{"type":"op","action":"set","props":{"key":"_k","value":"$[calc::(${_i}-${_g0})]"}},{"type":"op","action":"set","props":{"key":"_on","value":"$[if::(ge::(${_k},0),if::(lt::(${_k},10),if::(lt::(${_i},${_n}),if::(lt::(${_k},${_lim}),1,0),0),0),0)]"}},{"type":"op","action":"if","props":{"val":"$[eq::(${_on},1)]"},"react":[{"type":"op","action":"set","props":{"key":"_dm","value":"$[parseNumber::(subString::(${_it.d},0,2),0)]"}},{"type":"op","action":"set","props":{"key":"_dy","value":"$[parseNumber::(subString::(${_it.d},3,5),0)]"}},{"type":"op","action":"set","props":{"key":"_dme","value":"$[if::(eq::(${_dm},1),Jan,if::(eq::(${_dm},2),Feb,if::(eq::(${_dm},3),Mar,if::(eq::(${_dm},4),Apr,if::(eq::(${_dm},5),May,if::(eq::(${_dm},6),Jun,if::(eq::(${_dm},7),Jul,if::(eq::(${_dm},8),Aug,if::(eq::(${_dm},9),Sep,if::(eq::(${_dm},10),Oct,if::(eq::(${_dm},11),Nov,if::(eq::(${_dm},12),Dec,--))))))))))))]"}},{"type":"op","action":"set","props":{"key":"_dz","value":"${_dm}月${_dy}日"}},{"type":"op","action":"set","props":{"key":"_de","value":"${_dme} ${_dy}"}},{"type":"op","action":"set","props":{"key":"_dd","value":"$[if::(eq::(length::(${_it.d}),5),if::(startsWith::(${@app.language},zh),${_dz},${_de}),${_it.d})]"}},{"type":"op","action":"set","props":{"key":"_y","value":"$[findNotEmpty::(${_it.y},0)]"}},{"type":"op","action":"set","props":{"key":"_y1","value":"$[calc::(${_y}+14)]"}},{"type":"op","action":"set","props":{"key":"_y2","value":"$[calc::(${_y}+33)]"}},{"type":"op","action":"set","props":{"key":"_y3","value":"$[calc::(${_y}+53)]"}},{"type":"op","action":"set","props":{"key":"_y4","value":"$[calc::(${_y}+findNotEmpty::(${_it.ay},75))]"}},{"type":"op","action":"if","props":{"val":"$[ge::(${_k},1)]"},"react":[{"type":"layer","x":"16pt","y":"${_y}pt","w":"{parent.w}-32pt","h":"1pt","bgColor":"#EEF0F3|#22252B"}]},{"type":"txt","x":"16pt","y":"${_y1}pt","w":"110pt","h":"-1","text":"$[findNotEmpty::(${_it.st},☆☆☆☆☆)]","fontSize":"11pt","textColor":"#0A7AFF|#4DA0FF","maxLines":"1"},{"type":"txt","x":"{parent.w}-176pt","y":"${_y1}pt","w":"160pt","h":"-1","text":"v$[findNotEmpty::(${_it.v},--)] · $[findNotEmpty::(${_dd},--)]","fontSize":"9.5pt","alignmentH":"2","textColor":"#6B7280|#8E939B","maxLines":"1"},{"type":"txt","x":"16pt","y":"${_y2}pt","w":"{parent.w}-32pt","h":"-1","text":"$[findNotEmpty::(${_it.t},${@i18n.noTitle})]","fontSize":"12.5pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6","maxLines":"1"},{"type":"txt","x":"16pt","y":"${_y3}pt","w":"{parent.w}-32pt","h":"-1","text":"$[findNotEmpty::(${_it.c},${@i18n.noBody})]","fontSize":"11pt","lineSpacing":"3pt","textColor":"#4B5563|#B8BDC5","maxLines":"2"},{"type":"txt","x":"16pt","y":"${_y4}pt","w":"{parent.w}-32pt","h":"-1","text":"— $[findNotEmpty::(${_it.a},--)]","fontSize":"9.5pt","textColor":"#6B7280|#8E939B","maxLines":"1"}]}]},{"type":"op","action":"if","props":{"val":"$[eq::(findNotEmpty::(${more},0),1)]"},"react":[{"type":"layer","x":"16pt","y":"{parent.h}-44pt","w":"{parent.w}-32pt","h":"1pt","bgColor":"#EEF0F3|#22252B"},{"type":"txt","x":"0pt","y":"{parent.h}-44pt","w":"{parent.w}","h":"44pt","text":"${@i18n.more1} ${_n} ${@i18n.more2} ›","fontSize":"12pt","typeface":"System-Bold","alignmentH":"1","alignmentV":"1","textColor":"#0A7AFF|#4DA0FF","maxLines":"1"}]}],"i18n":{"zh-CN":{"noTitle":"(无标题)","noBody":"(无正文)","more1":"查看全部","more2":"条评论"},"en-US":{"noTitle":"(no title)","noBody":"(no text)","more1":"See all","more2":"reviews"}}}}
