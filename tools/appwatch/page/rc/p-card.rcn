{"_note":"商店卡 · 紧凑态(近两天没动静的 App):icon + 名 + 星串 + 评分数 + 版本 chip + 说明摘要,不带截图条。字段由 XPage forEach 逐槽传入。整卡可点进详情。","rc":{"cells":[{"id":"bg","type":"layer","x":"0pt","y":"0pt","w":"{parent.w}","h":"{parent.h}","bgColor":"#FFFFFF|#15171A","cornerRadius":{"leftT":"14pt","leftB":"14pt","rightT":"14pt","rightB":"14pt"}},{"id":"icon","type":"img","x":"14pt","y":"13pt","w":"36pt","h":"36pt","url":"${ic}","scaleType":"centerCrop","cornerRadius":{"leftT":"12pt","leftB":"12pt","rightT":"12pt","rightB":"12pt"},"bgColor":"#E7E9EE|#20232A"},{"id":"name","type":"txt","x":"60pt","y":"13pt","w":"{parent.w}-146pt","h":"-1","text":"$[findNotEmpty::(${n},--)]","fontSize":"13pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6","maxLines":"1"},{"id":"stars","type":"txt","x":"60pt","y":"33pt","w":"76pt","h":"-1","text":"$[findNotEmpty::(${st},☆☆☆☆☆)]","fontSize":"10.5pt","textColor":"#0A7AFF|#4DA0FF","maxLines":"1"},{"id":"meta","type":"txt","x":"138pt","y":"34pt","w":"{parent.w}-224pt","h":"-1","text":"$[findNotEmpty::(${r},--)] · $[findNotEmpty::(${cf},--)]","fontSize":"10pt","textColor":"#6B7280|#8E939B","maxLines":"1"},{"id":"verChip","type":"layer","x":"{parent.w}-78pt","y":"13pt","w":"64pt","h":"20pt","cornerRadius":{"leftT":"8pt","leftB":"8pt","rightT":"8pt","rightB":"8pt"},"bgColor":"#E7E9EE|#20232A"},{"id":"ver","type":"txt","x":"{parent.w}-78pt","y":"13pt","w":"64pt","h":"20pt","text":"v$[findNotEmpty::(${v},--)]","fontSize":"9.5pt","alignmentH":"1","alignmentV":"1","typeface":"System-Bold","textColor":"#6B7280|#8E939B","maxLines":"1"},{"type":"op","action":"if","props":{"val":"$[if::(eq::(${tk},1),if::(eq::(${du},1),1,0),0)]"},"react":[{"type":"txt","x":"{parent.w}-84pt","y":"39pt","w":"70pt","h":"-1","text":"${dl}","fontSize":"9.5pt","alignmentH":"1","typeface":"System-Bold","textColor":"#FF5C4D|#FF5C4D","maxLines":"1"}]},{"type":"op","action":"if","props":{"val":"$[if::(eq::(${tk},1),if::(eq::(${du},1),0,1),0)]"},"react":[{"type":"txt","x":"{parent.w}-84pt","y":"39pt","w":"70pt","h":"-1","text":"${dl}","fontSize":"9.5pt","alignmentH":"1","typeface":"System-Bold","textColor":"#1FC77D|#1FC77D","maxLines":"1"}]},{"type":"op","action":"if","props":{"val":"$[if::(eq::(${tk},2),if::(eq::(${du},1),1,0),0)]"},"react":[{"type":"txt","x":"{parent.w}-84pt","y":"39pt","w":"70pt","h":"-1","text":"${dl}${@i18n.perDay}","fontSize":"9.5pt","alignmentH":"1","typeface":"System-Bold","textColor":"#FF5C4D|#FF5C4D","maxLines":"1"}]},{"type":"op","action":"if","props":{"val":"$[if::(eq::(${tk},2),if::(eq::(${du},1),0,1),0)]"},"react":[{"type":"txt","x":"{parent.w}-84pt","y":"39pt","w":"70pt","h":"-1","text":"${dl}${@i18n.perDay}","fontSize":"9.5pt","alignmentH":"1","typeface":"System-Bold","textColor":"#1FC77D|#1FC77D","maxLines":"1"}]},{"type":"op","action":"if","props":{"val":"$[if::(eq::(findNotEmpty::(${tk},0),0),1,0)]"},"react":[{"type":"op","action":"set","props":{"key":"_dm","value":"$[parseNumber::(subString::(${d},0,2),0)]"}},{"type":"op","action":"set","props":{"key":"_dy","value":"$[parseNumber::(subString::(${d},3,5),0)]"}},{"type":"op","action":"set","props":{"key":"_dme","value":"$[if::(eq::(${_dm},1),Jan,if::(eq::(${_dm},2),Feb,if::(eq::(${_dm},3),Mar,if::(eq::(${_dm},4),Apr,if::(eq::(${_dm},5),May,if::(eq::(${_dm},6),Jun,if::(eq::(${_dm},7),Jul,if::(eq::(${_dm},8),Aug,if::(eq::(${_dm},9),Sep,if::(eq::(${_dm},10),Oct,if::(eq::(${_dm},11),Nov,if::(eq::(${_dm},12),Dec,--))))))))))))]"}},{"type":"op","action":"set","props":{"key":"_dz","value":"${_dm}月${_dy}日"}},{"type":"op","action":"set","props":{"key":"_de","value":"${_dme} ${_dy}"}},{"type":"op","action":"set","props":{"key":"_dd","value":"$[if::(eq::(length::(${d}),5),if::(startsWith::(${@app.language},zh),${_dz},${_de}),${d})]"}},{"type":"txt","x":"{parent.w}-84pt","y":"39pt","w":"70pt","h":"-1","text":"$[findNotEmpty::(${_dd},--)]","fontSize":"9.5pt","alignmentH":"1","typeface":"System","textColor":"#6B7280|#8E939B","maxLines":"1"}]},{"type":"op","action":"if","props":{"val":"$[eq::(${dy},0)]"},"react":[{"type":"txt","x":"14pt","y":"60pt","w":"{parent.w}-28pt","h":"-1","text":"${@i18n.updToday} · $[findNotEmpty::(${nt},${@i18n.noNotes})]","fontSize":"10.5pt","textColor":"#6B7280|#8E939B","maxLines":"1"}]},{"type":"op","action":"if","props":{"val":"$[eq::(${dy},1)]"},"react":[{"type":"txt","x":"14pt","y":"60pt","w":"{parent.w}-28pt","h":"-1","text":"${@i18n.updYday} · $[findNotEmpty::(${nt},${@i18n.noNotes})]","fontSize":"10.5pt","textColor":"#6B7280|#8E939B","maxLines":"1"}]},{"type":"op","action":"if","props":{"val":"$[ge::(${dy},2)]"},"react":[{"type":"txt","x":"14pt","y":"60pt","w":"{parent.w}-28pt","h":"-1","text":"${dy} ${@i18n.updDaysAgo} · $[findNotEmpty::(${nt},${@i18n.noNotes})]","fontSize":"10.5pt","textColor":"#6B7280|#8E939B","maxLines":"1"}]},{"type":"op","action":"if","props":{"val":"$[if::(ge::(${dy},0),0,1)]"},"react":[{"type":"txt","x":"14pt","y":"60pt","w":"{parent.w}-28pt","h":"-1","text":"$[findNotEmpty::(${nt},${@i18n.noNotes})]","fontSize":"10.5pt","textColor":"#6B7280|#8E939B","maxLines":"1"}]}],"i18n":{"zh-CN":{"noNotes":"这一版没有提供更新说明","perDay":"/日","updToday":"今天更新","updYday":"昨天更新","updDaysAgo":"天前更新"},"en-US":{"noNotes":"No release notes for this version","perDay":"/day","updToday":"Updated today","updYday":"Updated yesterday","updDaysAgo":"d ago, updated"}}}}
