{"_note":"分组卡上半:左侧段名(13pt 次级色,按 `k` 取:todo / apps / watch)+ 右侧附注(apps:App 数;watch:「管理」链接色)+ 上圆角帽(恒贴底)。`k` 为空时只画帽(底部操作那一组)。画布高:有段名 44pt / 只有帽 16pt。","rc":{"cells":[{"type":"op","action":"if","props":{"val":"$[if::(eq::(${k},todo),1,0)]"},"react":[{"type":"txt","x":"4pt","y":"4pt","w":"{parent.w}-120pt","h":"-1","maxLines":"1","text":"${@i18n.sTodo}","fontSize":"13pt","textColor":"#6B7280|#8E939B","typeface":"System-Bold"}]},{"type":"op","action":"if","props":{"val":"$[if::(eq::(${k},apps),1,0)]"},"react":[{"type":"txt","x":"4pt","y":"4pt","w":"{parent.w}-120pt","h":"-1","maxLines":"1","text":"${@i18n.sApps}","fontSize":"13pt","textColor":"#6B7280|#8E939B","typeface":"System-Bold"}]},{"type":"op","action":"if","props":{"val":"$[if::(eq::(${k},watch),1,0)]"},"react":[{"type":"txt","x":"4pt","y":"4pt","w":"{parent.w}-120pt","h":"-1","maxLines":"1","text":"${@i18n.sWatch}","fontSize":"13pt","textColor":"#6B7280|#8E939B","typeface":"System-Bold"}]},{"type":"op","action":"if","props":{"val":"$[if::(eq::(${k},apps),1,0)]"},"react":[{"type":"txt","x":"{parent.w}-124pt","y":"4pt","w":"120pt","h":"-1","maxLines":"1","text":"$[findNotEmpty::(${n},0)]${@i18n.uApps}","fontSize":"13pt","textColor":"#6B7280|#8E939B","alignmentH":"2"}]},{"type":"op","action":"if","props":{"val":"$[if::(eq::(${k},watch),1,0)]"},"react":[{"type":"txt","x":"{parent.w}-124pt","y":"4pt","w":"120pt","h":"-1","maxLines":"1","text":"${@i18n.manage}","fontSize":"13pt","textColor":"#0A7AFF|#4DA0FF","alignmentH":"2"}]},{"type":"layer","x":"0pt","y":"{parent.h}-16pt","w":"{parent.w}","h":"16pt","bgColor":"#FFFFFF|#15171A","cornerRadius":{"leftT":"16pt","rightT":"16pt","leftB":"0pt","rightB":"0pt"}}],"i18n":{"zh-CN":{"sTodo":"需要处理","sApps":"我的 App","sWatch":"关注","uApps":" 个","manage":"管理"},"en-US":{"sTodo":"Needs attention","sApps":"My apps","sWatch":"Watching","uApps":" apps","manage":"Manage"}}}}
