{"_note":"「关注」分组卡里的一行(设计稿 A,取代商店截图大卡与「今日动态」):图标 + 名称 + 「v版本 · N 天前更新」,右侧评分 + 变化(tk=1 评分升降 / tk=2 每日新增评分数 / 否则评分数)。params 同 p-card + f。画布高 64pt。","rc":{"cells":[{"type":"layer","x":"0pt","y":"0pt","w":"{parent.w}","h":"{parent.h}","bgColor":"#FFFFFF|#15171A"},{"type":"op","action":"if","props":{"val":"$[if::(eq::(findNotEmpty::(${f},0),1),0,1)]"},"react":[{"type":"layer","x":"68pt","y":"0pt","w":"{parent.w}-68pt","h":"1pt","bgColor":"#E9EBEF|#262A31"}]},{"type":"op","action":"if","props":{"val":"$[if::(gt::(length::(${ic}),0),0,1)]"},"react":[{"type":"txt","x":"16pt","y":"12pt","w":"40pt","h":"40pt","alignmentH":"1","alignmentV":"1","maxLines":"1","text":"$[subString::(${n},0,1)]","fontSize":"16pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6","bgColor":"#E7E9EE|#20232A","cornerRadius":{"leftT":"10pt","rightT":"10pt","leftB":"10pt","rightB":"10pt"}}]},{"type":"op","action":"if","props":{"val":"$[if::(gt::(length::(${ic}),0),1,0)]"},"react":[{"type":"img","x":"16pt","y":"12pt","w":"40pt","h":"40pt","url":"${ic}","scaleType":"centerCrop","cornerRadius":{"leftT":"10pt","rightT":"10pt","leftB":"10pt","rightB":"10pt"},"bgColor":"#E7E9EE|#20232A","clip":"1"}]},{"type":"txt","x":"68pt","y":"11pt","w":"{parent.w}-180pt","h":"-1","maxLines":"1","text":"$[findNotEmpty::(${n},--)]","fontSize":"15pt","textColor":"#0E1116|#F3F4F6","typeface":"System-Bold"},{"type":"op","action":"if","props":{"val":"$[eq::(${dy},0)]"},"react":[{"type":"txt","x":"68pt","y":"35pt","w":"{parent.w}-180pt","h":"-1","maxLines":"1","text":"v$[findNotEmpty::(${v},--)] · ${@i18n.updToday}","fontSize":"12pt","textColor":"#6B7280|#8E939B"}]},{"type":"op","action":"if","props":{"val":"$[eq::(${dy},1)]"},"react":[{"type":"txt","x":"68pt","y":"35pt","w":"{parent.w}-180pt","h":"-1","maxLines":"1","text":"v$[findNotEmpty::(${v},--)] · ${@i18n.updYday}","fontSize":"12pt","textColor":"#6B7280|#8E939B"}]},{"type":"op","action":"if","props":{"val":"$[ge::(${dy},2)]"},"react":[{"type":"txt","x":"68pt","y":"35pt","w":"{parent.w}-180pt","h":"-1","maxLines":"1","text":"v$[findNotEmpty::(${v},--)] · ${dy} ${@i18n.updDaysAgo}","fontSize":"12pt","textColor":"#6B7280|#8E939B"}]},{"type":"op","action":"if","props":{"val":"$[if::(ge::(${dy},0),0,1)]"},"react":[{"type":"txt","x":"68pt","y":"35pt","w":"{parent.w}-180pt","h":"-1","maxLines":"1","text":"v$[findNotEmpty::(${v},--)]","fontSize":"12pt","textColor":"#6B7280|#8E939B"}]},{"type":"txt","x":"{parent.w}-112pt","y":"12pt","w":"80pt","h":"-1","maxLines":"1","text":"★ $[findNotEmpty::(${r},--)]","fontSize":"15pt","textColor":"#0E1116|#F3F4F6","typeface":"System-Bold","alignmentH":"2"},{"type":"op","action":"if","props":{"val":"$[if::(eq::(${tk},1),if::(eq::(${du},1),1,0),0)]"},"react":[{"type":"txt","x":"{parent.w}-112pt","y":"35pt","w":"80pt","h":"-1","maxLines":"1","text":"${dl}","fontSize":"11pt","textColor":"#FF5C4D|#FF5C4D","typeface":"System-Bold","alignmentH":"2"}]},{"type":"op","action":"if","props":{"val":"$[if::(eq::(${tk},1),if::(eq::(${du},1),0,1),0)]"},"react":[{"type":"txt","x":"{parent.w}-112pt","y":"35pt","w":"80pt","h":"-1","maxLines":"1","text":"${dl}","fontSize":"11pt","textColor":"#1FC77D|#1FC77D","typeface":"System-Bold","alignmentH":"2"}]},{"type":"op","action":"if","props":{"val":"$[if::(eq::(${tk},2),1,0)]"},"react":[{"type":"txt","x":"{parent.w}-112pt","y":"35pt","w":"80pt","h":"-1","maxLines":"1","text":"${dl}${@i18n.perDay}","fontSize":"11pt","textColor":"#6B7280|#8E939B","alignmentH":"2"}]},{"type":"op","action":"if","props":{"val":"$[if::(eq::(findNotEmpty::(${tk},0),0),1,0)]"},"react":[{"type":"txt","x":"{parent.w}-112pt","y":"35pt","w":"80pt","h":"-1","maxLines":"1","text":"$[findNotEmpty::(${cf},--)]","fontSize":"11pt","textColor":"#6B7280|#8E939B","alignmentH":"2"}]},{"type":"txt","x":"{parent.w}-26pt","y":"20pt","w":"14pt","h":"-1","maxLines":"1","text":"›","fontSize":"18pt","textColor":"#C3C7CE|#4B5058"}],"i18n":{"zh-CN":{"perDay":"/日","updToday":"今天更新","updYday":"昨天更新","updDaysAgo":"天前更新"},"en-US":{"perDay":"/day","updToday":"Updated today","updYday":"Updated yesterday","updDaysAgo":"days ago"}}}}
