{"_note":"详情页页头：名称独占整行空间，评分移入概览；长名称最多两行。","rc":{"cells":[{"type":"layer","x":"0pt","y":"0pt","w":"{parent.w}","h":"{parent.h}","bgColor":"#FFFFFF|#15171A","cornerRadius":{"leftT":"16pt","rightT":"16pt","leftB":"16pt","rightB":"16pt"}},{"type":"layer","x":"16pt","y":"18pt","w":"58pt","h":"58pt","bgColor":"#E7E9EE|#20232A","cornerRadius":{"leftT":"14pt","rightT":"14pt","leftB":"14pt","rightB":"14pt"}},{"type":"txt","x":"16pt","y":"18pt","w":"58pt","h":"58pt","maxLines":"1","text":"$[subString::(findNotEmpty::(${name},${nm},?),0,1)]","fontSize":"22pt","textColor":"#0E1116|#F3F4F6","typeface":"System-Bold","alignmentH":"1","alignmentV":"1"},{"type":"op","action":"if","props":{"val":"$[gt::(length::(${icon}),0)]"},"react":[{"id":"icon","type":"img","x":"16pt","y":"18pt","w":"58pt","h":"58pt","url":"${icon}","scaleType":"centerCrop","cornerRadius":{"leftT":"14pt","rightT":"14pt","leftB":"14pt","rightB":"14pt"}}]},{"type":"txt","x":"88pt","y":"16pt","w":"{parent.w}-104pt","h":"-1","maxLines":"2","text":"$[findNotEmpty::(${name},${nm},${@i18n.unavailable})]","fontSize":"19pt","textColor":"#0E1116|#F3F4F6","typeface":"System-Bold"},{"type":"txt","x":"88pt","y":"70pt","w":"{parent.w}-104pt","h":"-1","maxLines":"1","text":"$[findNotEmpty::(${seller},${@i18n.retry})]","fontSize":"11pt","textColor":"#6B7280|#8E939B"},{"type":"layer","x":"16pt","y":"96pt","w":"{parent.w}-32pt","h":"1pt","bgColor":"#E9EBEF|#262A31"},{"type":"txt","x":"16pt","y":"110pt","w":"{parent.w}-100pt","h":"-1","maxLines":"1","text":"$[toUpperCase::(${country})] · $[findNotEmpty::(${genre},App Store)]","fontSize":"11pt","textColor":"#6B7280|#8E939B"},{"type":"txt","x":"{parent.w}-100pt","y":"110pt","w":"84pt","h":"-1","maxLines":"1","text":"$[findNotEmpty::(${at},--)]","fontSize":"11pt","textColor":"#6B7280|#8E939B","alignmentH":"2"}],"i18n":{"zh-CN":{"unavailable":"暂时查不到商店资料","retry":"下拉刷新，或返回选择其他 App"},"en-US":{"unavailable":"Store details unavailable","retry":"Pull to retry or choose another app"}}}}
