{"_note":"今日动态行,两型(k 由 XPage 传):k=1 发版(蓝点,「X 发布 vY / 更新于 d」);k=2 评分变动(琥珀点,「X 评分变动 / 4.02 → 3.94 · 今日」)。整行可点进详情。型别码用数字 —— eq 是数字化比较。","rc":{"cells":[{"id":"bg","type":"layer","x":"0pt","y":"0pt","w":"{parent.w}","h":"{parent.h}","bgColor":"#FFFFFF|#15171A","cornerRadius":{"leftT":"14pt","leftB":"14pt","rightT":"14pt","rightB":"14pt"}},{"type":"op","action":"if","props":{"val":"$[eq::(${k},1)]"},"react":[{"type":"op","action":"set","props":{"key":"_dm","value":"$[parseNumber::(subString::(${d},0,2),0)]"}},{"type":"op","action":"set","props":{"key":"_dy","value":"$[parseNumber::(subString::(${d},3,5),0)]"}},{"type":"op","action":"set","props":{"key":"_dme","value":"$[if::(eq::(${_dm},1),Jan,if::(eq::(${_dm},2),Feb,if::(eq::(${_dm},3),Mar,if::(eq::(${_dm},4),Apr,if::(eq::(${_dm},5),May,if::(eq::(${_dm},6),Jun,if::(eq::(${_dm},7),Jul,if::(eq::(${_dm},8),Aug,if::(eq::(${_dm},9),Sep,if::(eq::(${_dm},10),Oct,if::(eq::(${_dm},11),Nov,if::(eq::(${_dm},12),Dec,--))))))))))))]"}},{"type":"op","action":"set","props":{"key":"_dz","value":"${_dm}月${_dy}日"}},{"type":"op","action":"set","props":{"key":"_de","value":"${_dme} ${_dy}"}},{"type":"op","action":"set","props":{"key":"_dd","value":"$[if::(eq::(length::(${d}),5),if::(startsWith::(${@app.language},zh),${_dz},${_de}),${d})]"}},{"id":"dotA","type":"layer","x":"14pt","y":"{l1a.y}+({l1a.h}-7pt)/2","w":"7pt","h":"7pt","cornerRadius":{"leftT":"3.5pt","leftB":"3.5pt","rightT":"3.5pt","rightB":"3.5pt"},"bgColor":"#0A7AFF|#4DA0FF"},{"id":"l1a","type":"txt","x":"30pt","y":"8pt","w":"{parent.w}-120pt","h":"-1","text":"$[findNotEmpty::(${n},--)] ${@i18n.released} v$[findNotEmpty::(${v},--)]","fontSize":"12pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6","maxLines":"1"},{"id":"l2a","type":"txt","x":"30pt","y":"26pt","w":"{parent.w}-120pt","h":"-1","text":"${@i18n.updated} $[findNotEmpty::(${_dd},--)]","fontSize":"10pt","textColor":"#6B7280|#8E939B","maxLines":"1"}]},{"type":"op","action":"if","props":{"val":"$[eq::(${k},2)]"},"react":[{"id":"dotB","type":"layer","x":"14pt","y":"{l1b.y}+({l1b.h}-7pt)/2","w":"7pt","h":"7pt","cornerRadius":{"leftT":"3.5pt","leftB":"3.5pt","rightT":"3.5pt","rightB":"3.5pt"},"bgColor":"#B45309|#F2B65C"},{"id":"l1b","type":"txt","x":"30pt","y":"8pt","w":"{parent.w}-120pt","h":"-1","text":"$[findNotEmpty::(${n},--)] ${@i18n.rateChg}","fontSize":"12pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6","maxLines":"1"},{"id":"l2b","type":"txt","x":"30pt","y":"26pt","w":"{parent.w}-120pt","h":"-1","text":"$[findNotEmpty::(${fr},--)] → $[findNotEmpty::(${to},--)] · ${@i18n.todayW}","fontSize":"10pt","textColor":"#6B7280|#8E939B","maxLines":"1"}]},{"id":"arrow","type":"txt","x":"{parent.w}-24pt","y":"12pt","w":"14pt","h":"-1","text":"›","fontSize":"16pt","textColor":"#C6C7CC|#5A5C63","maxLines":"1"}],"i18n":{"zh-CN":{"released":"发布","updated":"更新于","rateChg":"评分变动","todayW":"今日"},"en-US":{"released":"released","updated":"updated","rateChg":"rating moved","todayW":"today"}}}}
