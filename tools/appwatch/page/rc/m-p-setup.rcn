{"rc":{"cells":[{"id":"ic","type":"img","x":"16pt","y":"14pt","w":"30pt","h":"30pt","url":"@[file://page/assets/setup-key.$[if::(eq::(${theme},dark),d,l)].uri]"},{"id":"t","type":"txt","x":"16pt","y":"{ic.b}+12pt","w":"{parent.w}-32pt","h":"-1","maxLines":"2","text":"${@i18n.setupT}","fontSize":"17pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6"},{"id":"lead","type":"txt","x":"16pt","y":"{t.b}+8pt","w":"{parent.w}-32pt","h":"-1","maxLines":"3","text":"${@i18n.setupS}","fontSize":"12.5pt","textColor":"#6B7280|#8E939B"},{"id":"n1","type":"txt","x":"16pt","y":"{lead.b}+20pt","w":"20pt","h":"20pt","alignmentH":"1","alignmentV":"1","maxLines":"1","text":"1","fontSize":"11.5pt","typeface":"System-Bold","textColor":"#FFFFFF|#0B0C0E","bgColor":"#0A7AFF|#4DA0FF","cornerRadius":{"leftT":"10pt","leftB":"10pt","rightT":"10pt","rightB":"10pt"}},{"id":"st1","type":"txt","x":"{n1.r}+10pt","y":"{n1.y}+1pt","w":"{parent.w}-{n1.r}-26pt","h":"-1","maxLines":"2","text":"${@i18n.s1t}","fontSize":"13pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6"},{"id":"sd1","type":"txt","x":"{st1.x}","y":"{st1.b}+3pt","w":"{st1.w}","h":"-1","maxLines":"3","text":"${@i18n.s1d}","fontSize":"12pt","textColor":"#6B7280|#8E939B"},{"id":"n2","type":"txt","x":"16pt","y":"{sd1.b}+20pt","w":"20pt","h":"20pt","alignmentH":"1","alignmentV":"1","maxLines":"1","text":"2","fontSize":"11.5pt","typeface":"System-Bold","textColor":"#FFFFFF|#0B0C0E","bgColor":"#0A7AFF|#4DA0FF","cornerRadius":{"leftT":"10pt","leftB":"10pt","rightT":"10pt","rightB":"10pt"}},{"id":"st2","type":"txt","x":"{n2.r}+10pt","y":"{n2.y}+1pt","w":"{parent.w}-{n2.r}-26pt","h":"-1","maxLines":"2","text":"${@i18n.s2t}","fontSize":"13pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6"},{"id":"sd2","type":"txt","x":"{st2.x}","y":"{st2.b}+3pt","w":"{st2.w}","h":"-1","maxLines":"3","text":"${@i18n.s2d}","fontSize":"12pt","textColor":"#6B7280|#8E939B"},{"id":"nt","type":"txt","x":"16pt","y":"{sd2.b}+22pt","w":"{parent.w}-32pt","h":"-1","maxLines":"4","text":"${@i18n.setupN}","fontSize":"11.5pt","textColor":"#9AA0A6|#8E939B"},{"id":"ln1","type":"layer","x":"{n1.x}+9.25pt","y":"{n1.b}+4pt","w":"1.5pt","h":"{n2.y}-{n1.b}-8pt","bgColor":"#E4E7EC|#262A31"}],"i18n":{"zh-CN":{"setupT":"还没有配置 App Store Connect 密钥","setupS":"接入后，你自己的 App 会多出下载、收益、审核进度、性能和完整评论。别人的 App 不受影响。","s1t":"生成一个 API 密钥","s1d":"App Store Connect › 用户和访问 › 集成 › App Store Connect API，新建密钥。记下 Issuer ID 和 Key ID，并下载 .p8 文件——它只能下载一次。","s2t":"把三样填进凭证面板","s2d":"点下面的按钮进「我的 › 凭证」，填 Issuer ID、Key ID 和 .p8 私钥内容。","setupN":"建议用 Admin 角色生成，一把就能看到下载收益和构建。只读取数据，不会提交或发布任何东西。私钥默认只存在这台设备上，不进备份。"},"en-US":{"setupT":"No App Store Connect key yet","setupS":"Once connected, your own apps gain downloads, proceeds, review status, performance and full reviews. Other apps are unaffected.","s1t":"Generate an API key","s1d":"Users and Access › Integrations › App Store Connect API › create a key. Note the Issuer ID and Key ID, then download the .p8 — it downloads only once.","s2t":"Enter all three in the credentials panel","s2d":"Tap below to open Settings › Credentials, then fill in all three.","setupN":"An Admin key sees everything, sales and builds included. It only reads, never submits or publishes. The private key stays on this device by default and never goes into backups."}}}}
