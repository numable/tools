{"_note":"`xJob/rival-release.xjob` 的判定段(合并包 §7 #4,2026-09-26 拍板「做」):关注的 App 发了新版本就告诉你。本文件由 tools/infosource/gen_appwatch.py 生成,改生成器别改这里(设计 doc/appstore-infosources-v2.md §8)。","version":1,"actions":[{"op":"set","props":{"key":"LL","value":"${list}"},"_note":"入参先落地:方法参数里看不见 flow 入参。"},{"op":"set","props":{"key":"MM","value":"${MF}"}},{"op":"set","props":{"key":"totIn","value":"$[findNotEmpty::(${total},0)]"}},{"id":"prevRaw","action":"data.get","params":{"key":"aw.rr.last","default":""}},{"op":"set","props":{"key":"_b0","value":"1"},"_note":"屏障(勿删)。"},{"op":"set","props":{"key":"prev","value":"${prevRaw}"}},{"op":"set","props":{"key":"hasPrev","value":"$[if::(eq::(findNotEmpty::(${prev},__none__),__none__),0,1)]"}},{"op":"set","props":{"key":"g0","value":"$[if::(lt::(0,${totIn}),if::(eq::(findNotEmpty::(index::(${MM},0),0),1),,if::(gt::(length::(${LL[0].v}),0),connect::(~,${LL[0].id},:,${LL[0].v},~),)),)]"}},{"op":"set","props":{"key":"w0","value":"$[if::(eq::(${hasPrev},1),if::(gt::(length::(${g0}),0),if::(contains::(${prev},${g0}),0,1),0),0)]"}},{"op":"set","props":{"key":"g1","value":"$[if::(lt::(1,${totIn}),if::(eq::(findNotEmpty::(index::(${MM},1),0),1),,if::(gt::(length::(${LL[1].v}),0),connect::(~,${LL[1].id},:,${LL[1].v},~),)),)]"}},{"op":"set","props":{"key":"w1","value":"$[if::(eq::(${hasPrev},1),if::(gt::(length::(${g1}),0),if::(contains::(${prev},${g1}),0,1),0),0)]"}},{"op":"set","props":{"key":"g2","value":"$[if::(lt::(2,${totIn}),if::(eq::(findNotEmpty::(index::(${MM},2),0),1),,if::(gt::(length::(${LL[2].v}),0),connect::(~,${LL[2].id},:,${LL[2].v},~),)),)]"}},{"op":"set","props":{"key":"w2","value":"$[if::(eq::(${hasPrev},1),if::(gt::(length::(${g2}),0),if::(contains::(${prev},${g2}),0,1),0),0)]"}},{"op":"set","props":{"key":"g3","value":"$[if::(lt::(3,${totIn}),if::(eq::(findNotEmpty::(index::(${MM},3),0),1),,if::(gt::(length::(${LL[3].v}),0),connect::(~,${LL[3].id},:,${LL[3].v},~),)),)]"}},{"op":"set","props":{"key":"w3","value":"$[if::(eq::(${hasPrev},1),if::(gt::(length::(${g3}),0),if::(contains::(${prev},${g3}),0,1),0),0)]"}},{"op":"set","props":{"key":"g4","value":"$[if::(lt::(4,${totIn}),if::(eq::(findNotEmpty::(index::(${MM},4),0),1),,if::(gt::(length::(${LL[4].v}),0),connect::(~,${LL[4].id},:,${LL[4].v},~),)),)]"}},{"op":"set","props":{"key":"w4","value":"$[if::(eq::(${hasPrev},1),if::(gt::(length::(${g4}),0),if::(contains::(${prev},${g4}),0,1),0),0)]"}},{"op":"set","props":{"key":"g5","value":"$[if::(lt::(5,${totIn}),if::(eq::(findNotEmpty::(index::(${MM},5),0),1),,if::(gt::(length::(${LL[5].v}),0),connect::(~,${LL[5].id},:,${LL[5].v},~),)),)]"}},{"op":"set","props":{"key":"w5","value":"$[if::(eq::(${hasPrev},1),if::(gt::(length::(${g5}),0),if::(contains::(${prev},${g5}),0,1),0),0)]"}},{"op":"set","props":{"key":"cur","value":"#${g0}${g1}${g2}${g3}${g4}${g5}"},"_note":"本轮签名串(# 前缀保证非空,「此刻一个都没有」也要记成基线)。"},{"op":"set","props":{"key":"nNew","value":"$[round::(calc::(${w0}+${w1}+${w2}+${w3}+${w4}+${w5}),0)]"}},{"op":"set","props":{"key":"hit","value":"$[if::(gt::(${nNew},0),1,0)]"}},{"op":"set","props":{"key":"fi","value":"$[findNotEmpty::(if::(eq::(${w0},1),0,),if::(eq::(${w1},1),1,),if::(eq::(${w2},1),2,),if::(eq::(${w3},1),3,),if::(eq::(${w4},1),4,),if::(eq::(${w5},1),5,))]"}},{"op":"set","props":{"key":"WN","value":["${LL[0].n}","${LL[1].n}","${LL[2].n}","${LL[3].n}","${LL[4].n}","${LL[5].n}"]},"_note":"App 名是自由文本:放进数组再按下标取,不进方法参数。"},{"op":"set","props":{"key":"WV","value":["${LL[0].v}","${LL[1].v}","${LL[2].v}","${LL[3].v}","${LL[4].v}","${LL[5].v}"]}},{"op":"set","props":{"key":"WT","value":["${LL[0].nt}","${LL[1].nt}","${LL[2].nt}","${LL[3].nt}","${LL[4].nt}","${LL[5].nt}"]}},{"op":"set","props":{"key":"_nb","value":"1"}},{"op":"set","props":{"key":"app","value":"$[index::(${WN},${fi})]"}},{"op":"set","props":{"key":"ver","value":"$[index::(${WV},${fi})]"}},{"op":"set","props":{"key":"nt","value":"$[index::(${WT},${fi})]"}},{"op":"set","props":{"key":"lang","value":"$[findNotEmpty::(${@app.language},en)]"}},{"op":"set","props":{"key":"zh","value":"$[if::(startsWith::(${lang},zh),1,0)]"}},{"op":"set","props":{"key":"more","value":"$[if::(gt::(${nNew},1),calc::(${nNew}-1),)]"}},{"op":"set","props":{"key":"evm","value":""}},{"op":"if","props":{"val":"$[if::(gt::(${nNew},1),if::(eq::(${zh},1),1,0),0)]"},"items":[{"op":"set","props":{"key":"evm","value":"另有 ${more} 个关注的 App 也发了新版本。"}}]},{"op":"if","props":{"val":"$[if::(gt::(${nNew},1),if::(eq::(${zh},1),0,1),0)]"},"items":[{"op":"set","props":{"key":"evm","value":"${more} more apps you watch released too."}}]},{"op":"if","props":{"val":"$[if::(ge::(${totIn},1),1,0)]"},"items":[{"action":"data.set","params":{"key":"aw.rr.last","value":"${cur}"}}],"_note":"基线只在关注列表取到了东西时写:取数失败那一轮 list 全空,写进去下一轮会把所有现状都当成新版本。"},{"action":"resultFilter","params":{"keys":["hit","app","ver","nt","evm","nNew"]}}]}
