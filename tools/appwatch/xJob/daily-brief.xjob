{
 "_note_gen": "tools/infosource/gen_appstore.py",
 "_note": "动态提醒(§7):每天日报出来后告诉你那天的下载与预估收益。按日期去重,首次运行只建基线。\n取数段 xJob/flow/brief.df(账号合计,最近两天,摘要与组件共用盘上键 → 平时 0–1 个请求);判定段 xJob/flow/daily-brief.df。一小时评估一次:日报在太平洋时间早上出,几点出不固定。\n日期写具体日子(「9月24日」),金额写「预估」(§4.5 / §10)。",
 "version": 1,
 "id": "daily-brief",
 "title": "经营日报提醒",
 "sub": "每天日报出来后告诉你下载和预估收益",
 "i18n": {
  "en-US": {
   "title": "Daily sales alert",
   "sub": "Tells you the day's downloads and estimated proceeds once the report is out",
   "message": {
    "title": "${adl}: ${bdN} downloads · est. proceeds ${brv}",
    "body": "Tap for the details"
   }
  }
 },
 "events": {
  "onClick": "/sales"
 },
 "task": {
  "depends": [
   {
    "flow": "@[file://xJob/flow/brief.df]"
   }
  ],
  "then": {
   "flow": "@[file://xJob/flow/daily-brief.df]",
   "params": {
    "bok": "${bok}",
    "ad": "${ad}"
   }
  },
  "refresh": {
   "interval": [
    "3600"
   ]
  }
 },
 "alert": {
  "level": "quiet",
  "message": {
   "title": "${adl} 下载 ${bdN} · 预估收益 ${brv}",
   "body": "点开看经营明细"
  }
 }
}
