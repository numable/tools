{
  "_note_gen": "tools/infosource/gen_appstore.py",
  "_note": "动态提醒(appstore-merged §7 #4):关注的 App 发了新版本。取数段复用 watchlist.df(公开数据,不要密钥),判定段 xJob/flow/rival-release.df 按 (App, 版本) 去重、首次运行只建基线。一小时评估一次。",
  "version": 1,
  "id": "rival-release",
  "title": "关注的 App 发新版",
  "sub": "你关注的 App 发了新版本时告诉你",
  "i18n": {
    "en-US": {
      "title": "Watched app update",
      "sub": "Tells you when an app you watch ships a new version",
      "message": {
        "title": "${app} released ${ver}",
        "body": "${nt} ${evm}"
      }
    }
  },
  "events": {
    "onClick": "/"
  },
  "task": {
    "depends": [
      {
        "flow": "@[file://xWidget/flow/watchlist.df]"
      }
    ],
    "then": {
      "flow": "@[file://xJob/flow/rival-release.df]",
      "params": {
        "list": "${list}",
        "total": "${total}",
        "MF": "${MF}"
      }
    },
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "alert": {
    "level": "quiet",
    "message": {
      "title": "${app} 发布了 ${ver}",
      "body": "${nt} ${evm}"
    }
  }
}
