    {
      "op": "set",
      "props": {
        "key": "_b",
        "value": "1"
      },
      "_note": "请求屏障(勿删)。"
    },
    {
      "op": "set",
      "props": {
        "key": "pid",
        "value": "${sm.page.id}"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${pid}),0),0,1)]"
      },
      "items": [
        {
          "action": "error",
          "params": {
            "errorMsg": "summary unavailable"
          }
        }
      ],
      "_note": "主干 = 这个服务的 summary.json。取不到就让流失败,页面保留缓存里的上一份。"
    },
    {
      "op": "set",
      "props": {
        "key": "nowMs",
        "value": "${@time.nowMs}"
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "nowMs",
          "sm",
          "hj"
        ]
      }
    }
