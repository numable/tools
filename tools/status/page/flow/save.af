{
  "_note": "唯一写盘口:关注列表(服务 id 数组,页面里去重、截到 6 个)。写完立刻让本包组件真取数重渲。",
  "version": 1,
  "actions": [
    {
      "action": "data.set",
      "params": {
        "key": "follow",
        "value": "${follow}"
      },
      "_note": "⚠️ 整取 `${follow}`,不在这里拼数组字面量 —— 长度会被写死。"
    },
    {
      "action": "data.remove",
      "params": {
        "key": "c.home"
      },
      "_note": "首页缓存按关注列表失效。"
    },
    {
      "action": "widget.refresh",
      "_note": "必须排在 data.set 之后。"
    }
  ]
}
