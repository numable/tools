{
  "_note": "进行中事故(44)。读关注列表;没有事故时画「都没事」+ 这次检查了哪些服务。",
  "version": 2,
  "title": "进行中事故",
  "sub": "关注的服务里正在发生的事故",
  "i18n": {
    "en-US": {
      "title": "Open incidents",
      "sub": "Active incidents across your services"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "用户关注的服务里进行中的事故：哪个服务、处理阶段、何时开始、已持续多久"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/incidents.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/follow.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "状态页 2 分钟一查(infosource-standard §5「状态页」档);只有看得见的组件才会被轮询。",
      "interval": [
        "120"
      ]
    }
  }
}
