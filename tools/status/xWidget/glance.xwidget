{
  "_note": "极简(22)。读首页维护的关注列表,无参数、无 onEdit(关注哪些服务在 App 首页「管理关注」里改)。",
  "version": 2,
  "title": "全部正常吗",
  "sub": "关注的服务一句结论 + 状态条",
  "i18n": {
    "en-US": {
      "title": "All good?",
      "sub": "One-line verdict for your services"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "用户关注的服务是否全部正常的一句结论，外加每个服务一格状态条"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/glance.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/follow.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "状态页 2 分钟一查(infosource-standard §5「状态页」档);只有看得见的组件才会被轮询。",
      "interval": [
        "120"
      ]
    }
  }
}
