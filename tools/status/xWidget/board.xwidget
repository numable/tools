{
  "_note": "关注看板(42)。读关注列表(最多 6 个),无参数。",
  "version": 2,
  "title": "关注看板",
  "sub": "关注的服务各自此刻的状态",
  "i18n": {
    "en-US": {
      "title": "Status board",
      "sub": "Each watched service at a glance"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "用户关注的最多 6 个服务，各自此刻的运行状态"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/board.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/follow.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "状态页 2 分钟一查(infosource-standard §5「状态页」档);只有看得见的组件才会被轮询。",
      "interval": [
        "120"
      ]
    }
  },
  "_note_jobs": "长按 →「添加提醒」:看板没有单个服务参数,在创建面板里选要盯的服务。",
  "jobs": [
    {
      "id": "down",
      "params": {}
    }
  ]
}
