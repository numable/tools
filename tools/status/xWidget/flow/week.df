          }
        }
      ]
    },
    {
      "op": "set",
      "props": {
        "key": "_b1",
        "value": "1"
      },
      "_note": "请求屏障(勿删)。"
    },
    {
      "op": "set",
      "props": {
        "key": "ok0",
        "value": "$[if::(eq::(${k0v},1),if::(or::(gt::(length::(${h0.months}),0),gt::(length::(${h0.incidents}),0)),1,0),0)]"
      },
      "_note": "这个服务的历史取到了没有(sp 看 months、io 看 incidents)。取不到 = 这一行画「--」,不画成「无事故」。"
    },
    {
      "op": "set",
      "props": {
        "key": "w0_0",
        "value": "0"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "w0_1",
        "value": "0"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "w0_2",
        "value": "0"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "w0_3",
        "value": "0"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "w0_4",
        "value": "0"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "w0_5",
        "value": "0"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "w0_6",
        "value": "0"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "c0",
        "value": "0"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "la0",
        "value": "999"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "o0s",
        "value": "$[findNotEmpty::(${h0.start_time},)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "o0L",
        "value": "$[length::(${o0s})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "o0z",
        "value": "$[if::(endsWith::(${o0s},Z),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "o0sg",
        "value": "$[if::(eq::(${o0z},1),+,subString::(${o0s},calc::(${o0L}-6),calc::(${o0L}-5)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "o0h",
        "value": "$[if::(eq::(${o0z},1),0,subString::(${o0s},calc::(${o0L}-5),calc::(${o0L}-3)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "o0m",
        "value": "$[if::(eq::(${o0z},1),0,subString::(${o0s},calc::(${o0L}-2),${o0L}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "o0n",
        "value": "$[if::(eq::(${o0sg},-),-1,1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "o0off",
        "value": "$[parseNumber::(calc::(${o0n}*(${o0h}*60+${o0m})),0)]"
      },
      "_note": "页面时区相对 UTC 的分钟数(EDT = −240);history.json 的时刻都是这个时区的墙钟。"
    },
    {
      "op": "set",
      "props": {
        "key": "b00y",
        "value": "$[findNotEmpty::(${h0.months[0].year},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "b00m",
        "value": "$[findNotEmpty::(get::(${MN},${h0.months[0].name}),0)]"
      }
    },
    {
      "op": "forEach",
      "props": {
        "items": "${h0.months[0].incidents}",
        "key": "it",
        "index": "i"
      },
      "items": [
        {
          "op": "set",
          "props": {
            "key": "_lb",
            "value": "1"
          },
          "_note": "循环屏障(勿删):每轮第一个节点读的是进循环那一刻的快照。"
        },
        {
          "op": "set",
          "props": {
            "key": "e0_ts",
            "value": "${it.timestamp}"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_mo",
            "value": "$[findNotEmpty::(get::(${M3},subString::(${e0_ts},0,3)),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_yy",
            "value": "$[if::(gt::(${e0_mo},${b00m}),calc::(${b00y}-1),${b00y})]"
          },
          "_note": "月块是一月、事故却从十二月开始 → 年份减一。"
        },
        {
          "op": "set",
          "props": {
            "key": "e0_dd",
            "value": "$[findNotEmpty::(index::(split::(index::(split::(${e0_ts},date.>),1),<),0),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_tm",
            "value": "$[findNotEmpty::(index::(split::(index::(split::(${e0_ts},time.>),1),<),0),00:00)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_hh",
            "value": "$[subString::(${e0_tm},0,2)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_mi",
            "value": "$[subString::(${e0_tm},3,5)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_im",
            "value": "${it.impact}"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_lv",
            "value": "$[if::(eq::(${e0_im},critical),4,if::(eq::(${e0_im},major),3,if::(eq::(${e0_im},maintenance),0,if::(gt::(length::(${e0_im}),0),2,0))))]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_adj",
            "value": "$[if::(le::(${e0_mo},2),1,0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_yoe",
            "value": "$[calc::(${e0_yy}-2000-${e0_adj})]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_mp",
            "value": "$[calc::(${e0_mo}-3+12*${e0_adj})]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_db",
            "value": "$[floor::(calc::((153*${e0_mp}+2)/5))]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_q4",
            "value": "$[floor::(calc::(${e0_yoe}/4))]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_days",
            "value": "$[calc::(11017+${e0_yoe}*365+${e0_q4}+${e0_db}+${e0_dd}-1)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_ms",
            "value": "$[calc::(${e0_days}*86400000+${e0_hh}*3600000+${e0_mi}*60000-(${o0off})*60000)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_ok",
            "value": "$[if::(and::(gt::(${e0_ms},1000000000000),gt::(${e0_lv},0),le::(${e0_ms},${nowMs})),1,0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_raw",
            "value": "$[floor::(calc::((${t0}-${e0_ms})/86400000))]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_ago",
            "value": "$[if::(ge::(${e0_ms},${t0}),0,calc::(${e0_raw}+1))]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_in",
            "value": "$[if::(and::(eq::(${e0_ok},1),le::(${e0_ago},6)),1,0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "w0_0",
            "value": "$[if::(and::(eq::(${e0_in},1),eq::(${e0_ago},0),gt::(${e0_lv},${w0_0})),${e0_lv},${w0_0})]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "w0_1",
            "value": "$[if::(and::(eq::(${e0_in},1),eq::(${e0_ago},1),gt::(${e0_lv},${w0_1})),${e0_lv},${w0_1})]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "w0_2",
            "value": "$[if::(and::(eq::(${e0_in},1),eq::(${e0_ago},2),gt::(${e0_lv},${w0_2})),${e0_lv},${w0_2})]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "w0_3",
            "value": "$[if::(and::(eq::(${e0_in},1),eq::(${e0_ago},3),gt::(${e0_lv},${w0_3})),${e0_lv},${w0_3})]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "w0_4",
            "value": "$[if::(and::(eq::(${e0_in},1),eq::(${e0_ago},4),gt::(${e0_lv},${w0_4})),${e0_lv},${w0_4})]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "w0_5",
            "value": "$[if::(and::(eq::(${e0_in},1),eq::(${e0_ago},5),gt::(${e0_lv},${w0_5})),${e0_lv},${w0_5})]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "w0_6",
            "value": "$[if::(and::(eq::(${e0_in},1),eq::(${e0_ago},6),gt::(${e0_lv},${w0_6})),${e0_lv},${w0_6})]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "c0",
            "value": "$[calc::(${c0}+${e0_in})]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "la0",
            "value": "$[if::(and::(eq::(${e0_ok},1),lt::(${e0_ago},${la0})),${e0_ago},${la0})]"
          }
        }
      ],
      "_note": "sp:逐月块逐条事故(本季度 3 个月块 + 跨季时上一页的最新月块)。io 的响应里没有 months → 这几个循环一轮都不跑。"
    },
    {
      "op": "set",
      "props": {
        "key": "b01y",
        "value": "$[findNotEmpty::(${h0.months[1].year},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "b01m",
        "value": "$[findNotEmpty::(get::(${MN},${h0.months[1].name}),0)]"
      }
    },
    {
      "op": "forEach",
      "props": {
        "items": "${h0.months[1].incidents}",
        "key": "it",
        "index": "i"
      },
      "items": [
        {
          "op": "set",
          "props": {
            "key": "_lb",
            "value": "1"
          },
          "_note": "循环屏障(勿删):每轮第一个节点读的是进循环那一刻的快照。"
        },
        {
          "op": "set",
          "props": {
            "key": "e0_ts",
            "value": "${it.timestamp}"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_mo",
            "value": "$[findNotEmpty::(get::(${M3},subString::(${e0_ts},0,3)),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_yy",
            "value": "$[if::(gt::(${e0_mo},${b01m}),calc::(${b01y}-1),${b01y})]"
          },
          "_note": "月块是一月、事故却从十二月开始 → 年份减一。"
        },
        {
          "op": "set",
          "props": {
            "key": "e0_dd",
            "value": "$[findNotEmpty::(index::(split::(index::(split::(${e0_ts},date.>),1),<),0),0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_tm",
            "value": "$[findNotEmpty::(index::(split::(index::(split::(${e0_ts},time.>),1),<),0),00:00)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_hh",
            "value": "$[subString::(${e0_tm},0,2)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_mi",
            "value": "$[subString::(${e0_tm},3,5)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_im",
            "value": "${it.impact}"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_lv",
            "value": "$[if::(eq::(${e0_im},critical),4,if::(eq::(${e0_im},major),3,if::(eq::(${e0_im},maintenance),0,if::(gt::(length::(${e0_im}),0),2,0))))]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_adj",
            "value": "$[if::(le::(${e0_mo},2),1,0)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "e0_yoe",
            "value": "$[calc::(${e0_yy}-2000-${e0_adj})]"
          }
        },
        {
          "op": "set",
