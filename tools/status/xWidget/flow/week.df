        "key": "v3",
        "value": "$[if::(and::(eq::(${k3v},1),eq::(${p2},1)),findNotEmpty::(get::(${HU2},${k3id}),),)]"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${u0}),0),1,0)]"
