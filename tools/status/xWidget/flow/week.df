    },
    {
      "op": "set",
      "props": {
        "key": "v0",
        "value": "$[if::(and::(eq::(${k0v},1),eq::(${p2},1)),findNotEmpty::(get::(${HU2},${k0id}),),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "u1",
        "value": "$[if::(eq::(${k1v},1),findNotEmpty::(get::(${HU},${k1id}),),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "v1",
