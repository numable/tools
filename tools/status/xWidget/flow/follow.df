        "value": "$[if::(endsWith::(${k5Tiso},Z),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k5Tsg",
        "value": "$[if::(eq::(${k5Tz},1),+,subString::(${k5Tiso},calc::(${k5TL}-6),calc::(${k5TL}-5)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k5Toh",
        "value": "$[if::(eq::(${k5Tz},1),0,subString::(${k5Tiso},calc::(${k5TL}-5),calc::(${k5TL}-3)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k5Tom",
