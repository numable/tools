          "op": "set",
          "props": {
            "key": "tn_linear",
            "value": "$[if::(eq::(${p_linear},0),${ih_linear.incidents[0].name},if::(eq::(${p_linear},1),${ih_linear.incidents[1].name},if::(eq::(${p_linear},2),${ih_linear.incidents[2].name},)))]"
          }
        },
        {
          "op": "set",
