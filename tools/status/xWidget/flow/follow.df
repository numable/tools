      }
    },
    {
      "op": "set",
      "props": {
        "key": "rid4",
        "value": "$[findNotEmpty::(index::(${raw},4),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rv4",
        "value": "$[if::(gt::(length::(${rid4}),0),if::(gt::(length::(findNotEmpty::(get::(${NM},${rid4}),)),0),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cj_4",
        "value": "${cl_3}~${rid4}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cl_4",
        "value": "$[if::(eq::(${rv4},1),if::(gt::(length::(${cl_3}),0),${cj_4},${rid4}),${cl_3})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rid5",
        "value": "$[findNotEmpty::(index::(${raw},5),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rv5",
        "value": "$[if::(gt::(length::(${rid5}),0),if::(gt::(length::(findNotEmpty::(get::(${NM},${rid5}),)),0),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cj_5",
        "value": "${cl_4}~${rid5}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cl_5",
        "value": "$[if::(eq::(${rv5},1),if::(gt::(length::(${cl_4}),0),${cj_5},${rid5}),${cl_4})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "parts",
        "value": "$[split::(${cl_5},~)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "MONE",
        "value": [
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ]
      },
      "_note": "事故开始时刻跨天时的月日:中文「9月25日 14:05」/ 英文「Sep 25 14:05」(doc/overseas-first.md §5)。"
    },
    {
      "op": "set",
      "props": {
        "key": "k0id",
        "value": "$[findNotEmpty::(index::(${parts},0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0n",
        "value": "$[if::(gt::(length::(${k0id}),0),findNotEmpty::(get::(${NM},${k0id}),),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0v",
        "value": "$[if::(gt::(length::(${k0n}),0),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0l",
        "value": "$[if::(eq::(${k0v},1),findNotEmpty::(get::(${LV},${k0id}),-1),-1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0o",
        "value": "$[if::(eq::(${k0v},1),findNotEmpty::(get::(${NO},${k0id}),0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0t",
