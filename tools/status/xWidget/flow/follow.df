          "github": "GitHub",
          "claude": "Claude",
          "openai": "OpenAI",
          "vercel": "Vercel",
          "cursor": "Cursor",
          "npm": "npm",
          "docker": "Docker",
          "bitbucket": "Bitbucket",
          "circleci": "CircleCI",
          "netlify": "Netlify",
          "supabase": "Supabase",
          "render": "Render",
          "digitalocean": "DigitalOcean",
          "mongodb": "MongoDB Cloud",
          "sentry": "Sentry",
          "datadog": "Datadog",
          "linear": "Linear",
          "notion": "Notion",
          "figma": "Figma",
          "postman": "Postman",
          "discord": "Discord",
          "reddit": "Reddit"
        }
      },
      "_note": "服务显示名(品牌名,中英同写)。"
    },
    {
      "op": "set",
      "props": {
        "key": "cl_x",
        "value": ""
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rid0",
        "value": "$[findNotEmpty::(index::(${raw},0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rv0",
        "value": "$[if::(gt::(length::(${rid0}),0),if::(gt::(length::(findNotEmpty::(get::(${NM},${rid0}),)),0),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cj_0",
        "value": "${cl_x}~${rid0}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cl_0",
        "value": "$[if::(eq::(${rv0},1),if::(gt::(length::(${cl_x}),0),${cj_0},${rid0}),${cl_x})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rid1",
        "value": "$[findNotEmpty::(index::(${raw},1),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rv1",
