            },
            "timeout": "8000"
          }
        },
        {
          "id": "ih_openai",
          "action": "request",
          "params": {
            "url": "https://status.openai.com/api/v2/incidents.json",
            "method": "GET",
            "formatType": "json",
            "header": {
              "Accept": "application/json"
            },
            "timeout": "8000"
          },
          "_note": "incident.io 兼容层:没有 unresolved.json(404),进行中事故从最新 25 条里挑未结束的。"
        }
      ]
    },
