      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0iid",
        "value": "$[if::(gt::(${k0o},0),findNotEmpty::(get::(${TID},${k0id}),),)]"
      },
      "_note": "最新一起进行中事故的 id(提醒按它去重:同一起事故只报一次)。"
    },
    {
      "op": "set",
      "props": {
        "key": "k0sc",
        "value": "$[if::(eq::(${k0rs},investigating),1,if::(eq::(${k0rs},identified),2,if::(eq::(${k0rs},monitoring),3,0)))]"
      },
      "_note": "事故进度码:1 调查中 · 2 已定位 · 3 观察恢复中 · 0 其它(处理中)。"
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tiso",
        "value": "$[findNotEmpty::(get::(${TT},${k0id}),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Thas",
        "value": "$[if::(gt::(length::(${k0Tiso}),18),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Ty",
        "value": "$[subString::(${k0Tiso},0,4)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tmo",
        "value": "$[subString::(${k0Tiso},5,7)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Td",
        "value": "$[subString::(${k0Tiso},8,10)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Thh",
        "value": "$[subString::(${k0Tiso},11,13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tmi",
        "value": "$[subString::(${k0Tiso},14,16)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tss",
        "value": "$[subString::(${k0Tiso},17,19)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0TL",
        "value": "$[length::(${k0Tiso})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tz",
        "value": "$[if::(endsWith::(${k0Tiso},Z),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tsg",
        "value": "$[if::(eq::(${k0Tz},1),+,subString::(${k0Tiso},calc::(${k0TL}-6),calc::(${k0TL}-5)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Toh",
        "value": "$[if::(eq::(${k0Tz},1),0,subString::(${k0Tiso},calc::(${k0TL}-5),calc::(${k0TL}-3)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tom",
        "value": "$[if::(eq::(${k0Tz},1),0,subString::(${k0Tiso},calc::(${k0TL}-2),${k0TL}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tsgn",
        "value": "$[if::(eq::(${k0Tsg},-),-1,1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tadj",
        "value": "$[if::(le::(${k0Tmo},2),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tyoe",
        "value": "$[calc::(${k0Ty}-2000-${k0Tadj})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tmp",
        "value": "$[calc::(${k0Tmo}-3+12*${k0Tadj})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tdb",
        "value": "$[floor::(calc::((153*${k0Tmp}+2)/5))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tq4",
        "value": "$[floor::(calc::(${k0Tyoe}/4))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tdays",
        "value": "$[calc::(11017+${k0Tyoe}*365+${k0Tq4}+${k0Tdb}+${k0Td}-1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Tms",
        "value": "$[calc::(${k0Tdays}*86400000+${k0Thh}*3600000+${k0Tmi}*60000+${k0Tss}*1000-${k0Tsgn}*(${k0Toh}*60+${k0Tom})*60000)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0el",
        "value": "$[max::(calc::((${nowMs}-${k0Tms})/60000),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0mn",
        "value": "$[parseNumber::(${k0el},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0hh",
        "value": "$[parseNumber::(calc::(${k0mn}/60),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0mm",
        "value": "$[parseNumber::(calc::(${k0mn}-${k0hh}*60),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0dd",
        "value": "$[parseNumber::(calc::(${k0mn}/1440),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0dh",
        "value": "$[parseNumber::(calc::(${k0hh}-${k0dd}*24),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0f",
        "value": "$[if::(and::(eq::(${k0Thas},1),gt::(${k0o},0)),if::(lt::(${k0mn},60),1,if::(lt::(${k0mn},1440),2,3)),0)]"
      },
      "_note": "已持续时长的格式:1 = N 分钟 · 2 = N 小时 M 分钟 · 3 = N 天 M 小时 · 0 = 无事故。两段数在 A / B。"
    },
    {
      "op": "set",
      "props": {
        "key": "k0A",
        "value": "$[if::(eq::(${k0f},1),${k0mn},if::(eq::(${k0f},2),${k0hh},if::(eq::(${k0f},3),${k0dd},)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0B",
        "value": "$[if::(eq::(${k0f},2),${k0mm},if::(eq::(${k0f},3),${k0dh},0))]"
      },
      "_note": "第二段数;为 0 时组件上不显示第二个单位(「2 小时」而不是「2 小时 0 分钟」)。"
    },
    {
      "op": "set",
      "props": {
        "key": "k0same",
        "value": "$[if::(eq::(formatDate::(${k0Tms},yyyyMMdd),formatDate::(${nowMs},yyyyMMdd)),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Mo",
        "value": "$[parseNumber::(formatDate::(${k0Tms},MM),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Dy",
        "value": "$[parseNumber::(formatDate::(${k0Tms},dd),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Me",
        "value": "$[index::(${MONE},calc::(${k0Mo}-1))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0Hm",
        "value": "$[formatDate::(${k0Tms},HH:mm)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0DZ",
        "value": "${k0Mo}月${k0Dy}日 ${k0Hm}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0DE",
        "value": "${k0Me} ${k0Dy} ${k0Hm}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0a",
        "value": "$[if::(and::(eq::(${k0Thas},1),gt::(${k0o},0)),if::(eq::(${k0same},1),${k0Hm},if::(startsWith::(${@app.language},zh),${k0DZ},${k0DE})),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0ok",
        "value": "$[if::(and::(eq::(${k0v},1),eq::(${k0l},0)),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0fe",
        "value": "$[if::(and::(eq::(${k0v},1),ge::(${k0l},0)),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0b",
        "value": "$[if::(and::(eq::(${k0v},1),ge::(${k0l},2)),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0m",
        "value": "$[if::(and::(eq::(${k0v},1),eq::(${k0l},1)),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0u",
        "value": "$[if::(and::(eq::(${k0v},1),lt::(${k0l},0)),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0h",
        "value": "$[if::(and::(eq::(${k0v},1),gt::(${k0o},0)),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0oc",
        "value": "$[if::(eq::(${k0v},1),${k0o},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1id",
        "value": "$[findNotEmpty::(index::(${parts},1),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1n",
        "value": "$[if::(gt::(length::(${k1id}),0),findNotEmpty::(get::(${NM},${k1id}),),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1v",
        "value": "$[if::(gt::(length::(${k1n}),0),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1l",
        "value": "$[if::(eq::(${k1v},1),findNotEmpty::(get::(${LV},${k1id}),-1),-1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1o",
        "value": "$[if::(eq::(${k1v},1),findNotEmpty::(get::(${NO},${k1id}),0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1t",
        "value": "$[if::(gt::(${k1o},0),findNotEmpty::(get::(${TN},${k1id}),),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1il",
        "value": "$[if::(gt::(${k1o},0),findNotEmpty::(get::(${TL},${k1id}),2),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1rs",
        "value": "$[if::(gt::(${k1o},0),findNotEmpty::(get::(${TS},${k1id}),),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1iid",
        "value": "$[if::(gt::(${k1o},0),findNotEmpty::(get::(${TID},${k1id}),),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1sc",
        "value": "$[if::(eq::(${k1rs},investigating),1,if::(eq::(${k1rs},identified),2,if::(eq::(${k1rs},monitoring),3,0)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1Tiso",
        "value": "$[findNotEmpty::(get::(${TT},${k1id}),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1Thas",
        "value": "$[if::(gt::(length::(${k1Tiso}),18),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1Ty",
        "value": "$[subString::(${k1Tiso},0,4)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1Tmo",
        "value": "$[subString::(${k1Tiso},5,7)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1Td",
        "value": "$[subString::(${k1Tiso},8,10)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1Thh",
        "value": "$[subString::(${k1Tiso},11,13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1Tmi",
        "value": "$[subString::(${k1Tiso},14,16)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1Tss",
        "value": "$[subString::(${k1Tiso},17,19)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1TL",
        "value": "$[length::(${k1Tiso})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1Tz",
        "value": "$[if::(endsWith::(${k1Tiso},Z),1,0)]"
      }
