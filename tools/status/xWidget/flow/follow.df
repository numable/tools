    },
    {
      "op": "set",
      "props": {
        "key": "k5Tadj",
        "value": "$[if::(le::(${k5Tmo},2),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k5Tyoe",
        "value": "$[calc::(${k5Ty}-2000-${k5Tadj})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k5Tmp",
        "value": "$[calc::(${k5Tmo}-3+12*${k5Tadj})]"
      }
    },
    {
      "op": "set",
      "props": {
