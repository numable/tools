          }
        },
        {
          "op": "set",
          "props": {
            "key": "u0_linear",
            "value": "$[if::(or::(eq::(${q0_linear},resolved),eq::(${q0_linear},postmortem),eq::(${q0_linear},completed)),0,1)]"
          }
        },
        {
          "op": "set",
