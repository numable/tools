        "value": "$[subString::(${k5Tiso},14,16)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k5Tss",
        "value": "$[subString::(${k5Tiso},17,19)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k5TL",
