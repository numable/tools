        "value": "$[floor::(calc::((153*${k5Tmp}+2)/5))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k5Tq4",
        "value": "$[floor::(calc::(${k5Tyoe}/4))]"
