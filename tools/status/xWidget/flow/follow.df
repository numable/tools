      "props": {
        "key": "rid3",
        "value": "$[findNotEmpty::(index::(${raw},3),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rv3",
        "value": "$[if::(gt::(length::(${rid3}),0),if::(gt::(length::(findNotEmpty::(get::(${NM},${rid3}),)),0),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cj_3",
