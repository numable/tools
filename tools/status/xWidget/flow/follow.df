      }
    },
    {
      "op": "set",
      "props": {
        "key": "cj_1",
        "value": "${cl_0}~${rid1}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cl_1",
        "value": "$[if::(eq::(${rv1},1),if::(gt::(length::(${cl_0}),0),${cj_1},${rid1}),${cl_0})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rid2",
        "value": "$[findNotEmpty::(index::(${raw},2),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rv2",
        "value": "$[if::(gt::(length::(${rid2}),0),if::(gt::(length::(findNotEmpty::(get::(${NM},${rid2}),)),0),1,0),0)]"
