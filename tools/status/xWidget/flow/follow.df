        "value": "1"
      },
      "_note": "请求屏障(勿删):request 之后紧邻的节点读不到响应(晚一拍)。"
    },
    {
      "op": "set",
      "props": {
        "key": "nowMs",
        "value": "${@time.nowMs}"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(contains::(${flk},~github~),1,0)]"
      },
      "items": [
        {
          "op": "set",
          "props": {
            "key": "ind_github",
            "value": "${st_github.status.indicator}"
          }
        },
        {
          "op": "set",
