{
  "_note": "单服务组件的「编辑」:从内置目录里选一个服务,写回这个组件的参数。只能选目录里的 —— 网络白名单是静态的,不能填任意地址。",
  "version": 1,
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "id": "r",
      "action": "singleValue",
      "interactive": true,
      "params": {
        "container": "sheet",
        "title": "${@i18n.title}",
        "desc": "${@i18n.desc}",
        "confirmTxt": "${@i18n.ok}",
        "component": {
          "type": "select",
          "value": "${svc}",
          "props": {
            "items": [
              {
                "label": "GitHub",
                "value": "github"
              },
              {
                "label": "Claude",
                "value": "claude"
              },
              {
                "label": "OpenAI",
                "value": "openai"
              },
              {
                "label": "Vercel",
                "value": "vercel"
              },
              {
                "label": "Cursor",
                "value": "cursor"
              },
              {
                "label": "npm",
                "value": "npm"
              },
              {
                "label": "Docker",
                "value": "docker"
              },
              {
                "label": "Bitbucket",
                "value": "bitbucket"
              },
              {
                "label": "CircleCI",
                "value": "circleci"
              },
              {
                "label": "Netlify",
                "value": "netlify"
              },
              {
                "label": "Supabase",
                "value": "supabase"
              },
              {
                "label": "Render",
                "value": "render"
              },
              {
                "label": "DigitalOcean",
                "value": "digitalocean"
              },
              {
                "label": "MongoDB Cloud",
                "value": "mongodb"
              },
              {
                "label": "Sentry",
                "value": "sentry"
              },
              {
                "label": "Datadog",
                "value": "datadog"
              },
              {
                "label": "Linear",
                "value": "linear"
              },
              {
                "label": "Notion",
                "value": "notion"
              },
              {
                "label": "Figma",
                "value": "figma"
              },
              {
                "label": "Postman",
                "value": "postman"
              },
              {
                "label": "Discord",
                "value": "discord"
              },
              {
                "label": "Reddit",
                "value": "reddit"
              }
            ]
          }
        }
      }
    },
    {
      "op": "set",
      "props": {
        "key": "picked",
        "value": "${r.value.value}"
      },
      "_note": "返回形状恒为 {value:{value}, cancelled};先落地再判,取消时为空、不写回。"
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${picked}),0),1,0)]"
      },
      "items": [
        {
          "action": "widget.updateParams",
          "params": {
            "svc": "${picked}"
          }
        }
      ]
    }
  ],
  "i18n": {
    "zh-CN": {
      "title": "选择服务",
      "desc": "这个组件显示哪个服务的状态",
      "ok": "确定"
    },
    "en-US": {
      "title": "Choose a service",
      "desc": "Which service this widget shows",
      "ok": "Done"
    }
  }
}
