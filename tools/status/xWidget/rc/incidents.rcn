                    "h": "${lh}pt",
                    "text": "$[if::(eq::(findNotEmpty::(${_it.l},-9),0),${@i18n.lv0},if::(eq::(findNotEmpty::(${_it.l},-9),1),${@i18n.lv1},if::(eq::(findNotEmpty::(${_it.l},-9),2),${@i18n.lv2},if::(eq::(findNotEmpty::(${_it.l},-9),3),${@i18n.lv3},if::(eq::(findNotEmpty::(${_it.l},-9),4),${@i18n.lv4},${@i18n.lvU})))))]",
                    "fontSize": "10.5pt",
