{
  "_note": "极简(22 · 158×158):关注的服务全部正常吗?一句结论 + 一条按服务分段的状态条 + 异常服务名单。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FAF8FE\\,#F4F0FE)@90|linear(#15171A\\,#19191F\\,#1E1B28)@90",
        "id": "bg"
      },
      {
        "type": "layer",
        "x": "12pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#7A4FD8|#B49BFF",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot",
        "_note": "源色身份点(本包紫,刻意避开五档状态色)。y 锚在标题的实测框上,不写常量。"
      },
      {
        "type": "txt",
        "x": "21pt",
        "y": "11pt",
        "w": "{parent.w}-83pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "txt",
        "x": "{parent.w}-58pt",
        "y": "14pt",
        "w": "46pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "id": "at",
        "_note": "时间锚 = 这次检查的时刻(取数那一刻)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${n},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "39.6pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "--",
            "fontSize": "20pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "hd"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${n},-1),0),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "32pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${@i18n.gNone}",
            "fontSize": "20pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "hd"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(and::(gt::(${n},0),eq::(${nIss},0)),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "32pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${@i18n.gAll}",
            "fontSize": "20pt",
            "textColor": "#1E9E62|#3DD68C",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "hd"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(gt::(${nBad},0),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "32pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${nBad}${@i18n.gBad}",
            "fontSize": "20pt",
            "textColor": "$[if::(eq::(findNotEmpty::(${headLv},-9),0),#1E9E62|#3DD68C,if::(eq::(findNotEmpty::(${headLv},-9),1),#2F6FDB|#6EA8FE,if::(eq::(findNotEmpty::(${headLv},-9),2),#A86E00|#E8B339,if::(eq::(findNotEmpty::(${headLv},-9),3),#D9600F|#FF9148,if::(eq::(findNotEmpty::(${headLv},-9),4),#D93A34|#FF6B61,#6B7280|#8E939B)))))]",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "hd"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(and::(eq::(${nBad},0),gt::(${nMaint},0)),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "32pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${nMaint}${@i18n.gMaint}",
            "fontSize": "20pt",
            "textColor": "#2F6FDB|#6EA8FE",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "hd"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(and::(eq::(${nBad},0),eq::(${nMaint},0),gt::(${nUnk},0)),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "32pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${nUnk}${@i18n.gUnk}",
            "fontSize": "20pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "hd"
          }
        ]
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "61pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${@i18n.wPre}${n}${@i18n.wSuf}",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "id": "wsub",
        "hide": "$[if::(gt::(findNotEmpty::(${n},0),0),0,2)]"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${n},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "61pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "--",
            "fontSize": "10.5pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "layer",
        "x": "12pt",
        "y": "84pt",
        "w": "{parent.w}-24pt",
        "h": "20pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "5pt",
          "leftB": "5pt",
          "rightT": "5pt",
          "rightB": "5pt"
        },
        "id": "track",
        "_note": "状态条底轨画在循环之外:没关注 / 取不到数据时仍是一条完整的条,不开洞。"
      },
      {
        "type": "op",
        "action": "forEach",
        "props": {
          "items": "${svcs}",
          "key": "_it",
          "index": "_i"
        },
        "react": [
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(lt::(${_i},findNotEmpty::(${n},0)),1,0)]"
            },
            "react": [
              {
                "type": "layer",
                "x": "${_it.gx}pt",
                "y": "84pt",
                "w": "${gw}pt",
                "h": "20pt",
                "bgColor": "$[if::(eq::(findNotEmpty::(${_it.l},-9),0),#1E9E62|#3DD68C,if::(eq::(findNotEmpty::(${_it.l},-9),1),#2F6FDB|#6EA8FE,if::(eq::(findNotEmpty::(${_it.l},-9),2),#E0A100|#E8B339,if::(eq::(findNotEmpty::(${_it.l},-9),3),#D9600F|#FF9148,if::(eq::(findNotEmpty::(${_it.l},-9),4),#D93A34|#FF6B61,#6B7280|#8E939B)))))]",
                "cornerRadius": {
                  "leftT": "5pt",
                  "leftB": "5pt",
                  "rightT": "5pt",
                  "rightB": "5pt"
                }
              }
            ]
          }
        ],
        "_note": "每个关注的服务一段,颜色 = 它此刻的状态档;段宽由取数流按关注数等分好。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(gt::(findNotEmpty::(${nIss},0),0),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "112pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${@i18n.issPre}${badNames}",
            "fontSize": "10pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "2",
            "lineBreak": "0",
            "lineSpacing": "2pt"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(and::(gt::(findNotEmpty::(${n},0),0),eq::(${nIss},0)),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "112pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${names}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "2",
            "lineBreak": "0",
            "lineSpacing": "2pt"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${n},-1),0),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "112pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${@i18n.hint}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "2",
            "lineBreak": "0",
            "lineSpacing": "2pt"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "brand": "服务状态",
        "gAll": "全部正常",
        "gNone": "还没关注",
        "gBad": " 个异常",
        "gMaint": " 个维护中",
        "gUnk": " 个未知",
        "wPre": "关注 ",
        "wSuf": " 个服务",
        "issPre": "异常：",
        "hint": "点开组件，选择要关注的服务"
      },
      "en-US": {
        "brand": "Status",
        "gAll": "All good",
        "gNone": "None yet",
        "gBad": " affected",
        "gMaint": " in maint.",
        "gUnk": " unknown",
        "wPre": "",
        "wSuf": " watched",
        "issPre": "Affected: ",
        "hint": "Tap to choose services to watch"
      }
    },
    "i18nEmptyOk": [
      "wPre"
    ]
  }
}
