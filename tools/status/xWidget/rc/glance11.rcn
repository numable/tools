{
  "_note": "全部正常吗 · 11 微档(68×60,card-design-system §8.2):关注的服务全部正常吗?一个词或一个数 + 一句底行。主值恒 ≤ 2 字符(「正常」/「OK」/ 个数,关注上限 6 个),字号固定 20pt。没有时间锚。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FAF8FE\\,#F4F0FE)@90|linear(#15171A\\,#19191F\\,#1E1B28)@90",
        "id": "bg"
      },
      {
        "type": "layer",
        "x": "8pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#7A4FD8|#B49BFF",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot",
        "_note": "源色身份点(本包紫,刻意避开五档状态色)。"
      },
      {
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "10pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(le::(findNotEmpty::(${n},0),0),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "8pt",
            "y": "28pt",
            "w": "54pt",
            "h": "-1",
            "text": "--",
            "fontSize": "20pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "hd"
          },
          {
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "text": "--",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "lineBreak": "0",
            "id": "low"
          }
        ],
        "_note": "没关注任何服务 / 取不到数据:值位 --,底行 --。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(and::(gt::(findNotEmpty::(${n},0),0),eq::(${nIss},0)),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "text": "${@i18n.ok11}",
            "fontSize": "20pt",
            "textColor": "#1E9E62|#3DD68C",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "hd"
          },
          {
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "text": "${@i18n.wPre}${n}${@i18n.wSuf11}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "lineBreak": "0",
            "id": "low"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(gt::(findNotEmpty::(${nBad},0),0),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "text": "${nBad}",
            "fontSize": "20pt",
            "textColor": "$[if::(eq::(findNotEmpty::(${headLv},-9),0),#1E9E62|#3DD68C,if::(eq::(findNotEmpty::(${headLv},-9),1),#2F6FDB|#6EA8FE,if::(eq::(findNotEmpty::(${headLv},-9),2),#A86E00|#E8B339,if::(eq::(findNotEmpty::(${headLv},-9),3),#D9600F|#FF9148,if::(eq::(findNotEmpty::(${headLv},-9),4),#D93A34|#FF6B61,#6B7280|#8E939B)))))]",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "hd"
          },
          {
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "text": "${@i18n.bad11}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "lineBreak": "0",
            "id": "low"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(and::(eq::(findNotEmpty::(${nBad},0),0),gt::(findNotEmpty::(${nMaint},0),0)),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "text": "${nMaint}",
            "fontSize": "20pt",
            "textColor": "#2F6FDB|#6EA8FE",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "hd"
          },
          {
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "text": "${@i18n.mnt11}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "lineBreak": "0",
            "id": "low"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(and::(eq::(findNotEmpty::(${nBad},0),0),eq::(findNotEmpty::(${nMaint},0),0),gt::(findNotEmpty::(${nUnk},0),0)),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "text": "${nUnk}",
            "fontSize": "20pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "hd"
          },
          {
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "text": "${@i18n.unk11}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "lineBreak": "0",
            "id": "low"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "brand": "服务状态",
        "ok11": "正常",
        "wPre": "关注 ",
        "wSuf11": " 个",
        "bad11": "个异常",
        "mnt11": "个维护中",
        "unk11": "个未知"
      },
      "en-US": {
        "brand": "Status",
        "ok11": "OK",
        "wPre": "",
        "wSuf11": " watched",
        "bad11": "affected",
        "mnt11": "in maint.",
        "unk11": "unknown"
      }
    },
    "i18nEmptyOk": [
      "wPre"
    ]
  }
}
