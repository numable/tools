{
  "_note": "单个服务 · 21 迷你(158×60,card-design-system §8.1):这个服务此刻怎么样 —— 一个状态词,颜色随档位。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FAF8FE\\,#F4F0FE)@90|linear(#15171A\\,#19191F\\,#1E1B28)@90",
        "id": "bg"
      },
      {
        "type": "layer",
        "x": "10pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#7A4FD8|#B49BFF",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot",
        "_note": "源色身份点(本包紫,刻意避开五档状态色)。"
      },
      {
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "90pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${k0n},${@i18n.brand})]",
        "fontSize": "11pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "txt",
        "x": "113pt",
        "y": "10.5pt",
        "w": "35pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "id": "at",
        "_note": "时间锚 = 这次检查的时刻(取数那一刻)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${k0l},-9),-9),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "10pt",
            "y": "27pt",
            "w": "138pt",
            "h": "-1",
            "text": "$[if::(eq::(findNotEmpty::(${k0l},-9),0),${@i18n.lv0},if::(eq::(findNotEmpty::(${k0l},-9),1),${@i18n.lv1},if::(eq::(findNotEmpty::(${k0l},-9),2),${@i18n.lv2},if::(eq::(findNotEmpty::(${k0l},-9),3),${@i18n.lv3},if::(eq::(findNotEmpty::(${k0l},-9),4),${@i18n.lv4},${@i18n.lvU})))))]",
            "fontSize": "16pt",
            "textColor": "$[if::(eq::(findNotEmpty::(${k0l},-9),0),#1E9E62|#3DD68C,if::(eq::(findNotEmpty::(${k0l},-9),1),#2F6FDB|#6EA8FE,if::(eq::(findNotEmpty::(${k0l},-9),2),#A86E00|#E8B339,if::(eq::(findNotEmpty::(${k0l},-9),3),#D9600F|#FF9148,if::(eq::(findNotEmpty::(${k0l},-9),4),#D93A34|#FF6B61,#6B7280|#8E939B)))))]",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "st"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${k0l},-9),-9),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "10pt",
            "y": "32pt",
            "w": "138pt",
            "h": "-1",
            "text": "--",
            "fontSize": "16pt",
            "textColor": "$[if::(eq::(findNotEmpty::(${k0l},-9),0),#1E9E62|#3DD68C,if::(eq::(findNotEmpty::(${k0l},-9),1),#2F6FDB|#6EA8FE,if::(eq::(findNotEmpty::(${k0l},-9),2),#A86E00|#E8B339,if::(eq::(findNotEmpty::(${k0l},-9),3),#D9600F|#FF9148,if::(eq::(findNotEmpty::(${k0l},-9),4),#D93A34|#FF6B61,#6B7280|#8E939B)))))]",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "id": "stE"
          }
        ],
        "_note": "取不到数据:值位「--」(下移到 16pt 结论词墨迹中线)。"
      }
    ],
    "i18n": {
      "zh-CN": {
        "lv0": "运行正常",
        "lv1": "维护中",
        "lv2": "轻微异常",
        "lv3": "部分中断",
        "lv4": "重大中断",
        "lvU": "状态未知",
        "brand": "服务状态"
      },
      "en-US": {
        "lv0": "Operational",
        "lv1": "Maintenance",
        "lv2": "Minor issues",
        "lv3": "Partial outage",
        "lv4": "Major outage",
        "lvU": "Unknown",
        "brand": "Status"
      }
    }
  }
}
