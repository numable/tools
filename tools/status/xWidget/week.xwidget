{
  "_note": "近 7 天稳定性(42)。读关注列表的前 4 个;数据是各服务的事故历史,1 小时一查。",
  "version": 2,
  "title": "近 7 天稳定性",
  "sub": "关注的服务这一周每天有没有出事",
  "i18n": {
    "en-US": {
      "title": "7-day stability",
      "sub": "Which days your services had incidents"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "用户关注的前 4 个服务近 7 天每天有没有事故与影响程度，以及近 7 天事故总数"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/week.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/week.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "事故历史 1 小时一查:它回答「这周稳不稳」,不需要状态页那档 2 分钟;每次要取最多 4 份历史(见 week.df 的 _note),查得太勤是白耗流量。",
      "interval": [
        "3600"
      ]
    }
  }
}
