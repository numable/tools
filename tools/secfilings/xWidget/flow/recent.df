{
  "_note": "生成器 tools/infosource/gen_secfilings.py(secfilings · 每家前 3 份有效的 · 输出 2 份)。组件 .df **不缓存**(G23 契约 5)。只取类型 / 事项编号 / 时刻,正文与 <summary> 一律不进输出(§3.13)。",
  "version": 1,
  "actions": [
    {
      "op": "set",
      "props": {
        "key": "kRaw",
        "value": "${kind}"
      },
      "_note": "入参落地(勿删):方法参数里的 ${} 看不见 flow 入参。"
    },
    {
      "op": "set",
      "props": {
        "key": "kIn",
        "value": "$[findNotEmpty::(${kRaw},all)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "qty",
        "value": "$[if::(eq::(${kIn},cur),8-K,if::(eq::(${kIn},fin),10-,))]"
      },
      "_note": "type 是**前缀**:8-K 含 8-K/A,10- 含 10-Q / 10-K 及更正。"
    },
    {
      "op": "set",
      "props": {
        "key": "qow",
        "value": "$[if::(eq::(${kIn},ins),only,exclude)]"
      },
      "_note": "内部人走 owner=only(Form 3/4/5 与 144)。⚠️ 不能用 type=4:前缀会把 424B2 一并带出。"
    },
    {
      "op": "set",
      "props": {
        "key": "kd",
        "value": "$[if::(eq::(${kIn},cur),2,if::(eq::(${kIn},fin),3,if::(eq::(${kIn},ins),4,1)))]"
      },
      "_note": "类型码(1 全部 / 2 8-K / 3 财报 / 4 内部人),给 RCN 选卡名用。"
    },
    {
      "op": "set",
      "props": {
        "key": "tzNow",
        "value": "${@time.nowMs}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzLf",
        "value": "$[formatDate::(${tzNow},yyyy-MM-dd HH:mm)]"
      },
      "_note": "此刻的**本机**年月日时分。pattern 只用纯 token + `-` `:` 空格(G4c)。"
    },
    {
      "op": "set",
      "props": {
        "key": "tzY",
        "value": "$[subString::(${tzLf},0,4)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzMo",
        "value": "$[subString::(${tzLf},5,7)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzD",
        "value": "$[subString::(${tzLf},8,10)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzH",
        "value": "$[subString::(${tzLf},11,13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzMi",
        "value": "$[subString::(${tzLf},14,16)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzAdj",
        "value": "$[if::(le::(${tzMo},2),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzYoe",
        "value": "$[calc::(${tzY}-2000-${tzAdj})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzMp",
        "value": "$[calc::(${tzMo}-3+12*${tzAdj})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzDb",
        "value": "$[floor::(calc::((153*${tzMp}+2)/5))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzQ4",
        "value": "$[floor::(calc::(${tzYoe}/4))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzDays",
        "value": "$[calc::(11017+${tzYoe}*365+${tzQ4}+${tzDb}+${tzD}-1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzE",
        "value": "$[calc::(${tzDays}*86400000+${tzH}*3600000+${tzMi}*60000)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzMin",
        "value": "$[calc::(floor::(calc::(${tzNow}/60000))*60000)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tzO",
        "value": "$[round::(calc::(${tzE}-${tzMin}))]"
      },
      "_note": "本机时区偏移(毫秒):东八区 = 28800000。round:Android 上 calc 返回 double,不 round 会带 .0。"
    },
    {
      "id": "lst",
      "action": "data.get",
      "params": {
        "key": "sec_list",
        "default": []
      },
      "_note": "关注列表(首页 / 管理页写入,[{t,n}],最多 8 家)。**默认空** —— 不替用户关注任何公司。"
    },
    {
      "op": "set",
      "props": {
        "key": "_b0",
        "value": "1"
      },
      "_note": "⚠️ 请求/并发屏障(勿删):request 与 concurrent 之后**紧邻**的节点读不到响应(晚一拍合并,memory [[actionflow-concurrent-late-merge]])。删掉它 → 下面所有 index:: 静默取空 → 卡渲一片 `--`,而流仍报 success。"
    },
    {
      "op": "set",
      "props": {
        "key": "cnt",
        "value": "$[length::(${lst})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "T",
        "value": {
          "t0": "${lst[0].t}",
          "t1": "${lst[1].t}",
          "t2": "${lst[2].t}",
          "t3": "${lst[3].t}",
          "t4": "${lst[4].t}",
          "t5": "${lst[5].t}",
          "t6": "${lst[6].t}",
          "t7": "${lst[7].t}"
        }
      },
      "_note": "8 个定长槽的代码(字面下标;空槽 = 空)。"
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${T.t0}),0),1,0)]"
      },
      "items": [
        {
          "action": "request",
          "id": "r0",
          "params": {
            "url": "https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${T.t0}&type=${qty}&dateb=&owner=${qow}&count=10&output=atom",
            "method": "GET",
            "formatType": "string",
            "header": {
              "User-Agent": "Numable support@numable.app",
              "Accept": "application/atom+xml"
            },
            "timeout": "12000"
          },
          "_note": "formatType:string —— Atom XML 不经任何 XML 解析器,用 split 切(xmlParse 四端是四个引擎,对带默认 xmlns 的 Atom 结果互相矛盾;memory actionflow-df-pitfalls §xmlparse)。UA 是 SEC 要求的如实身份,不是伪装(见生成器头注)。"
        }
      ]
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${T.t1}),0),1,0)]"
      },
      "items": [
        {
          "action": "sleep",
          "params": {
            "timestamp": "150"
          },
          "_note": "相邻两次请求之间垫 150ms:SEC 公开限速 10 次/秒,超了按 IP 封 10 分钟。"
        },
        {
          "action": "request",
          "id": "r1",
          "params": {
            "url": "https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${T.t1}&type=${qty}&dateb=&owner=${qow}&count=10&output=atom",
            "method": "GET",
            "formatType": "string",
            "header": {
              "User-Agent": "Numable support@numable.app",
              "Accept": "application/atom+xml"
            },
            "timeout": "12000"
          },
          "_note": "formatType:string —— Atom XML 不经任何 XML 解析器,用 split 切(xmlParse 四端是四个引擎,对带默认 xmlns 的 Atom 结果互相矛盾;memory actionflow-df-pitfalls §xmlparse)。UA 是 SEC 要求的如实身份,不是伪装(见生成器头注)。"
        }
      ]
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${T.t2}),0),1,0)]"
      },
      "items": [
        {
          "action": "sleep",
          "params": {
            "timestamp": "150"
          },
          "_note": "相邻两次请求之间垫 150ms:SEC 公开限速 10 次/秒,超了按 IP 封 10 分钟。"
        },
        {
