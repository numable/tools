          "id": "r7",
          "params": {
            "url": "https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${T.t7}&type=${qty}&dateb=&owner=${qow}&count=10&output=atom",
            "method": "GET",
            "formatType": "string",
            "header": {
