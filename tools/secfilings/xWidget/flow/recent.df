    {
      "op": "set",
      "props": {
        "key": "nOk",
        "value": "$[calc::(${OK.ok0}+${OK.ok1}+${OK.ok2}+${OK.ok3}+${OK.ok4}+${OK.ok5}+${OK.ok6}+${OK.ok7})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "nV",
        "value": "$[calc::(if::(gt::(${TK.k0},0),1,0)+if::(gt::(${TK.k1},0),1,0)+if::(gt::(${TK.k2},0),1,0)+if::(gt::(${TK.k3},0),1,0)+if::(gt::(${TK.k4},0),1,0)+if::(gt::(${TK.k5},0),1,0)+if::(gt::(${TK.k6},0),1,0)+if::(gt::(${TK.k7},0),1,0)+if::(gt::(${TK.k8},0),1,0)+if::(gt::(${TK.k9},0),1,0)+if::(gt::(${TK.k10},0),1,0)+if::(gt::(${TK.k11},0),1,0)+if::(gt::(${TK.k12},0),1,0)+if::(gt::(${TK.k13},0),1,0)+if::(gt::(${TK.k14},0),1,0)+if::(gt::(${TK.k15},0),1,0)+if::(gt::(${TK.k16},0),1,0)+if::(gt::(${TK.k17},0),1,0)+if::(gt::(${TK.k18},0),1,0)+if::(gt::(${TK.k19},0),1,0)+if::(gt::(${TK.k20},0),1,0)+if::(gt::(${TK.k21},0),1,0)+if::(gt::(${TK.k22},0),1,0)+if::(gt::(${TK.k23},0),1,0))]"
      }
