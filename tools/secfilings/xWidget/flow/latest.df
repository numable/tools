    {
      "op": "set",
      "props": {
        "key": "F",
        "value": {
          "f0_0": "$[replaceAll::(index::(split::(index::(split::(index::(${SP.s0},1),<filing-type>),1),<),0),SCHEDULE,SC)]",
          "f0_1": "$[replaceAll::(index::(split::(index::(split::(index::(${SP.s0},2),<filing-type>),1),<),0),SCHEDULE,SC)]",
          "f0_2": "$[replaceAll::(index::(split::(index::(split::(index::(${SP.s0},3),<filing-type>),1),<),0),SCHEDULE,SC)]",
          "f0_3": "$[replaceAll::(index::(split::(index::(split::(index::(${SP.s0},4),<filing-type>),1),<),0),SCHEDULE,SC)]",
          "f0_4": "$[replaceAll::(index::(split::(index::(split::(index::(${SP.s0},5),<filing-type>),1),<),0),SCHEDULE,SC)]",
          "f0_5": "$[replaceAll::(index::(split::(index::(split::(index::(${SP.s0},6),<filing-type>),1),<),0),SCHEDULE,SC)]",
          "f0_6": "$[replaceAll::(index::(split::(index::(split::(index::(${SP.s0},7),<filing-type>),1),<),0),SCHEDULE,SC)]",
          "f0_7": "$[replaceAll::(index::(split::(index::(split::(index::(${SP.s0},8),<filing-type>),1),<),0),SCHEDULE,SC)]",
          "f0_8": "$[replaceAll::(index::(split::(index::(split::(index::(${SP.s0},9),<filing-type>),1),<),0),SCHEDULE,SC)]",
