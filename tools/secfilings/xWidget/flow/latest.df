        "value": [
          "${CD.i0}",
          "${CD.i1}",
          "${CD.i2}",
          "${CD.i3}",
          "${CD.i4}",
          "${CD.i5}",
          "${CD.i6}",
          "${CD.i7}"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "CS",
        "value": [
          "${TS.s0}",
          "${TS.s1}",
          "${TS.s2}",
          "${TS.s3}",
          "${TS.s4}",
          "${TS.s5}",
          "${TS.s6}",
          "${TS.s7}"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "CN",
        "value": [
          "${lst[0].n}",
          "${lst[1].n}",
          "${lst[2].n}",
          "${lst[3].n}",
          "${lst[4].n}",
          "${lst[5].n}",
          "${lst[6].n}",
          "${lst[7].n}"
        ]
      },
      "_note": "公司名取关注列表里存的那份(添加时从 SEC 的 conformed-name 取来,已解好 &amp;)。"
    },
    {
      "op": "set",
      "props": {
        "key": "O",
        "value": {
          "k0": "$[index::(${CT},${PK.p0})]",
          "f0": "$[index::(${CF},${PK.p0})]",
          "i0": "$[index::(${CI},${PK.p0})]",
          "s0": "$[index::(${CS},${PK.p0})]",
          "n0": "$[index::(${CN},${PK.p0})]"
        }
      },
      "_note": "按受理时刻排好的前 1 份候选。"
    },
    {
      "op": "set",
      "props": {
        "key": "M",
        "value": {
          "m0": "$[if::(gt::(length::(${O.f0}),0),max::(floor::(calc::((${tzNow}-parseNumber::(${O.s0},0))/60000)),1),)]"
        }
      },
      "_note": "距今分钟数(下限 1:时钟偏差会让刚交的文件算出负数)。"
    },
    {
      "op": "set",
      "props": {
        "key": "nmR",
        "value": "$[findNotEmpty::(${O.n0},)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "nmUp",
        "value": "$[if::(eq::(connect::(k,toUpperCase::(${nmR})),connect::(k,${nmR})),1,0)]"
      },
      "_note": "全大写?(前缀 k:两边都不是数字,eq 走字符串比较)"
    },
    {
      "op": "set",
      "props": {
        "key": "nmW",
        "value": "$[split::(${nmR},\\s)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "nmN",
        "value": "$[length::(${nmW})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "NC",
        "value": {
          "c0": "$[if::(lt::(0,${nmN}),replaceAll::(replaceAll::(index::(${nmW},0),\\x2C,),\\.,),)]",
          "c1": "$[if::(lt::(1,${nmN}),replaceAll::(replaceAll::(index::(${nmW},1),\\x2C,),\\.,),)]",
          "c2": "$[if::(lt::(2,${nmN}),replaceAll::(replaceAll::(index::(${nmW},2),\\x2C,),\\.,),)]",
          "c3": "$[if::(lt::(3,${nmN}),replaceAll::(replaceAll::(index::(${nmW},3),\\x2C,),\\.,),)]",
          "c4": "$[if::(lt::(4,${nmN}),replaceAll::(replaceAll::(index::(${nmW},4),\\x2C,),\\.,),)]",
          "c5": "$[if::(lt::(5,${nmN}),replaceAll::(replaceAll::(index::(${nmW},5),\\x2C,),\\.,),)]"
        }
      },
      "_note": "逐词去逗号与句点(逗号是方法参数分隔符,只能写 \\x2C)。"
    },
    {
      "op": "set",
      "props": {
        "key": "NS",
        "value": {
          "s0": "$[if::(ge::(0,${nmN}),1,if::(or::(contains::(~CO~COM~CORP~CORPORATION~INC~INCORPORATED~LTD~LIMITED~PLC~LLC~LP~SA~NV~AG~SE~&~,connect::(~,connect::(toUpperCase::(${NC.c0}),~))),startsWith::(${NC.c0},/)),1,0))]",
          "s1": "$[if::(ge::(1,${nmN}),1,if::(or::(contains::(~CO~COM~CORP~CORPORATION~INC~INCORPORATED~LTD~LIMITED~PLC~LLC~LP~SA~NV~AG~SE~&~,connect::(~,connect::(toUpperCase::(${NC.c1}),~))),startsWith::(${NC.c1},/)),1,0))]",
          "s2": "$[if::(ge::(2,${nmN}),1,if::(or::(contains::(~CO~COM~CORP~CORPORATION~INC~INCORPORATED~LTD~LIMITED~PLC~LLC~LP~SA~NV~AG~SE~&~,connect::(~,connect::(toUpperCase::(${NC.c2}),~))),startsWith::(${NC.c2},/)),1,0))]",
          "s3": "$[if::(ge::(3,${nmN}),1,if::(or::(contains::(~CO~COM~CORP~CORPORATION~INC~INCORPORATED~LTD~LIMITED~PLC~LLC~LP~SA~NV~AG~SE~&~,connect::(~,connect::(toUpperCase::(${NC.c3}),~))),startsWith::(${NC.c3},/)),1,0))]",
          "s4": "$[if::(ge::(4,${nmN}),1,if::(or::(contains::(~CO~COM~CORP~CORPORATION~INC~INCORPORATED~LTD~LIMITED~PLC~LLC~LP~SA~NV~AG~SE~&~,connect::(~,connect::(toUpperCase::(${NC.c4}),~))),startsWith::(${NC.c4},/)),1,0))]",
          "s5": "$[if::(ge::(5,${nmN}),1,if::(or::(contains::(~CO~COM~CORP~CORPORATION~INC~INCORPORATED~LTD~LIMITED~PLC~LLC~LP~SA~NV~AG~SE~&~,connect::(~,connect::(toUpperCase::(${NC.c5}),~))),startsWith::(${NC.c5},/)),1,0))]"
        }
      },
      "_note": "是不是后缀词(不存在的词也算,好让「末尾连续」一路串到底)。"
    },
    {
      "op": "set",
      "props": {
        "key": "NT",
        "value": {
          "t0": "$[if::(and::(eq::(${NS.s0},1),eq::(${NS.s1},1),eq::(${NS.s2},1),eq::(${NS.s3},1),eq::(${NS.s4},1),eq::(${NS.s5},1)),1,0)]",
          "t1": "$[if::(and::(eq::(${NS.s1},1),eq::(${NS.s2},1),eq::(${NS.s3},1),eq::(${NS.s4},1),eq::(${NS.s5},1)),1,0)]",
          "t2": "$[if::(and::(eq::(${NS.s2},1),eq::(${NS.s3},1),eq::(${NS.s4},1),eq::(${NS.s5},1)),1,0)]",
          "t3": "$[if::(and::(eq::(${NS.s3},1),eq::(${NS.s4},1),eq::(${NS.s5},1)),1,0)]",
          "t4": "$[if::(and::(eq::(${NS.s4},1),eq::(${NS.s5},1)),1,0)]",
          "t5": "$[if::(and::(eq::(${NS.s5},1)),1,0)]"
        }
      },
      "_note": "从这个词起到末尾全是后缀 → 去掉。"
    },
    {
      "op": "set",
      "props": {
        "key": "NO",
        "value": {
          "o0": "$[if::(eq::(1,0),,if::(and::(eq::(${nmUp},1),eq::(if::(contains::(${NC.c0},&),1,0),0)),connect::(toUpperCase::(subString::(${NC.c0},0,1)),toLowerCase::(subString::(${NC.c0},1,length::(${NC.c0})))),${NC.c0}))]",
          "o1": "$[if::(eq::(${NT.t1},1),,if::(and::(eq::(${nmUp},1),eq::(if::(contains::(${NC.c1},&),1,0),0)),connect::(toUpperCase::(subString::(${NC.c1},0,1)),toLowerCase::(subString::(${NC.c1},1,length::(${NC.c1})))),${NC.c1}))]",
          "o2": "$[if::(eq::(${NT.t2},1),,if::(and::(eq::(${nmUp},1),eq::(if::(contains::(${NC.c2},&),1,0),0)),connect::(toUpperCase::(subString::(${NC.c2},0,1)),toLowerCase::(subString::(${NC.c2},1,length::(${NC.c2})))),${NC.c2}))]",
          "o3": "$[if::(eq::(${NT.t3},1),,if::(and::(eq::(${nmUp},1),eq::(if::(contains::(${NC.c3},&),1,0),0)),connect::(toUpperCase::(subString::(${NC.c3},0,1)),toLowerCase::(subString::(${NC.c3},1,length::(${NC.c3})))),${NC.c3}))]",
          "o4": "$[if::(eq::(${NT.t4},1),,if::(and::(eq::(${nmUp},1),eq::(if::(contains::(${NC.c4},&),1,0),0)),connect::(toUpperCase::(subString::(${NC.c4},0,1)),toLowerCase::(subString::(${NC.c4},1,length::(${NC.c4})))),${NC.c4}))]",
          "o5": "$[if::(eq::(${NT.t5},1),,if::(and::(eq::(${nmUp},1),eq::(if::(contains::(${NC.c5},&),1,0),0)),connect::(toUpperCase::(subString::(${NC.c5},0,1)),toLowerCase::(subString::(${NC.c5},1,length::(${NC.c5})))),${NC.c5}))]"
        }
      },
      "_note": "留下的词逐个首字母大写(第一个词恒留)。"
    },
    {
      "op": "set",
      "props": {
        "key": "nice0",
        "value": "${NO.o0} ${NO.o1} ${NO.o2} ${NO.o3} ${NO.o4} ${NO.o5}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "nice",
        "value": "$[if::(gt::(${nmN},6),${nmR},${nice0})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tTs",
        "value": "$[parseNumber::(${O.s0},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tMo",
        "value": "$[round::(parseNumber::(formatDate::(${tTs},MM),0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tDd",
        "value": "$[round::(parseNumber::(formatDate::(${tTs},dd),0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tHm",
        "value": "$[formatDate::(${tTs},HH:mm)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "MONS",
        "value": [
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tMn",
        "value": "$[index::(${MONS},calc::(${tMo}-1))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tZh",
        "value": "${tMo}月${tDd}日 ${tHm}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tEn",
        "value": "${tMn} ${tDd} ${tHm}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tTx",
        "value": "$[if::(startsWith::(${@app.language},zh),${tZh},${tEn})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rows",
        "value": [
          {
