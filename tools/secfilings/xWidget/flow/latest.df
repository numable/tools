      },
      "_note": "1 有文件 · 2 关注了但这一类最近没有 · 3 还没关注任何公司。取数失败时流已抛错,st 不存在 → RCN 画骨架。"
    },
    {
      "op": "set",
      "props": {
        "key": "at",
        "value": "$[formatDate::(${tzNow},HH:mm)]"
      },
      "_note": "时效锚 = 取数时刻(SEC 列表没有「数据时间」字段)。"
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "rows",
          "st",
          "kd",
          "at"
        ]
      }
    }
  ]
}
