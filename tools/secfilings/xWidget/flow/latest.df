          "s0": "$[calc::(parseDate::(subString::(${CD.u0},0,10),yyyy-MM-dd)+${tzO}+subString::(${CD.u0},11,13)*3600000+subString::(${CD.u0},14,16)*60000+subString::(${CD.u0},17,19)*1000+(2*${G.g0}-1)*${G.o0}*60000)]",
          "s1": "$[calc::(parseDate::(subString::(${CD.u1},0,10),yyyy-MM-dd)+${tzO}+subString::(${CD.u1},11,13)*3600000+subString::(${CD.u1},14,16)*60000+subString::(${CD.u1},17,19)*1000+(2*${G.g1}-1)*${G.o1}*60000)]",
          "s2": "$[calc::(parseDate::(subString::(${CD.u2},0,10),yyyy-MM-dd)+${tzO}+subString::(${CD.u2},11,13)*3600000+subString::(${CD.u2},14,16)*60000+subString::(${CD.u2},17,19)*1000+(2*${G.g2}-1)*${G.o2}*60000)]",
          "s3": "$[calc::(parseDate::(subString::(${CD.u3},0,10),yyyy-MM-dd)+${tzO}+subString::(${CD.u3},11,13)*3600000+subString::(${CD.u3},14,16)*60000+subString::(${CD.u3},17,19)*1000+(2*${G.g3}-1)*${G.o3}*60000)]",
          "s4": "$[calc::(parseDate::(subString::(${CD.u4},0,10),yyyy-MM-dd)+${tzO}+subString::(${CD.u4},11,13)*3600000+subString::(${CD.u4},14,16)*60000+subString::(${CD.u4},17,19)*1000+(2*${G.g4}-1)*${G.o4}*60000)]",
          "s5": "$[calc::(parseDate::(subString::(${CD.u5},0,10),yyyy-MM-dd)+${tzO}+subString::(${CD.u5},11,13)*3600000+subString::(${CD.u5},14,16)*60000+subString::(${CD.u5},17,19)*1000+(2*${G.g5}-1)*${G.o5}*60000)]",
          "s6": "$[calc::(parseDate::(subString::(${CD.u6},0,10),yyyy-MM-dd)+${tzO}+subString::(${CD.u6},11,13)*3600000+subString::(${CD.u6},14,16)*60000+subString::(${CD.u6},17,19)*1000+(2*${G.g6}-1)*${G.o6}*60000)]",
          "s7": "$[calc::(parseDate::(subString::(${CD.u7},0,10),yyyy-MM-dd)+${tzO}+subString::(${CD.u7},11,13)*3600000+subString::(${CD.u7},14,16)*60000+subString::(${CD.u7},17,19)*1000+(2*${G.g7}-1)*${G.o7}*60000)]"
        }
      },
      "_note": "受理时刻(UTC 毫秒)。空候选这里求不出值 —— 下一阶段按「时刻串够长」闸成 -1。"
    },
    {
      "op": "set",
      "props": {
        "key": "TK",
        "value": {
          "k0": "$[if::(gt::(length::(${CD.u0}),18),${TS.s0},-1)]",
          "k1": "$[if::(gt::(length::(${CD.u1}),18),${TS.s1},-1)]",
          "k2": "$[if::(gt::(length::(${CD.u2}),18),${TS.s2},-1)]",
          "k3": "$[if::(gt::(length::(${CD.u3}),18),${TS.s3},-1)]",
          "k4": "$[if::(gt::(length::(${CD.u4}),18),${TS.s4},-1)]",
          "k5": "$[if::(gt::(length::(${CD.u5}),18),${TS.s5},-1)]",
          "k6": "$[if::(gt::(length::(${CD.u6}),18),${TS.s6},-1)]",
          "k7": "$[if::(gt::(length::(${CD.u7}),18),${TS.s7},-1)]"
        }
      },
      "_note": "排名键:有效候选 = 受理时刻,空候选 = -1(排到最后)。只进比较,不进 calc。"
    },
    {
      "op": "set",
      "props": {
        "key": "RK",
        "value": {
          "r0": "$[calc::(if::(gt::(${TK.k1},${TK.k0}),1,0)+if::(gt::(${TK.k2},${TK.k0}),1,0)+if::(gt::(${TK.k3},${TK.k0}),1,0)+if::(gt::(${TK.k4},${TK.k0}),1,0)+if::(gt::(${TK.k5},${TK.k0}),1,0)+if::(gt::(${TK.k6},${TK.k0}),1,0)+if::(gt::(${TK.k7},${TK.k0}),1,0))]",
          "r1": "$[calc::(if::(ge::(${TK.k0},${TK.k1}),1,0)+if::(gt::(${TK.k2},${TK.k1}),1,0)+if::(gt::(${TK.k3},${TK.k1}),1,0)+if::(gt::(${TK.k4},${TK.k1}),1,0)+if::(gt::(${TK.k5},${TK.k1}),1,0)+if::(gt::(${TK.k6},${TK.k1}),1,0)+if::(gt::(${TK.k7},${TK.k1}),1,0))]",
          "r2": "$[calc::(if::(ge::(${TK.k0},${TK.k2}),1,0)+if::(ge::(${TK.k1},${TK.k2}),1,0)+if::(gt::(${TK.k3},${TK.k2}),1,0)+if::(gt::(${TK.k4},${TK.k2}),1,0)+if::(gt::(${TK.k5},${TK.k2}),1,0)+if::(gt::(${TK.k6},${TK.k2}),1,0)+if::(gt::(${TK.k7},${TK.k2}),1,0))]",
          "r3": "$[calc::(if::(ge::(${TK.k0},${TK.k3}),1,0)+if::(ge::(${TK.k1},${TK.k3}),1,0)+if::(ge::(${TK.k2},${TK.k3}),1,0)+if::(gt::(${TK.k4},${TK.k3}),1,0)+if::(gt::(${TK.k5},${TK.k3}),1,0)+if::(gt::(${TK.k6},${TK.k3}),1,0)+if::(gt::(${TK.k7},${TK.k3}),1,0))]",
          "r4": "$[calc::(if::(ge::(${TK.k0},${TK.k4}),1,0)+if::(ge::(${TK.k1},${TK.k4}),1,0)+if::(ge::(${TK.k2},${TK.k4}),1,0)+if::(ge::(${TK.k3},${TK.k4}),1,0)+if::(gt::(${TK.k5},${TK.k4}),1,0)+if::(gt::(${TK.k6},${TK.k4}),1,0)+if::(gt::(${TK.k7},${TK.k4}),1,0))]",
          "r5": "$[calc::(if::(ge::(${TK.k0},${TK.k5}),1,0)+if::(ge::(${TK.k1},${TK.k5}),1,0)+if::(ge::(${TK.k2},${TK.k5}),1,0)+if::(ge::(${TK.k3},${TK.k5}),1,0)+if::(ge::(${TK.k4},${TK.k5}),1,0)+if::(gt::(${TK.k6},${TK.k5}),1,0)+if::(gt::(${TK.k7},${TK.k5}),1,0))]",
          "r6": "$[calc::(if::(ge::(${TK.k0},${TK.k6}),1,0)+if::(ge::(${TK.k1},${TK.k6}),1,0)+if::(ge::(${TK.k2},${TK.k6}),1,0)+if::(ge::(${TK.k3},${TK.k6}),1,0)+if::(ge::(${TK.k4},${TK.k6}),1,0)+if::(ge::(${TK.k5},${TK.k6}),1,0)+if::(gt::(${TK.k7},${TK.k6}),1,0))]",
          "r7": "$[calc::(if::(ge::(${TK.k0},${TK.k7}),1,0)+if::(ge::(${TK.k1},${TK.k7}),1,0)+if::(ge::(${TK.k2},${TK.k7}),1,0)+if::(ge::(${TK.k3},${TK.k7}),1,0)+if::(ge::(${TK.k4},${TK.k7}),1,0)+if::(ge::(${TK.k5},${TK.k7}),1,0)+if::(ge::(${TK.k6},${TK.k7}),1,0))]"
        }
      },
      "_note": "名次 = 比我新的候选数(下标小的同刻者算在前),8 个候选的名次两两不同。"
    },
    {
      "op": "set",
      "props": {
        "key": "PK",
        "value": {
          "p0": "$[findNotEmpty::(if::(eq::(${RK.r0},0),0,),if::(eq::(${RK.r1},0),1,),if::(eq::(${RK.r2},0),2,),if::(eq::(${RK.r3},0),3,),if::(eq::(${RK.r4},0),4,),if::(eq::(${RK.r5},0),5,),if::(eq::(${RK.r6},0),6,),if::(eq::(${RK.r7},0),7,))]"
        }
      },
      "_note": "第 s 个输出槽 = 名次为 s 的候选下标(findNotEmpty 对数字 0 原样返回)。"
    },
    {
      "op": "set",
      "props": {
        "key": "CT",
        "value": [
          "${T.t0}",
          "${T.t1}",
          "${T.t2}",
          "${T.t3}",
          "${T.t4}",
          "${T.t5}",
          "${T.t6}",
          "${T.t7}"
        ]
      },
      "_note": "候选 → 代码(真数组字面量,逐元素求值)。"
    },
    {
      "op": "set",
      "props": {
        "key": "CF",
        "value": [
          "${CD.f0}",
          "${CD.f1}",
          "${CD.f2}",
          "${CD.f3}",
          "${CD.f4}",
          "${CD.f5}",
          "${CD.f6}",
          "${CD.f7}"
        ]
      }
    },
    {
      "op": "set",
      "props": {
