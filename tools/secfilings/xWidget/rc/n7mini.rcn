{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FBFCFD\\,#F3F5F8)@90|linear(#15171A\\,#171A1E\\,#1C1F26)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#1C3F7A|#91AEE8",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "100pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(${kd},2),${@i18n.b2},if::(eq::(${kd},3),${@i18n.b3},if::(eq::(${kd},4),${@i18n.b4},${@i18n.b1})))]",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "10pt",
        "y": "10.5pt",
        "w": "138pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "mv",
        "type": "txt",
        "x": "10pt",
        "y": "25pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(if::(eq::(findNotEmpty::(${n7},__none__),__none__),0,if::(eq::(${st},3),0,1)),1),${n7},--)]",
        "fontSize": "17pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "mu",
        "type": "txt",
        "x": "{mv.r}+3pt",
        "y": "30.5pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(${n7},1),${@i18n.unit1},${@i18n.unit})]",
        "fontSize": "10pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(if::(eq::(findNotEmpty::(${n7},__none__),__none__),0,if::(eq::(${st},3),0,1)),1),0,1)]"
      },
      {
        "id": "ft",
        "type": "txt",
        "x": "10pt",
        "y": "45pt",
        "w": "78pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(findNotEmpty::(${st},0),3),${@i18n.f3},if::(eq::(findNotEmpty::(${n7},__none__),__none__),--,if::(gt::(${n7},0),${@i18n.fTopA}${top},${@i18n.f0})))]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "type": "layer",
        "x": "90pt",
        "y": "52pt",
        "w": "6pt",
        "h": "2pt",
