{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FBFCFD\\,#F3F5F8)@90|linear(#15171A\\,#171A1E\\,#1C1F26)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#1C3F7A|#91AEE8",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(${kd},2),${@i18n.b2},if::(eq::(${kd},3),${@i18n.b3},if::(eq::(${kd},4),${@i18n.b4},${@i18n.b1})))]",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "mv",
        "type": "txt",
        "x": "8pt",
        "y": "22pt",
        "w": "54pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(if::(eq::(findNotEmpty::(${n7},__none__),__none__),0,if::(eq::(${st},3),0,1)),1),${n7},--)]",
        "fontSize": "20pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "_note": "近 7 天份数(每家最多计 10 份,≤ 80,恒 ≤ 2 位数 → 20pt 定号)。"
      },
      {
        "id": "ft",
        "type": "txt",
        "x": "8pt",
        "y": "46pt",
        "w": "54pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(findNotEmpty::(${st},0),3),${@i18n.f3},if::(eq::(findNotEmpty::(${n7},__none__),__none__),--,if::(gt::(${n7},0),${@i18n.fTopA}${top},${@i18n.f0})))]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      }
    ],
    "i18n": {
      "zh-CN": {
        "fTopA": "最多 ",
        "f0": "没有新的",
        "f3": "还没关注",
        "b1": "7 天公告",
        "b2": "7 天 8-K",
        "b3": "7 天财报",
        "b4": "内部人"
      },
      "en-US": {
        "fTopA": "top ",
        "f0": "none new",
        "f3": "no tickers",
        "b1": "Last 7d",
        "b2": "8-K 7d",
        "b3": "Reports",
        "b4": "Insiders"
      }
    },
    "_note": "生成器 tools/infosource/gen_secfilings.py(11 微档,复用 feed.df 的近 7 天统计)。"
  }
}
