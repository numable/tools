{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FBFCFD\\,#F3F5F8)@90|linear(#15171A\\,#171A1E\\,#1C1F26)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#1C3F7A|#91AEE8",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "brand",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(${kd},2),${@i18n.b2},if::(eq::(${kd},3),${@i18n.b3},if::(eq::(${kd},4),${@i18n.b4},${@i18n.b1})))]",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "_note": "组件名随 kind 参数(同 22)。英文最长「Insider filing」11pt 约 72pt,右侧时效锚从 ≈ 122 起,够。"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "10pt",
        "y": "10.5pt",
        "w": "138pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "tk",
        "type": "txt",
        "x": "10pt",
        "y": "26pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(${st},1),findNotEmpty::(${rows[0].k},--),--)]",
        "fontSize": "15pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "fm",
        "type": "txt",
        "x": "{tk.r}+6pt",
        "y": "26.5pt",
        "w": "-1",
        "h": "-1",
        "alignmentH": "1",
        "maxLines": "1",
        "text": "${rows[0].f}",
        "fontSize": "9pt",
        "textColor": "#1C3F7A|#91AEE8",
        "typeface": "System-Bold",
        "bgColor": "#1F1C3F7A|#2991AEE8",
        "paddingLeft": "6.0pt",
        "paddingRight": "6.0pt",
        "paddingTop": "2.5pt",
        "paddingBottom": "2.5pt",
        "cornerRadius": {
          "leftT": "9.5pt",
          "leftB": "9.5pt",
          "rightT": "9.5pt",
          "rightB": "9.5pt"
        },
        "hide": "$[if::(eq::(${st},1),if::(gt::(length::(${rows[0].f}),0),0,1),1)]",
        "_note": "类型胶囊(8-K / 10-Q …):宽度随文案,x 锚在代码右边缘。一个 txt 节点自带底(§4.2a-2)。"
      },
      {
        "id": "tm",
        "type": "txt",
        "x": "10pt",
        "w": "138pt",
        "y": "44pt",
        "h": "13pt",
        "alignmentV": "1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${rows[0].t},--)] · $[findNotEmpty::(${rows[0].a},--)] $[if::(eq::(${rows[0].u},1),${@i18n.uM},if::(eq::(${rows[0].u},2),${@i18n.uH},if::(eq::(${rows[0].u},3),${@i18n.uD},)))]",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(${st},1),if::(gt::(length::(${rows[0].k}),0),0,1),1)]",
        "_note": "本机时刻(SEC 受理时刻换算)· 多久前(同 22 的 tm)。"
      },
      {
        "id": "tmX",
        "type": "txt",
        "x": "10pt",
        "w": "138pt",
        "y": "44pt",
        "h": "13pt",
        "alignmentV": "1",
        "maxLines": "1",
        "text": "--",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(${st},1),if::(gt::(length::(${rows[0].k}),0),1,0),0)]"
      }
    ],
    "i18n": {
      "zh-CN": {
        "uM": "分钟前",
        "uH": "小时前",
        "uD": "天前",
        "b1": "最新公告",
        "b2": "最新 8-K",
        "b3": "最新财报",
        "b4": "内部人交易"
      },
      "en-US": {
        "uM": "min ago",
        "uH": "hr ago",
        "uD": "days ago",
        "b1": "Latest filing",
        "b2": "Latest 8-K",
        "b3": "Latest report",
        "b4": "Insider filing"
      }
    },
    "_note": "生成器 tools/infosource/gen_secfilings.py(21 迷你,复用 latest.df)。"
  }
}
