{rows[0].c},111),${@i18n.lb111},if::(eq::(${rows[0].c},112),${@i18n.lb112},if::(eq::(${rows[0].c},113),${@i18n.lb113},if::(eq::(${rows[0].c},114),${@i18n.lb114},if::(eq::(${rows[0].c},115),${@i18n.lb115},if::(eq::(${rows[0].c},116),${@i18n.lb116},if::(eq::(${rows[0].c},117),${@i18n.lb117},if::(eq::(${rows[0].c},118),${@i18n.lb118},if::(eq::(${rows[0].c},119),${@i18n.lb119},if::(eq::(${rows[0].c},120),${@i18n.lb120},if::(eq::(${rows[0].c},121),${@i18n.lb121},)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))]",
