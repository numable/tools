{
  "_note": "xJob/new.xjob 的判定段:按 accession 编号去重,首跑只建基线、不补报;基线只在这里写。生成器 tools/infosource/gen_secfilings.py。",
  "version": 1,
  "actions": [
    {
      "op": "set",
      "props": {
        "key": "insRaw",
        "value": "${ins}"
      },
      "_note": "入参落地(勿删):方法参数里看不见 flow 入参。"
    },
    {
      "op": "set",
      "props": {
        "key": "insIn",
        "value": "$[findNotEmpty::(${insRaw},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "JJ",
        "value": "${J}"
      },
      "_note": "取数段的整个 J 对象(then.params 只认整串单键 `${J}`,不认 `${J.l0}` 这种点路径 —— iOS runDependSlots 按平铺键名查,点路径会查成空)。"
    },
    {
      "op": "set",
      "props": {
        "key": "I",
        "value": {
          "t0": "$[findNotEmpty::(${JJ.t0},)]",
          "t1": "$[findNotEmpty::(${JJ.t1},)]",
          "t2": "$[findNotEmpty::(${JJ.t2},)]",
          "t3": "$[findNotEmpty::(${JJ.t3},)]",
          "t4": "$[findNotEmpty::(${JJ.t4},)]",
          "t5": "$[findNotEmpty::(${JJ.t5},)]",
          "t6": "$[findNotEmpty::(${JJ.t6},)]",
          "t7": "$[findNotEmpty::(${JJ.t7},)]",
          "n0": "$[findNotEmpty::(${JJ.n0},)]",
          "n1": "$[findNotEmpty::(${JJ.n1},)]",
          "n2": "$[findNotEmpty::(${JJ.n2},)]",
          "n3": "$[findNotEmpty::(${JJ.n3},)]",
          "n4": "$[findNotEmpty::(${JJ.n4},)]",
          "n5": "$[findNotEmpty::(${JJ.n5},)]",
          "n6": "$[findNotEmpty::(${JJ.n6},)]",
          "n7": "$[findNotEmpty::(${JJ.n7},)]",
          "l0": "$[findNotEmpty::(${JJ.l0},)]",
          "l1": "$[findNotEmpty::(${JJ.l1},)]",
          "l2": "$[findNotEmpty::(${JJ.l2},)]",
          "l3": "$[findNotEmpty::(${JJ.l3},)]",
          "l4": "$[findNotEmpty::(${JJ.l4},)]",
          "l5": "$[findNotEmpty::(${JJ.l5},)]",
          "l6": "$[findNotEmpty::(${JJ.l6},)]",
          "l7": "$[findNotEmpty::(${JJ.l7},)]"
        }
      },
      "_note": "t 代码 · n 公司名 · l 这一轮的串(取不到 = 空)。"
    },
    {
      "op": "set",
      "props": {
        "key": "K",
        "value": {
          "s0": "$[connect::(sec.seen.,${insIn},.,${I.t0})]",
          "s1": "$[connect::(sec.seen.,${insIn},.,${I.t1})]",
          "s2": "$[connect::(sec.seen.,${insIn},.,${I.t2})]",
          "s3": "$[connect::(sec.seen.,${insIn},.,${I.t3})]",
          "s4": "$[connect::(sec.seen.,${insIn},.,${I.t4})]",
          "s5": "$[connect::(sec.seen.,${insIn},.,${I.t5})]",
          "s6": "$[connect::(sec.seen.,${insIn},.,${I.t6})]",
          "s7": "$[connect::(sec.seen.,${insIn},.,${I.t7})]"
        }
      },
      "_note": "基线键 = 实例参数(ins)+ 代码。"
    },
    {
      "id": "pv0",
      "action": "data.get",
      "params": {
        "key": "${K.s0}",
        "default": ""
      }
    },
    {
