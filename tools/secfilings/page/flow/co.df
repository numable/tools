              },
              {
                "f": "$[replaceAll::(index::(split::(index::(split::(index::(${SP},14),<filing-type>),1),<),0),SCHEDULE,SC)]",
                "d": "$[index::(split::(index::(split::(index::(${SP},14),<filing-date>),1),<),0)]",
                "u": "$[index::(split::(index::(split::(index::(${SP},14),<updated>),1),<),0)]",
                "h": "$[index::(split::(index::(split::(index::(${SP},14),<filing-href>),1),<),0)]",
                "a": "$[index::(split::(index::(split::(index::(${SP},14),<accession-number>),1),<),0)]",
                "i": "$[index::(split::(index::(split::(index::(${SP},14),<items-desc>),1),<),0)]",
                "n": "$[index::(split::(index::(split::(index::(${SP},14),<form-name>),1),<),0)]"
              },
              {
                "f": "$[replaceAll::(index::(split::(index::(split::(index::(${SP},15),<filing-type>),1),<),0),SCHEDULE,SC)]",
                "d": "$[index::(split::(index::(split::(index::(${SP},15),<filing-date>),1),<),0)]",
                "u": "$[index::(split::(index::(split::(index::(${SP},15),<updated>),1),<),0)]",
                "h": "$[index::(split::(index::(split::(index::(${SP},15),<filing-href>),1),<),0)]",
                "a": "$[index::(split::(index::(split::(index::(${SP},15),<accession-number>),1),<),0)]",
                "i": "$[index::(split::(index::(split::(index::(${SP},15),<items-desc>),1),<),0)]",
                "n": "$[index::(split::(index::(split::(index::(${SP},15),<form-name>),1),<),0)]"
              },
              {
                "f": "$[replaceAll::(index::(split::(index::(split::(index::(${SP},16),<filing-type>),1),<),0),SCHEDULE,SC)]",
                "d": "$[index::(split::(index::(split::(index::(${SP},16),<filing-date>),1),<),0)]",
                "u": "$[index::(split::(index::(split::(index::(${SP},16),<updated>),1),<),0)]",
                "h": "$[index::(split::(index::(split::(index::(${SP},16),<filing-href>),1),<),0)]",
                "a": "$[index::(split::(index::(split::(index::(${SP},16),<accession-number>),1),<),0)]",
                "i": "$[index::(split::(index::(split::(index::(${SP},16),<items-desc>),1),<),0)]",
                "n": "$[index::(split::(index::(split::(index::(${SP},16),<form-name>),1),<),0)]"
              },
              {
                "f": "$[replaceAll::(index::(split::(index::(split::(index::(${SP},17),<filing-type>),1),<),0),SCHEDULE,SC)]",
                "d": "$[index::(split::(index::(split::(index::(${SP},17),<filing-date>),1),<),0)]",
                "u": "$[index::(split::(index::(split::(index::(${SP},17),<updated>),1),<),0)]",
                "h": "$[index::(split::(index::(split::(index::(${SP},17),<filing-href>),1),<),0)]",
                "a": "$[index::(split::(index::(split::(index::(${SP},17),<accession-number>),1),<),0)]",
                "i": "$[index::(split::(index::(split::(index::(${SP},17),<items-desc>),1),<),0)]",
                "n": "$[index::(split::(index::(split::(index::(${SP},17),<form-name>),1),<),0)]"
              },
              {
                "f": "$[replaceAll::(index::(split::(index::(split::(index::(${SP},18),<filing-type>),1),<),0),SCHEDULE,SC)]",
                "d": "$[index::(split::(index::(split::(index::(${SP},18),<filing-date>),1),<),0)]",
                "u": "$[index::(split::(index::(split::(index::(${SP},18),<updated>),1),<),0)]",
                "h": "$[index::(split::(index::(split::(index::(${SP},18),<filing-href>),1),<),0)]",
                "a": "$[index::(split::(index::(split::(index::(${SP},18),<accession-number>),1),<),0)]",
                "i": "$[index::(split::(index::(split::(index::(${SP},18),<items-desc>),1),<),0)]",
                "n": "$[index::(split::(index::(split::(index::(${SP},18),<form-name>),1),<),0)]"
              },
              {
                "f": "$[replaceAll::(index::(split::(index::(split::(index::(${SP},19),<filing-type>),1),<),0),SCHEDULE,SC)]",
                "d": "$[index::(split::(index::(split::(index::(${SP},19),<filing-date>),1),<),0)]",
                "u": "$[index::(split::(index::(split::(index::(${SP},19),<updated>),1),<),0)]",
                "h": "$[index::(split::(index::(split::(index::(${SP},19),<filing-href>),1),<),0)]",
                "a": "$[index::(split::(index::(split::(index::(${SP},19),<accession-number>),1),<),0)]",
                "i": "$[index::(split::(index::(split::(index::(${SP},19),<items-desc>),1),<),0)]",
                "n": "$[index::(split::(index::(split::(index::(${SP},19),<form-name>),1),<),0)]"
              },
              {
                "f": "$[replaceAll::(index::(split::(index::(split::(index::(${SP},20),<filing-type>),1),<),0),SCHEDULE,SC)]",
                "d": "$[index::(split::(index::(split::(index::(${SP},20),<filing-date>),1),<),0)]",
                "u": "$[index::(split::(index::(split::(index::(${SP},20),<updated>),1),<),0)]",
                "h": "$[index::(split::(index::(split::(index::(${SP},20),<filing-href>),1),<),0)]",
                "a": "$[index::(split::(index::(split::(index::(${SP},20),<accession-number>),1),<),0)]",
                "i": "$[index::(split::(index::(split::(index::(${SP},20),<items-desc>),1),<),0)]",
                "n": "$[index::(split::(index::(split::(index::(${SP},20),<form-name>),1),<),0)]"
              }
            ]
          },
          "_note": "f 类型 · d 归属日 · u 受理时刻(ISO,页面 JS 换本机时间)· h SEC 文件索引页 · a 编号 · i 8-K 事项编号 · n SEC 的表格名称(只作未知类型的兜底标签)。**没有 <summary> / 正文**(§3.13)。"
        },
        {
          "op": "set",
          "props": {
            "key": "fetchedMs",
            "value": "${@time.nowMs}"
          },
          "_note": "取数时刻(页面时效锚)。"
        },
        {
          "_note": "写回哨兵:**直接取响应字段,不加任何兜底** —— 取数失败/响应变形时它必空。别拿加工后的显示字段当判据,那些几乎都带兜底,拦不住任何东西。",
          "op": "set",
          "props": {
            "key": "_guard",
            "value": "$[index::(split::(index::(split::(${raw},<conformed-name>),1),<),0)]"
          }
        },
        {
          "_note": "整份渲染输入打包落盘。⚠️ 键集必须与 resultFilter 完全一致 —— 少一个,命中缓存那趟就少一个字段(而且不报错)。",
          "op": "set",
          "props": {
            "key": "pack",
            "value": {
              "nm": "${nm}",
              "rows": "${rows}",
              "fetchedMs": "${fetchedMs}",
              "ts": "${nowMs}",
              "schema": "${SCHEMA}"
            }
          }
        },
        {
          "_note": "契约 4(§5.5.2):关键字段非空才写回。`_guard` 在取数失败/响应变形时必空 —— 此时什么都不写,盘上的旧货留着继续渲。一次超时把 pack 写成空,就把这页永久钉死在空态上直到下次恰好成功。",
          "op": "if",
          "props": {
            "val": "$[if::(gt::(length::(${_guard}),0),1,0)]"
          },
          "items": [
            {
              "action": "data.set",
              "params": {
                "key": "${ckey}",
                "value": "${pack}"
              }
            }
          ]
        }
      ]
    },
    {
      "_note": "统一出口:走没走网络都从缓存对象取渲染输入 —— 两条路径只有一份字段映射,不会出现「命中那条少算一个字段」的分叉。",
      "id": "box",
      "action": "data.get",
      "params": {
        "key": "${ckey}",
        "default": {}
      }
    },
    {
      "op": "set",
      "props": {
        "key": "nm",
        "value": "${box.nm}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rows",
        "value": "${box.rows}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "fetchedMs",
        "value": "${box.fetchedMs}"
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "_stale",
          "ckey",
          "nm",
          "rows",
          "fetchedMs"
        ]
      },
      "_note": "resultFilter 恒放最后;少透一个键,下游就是空参。⚠️ `_stale`/`ckey` 是校新那条路的入参,别删。"
    }
  ]
}
