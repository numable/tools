{
  "_note": "中国国债曲线(42):最新与约 1 个月前两条曲线 + 10 年减 2 年利差。",
  "version": 2,
  "title": "中国国债曲线",
  "sub": "收益率曲线与 10 年减 2 年利差",
  "i18n": {
    "en-US": {
      "title": "China yield curve",
      "sub": "Government bond curve and the 10Y–2Y spread"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "中国国债收益率曲线(3 个月到 30 年)最新与约一个月前的对比,以及 2 年与 10 年利差"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/cncurve.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/cn.df]",
        "params": {
          "mode": "curve"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  }
}
