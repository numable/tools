{
  "_note": "美债曲线(42):最新与约 1 个月前两条曲线 + 2–10 年利差(倒挂时标出)。",
  "version": 2,
  "title": "美债曲线",
  "sub": "收益率曲线与 2–10 年利差",
  "i18n": {
    "en-US": {
      "title": "Yield curve",
      "sub": "Treasury curve and the 2s10s spread"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "美国国债收益率曲线(3 个月到 30 年)最新与约一个月前的对比,以及 2 年与 10 年利差、是否倒挂"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/curve.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/ust.df]",
        "params": {
          "mode": "curve"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  }
}
