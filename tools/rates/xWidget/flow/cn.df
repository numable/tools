        },
        {
          "op": "set",
          "props": {
            "key": "dMt",
            "value": "$[if::(eq::(${dMtm},0),--,if::(eq::(${zh},1),${dMtm} 月 ${dMtd} 日,index::(split::(Jan~Feb~Mar~Apr~May~Jun~Jul~Aug~Sep~Oct~Nov~Dec,~),calc::(${dMtm}-1)) ${dMtd}))]"
          }
        },
