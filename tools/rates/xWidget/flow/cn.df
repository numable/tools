            "value": "$[if::(eq::(if::(matches::(findNotEmpty::(${L10y},x),^-?[0-9]+[.]?[0-9]*$),1,0),1),parseNumber::(${L10y},0.00),)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "spv",
            "value": "$[if::(and::(eq::(if::(matches::(findNotEmpty::(${L10y},x),^-?[0-9]+[.]?[0-9]*$),1,0),1),eq::(if::(matches::(findNotEmpty::(${L2y},x),^-?[0-9]+[.]?[0-9]*$),1,0),1)),round::(calc::((${L10y}-${L2y})*100)),)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "spn",
            "value": "$[if::(eq::(if::(eq::(findNotEmpty::(${spv},__none__),__none__),0,1),1),parseNumber::(${spv},0),--)]"
          }
        },
        {
          "op": "set",
          "props": {
            "key": "spT",
            "value": "$[if::(eq::(if::(eq::(findNotEmpty::(${spv},__none__),__none__),0,1),0),--,if::(gt::(${spv},0),+${spn},if::(lt::(${spv},0),−parseNumber::(calc::(0-${spv}),0),0)))]"
          },
          "_note": "10 年 − 2 年利差带符号写(单位「基点」在 RCN 里另一个 span)。"
        },
        {
          "op": "set",
          "props": {
            "key": "inv",
            "value": "$[if::(and::(eq::(if::(eq::(findNotEmpty::(${spv},__none__),__none__),0,1),1),lt::(${spv},0)),1,0)]"
          },
          "_note": "倒挂 = 2 年 > 10 年(事实,不解读)。"
        },
        {
          "op": "if",
          "props": {
            "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${t10},__none__),__none__),0,1),1),0,1)]"
