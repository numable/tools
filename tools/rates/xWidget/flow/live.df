        "value": "$[if::(eq::(${lOk},1),parseNumber::(calc::(2+(${lHi}-findNotEmpty::(${tv10},${tv1}))/(${lHi}-${lLo})*22),0.0),13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "l21y13",
        "value": "$[if::(eq::(${lOk},1),parseNumber::(calc::(2+(${lHi}-findNotEmpty::(${tv9},${tv1}))/(${lHi}-${lLo})*22),0.0),13)]"
      }
    },
    {
