      "props": {
        "key": "l21y14",
        "value": "$[if::(eq::(${lOk},1),parseNumber::(calc::(2+(${lHi}-findNotEmpty::(${tv8},${tv1}))/(${lHi}-${lLo})*22),0.0),13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "l21y15",
        "value": "$[if::(eq::(${lOk},1),parseNumber::(calc::(2+(${lHi}-findNotEmpty::(${tv7},${tv1}))/(${lHi}-${lLo})*22),0.0),13)]"
      }
    },
    {
