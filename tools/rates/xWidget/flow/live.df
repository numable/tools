        "value": "$[if::(eq::(${lOk},1),parseNumber::(calc::(2+(${lHi}-findNotEmpty::(${tv12},${tv1}))/(${lHi}-${lLo})*22),0.0),13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "l21y11",
        "value": "$[if::(eq::(${lOk},1),parseNumber::(calc::(2+(${lHi}-findNotEmpty::(${tv11},${tv1}))/(${lHi}-${lLo})*22),0.0),13)]"
      }
    },
    {
      "op": "set",
      "props": {
