      }
    },
    {
      "op": "set",
      "props": {
        "key": "l21y17",
        "value": "$[if::(eq::(${lOk},1),parseNumber::(calc::(2+(${lHi}-findNotEmpty::(${tv5},${tv1}))/(${lHi}-${lLo})*22),0.0),13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "l21y18",
        "value": "$[if::(eq::(${lOk},1),parseNumber::(calc::(2+(${lHi}-findNotEmpty::(${tv4},${tv1}))/(${lHi}-${lLo})*22),0.0),13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "l21y19",
        "value": "$[if::(eq::(${lOk},1),parseNumber::(calc::(2+(${lHi}-findNotEmpty::(${tv3},${tv1}))/(${lHi}-${lLo})*22),0.0),13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "l21y20",
        "value": "$[if::(eq::(${lOk},1),parseNumber::(calc::(2+(${lHi}-findNotEmpty::(${tv2},${tv1}))/(${lHi}-${lLo})*22),0.0),13)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "l21y21",
        "value": "$[if::(eq::(${lOk},1),parseNumber::(calc::(2+(${lHi}-findNotEmpty::(${tv1},${tv1}))/(${lHi}-${lLo})*22),0.0),13)]"
      }
    },
    {
