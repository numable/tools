{
  "_note": "2–10 年利差(21):与 42 档同一条 ust.df(mode=spread),零新增请求。",
  "version": 2,
  "title": "2–10 年利差 · 迷你",
  "sub": "利差与一年走势",
  "i18n": {
    "en-US": {
      "title": "2s10s · mini",
      "sub": "Spread and the past year"
    }
  },
  "layout": 21,
  "params": {},
  "ai": {
    "shows": "美国 10 年与 2 年国债收益率之差(基点)、是否倒挂,以及过去一年走势小图"
  },
  "events": {
    "onClick": "numable://self/page/s?id=s2s10"
  },
  "canvas": {
    "source": "@[file://rc/spread21.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/ust.df]",
        "params": {
          "mode": "spread"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  }
}
