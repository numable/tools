{
  "_note": "2–10 年利差(42):当前值 + 一年走势(26 个点)。",
  "version": 2,
  "title": "2–10 年利差",
  "sub": "10 年减 2 年的一年走势",
  "i18n": {
    "en-US": {
      "title": "2s10s spread",
      "sub": "10Y minus 2Y over the past year"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "美国 10 年与 2 年国债收益率之差(基点)及其过去一年走势,标出是否倒挂"
  },
  "events": {
    "onClick": "numable://self/page/s?id=s2s10"
  },
  "canvas": {
    "source": "@[file://rc/spread.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/ust.df]",
        "params": {
          "mode": "spread"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  }
}
