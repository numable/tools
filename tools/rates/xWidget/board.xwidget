{
  "_note": "利率总表(44):美 3 个月 / 2 / 10 / 30 年、10 年实际、2–10 年利差、德 10 年、日 10 年。",
  "version": 2,
  "title": "利率总表",
  "sub": "主要期限的日、月、年变化",
  "i18n": {
    "en-US": {
      "title": "Rates board",
      "sub": "Key yields with 1-day, 1-month and 1-year moves"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "美债各期限、实际利率、2–10 年利差与德日 10 年收益率,及日、月、年变化"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/board.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/glob.df]",
        "params": {
          "mode": "board"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  }
}
