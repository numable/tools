{
  "_note": "美债 10 年(财政部收盘):收益率大字 + 日变化(基点,涨跌色按数值方向)+ 右侧近 1 个月迷你线 + 底部 5 / 30 年。取不到时标签与骨架照画(§5.1)。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "id": "bg"
      },
      {
        "type": "layer",
        "x": "12pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#9A5B2E|#D9A27A",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot",
        "_note": "源色身份点(赭)。y 锚在标题的实测框上,不写常量。"
      },
      {
        "type": "txt",
        "x": "21pt",
        "y": "11pt",
        "w": "{parent.w}-69pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "txt",
        "x": "{parent.w}-58pt",
        "y": "14pt",
        "w": "46pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "id": "at",
        "_note": "时效锚:收盘口径 = 数据日期 MM-DD。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${tnxV},__none__),__none__),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "44pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "--",
            "fontSize": "28pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${tnxV},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "type": "richText",
            "x": "12pt",
            "y": "38pt",
            "w": "-1",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "${tnxV}",
                "fontSize": "28pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "4pt"
              },
              {
                "text": "%",
                "fontSize": "13pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "76pt",
        "w": "70pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${bpt},--)]",
        "fontSize": "12pt",
        "textColor": "$[if::(eq::(${bpf},1),#9AA0A6,if::(eq::(findNotEmpty::(${bpu},__none__),__none__),#9AA0A6,if::(eq::(${bpu},1),if::(eq::(${@app.upColor},red),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bpu},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${bpu},1),#1FC77D,#FF5C4D)))),if::(eq::(${bpu},0),if::(eq::(${@app.upColor},red),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bpu},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${bpu},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${lOk},0),1),0,1)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "92pt",
            "y": "40pt",
            "w": "54pt",
            "h": "26pt",
            "bgColor": "#E7E9EE|#20232A",
            "cornerRadius": {
              "leftT": "6pt",
              "leftB": "6pt",
              "rightT": "6pt",
              "rightB": "6pt"
            }
          }
        ],
        "_note": "近 1 个月(22 个交易日收盘)的 10 年迷你线(2026-10-08 评审 P2:下半张原来只有两个小数字)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${lOk},0),1),1,0)]"
        },
        "react": [
          {
            "type": "line",
            "x": "92pt",
            "y": "40pt",
            "w": "54pt",
            "h": "26pt",
            "points": "[${l22P}]",
            "lineWidth": "1.6pt",
            "strokeColor": "#9A5B2E|#D9A27A",
            "lineCap": "round",
            "lineJoin": "round"
          },
          {
            "type": "layer",
            "x": "141.5pt",
            "y": "${l22Y}pt+37.5pt",
            "w": "5pt",
            "h": "5pt",
            "bgColor": "#9A5B2E|#D9A27A",
            "cornerRadius": {
              "leftT": "2.5pt",
              "leftB": "2.5pt",
              "rightT": "2.5pt",
              "rightB": "2.5pt"
            }
          }
        ]
      },
      {
        "type": "txt",
        "x": "92pt",
        "y": "70pt",
        "w": "54pt",
        "h": "-1",
        "text": "${@i18n.m1}",
        "fontSize": "8.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2"
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "112pt",
        "w": "60pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${fvxV},--)]",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "129.0pt",
        "w": "60pt",
        "h": "-1",
        "text": "${@i18n.y5}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "80pt",
        "y": "112pt",
        "w": "66pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${tyxV},--)]",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "80pt",
        "y": "129.0pt",
        "w": "66pt",
        "h": "-1",
        "text": "${@i18n.y30}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      }
    ],
    "i18n": {
      "zh-CN": {
        "nbsp": " ",
        "brand": "美债 10 年",
        "y5": "5 年 %",
        "y30": "30 年 %",
        "m1": "近 1 个月"
      },
      "en-US": {
        "nbsp": " ",
        "brand": "US 10Y",
        "y5": "5Y %",
        "y30": "30Y %",
        "m1": "1 month"
      }
    }
  }
}
