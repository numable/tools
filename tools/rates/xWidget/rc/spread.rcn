{
  "_note": "美债 10 年 − 2 年利差(42):左为当前利差(基点)与两端收益率,右为一年走势(每 10 个交易日一个点)。收盘口径。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "id": "bg"
      },
      {
        "type": "layer",
        "x": "14pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#9A5B2E|#D9A27A",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot",
        "_note": "源色身份点(赭)。y 锚在标题的实测框上,不写常量。"
      },
      {
        "type": "txt",
        "x": "23pt",
        "y": "12pt",
        "w": "{parent.w}-73pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "txt",
        "x": "{parent.w}-60pt",
        "y": "15pt",
        "w": "46pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "id": "at",
        "_note": "时效锚:收盘口径 = 数据日期 MM-DD。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${spT},__none__),__none__),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "14pt",
            "y": "40pt",
            "w": "{parent.w}-28pt",
            "h": "-1",
            "text": "--",
            "fontSize": "24pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${spT},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "type": "richText",
            "x": "14pt",
            "y": "38pt",
            "w": "-1",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "${spT}",
                "fontSize": "24pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "4pt"
              },
              {
                "text": "${@i18n.bp}",
                "fontSize": "13pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${inv},1),1,0)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "14pt",
            "y": "72pt",
            "w": "34pt",
            "h": "17pt",
            "bgColor": "#E7E9EE|#20232A",
            "cornerRadius": {
              "leftT": "8.5pt",
              "leftB": "8.5pt",
              "rightT": "8.5pt",
              "rightB": "8.5pt"
            }
          },
          {
            "type": "txt",
            "x": "14pt",
            "y": "72pt",
            "w": "34pt",
            "h": "17pt",
            "text": "${@i18n.inv}",
            "fontSize": "10pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0",
            "alignmentH": "1",
            "alignmentV": "1"
          }
        ]
      },
      {
        "type": "txt",
        "x": "14pt",
        "y": "112pt",
        "w": "52pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${t2},--)]",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "14pt",
        "y": "129.0pt",
        "w": "52pt",
        "h": "-1",
        "text": "${@i18n.t2}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "68pt",
        "y": "112pt",
        "w": "56pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${t10},--)]",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "68pt",
        "y": "129.0pt",
        "w": "56pt",
        "h": "-1",
        "text": "${@i18n.t10}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${sOk},0),1),0,1)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "130pt",
            "y": "40pt",
            "w": "194pt",
            "h": "74pt",
            "bgColor": "#E7E9EE|#20232A",
            "cornerRadius": {
              "leftT": "8pt",
              "leftB": "8pt",
              "rightT": "8pt",
              "rightB": "8pt"
            },
            "_note": "图位骨架(取不到时结构先行,§5.1)。"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${sOk},1),1,0)]"
        },
        "react": [
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(eq::(${zOn},1),1,0)]"
            },
            "react": [
              {
                "type": "layer",
                "x": "130pt",
                "y": "${zAbs}pt",
                "w": "194pt",
                "h": "1.2pt",
                "bgColor": "#C9CDD4|#4A505A",
                "_note": "零线(只在量程跨过 0 时画)。"
              }
            ]
          },
          {
            "type": "line",
            "x": "130pt",
            "y": "40pt",
            "w": "194pt",
            "h": "74pt",
            "points": "$[findNotEmpty::(${sPts},[0\\,0\\,1\\,0])]",
            "lineWidth": "1.8pt",
            "strokeColor": "#9A5B2E|#D9A27A",
            "lineCap": "round",
            "lineJoin": "round"
          },
          {
            "type": "layer",
            "x": "321pt",
            "y": "${sDot}pt",
            "w": "6pt",
            "h": "6pt",
            "bgColor": "#9A5B2E|#D9A27A",
            "cornerRadius": {
              "leftT": "3pt",
              "leftB": "3pt",
              "rightT": "3pt",
              "rightB": "3pt"
            }
          },
          {
            "type": "txt",
            "x": "130pt",
            "y": "122pt",
            "w": "80pt",
            "h": "-1",
            "text": "$[findNotEmpty::(${dYt},--)]",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "lineBreak": "0"
          },
          {
            "type": "txt",
            "x": "244pt",
            "y": "122pt",
            "w": "80pt",
            "h": "-1",
            "text": "$[findNotEmpty::(${dLt},--)]",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "lineBreak": "0",
            "alignmentH": "2"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "nbsp": " ",
        "bp": "基点",
        "brand": "2–10 年利差",
        "inv": "倒挂",
        "t2": "2 年 %",
        "t10": "10 年 %"
      },
      "en-US": {
        "nbsp": " ",
        "bp": "bp",
        "brand": "2s10s spread",
        "inv": "Inverted",
        "t2": "2Y %",
        "t10": "10Y %"
      }
    }
  }
}
