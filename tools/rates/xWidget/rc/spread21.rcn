{
  "_note": "2–10 年利差(21,§8.1):当前利差(基点)+ 右侧一年走势(26 个点,跨过 0 时画零线)。与 42 档同一条 ust.df(mode=spread),零新增请求。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "id": "bg"
      },
      {
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "84pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "11pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "layer",
        "x": "10pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#9A5B2E|#D9A27A",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot"
      },
      {
        "type": "txt",
        "x": "104pt",
        "y": "10.5pt",
        "w": "44pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "id": "at"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${spT},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "type": "richText",
            "x": "10pt",
            "y": "25pt",
            "w": "80pt",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "${spT}",
                "fontSize": "17pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "3pt"
              },
              {
                "text": "${@i18n.bp}",
                "fontSize": "10pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${spT},__none__),__none__),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "10pt",
            "y": "28pt",
            "w": "70pt",
            "h": "-1",
            "text": "--",
            "fontSize": "17pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "txt",
        "x": "10pt",
        "y": "46pt",
        "w": "80pt",
        "h": "-1",
        "text": "$[if::(eq::(${inv},1),${@i18n.inv},${@i18n.y1})]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(and::(eq::(findNotEmpty::(${sOk},0),1),eq::(findNotEmpty::(${zOn},0),1)),1,0)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "92pt",
            "y": "${z21}pt+24.5pt",
            "w": "56pt",
            "h": "1pt",
            "bgColor": "#C9CDD4|#4A505A",
            "_note": "零线(量程跨过 0 时画:倒挂与否一眼看出)。"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${sOk},0),1),0,1)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "92pt",
            "y": "25pt",
            "w": "56pt",
            "h": "26pt",
            "bgColor": "#E7E9EE|#20232A",
            "cornerRadius": {
              "leftT": "6pt",
              "leftB": "6pt",
              "rightT": "6pt",
              "rightB": "6pt"
            }
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${sOk},0),1),1,0)]"
        },
        "react": [
          {
            "type": "line",
            "x": "92pt",
            "y": "25pt",
            "w": "56pt",
            "h": "26pt",
            "points": "[${s21P}]",
            "lineWidth": "1.6pt",
            "strokeColor": "#9A5B2E|#D9A27A",
            "lineCap": "round",
            "lineJoin": "round"
          },
          {
            "type": "layer",
            "x": "143.5pt",
            "y": "${s21Y}pt+22.5pt",
            "w": "5pt",
            "h": "5pt",
            "bgColor": "#9A5B2E|#D9A27A",
            "cornerRadius": {
              "leftT": "2.5pt",
              "leftB": "2.5pt",
              "rightT": "2.5pt",
              "rightB": "2.5pt"
            }
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "nbsp": " ",
        "bp": "基点",
        "brand": "2–10 年利差",
        "inv": "倒挂",
        "y1": "近一年走势"
      },
      "en-US": {
        "nbsp": " ",
        "bp": "bp",
        "brand": "2s10s",
        "inv": "Inverted",
        "y1": "Past year"
      }
    }
  }
}
