{
  "_note": "美债 10 年(21,card-design-system §8.1):收益率 + 日变化(基点)+ 右侧近 1 个月迷你线。与 22 档同一条 live.df,零新增请求。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "id": "bg"
      },
      {
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "84pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "11pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "layer",
        "x": "10pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#9A5B2E|#D9A27A",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot"
      },
      {
        "type": "txt",
        "x": "104pt",
        "y": "10.5pt",
        "w": "44pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "id": "at"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${tnxV},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "type": "richText",
            "x": "10pt",
            "y": "25pt",
            "w": "80pt",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "${tnxV}",
                "fontSize": "17pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "3pt"
              },
              {
                "text": "%",
                "fontSize": "10pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${tnxV},__none__),__none__),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "10pt",
            "y": "28pt",
            "w": "70pt",
            "h": "-1",
            "text": "--",
            "fontSize": "17pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "txt",
        "x": "10pt",
        "y": "46pt",
        "w": "80pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${bpt},--)]",
        "fontSize": "9pt",
        "textColor": "$[if::(eq::(${bpf},1),#9AA0A6,if::(eq::(findNotEmpty::(${bpu},__none__),__none__),#9AA0A6,if::(eq::(${bpu},1),if::(eq::(${@app.upColor},red),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bpu},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${bpu},1),#1FC77D,#FF5C4D)))),if::(eq::(${bpu},0),if::(eq::(${@app.upColor},red),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bpu},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${bpu},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${lOk},0),1),0,1)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "92pt",
            "y": "25pt",
            "w": "56pt",
            "h": "26pt",
            "bgColor": "#E7E9EE|#20232A",
            "cornerRadius": {
              "leftT": "6pt",
              "leftB": "6pt",
              "rightT": "6pt",
              "rightB": "6pt"
            }
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${lOk},0),1),1,0)]"
        },
        "react": [
          {
            "type": "line",
            "x": "92pt",
            "y": "25pt",
            "w": "56pt",
            "h": "26pt",
            "points": "[${l21P}]",
            "lineWidth": "1.6pt",
            "strokeColor": "#9A5B2E|#D9A27A",
            "lineCap": "round",
            "lineJoin": "round"
          },
          {
            "type": "layer",
            "x": "143.5pt",
            "y": "${l21Y}pt+22.5pt",
            "w": "5pt",
            "h": "5pt",
            "bgColor": "#9A5B2E|#D9A27A",
            "cornerRadius": {
              "leftT": "2.5pt",
              "leftB": "2.5pt",
              "rightT": "2.5pt",
              "rightB": "2.5pt"
            }
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "nbsp": " ",
        "brand": "美债 10 年"
      },
      "en-US": {
        "nbsp": " ",
        "brand": "US 10Y"
      }
    }
  }
}
