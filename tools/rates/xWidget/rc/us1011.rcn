{
  "_note": "美债 10 年(11,§8.2):收益率(4 字符,20pt;美债收益率不会到两位整数)+ 底行日变化(整数基点)。无时效锚。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "id": "bg"
      },
      {
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "10pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "layer",
        "x": "8pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#9A5B2E|#D9A27A",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${tnxV},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "text": "${t10s}",
            "fontSize": "20pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${tnxV},__none__),__none__),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "text": "--",
            "fontSize": "20pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "txt",
        "x": "8pt",
        "y": "46pt",
        "w": "54pt",
        "h": "-1",
        "text": "$[if::(eq::(findNotEmpty::(${bps},--),--),--,connect::(${bps},${@i18n.nbsp},${@i18n.bp}))]",
        "fontSize": "9pt",
        "textColor": "$[if::(eq::(${bpf},1),#9AA0A6,if::(eq::(findNotEmpty::(${bpu},__none__),__none__),#9AA0A6,if::(eq::(${bpu},1),if::(eq::(${@app.upColor},red),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bpu},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${bpu},1),#1FC77D,#FF5C4D)))),if::(eq::(${bpu},0),if::(eq::(${@app.upColor},red),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bpu},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bpu},1),#FF5C4D,#1FC77D),if::(eq::(${bpu},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "maxLines": "1",
        "lineBreak": "0"
      }
    ],
    "i18n": {
      "zh-CN": {
        "nbsp": " ",
        "bp": "基点",
        "brand": "美 10 年"
      },
      "en-US": {
        "nbsp": " ",
        "bp": "bp",
        "brand": "US 10Y"
      }
    }
  }
}
