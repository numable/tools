                "text": "${@i18n.nbsp}",
                "fontSize": "3pt"
              },
              {
                "text": "%",
                "fontSize": "13pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${w_us},__none__),__none__),0,1),1),0,1)]"
        },
