{
  "_note": "10 年实际利率(TIPS)+ 日变化;底部通胀预期(名义 − 实际,近似)与名义 10 年。收盘口径,锚 = 数据日期。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "id": "bg"
      },
      {
        "type": "layer",
        "x": "12pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#9A5B2E|#D9A27A",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot",
        "_note": "源色身份点(赭)。y 锚在标题的实测框上,不写常量。"
      },
      {
        "type": "txt",
        "x": "21pt",
        "y": "11pt",
        "w": "{parent.w}-69pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "txt",
        "x": "{parent.w}-58pt",
        "y": "14pt",
        "w": "46pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "id": "at",
        "_note": "时效锚:收盘口径 = 数据日期 MM-DD。"
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "36pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${@i18n.tips}",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${r10t},__none__),__none__),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "52pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "--",
            "fontSize": "28pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${r10t},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "type": "richText",
            "x": "12pt",
            "y": "50pt",
            "w": "-1",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "${r10t}",
                "fontSize": "28pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "4pt"
              },
              {
                "text": "%",
                "fontSize": "13pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "86pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${ct},--)]",
        "fontSize": "11.5pt",
        "textColor": "$[if::(eq::(${cf},1),#9AA0A6,if::(eq::(findNotEmpty::(${cu},__none__),__none__),#9AA0A6,if::(eq::(${cu},1),if::(eq::(${@app.upColor},red),if::(eq::(${cu},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${cu},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${cu},1),#FF5C4D,#1FC77D),if::(eq::(${cu},1),#1FC77D,#FF5C4D)))),if::(eq::(${cu},0),if::(eq::(${@app.upColor},red),if::(eq::(${cu},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${cu},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${cu},1),#FF5C4D,#1FC77D),if::(eq::(${cu},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "112pt",
        "w": "64pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${bei},--)]",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "129.0pt",
        "w": "64pt",
        "h": "-1",
        "text": "${@i18n.bei}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "84pt",
        "y": "112pt",
        "w": "62pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${n10t},--)]",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "84pt",
        "y": "129.0pt",
        "w": "62pt",
        "h": "-1",
        "text": "${@i18n.nom}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      }
    ],
    "i18n": {
      "zh-CN": {
        "nbsp": " ",
        "brand": "实际利率",
        "tips": "美债 10 年 · 通胀保值",
        "bei": "通胀预期 %",
        "nom": "名义 %"
      },
      "en-US": {
        "nbsp": " ",
        "brand": "Real yield",
        "tips": "US 10Y TIPS",
        "bei": "Infl. exp. %",
        "nom": "Nominal %"
      }
    }
  }
}
