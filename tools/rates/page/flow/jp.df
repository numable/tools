{
  "_note": "日本财务省当月 JGB CSV 原文(<1KB)。原样取回,解析与首屏缓存在页面 JS 的 flowCached 里做(与 macro 同法)。",
  "_lintCache": "exempt",
  "version": 1,
  "actions": [
    {
      "id": "raw",
      "action": "request",
      "params": {
        "url": "https://www.mof.go.jp/english/policy/jgbs/reference/interest_rate/jgbcme.csv",
        "method": "GET",
        "formatType": "string",
        "timeout": "10000"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_b",
        "value": "1"
      },
      "_note": "屏障(勿删):request / concurrent 之后紧邻的节点读不到结果(memory actionflow-concurrent-late-merge)。"
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "raw"
        ]
      }
    }
  ]
}
