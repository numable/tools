        "text": "${@i18n.uD}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[if::(eq::(${mask},1),1,if::(eq::(if::(eq::(findNotEmpty::(${avgGap},--),--),0,1),1),0,1))]"
    },
    "react": [
     {
      "id": "t2E",
      "type": "txt",
      "x": "{t2.x}+10pt",
      "y": "{t2.y}+23pt+6pt",
      "w": "{t2.w}-20pt",
      "h": "-1",
      "text": "$[if::(eq::(${mask},1),••,--)]",
      "fontSize": "20pt",
      "typeface": "System-Bold",
      "textColor": "#0E1116|#F3F4F6"
     }
    ]
   }
  ]
 }
}
