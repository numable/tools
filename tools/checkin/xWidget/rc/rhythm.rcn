   {
    "id": "t1",
    "type": "layer",
    "x": "194pt",
    "y": "40pt",
    "w": "{parent.w}-208pt",
    "h": "48pt",
    "bgColor": "#E7E9EE|#20232A",
    "cornerRadius": {
     "leftT": "12pt",
     "leftB": "12pt",
     "rightT": "12pt",
     "rightB": "12pt"
    }
   },
   {
    "id": "t1L",
    "type": "txt",
    "x": "{t1.x}+10pt",
    "y": "{t1.y}+8pt",
    "w": "{t1.w}-20pt",
    "h": "-1",
    "text": "${@i18n.streak}",
    "fontSize": "10.5pt",
    "textColor": "#6B7280|#8E939B",
    "maxLines": "1"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[if::(eq::(${mask},1),0,if::(eq::(findNotEmpty::(${streak},__n__),__n__),0,1))]"
    },
    "react": [
     {
      "id": "t1V",
      "type": "richText",
      "x": "{t1.x}+10pt",
      "y": "{t1.y}+23pt",
      "w": "{t1.w}-20pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "${streak}",
        "fontSize": "20pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${@i18n.nbsp}",
        "fontSize": "14pt",
        "textColor": "#6B7280|#8E939B"
       },
       {
        "text": "${@i18n.uD}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[if::(eq::(${mask},1),1,if::(eq::(if::(eq::(findNotEmpty::(${streak},__n__),__n__),0,1),1),0,1))]"
    },
    "react": [
     {
      "id": "t1E",
      "type": "txt",
      "x": "{t1.x}+10pt",
      "y": "{t1.y}+23pt+6pt",
      "w": "{t1.w}-20pt",
      "h": "-1",
      "text": "$[if::(eq::(${mask},1),••,--)]",
      "fontSize": "20pt",
      "typeface": "System-Bold",
      "textColor": "#0E1116|#F3F4F6"
     }
    ]
   },
