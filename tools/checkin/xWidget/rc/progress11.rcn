{
  "_note": "今日进度(11,68×60,card-design-system §8.2):名 / 「做了几件 / 共几件」/ 还剩几件。2026-10-08 新增,零新增请求:取数复用 flow/progress.df(与 progress / progress21 同一条流、同一组键)。主值 ≤ 5 字符(事项上限 8 件 → 最长「8/8」),字号恒 20pt。",
  "rc": {
    "i18n": {
      "zh-CN": {
        "title": "今日",
        "leftPre": "还剩 ",
        "leftSuf": " 件",
        "allDone": "全做完了",
        "empty": "未添加",
        "masked": "已隐藏"
      },
      "en-US": {
        "title": "Today",
        "leftPre": "",
        "leftSuf": " to go",
        "allDone": "All done",
        "empty": "No habits",
        "masked": "Hidden"
      }
    },
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#F9FCFB\\,#EEF7F3)@90|linear(#15171A\\,#161B1D\\,#182221)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#2E9E6B|#45C793",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "${@i18n.title}",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${mask},1),0,if::(eq::(findNotEmpty::(${hasAny},0),1),1,0))]"
        },
        "react": [
          {
            "id": "num",
            "type": "richText",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "$[findNotEmpty::(${done},0)]",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "/$[findNotEmpty::(${total},--)]",
                "fontSize": "11pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${mask},1),1,0)]"
        },
        "react": [
          {
            "id": "numM",
            "type": "txt",
            "x": "8pt",
            "y": "28pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "••",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${mask},1),0,if::(eq::(findNotEmpty::(${hasAny},0),1),0,1))]"
        },
        "react": [
          {
            "id": "numE",
            "type": "txt",
            "x": "8pt",
            "y": "28pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "_note": "底行:做满了用源色说「全做完了」,否则「还剩 N 件」;没有事项 / 取不到时一句状态。",
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${hasAny},0),1),1,0)]"
        },
        "react": [
          {
            "id": "foot",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[if::(eq::(${mask},1),${@i18n.masked},if::(eq::(${allDone},1),${@i18n.allDone},${@i18n.leftPre}${left}${@i18n.leftSuf}))]",
            "fontSize": "9pt",
            "textColor": "$[if::(eq::(${mask},1),#6B7280|#8E939B,if::(eq::(${allDone},1),#2E9E6B|#45C793,#6B7280|#8E939B))]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${hasAny},0),1),0,1)]"
        },
        "react": [
          {
            "id": "footE",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[if::(eq::(findNotEmpty::(${hasAny},-1),0),${@i18n.empty},--)]",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      }
    ],
    "i18nEmptyOk": [
      "leftPre"
    ]
  }
}
