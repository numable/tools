      "h": "44pt",
      "text": "${@i18n.empty}",
      "fontSize": "11pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentV": "1",
      "alignmentH": "1"
     }
    ]
   },
