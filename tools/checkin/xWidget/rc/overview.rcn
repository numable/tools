        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${done},1),1,0)]"
        },
        "react": [
          {
            "id": "cD",
            "type": "txt",
            "x": "{chip.x}",
            "y": "{chip.y}+5pt",
            "w": "{chip.w}",
            "h": "-1",
            "text": "${@i18n.doneToday}",
            "fontSize": "11pt",
            "textColor": "${mc}",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${has},1),if::(eq::(${done},0),1,0),0)]"
        },
        "react": [
          {
            "id": "cT",
            "type": "txt",
            "x": "{chip.x}",
            "y": "{chip.y}+5pt",
            "w": "{chip.w}",
