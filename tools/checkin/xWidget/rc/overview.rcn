        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${has},1),0,1)]"
        },
        "react": [
          {
            "id": "cN",
            "type": "txt",
            "x": "{chip.x}",
            "y": "{chip.y}+5pt",
            "w": "{chip.w}",
            "h": "-1",
            "text": "${@i18n.never}",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
