{
  "version": 2,
  "title": "连续天数 · 小",
  "sub": "一件事 · 连着打了几天",
  "i18n": {
    "en-US": {
      "title": "Streak · tiny",
      "sub": "One habit · how many days in a row"
    }
  },
  "layout": 11,
  "params": {
    "itemId": "",
    "mask": "0"
  },
  "ai": {
    "shows": "一件事项当前连续打卡的天数",
    "params": {
      "itemId": {
        "kind": "user",
        "hint": "用户的一件打卡事项 id;留空时组件显示「选择事项」,装上后长按「编辑参数」挑一件"
      },
      "mask": {
        "kind": "enum",
        "values": {
          "0": "正常显示",
          "1": "打码:数字与格子隐去,只在 App 内能看"
        }
      }
    }
  },
  "events": {
    "onClick": "numable://self/page/item?id=${itemId}",
    "onEdit": "/edit?cur=${itemId}"
  },
  "canvas": {
    "source": "@[file://rc/streak11.rcn]",
    "depends": [
      {
        "_note": "与 streak(22)同一条流、同一组入参(§D 纯显式 {flow, params})。",
        "flow": "@[file://flow/streak.df]",
        "params": {
          "itemId": "${itemId}",
          "mask": "${mask}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "_note": "streak(22)的 1×1 版:params / events 照抄 streak.xwidget(itemId 选事项、mask=1 打码)。"
}
