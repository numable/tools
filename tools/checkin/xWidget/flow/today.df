    },
    {
      "op": "set",
      "props": {
        "key": "p1",
        "value": "$[if::(eq::(${h0},1),if::(eq::(${h1},0),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "p2",
        "value": "$[if::(eq::(${h1},1),if::(eq::(${h2},0),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "p3",
        "value": "$[if::(eq::(${h2},1),if::(eq::(${h3},0),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "p4",
        "value": "$[if::(eq::(${h3},1),if::(eq::(${h4},0),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "p5",
        "value": "$[if::(eq::(${h4},1),if::(eq::(${h5},0),1,0),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "doneRow",
        "value": "$[calc::(${d0}+${d1}+${d2}+${d3}+${d4}+${d5})]"
      }
    },
    {
      "_note": "真实事项总数(2026-10-08):原先是 6 个槽位 h0..h5 之和,第 7、8 件事被静默吞掉,页头「3/6」与 progress「5/8」对不上。",
      "op": "set",
      "props": {
        "key": "allCnt",
        "value": "$[length::(${it})]"
      }
    },
    {
      "_note": "跨事项聚合(页面 computeAgg 落盘,同 progress.df):超过 6 件时,今天达标件数以它为准 —— 行里只算得到前 6 件。",
      "id": "agg",
      "action": "data.get",
      "params": {
        "key": "agg",
        "default": {}
      }
    },
    {
      "op": "set",
      "props": {
        "key": "aggBy",
        "value": "${agg.byDay}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "doneCnt",
        "value": "$[if::(gt::(${allCnt},6),findNotEmpty::(get::(${aggBy},${todayKey}),${doneRow}),${doneRow})]"
      }
    },
    {
      "_note": "超过 6 件:第 6 行让给「还有 N 件」,只列前 5 件。",
      "op": "set",
      "props": {
        "key": "ov",
        "value": "$[if::(gt::(${allCnt},6),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "more",
        "value": "$[calc::(${allCnt}-5)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "dateLbl",
        "value": "$[formatDate::(${nowMs},MM-dd)]"
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "w0",
          "w1",
          "w2",
          "w3",
          "w4",
          "w5",
          "n0",
          "n1",
          "n2",
          "n3",
          "n4",
          "n5",
          "i0",
          "i1",
          "i2",
          "i3",
          "i4",
          "i5",
          "m0",
          "m1",
          "m2",
          "m3",
          "m4",
          "m5",
          "h0",
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "d0",
          "d1",
          "d2",
          "d3",
          "d4",
          "d5",
          "v0",
          "v1",
          "v2",
          "v3",
          "v4",
          "v5",
          "g0",
          "g1",
          "g2",
          "g3",
          "g4",
          "g5",
          "t0",
          "t1",
          "t2",
          "t3",
          "t4",
          "t5",
          "p0",
          "p1",
          "p2",
          "p3",
          "p4",
          "p5",
          "doneCnt",
          "allCnt",
          "dateLbl",
          "mask",
          "ov",
          "more"
        ]
      }
    }
  ]
}
