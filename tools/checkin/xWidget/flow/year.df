{
 "version": 1,
 "actions": [
  {
   "_note": "入参先落地成 data 域的键(§9.5 #3),再由 resultFilter 透出去 —— RCN 只看得见 flow 的输出,shell params 不进渲染域。本文件由 tools/infosource/mk_checkin_year.py 生成,别手改。",
   "op": "set",
   "props": {
    "key": "mask",
    "value": "${mask}"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "sk",
    "value": "stat_${itemId}"
   }
  },
  {
   "_note": "零网络:byDay 是不随时间变的真源桶(页面 H5 写入,留近 400 天),过去一年窗口(371 天)在读时按今天投影。",
   "id": "s",
   "action": "data.get",
   "params": {
    "key": "${sk}",
    "default": {}
   }
  },
  {
   "op": "set",
   "props": {
    "key": "byDay",
    "value": "${s.byDay}"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "pal",
    "value": "$[findNotEmpty::(${s.pal},1)]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "goalRaw",
    "value": "$[findNotEmpty::(${s.goal},1)]"
   }
  },
  {
   "_note": "目标下限钉 1:0 或空会让「达标」恒真。",
   "op": "set",
   "props": {
    "key": "goal",
    "value": "$[if::(ge::(${goalRaw},1),${goalRaw},1)]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "icon",
    "value": "$[findNotEmpty::(${s.icon},)]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "hicon",
    "value": "$[if::(eq::(findNotEmpty::(${icon},_),_),0,1)]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "iname",
    "value": "$[findNotEmpty::(${s.name},)]"
   }
  },
  {
   "_note": "check 型的合计单位是「天」(effLog 按天去重后条数=天数),count 型是「次」—— 与详情页口径一致。",
   "op": "set",
   "props": {
    "key": "ck",
    "value": "$[if::(eq::(findNotEmpty::(${s.kind},check),check),1,0)]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "e0",
    "value": "#EDEEF0|#20232A"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "hp1",
    "value": "$[if::(eq::(${pal},1),#7ABEA0|#3A896C,if::(eq::(${pal},2),#7BA2E9|#486FAD,if::(eq::(${pal},3),#A895F5|#7565AA,if::(eq::(${pal},4),#E5A982|#A1724D,if::(eq::(${pal},5),#DD91A1|#9C5B6C,#67BCC4|#318690)))))]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "hp2",
    "value": "$[if::(eq::(${pal},1),#54AE86|#40A880,if::(eq::(${pal},2),#5588E6|#5285D6,if::(eq::(${pal},3),#9178F6|#8E78D2,if::(eq::(${pal},4),#E3925E|#C88956,if::(eq::(${pal},5),#D77287|#C26A80,#3BABB6|#33A4AF)))))]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "mc",
    "value": "$[if::(eq::(${pal},1),#2E9E6B|#45C793,if::(eq::(${pal},2),#2F6FE4|#5C9BFF,if::(eq::(${pal},3),#7A5AF8|#A78BFA,if::(eq::(${pal},4),#E07B39|#F0A05F,if::(eq::(${pal},5),#D2536D|#E87A93,#0E9AA7|#35C2CE)))))]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "nowMs",
    "value": "${@time.nowMs}"
   }
  },
  {
   "_note": "按自然日归零再相减(同 days.df)。",
   "op": "set",
   "props": {
    "key": "todayMs",
    "value": "$[parseDate::(formatDate::(${nowMs},yyyy-MM-dd),yyyy-MM-dd)]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "k0",
    "value": "$[formatDate::(calc::(${todayMs}-0),yyyy-MM-dd)]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "v0",
    "value": "$[findNotEmpty::(get::(${byDay},${k0}),0)]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "d0",
    "value": "$[if::(ge::(${v0},${goal}),${mc},if::(ge::(calc::(${v0}*2),${goal}),${hp2},if::(ge::(${v0},1),${hp1},${e0})))]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "k1",
    "value": "$[formatDate::(calc::(${todayMs}-86400000),yyyy-MM-dd)]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "v1",
    "value": "$[findNotEmpty::(get::(${byDay},${k1}),0)]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "d1",
    "value": "$[if::(ge::(${v1},${goal}),${mc},if::(ge::(calc::(${v1}*2),${goal}),${hp2},if::(ge::(${v1},1),${hp1},${e0})))]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "k2",
    "value": "$[formatDate::(calc::(${todayMs}-172800000),yyyy-MM-dd)]"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "v2",
    "value": "$[findNotEmpty::(get::(${byDay},${k2}),0)]"
   }
  },
