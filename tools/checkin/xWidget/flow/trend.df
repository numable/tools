{
  "_note": "趋势(checkin trend 卡,单个事项)。生成器 gen_record_trend.py。",
  "version": 1,
  "actions": [
    {
      "op": "set",
      "props": {
        "key": "mask",
        "value": "${mask}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "sk",
        "value": "stat_${itemId}"
      }
    },
    {
      "id": "s",
      "action": "data.get",
      "params": {
        "key": "${sk}",
        "default": {}
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_b",
        "value": "1"
      },
      "_note": "⚠️ 请求/并发屏障(勿删):request 与 concurrent 之后**紧邻**的节点读不到响应(晚一拍合并,memory [[actionflow-concurrent-late-merge]])。删掉它 → 下面所有 index:: 静默取空 → 卡渲一片 `--`,而流仍报 success。"
    },
    {
      "op": "set",
      "props": {
        "key": "byDay",
        "value": "${s.byDay}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pal",
        "value": "$[findNotEmpty::(${s.pal},1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ttl",
        "value": "$[findNotEmpty::(${alias},findNotEmpty::(${s.name},))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "mc",
        "value": "$[if::(eq::(${pal},1),#2E9E6B|#45C793,if::(eq::(${pal},2),#2F6FE4|#5C9BFF,if::(eq::(${pal},3),#7A5AF8|#A78BFA,if::(eq::(${pal},4),#E07B39|#F0A05F,if::(eq::(${pal},5),#D2536D|#E87A93,#0E9AA7|#35C2CE)))))]"
      },
      "_note": "事项色板(与 days.df 同一张表)。"
    },
    {
      "op": "set",
      "props": {
        "key": "mc2",
        "value": "$[if::(eq::(${pal},1),#9FD2BA|#2F6F57,if::(eq::(${pal},2),#A6C1F2|#2F4D80,if::(eq::(${pal},3),#C3B3FB|#4F4380,if::(eq::(${pal},4),#F0BF9C|#7A5234,if::(eq::(${pal},5),#E9A9B6|#7A4452,#8FD0D6|#23636A)))))]"
      },
      "_note": "同色的淡一档:非最多的星期 / 往周。"
    },
    {
      "op": "set",
      "props": {
        "key": "todayMs",
        "value": "$[parseDate::(formatDate::(${@time.nowMs},yyyy-MM-dd),yyyy-MM-dd)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "off",
        "value": "$[round::(calc::((${todayMs}-parseDate::(2026-09-21,yyyy-MM-dd))/86400000))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "wT",
        "value": "$[calc::(${off}-floor::(calc::(${off}/7))*7)]"
      },
      "_note": "今天星期几:0 = 周一 … 6 = 周日。"
    },
    {
      "op": "set",
      "props": {
        "key": "cnd",
        "value": "$[if::(eq::(${@app.region},cn),1,if::(eq::(${@app.region},overseas),0,if::(startsWith::(${@app.language},zh),1,0)))]"
      },
      "_note": "国内默认判据(§1,逐字)。"
    },
    {
      "op": "set",
      "props": {
        "key": "_fw",
        "value": "$[findNotEmpty::(${@app.firstWeekday},none)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "fw",
        "value": "$[if::(eq::(${_fw},none),if::(eq::(${cnd},1),1,7),${_fw})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "sh",
        "value": "$[round::(calc::(${fw}-1),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "WL",
        "value": [
          "一",
          "二",
          "三",
          "四",
          "五",
          "六",
          "日"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "WN",
        "value": [
          "周一",
          "周二",
          "周三",
          "周四",
          "周五",
          "周六",
          "周日"
        ]
      }
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(startsWith::(${@app.language},zh),0,1)]"
      },
      "items": [
        {
          "op": "set",
          "props": {
            "key": "WL",
            "value": [
              "M",
              "T",
              "W",
              "T",
              "F",
              "S",
              "S"
            ]
          }
        },
        {
          "op": "set",
          "props": {
            "key": "WN",
            "value": [
              "Mon",
              "Tue",
              "Wed",
              "Thu",
              "Fri",
              "Sat",
              "Sun"
            ]
          }
        }
      ]
    },
    {
      "op": "set",
      "props": {
        "key": "L0",
        "value": "$[index::(${WL},calc::(0+${sh}-floor::(calc::((0+${sh})/7))*7))]"
      },
      "_note": "第 j 根星期柱的标签(按周首旋转;中文 一…日 / 英文 M…S)。"
    },
    {
      "op": "set",
      "props": {
        "key": "L1",
        "value": "$[index::(${WL},calc::(1+${sh}-floor::(calc::((1+${sh})/7))*7))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "L2",
        "value": "$[index::(${WL},calc::(2+${sh}-floor::(calc::((2+${sh})/7))*7))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "L3",
        "value": "$[index::(${WL},calc::(3+${sh}-floor::(calc::((3+${sh})/7))*7))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "L4",
        "value": "$[index::(${WL},calc::(4+${sh}-floor::(calc::((4+${sh})/7))*7))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "L5",
        "value": "$[index::(${WL},calc::(5+${sh}-floor::(calc::((5+${sh})/7))*7))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "L6",
        "value": "$[index::(${WL},calc::(6+${sh}-floor::(calc::((6+${sh})/7))*7))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k0",
        "value": "$[formatDate::(calc::(${todayMs}-0*86400000+43200000),yyyy-MM-dd)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "v0",
        "value": "$[findNotEmpty::(get::(${byDay},${k0}),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1",
        "value": "$[formatDate::(calc::(${todayMs}-1*86400000+43200000),yyyy-MM-dd)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "v1",
        "value": "$[findNotEmpty::(get::(${byDay},${k1}),0)]"
