{"version":1,"_note":"信息源页海报专用(tools/banner/dyn_personal.py 生成,不要手改),组件不用。","actions":[{"id":"it","action":"data.get","params":{"key":"items","default":[]}},{"op":"set","props":{"key":"_b","value":"1"},"_note":"⚠️ 请求屏障(勿删):request 之后紧邻的节点读不到响应(晚一拍合并)。"},{"op":"set","props":{"key":"iid","value":"$[findNotEmpty::(${it[0].id},)]"}},{"op":"set","props":{"key":"nm","value":"$[findNotEmpty::(${it[0].name},)]"}},{"op":"set","props":{"key":"has","value":"$[if::(eq::(${iid},),0,1)]"}},{"op":"set","props":{"key":"sk","value":"stat_${iid}"}},{"id":"s","action":"data.get","params":{"key":"${sk}","default":{}}},{"op":"set","props":{"key":"_b","value":"1"},"_note":"⚠️ 请求屏障(勿删):request 之后紧邻的节点读不到响应(晚一拍合并)。"},{"op":"set","props":{"key":"byDay","value":"${s.byDay}"}},{"op":"set","props":{"key":"goalRaw","value":"$[findNotEmpty::(${s.goal},1)]"}},{"op":"set","props":{"key":"goal","value":"$[if::(ge::(${goalRaw},1),${goalRaw},1)]"},"_note":"目标下限钉 1(同 days.df)。"},{"op":"set","props":{"key":"nowMs","value":"${@time.nowMs}"}},{"op":"set","props":{"key":"todayKey","value":"$[formatDate::(${nowMs},yyyy-MM-dd)]"}},{"op":"set","props":{"key":"todayMs","value":"$[parseDate::(${todayKey},yyyy-MM-dd)]"}},{"op":"set","props":{"key":"noon","value":"$[calc::(${todayMs}+43200000)]"},"_note":"正午锚点:往前按天减不会被夏令时切到前一天。"},{"op":"set","props":{"key":"todayCnt","value":"$[findNotEmpty::(get::(${byDay},${todayKey}),0)]"}},{"op":"set","props":{"key":"done","value":"$[if::(ge::(${todayCnt},${goal}),1,0)]"}},{"op":"set","props":{"key":"lastDayMs","value":"$[parseDate::(formatDate::(findNotEmpty::(${s.lastTs},0),yyyy-MM-dd),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"alive","value":"$[if::(eq::(findNotEmpty::(${s.lastTs},__none__),__none__),0,if::(ge::(${lastDayMs},calc::(${todayMs}-86400000)),1,0))]"}},{"op":"set","props":{"key":"endDayMs","value":"$[parseDate::(formatDate::(findNotEmpty::(${s.streakEnd},findNotEmpty::(${s.lastTs},0)),yyyy-MM-dd),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"streak","value":"$[i