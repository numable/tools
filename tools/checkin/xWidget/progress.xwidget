{
  "version": 2,
  "title": "今日进度",
  "sub": "所有事项 · 今天达标了几件",
  "i18n": {
    "en-US": {
      "title": "Today's progress",
      "sub": "All habits · how many met today"
    }
  },
  "layout": 22,
  "params": {
    "mask": "0"
  },
  "ai": {
    "shows": "今天所有打卡事项里达标了几件 / 共几件,分段进度条;还没有事项时提示添加",
    "params": {
      "mask": {
        "kind": "enum",
        "values": {
          "0": "正常显示",
          "1": "打码:数字与格子隐去,只在 App 内能看"
        }
      }
    }
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/progress.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/progress.df]",
        "params": {
          "mask": "${mask}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "_note": "跨所有事项的今日进度。**不绑定具体事项** —— 它回答的是「今天还剩什么」,而不是「某一件事怎么样」(那是 streak/recent/rhythm/overview 四张的事)。"
}
