{
  "version": 2,
  "title": "今日进度 · 迷你",
  "sub": "所有事项 · 今天达标了几件",
  "i18n": {
    "en-US": {
      "title": "Today's progress · mini",
      "sub": "All habits · how many met today"
    }
  },
  "layout": 21,
  "params": {
    "mask": "0"
  },
  "ai": {
    "shows": "迷你条:今天所有打卡事项里达标了几件 / 共几件",
    "params": {
      "mask": {
        "kind": "enum",
        "values": {
          "0": "正常显示",
          "1": "打码:数字与格子隐去,只在 App 内能看"
        }
      }
    }
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/progress21.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/progress.df]",
        "params": {
          "mask": "${mask}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "_note": "progress(22)的迷你版:params / events 照抄 progress.xwidget。"
}
