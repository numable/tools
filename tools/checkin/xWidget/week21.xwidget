{
  "version": 2,
  "title": "近 7 天达标 · 迷你",
  "sub": "所有事项 · 今天几件 + 近 7 天七格",
  "i18n": {
    "en-US": {
      "title": "Last 7 days · mini",
      "sub": "All habits · today's count + last 7 days"
    }
  },
  "layout": 21,
  "params": {
    "mask": "0"
  },
  "ai": {
    "shows": "迷你条:今天所有打卡事项达标几件 / 共几件,加近 7 天每天达标浓淡七格(今天描边)",
    "params": {
      "mask": {
        "kind": "enum",
        "values": {
          "0": "正常显示",
          "1": "打码:数字与格子隐去,只在 App 内能看"
        }
      }
    }
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/week21.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/week.df]",
        "params": {
          "mask": "${mask}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "_note": "week(42)的 1×2 版(2026-10-08 新增):零新增请求,复用 flow/week.df;params / events 照抄 week。"
}
