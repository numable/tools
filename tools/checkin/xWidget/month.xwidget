{
  "version": 2,
  "title": "近一个月",
  "sub": "所有事项 · 近 35 天，一天一格 + 三项统计（大号）",
  "i18n": {
    "en-US": {
      "title": "Last 35 days",
      "sub": "All habits · last 35 days, one cell a day + 3 stats (large)"
    }
  },
  "layout": 44,
  "params": {
    "mask": "0"
  },
  "ai": {
    "shows": "所有打卡事项近 35 天每天达标几件的热力格,加今天、有记录天数、达标次数三项",
    "params": {
      "mask": {
        "kind": "enum",
        "values": {
          "0": "正常显示",
          "1": "打码:数字与格子隐去,只在 App 内能看"
        }
      }
    }
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/month.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/month.df]",
        "params": {
          "mask": "${mask}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "_note": "35 格跨事项热力 + 三项统计。与 today(44) 的分工:today 是今天的横切面,这张是一个月的纵深。"
}
