{
  "_note": "趋势(42,v33 新增)。单个事项,参数与点击同 rhythm。生成器 gen_record_trend.py。",
  "version": 2,
  "title": "趋势",
  "sub": "一件事 · 近 12 周每周几次 + 星期分布",
  "i18n": {
    "en-US": {
      "title": "Trend",
      "sub": "One habit · weekly count for 12 weeks + by weekday"
    }
  },
  "layout": 42,
  "params": {
    "itemId": "",
    "alias": "",
    "mask": "0"
  },
  "ai": {
    "shows": "一件事项近 12 周每周打卡次数与周均,加最常打卡的星期",
    "params": {
      "itemId": {
        "kind": "user",
        "hint": "用户的一件打卡事项 id;留空时组件显示「选择事项」,装上后长按「编辑参数」挑一件"
      },
      "alias": {
        "kind": "user",
        "hint": "卡上名字的手写覆盖,留空 = 显示事项本身的名字"
      },
      "mask": {
        "kind": "enum",
        "values": {
          "0": "正常显示",
          "1": "打码:数字与格子隐去,只在 App 内能看"
        }
      }
    }
  },
  "events": {
    "onClick": "numable://self/page/item?id=${itemId}",
    "onEdit": "/edit?cur=${itemId}"
  },
  "canvas": {
    "source": "@[file://rc/trend.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/trend.df]",
        "params": {
          "itemId": "${itemId}",
          "mask": "${mask}",
          "alias": "${alias}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  }
}
