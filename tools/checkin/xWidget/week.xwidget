{
  "version": 2,
  "title": "本周节奏",
  "sub": "所有事项 · 近 7 天，一天一根柱（宽幅）",
  "i18n": {
    "en-US": {
      "title": "This week",
      "sub": "All habits · last 7 days, one bar a day (wide)"
    }
  },
  "layout": 42,
  "params": {
    "mask": "0"
  },
  "ai": {
    "shows": "所有打卡事项近 7 天每天达标几件,一天一格,最后一格是今天",
    "params": {
      "mask": {
        "kind": "enum",
        "values": {
          "0": "正常显示",
          "1": "打码:数字与格子隐去,只在 App 内能看"
        }
      }
    }
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/week.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/week.df]",
        "params": {
          "mask": "${mask}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "_note": "近 7 天的跨事项浓淡,最后一格恒是今天。rhythm(42) 的聚合版:那张看一件事,这张看整体。"
}
