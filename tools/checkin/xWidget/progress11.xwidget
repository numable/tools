{
  "version": 2,
  "title": "今日进度 · 小",
  "sub": "所有事项 · 今天做了几件",
  "i18n": {
    "en-US": {
      "title": "Today's progress · tiny",
      "sub": "All habits · how many done today"
    }
  },
  "layout": 11,
  "params": {
    "mask": "0"
  },
  "ai": {
    "shows": "微型:今天所有打卡事项里达标了几件 / 共几件,底行还剩几件",
    "params": {
      "mask": {
        "kind": "enum",
        "values": {
          "0": "正常显示",
          "1": "打码:数字与格子隐去,只在 App 内能看"
        }
      }
    }
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/progress11.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/progress.df]",
        "params": {
          "mask": "${mask}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "_note": "progress(22)的 1×1 版(2026-10-08 新增):零新增请求,复用 flow/progress.df;params / events 照抄 progress。"
}
