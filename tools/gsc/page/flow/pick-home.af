{
  "_note": "首页加卡:只列**不需要先指定单个对象**的卡(§8.1 判据)。\n⚠️ 不落盘:落盘只发生在面板里的原生按钮上,流里别接「已添加」。",
  "version": 1,
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "op": "set",
      "props": {
        "key": "picks",
        "value": [
          {
            "id": "sites"
          }
        ]
      }
    },
    {
      "action": "widget.pick",
      "params": {
        "items": "${picks}"
      }
    }
  ]
}
