                "nd": "${m3nd}"
              },
              {
                "u": "${k4}",
                "n": "${nm4}",
                "c": "${m4clicks}",
                "im": "${m4imps}",
                "ct": "${m4ctr}",
                "p": "${m4pos}",
                "nd": "${m4nd}"
              },
              {
                "u": "${k5}",
                "n": "${nm5}",
                "c": "${m5clicks}",
                "im": "${m5imps}",
                "ct": "${m5ctr}",
                "p": "${m5pos}",
                "nd": "${m5nd}"
              },
              {
                "u": "${k6}",
                "n": "${nm6}",
                "c": "${m6clicks}",
                "im": "${m6imps}",
                "ct": "${m6ctr}",
                "p": "${m6pos}",
                "nd": "${m6nd}"
              }
            ]
          }
        },
        {
          "_note": "写回哨兵:**直接取响应字段,不加任何兜底** —— 取数失败/响应变形时它必空。别拿加工后的显示字段当判据,那些几乎都带兜底,拦不住任何东西。",
          "op": "set",
          "props": {
            "key": "_guard",
            "value": "${sr.siteEntry[0].siteUrl}"
          }
        },
        {
          "_note": "整份渲染输入打包落盘。⚠️ 键集必须与 resultFilter 完全一致 —— 少一个,命中缓存那趟就少一个字段(而且不报错)。",
          "op": "set",
          "props": {
            "key": "pack",
            "value": {
              "ok": "${ok}",
              "errMsg": "${errMsg}",
              "total": "${total}",
              "tShow": "${tShow}",
              "list": "${list}",
              "range": "${range}",
              "k1": "${k1}",
              "nm1": "${nm1}",
              "m1clicks": "${m1clicks}",
              "m1imps": "${m1imps}",
              "m1ctr": "${m1ctr}",
              "m1pos": "${m1pos}",
              "m1nd": "${m1nd}",
              "chgA": "${chgA}",
              "up": "${up}",
              "flat": "${flat}",
              "hpts": "${hpts}",
              "hly": "${hly}",
              "ts": "${nowMs}",
              "schema": "${SCHEMA}"
            }
          }
        },
        {
          "_note": "契约 4(§5.5.2):关键字段非空才写回。`_guard` 在取数失败/响应变形时必空 —— 此时什么都不写,盘上的旧货留着继续渲。一次超时把 pack 写成空,就把这页永久钉死在空态上直到下次恰好成功。",
          "op": "if",
          "props": {
            "val": "$[if::(gt::(length::(${_guard}),0),1,0)]"
          },
          "items": [
            {
              "action": "data.set",
              "params": {
                "key": "${ckey}",
                "value": "${pack}"
              }
            }
          ]
        }
      ]
    },
    {
      "_note": "统一出口:走没走网络都从缓存对象取渲染输入 —— 两条路径只有一份字段映射,不会出现「命中那条少算一个字段」的分叉。",
      "id": "box",
      "action": "data.get",
      "params": {
        "key": "${ckey}",
        "default": {}
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ok",
        "value": "${box.ok}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "errMsg",
        "value": "${box.errMsg}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "total",
        "value": "${box.total}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tShow",
        "value": "${box.tShow}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "list",
        "value": "${box.list}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "range",
        "value": "${box.range}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k1",
        "value": "${box.k1}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "nm1",
        "value": "${box.nm1}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "m1clicks",
        "value": "${box.m1clicks}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "m1imps",
        "value": "${box.m1imps}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "m1ctr",
        "value": "${box.m1ctr}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "m1pos",
        "value": "${box.m1pos}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "m1nd",
        "value": "${box.m1nd}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "chgA",
        "value": "${box.chgA}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "up",
        "value": "${box.up}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "flat",
        "value": "${box.flat}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hpts",
        "value": "${box.hpts}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hly",
        "value": "${box.hly}"
      }
    },
    {
      "_note": "外传①:这次渲染用的缓存键。跑在 reloadPage **之后**的流(下拉穿透、切对象校新)拿不到 depends 输出,只能读盘;让它们读结果而不是重算判据 —— AF 没有子流程调用,判据抄几份就会有一天「删的键 ≠ 渲的键」,那时下拉安静地刷不动、日志还全绿。",
      "action": "data.set",
      "params": {
        "key": "c.gsc.home._cur",
        "value": "${ckey}"
      }
    },
    {
      "_note": "外传②:这次出的是不是旧货。",
      "action": "data.set",
      "params": {
        "key": "c.gsc.home._stale",
        "value": "${_stale}"
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "_stale",
          "ckey",
          "ok",
          "errMsg",
          "total",
          "tShow",
          "list",
          "range",
          "k1",
          "nm1",
          "m1clicks",
          "m1imps",
          "m1ctr",
          "m1pos",
          "m1nd",
          "chgA",
          "up",
          "flat",
          "hpts",
          "hly"
        ]
      },
      "_note": "resultFilter 恒放最后;少透一个键,下游就是空参。⚠️ `_stale`/`ckey` 是校新那条路的入参,别删。"
    }
  ]
}
