{
  "_note": "站点详情页加卡:两张卡各带这个站点(§8.1 判据)。",
  "version": 1,
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "op": "set",
      "props": {
        "key": "picks",
        "value": [
          {
            "id": "traffic",
            "params": {
              "site": "${site}",
              "siteName": "${label}"
            }
          },
          {
            "id": "mini",
            "params": {
              "site": "${site}",
              "siteName": "${label}"
            }
          }
        ]
      }
    },
    {
      "action": "widget.pick",
      "params": {
        "items": "${picks}"
      }
    }
  ]
}
