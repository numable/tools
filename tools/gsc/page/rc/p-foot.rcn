{
  "rc": {
    "cells": [
      {
        "id": "f",
        "type": "txt",
        "x": "0pt",
        "y": "8pt",
        "w": "{parent.w}",
        "h": "-1",
        "maxLines": "8",
        "text": "${@i18n.foot}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B"
      }
    ],
    "i18n": {
      "zh-CN": {
        "foot": "数据来源：Google Search Console API（你自己的账号，只读授权）。授权走 PKCE 公有客户端，令牌只存本机保险箱、不上传、不进包、不进备份，可随时在 Google 账号「第三方应用」里撤销。搜索数据本身滞后约 2–3 天，页面每小时之内不重复取数。"
      },
      "en-US": {
        "foot": "Source: Google Search Console API (your own account, read-only). Authorization uses a PKCE public client; the token lives only in the on-device vault — never uploaded, bundled, or backed up — and you can revoke it anytime under Google Account → Third-party apps. Search data itself lags 2–3 days; this page will not re-fetch within an hour."
      }
    }
  }
}
