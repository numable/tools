{
  "rc": {
    "cells": [
      {
        "id": "t",
        "type": "txt",
        "x": "0pt",
        "y": "3pt",
        "w": "{parent.w}-120pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${label},--)]",
        "fontSize": "24pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${ok},1),1,0)]"
        },
        "react": [
          {
            "id": "at",
            "type": "txt",
            "x": "{parent.w}-{at.w}",
            "y": "0pt",
            "w": "-1",
            "h": "26pt",
            "alignmentV": "1",
            "maxLines": "1",
            "text": "${@i18n.asOf}",
            "fontSize": "12pt",
            "typeface": "System",
            "textColor": "#6B7280|#8E939B",
            "bgColor": "#0E0E1116|#14F3F4F6",
            "paddingLeft": "26pt",
            "paddingRight": "10pt",
            "cornerRadius": {
              "leftT": "13pt",
              "leftB": "13pt",
              "rightT": "13pt",
              "rightB": "13pt"
            },
            "_note": "时效锚(page-design-system §1.1)—— 由 tools/infosource/mk_anchor.py rcn_nodes() 生成,改规格改那里。",
            "events": {
              "onClick": "@[file://page/flow/site-refresh.af]"
            }
          },
          {
            "id": "atIc",
            "type": "path",
            "x": "{at.x}+8pt",
            "y": "{at.y}+6.5pt",
            "w": "13pt",
            "h": "13pt",
            "viewBox": "0 0 256 256",
            "d": "M224,48V96a8,8,0,0,1-8,8H168a8,8,0,0,1,0-16h28.69L182.06,73.37a79.56,79.56,0,0,0-56.13-23.43h-.45A79.52,79.52,0,0,0,69.59,72.71,8,8,0,0,1,58.41,61.27a96,96,0,0,1,135,.79L208,76.69V48a8,8,0,0,1,16,0ZM186.41,183.29a80,80,0,0,1-112.47-.66L59.31,168H88a8,8,0,0,0,0-16H40a8,8,0,0,0-8,8v48a8,8,0,0,0,16,0V179.31l14.63,14.63A95.43,95.43,0,0,0,130,222.06h.53a95.36,95.36,0,0,0,67.07-27.33,8,8,0,0,0-11.18-11.44Z",
            "fillColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "id": "s",
        "type": "txt",
        "x": "0pt",
        "y": "34pt",
        "w": "{parent.w}-4pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${mclicks},--)]${@i18n.uClicks} · $[if::(eq::(findNotEmpty::(${ok},0),1),findNotEmpty::(${qn},0),--)]${@i18n.uQueries}",
        "fontSize": "12pt",
        "textColor": "#6B7280|#8E939B"
      }
    ],
    "i18n": {
      "zh-CN": {
        "asOf": "截至 3 天前",
        "uClicks": " 次点击",
        "uQueries": " 个词"
      },
      "en-US": {
        "asOf": "through 3d ago",
        "uClicks": " clicks",
        "uQueries": " queries"
      }
    }
  }
}
