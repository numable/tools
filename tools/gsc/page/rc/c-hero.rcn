{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "id": "site",
        "type": "txt",
        "x": "16pt",
        "y": "18pt",
        "w": "{parent.w}-140pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${label},--)]",
        "fontSize": "16pt",
        "typeface": "System-Bold",
        "textColor": "#1A73E8|#8AB4F8"
      },
      {
        "id": "win",
        "type": "txt",
        "x": "{parent.w}-124pt",
        "y": "20pt",
        "w": "102pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "${@i18n.d28}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mnd},0),1),1,0)]"
        },
        "_note": "新站点还没数据(v37):一句话替掉大数字与环比。",
        "react": [
          {
            "id": "nd1",
            "type": "txt",
            "x": "16pt",
            "y": "54pt",
            "w": "{parent.w}-40pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.noData}",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "id": "nd2",
            "type": "txt",
            "x": "16pt",
            "y": "86pt",
            "w": "{parent.w}-40pt",
            "h": "-1",
            "maxLines": "2",
            "text": "${@i18n.noDataS}",
            "fontSize": "12pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mclicks},--),--),0,1)]"
        },
        "react": [
          {
            "id": "num",
            "type": "txt",
            "x": "16pt",
            "y": "48pt",
            "w": "250pt",
            "h": "-1",
            "maxLines": "1",
            "text": "$[findNotEmpty::(${mclicks},--)]",
            "fontSize": "38pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "hide": "$[if::(eq::(findNotEmpty::(${mnd},0),1),1,0)]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mclicks},--),--),1,0)]"
        },
        "react": [
          {
            "id": "numE",
            "type": "txt",
            "x": "16pt",
            "y": "59.5pt",
            "w": "250pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "38pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "hide": "$[if::(eq::(findNotEmpty::(${mnd},0),1),1,0)]"
          }
        ]
      },
      {
        "id": "unit",
        "type": "txt",
        "x": "16pt",
        "y": "100pt",
        "w": "60pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.clicks}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(findNotEmpty::(${mnd},0),1),1,0)]"
      },
      {
        "id": "tri",
        "type": "path",
        "x": "64.0pt",
        "y": "100.7pt",
        "w": "10pt",
        "h": "6.60pt",
        "d": "$[if::(eq::(${up},1),M128 64 L240 192 L16 192 Z,M128 192 L16 64 L240 64 Z)]",
        "viewBox": "0 0 256 256",
        "fillColor": "$[if::(eq::(${flat},1),#9AA0A6,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6,if::(eq::(${up},1),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(eq::(${up},0),if::(eq::(${up},1),#1FC77D,#FF5C4D),#9AA0A6))))]",
        "hide": "$[if::(eq::(${flat},1),1,if::(gt::(length::(${up}),0),0,1))]"
      },
      {
        "id": "flatBar",
        "type": "layer",
        "x": "64.0pt",
        "y": "103.25pt",
        "w": "8.0pt",
        "h": "1.5pt",
        "bgColor": "#9AA0A6|#8E939B",
        "hide": "$[if::(eq::(${flat},1),0,1)]"
      },
      {
        "id": "pct",
        "type": "txt",
        "x": "79pt",
        "y": "99pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(${flat},1),${@i18n.flat},connect::(findNotEmpty::(${chgA},--),%))]",
        "fontSize": "14pt",
        "typeface": "System-Bold",
        "textColor": "$[if::(eq::(${flat},1),#9AA0A6,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6,if::(eq::(${up},1),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(eq::(${up},0),if::(eq::(${up},1),#1FC77D,#FF5C4D),#9AA0A6))))]",
        "hide": "$[if::(eq::(findNotEmpty::(${mnd},0),1),1,0)]"
      },
      {
        "id": "vs",
        "type": "txt",
        "x": "{pct.r}+6pt",
        "y": "100pt",
        "w": "90pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.vs}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(findNotEmpty::(${mnd},0),1),1,0)]"
      }
    ],
    "i18n": {
      "zh-CN": {
        "d28": "近 28 天",
        "vs": "环比",
        "flat": "持平",
        "noData": "还没有搜索数据",
        "noDataS": "新验证的站点通常 2–3 天后开始有数据",
        "clicks": "点击"
      },
      "en-US": {
        "d28": "Last 28 days",
        "vs": "vs prev",
        "flat": "flat",
        "noData": "No search data yet",
        "noDataS": "Newly verified sites usually get data in 2–3 days",
        "clicks": "Clicks"
      }
    }
  }
}
