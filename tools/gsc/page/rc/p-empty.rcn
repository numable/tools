{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "id": "t",
        "type": "txt",
        "x": "16pt",
        "y": "27.5pt",
        "w": "{parent.w}-32pt",
        "h": "-1",
        "alignmentH": "1",
        "maxLines": "1",
        "text": "${@i18n.emptyT}",
        "fontSize": "14pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "s",
        "type": "txt",
        "x": "16pt",
        "y": "51.5pt",
        "w": "{parent.w}-32pt",
        "h": "-1",
        "alignmentH": "1",
        "maxLines": "2",
        "text": "${@i18n.emptyS}",
        "fontSize": "12pt",
        "textColor": "#6B7280|#8E939B"
      }
    ],
    "i18n": {
      "zh-CN": {
        "emptyT": "这个账号下没有站点",
        "emptyS": "先在 Search Console 里添加并验证一个站点"
      },
      "en-US": {
        "emptyT": "No sites on this account",
        "emptyS": "Add and verify a site in Search Console first"
      }
    }
  }
}
