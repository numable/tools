{
  "rc": {
    "cells": [
      {
        "id": "t",
        "type": "txt",
        "x": "0pt",
        "y": "4pt",
        "w": "{parent.w}-120pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.mine}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "v",
        "type": "txt",
        "x": "{parent.w}-118pt",
        "y": "4pt",
        "w": "118pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${total},0)]${@i18n.uSites}",
        "fontSize": "13pt",
        "textColor": "#6B7280|#8E939B"
      }
    ],
    "i18n": {
      "zh-CN": {
        "mine": "我的站点",
        "uSites": " 个站点"
      },
      "en-US": {
        "mine": "My sites",
        "uSites": " site(s)"
      }
    }
  }
}
