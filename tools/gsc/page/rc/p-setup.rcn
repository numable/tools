{
  "rc": {
    "cells": [
      {
        "id": "ic",
        "type": "img",
        "x": "16pt",
        "y": "14pt",
        "w": "30pt",
        "h": "30pt",
        "url": "@[file://page/assets/setup-key.$[if::(eq::(${theme},dark),d,l)].uri]"
      },
      {
        "id": "t",
        "type": "txt",
        "x": "16pt",
        "y": "{ic.b}+12pt",
        "w": "{parent.w}-32pt",
        "h": "-1",
        "maxLines": "2",
        "text": "${@i18n.setupT}",
        "fontSize": "17pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "lead",
        "type": "txt",
        "x": "16pt",
        "y": "{t.b}+8pt",
        "w": "{parent.w}-32pt",
        "h": "-1",
        "maxLines": "3",
        "text": "${@i18n.setupS}",
        "fontSize": "12.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "n1",
        "type": "txt",
        "x": "16pt",
        "y": "{lead.b}+20pt",
        "w": "20pt",
        "h": "20pt",
        "alignmentH": "1",
        "alignmentV": "1",
        "maxLines": "1",
        "text": "1",
        "fontSize": "11.5pt",
        "typeface": "System-Bold",
        "textColor": "#FFFFFF|#0B0C0E",
        "bgColor": "#1A73E8|#8AB4F8",
        "cornerRadius": {
          "leftT": "10pt",
          "leftB": "10pt",
          "rightT": "10pt",
          "rightB": "10pt"
        }
      },
      {
        "id": "st1",
        "type": "txt",
        "x": "{n1.r}+10pt",
        "y": "{n1.y}+1pt",
        "w": "{parent.w}-{n1.r}-26pt",
        "h": "-1",
        "maxLines": "2",
        "text": "${@i18n.s1t}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "sd1",
        "type": "txt",
        "x": "{st1.x}",
        "y": "{st1.b}+3pt",
        "w": "{st1.w}",
        "h": "-1",
        "maxLines": "3",
        "text": "${@i18n.s1d}",
        "fontSize": "12pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "sa1",
        "type": "txt",
        "x": "{sd1.x}",
        "y": "{sd1.b}+8pt",
        "w": "151.4pt",
        "h": "30pt",
        "alignmentH": "1",
        "alignmentV": "1",
        "maxLines": "1",
        "text": "${@i18n.s1a} ›",
        "fontSize": "12pt",
        "typeface": "System-Bold",
        "textColor": "#1A73E8|#8AB4F8",
        "bgColor": "#141A73E8|#1F8AB4F8",
        "cornerRadius": {
          "leftT": "15pt",
          "leftB": "15pt",
          "rightT": "15pt",
          "rightB": "15pt"
        },
        "events": {
          "onClick": "@[file://page/flow/open-console.af]"
        }
      },
      {
        "id": "n2",
        "type": "txt",
        "x": "16pt",
        "y": "{sa1.b}+20pt",
        "w": "20pt",
        "h": "20pt",
        "alignmentH": "1",
        "alignmentV": "1",
        "maxLines": "1",
        "text": "2",
        "fontSize": "11.5pt",
        "typeface": "System-Bold",
        "textColor": "#FFFFFF|#0B0C0E",
        "bgColor": "#1A73E8|#8AB4F8",
        "cornerRadius": {
          "leftT": "10pt",
          "leftB": "10pt",
          "rightT": "10pt",
          "rightB": "10pt"
        }
      },
      {
        "id": "st2",
        "type": "txt",
        "x": "{n2.r}+10pt",
        "y": "{n2.y}+1pt",
        "w": "{parent.w}-{n2.r}-26pt",
        "h": "-1",
        "maxLines": "2",
        "text": "${@i18n.s2t}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "sd2",
        "type": "txt",
        "x": "{st2.x}",
        "y": "{st2.b}+3pt",
        "w": "{st2.w}",
        "h": "-1",
        "maxLines": "3",
        "text": "${@i18n.s2d}",
        "fontSize": "12pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "nt",
        "type": "txt",
        "x": "16pt",
        "y": "{sd2.b}+22pt",
        "w": "{parent.w}-32pt",
        "h": "-1",
        "maxLines": "4",
        "text": "${@i18n.setupN}",
        "fontSize": "11.5pt",
        "textColor": "#9AA0A6|#8E939B"
      },
      {
        "id": "ln1",
        "type": "layer",
        "x": "{n1.x}+9.25pt",
        "y": "{n1.b}+4pt",
        "w": "1.5pt",
        "h": "{n2.y}-{n1.b}-8pt",
        "bgColor": "#E4E7EC|#262A31"
      }
    ],
    "i18n": {
      "zh-CN": {
        "setupT": "还没有连接 Google 账号",
        "setupS": "连上之后，这里会显示你的站点在 Google 搜索里的曝光、点击和平均排名。",
        "s1t": "在 Search Console 里验证一个站点",
        "s1d": "打开 search.google.com/search-console，添加你的网站并完成验证。已经验证过就跳过这步。",
        "s1a": "打开 Search Console",
        "s2t": "用 Google 账号授权",
        "s2d": "点下面的按钮进「我的 › 凭证」，选 Google Search Console 授权登录。",
        "setupN": "只读取搜索效果数据（曝光、点击、排名），不会改动你的网站，也读不到网站内容。授权随时可以在凭证面板断开。"
      },
      "en-US": {
        "setupT": "No Google account connected",
        "setupS": "Once connected: your site's impressions, clicks and average position in Google Search.",
        "s1t": "Verify a property in Search Console",
        "s1d": "Open search.google.com/search-console and verify your site. Skip if you already have one.",
        "s1a": "Open Search Console",
        "s2t": "Authorize with your Google account",
        "s2d": "Tap below to open Settings › Credentials, then sign in to Google Search Console.",
        "setupN": "Reads Search performance only — it cannot change your site or read its content. Disconnect any time from the credentials panel."
      }
    }
  }
}
