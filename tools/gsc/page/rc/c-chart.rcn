{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "id": "lbl",
        "type": "txt",
        "x": "16pt",
        "y": "16pt",
        "w": "240pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.d28} · ${@i18n.lag}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "_note": "⚠️ 英文比中文长约 30%,超出 w 会被 maxLines 静默截成半句 ——\n                  这一行实测过:`Search Console data lags about 2–3 days` 恰好断在「about 2」。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mnd},0),1),0,1)]"
        },
        "react": [
          {
            "id": "chartAxis",
            "type": "line",
            "points": "[0,107.0,260.0,107.0]",
            "lineWidth": "1pt",
            "strokeColor": "#1A0E1116|#1AF3F4F6",
            "x": "{parent.w}-276pt",
            "y": "44pt",
            "w": "260.0pt",
            "h": "108.0pt"
          },
          {
            "id": "chart",
            "type": "line",
            "points": "[${pts}]",
            "lineWidth": "1.8pt",
            "lineCap": "round",
            "lineJoin": "round",
            "strokeColor": "#1A73E8|#8AB4F8",
            "coverageColor": "linear(#4A1A73E8\\,#001A73E8)@90|linear(#4A8AB4F8\\,#008AB4F8)@90",
            "x": "{parent.w}-276pt",
            "y": "44pt",
            "w": "260.0pt",
            "h": "108.0pt",
            "_note": "折线本体 + coverageColor 渐变面积。coverageColor 与 bgColor 走同一个 paint 构建器,所以面积可以是渐变、不必是平涂;它也能脱离可见描边单独存在(水印卡就是这么用的)。"
          },
          {
            "id": "chartHalo",
            "type": "line",
            "points": "[251.99,$[findNotEmpty::(${lastY},-99)],252.0,$[findNotEmpty::(${lastY},-99)]]",
            "lineWidth": "16.0pt",
            "lineCap": "round",
            "strokeColor": "#2E1A73E8|#2E8AB4F8",
            "x": "{parent.w}-276pt",
            "y": "44pt",
            "w": "260.0pt",
            "h": "108.0pt"
          },
          {
            "id": "chartRing",
            "type": "line",
            "points": "[251.99,$[findNotEmpty::(${lastY},-99)],252.0,$[findNotEmpty::(${lastY},-99)]]",
            "lineWidth": "10.6pt",
            "lineCap": "round",
            "strokeColor": "#FFFFFF|#15171A",
            "x": "{parent.w}-276pt",
            "y": "44pt",
            "w": "260.0pt",
            "h": "108.0pt"
          },
          {
            "id": "chartDot",
            "type": "line",
            "points": "[251.99,$[findNotEmpty::(${lastY},-99)],252.0,$[findNotEmpty::(${lastY},-99)]]",
            "lineWidth": "7.1pt",
            "lineCap": "round",
            "strokeColor": "#1A73E8|#8AB4F8",
            "x": "{parent.w}-276pt",
            "y": "44pt",
            "w": "260.0pt",
            "h": "108.0pt"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mnd},0),1),1,0)]"
        },
        "react": [
          {
            "id": "ndc",
            "type": "txt",
            "x": "16pt",
            "y": "80pt",
            "w": "{parent.w}-32pt",
            "h": "-1",
            "maxLines": "1",
            "alignmentH": "1",
            "text": "${@i18n.noData}",
            "fontSize": "12pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "d28": "近 28 天",
        "noData": "还没有搜索数据",
        "lag": "Search Console 的数据滞后约 2–3 天"
      },
      "en-US": {
        "d28": "Last 28 days",
        "noData": "No search data yet",
        "lag": "data lags 2–3 days"
      }
    }
  }
}
