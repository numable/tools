{
  "rc": {
    "cells": [
      {
        "id": "t",
        "type": "txt",
        "x": "0pt",
        "y": "4pt",
        "w": "{parent.w}-120pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.queries}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "v",
        "type": "txt",
        "x": "{parent.w}-118pt",
        "y": "4pt",
        "w": "118pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[if::(eq::(findNotEmpty::(${ok},0),1),findNotEmpty::(${qn},0),--)]${@i18n.uQueries}",
        "fontSize": "13pt",
        "textColor": "#6B7280|#8E939B"
      }
    ],
    "i18n": {
      "zh-CN": {
        "queries": "热门搜索词",
        "uQueries": " 个词"
      },
      "en-US": {
        "queries": "Top queries",
        "uQueries": " queries"
      }
    }
  }
}
