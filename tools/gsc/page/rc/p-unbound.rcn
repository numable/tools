{
  "_note": "空参兜底提示卡(2026-08-27 深链评审第二批):组件卡未绑定对象时点进详情页,路由参数为空 —— 这块替掉整页内容,给出可点的下一步(整卡 onClick 回首页)。结构照 G9(结构 + 文案 + 下一步),配色照本包 p-empty/加卡按钮族;按钮实底上的字取 onAccent 不取恒白(memory [[theme-electric-b-nav-expanding]])。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "id": "t",
        "type": "txt",
        "x": "16pt",
        "y": "20pt",
        "w": "{parent.w}-32pt",
        "h": "-1",
        "maxLines": "1",
        "alignmentH": "1",
        "text": "${@i18n.ubT}",
        "fontSize": "14pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "s",
        "type": "txt",
        "x": "16pt",
        "y": "{t.b}+6pt",
        "w": "{parent.w}-32pt",
        "h": "-1",
        "maxLines": "2",
        "lineBreak": "1",
        "alignmentH": "1",
        "text": "${@i18n.ubS}",
        "fontSize": "11.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "btn",
        "type": "txt",
        "x": "16pt",
        "y": "{s.b}+12pt",
        "w": "{parent.w}-32pt",
        "h": "34pt",
        "alignmentH": "1",
        "maxLines": "1",
        "text": "${@i18n.ubBtn}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#FFFFFF|#0B0C0E",
        "bgColor": "#1A73E8|#8AB4F8",
        "cornerRadius": {
          "leftT": "12pt",
          "leftB": "12pt",
          "rightT": "12pt",
          "rightB": "12pt"
        },
        "alignmentV": "1"
      }
    ],
    "i18n": {
      "zh-CN": {
        "ubT": "还没绑定站点",
        "ubS": "这个组件还没有选定站点。回首页点进一个站点，从它的详情页重新添加",
        "ubBtn": "去首页选一个"
      },
      "en-US": {
        "ubT": "No site selected",
        "ubS": "This widget has no site yet. Go home, open a site, and add it from that page",
        "ubBtn": "Pick one on the home page"
      }
    }
  }
}
