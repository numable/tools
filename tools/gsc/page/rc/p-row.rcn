{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "id": "n",
        "type": "txt",
        "x": "12pt",
        "y": "13pt",
        "w": "{parent.w}-150pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${n},--)]",
        "fontSize": "14pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "sub",
        "type": "txt",
        "x": "12pt",
        "y": "35pt",
        "w": "{parent.w}-150pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.imps} $[findNotEmpty::(${im},--)] · ${@i18n.ctr} $[findNotEmpty::(${ct},--)]",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(findNotEmpty::(${nd},0),1),1,0)]"
      },
      {
        "id": "subNd",
        "type": "txt",
        "x": "12pt",
        "y": "35pt",
        "w": "{parent.w}-150pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.noData}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(findNotEmpty::(${nd},0),1),0,1)]"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${c},--),--),0,1)]"
        },
        "react": [
          {
            "id": "c",
            "type": "txt",
            "x": "{parent.w}-108pt",
            "y": "14pt",
            "w": "82pt",
            "h": "-1",
            "alignmentH": "2",
            "maxLines": "1",
            "text": "$[findNotEmpty::(${c},--)]",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${c},--),--),1,0)]"
        },
        "react": [
          {
            "id": "cE",
            "type": "txt",
            "x": "{parent.w}-108pt",
            "y": "20pt",
            "w": "82pt",
            "h": "-1",
            "alignmentH": "2",
            "maxLines": "1",
            "text": "--",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "id": "cl",
        "type": "txt",
        "x": "{parent.w}-108pt",
        "y": "38pt",
        "w": "82pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "${@i18n.clicks}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "arrow",
        "type": "txt",
        "x": "{parent.w}-16pt",
        "y": "25.5pt",
        "w": "12pt",
        "h": "-1",
        "maxLines": "1",
        "text": "›",
        "fontSize": "16pt",
        "textColor": "#C6C7CC|#5A5C63"
      }
    ],
    "i18n": {
      "zh-CN": {
        "noData": "还没有搜索数据",
        "clicks": "点击",
        "imps": "曝光",
        "ctr": "点击率"
      },
      "en-US": {
        "noData": "No search data yet",
        "clicks": "Clicks",
        "imps": "Impressions",
        "ctr": "CTR"
      }
    }
  }
}
