{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "cornerRadius": {
          "leftT": "14pt",
          "leftB": "14pt",
          "rightT": "14pt",
          "rightB": "14pt"
        }
      },
      {
        "id": "site",
        "type": "txt",
        "x": "16pt",
        "y": "16pt",
        "w": "{parent.w}-150pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${nm1},--)]",
        "fontSize": "15pt",
        "typeface": "System-Bold",
        "textColor": "#1A73E8|#8AB4F8"
      },
      {
        "id": "win",
        "type": "txt",
        "x": "{parent.w}-124pt",
        "y": "18pt",
        "w": "102pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "${@i18n.d28}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "arrow",
        "type": "txt",
        "x": "{parent.w}-20pt",
        "y": "19pt",
        "w": "14pt",
        "h": "-1",
        "maxLines": "1",
        "text": "›",
        "fontSize": "18pt",
        "textColor": "#C6C7CC|#5A5C63",
        "_note": "「›」是可进入的唯一提示 —— 没有它,一整块可点的面板在四端都看不出来能点。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${m1nd},0),1),1,0)]"
        },
        "_note": "新站点还没数据:一句话替掉大数字 / 环比 / 曲线(v37)。",
        "react": [
          {
            "id": "nd1",
            "type": "txt",
            "x": "16pt",
            "y": "48pt",
            "w": "{parent.w}-40pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.noData}",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "id": "nd2",
            "type": "txt",
            "x": "16pt",
            "y": "80pt",
            "w": "{parent.w}-40pt",
            "h": "-1",
            "maxLines": "2",
            "text": "${@i18n.noDataS}",
            "fontSize": "12pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${m1clicks},--),--),0,1)]"
        },
        "react": [
          {
            "id": "num",
            "type": "txt",
            "x": "16pt",
            "y": "42pt",
            "w": "240pt",
            "h": "-1",
            "maxLines": "1",
            "text": "$[findNotEmpty::(${m1clicks},--)]",
            "fontSize": "36pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "hide": "$[if::(eq::(findNotEmpty::(${m1nd},0),1),1,0)]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${m1clicks},--),--),1,0)]"
        },
        "react": [
          {
            "id": "numE",
            "type": "txt",
            "x": "16pt",
            "y": "52.75pt",
            "w": "240pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "36pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6",
            "hide": "$[if::(eq::(findNotEmpty::(${m1nd},0),1),1,0)]"
          }
        ]
      },
      {
        "id": "unit",
        "type": "txt",
        "x": "16pt",
        "y": "88pt",
        "w": "60pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.clicks}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(findNotEmpty::(${m1nd},0),1),1,0)]"
      },
      {
        "id": "tri",
        "type": "path",
        "x": "62.0pt",
        "y": "89.6pt",
        "w": "9.0pt",
        "h": "5.94pt",
        "d": "$[if::(eq::(${up},1),M128 64 L240 192 L16 192 Z,M128 192 L16 64 L240 64 Z)]",
        "viewBox": "0 0 256 256",
        "fillColor": "$[if::(eq::(${flat},1),#9AA0A6,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6,if::(eq::(${up},1),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(eq::(${up},0),if::(eq::(${up},1),#1FC77D,#FF5C4D),#9AA0A6))))]",
        "hide": "$[if::(eq::(${flat},1),1,if::(gt::(length::(${up}),0),0,1))]"
      },
      {
        "id": "flatBar",
        "type": "layer",
        "x": "62.0pt",
        "y": "91.9pt",
        "w": "8.0pt",
        "h": "1.5pt",
        "bgColor": "#9AA0A6|#8E939B",
        "hide": "$[if::(eq::(${flat},1),0,1)]"
      },
      {
        "id": "pct",
        "type": "txt",
        "x": "75pt",
        "y": "88pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(${flat},1),${@i18n.flat},connect::(findNotEmpty::(${chgA},--),%))]",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "$[if::(eq::(${flat},1),#9AA0A6,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6,if::(eq::(${up},1),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(eq::(${up},0),if::(eq::(${up},1),#1FC77D,#FF5C4D),#9AA0A6))))]",
        "hide": "$[if::(eq::(findNotEmpty::(${m1nd},0),1),1,0)]"
      },
      {
        "id": "vs",
        "type": "txt",
        "x": "{pct.r}+6pt",
        "y": "88pt",
        "w": "90pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.vs}",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(findNotEmpty::(${m1nd},0),1),1,0)]"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${m1nd},0),1),0,1)]"
        },
        "react": [
          {
            "id": "heroAxis",
            "type": "line",
            "points": "[0,61.0,260.0,61.0]",
            "lineWidth": "1pt",
            "strokeColor": "#1A0E1116|#1AF3F4F6",
            "x": "{parent.w}-276pt",
            "y": "116pt",
            "w": "260.0pt",
            "h": "62.0pt"
          },
          {
            "id": "hero",
            "type": "line",
            "points": "[${hpts}]",
            "lineWidth": "1.8pt",
            "lineCap": "round",
            "lineJoin": "round",
            "strokeColor": "#1A73E8|#8AB4F8",
            "coverageColor": "linear(#4A1A73E8\\,#001A73E8)@90|linear(#4A8AB4F8\\,#008AB4F8)@90",
            "x": "{parent.w}-276pt",
            "y": "116pt",
            "w": "260.0pt",
            "h": "62.0pt",
            "_note": "折线本体 + coverageColor 渐变面积。coverageColor 与 bgColor 走同一个 paint 构建器,所以面积可以是渐变、不必是平涂;它也能脱离可见描边单独存在(水印卡就是这么用的)。"
          },
          {
            "id": "heroHalo",
            "type": "line",
            "points": "[252.99,$[findNotEmpty::(${hly},-99)],253.0,$[findNotEmpty::(${hly},-99)]]",
            "lineWidth": "14.0pt",
            "lineCap": "round",
            "strokeColor": "#2E1A73E8|#2E8AB4F8",
            "x": "{parent.w}-276pt",
            "y": "116pt",
            "w": "260.0pt",
            "h": "62.0pt"
          },
          {
            "id": "heroRing",
            "type": "line",
            "points": "[252.99,$[findNotEmpty::(${hly},-99)],253.0,$[findNotEmpty::(${hly},-99)]]",
            "lineWidth": "9.2pt",
            "lineCap": "round",
            "strokeColor": "#FFFFFF|#15171A",
            "x": "{parent.w}-276pt",
            "y": "116pt",
            "w": "260.0pt",
            "h": "62.0pt"
          },
          {
            "id": "heroDot",
            "type": "line",
            "points": "[252.99,$[findNotEmpty::(${hly},-99)],253.0,$[findNotEmpty::(${hly},-99)]]",
            "lineWidth": "6.2pt",
            "lineCap": "round",
            "strokeColor": "#1A73E8|#8AB4F8",
            "x": "{parent.w}-276pt",
            "y": "116pt",
            "w": "260.0pt",
            "h": "62.0pt"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "d28": "近 28 天",
        "vs": "环比",
        "flat": "持平",
        "noData": "还没有搜索数据",
        "noDataS": "新验证的站点通常 2–3 天后开始有数据",
        "clicks": "点击"
      },
      "en-US": {
        "d28": "Last 28 days",
        "vs": "vs prev",
        "flat": "flat",
        "noData": "No search data yet",
        "noDataS": "Newly verified sites usually get data in 2–3 days",
        "clicks": "Clicks"
      }
    }
  }
}
