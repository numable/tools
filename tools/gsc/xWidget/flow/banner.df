Empty::(${ra.rows[0].impressions},0))]"}},{"op":"set","props":{"key":"pclk","value":"$[findNotEmpty::(${rb.rows[0].clicks},0)]"}},{"op":"set","props":{"key":"clkT","value":"$[if::(ge::(${clk},1000000),connect::(parseNumber::(calc::(${clk}/1000000),0.0),M),if::(ge::(${clk},1000),connect::(parseNumber::(calc::(${clk}/1000),0.0),K),parseNumber::(${clk},0)))]"}},{"op":"set","props":{"key":"impT","value":"$[if::(ge::(${imp},1000000),connect::(parseNumber::(calc::(${imp}/1000000),0.0),M),if::(ge::(${imp},1000),connect::(parseNumber::(calc::(${imp}/1000),0.0),K),parseNumber::(${imp},0)))]"}},{"op":"set","props":{"key":"ctrT","value":"$[connect::(parseNumber::(calc::(findNotEmpty::(${ra.rows[0].ctr},0)*100),0.0),%)]"}},{"op":"set","props":{"key":"posT","value":"$[parseNumber::(findNotEmpty::(${ra.rows[0].position},0),0.0)]"}},{"op":"set","props":{"key":"chg","value":"$[if::(gt::(${pclk},0),parseNumber::(calc::((${clk}-${pclk})/${pclk}*100),0.0),)]"},"_note":"分母为 0 不算(从 0 涨到 5 的百分比没有意义),留空 → 卡上不出现变化那一组。"},{"op":"set","props":{"key":"chgOk","value":"$[if::(gt::(${pclk},0),1,0)]"}},{"op":"set","props":{"key":"chgT","value":"$[if::(eq::(${chgOk},1),connect::(if::(ge::(${chg},0),+,−),if::(ge::(${chg},0),${chg},parseNumber::(calc::(0-${chg}),0.0)),%),)]"}},{"op":"set","props":{"key":"sl1","value":"$[replaceAll::(${site},^sc-domain.,)]"}},{"op":"set","props":{"key":"sl2","value":"$[replaceAll::(${sl1},^https?.//,)]"}},{"op":"set","props":{"key":"siteT","value":"$[replaceAll::(${sl2},/$,)]"},"_note":"站名去 sc-domain: / https:// 前缀与尾斜杠(同 sites.df)。"},{"op":"set","props":{"key":"_MON","value":{"01":"Jan","02":"Feb","03":"Mar","04":"Apr","05":"May","06":"Jun","07":"Jul","08":"Aug","09":"Sep","10":"Oct","11":"Nov","12":"Dec"}}},{"op":"set","props":{"key":"_toM","value":"$[get::(${_MON},subString::(${dTo},5,7))]"}},{"op":"set","props":{"key":"_toD","value":"$[parseNumber::(subString::(${dTo},8,10),0)]"}},{"op":"set","props":{"key":"_toZ","value":"$[parseNumber::(subString::(${dTo},5,7),0)