{"version":1,"_note":"信息源页海报专用(tools/banner/dyn_personal.py 生成,不要手改),组件不用。","actions":[{"id":"_cs","action":"credential.state","params":{"id":"google"}},{"op":"set","props":{"key":"_bcs","value":"1"},"_note":"⚠️ 读取屏障(勿删):credential.state 之后紧邻的节点读不到结果。"},{"op":"set","props":{"key":"demo","value":"$[if::(eq::(${_cs.state},unbound),1,0)]"},"_note":"只认 unbound 画示例;expired / 绑了但被拒照旧走真请求 → 失败退回上次的图或静态图。"},{"op":"set","props":{"key":"live","value":"$[if::(eq::(${demo},1),0,1)]"}},{"op":"if","props":{"val":"${live}"},"items":[{"id":"resp","action":"request","params":{"url":"https://searchconsole.googleapis.com/webmasters/v3/sites","method":"GET","header":{"Accept":"application/json","User-Agent":"Numable"},"formatType":"json","credential":"google"}},{"op":"set","props":{"key":"_b","value":"1"},"_note":"⚠️ 请求屏障(勿删):request 之后紧邻的节点读不到响应(晚一拍合并)。"},{"op":"set","props":{"key":"_fail","value":"$[if::(eq::(${resp},),1,0)]"}},{"op":"if","props":{"val":"${_fail}"},"items":[{"action":"error","params":{"errorMsg":"gsc_unreachable"}}]},{"op":"set","props":{"key":"site","value":"$[if::(eq::(findNotEmpty::(${resp.error.message},__none__),__none__),findNotEmpty::(${resp.siteEntry[0].siteUrl},),)]"},"_note":"账号被拒(error.message)/ 名下没有站点 → site 空 → ok=0 → 静态图。"},{"op":"set","props":{"key":"hasSite","value":"$[if::(eq::(${site},),0,1)]"}},{"op":"if","props":{"val":"${hasSite}"},"items":[{"op":"set","props":{"key":"dTo","value":"$[formatDate::(calc::(${@time.nowMs}-3*86400000),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"dFrom","value":"$[formatDate::(calc::(${@time.nowMs}-30*86400000),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"pTo","value":"$[formatDate::(calc::(${@time.nowMs}-31*86400000),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"pFrom","value":"$[formatDate::(calc::(${@time.nowMs}-58*86400000),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"bA","value":"{\"startDate\":\"${dFrom}\",\"endDate\":\"${dTo}\",\"dimensions\":[],\"rowLimit\":1}"}},{"id":"ra","action":"request","params":{"url":"https: