{
  "version": 2,
  "title": "点击与环比",
  "sub": "28 天点击数 · 比前 14 天 · 截至 3 天前",
  "i18n": {
    "en-US": {
      "title": "Clicks & change",
      "sub": "28-day clicks vs prev 14 days, to 3 days ago"
    }
  },
  "layout": 11,
  "_note": "11 微档(card-design-system §8.2):与 21 档 mini 共用 mini.df(零新增请求),只读流里追加的 v11 / vf 两个展示键。params / events 照抄 mini.xwidget。",
  "params": {
    "site": "",
    "siteName": ""
  },
  "events": {
    "onClick": "/site?u=${site}",
    "onEdit": "/edit?site=${site}"
  },
  "canvas": {
    "source": "@[file://rc/mini11.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/mini.df]",
        "params": {
          "site": "${site}",
          "siteName": "${siteName}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "ai": {
    "shows": "某个站点近 28 天 Google 搜索点击数与较前 14 天的变化(一格小号);需绑 Google 账号",
    "params": {
      "site": {
        "kind": "account",
        "group": [
          "site",
          "siteName"
        ],
        "hint": "用户 Search Console 里的资源(如 sc-domain:example.com 或 https://example.com/);留空 = 未选站点,组件提示用户点按选择"
      },
      "siteName": {
        "kind": "account",
        "hint": "与 site 配套的站点显示名"
      }
    }
  }
}
