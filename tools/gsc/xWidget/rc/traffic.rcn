      },
      {
        "id": "tk2",
        "type": "txt",
        "x": "234.66666666666666pt",
        "y": "103pt",
        "w": "79.33333333333333pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.pos}",
