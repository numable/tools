    "i18n": {
      "zh-CN": {
        "clicks": "点击",
        "imps": "曝光",
        "pos": "平均排名",
        "ctr": "点击率",
        "win": "近 28 天 · 截至 3 天前",
        "vs": "较前 14 天",
        "flatMsg": "与前 14 天基本持平",
        "noSite": "点按选择站点",
        "err": "暂时取不到",
        "noData": "还没有搜索数据",
