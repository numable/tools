      {
        "id": "tl2",
        "type": "layer",
        "x": "224.66666666666666pt",
        "y": "92pt",
        "w": "99.33333333333333pt",
        "h": "52pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "12pt",
          "leftB": "12pt",
