      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${nd},0),1),--,findNotEmpty::(${pos},--)),--),0,1)]"
        },
        "react": [
          {
            "id": "tv2",
            "type": "txt",
            "x": "234.66666666666666pt",
            "y": "118pt",
            "w": "79.33333333333333pt",
            "h": "-1",
            "maxLines": "1",
            "text": "$[if::(eq::(findNotEmpty::(${nd},0),1),--,findNotEmpty::(${pos},--))]",
            "fontSize": "20pt",
