        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${nd},0),1),--,findNotEmpty::(${pos},--)),--),1,0)]"
        },
        "react": [
          {
            "id": "tv2E",
            "type": "txt",
            "x": "234.66666666666666pt",
            "y": "124pt",
            "w": "79.33333333333333pt",
            "h": "-1",
            "maxLines": "1",
