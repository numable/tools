{
  "_note": "平均排名(22)。生成器 gen_gsc.py。走势纵轴倒置(流里取负),只画形状;大数字是汇总请求的加权排名。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FAFCFE\\,#EFF5FD)@90|linear(#15171A\\,#171A1E\\,#1B1F26)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12.0pt",
        "y": "{site.y}+({site.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#1A73E8|#8AB4F8",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "site",
        "type": "txt",
        "x": "21.0pt",
        "y": "11pt",
        "w": "85.0pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(findNotEmpty::(${hasSite},__none__),__none__),${@i18n.fnP},if::(eq::(${hasSite},1),${siteLabel},${@i18n.noSite}))]",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "12.0pt",
        "y": "14pt",
        "w": "134.0pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[if::(eq::(${hasSite},1),if::(eq::(${ok},1),${at},${@i18n.err}),)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "lab",
        "type": "txt",
        "x": "12.0pt",
        "y": "33pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.posL}",
        "fontSize": "10pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${nd},0),1),--,findNotEmpty::(${pos},--)),--),0,1)]"
        },
        "react": [
          {
            "id": "num",
            "type": "txt",
            "x": "12.0pt",
            "y": "49pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "$[if::(eq::(findNotEmpty::(${nd},0),1),--,findNotEmpty::(${pos},--))]",
            "fontSize": "28pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${nd},0),1),--,findNotEmpty::(${pos},--)),--),1,0)]"
        },
        "react": [
          {
            "id": "numE",
            "type": "txt",
            "x": "12.0pt",
            "y": "57.5pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "28pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(if::(eq::(findNotEmpty::(${hasSite},0),1),if::(eq::(findNotEmpty::(${ok},0),1),1,0),0),if::(eq::(findNotEmpty::(${nd},0),1),0,1),0)]"
        },
        "react": [
          {
            "id": "pg",
            "type": "txt",
            "x": "12.0pt",
            "y": "85pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "$[if::(le::(findNotEmpty::(${pg},9),1),${@i18n.pg1},${@i18n.pgA}${pg}${@i18n.pgB})]",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${nd},0),1),1,0)]"
        },
        "react": [
          {
            "id": "nd",
            "type": "txt",
            "x": "12.0pt",
            "y": "85pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.noDataM}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${hasSite},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "id": "stN",
            "type": "txt",
            "x": "12.0pt",
            "y": "85pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.unbound}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${hasSite},0),1),if::(eq::(findNotEmpty::(${ok},0),1),0,1),0)]"
        },
        "react": [
          {
            "id": "stF",
            "type": "txt",
            "x": "12.0pt",
            "y": "85pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.failed}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${hasSite},__none__),__none__),0,if::(eq::(${hasSite},1),0,1))]"
        },
        "react": [
          {
            "id": "stS",
            "type": "txt",
            "x": "12.0pt",
            "y": "85pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.noSiteL}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "id": "pAxis",
        "type": "line",
        "x": "12.0pt",
        "y": "104pt",
        "w": "134.0pt",
        "h": "38.0pt",
        "points": "[0,37.0,134.0,37.0]",
        "lineWidth": "1pt",
        "strokeColor": "#1A0E1116|#1AF3F4F6"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(if::(eq::(findNotEmpty::(${hasSite},0),1),if::(eq::(findNotEmpty::(${ok},0),1),1,0),0),if::(eq::(findNotEmpty::(${nd},0),1),0,1),0)]"
        },
        "react": [
          {
            "id": "pspark",
            "type": "line",
            "points": "[${ppts}]",
            "lineWidth": "1.8pt",
            "lineCap": "round",
            "lineJoin": "round",
            "strokeColor": "#1A73E8|#8AB4F8",
            "coverageColor": "linear(#4A1A73E8\\,#001A73E8)@90|linear(#4A8AB4F8\\,#008AB4F8)@90",
            "x": "12.0pt",
            "y": "104pt",
            "w": "134.0pt",
            "h": "38.0pt",
            "_note": "折线本体 + coverageColor 渐变面积。coverageColor 与 bgColor 走同一个 paint 构建器,所以面积可以是渐变、不必是平涂;它也能脱离可见描边单独存在(水印卡就是这么用的)。"
          },
          {
            "id": "psparkHalo",
            "type": "line",
            "points": "[128.99,$[findNotEmpty::(${plastY},-99)],129.0,$[findNotEmpty::(${plastY},-99)]]",
            "lineWidth": "10.0pt",
            "lineCap": "round",
            "strokeColor": "#2E1A73E8|#2E8AB4F8",
            "x": "12.0pt",
            "y": "104pt",
            "w": "134.0pt",
            "h": "38.0pt"
          },
          {
            "id": "psparkRing",
            "type": "line",
            "points": "[128.99,$[findNotEmpty::(${plastY},-99)],129.0,$[findNotEmpty::(${plastY},-99)]]",
            "lineWidth": "6.6pt",
            "lineCap": "round",
            "strokeColor": "#FFFFFF|#15171A",
            "x": "12.0pt",
            "y": "104pt",
            "w": "134.0pt",
            "h": "38.0pt"
          },
          {
            "id": "psparkDot",
            "type": "line",
            "points": "[128.99,$[findNotEmpty::(${plastY},-99)],129.0,$[findNotEmpty::(${plastY},-99)]]",
            "lineWidth": "4.5pt",
            "lineCap": "round",
            "strokeColor": "#1A73E8|#8AB4F8",
            "x": "12.0pt",
            "y": "104pt",
            "w": "134.0pt",
            "h": "38.0pt"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "noSite": "点按选择站点",
        "err": "暂时取不到",
        "noDataM": "暂无数据",
        "unbound": "还没连接 Google 账号",
        "failed": "暂时取不到数据",
        "noSiteL": "还没选站点",
        "fnP": "平均排名",
        "posL": "平均排名 · 近 28 天",
        "pg1": "多数在第 1 页",
        "pgA": "多数在第 ",
        "pgB": " 页"
      },
      "en-US": {
        "noSite": "Pick a site",
        "err": "Unavailable",
        "noDataM": "No data yet",
        "unbound": "Google not linked",
        "failed": "Couldn't get data right now",
        "noSiteL": "No site picked yet",
        "fnP": "Avg. position",
        "posL": "Avg. position · 28 days",
        "pg1": "Mostly on page 1",
        "pgA": "Mostly on page ",
        "pgB": ""
      }
    },
    "i18nEmptyOk": [
      "pgB"
    ]
  }
}
