{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FAFCFE\\,#EFF5FD)@90|linear(#15171A\\,#171A1E\\,#1B1F26)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8.0pt",
        "y": "{site.y}+({site.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#1A73E8|#8AB4F8",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "_note": "组件名 = 对象名(站点)。未选站点时退回功能名「点击」—— 11 档放不下「点按选择站点」那句说明(§5)。",
        "id": "site",
        "type": "txt",
        "x": "17.0pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(${hasSite},1),${siteLabel},${@i18n.clicks})]",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${v11},--),--),0,if::(eq::(${vf},17),1,0))]"
        },
        "react": [
          {
            "id": "num17",
            "type": "txt",
            "x": "8.0pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${v11}",
            "fontSize": "17pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${v11},--),--),0,if::(eq::(${vf},17),0,1))]"
        },
        "react": [
          {
            "id": "num",
            "type": "txt",
            "x": "8.0pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${v11}",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${v11},--),--),1,0)]"
        },
        "_note": "空值「--」落回数字中线(同 dash_split:y 下移 ≈ 0.3 × 字号)。",
        "react": [
          {
            "id": "numE",
            "type": "txt",
            "x": "8.0pt",
            "y": "28pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${flat},1),0,if::(gt::(length::(${up}),0),1,0))]"
        },
        "react": [
          {
            "id": "chg",
            "type": "txt",
            "x": "8.0pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${chgTxt}",
            "fontSize": "9pt",
            "typeface": "System-Bold",
            "textColor": "$[if::(eq::(${flat},1),#9AA0A6,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6,if::(eq::(${up},1),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(eq::(${up},0),if::(eq::(${up},1),#1FC77D,#FF5C4D),#9AA0A6))))]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${flat},1),1,0)]"
        },
        "react": [
          {
            "id": "chgFlat",
            "type": "txt",
            "x": "8.0pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.flatS}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${flat},1),0,if::(gt::(length::(${up}),0),0,1))]"
        },
        "react": [
          {
            "id": "chgE",
            "type": "txt",
            "x": "8.0pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "clicks": "点击",
        "flatS": "持平"
      },
      "en-US": {
        "clicks": "Clicks",
        "flatS": "Flat"
      }
    }
  }
}
