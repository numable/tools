{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FAFCFE\\,#EFF5FD)@90|linear(#15171A\\,#171A1E\\,#1B1F26)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12.0pt",
        "y": "{hd.y}+({hd.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#1A73E8|#8AB4F8",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "hd",
        "type": "txt",
        "x": "21.0pt",
        "y": "11pt",
        "w": "100pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.sites}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${n},--),--),0,1)]"
        },
        "react": [
          {
            "id": "n",
            "type": "richText",
            "x": "12.0pt",
            "y": "30pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "$[findNotEmpty::(${n},--)]",
                "fontSize": "30pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${n},--),--),1,0)]"
        },
        "react": [
          {
            "id": "nE",
            "type": "richText",
            "x": "12.0pt",
            "y": "39pt",
            "w": "134.0pt",
            "h": "-1",
            "maxLines": "1",
            "spans": [
              {
                "text": "--",
                "fontSize": "30pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              }
            ]
          }
        ]
      },
      {
        "id": "r0",
        "type": "layer",
        "x": "12.0pt",
        "y": "74.0pt",
        "w": "134.0pt",
        "h": "20pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "6pt",
          "leftB": "6pt",
          "rightT": "6pt",
          "rightB": "6pt"
        }
      },
      {
        "id": "s0",
        "type": "txt",
        "x": "19.0pt",
        "y": "79.5pt",
        "w": "120.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${s0},)]",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "r1",
        "type": "layer",
        "x": "12.0pt",
        "y": "98.0pt",
        "w": "134.0pt",
        "h": "20pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "6pt",
          "leftB": "6pt",
          "rightT": "6pt",
          "rightB": "6pt"
        }
      },
      {
        "id": "s1",
        "type": "txt",
        "x": "19.0pt",
        "y": "103.5pt",
        "w": "120.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${s1},)]",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "r2",
        "type": "layer",
        "x": "12.0pt",
        "y": "122.0pt",
        "w": "134.0pt",
        "h": "20pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "6pt",
          "leftB": "6pt",
          "rightT": "6pt",
          "rightB": "6pt"
        }
      },
      {
        "id": "s2",
        "type": "txt",
        "x": "19.0pt",
        "y": "127.5pt",
        "w": "120.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${s2},)]",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "id": "stN",
            "type": "txt",
            "x": "19.0pt",
            "y": "79.5pt",
            "w": "120.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.unbound}",
            "fontSize": "9.5pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},__none__),__none__),0,if::(eq::(${ok},1),0,1))]"
        },
        "react": [
          {
            "id": "stF",
            "type": "txt",
            "x": "19.0pt",
            "y": "79.5pt",
            "w": "120.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.failed}",
            "fontSize": "9.5pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${ok},0),1),if::(eq::(findNotEmpty::(${n},0),0),1,0),0)]"
        },
        "react": [
          {
            "id": "stE",
            "type": "txt",
            "x": "19.0pt",
            "y": "79.5pt",
            "w": "120.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.empty}",
            "fontSize": "9.5pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "_note": "时效锚(卡片设计系统 §3):**右上角、与卡名同一 y、9pt、右对齐**。原来它钉在卡底 y=146,而同包的 traffic/mini 都在顶上 —— 三张卡三个位置,一屏并排时「数据几点的」得逐张卡去找。实测「我的站点」13pt 粗 52pt + 「暂时取不到」9pt 45pt,在 22 档的 134pt 行宽里还余 37pt,放得下。",
        "id": "at",
        "type": "txt",
        "x": "12.0pt",
        "y": "14pt",
        "w": "134.0pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[if::(eq::(findNotEmpty::(${ok},__none__),__none__),,if::(eq::(${ok},1),${at},${@i18n.err}))]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      }
    ],
    "i18n": {
      "zh-CN": {
        "err": "暂时取不到",
        "sites": "我的站点",
        "empty": "还没有站点",
        "unbound": "还没连接 Google 账号",
        "failed": "暂时取不到数据"
      },
      "en-US": {
        "err": "Unavailable",
        "sites": "My sites",
        "empty": "No sites yet",
        "unbound": "Google not linked",
        "failed": "Couldn't get data right now"
      }
    }
  }
}
