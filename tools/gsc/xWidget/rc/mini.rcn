{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FAFCFE\\,#EFF5FD)@90|linear(#15171A\\,#171A1E\\,#1B1F26)@90"
      },
      {
        "_note": "源色身份点(卡片设计系统 §2.1:每张卡恰好一次)。21 档原来是本包唯一一张没有身份点的卡。",
        "id": "dot",
        "type": "layer",
        "x": "10.0pt",
        "y": "{site.y}+({site.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#1A73E8|#8AB4F8",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "site",
        "type": "txt",
        "x": "19.0pt",
        "y": "9pt",
        "w": "77pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(findNotEmpty::(${hasSite},__none__),__none__),${@i18n.fnM},if::(eq::(${hasSite},1),${siteLabel},${@i18n.noSite}))]",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${nd},0),1),1,0)]"
        },
        "react": [
          {
            "id": "nd1",
            "type": "txt",
            "x": "10.0pt",
            "y": "27pt",
            "w": "138pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.noDataM}",
            "fontSize": "13pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${clicks},--),--),0,1)]"
        },
        "react": [
          {
            "id": "num",
            "type": "richText",
            "x": "10.0pt",
            "y": "25pt",
            "w": "86pt",
            "h": "-1",
            "maxLines": "1",
            "hide": "$[if::(eq::(findNotEmpty::(${nd},0),1),1,0)]",
            "spans": [
              {
                "text": "$[findNotEmpty::(${clicks},--)]",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "13pt"
              },
              {
                "text": "${@i18n.clicks}",
                "fontSize": "9pt",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${clicks},--),--),1,0)]"
        },
        "react": [
          {
            "id": "numE",
            "type": "richText",
            "x": "10.0pt",
            "y": "31pt",
            "w": "86pt",
            "h": "-1",
            "maxLines": "1",
            "hide": "$[if::(eq::(findNotEmpty::(${nd},0),1),1,0)]",
            "spans": [
              {
                "text": "--",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "13pt"
              },
              {
                "text": "${@i18n.clicks}",
                "fontSize": "9pt",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${nd},0),1),0,1)]"
        },
        "react": [
          {
            "id": "spark",
            "type": "line",
            "points": "[${pts}]",
            "lineWidth": "1.8pt",
            "lineCap": "round",
            "lineJoin": "round",
            "strokeColor": "#1A73E8|#8AB4F8",
            "coverageColor": "linear(#4A1A73E8\\,#001A73E8)@90|linear(#4A8AB4F8\\,#008AB4F8)@90",
            "x": "88.0pt",
            "y": "20pt",
            "w": "60.0pt",
            "h": "24.0pt",
            "_note": "折线本体 + coverageColor 渐变面积。coverageColor 与 bgColor 走同一个 paint 构建器,所以面积可以是渐变、不必是平涂;它也能脱离可见描边单独存在(水印卡就是这么用的)。"
          },
          {
            "id": "sparkHalo",
            "type": "line",
            "points": "[55.99,$[findNotEmpty::(${lastY},-99)],56.0,$[findNotEmpty::(${lastY},-99)]]",
            "lineWidth": "8.0pt",
            "lineCap": "round",
            "strokeColor": "#2E1A73E8|#2E8AB4F8",
            "x": "88.0pt",
            "y": "20pt",
            "w": "60.0pt",
            "h": "24.0pt"
          },
          {
            "id": "sparkRing",
            "type": "line",
            "points": "[55.99,$[findNotEmpty::(${lastY},-99)],56.0,$[findNotEmpty::(${lastY},-99)]]",
            "lineWidth": "5.3pt",
            "lineCap": "round",
            "strokeColor": "#FFFFFF|#15171A",
            "x": "88.0pt",
            "y": "20pt",
            "w": "60.0pt",
            "h": "24.0pt"
          },
          {
            "id": "sparkDot",
            "type": "line",
            "points": "[55.99,$[findNotEmpty::(${lastY},-99)],56.0,$[findNotEmpty::(${lastY},-99)]]",
            "lineWidth": "3.6pt",
            "lineCap": "round",
            "strokeColor": "#1A73E8|#8AB4F8",
            "x": "88.0pt",
            "y": "20pt",
            "w": "60.0pt",
            "h": "24.0pt"
          }
        ]
      },
      {
        "_note": "取数时刻锚点(标准 §4.4)。21 档没有脚注位,但**顶部右侧那一格是空的** ——site 只占 x 10..96、折线从 y=20 才开始,所以 x 98..148 × y 9..18 这一块本来就没人用。",
        "id": "at",
        "type": "txt",
        "x": "98.0pt",
        "y": "10.5pt",
        "w": "50.0pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[if::(eq::(${hasSite},1),if::(eq::(${ok},1),${at},${@i18n.err}),)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "_note": "窗口标签(同 traffic.rcn #win 的理由)。21 档原来连「28 天」三个字都没有 ——用户看到的是一个孤零零的点击数,既不知道窗口多长、也不知道它截到哪天。折线盒到 y=44 为止,卡高 60,底下这一条 8.5pt 的灰字放得下。",
        "id": "win",
        "type": "txt",
        "x": "10.0pt",
        "y": "46pt",
        "w": "138.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.win}",
        "fontSize": "8.5pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(if::(eq::(findNotEmpty::(${hasSite},0),1),if::(eq::(findNotEmpty::(${ok},0),1),1,0),0),1),0,2)]"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${hasSite},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "id": "stN",
            "type": "txt",
            "x": "10.0pt",
            "y": "46pt",
            "w": "138.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.unbound}",
            "fontSize": "8.5pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${hasSite},0),1),if::(eq::(findNotEmpty::(${ok},0),1),0,1),0)]"
        },
        "react": [
          {
            "id": "stF",
            "type": "txt",
            "x": "10.0pt",
            "y": "46pt",
            "w": "138.0pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.failed}",
            "fontSize": "8.5pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "clicks": "点击",
        "win": "近 28 天 · 截至 3 天前",
        "noSite": "点按选择站点",
        "err": "暂时取不到",
        "noDataM": "暂无数据",
        "unbound": "还没连接 Google 账号",
        "failed": "暂时取不到数据",
        "fnM": "搜索点击",
        "nbsp": " "
      },
      "en-US": {
        "clicks": "Clicks",
        "win": "Last 28 days · ending 3 days ago",
        "noSite": "Pick a site",
        "err": "Unavailable",
        "noDataM": "No data yet",
        "unbound": "Google not linked",
        "failed": "Couldn't get data right now",
        "fnM": "Search clicks",
        "nbsp": " "
      }
    }
  }
}
