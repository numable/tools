{
  "version": 2,
  "title": "我的站点",
  "sub": "Search Console 里的资源数与名单",
  "i18n": {
    "en-US": {
      "title": "My sites",
      "sub": "Property count and list from Search Console"
    }
  },
  "layout": 22,
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/sites.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/sites.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "ai": {
    "shows": "用户 Search Console 里有几个资源,以及站点名单;需绑 Google 账号"
  }
}
