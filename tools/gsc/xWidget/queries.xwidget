{
  "_note": "热门搜索词(42)。 生成器 gen_gsc.py(params / events 抄 traffic.xwidget:site 为空时详情页渲兜底)。",
  "version": 2,
  "title": "热门搜索词",
  "sub": "近 28 天点击最多的 5 个搜索词 · 截至 3 天前",
  "i18n": {
    "en-US": {
      "title": "Top queries",
      "sub": "5 most-clicked queries, 28 days, to 3 days ago"
    }
  },
  "layout": 42,
  "params": {
    "site": "",
    "siteName": ""
  },
  "events": {
    "onClick": "/site?u=${site}",
    "onEdit": "/edit?site=${site}"
  },
  "canvas": {
    "source": "@[file://rc/queries.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/queries.df]",
        "params": {
          "site": "${site}",
          "siteName": "${siteName}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "ai": {
    "shows": "某个站点近 28 天 Google 搜索里点击最多的 5 个搜索词,各带点击数与平均排名;需绑 Google 账号",
    "params": {
      "site": {
        "kind": "account",
        "group": [
          "site",
          "siteName"
        ],
        "hint": "用户 Search Console 里的资源(如 sc-domain:example.com 或 https://example.com/);留空 = 未选站点,组件提示用户点按选择"
      },
      "siteName": {
        "kind": "account",
        "hint": "与 site 配套的站点显示名"
      }
    }
  }
}
