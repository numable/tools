{
  "version": 2,
  "title": "点击数",
  "sub": "一个数 · 一条 28 天形状 · 截至 3 天前",
  "i18n": {
    "en-US": {
      "title": "Clicks",
      "sub": "One number, one 28-day shape, to 3 days ago"
    }
  },
  "layout": 21,
  "params": {
    "site": "",
    "siteName": ""
  },
  "events": {
    "onClick": "/site?u=${site}",
    "onEdit": "/edit?site=${site}",
    "_noteClick": "单对象卡点击带对象参数进详情页(2026-08-27 深链评审第二批)。详情页 /site 的 query 键是 u(抄自首页跳转串 numable://self/page/site?u=);site 为空时详情页渲 p-unbound 兜底(同日新增),不再是死页。"
  },
  "canvas": {
    "source": "@[file://rc/mini.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/mini.df]",
        "params": {
          "site": "${site}",
          "siteName": "${siteName}"
        },
        "_note": "21 条与 42 卡各绑各的 flow —— 两张卡的迷你图宽高不同,而点串是在数据层按**那张卡的**坐标系归一化的。共用一条流会让其中一张的折线被 self_clip 削掉或留一条空白,且百分比数字照旧正确(最难查的那种不一致)。"
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "ai": {
    "shows": "某个站点近 28 天的 Google 搜索点击数与 28 天走势(数据截至 3 天前);需绑 Google 账号",
    "params": {
      "site": {
        "kind": "account",
        "group": [
          "site",
          "siteName"
        ],
        "hint": "用户 Search Console 里的资源(如 sc-domain:example.com 或 https://example.com/);留空 = 未选站点,组件提示用户点按选择"
      },
      "siteName": {
        "kind": "account",
        "hint": "与 site 配套的站点显示名"
      }
    }
  }
}
