{
  "_note": "平均排名(22)。复用 traffic.df(同一对请求,零新增)。 生成器 gen_gsc.py(params / events 抄 traffic.xwidget:site 为空时详情页渲兜底)。",
  "version": 2,
  "title": "平均排名",
  "sub": "近 28 天平均排名与走势 · 截至 3 天前",
  "i18n": {
    "en-US": {
      "title": "Avg. position",
      "sub": "28-day average position and trend, to 3 days ago"
    }
  },
  "layout": 22,
  "params": {
    "site": "",
    "siteName": ""
  },
  "events": {
    "onClick": "/site?u=${site}",
    "onEdit": "/edit?site=${site}"
  },
  "canvas": {
    "source": "@[file://rc/pos.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/traffic.df]",
        "params": {
          "site": "${site}",
          "siteName": "${siteName}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  },
  "ai": {
    "shows": "某个站点近 28 天在 Google 搜索里的平均排名(越小越靠前)、落在第几页与逐日走势;需绑 Google 账号",
    "params": {
      "site": {
        "kind": "account",
        "group": [
          "site",
          "siteName"
        ],
        "hint": "用户 Search Console 里的资源(如 sc-domain:example.com 或 https://example.com/);留空 = 未选站点,组件提示用户点按选择"
      },
      "siteName": {
        "kind": "account",
        "hint": "与 site 配套的站点显示名"
      }
    }
  }
}
