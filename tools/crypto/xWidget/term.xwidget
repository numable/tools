{
  "version": 2,
  "title": "单币大盘",
  "sub": "大字价格 · 48 小时走势 · 合约六格",
  "i18n": {
    "en-US": {
      "title": "Coin terminal",
      "sub": "Big price, 48h chart, six derivatives stats"
    }
  },
  "layout": 44,
  "params": {
    "pair": "BTC-USDT",
    "name": "BTC"
  },
  "ai": {
    "shows": "一个币的大字现价、48 小时逐小时走势、24h 高低与成交额、资金费率、持仓量、多空比",
    "params": {
      "pair": {
        "kind": "value",
        "group": [
          "pair",
          "name"
        ],
        "format": "OKX 交易对:币种-USDT(现货);只有永续合约的币写 币种-USDT-SWAP",
        "hint": "name 填 pair 的币种部分(BTC-USDT → BTC)",
        "examples": [
          "BTC-USDT",
          "ETH-USDT",
          "SOL-USDT",
          "DOGE-USDT"
        ]
      },
      "name": {
        "kind": "value",
        "format": "币种代码 = pair 第一段,如 BTC"
      }
    }
  },
  "events": {
    "onClick": "/coin?pair=${pair}&name=${name}",
    "onEdit": "/pick?pair=${pair}&name=${name}"
  },
  "jobs": [
    {
      "id": "price",
      "params": {
        "pair": "${pair}"
      }
    },
    {
      "id": "move",
      "params": {
        "pair": "${pair}"
      }
    },
    {
      "id": "funding",
      "params": {
        "pair": "${pair}"
      }
    }
  ],
  "canvas": {
    "source": "@[file://rc/term.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/term.df]",
        "params": {
          "pair": "${pair}",
          "name": "${name}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "5"
      ]
    }
  }
}
