{
  "version": 2,
  "title": "迷你行情",
  "sub": "一行 · 价格与 24 小时走势",
  "i18n": {
    "en-US": {
      "title": "Mini quote",
      "sub": "One line · price and its 24h shape"
    }
  },
  "layout": 21,
  "params": {
    "pair": "BTC-USDT",
    "name": "BTC"
  },
  "ai": {
    "shows": "一行:一个币的现价、24h 涨跌幅与 24 小时走势线",
    "params": {
      "pair": {
        "kind": "value",
        "group": [
          "pair",
          "name"
        ],
        "format": "OKX 交易对:币种-USDT(现货);只有永续合约的币写 币种-USDT-SWAP",
        "hint": "name 填 pair 的币种部分(BTC-USDT → BTC)",
        "examples": [
          "BTC-USDT",
          "ETH-USDT",
          "SOL-USDT",
          "DOGE-USDT"
        ]
      },
      "name": {
        "kind": "value",
        "format": "币种代码 = pair 第一段,如 BTC"
      }
    }
  },
  "events": {
    "onClick": "/coin?pair=${pair}&name=${name}",
    "onEdit": "/pick?pair=${pair}&name=${name}"
  },
  "jobs": [
    {
      "id": "price",
      "params": {
        "pair": "${pair}"
      }
    },
    {
      "id": "move",
      "params": {
        "pair": "${pair}"
      }
    }
  ],
  "canvas": {
    "source": "@[file://rc/mini.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/mini.df]",
        "params": {
          "pair": "${pair}",
          "name": "${name}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3"
      ]
    }
  }
}
