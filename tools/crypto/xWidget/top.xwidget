{
  "version": 2,
  "title": "币种行情",
  "sub": "五个币种 · 各带 24 小时形状",
  "i18n": {
    "en-US": {
      "title": "Coins",
      "sub": "Five coins, each with its 24h shape"
    }
  },
  "layout": 44,
  "params": {
    "p1": "BTC-USDT",
    "n1": "BTC",
    "p2": "ETH-USDT",
    "n2": "ETH",
    "p3": "SOL-USDT",
    "n3": "SOL",
    "p4": "XRP-USDT",
    "n4": "XRP",
    "p5": "ADA-USDT",
    "n5": "ADA"
  },
  "ai": {
    "shows": "五个币各自的现价、24h 涨跌幅与 24 小时走势线,标出领涨领跌",
    "params": {
      "p1": {
        "kind": "value",
        "group": [
          "p1",
          "n1"
        ],
        "format": "OKX 交易对:币种-USDT;只有永续的币写 币种-USDT-SWAP",
        "hint": "第 1 个币;五个互不重复;n1 填它的币种代码"
      },
      "n1": {
        "kind": "value",
        "format": "p1 的币种代码,如 BTC"
      },
      "p2": {
        "kind": "value",
        "group": [
          "p2",
          "n2"
        ],
        "format": "OKX 交易对:币种-USDT;只有永续的币写 币种-USDT-SWAP",
        "hint": "第 2 个币;五个互不重复;n2 填它的币种代码"
      },
      "n2": {
        "kind": "value",
        "format": "p2 的币种代码,如 BTC"
      },
      "p3": {
        "kind": "value",
        "group": [
          "p3",
          "n3"
        ],
        "format": "OKX 交易对:币种-USDT;只有永续的币写 币种-USDT-SWAP",
        "hint": "第 3 个币;五个互不重复;n3 填它的币种代码"
      },
      "n3": {
        "kind": "value",
        "format": "p3 的币种代码,如 BTC"
      },
      "p4": {
        "kind": "value",
        "group": [
          "p4",
          "n4"
        ],
        "format": "OKX 交易对:币种-USDT;只有永续的币写 币种-USDT-SWAP",
        "hint": "第 4 个币;五个互不重复;n4 填它的币种代码"
      },
      "n4": {
        "kind": "value",
        "format": "p4 的币种代码,如 BTC"
      },
      "p5": {
        "kind": "value",
        "group": [
          "p5",
          "n5"
        ],
        "format": "OKX 交易对:币种-USDT;只有永续的币写 币种-USDT-SWAP",
        "hint": "第 5 个币;五个互不重复;n5 填它的币种代码"
      },
      "n5": {
        "kind": "value",
        "format": "p5 的币种代码,如 BTC"
      }
    }
  },
  "events": {
    "onClick": "numable://self",
    "onEdit": "/pick?ref=top&p1=${p1}&n1=${n1}&p2=${p2}&n2=${n2}&p3=${p3}&n3=${n3}&p4=${p4}&n4=${n4}&p5=${p5}&n5=${n5}"
  },
  "canvas": {
    "source": "@[file://rc/top.rcn]",
    "depends": [
      {
        "_note": "§D 纯显式:裸 `@[file://…df]` 字符串绑定**传空入参** —— flow 里的 ${x} 取到空、请求打空参,卡片渲一片 `--` 且**不报错**(流仍 success)。要把 widget params 喂给 flow,必须在绑定处显式写 {flow, params}。与 .xpage 的 depends 同一条规则,没有例外。",
        "flow": "@[file://flow/top.df]",
        "params": {
          "p1": "${p1}",
          "n1": "${n1}",
          "p2": "${p2}",
          "n2": "${n2}",
          "p3": "${p3}",
          "n3": "${n3}",
          "p4": "${p4}",
          "n4": "${n4}",
          "p5": "${p5}",
          "n5": "${n5}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "5"
      ]
    }
  }
}
