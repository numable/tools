        "y": "105pt",
        "w": "150pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.range} $[findNotEmpty::(${loS},--)] – $[findNotEmpty::(${hiS},--)]",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "vDot",
