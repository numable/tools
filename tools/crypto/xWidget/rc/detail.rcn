        }
      },
      {
        "id": "verdict",
        "type": "txt",
        "x": "26.0pt",
        "y": "104pt",
        "w": "279pt",
        "h": "-1",
        "maxLines": "1",
        "alignmentH": "2",
        "text": "$[if::(le::(${pos},8),${@i18n.vLow},if::(ge::(${pos},92),${@i18n.vHigh},connect::(${@i18n.vMid},findNotEmpty::(${pos},--),%)))]",
        "fontSize": "10.5pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "_note": "整张卡的结论句 —— 也是这次改版的支点:回答「今天这波在哪儿」,不是「现在是多少」。"
      },
