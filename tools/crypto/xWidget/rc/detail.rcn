{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FEFBF7\\,#FDF3E7)@90|linear(#15171A\\,#191A1B\\,#211F1D)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "14.0pt",
        "y": "{sym.y}+({sym.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#F0972A|#FFB454",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "sym",
        "type": "richText",
        "x": "23.0pt",
        "y": "12pt",
        "w": "151pt",
        "h": "-1",
        "maxLines": "1",
        "spans": [
          {
            "text": "$[findNotEmpty::(${sym},${name},--)]",
            "fontSize": "13pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "text": "/USDT",
            "fontSize": "13pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "_note": "时效锚与成交量同一行;失败态(空数据)下整串会剩一个孤零零的「· 量」,故按 vol 有无二选一。",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${vol},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "id": "at",
            "type": "txt",
            "x": "14.0pt",
            "y": "15pt",
            "w": "310.0pt",
            "h": "-1",
            "alignmentH": "2",
            "maxLines": "1",
            "text": "${at} · ${@i18n.vol}${vol} $[findNotEmpty::(${sym},)]",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${vol},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "id": "at0",
            "type": "txt",
            "x": "14.0pt",
            "y": "15pt",
            "w": "310.0pt",
            "h": "-1",
            "alignmentH": "2",
            "maxLines": "1",
            "text": "--",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "id": "num",
        "type": "richText",
        "x": "14.0pt",
        "y": "30pt",
        "w": "160pt",
        "h": "-1",
        "maxLines": "1",
        "spans": [
          {
            "text": "$[findNotEmpty::(${lead},--)]",
            "fontSize": "34pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "text": "${leadT}",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "id": "tri",
        "type": "path",
        "x": "14.0pt",
        "y": "77pt",
        "w": "9.0pt",
        "h": "5.94pt",
        "d": "$[if::(eq::(${up},1),M128 64 L240 192 L16 192 Z,M128 192 L16 64 L240 64 Z)]",
        "viewBox": "0 0 256 256",
        "fillColor": "$[if::(eq::(${flat},1),#9AA0A6,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6,if::(eq::(${up},1),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${up},1),#1FC77D,#FF5C4D)))),if::(eq::(${up},0),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${up},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "hide": "$[if::(eq::(${flat},1),1,if::(gt::(length::(${up}),0),0,1))]"
      },
      {
        "id": "flatBar",
        "type": "layer",
        "x": "14.0pt",
        "y": "80.5pt",
        "w": "8.0pt",
        "h": "1.5pt",
        "bgColor": "#9AA0A6|#8E939B",
        "hide": "$[if::(eq::(${flat},1),0,1)]"
      },
      {
        "id": "pct",
        "type": "txt",
        "x": "27.0pt",
        "y": "73pt",
        "w": "80pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(${flat},1),${@i18n.flat},connect::(findNotEmpty::(${chgA},--),%))]",
        "fontSize": "12.5pt",
        "typeface": "System-Bold",
        "textColor": "$[if::(eq::(${flat},1),#9AA0A6,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6,if::(eq::(${up},1),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${up},1),#1FC77D,#FF5C4D)))),if::(eq::(${up},0),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${up},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]"
      },
      {
        "id": "h24",
        "type": "txt",
        "x": "14.0pt",
        "y": "74pt",
        "w": "150pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "${@i18n.h24}",
        "fontSize": "10pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "chLbl",
        "type": "txt",
        "x": "174pt",
        "y": "15pt",
        "w": "142.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.hourly}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "_note": "图上那行标的是**采样粒度**(逐小时),不是窗口长度 —— 窗口长度已经由左边涨跌那行的「24 小时」说了,两处都写「24 小时」等于把一张卡上唯一的两个标签浪费成同一句话。"
      },
      {
        "id": "sparkAxis",
        "type": "line",
        "points": "[0,53.0,142.0,53.0]",
        "lineWidth": "1pt",
        "strokeColor": "#1A0E1116|#1AF3F4F6",
        "x": "174pt",
        "y": "24pt",
        "w": "142.0pt",
        "h": "54.0pt"
      },
      {
        "id": "spark",
        "type": "line",
        "points": "[${pts}]",
        "lineWidth": "1.8pt",
        "lineCap": "round",
        "lineJoin": "round",
        "strokeColor": "$[if::(eq::(${flat},1),#9AA0A6,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6,if::(eq::(${up},1),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${up},1),#1FC77D,#FF5C4D)))),if::(eq::(${up},0),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${up},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "coverageColor": "$[if::(eq::(${flat},1),linear(#1F9AA0A6\\,#009AA0A6)@90,if::(eq::(findNotEmpty::(${up},__none__),__none__),linear(#1F9AA0A6\\,#009AA0A6)@90,if::(eq::(${up},1),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),linear(#4AFF5C4D\\,#00FF5C4D)@90,linear(#4A1FC77D\\,#001FC77D)@90),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),linear(#4A1FC77D\\,#001FC77D)@90,linear(#4AFF5C4D\\,#00FF5C4D)@90),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),linear(#4AFF5C4D\\,#00FF5C4D)@90,linear(#4A1FC77D\\,#001FC77D)@90),if::(eq::(${up},1),linear(#4A1FC77D\\,#001FC77D)@90,linear(#4AFF5C4D\\,#00FF5C4D)@90)))),if::(eq::(${up},0),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),linear(#4AFF5C4D\\,#00FF5C4D)@90,linear(#4A1FC77D\\,#001FC77D)@90),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),linear(#4A1FC77D\\,#001FC77D)@90,linear(#4AFF5C4D\\,#00FF5C4D)@90),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),linear(#4AFF5C4D\\,#00FF5C4D)@90,linear(#4A1FC77D\\,#001FC77D)@90),if::(eq::(${up},1),linear(#4A1FC77D\\,#001FC77D)@90,linear(#4AFF5C4D\\,#00FF5C4D)@90)))),linear(#1F9AA0A6\\,#009AA0A6)@90))))]",
        "x": "174pt",
        "y": "24pt",
        "w": "142.0pt",
        "h": "54.0pt",
        "_note": "折线本体 + coverageColor 渐变面积。coverageColor 与 bgColor 走同一个 paint 构建器,所以面积可以是渐变、不必是平涂;它也能脱离可见描边单独存在(水印卡就是这么用的)。"
      },
      {
        "id": "sparkHalo",
        "type": "line",
        "points": "[134.99,$[findNotEmpty::(${lastY},-99)],135.0,$[findNotEmpty::(${lastY},-99)]]",
        "lineWidth": "14.0pt",
        "lineCap": "round",
        "strokeColor": "$[if::(eq::(${flat},1),#2E9AA0A6,if::(eq::(findNotEmpty::(${up},__none__),__none__),#2E9AA0A6,if::(eq::(${up},1),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),#2EFF5C4D,#2E1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),#2E1FC77D,#2EFF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),#2EFF5C4D,#2E1FC77D),if::(eq::(${up},1),#2E1FC77D,#2EFF5C4D)))),if::(eq::(${up},0),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),#2EFF5C4D,#2E1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),#2E1FC77D,#2EFF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),#2EFF5C4D,#2E1FC77D),if::(eq::(${up},1),#2E1FC77D,#2EFF5C4D)))),#2E9AA0A6))))]",
        "x": "174pt",
        "y": "24pt",
        "w": "142.0pt",
        "h": "54.0pt"
      },
      {
        "id": "sparkRing",
        "type": "line",
        "points": "[134.99,$[findNotEmpty::(${lastY},-99)],135.0,$[findNotEmpty::(${lastY},-99)]]",
        "lineWidth": "9.2pt",
        "lineCap": "round",
        "strokeColor": "#FFFFFF|#15171A",
        "x": "174pt",
        "y": "24pt",
        "w": "142.0pt",
        "h": "54.0pt"
      },
      {
        "id": "sparkDot",
        "type": "line",
        "points": "[134.99,$[findNotEmpty::(${lastY},-99)],135.0,$[findNotEmpty::(${lastY},-99)]]",
        "lineWidth": "6.2pt",
        "lineCap": "round",
        "strokeColor": "$[if::(eq::(${flat},1),#9AA0A6,if::(eq::(findNotEmpty::(${up},__none__),__none__),#9AA0A6,if::(eq::(${up},1),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${up},1),#1FC77D,#FF5C4D)))),if::(eq::(${up},0),if::(eq::(${@app.upColor},red),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${up},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${up},1),#FF5C4D,#1FC77D),if::(eq::(${up},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "x": "174pt",
        "y": "24pt",
        "w": "142.0pt",
        "h": "54.0pt"
      },
      {
        "id": "tile",
        "type": "layer",
        "x": "14.0pt",
        "y": "96pt",
