{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FEFBF7\\,#FDF3E7)@90|linear(#15171A\\,#191A1B\\,#211F1D)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12.0pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#F0972A|#FFB454",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "21.0pt",
        "y": "11pt",
        "w": "90pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.fng}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "12.0pt",
        "y": "14pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "alignmentH": "2"
      },
      {
        "id": "num",
        "type": "txt",
        "x": "12.0pt",
        "y": "30pt",
        "w": "70pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${fv},--)]",
        "fontSize": "34pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold"
      },
      {
        "id": "lbl",
        "type": "txt",
        "x": "12.0pt",
        "y": "45pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(findNotEmpty::(${band},__none__),__none__),--,if::(eq::(${band},0),${@i18n.b0},if::(eq::(${band},1),${@i18n.b1},if::(eq::(${band},2),${@i18n.b2},if::(eq::(${band},3),${@i18n.b3},if::(eq::(${band},4),${@i18n.b4},--))))))]",
        "fontSize": "12pt",
        "textColor": "$[if::(eq::(findNotEmpty::(${band},__none__),__none__),#9AA0A6,if::(eq::(${band},0),#E5484D,if::(eq::(${band},1),#F0972A,if::(eq::(${band},2),#9AA0A6,if::(eq::(${band},3),#65A30D,if::(eq::(${band},4),#16A34A,#9AA0A6))))))]",
        "typeface": "System-Bold",
        "alignmentH": "2"
      },
      {
        "id": "gauge",
        "type": "layer",
        "x": "12.0pt",
        "y": "80pt",
        "w": "134.0pt",
        "h": "6pt",
        "bgColor": "linear(#E5484D\\,#F0972A\\,#E8C547\\,#8BC34A\\,#1FC77D)@0|linear(#E5484D\\,#F0972A\\,#E8C547\\,#8BC34A\\,#1FC77D)@0",
        "cornerRadius": {
          "leftT": "3pt",
          "leftB": "3pt",
          "rightT": "3pt",
          "rightB": "3pt"
        }
      },
      {
        "id": "gRing",
        "type": "line",
        "points": "[$[findNotEmpty::(${gxa},-99)],6,$[findNotEmpty::(${gx},-99)],6]",
        "x": "12.0pt",
        "y": "77pt",
        "w": "134.0pt",
        "h": "12pt",
        "lineWidth": "12pt",
        "lineCap": "round",
        "strokeColor": "#FFFFFF|#15171A"
      },
      {
        "id": "gCur",
        "type": "line",
        "points": "[$[findNotEmpty::(${gxa},-99)],6,$[findNotEmpty::(${gx},-99)],6]",
        "x": "12.0pt",
        "y": "77pt",
        "w": "134.0pt",
        "h": "12pt",
        "lineWidth": "7pt",
        "lineCap": "round",
        "strokeColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "yest",
        "type": "txt",
        "x": "12.0pt",
        "y": "92pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.yest}$[findNotEmpty::(${yv},--)]",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "tile",
        "type": "layer",
        "x": "12.0pt",
        "y": "108pt",
        "w": "134.0pt",
        "h": "38pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "10pt",
          "leftB": "10pt",
          "rightT": "10pt",
          "rightB": "10pt"
        }
      },
      {
        "id": "dL",
        "type": "txt",
        "x": "20.0pt",
        "y": "113pt",
        "w": "60pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.dom}",
        "fontSize": "8.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "dV",
        "type": "txt",
        "x": "20.0pt",
        "y": "125pt",
        "w": "60pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${btcD},--)]%",
        "fontSize": "12pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold"
      },
      {
        "id": "mL",
        "type": "txt",
        "x": "82.0pt",
        "y": "113pt",
        "w": "56pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.mcap}",
        "fontSize": "8.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "mV",
        "type": "txt",
        "x": "82.0pt",
        "y": "125pt",
        "w": "56pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${mcT},--)]",
        "fontSize": "12pt",
        "textColor": "$[if::(eq::(${mcFl},1),#9AA0A6,if::(eq::(findNotEmpty::(${mcUp},__none__),__none__),#9AA0A6,if::(eq::(${mcUp},1),if::(eq::(${@app.upColor},red),if::(eq::(${mcUp},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${mcUp},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${mcUp},1),#FF5C4D,#1FC77D),if::(eq::(${mcUp},1),#1FC77D,#FF5C4D)))),if::(eq::(${mcUp},0),if::(eq::(${@app.upColor},red),if::(eq::(${mcUp},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${mcUp},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${mcUp},1),#FF5C4D,#1FC77D),if::(eq::(${mcUp},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "typeface": "System-Bold"
      }
    ],
    "i18n": {
      "zh-CN": {
        "fng": "恐惧贪婪",
        "b0": "极度恐惧",
