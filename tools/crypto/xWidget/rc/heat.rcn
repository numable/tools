        "textColor": "$[if::(eq::(${c6fl},1),#9AA0A6,if::(eq::(findNotEmpty::(${c6up},__none__),__none__),#9AA0A6,if::(eq::(${c6up},1),if::(eq::(${@app.upColor},red),if::(eq::(${c6up},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${c6up},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${c6up},1),#FF5C4D,#1FC77D),if::(eq::(${c6up},1),#1FC77D,#FF5C4D)))),if::(eq::(${c6up},0),if::(eq::(${@app.upColor},red),if::(eq::(${c6up},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${c6up},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${c6up},1),#FF5C4D,#1FC77D),if::(eq::(${c6up},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "typeface": "System-Bold",
        "hide": "$[if::(gt::(6,findNotEmpty::(${tot},6)),1,0)]"
      }
    ],
    "i18n": {
      "zh-CN": {
        "heat": "自选热力"
      },
      "en-US": {
        "heat": "Watchlist heat"
      }
    }
  }
}
