        "w": "83.33333333333333pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${mcT},--)]",
        "fontSize": "11.5pt",
        "textColor": "$[if::(eq::(${mcFl},1),#9AA0A6,if::(eq::(findNotEmpty::(${mcUp},__none__),__none__),#9AA0A6,if::(eq::(${mcUp},1),if::(eq::(${@app.upColor},red),if::(eq::(${mcUp},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${mcUp},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${mcUp},1),#FF5C4D,#1FC77D),if::(eq::(${mcUp},1),#1FC77D,#FF5C4D)))),if::(eq::(${mcUp},0),if::(eq::(${@app.upColor},red),if::(eq::(${mcUp},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${mcUp},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${mcUp},1),#FF5C4D,#1FC77D),if::(eq::(${mcUp},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "typeface": "System-Bold"
      },
      {
