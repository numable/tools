{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FEFBF7\\,#FDF3E7)@90|linear(#15171A\\,#191A1B\\,#211F1D)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "14.0pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#F0972A|#FFB454",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "23.0pt",
        "y": "12pt",
        "w": "200pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.moodw}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "14.0pt",
        "y": "15pt",
        "w": "310.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "alignmentH": "2"
      },
      {
        "id": "num",
        "type": "txt",
        "x": "14.0pt",
        "y": "32pt",
        "w": "90pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${fv},--)]",
        "fontSize": "34pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold"
      },
      {
        "id": "lbl",
        "type": "txt",
        "x": "14.0pt",
        "y": "74pt",
        "w": "130pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(findNotEmpty::(${band},__none__),__none__),--,if::(eq::(${band},0),${@i18n.b0},if::(eq::(${band},1),${@i18n.b1},if::(eq::(${band},2),${@i18n.b2},if::(eq::(${band},3),${@i18n.b3},if::(eq::(${band},4),${@i18n.b4},--))))))]",
        "fontSize": "12pt",
        "textColor": "$[if::(eq::(findNotEmpty::(${band},__none__),__none__),#9AA0A6,if::(eq::(${band},0),#E5484D,if::(eq::(${band},1),#F0972A,if::(eq::(${band},2),#9AA0A6,if::(eq::(${band},3),#65A30D,if::(eq::(${band},4),#16A34A,#9AA0A6))))))]",
        "typeface": "System-Bold"
      },
      {
        "id": "ago",
        "type": "txt",
        "x": "14.0pt",
        "y": "92pt",
        "w": "140pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.d7ago}$[findNotEmpty::(${v7},--)] · ${@i18n.d30ago}$[findNotEmpty::(${v30},--)]",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "r75",
        "type": "line",
        "points": "[0,$[findNotEmpty::(${y75},-99)],168,$[findNotEmpty::(${y75},-99)]]",
        "x": "156.0pt",
        "y": "30.0pt",
        "w": "168.0pt",
        "h": "70.0pt",
        "lineWidth": "1pt",
        "strokeColor": "#1A0E1116|#1AF3F4F6"
      },
      {
        "id": "r25",
        "type": "line",
        "points": "[0,$[findNotEmpty::(${y25},-99)],168,$[findNotEmpty::(${y25},-99)]]",
        "x": "156.0pt",
        "y": "30.0pt",
        "w": "168.0pt",
        "h": "70.0pt",
        "lineWidth": "1pt",
        "strokeColor": "#1A0E1116|#1AF3F4F6"
      },
      {
        "id": "line",
        "type": "line",
        "points": "[${pts}]",
        "lineWidth": "1.8pt",
        "lineCap": "round",
        "lineJoin": "round",
        "strokeColor": "#F0972A|#FFB454",
        "coverageColor": "linear(#4AF0972A\\,#00F0972A)@90|linear(#4AFFB454\\,#00FFB454)@90",
        "x": "156.0pt",
        "y": "30.0pt",
        "w": "168.0pt",
        "h": "70.0pt",
        "_note": "折线本体 + coverageColor 渐变面积。coverageColor 与 bgColor 走同一个 paint 构建器,所以面积可以是渐变、不必是平涂;它也能脱离可见描边单独存在(水印卡就是这么用的)。"
      },
      {
        "id": "lineHalo",
        "type": "line",
        "points": "[162.99,$[findNotEmpty::(${lastY},-99)],163.0,$[findNotEmpty::(${lastY},-99)]]",
        "lineWidth": "10.0pt",
        "lineCap": "round",
        "strokeColor": "#2EF0972A|#2EFFB454",
        "x": "156.0pt",
        "y": "30.0pt",
        "w": "168.0pt",
        "h": "70.0pt"
      },
      {
        "id": "lineRing",
        "type": "line",
        "points": "[162.99,$[findNotEmpty::(${lastY},-99)],163.0,$[findNotEmpty::(${lastY},-99)]]",
        "lineWidth": "6.6pt",
        "lineCap": "round",
        "strokeColor": "#FFFFFF|#15171A",
        "x": "156.0pt",
        "y": "30.0pt",
        "w": "168.0pt",
        "h": "70.0pt"
      },
      {
        "id": "lineDot",
        "type": "line",
        "points": "[162.99,$[findNotEmpty::(${lastY},-99)],163.0,$[findNotEmpty::(${lastY},-99)]]",
        "lineWidth": "4.5pt",
        "lineCap": "round",
        "strokeColor": "#F0972A|#FFB454",
        "x": "156.0pt",
        "y": "30.0pt",
        "w": "168.0pt",
        "h": "70.0pt"
      },
      {
        "id": "tile",
        "type": "layer",
        "x": "14.0pt",
