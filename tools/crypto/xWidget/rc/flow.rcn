{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FEFBF7\\,#FDF3E7)@90|linear(#15171A\\,#191A1B\\,#211F1D)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12.0pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#F0972A|#FFB454",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "21.0pt",
        "y": "11pt",
        "w": "200pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.flowT}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "12.0pt",
        "y": "14pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "alignmentH": "2"
      },
      {
        "id": "sub",
        "type": "txt",
        "x": "12.0pt",
        "y": "30pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${sym},${name},--)] · ${@i18n.book20}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "lbl",
        "type": "txt",
        "x": "12.0pt",
        "y": "45pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.bidSide}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "num",
        "type": "richText",
        "x": "12.0pt",
        "y": "61pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "spans": [
          {
            "text": "$[findNotEmpty::(${bidR},--)]",
            "fontSize": "24pt",
            "typeface": "System-Bold",
            "textColor": "$[if::(eq::(findNotEmpty::(${bL},__none__),__none__),#9AA0A6,if::(eq::(${bL},1),if::(eq::(${@app.upColor},red),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bL},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${bL},1),#1FC77D,#FF5C4D)))),if::(eq::(${bL},0),if::(eq::(${@app.upColor},red),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bL},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${bL},1),#1FC77D,#FF5C4D)))),#9AA0A6)))]"
          },
          {
            "text": "%",
            "fontSize": "14pt",
            "typeface": "System-Bold",
            "textColor": "$[if::(eq::(findNotEmpty::(${bL},__none__),__none__),#9AA0A6,if::(eq::(${bL},1),if::(eq::(${@app.upColor},red),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bL},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${bL},1),#1FC77D,#FF5C4D)))),if::(eq::(${bL},0),if::(eq::(${@app.upColor},red),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bL},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${bL},1),#1FC77D,#FF5C4D)))),#9AA0A6)))]"
          }
        ]
      },
      {
        "id": "barL",
        "type": "line",
        "points": "[3,3,$[findNotEmpty::(${bxL},62)],3]",
        "x": "12.0pt",
        "y": "91pt",
        "w": "134.0pt",
        "h": "6pt",
        "lineWidth": "6pt",
        "lineCap": "round",
        "strokeColor": "$[if::(eq::(findNotEmpty::(${bL},__none__),__none__),#9AA0A6,if::(eq::(${bL},1),if::(eq::(${@app.upColor},red),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bL},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${bL},1),#1FC77D,#FF5C4D)))),if::(eq::(${bL},0),if::(eq::(${@app.upColor},red),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bL},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bL},1),#FF5C4D,#1FC77D),if::(eq::(${bL},1),#1FC77D,#FF5C4D)))),#9AA0A6)))]",
        "_note": "取不到数时 bL / bR 不存在 → 两段都落灰(原来空态画成 62/72 的红绿假分割,读起来像有数据)"
      },
      {
        "id": "barR",
        "type": "line",
        "points": "[$[findNotEmpty::(${bxR},72)],3,131,3]",
        "x": "12.0pt",
        "y": "91pt",
        "w": "134.0pt",
        "h": "6pt",
        "lineWidth": "6pt",
        "lineCap": "round",
        "strokeColor": "$[if::(eq::(findNotEmpty::(${bR},__none__),__none__),#9AA0A6,if::(eq::(${bR},1),if::(eq::(${@app.upColor},red),if::(eq::(${bR},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bR},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bR},1),#FF5C4D,#1FC77D),if::(eq::(${bR},1),#1FC77D,#FF5C4D)))),if::(eq::(${bR},0),if::(eq::(${@app.upColor},red),if::(eq::(${bR},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${bR},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${bR},1),#FF5C4D,#1FC77D),if::(eq::(${bR},1),#1FC77D,#FF5C4D)))),#9AA0A6)))]"
      },
      {
        "id": "spr",
        "type": "txt",
        "x": "12.0pt",
        "y": "102pt",
        "w": "134.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.spread}$[findNotEmpty::(${sprS},--)]${@i18n.bp}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "tile",
        "type": "layer",
        "x": "12.0pt",
        "y": "116pt",
        "w": "134.0pt",
        "h": "30pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "9pt",
          "leftB": "9pt",
          "rightT": "9pt",
          "rightB": "9pt"
        }
      },
      {
        "id": "trN",
        "type": "txt",
        "x": "20.0pt",
        "y": "124pt",
        "w": "118.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.trN}$[findNotEmpty::(${span},--)]${@i18n.min}",
        "fontSize": "8.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "tk",
        "type": "txt",
        "x": "20.0pt",
        "y": "122pt",
        "w": "118.0pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${tkB},--)]%",
        "fontSize": "12pt",
        "textColor": "$[if::(eq::(findNotEmpty::(${tkUp},__none__),__none__),#9AA0A6,if::(eq::(${tkUp},1),if::(eq::(${@app.upColor},red),if::(eq::(${tkUp},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${tkUp},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${tkUp},1),#FF5C4D,#1FC77D),if::(eq::(${tkUp},1),#1FC77D,#FF5C4D)))),if::(eq::(${tkUp},0),if::(eq::(${@app.upColor},red),if::(eq::(${tkUp},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${tkUp},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${tkUp},1),#FF5C4D,#1FC77D),if::(eq::(${tkUp},1),#1FC77D,#FF5C4D)))),#9AA0A6)))]",
        "typeface": "System-Bold",
        "alignmentH": "2"
      }
    ],
    "i18n": {
      "zh-CN": {
        "flowT": "买卖力量",
        "book20": "盘口 20 档",
        "bidSide": "盘口买方",
        "spread": "价差 ",
        "bp": " 个基点",
        "trN": "主动买入 · 近 ",
        "min": " 分钟"
      },
      "en-US": {
        "flowT": "Order flow",
        "book20": "20-level book",
        "bidSide": "Bid side",
        "spread": "Spread ",
        "bp": " bp",
