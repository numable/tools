{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FEFBF7\\,#FDF3E7)@90|linear(#15171A\\,#191A1B\\,#211F1D)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{sym.y}+({sym.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#F0972A|#FFB454",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "sym",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "46pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${sym},${name},--)]",
        "fontSize": "11pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold"
      },
      {
        "id": "pct",
        "type": "txt",
        "x": "60pt",
        "y": "10pt",
        "w": "52pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${pT}",
        "fontSize": "10pt",
        "textColor": "$[if::(eq::(${pfl},1),#9AA0A6,if::(eq::(findNotEmpty::(${pup},__none__),__none__),#9AA0A6,if::(eq::(${pup},1),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${pup},1),#1FC77D,#FF5C4D)))),if::(eq::(${pup},0),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${pup},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "typeface": "System-Bold"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "113pt",
        "y": "10.5pt",
        "w": "35pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${at}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "alignmentH": "2"
      },
      {
        "id": "px",
        "type": "richText",
        "x": "10pt",
        "y": "27pt",
        "w": "82pt",
        "h": "-1",
        "maxLines": "1",
        "spans": [
          {
            "text": "$[findNotEmpty::(${L},--)]",
            "fontSize": "16.5pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "text": "${LT}",
            "fontSize": "10pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "id": "spark",
        "type": "line",
        "points": "[${pts}]",
        "lineWidth": "1.6pt",
        "lineCap": "round",
        "lineJoin": "round",
        "strokeColor": "$[if::(eq::(${pfl},1),#9AA0A6,if::(eq::(findNotEmpty::(${pup},__none__),__none__),#9AA0A6,if::(eq::(${pup},1),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${pup},1),#1FC77D,#FF5C4D)))),if::(eq::(${pup},0),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${pup},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "coverageColor": "$[if::(eq::(${pfl},1),linear(#1F9AA0A6\\,#009AA0A6)@90,if::(eq::(findNotEmpty::(${pup},__none__),__none__),linear(#1F9AA0A6\\,#009AA0A6)@90,if::(eq::(${pup},1),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),linear(#4AFF5C4D\\,#00FF5C4D)@90,linear(#4A1FC77D\\,#001FC77D)@90),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),linear(#4A1FC77D\\,#001FC77D)@90,linear(#4AFF5C4D\\,#00FF5C4D)@90),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),linear(#4AFF5C4D\\,#00FF5C4D)@90,linear(#4A1FC77D\\,#001FC77D)@90),if::(eq::(${pup},1),linear(#4A1FC77D\\,#001FC77D)@90,linear(#4AFF5C4D\\,#00FF5C4D)@90)))),if::(eq::(${pup},0),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),linear(#4AFF5C4D\\,#00FF5C4D)@90,linear(#4A1FC77D\\,#001FC77D)@90),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),linear(#4A1FC77D\\,#001FC77D)@90,linear(#4AFF5C4D\\,#00FF5C4D)@90),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),linear(#4AFF5C4D\\,#00FF5C4D)@90,linear(#4A1FC77D\\,#001FC77D)@90),if::(eq::(${pup},1),linear(#4A1FC77D\\,#001FC77D)@90,linear(#4AFF5C4D\\,#00FF5C4D)@90)))),linear(#1F9AA0A6\\,#009AA0A6)@90))))]",
        "x": "90pt",
        "y": "22pt",
        "w": "58.0pt",
        "h": "24.0pt",
        "_note": "折线本体 + coverageColor 渐变面积。coverageColor 与 bgColor 走同一个 paint 构建器,所以面积可以是渐变、不必是平涂;它也能脱离可见描边单独存在(水印卡就是这么用的)。"
      },
      {
        "id": "sparkHalo",
        "type": "line",
        "points": "[53.99,$[findNotEmpty::(${lastY},-99)],54.0,$[findNotEmpty::(${lastY},-99)]]",
        "lineWidth": "8.0pt",
        "lineCap": "round",
        "strokeColor": "$[if::(eq::(${pfl},1),#9AA0A6,if::(eq::(findNotEmpty::(${pup},__none__),__none__),#9AA0A6,if::(eq::(${pup},1),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),#2EFF5C4D,#2E1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),#2E1FC77D,#2EFF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),#2EFF5C4D,#2E1FC77D),if::(eq::(${pup},1),#2E1FC77D,#2EFF5C4D)))),if::(eq::(${pup},0),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),#2EFF5C4D,#2E1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),#2E1FC77D,#2EFF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),#2EFF5C4D,#2E1FC77D),if::(eq::(${pup},1),#2E1FC77D,#2EFF5C4D)))),#9AA0A6))))]",
        "x": "90pt",
        "y": "22pt",
        "w": "58.0pt",
        "h": "24.0pt"
      },
      {
        "id": "sparkRing",
        "type": "line",
        "points": "[53.99,$[findNotEmpty::(${lastY},-99)],54.0,$[findNotEmpty::(${lastY},-99)]]",
        "lineWidth": "5.3pt",
        "lineCap": "round",
        "strokeColor": "#FFFFFF|#15171A",
        "x": "90pt",
        "y": "22pt",
        "w": "58.0pt",
        "h": "24.0pt"
      },
      {
        "id": "sparkDot",
        "type": "line",
        "points": "[53.99,$[findNotEmpty::(${lastY},-99)],54.0,$[findNotEmpty::(${lastY},-99)]]",
        "lineWidth": "3.6pt",
        "lineCap": "round",
        "strokeColor": "$[if::(eq::(${pfl},1),#9AA0A6,if::(eq::(findNotEmpty::(${pup},__none__),__none__),#9AA0A6,if::(eq::(${pup},1),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${pup},1),#1FC77D,#FF5C4D)))),if::(eq::(${pup},0),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${pup},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "x": "90pt",
        "y": "22pt",
        "w": "58.0pt",
        "h": "24.0pt"
      }
