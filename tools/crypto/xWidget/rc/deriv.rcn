{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FEFBF7\\,#FDF3E7)@90|linear(#15171A\\,#191A1B\\,#211F1D)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "14.0pt",
        "y": "{sym.y}+({sym.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#F0972A|#FFB454",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
