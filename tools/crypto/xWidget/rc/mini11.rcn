{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FEFBF7\\,#FDF3E7)@90|linear(#15171A\\,#191A1B\\,#211F1D)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8pt",
        "y": "{sym.y}+({sym.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#F0972A|#FFB454",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "sym",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${sym},${name},--)]",
        "fontSize": "10pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${vf},20),1,if::(eq::(${vf},17),1,if::(eq::(${vf},16),1,0)))]"
        },
        "react": [
          {
            "id": "v",
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${v11}",
            "fontSize": "${vf}pt",
            "textColor": "#0E1116|#F3F4F6",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(${vf},20),1,if::(eq::(${vf},17),1,if::(eq::(${vf},16),1,0))),1),0,1)]"
        },
        "react": [
          {
            "id": "vE",
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "20pt",
            "textColor": "#0E1116|#F3F4F6",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "id": "s",
        "type": "txt",
        "x": "8pt",
        "y": "46pt",
        "w": "54pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${pT},--)]",
        "fontSize": "9pt",
        "textColor": "$[if::(eq::(${pfl},1),#9AA0A6,if::(eq::(findNotEmpty::(${pup},__none__),__none__),#9AA0A6,if::(eq::(${pup},1),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${pup},1),#1FC77D,#FF5C4D)))),if::(eq::(${pup},0),if::(eq::(${@app.upColor},red),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${@app.upColor},green),if::(eq::(${pup},1),#1FC77D,#FF5C4D),if::(startsWith::(${@app.language},zh),if::(eq::(${pup},1),#FF5C4D,#1FC77D),if::(eq::(${pup},1),#1FC77D,#FF5C4D)))),#9AA0A6))))]",
        "lineBreak": "0"
      }
    ],
    "i18n": {
      "zh-CN": {},
      "en-US": {}
    }
  }
}
