{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FEFBF7\\,#FDF3E7)@90|linear(#15171A\\,#191A1B\\,#211F1D)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#F0972A|#FFB454",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.fngS}",
        "fontSize": "10pt",
        "textColor": "#0E1116|#F3F4F6",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${fv},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "id": "v",
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${fv}",
            "fontSize": "20pt",
            "textColor": "#0E1116|#F3F4F6",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${fv},__none__),__none__),1,0)]"
        },
        "react": [
          {
            "id": "vE",
            "type": "txt",
            "x": "8pt",
            "y": "28pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "20pt",
            "textColor": "#0E1116|#F3F4F6",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "id": "b",
        "type": "txt",
        "x": "8pt",
        "y": "46pt",
        "w": "54pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(findNotEmpty::(${band},__none__),__none__),--,if::(eq::(${band},0),${@i18n.s0},if::(eq::(${band},1),${@i18n.s1},if::(eq::(${band},2),${@i18n.s2},if::(eq::(${band},3),${@i18n.s3},if::(eq::(${band},4),${@i18n.s4},--))))))]",
        "fontSize": "9pt",
        "textColor": "$[if::(eq::(findNotEmpty::(${band},__none__),__none__),#9AA0A6,if::(eq::(${band},0),#E5484D,if::(eq::(${band},1),#F0972A,if::(eq::(${band},2),#9AA0A6,if::(eq::(${band},3),#65A30D,if::(eq::(${band},4),#16A34A,#9AA0A6))))))]",
        "typeface": "System-Bold",
        "lineBreak": "0"
      }
    ],
    "i18n": {
      "zh-CN": {
        "fngS": "恐惧贪婪",
        "s0": "极度恐惧",
        "s1": "恐惧",
        "s2": "中性",
        "s3": "贪婪",
        "s4": "极度贪婪"
      },
      "en-US": {
        "fngS": "F&G",
        "s0": "Ext. fear",
        "s1": "Fear",
        "s2": "Neutral",
        "s3": "Greed",
        "s4": "Ext. greed"
      }
    }
  }
}
