{
  "version": 2,
  "title": "买卖力量",
  "sub": "盘口买卖占比 · 价差 · 主动买入",
  "i18n": {
    "en-US": {
      "title": "Order flow",
      "sub": "Book imbalance, spread, taker buys"
    }
  },
  "layout": 22,
  "params": {
    "pair": "BTC-USDT",
    "name": "BTC"
  },
  "ai": {
    "shows": "一个币的盘口 20 档买方占比、买卖价差(基点)、近期主动买入占比",
    "params": {
      "pair": {
        "kind": "value",
        "group": [
          "pair",
          "name"
        ],
        "format": "OKX 交易对:币种-USDT(现货);只有永续合约的币写 币种-USDT-SWAP",
        "hint": "name 填 pair 的币种部分(BTC-USDT → BTC)",
        "examples": [
          "BTC-USDT",
          "ETH-USDT",
          "SOL-USDT",
          "DOGE-USDT"
        ]
      },
      "name": {
        "kind": "value",
        "format": "币种代码 = pair 第一段,如 BTC"
      }
    }
  },
  "events": {
    "onClick": "/coin?pair=${pair}&name=${name}",
    "onEdit": "/pick?pair=${pair}&name=${name}"
  },
  "canvas": {
    "source": "@[file://rc/flow.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/flow.df]",
        "params": {
          "pair": "${pair}",
          "name": "${name}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3"
      ]
    }
  }
}
