{
  "version": 2,
  "title": "自选热力",
  "sub": "自选前 6 个 · 涨跌幅度一眼看",
  "i18n": {
    "en-US": {
      "title": "Watchlist heat",
      "sub": "Your first 6 coins, colored by 24h move"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "自选列表前 6 个币按 24h 涨跌幅着色的热力块(读用户在本工具里的自选)"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/heat.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/heat.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "5"
      ]
    }
  }
}
