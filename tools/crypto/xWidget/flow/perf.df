        "value": "$[if::(lt::(${q5TA},2),0,if::(lt::(${q5TA},5),1,if::(lt::(${q5TA},15),2,3)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "b6v",
        "value": "$[index::(index::(${d_q},90),4)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "q6c",
        "value": "$[parseNumber::(calc::((${last}-${b6v})/${b6v}*100),0.00)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "q6up",
        "value": "$[if::(gt::(length::(${q6c}),0),if::(ge::(${q6c},0),1,0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "q6fl",
        "value": "$[if::(gt::(length::(${q6c}),0),if::(lt::(calc::(${q6c}*${q6c}),0.000025),1,0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "q6TA",
        "value": "$[if::(gt::(${q6c},0),${q6c},calc::(0-${q6c}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "q6TF",
        "value": "$[if::(ne::(findNotEmpty::(${q6c},__none__),__none__),parseNumber::(${q6TA},0.00),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "q6T",
        "value": "$[if::(ne::(findNotEmpty::(${q6c},__none__),__none__),if::(eq::(${q6TF},0),connect::(${q6TF},%),connect::(if::(gt::(${q6c},0),+,−),${q6TF},%)),--)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "b6",
        "value": "$[if::(lt::(${q6TA},2),0,if::(lt::(${q6TA},5),1,if::(lt::(${q6TA},15),2,3)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "at",
        "value": "$[formatDate::(${@time.nowMs},HH:mm)]"
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "sym",
          "pxS",
          "offH",
          "offL",
          "at",
          "q1T",
          "q1up",
          "q1fl",
          "b1",
