{
  "version": 1,
  "_note": "自选热力:自选前 6 个币的 24h 涨跌,块的底色深浅 = 幅度(<0.5% / <2% / <5% / ≥5% 四档)。",
  "i18n": {
    "zh-CN": {
      "noData": "暂时取不到行情"
    },
    "en-US": {
      "noData": "Quotes unavailable"
    }
  },
  "actions": [
    {
      "id": "sp1",
      "action": "data.get",
      "params": {
        "key": "w.p1",
        "default": "BTC-USDT"
      },
      "_note": "自选槽:H5 页的 wlSave 把 data.wl 的前 8 个镜像到 w.p1…w.p8(不足循环补齐),这张卡读前 6 个。"
    },
    {
      "id": "sp2",
      "action": "data.get",
      "params": {
        "key": "w.p2",
        "default": "ETH-USDT"
      }
    },
    {
      "id": "sp3",
      "action": "data.get",
      "params": {
