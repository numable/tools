    },
    {
      "op": "set",
      "props": {
        "key": "c5TF",
        "value": "$[if::(ne::(findNotEmpty::(${c5c},__none__),__none__),parseNumber::(${c5TA},0.00),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "c5T",
        "value": "$[if::(ne::(findNotEmpty::(${c5c},__none__),__none__),if::(eq::(${c5TF},0),connect::(${c5TF},%),connect::(if::(gt::(${c5c},0),+,−),${c5TF},%)),--)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "s5",
        "value": "$[if::(eq::(findNotEmpty::(${l5},__none__),__none__),--,if::(ge::(${l5},1000),parseNumber::(${l5},#\\,##0.0),if::(ge::(${l5},100),parseNumber::(${l5},0.00),if::(ge::(${l5},1),parseNumber::(${l5},0.000),if::(ge::(${l5},0.01),parseNumber::(${l5},0.00000),parseNumber::(${l5},0.0000000))))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "b5",
        "value": "$[if::(lt::(${c5TA},0.5),0,if::(lt::(${c5TA},2),1,if::(lt::(${c5TA},5),2,3)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "l6",
        "value": "$[get::(index::(${t6_q},0),last)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "o6",
        "value": "$[get::(index::(${t6_q},0),open24h)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "n6",
        "value": "$[index::(split::(${k6},-),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "c6c",
        "value": "$[parseNumber::(calc::((${l6}-${o6})/${o6}*100),0.00)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "c6up",
        "value": "$[if::(gt::(length::(${c6c}),0),if::(ge::(${c6c},0),1,0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "c6fl",
        "value": "$[if::(gt::(length::(${c6c}),0),if::(lt::(calc::(${c6c}*${c6c}),0.000025),1,0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "c6TA",
        "value": "$[if::(gt::(${c6c},0),${c6c},calc::(0-${c6c}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "c6TF",
        "value": "$[if::(ne::(findNotEmpty::(${c6c},__none__),__none__),parseNumber::(${c6TA},0.00),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "c6T",
        "value": "$[if::(ne::(findNotEmpty::(${c6c},__none__),__none__),if::(eq::(${c6TF},0),connect::(${c6TF},%),connect::(if::(gt::(${c6c},0),+,−),${c6TF},%)),--)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "s6",
        "value": "$[if::(eq::(findNotEmpty::(${l6},__none__),__none__),--,if::(ge::(${l6},1000),parseNumber::(${l6},#\\,##0.0),if::(ge::(${l6},100),parseNumber::(${l6},0.00),if::(ge::(${l6},1),parseNumber::(${l6},0.000),if::(ge::(${l6},0.01),parseNumber::(${l6},0.00000),parseNumber::(${l6},0.0000000))))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "b6",
        "value": "$[if::(lt::(${c6TA},0.5),0,if::(lt::(${c6TA},2),1,if::(lt::(${c6TA},5),2,3)))]"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${l1}),0),0,1)]"
      },
      "items": [
        {
          "action": "error",
          "params": {
            "errorMsg": "${@i18n.noData}"
          }
        }
      ],
      "_note": "取数失败 → 抛错终止流,平台据此回落上次成功数据(G26/§7.2)"
    },
    {
      "op": "set",
      "props": {
        "key": "tot",
        "value": "$[parseNumber::(findNotEmpty::(${stot},6),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "at",
        "value": "$[formatDate::(${@time.nowMs},HH:mm)]"
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
