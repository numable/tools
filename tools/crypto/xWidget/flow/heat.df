      "op": "set",
      "props": {
        "key": "kr1",
        "value": "$[findNotEmpty::(${sp1},btcusdt)]"
      },
      "_note": "⚠️ 入参先落地:方法参数里看不见 flow 入参(§9.5 #3)。"
    },
    {
      "op": "set",
      "props": {
        "key": "k1",
        "value": "$[if::(contains::(${kr1},-),toUpperCase::(${kr1}),connect::(toUpperCase::(if::(endsWith::(${kr1},usdt),subString::(${kr1},0,calc::(length::(${kr1})-4)),if::(endsWith::(${kr1},usdc),subString::(${kr1},0,calc::(length::(${kr1})-4)),if::(endsWith::(${kr1},usd),subString::(${kr1},0,calc::(length::(${kr1})-3)),${kr1})))),-,if::(endsWith::(${kr1},usdc),USDC,USDT)))]"
      },
      "_note": "币对归一:老实例是 Bitstamp 形状 `btcusd`,新实例是 OKX instId `BTC-USDT`,两种都认。"
    },
    {
      "op": "set",
      "props": {
