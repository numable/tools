    {
      "op": "set",
      "props": {
        "key": "t1_ok",
        "value": "$[if::(eq::(findNotEmpty::(${t1_c.last},__none__),__none__),0,1)]"
      },
      "_fb": 1
    },
    {
      "op": "set",
      "props": {
        "key": "t1_q",
        "value": "${t1.data}"
      },
      "_fb": 1,
      "_note": "下游统一读 t1_q:OKX 的 data,或下面按 OKX 形状重排的备用数据。"
    },
    {
      "op": "if",
      "props": {
        "val": "${t1_ok}"
      },
      "_fb": 1,
      "items": [
        {
          "op": "set",
          "props": {
            "key": "t1_q",
            "value": [
              {
                "last": "$[connect::(${t1_c.last},)]",
                "open24h": "$[connect::(${t1_c.open},)]",
                "high24h": "$[connect::(${t1_c.high},)]",
                "low24h": "$[connect::(${t1_c.low},)]",
                "vol24h": "$[connect::(${t1_c.volume},)]",
                "volCcy24h": "$[if::(endsWith::(${k1},-SWAP),connect::(${t1_c.volume},),parseNumber::(calc::(${t1_c.volume}*${t1_c.last}),0))]"
              }
            ]
          },
          "_fb": 1
        }
      ]
    },
    {
