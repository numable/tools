          "$[index::(index::(${r_q},3),3)]",
          "$[index::(index::(${r_q},2),3)]",
          "$[index::(index::(${r_q},1),3)]",
          "$[index::(index::(${r_q},0),3)]"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lo",
        "value": "$[min::(${c})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hi",
        "value": "$[max::(${c})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hi24",
        "value": "$[max::(${h})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lo24",
        "value": "$[min::(${l})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "last",
        "value": "$[index::(${c},24)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "first",
        "value": "$[index::(${c},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "chg",
        "value": "$[parseNumber::(calc::((${last}-${first})/${first}*100),0.00)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "up",
        "value": "$[if::(gt::(length::(${chg}),0),if::(ge::(${chg},0),1,0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "flat",
        "value": "$[if::(gt::(length::(${chg}),0),if::(lt::(calc::(${chg}*${chg}),0.0004),1,0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "chgA",
        "value": "$[if::(ge::(${chg},0),${chg},calc::(0-${chg}))]"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${last}),0),0,1)]"
      },
      "items": [
        {
          "action": "error",
          "params": {
            "errorMsg": "${@i18n.noData}"
          }
        }
      ],
      "_note": "取数失败 → 抛错终止流,平台据此回落上次成功数据(G26/§7.2)"
    },
    {
      "op": "set",
      "props": {
        "key": "lead_s",
        "value": "$[if::(ge::(${last},1000),parseNumber::(${last},#\\,##0.00),if::(ge::(${last},100),parseNumber::(${last},0.00),if::(ge::(${last},10),parseNumber::(${last},0.000),if::(ge::(${last},1),parseNumber::(${last},0.0000),parseNumber::(${last},0.00000)))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lead_c",
        "value": "$[calc::(length::(${lead_s})-2)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lead",
        "value": "$[subString::(${lead_s},0,${lead_c})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "leadT",
        "value": "$[subString::(${lead_s},${lead_c},99)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pts_a",
        "value": [
          "0.0",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},0)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "5.6",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},1)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "11.2",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},2)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "16.9",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},3)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "22.5",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},4)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "28.1",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},5)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "33.8",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},6)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "39.4",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},7)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "45.0",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},8)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "50.6",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},9)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "56.2",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},10)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "61.9",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},11)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "67.5",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},12)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "73.1",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},13)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "78.8",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},14)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "84.4",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},15)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "90.0",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},16)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "95.6",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},17)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "101.2",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},18)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "106.9",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},19)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "112.5",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},20)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "118.1",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},21)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "123.8",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},22)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "129.4",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},23)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]",
          "135.0",
          "$[findNotEmpty::(parseNumber::(calc::((1-((index::(${c},24)-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pts",
        "value": "$[join::(${pts_a},\\,)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lastY",
        "value": "$[findNotEmpty::(parseNumber::(calc::((1-((${last}-${lo})/(${hi}-${lo})))*40.0+7.0),0.0),999)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "atNow",
        "value": "${@time.nowMs}"
      },
      "_hdr": 1,
      "_note": "builtin 先落地成键再进方法参数(kmid.df 同款)。"
    },
    {
      "op": "set",
      "props": {
        "key": "at",
        "value": "$[if::(gt::(findNotEmpty::(index::(index::(${r_q},0),0),0),1000000000000),formatDate::(${atNow},HH:mm),)]"
      },
      "_note": "时效锚(card-design-system §3)= 取数时刻,不是末根 1 小时蜡烛的开盘时刻(原写法 19:44 取数显示 19:00)。卡上价格取自进行中的那根蜡烛、随每次取数变,与 kday / kmid 同理;24 小时交易、取数恒在当天,只有 HH:mm 一档。末根蜡烛的时间戳(毫秒)只用来判「取到了」—— 取不到留空,不渲假时刻。",
      "_hdr": 1
    },
    {
      "op": "set",
      "props": {
        "key": "sym",
        "value": "$[index::(split::(${k},-),0)]"
      },
      "_note": "币种代码从 pair 推,不必让调用方多传一个参数;取不到时 .rcn 用 ${name} 兜底。"
    },
    {
      "op": "set",
      "props": {
        "key": "pos",
        "value": "$[parseNumber::(calc::((${last}-${lo24})/(${hi24}-${lo24})*100),0)]"
      },
      "_note": "24h 区间分位 0–100 —— 「今天这波在哪儿」这句话的唯一依据。"
    },
    {
      "op": "set",
      "props": {
        "key": "railW",
        "value": "$[parseNumber::(max::(calc::(${pos}/100*275.0+5.5),5.5),0.0)]"
      },
      "_note": "轨内游标圆心的横坐标(pt)。286.0 = 轨宽,11 = 游标直径 —— 与 rc/detail.rcn #rail 逐字对应。⚠️ 下限勿删:pos=0 时游标会压在轨的左端点外,而「正好在 24h 最低点」恰恰是这张卡最想说的那句话。"
    },
    {
      "op": "set",
      "props": {
        "key": "loS",
        "value": "$[if::(ge::(${lo24},100),parseNumber::(${lo24},#\\,##0),parseNumber::(${lo24},0.0000))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hiS",
        "value": "$[if::(ge::(${hi24},100),parseNumber::(${hi24},#\\,##0),parseNumber::(${hi24},0.0000))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "vol",
        "value": "$[parseNumber::(calc::(index::(index::(${r_q},0),5)+index::(index::(${r_q},1),5)+index::(index::(${r_q},2),5)+index::(index::(${r_q},3),5)+index::(index::(${r_q},4),5)+index::(index::(${r_q},5),5)+index::(index::(${r_q},6),5)+index::(index::(${r_q},7),5)+index::(index::(${r_q},8),5)+index::(index::(${r_q},9),5)+index::(index::(${r_q},10),5)+index::(index::(${r_q},11),5)+index::(index::(${r_q},12),5)+index::(index::(${r_q},13),5)+index::(index::(${r_q},14),5)+index::(index::(${r_q},15),5)+index::(index::(${r_q},16),5)+index::(index::(${r_q},17),5)+index::(index::(${r_q},18),5)+index::(index::(${r_q},19),5)+index::(index::(${r_q},20),5)+index::(index::(${r_q},21),5)+index::(index::(${r_q},22),5)+index::(index::(${r_q},23),5)),#\\,##0)]"
      },
      "_note": "24 小时成交量(本窗口逐根之和)。"
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "lead",
          "leadT",
          "chgA",
          "up",
          "flat",
          "pts",
          "lastY",
          "at",
          "sym",
          "pos",
          "railW",
          "loS",
          "hiS",
          "vol"
        ]
      }
    }
  ]
}
