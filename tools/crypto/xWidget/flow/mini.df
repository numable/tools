          },
          "_fb": 1
        }
      ]
    },
    {
      "op": "set",
      "props": {
        "key": "_bfc",
        "value": "1"
      },
      "_fb": 1,
      "_note": "⚠️ 屏障(勿删):op:if 复合节点之后紧邻的节点同样读不到它的结果 ——实测紧跟一个 remove 会让后面的节点全部取空(2026-10-01 CLI)。"
    },
    {
      "op": "remove",
      "props": {
        "key": "r_c"
      },
      "_fb": 1
    },
    {
      "op": "set",
      "props": {
        "key": "c",
        "value": [
          "$[index::(index::(${r_q},24),4)]",
          "$[index::(index::(${r_q},23),4)]",
          "$[index::(index::(${r_q},22),4)]",
          "$[index::(index::(${r_q},21),4)]",
          "$[index::(index::(${r_q},20),4)]",
          "$[index::(index::(${r_q},19),4)]",
          "$[index::(index::(${r_q},18),4)]",
