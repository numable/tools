{
  "version": 1,
  "_note": "迷你一行:价格 + 24h 涨跌 + 24 小时逐小时折线。涨跌基准 = 折线第一根,与画出来的线是同一组数。v11 / vf 只给 1×1 的 mini11(同一份数,零新增请求)。",
  "i18n": {
    "zh-CN": {
      "noData": "取不到行情"
    },
    "en-US": {
      "noData": "Quote unavailable"
    }
  },
  "actions": [
    {
      "op": "set",
      "props": {
        "key": "kr",
        "value": "$[findNotEmpty::(${pair},btcusd)]"
      },
      "_note": "⚠️ 入参先落地:方法参数里看不见 flow 入参(§9.5 #3)。"
    },
    {
      "op": "set",
      "props": {
        "key": "k",
        "value": "$[if::(contains::(${kr},-),toUpperCase::(${kr}),connect::(toUpperCase::(if::(endsWith::(${kr},usdt),subString::(${kr},0,calc::(length::(${kr})-4)),if::(endsWith::(${kr},usdc),subString::(${kr},0,calc::(length::(${kr})-4)),if::(endsWith::(${kr},usd),subString::(${kr},0,calc::(length::(${kr})-3)),${kr})))),-,if::(endsWith::(${kr},usdc),USDC,USDT)))]"
      },
      "_note": "币对归一:老实例是 Bitstamp 形状 `btcusd`,新实例是 OKX instId `BTC-USDT`,两种都认。"
    },
    {
      "op": "set",
      "props": {
        "key": "sym",
        "value": "$[index::(split::(${k},-),0)]"
      }
    },
    {
      "action": "request",
      "id": "r",
      "params": {
        "url": "https://www.okx.com/api/v5/market/candles?instId=${k}&bar=1H&limit=25",
        "method": "GET",
        "formatType": "json"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_b",
        "value": "1"
      },
      "_note": "⚠️ 请求/并发屏障(勿删):request 与 concurrent 之后**紧邻**的节点读不到响应(晚一拍合并,memory [[actionflow-concurrent-late-merge]])。删掉它 → 下面所有 index:: 静默取空 → 卡渲一片 `--`,而流仍报 success。"
    },
    {
      "op": "set",
      "props": {
        "key": "r_bad",
        "value": "$[if::(gt::(length::(${r.data}),0),0,1)]"
      },
      "_fb": 1,
      "_note": "OKX 没取到(被地区政策拦 / 超时 / 空)→ 走备用源 Coinbase(doc/overseas-first.md §10)。"
    },
    {
      "op": "set",
      "props": {
        "key": "r_s0",
        "value": "$[if::(endsWith::(${k},-SWAP),subString::(${k},0,calc::(length::(${k})-5)),${k})]"
      },
      "_fb": 1
    },
    {
      "op": "set",
      "props": {
        "key": "r_p",
        "value": "$[if::(endsWith::(${r_s0},-USDT),connect::(subString::(${r_s0},0,calc::(length::(${r_s0})-5)),-USD),if::(endsWith::(${r_s0},-USDC),connect::(subString::(${r_s0},0,calc::(length::(${r_s0})-5)),-USD),${r_s0}))]"
      },
      "_fb": 1,
      "_note": "备用源 Coinbase 的产品名(doc/overseas-first.md §10)。"
    },
    {
      "op": "set",
      "props": {
        "key": "r_go",
        "value": "${r_bad}"
      },
      "_fb": 1
    },
    {
      "action": "concurrent",
      "items": [
        {
          "op": "if",
          "props": {
            "val": "${r_go}"
          },
          "items": [
            {
              "action": "request",
              "id": "r_c",
              "params": {
                "url": "https://api.exchange.coinbase.com/products/${r_p}/candles?granularity=3600",
                "method": "GET",
                "formatType": "json",
                "timeout": "5000"
              }
            }
          ]
        }
      ],
      "_fb": 1,
      "_note": "备用请求(只在 OKX 没取到时发;每个都在 op:if 里)。"
    },
    {
      "op": "set",
      "props": {
        "key": "_bfb",
        "value": "1"
      },
      "_fb": 1,
      "_note": "⚠️ 请求屏障(勿删):request / concurrent 之后紧邻的节点读不到结果(memory actionflow-concurrent-late-merge)。"
    },
    {
      "op": "set",
      "props": {
        "key": "r_ok",
        "value": "$[if::(eq::(findNotEmpty::(index::(index::(${r_c},0),4),__none__),__none__),0,1)]"
      },
      "_fb": 1
    },
    {
      "op": "set",
      "props": {
        "key": "r_q",
        "value": "${r.data}"
      },
      "_fb": 1,
      "_note": "下游统一读 r_q:OKX 的 data,或下面按 OKX 形状重排的备用数据。"
    },
    {
      "op": "if",
      "props": {
        "val": "${r_ok}"
      },
      "_fb": 1,
      "items": [
        {
          "op": "set",
          "props": {
            "key": "r_q",
            "value": [
              [
                "$[connect::(parseNumber::(calc::(index::(index::(${r_c},0),0)*1000),0),)]",
                "$[connect::(index::(index::(${r_c},0),3),)]",
                "$[connect::(index::(index::(${r_c},0),2),)]",
                "$[connect::(index::(index::(${r_c},0),1),)]",
                "$[connect::(index::(index::(${r_c},0),4),)]",
                "$[connect::(index::(index::(${r_c},0),5),)]"
              ],
              [
                "$[connect::(parseNumber::(calc::(index::(index::(${r_c},1),0)*1000),0),)]",
                "$[connect::(index::(index::(${r_c},1),3),)]",
                "$[connect::(index::(index::(${r_c},1),2),)]",
                "$[connect::(index::(index::(${r_c},1),1),)]",
                "$[connect::(index::(index::(${r_c},1),4),)]",
                "$[connect::(index::(index::(${r_c},1),5),)]"
              ],
              [
                "$[connect::(parseNumber::(calc::(index::(index::(${r_c},2),0)*1000),0),)]",
                "$[connect::(index::(index::(${r_c},2),3),)]",
                "$[connect::(index::(index::(${r_c},2),2),)]",
                "$[connect::(index::(index::(${r_c},2),1),)]",
                "$[connect::(index::(index::(${r_c},2),4),)]",
                "$[connect::(index::(index::(${r_c},2),5),)]"
              ],
              [
                "$[connect::(parseNumber::(calc::(index::(index::(${r_c},3),0)*1000),0),)]",
                "$[connect::(index::(index::(${r_c},3),3),)]",
                "$[connect::(index::(index::(${r_c},3),2),)]",
                "$[connect::(index::(index::(${r_c},3),1),)]",
                "$[connect::(index::(index::(${r_c},3),4),)]",
                "$[connect::(index::(index::(${r_c},3),5),)]"
              ],
              [
                "$[connect::(parseNumber::(calc::(index::(index::(${r_c},4),0)*1000),0),)]",
                "$[connect::(index::(index::(${r_c},4),3),)]",
                "$[connect::(index::(index::(${r_c},4),2),)]",
                "$[connect::(index::(index::(${r_c},4),1),)]",
                "$[connect::(index::(index::(${r_c},4),4),)]",
                "$[connect::(index::(index::(${r_c},4),5),)]"
              ],
              [
                "$[connect::(parseNumber::(calc::(index::(index::(${r_c},5),0)*1000),0),)]",
                "$[connect::(index::(index::(${r_c},5),3),)]",
                "$[connect::(index::(index::(${r_c},5),2),)]",
                "$[connect::(index::(index::(${r_c},5),1),)]",
                "$[connect::(index::(index::(${r_c},5),4),)]",
                "$[connect::(index::(index::(${r_c},5),5),)]"
              ],
              [
                "$[connect::(parseNumber::(calc::(index::(index::(${r_c},6),0)*1000),0),)]",
                "$[connect::(index::(index::(${r_c},6),3),)]",
                "$[connect::(index::(index::(${r_c},6),2),)]",
                "$[connect::(index::(index::(${r_c},6),1),)]",
                "$[connect::(index::(index::(${r_c},6),4),)]",
                "$[connect::(index::(index::(${r_c},6),5),)]"
              ],
