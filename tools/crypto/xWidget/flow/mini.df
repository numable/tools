          "$[index::(index::(${r_q},16),4)]",
          "$[index::(index::(${r_q},15),4)]",
          "$[index::(index::(${r_q},14),4)]",
          "$[index::(index::(${r_q},13),4)]",
          "$[index::(index::(${r_q},12),4)]",
          "$[index::(index::(${r_q},11),4)]",
          "$[index::(index::(${r_q},10),4)]",
          "$[index::(index::(${r_q},9),4)]",
          "$[index::(index::(${r_q},8),4)]",
          "$[index::(index::(${r_q},7),4)]",
          "$[index::(index::(${r_q},6),4)]",
          "$[index::(index::(${r_q},5),4)]",
          "$[index::(index::(${r_q},4),4)]",
          "$[index::(index::(${r_q},3),4)]",
          "$[index::(index::(${r_q},2),4)]",
          "$[index::(index::(${r_q},1),4)]",
          "$[index::(index::(${r_q},0),4)]"
        ]
      }
    },
    {
      "op": "set",
      "props": {
        "key": "last",
        "value": "$[index::(${c},24)]"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "$[if::(gt::(length::(${last}),0),0,1)]"
      },
      "items": [
        {
          "action": "error",
          "params": {
            "errorMsg": "${@i18n.noData}"
          }
        }
      ],
      "_note": "取数失败 → 抛错终止流,平台据此回落上次成功数据(G26/§7.2)"
    },
    {
      "op": "set",
      "props": {
        "key": "first",
        "value": "$[index::(${c},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lo",
        "value": "$[min::(${c})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hi",
        "value": "$[max::(${c})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pc",
        "value": "$[parseNumber::(calc::((${last}-${first})/${first}*100),0.00)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pup",
        "value": "$[if::(gt::(length::(${pc}),0),if::(ge::(${pc},0),1,0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pfl",
        "value": "$[if::(gt::(length::(${pc}),0),if::(lt::(calc::(${pc}*${pc}),0.000025),1,0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pTA",
        "value": "$[if::(gt::(${pc},0),${pc},calc::(0-${pc}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pTF",
        "value": "$[if::(ne::(findNotEmpty::(${pc},__none__),__none__),parseNumber::(${pTA},0.00),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pT",
        "value": "$[if::(ne::(findNotEmpty::(${pc},__none__),__none__),if::(eq::(${pTF},0),connect::(${pTF},%),connect::(if::(gt::(${pc},0),+,−),${pTF},%)),--)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "L_s",
        "value": "$[if::(ge::(${last},1000),parseNumber::(${last},#\\,##0.00),if::(ge::(${last},100),parseNumber::(${last},0.00),if::(ge::(${last},10),parseNumber::(${last},0.000),if::(ge::(${last},1),parseNumber::(${last},0.0000),parseNumber::(${last},0.00000)))))]"
      }
    },
    {
      "op": "set",
