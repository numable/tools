                "$[connect::(index::(index::(${r_c},7),3),)]",
                "$[connect::(index::(index::(${r_c},7),2),)]",
                "$[connect::(index::(index::(${r_c},7),1),)]",
                "$[connect::(index::(index::(${r_c},7),4),)]",
                "$[connect::(index::(index::(${r_c},7),5),)]"
