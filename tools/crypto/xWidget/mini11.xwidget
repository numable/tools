{
  "version": 2,
  "title": "单币",
  "sub": "一格 · 价格与 24 小时涨跌",
  "i18n": {
    "en-US": {
      "title": "Coin",
      "sub": "One tile · price and 24h change"
    }
  },
  "layout": 11,
  "params": {
    "pair": "BTC-USDT",
    "name": "BTC"
  },
  "ai": {
    "shows": "一格:一个币的币名、现价与 24h 涨跌幅",
    "params": {
      "pair": {
        "kind": "value",
        "group": [
          "pair",
          "name"
        ],
        "format": "OKX 交易对:币种-USDT(现货);只有永续合约的币写 币种-USDT-SWAP",
        "hint": "name 填 pair 的币种部分(BTC-USDT → BTC)",
        "examples": [
          "BTC-USDT",
          "ETH-USDT",
          "SOL-USDT",
          "DOGE-USDT"
        ]
      },
      "name": {
        "kind": "value",
        "format": "币种代码 = pair 第一段,如 BTC"
      }
    }
  },
  "events": {
    "onClick": "/coin?pair=${pair}&name=${name}",
    "onEdit": "/pick?pair=${pair}&name=${name}"
  },
  "jobs": [
    {
      "id": "price",
      "params": {
        "pair": "${pair}"
      }
    },
    {
      "id": "move",
      "params": {
        "pair": "${pair}"
      }
    }
  ],
  "canvas": {
    "source": "@[file://rc/mini11.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/mini.df]",
        "params": {
          "pair": "${pair}",
          "name": "${name}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3"
      ]
    }
  }
}
