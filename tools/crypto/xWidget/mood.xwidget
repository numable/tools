{
  "version": 2,
  "title": "市场情绪",
  "sub": "恐惧贪婪 · BTC 占比 · 总市值",
  "i18n": {
    "en-US": {
      "title": "Market mood",
      "sub": "Fear & Greed, BTC dominance, market cap"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "加密市场情绪:恐惧贪婪指数及昨日读数、BTC 市值占比、总市值与 24h 变化"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/mood.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/mood.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "1800"
      ]
    }
  }
}
