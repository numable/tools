{
  "_note": "动态 banner(方案 A 多条走势)。生成器 tools/banner/gen_dyn_banners.py;规则见 Numable/doc/dynamic-banner-ui.html。取不到数时整张退回静态图(静态 cell 挂 hide=okN>0)。",
  "version": 2,
  "id": "banner",
  "ratio": "16:9",
  "theme": "auto",
  "scene": {
    "width": 338,
    "height": 190,
    "corner": 18
  },
  "params": {
    "p1": "BTC-USDT",
    "n1": "BTC",
    "p2": "ETH-USDT",
    "n2": "ETH",
    "p3": "SOL-USDT",
    "n3": "SOL",
    "p4": "XRP-USDT",
    "n4": "XRP",
    "p5": "DOGE-USDT",
    "n5": "DOGE"
  },
  "canvas": {
    "source": "@[file://xWidget/rc/banner.rcn]",
    "depends": [
      {
        "flow": "@[file://xWidget/flow/top.df]",
        "params": {
          "p1": "${p1}",
          "n1": "${n1}",
          "p2": "${p2}",
          "n2": "${n2}",
          "p3": "${p3}",
          "n3": "${n3}",
          "p4": "${p4}",
          "n4": "${n4}",
          "p5": "${p5}",
          "n5": "${n5}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "60"
      ]
    }
  }
}
