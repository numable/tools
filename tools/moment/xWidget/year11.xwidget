{
  "_note": "今年进度(11 · 微档,card-design-system §8.2):年份 / 百分比 / 还剩几天。rc 由 tools/infosource/gen_moment.py 生成;数据 = progress.df(与 year / progress 同一条,零新增)。",
  "version": 2,
  "title": "今年进度",
  "sub": "一格 · 百分比与还剩几天",
  "i18n": {
    "en-US": {
      "title": "Year progress",
      "sub": "Tiny · percent and days left"
    }
  },
  "layout": 11,
  "params": {},
  "ai": {
    "shows": "今年已过的百分比与还剩几天（一格小组件）"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/year11.rcn]",
    "depends": [
      "@[file://flow/progress.df]"
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  }
}
