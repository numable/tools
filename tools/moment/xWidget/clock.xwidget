{
  "_note": "世界时钟 22(单城市)。零网络,数据 clock.df。onEdit → /clock 选城市页(带当前城市)。",
  "version": 2,
  "title": "世界时钟",
  "sub": "一个城市的当地时间、与本地相差",
  "i18n": {
    "en-US": {
      "title": "World clock",
      "sub": "Local time in one city and how far ahead or behind"
    }
  },
  "layout": 22,
  "params": {
    "c1": ""
  },
  "ai": {
    "shows": "一个城市此刻的当地时间、日期星期、白天还是夜晚，以及与本地相差几小时、所在时区（含夏令时）",
    "params": {
      "c1": {
        "kind": "auto",
        "hint": "城市 id(小写英文,见下),留空 = 按用户地区给缺省(国内默认:纽约 / 伦敦 / 东京 / 悉尼)。可选 id:utc beijing hongkong taipei singapore kualalumpur manila perth tokyo seoul bangkok hochiminh jakarta yangon dhaka kathmandu delhi mumbai karachi tashkent dubai tehran riyadh istanbul moscow nairobi cairo johannesburg athens helsinki kyiv lagos paris berlin madrid rome amsterdam zurich stockholm warsaw london dublin lisbon reykjavik saopaulo buenosaires stjohns halifax newyork toronto chicago mexicocity denver phoenix losangeles sanfrancisco seattle vancouver anchorage honolulu brisbane sydney melbourne adelaide darwin auckland",
        "examples": [
          "tokyo",
          "london",
          "newyork"
        ]
      }
    }
  },
  "events": {
    "onClick": "numable://self",
    "onEdit": "/clock?n=1&c1=${c1}"
  },
  "canvas": {
    "source": "@[file://rc/clock.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/clock.df]",
        "params": {
          "c1": "${c1}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "60"
      ]
    },
    "_noteRefresh": "60 秒 = 分钟级时钟的本意。免费档会被平台钳到 5 分钟、iOS 桌面小组件约 15 分钟一画 —— 卡上的分钟数因此可能落后几分钟;42 卡右上角的「本地 HH:mm」就是为了让这个落后看得见。见 doc/moment-worldclock.md §5。"
  }
}
