{
  "_note": "下一个假期(42,v36 新增)。零网络。生成器 gen_moment_holiday.py。",
  "version": 2,
  "title": "下一个假期",
  "sub": "距下个节日几天 · 其后三个",
  "i18n": {
    "en-US": {
      "title": "Next holiday",
      "sub": "Days to the next public holiday and the three after"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "下一个节假日还有几天，以及其后三个节日（国内看中国节日，海外看美国节日）"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/holiday.rcn]",
    "depends": [
      "@[file://flow/holiday.df]"
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  }
}
