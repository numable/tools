{
  "_note": "倒数日(21 · 迷你档,§8.1):params / onClick / onEdit / depends 照抄 countdown.xwidget(title 与 date 两个键都要显式传)。rc 由 gen_moment.py 生成。",
  "version": 2,
  "title": "倒数日",
  "sub": "迷你 · 还有几天",
  "i18n": {
    "en-US": {
      "title": "Countdown",
      "sub": "Mini · days to go"
    }
  },
  "layout": 21,
  "params": {
    "title": "",
    "date": ""
  },
  "ai": {
    "shows": "距一个目标日期还剩（或已过）几天与目标日期（一行迷你）",
    "params": {
      "title": {
        "kind": "auto",
        "hint": "卡上显示的名字（≤ 12 字），与 date 配套，如「春节」「生日」；留空显示「倒数日」（date 也空时显示「元旦」）",
        "examples": [
          "春节",
          "圣诞节",
          "高考"
        ]
      },
      "date": {
        "kind": "auto",
        "format": "公历目标日 YYYY-MM-DD（农历节日先换算成当年公历；已过的日子显示已过几天）。用户的私人日子不知道日期就留空，装上后用户自己填；留空 = 倒数到下一个元旦",
        "examples": [
          "2027-02-06",
          "2026-12-25"
        ]
      }
    }
  },
  "events": {
    "onClick": "numable://self",
    "onEdit": "/count?title=${title}&date=${date}"
  },
  "canvas": {
    "source": "@[file://rc/countdown21.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/countdown.df]",
        "params": {
          "date": "${date}",
          "title": "${title}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  }
}
