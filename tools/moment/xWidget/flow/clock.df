        "val": "$[if::(startsWith::(${@app.language},zh),0,1)]"
      },
      "items": [
        {
          "op": "set",
          "props": {
            "key": "rl2",
            "value": "$[if::(eq::(${dd2},1),Tomorrow,if::(eq::(${dd2},-1),Yesterday,Today))]"
          }
        }
      ]
    },
    {
      "op": "set",
      "props": {
        "key": "_3ck",
        "value": "k${c4}"
      },
      "_note": "查表键加前缀 k:空 id 时 get::(表,'') 会把整张表当结果返回,加前缀后落空。"
    },
    {
      "op": "set",
      "props": {
        "key": "_3dk",
        "value": "$[calc::(${grp}*4+3)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3i",
        "value": "$[findNotEmpty::(get::(${CI},${_3ck}),index::(${DEF},${_3dk}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3sb",
        "value": "$[index::(${STDB},${_3i})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3r",
        "value": "$[index::(${RULE},${_3i})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3lc",
        "value": "$[index::(${LOC},${_3r})]"
