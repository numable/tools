          "kUS": 1,
          "kVN": 5
        }
      }
    },
    {
      "op": "set",
      "props": {
        "key": "grp",
        "value": "$[if::(eq::(${cnd},1),0,findNotEmpty::(get::(${CG},${_cc}),0))]"
      },
      "_note": "国内默认 → 组 0;否则按系统地区分组(没登记的国家也是组 0)。"
    },
