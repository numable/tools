      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3s",
        "value": "$[calc::(${_3sT}+720*${_3lc}-${_3sb}*${_3lc})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3e",
        "value": "$[calc::(${_3eT}+720*${_3lc}-${_3sb}*${_3lc})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3on",
        "value": "$[if::(eq::(${_3r},0),0,if::(eq::(${_3so},1),if::(or::(ge::(${u},${_3s}),lt::(${u},${_3e})),1,0),if::(and::(ge::(${u},${_3s}),lt::(${u},${_3e})),1,0)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3cu",
        "value": "$[index::(${CUT},${_3i})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3ca",
        "value": "$[index::(${CUTB},${_3i})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3ob0",
        "value": "$[calc::(${_3sb}+60*${_3on})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3ob",
        "value": "$[if::(ge::(${u},${_3cu}),${_3ca},${_3ob0})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3ds",
        "value": "$[if::(ge::(${u},${_3cu}),0,${_3on})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3tw",
        "value": "$[calc::(${u}+${_3ob}-720)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3td",
        "value": "$[floor::(calc::(${_3tw}/1440))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3tm",
        "value": "$[calc::(${_3tw}-${_3td}*1440)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3th",
        "value": "$[floor::(calc::(${_3tm}/60))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_3tn",
        "value": "$[calc::(${_3tm}-${_3th}*60)]"
