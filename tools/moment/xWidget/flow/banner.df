{"version":1,"_note":"信息源页海报专用(tools/banner/dyn_daily.py),组件不用。","actions":[{"op":"set","props":{"key":"now","value":"${@time.nowMs}"}},{"op":"set","props":{"key":"y","value":"$[formatDate::(${now},yyyy)]"}},{"op":"set","props":{"key":"m","value":"$[formatDate::(${now},MM)]"}},{"op":"set","props":{"key":"dd","value":"$[formatDate::(${now},dd)]"}},{"op":"set","props":{"key":"dS","value":"$[parseDate::(formatDate::(${now},yyyy-MM-dd),yyyy-MM-dd)]"},"_note":"今天 0 点(本机时区)。"},{"op":"set","props":{"key":"yS","value":"$[parseDate::(connect::(${y},-01-01),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"yE","value":"$[parseDate::(connect::(calc::(${y}+1),-01-01),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"yP","value":"$[parseNumber::(calc::((${now}-${yS})/(${yE}-${yS})*100),0.0)]"},"_note":"今年已过,一位小数。"},{"op":"set","props":{"key":"tP","value":"$[min::(100,round::(calc::((${now}-${dS})/86400000*100)))]"}},{"op":"set","props":{"key":"_ref","value":"$[parseDate::(2024-01-01,yyyy-MM-dd)]"}},{"op":"set","props":{"key":"_dn","value":"$[round::(calc::((${dS}-${_ref})/86400000))]"},"_note":"round:夏令时那天差出的 ±1 小时不影响天数。"},{"op":"set","props":{"key":"_fw","value":"$[findNotEmpty::(${@app.firstWeekday},1)]"}},{"op":"set","props":{"key":"_wo","value":"$[calc::((${_dn}%7-(${_fw}-1)+14)%7)]"},"_note":"今天是本周第几天(0 基)。"},{"op":"set","props":{"key":"wP","value":"$[min::(100,round::(calc::((${_wo}*86400000+${now}-${dS})/604800000*100)))]"}},{"op":"set","props":{"key":"mS","value":"$[parseDate::(connect::(${y},-,${m},-01),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"nm","value":"$[if::(ge::(${m},12),01,if::(lt::(${m},9),connect::(0,calc::(${m}+1)),calc::(${m}+1)))]"}},{"op":"set","props":{"key":"ny","value":"$[if::(ge::(${m},12),calc::(${y}+1),${y})]"}},{"op":"set","props":{"key":"mE","value":"$[parseDate::(connect::(${ny},-,${nm},-01),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"mP","value":"$[round::(calc::((${now}-${mS})/(${mE}-${mS})*100))]"}},{"op":"set","props":{"key":"m1","value":"$[calc::(${m}-1)]"}},{"op":"set","props":{"key":"qi","value":"$[round::(calc::((${m1}-${m1}%3)/3+1))]"}},{"op":"set","props":{"key":"qsm","value":"$[calc::((${qi}-1)*3+1)]"}},{"op":"set","props":{"key":"qs","value":"$[if::(lt::(${qsm},10),connect::(0,${qsm}),${qsm})]"}},{"op":"set","props":{"key":"qem","value":"$[calc::(${qi}*3+1)]"}},{"op":"set","props":{"key":"qeY","value":"$[if::(gt::(${qem},12),calc::(${y}+1),${y})]"}},{"op":"set","props":{"key":"qe","value":"$[if::(gt::(${qem},12),01,if::(lt::(${qem},10),connect::(0,${qem}),${qem}))]"}},{"op":"set","props":{"key":"qS","value":"$[parseDate::(connect::(${y},-,${qs},-01),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"qE","value":"$[parseDate::(connect::(${qeY},-,${qe},-01),yyyy-MM-dd)]"}},{"op":"set","props":{"key":"qP","value":"$[round::(calc::((${now}-${qS})/(${qE}-${qS})*100))]"}},{"op":"set","props":{"key":"_mo","value":"Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec"}},{"op":"set","props":{"key":"mN","value":"$[parseNumber::(${m},0)]"}},{"op":"set","props":{"key":"dN","value":"$[parseNumber::(${dd},0)]"}},{"op":"set","props":{"key":"hm","value":"$[formatDate::(${now},HH:mm)]"}},{"op":"set","props":{"key":"_mdZ","value":"${mN}月${dN}日"}},{"op":"set","props":{"key":"_mdE","value":"$[index::(split::(${_mo},;),${m1})] ${dN}"},"_note":"空格放在方法外面:方法参数首尾的空格(含 NBSP)会被吃掉。"},{"op":"set","props":{"key":"md","value":"$[if::(startsWith::(${@app.language},zh),${_mdZ},${_mdE})]"}},{"op":"set","props":{"key":"at","value":"${md} ${hm}"}},{"op":"set","props":{"key":"_yb","value":"$[calc::(28.0+max::(0,min::(100,${yP}))*2.82)]"}},{"op":"set","props":{"key":"yb","value":"$[connect::(28.0\\,146\\,,parseNumber::(${_yb},0.0),\\,146)]"}},{"op":"set","props":{"key":"_b0","value":"$[calc::(227.0+max::(0,min::(100,${tP}))*0.5)]"}},{"op":"set","props":{"key":"b0","value":"$[connect::(227.0\\,70\\,,parseNumber::(${_b0},0.0),\\,70)]"}},{"op":"set","props":{"key":"_b1","value":"$[calc::(227.0+max::(0,min::(100,${wP}))*0.5)]"}},{"op":"set","props":{"key":"b1","value":"$[connect::(227.0\\,86\\,,parseNumber::(${_b1},0.0),\\,86)]"}},{"op":"set","props":{"key":"_b2","value":"$[calc::(227.0+max::(0,min::(100,${mP}))*0.5)]"}},{"op":"set","props":{"key":"b2","value":"$[connect::(227.0\\,102\\,,parseNumber::(${_b2},0.0),\\,102)]"}},{"op":"set","props":{"key":"_b3","value":"$[calc::(227.0+max::(0,min::(100,${qP}))*0.5)]"}},{"op":"set","props":{"key":"b3","value":"$[connect::(227.0\\,118\\,,parseNumber::(${_b3},0.0),\\,118)]"}},{"op":"set","props":{"key":"ok","value":"$[if::(gt::(${yE},${yS}),1,0)]"}},{"action":"resultFilter","params":{"keys":["ok","y","at","yP","tP","wP","mP","qP","yb","b0","b1","b2","b3"]}}]}
