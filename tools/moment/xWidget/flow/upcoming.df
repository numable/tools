{
  "version": 1,
  "actions": [
    {
      "id": "dl",
      "action": "data.get",
      "params": {
        "key": "days",
        "default": []
      },
      "_note": "与 page/flow/read.df 同一个键。⚠️ 这条流一加,`page/flow/save.af` 就**必须**补 `widget.refresh`(scope=widget/progress)—— 否则改完清单,盘上那张 44 卡要等到下一个 interval(1 小时)才看得到,而日志全绿。"
    },
    {
      "op": "set",
      "props": {
        "key": "L",
        "value": "${dl}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "nowMs",
        "value": "${@time.nowMs}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "todayMs",
        "value": "$[parseDate::(formatDate::(${nowMs},yyyy-MM-dd),yyyy-MM-dd)]"
      },
      "_note": "按自然日归零再相减(同 countdown.df):否则同一天的上午/下午差出一天。"
    },
    {
      "op": "set",
      "props": {
        "key": "k1",
        "value": "999999"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "n1",
        "value": ""
      }
    },
    {
      "op": "set",
      "props": {
        "key": "i1",
        "value": ""
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k2",
        "value": "999999"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "n2",
        "value": ""
      }
    },
    {
      "op": "set",
      "props": {
        "key": "i2",
        "value": ""
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k3",
        "value": "999999"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "n3",
        "value": ""
      }
    },
    {
      "op": "set",
      "props": {
        "key": "i3",
        "value": ""
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pS",
        "value": "$[parseDate::(${L[0].date},yyyy-MM-dd)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "rS",
        "value": "$[round::(calc::((${pS}-${todayMs})/86400000),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cS",
        "value": "$[if::(gt::(length::(${L[0].date}),0),if::(ge::(${rS},0),${rS},999999),999999)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "b1",
        "value": "$[if::(lt::(${cS},${k1}),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "b2",
        "value": "$[if::(lt::(${cS},${k2}),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "b3",
        "value": "$[if::(lt::(${cS},${k3}),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "n3",
        "value": "$[if::(eq::(${b2},1),${n2},if::(eq::(${b3},1),findNotEmpty::(${L[0].title},--),${n3}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "i3",
        "value": "$[if::(eq::(${b2},1),${i2},if::(eq::(${b3},1),${L[0].id},${i3}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "k3",
        "value": "$[if::(eq::(${b2},1),${k2},if::(eq::(${b3},1),${cS},${k3}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "n2",
        "value": "$[if::(eq::(${b1},1),${n1},if::(eq::(${b2},1),findNotEmpty::(${L[0].title},--),${n2}))]"
