{
  "_note": "本月进度(21 · 迷你档,card-design-system §8.1,2026-10-08 新增):百分比 + 还剩几天 + 31 格细条。rc 由 tools/infosource/gen_moment.py 生成;数据 = progress.df(与 year / progress 同一条,零新增)。",
  "version": 2,
  "title": "本月进度",
  "sub": "迷你 · 本月过了多少、还剩几天",
  "i18n": {
    "en-US": {
      "title": "Month progress",
      "sub": "Mini · how much of this month has passed"
    }
  },
  "layout": 21,
  "params": {},
  "ai": {
    "shows": "本月已过的百分比与还剩几天，附一天一格的本月进度条（一行迷你）"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/month21.rcn]",
    "depends": [
      "@[file://flow/progress.df]"
    ],
    "refresh": {
      "interval": [
        "3600"
      ]
    }
  }
}
