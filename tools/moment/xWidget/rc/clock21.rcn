{
  "_note": "世界时钟 21(两城市)。生成器 gen_moment_clock.py;数据 clock.df。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FBFBFE\\,#F5F5FC)@90|linear(#15171A\\,#181A1F\\,#1D1F28)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{hd.y}+({hd.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#5B5BD6|#A5A3FF"
      },
      {
        "id": "hd",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "90pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "${@i18n.ttl}",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "nm0",
        "type": "txt",
        "x": "10pt",
        "y": "25pt",
        "w": "52pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${s0},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "ic0a",
        "type": "layer",
        "x": "66pt",
        "y": "{nm0.y}+({nm0.h}-7pt)/2",
        "w": "7pt",
        "h": "7pt",
        "cornerRadius": {
          "leftT": "3.5pt",
          "leftB": "3.5pt",
          "rightT": "3.5pt",
          "rightB": "3.5pt"
        },
        "bgColor": "$[if::(eq::(findNotEmpty::(${ng0},0),1),#7C7FD9|#A5A3FF,#F59E0B|#F2B655)]",
        "hide": "$[if::(eq::(findNotEmpty::(${ng0},__none__),__none__),1,0)]",
        "_note": "没数据不画(空态里一颗琥珀圆点会被读成「白天」)。"
      },
      {
        "id": "ic0b",
        "type": "layer",
        "x": "{ic0a.x}+2.7pt",
        "y": "{ic0a.y}-1.3pt",
        "w": "5.6pt",
        "h": "5.6pt",
        "cornerRadius": {
          "leftT": "2.8pt",
          "leftB": "2.8pt",
          "rightT": "2.8pt",
          "rightB": "2.8pt"
        },
        "bgColor": "#FFFFFF|#15171A",
        "hide": "$[if::(eq::(findNotEmpty::(${ng0},__none__),1),0,1)]"
      },
      {
        "id": "tm0",
        "type": "richText",
        "x": "10pt",
        "y": "36pt",
        "w": "64pt",
        "h": "-1",
        "maxLines": "1",
        "spans": [
          {
            "text": "$[findNotEmpty::(${t0},--:--)]",
            "fontSize": "17pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "text": "$[if::(eq::(findNotEmpty::(${dd0},0),1), +1,if::(eq::(findNotEmpty::(${dd0},0),-1), −1,))]",
            "fontSize": "9pt",
            "typeface": "System-Bold",
            "textColor": "#5B5BD6|#A5A3FF"
          }
        ],
        "_note": "「+1 / −1」= 当地已是明天 / 还是昨天(世界时钟通行写法);同一天不写。"
      },
      {
        "id": "nm1",
        "type": "txt",
        "x": "84pt",
        "y": "25pt",
        "w": "52pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${s1},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "ic1a",
        "type": "layer",
        "x": "140pt",
        "y": "{nm1.y}+({nm1.h}-7pt)/2",
        "w": "7pt",
        "h": "7pt",
        "cornerRadius": {
          "leftT": "3.5pt",
          "leftB": "3.5pt",
          "rightT": "3.5pt",
          "rightB": "3.5pt"
        },
        "bgColor": "$[if::(eq::(findNotEmpty::(${ng1},0),1),#7C7FD9|#A5A3FF,#F59E0B|#F2B655)]",
        "hide": "$[if::(eq::(findNotEmpty::(${ng1},__none__),__none__),1,0)]"
      },
      {
        "id": "ic1b",
        "type": "layer",
        "x": "{ic1a.x}+2.7pt",
        "y": "{ic1a.y}-1.3pt",
        "w": "5.6pt",
        "h": "5.6pt",
        "cornerRadius": {
          "leftT": "2.8pt",
          "leftB": "2.8pt",
          "rightT": "2.8pt",
          "rightB": "2.8pt"
        },
        "bgColor": "#FFFFFF|#15171A",
        "hide": "$[if::(eq::(findNotEmpty::(${ng1},__none__),1),0,1)]"
      },
      {
        "id": "tm1",
        "type": "richText",
        "x": "84pt",
        "y": "36pt",
        "w": "64pt",
        "h": "-1",
        "maxLines": "1",
        "spans": [
          {
            "text": "$[findNotEmpty::(${t1},--:--)]",
            "fontSize": "17pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "text": "$[if::(eq::(findNotEmpty::(${dd1},0),1), +1,if::(eq::(findNotEmpty::(${dd1},0),-1), −1,))]",
            "fontSize": "9pt",
            "typeface": "System-Bold",
            "textColor": "#5B5BD6|#A5A3FF"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "ttl": "世界时钟"
      },
      "en-US": {
        "ttl": "World clock"
      }
    }
  }
}
