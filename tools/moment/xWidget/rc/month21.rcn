{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FBFBFE\\,#F5F5FC)@90|linear(#15171A\\,#181A1F\\,#1D1F28)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{hd.y}+({hd.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#5B5BD6|#A5A3FF",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "hd",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "90pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "${@i18n.mo21}",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "113pt",
        "y": "10.5pt",
        "w": "35pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${today},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mPct},--),--),0,1)]"
        },
        "react": [
          {
            "id": "pct",
            "type": "richText",
            "x": "10pt",
            "y": "23pt",
            "w": "70pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "$[findNotEmpty::(${mPct},--)]",
                "fontSize": "17pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "%",
                "fontSize": "10pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${mPct},--),--),1,0)]"
        },
        "react": [
          {
            "id": "pctE",
            "type": "richText",
            "x": "10pt",
            "y": "28pt",
            "w": "70pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "--",
                "fontSize": "17pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "%",
                "fontSize": "10pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),1,0)]"
        },
        "react": [
          {
            "id": "lf",
            "type": "txt",
            "x": "80pt",
            "y": "28pt",
            "w": "68pt",
            "h": "-1",
            "alignmentH": "2",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${@i18n.left} $[findNotEmpty::(${mLeft},--)]$[if::(eq::(${mLeft},1),${@i18n.day1},${@i18n.day})]",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "_note": "中英同一语序:「还剩 23 天」/「left 23 days」读不顺,英文改走 lfE 分支"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),0,1)]"
        },
        "react": [
          {
            "id": "lfE",
            "type": "txt",
            "x": "80pt",
            "y": "28pt",
            "w": "68pt",
            "h": "-1",
            "alignmentH": "2",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[findNotEmpty::(${mLeft},--)]$[if::(eq::(${mLeft},1),${@i18n.day1},${@i18n.day})] ${@i18n.left}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
