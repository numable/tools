                "y": "{r0.y}+({r0.h}-{tm0.h})/2",
                "w": "72pt",
                "h": "-1",
                "maxLines": "1",
                "alignmentH": "2",
                "text": "$[findNotEmpty::(${t0},--:--)]",
                "fontSize": "${fT}pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
