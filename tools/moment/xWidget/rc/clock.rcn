{
  "_note": "世界时钟 22(单城市)。生成器 gen_moment_clock.py;数据 clock.df。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FBFBFE\\,#F5F5FC)@90|linear(#15171A\\,#181A1F\\,#1D1F28)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12.0pt",
        "y": "{hd.y}+({hd.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#5B5BD6|#A5A3FF"
      },
      {
        "id": "hd",
        "type": "txt",
        "x": "21.0pt",
        "y": "11pt",
        "w": "{parent.w}-49pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${n0},${@i18n.ttl})]",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "_note": "组件名位 = 城市名(同 year11 用年份作名)。空态回落「世界时钟」。"
      },
      {
        "id": "ica",
        "type": "layer",
        "x": "{parent.w}-23pt",
        "y": "{hd.y}+({hd.h}-11pt)/2",
        "w": "11pt",
        "h": "11pt",
        "cornerRadius": {
          "leftT": "5.5pt",
          "leftB": "5.5pt",
          "rightT": "5.5pt",
          "rightB": "5.5pt"
        },
        "bgColor": "$[if::(eq::(findNotEmpty::(${ng0},0),1),#7C7FD9|#A5A3FF,#F59E0B|#F2B655)]",
        "hide": "$[if::(eq::(findNotEmpty::(${ng0},__none__),__none__),1,0)]",
        "_note": "没数据不画(空态里一颗琥珀圆点会被读成「白天」)。"
      },
      {
        "id": "icb",
        "type": "layer",
        "x": "{ica.x}+4.2pt",
        "y": "{ica.y}-2.0pt",
        "w": "8.8pt",
        "h": "8.8pt",
        "cornerRadius": {
          "leftT": "4.4pt",
          "leftB": "4.4pt",
          "rightT": "4.4pt",
          "rightB": "4.4pt"
        },
        "bgColor": "#FFFFFF|#15171A",
        "hide": "$[if::(eq::(findNotEmpty::(${ng0},__none__),1),0,1)]"
      },
      {
        "id": "tm",
        "type": "txt",
        "x": "12.0pt",
        "y": "30pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${t0},--:--)]",
        "fontSize": "42pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "dt",
        "type": "txt",
        "x": "12.0pt",
        "y": "82pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(findNotEmpty::(${dt0},__none__),__none__),--,${rl0} · ${dt0})]",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "tl",
        "type": "layer",
        "x": "12.0pt",
        "y": "104pt",
        "w": "134pt",
        "h": "42pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "10pt",
          "leftB": "10pt",
          "rightT": "10pt",
          "rightB": "10pt"
        }
      },
      {
        "id": "k1",
        "type": "txt",
        "x": "22.0pt",
        "y": "109pt",
        "w": "40pt",
        "h": "-1",
        "maxLines": "1",
        "text": "${@i18n.vsL}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "v1",
        "type": "txt",
        "x": "56.0pt",
        "y": "108pt",
        "w": "80pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "text": "$[findNotEmpty::(${df0},--)]",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "k2",
        "type": "txt",
        "x": "22.0pt",
        "y": "128pt",
        "w": "60pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[if::(eq::(findNotEmpty::(${ds0},0),1),${@i18n.dst},${@i18n.zone})]",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "v2",
        "type": "txt",
        "x": "76.0pt",
        "y": "127pt",
        "w": "60pt",
        "h": "-1",
        "maxLines": "1",
        "alignmentH": "2",
        "text": "$[findNotEmpty::(${ut0},--)]",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      }
    ],
    "i18n": {
      "zh-CN": {
        "ttl": "世界时钟",
        "vsL": "与本地",
        "zone": "时区",
        "dst": "时区 · 夏令时"
      },
      "en-US": {
        "ttl": "World clock",
        "vsL": "Vs local",
        "zone": "Zone",
        "dst": "Zone · DST"
      }
    }
  }
}
