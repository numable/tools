{
  "_note": "世界时钟 11(单城市微档)。生成器 gen_moment_clock.py;数据 clock.df。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FBFBFE\\,#F5F5FC)@90|linear(#15171A\\,#181A1F\\,#1D1F28)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8pt",
        "y": "{hd.y}+({hd.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#5B5BD6|#A5A3FF"
      },
      {
        "id": "hd",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${s0},${@i18n.ttl11})]",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "tm",
        "type": "txt",
        "x": "8pt",
        "y": "21pt",
        "w": "56pt",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${t0},--:--)]",
        "fontSize": "18pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "sb",
        "type": "txt",
        "x": "8pt",
        "y": "44pt",
        "w": "54pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(findNotEmpty::(${dd0},0),0),findNotEmpty::(${df0},--),${rl0})]",
        "fontSize": "9pt",
        "textColor": "$[if::(eq::(findNotEmpty::(${dd0},0),0),#6B7280|#8E939B,#5B5BD6|#A5A3FF)]",
        "_note": "跨天时这一行说「明天 / 昨天」(用源色,这是这张卡最容易看错的事),同一天才说相差几小时。"
      }
    ],
    "i18n": {
      "zh-CN": {
        "ttl11": "时钟"
      },
      "en-US": {
        "ttl11": "Clock"
      }
    }
  }
}
