{
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FBFBFE\\,#F5F5FC)@90|linear(#15171A\\,#181A1F\\,#1D1F28)@90"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#5B5BD6|#A5A3FF",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "90pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(findNotEmpty::(${ttl},__n__),__n__),if::(eq::(${isDef},1),${@i18n.nyd},${@i18n.cdT}),${ttl})]",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "113pt",
        "y": "10.5pt",
        "w": "35pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${today},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${abs},--),--),0,1)]"
        },
        "react": [
          {
            "id": "num",
            "type": "richText",
            "x": "10pt",
            "y": "24pt",
            "w": "74pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "$[findNotEmpty::(${abs},--)]",
                "fontSize": "${vf21}pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "$[if::(eq::(${abs},1),${@i18n.day1},${@i18n.day})]",
                "fontSize": "10pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${abs},--),--),1,0)]"
        },
        "react": [
          {
            "id": "numE",
            "type": "richText",
            "x": "10pt",
            "y": "30pt",
            "w": "74pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "--",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "$[if::(eq::(${abs},1),${@i18n.day1},${@i18n.day})]",
                "fontSize": "10pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "id": "lead",
        "type": "txt",
        "x": "84pt",
        "y": "25pt",
        "w": "64pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(${past},1),${@i18n.cdLeadP},${@i18n.cdLead})]",
        "fontSize": "9pt",
        "textColor": "#5B5BD6|#A5A3FF",
        "hide": "$[if::(eq::(findNotEmpty::(${abs},__none__),__none__),1,0)]",
        "_note": "空态不写「还剩」(没有天数时这两个字是在说一个不存在的数)"
      },
      {
        "id": "date",
        "type": "txt",
        "x": "84pt",
        "y": "37pt",
        "w": "64pt",
        "h": "-1",
        "alignmentH": "2",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${dateC},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      }
    ],
    "i18n": {
      "zh-CN": {
        "day": " 天",
        "day1": " 天",
        "nyd": "元旦",
        "cdT": "倒数日",
        "cdLead": "还剩",
        "cdLeadP": "已过"
      },
      "en-US": {
        "day": " days",
        "day1": " day",
        "nyd": "New Year",
        "cdT": "Countdown",
        "cdLead": "until",
        "cdLeadP": "since"
      }
    }
  }
}
