{
  "_note_gen": "tools/infosource/calendar/gen.py",
  "_note": "动态提醒:当天是节气(jqT 非空)才响。零网络。正文 jqB = 本机时区的交节时刻 + 三候(day.df 换算,doc/overseas-first.md §8:写本地时间不写北京时间)。",
  "version": 1,
  "id": "term",
  "title": "节气提醒",
  "sub": "交节那天早上 8 点提醒",
  "i18n": {
    "en-US": {
      "title": "Solar term reminder",
      "sub": "Once on the day a new solar term begins",
      "message": {
        "title": "Today: ${jqT}",
        "body": "${jqB}"
      }
    }
  },
  "events": {
    "onClick": "/terms"
  },
  "task": {
    "depends": [
      {
        "flow": "@[file://xWidget/flow/day.df]",
        "params": {}
      }
    ],
    "refresh": {
      "at": [
        "08:00"
      ]
    }
  },
  "alert": {
    "level": "normal",
    "activeCondition": "$[if::(eq::(findNotEmpty::(${jqT},__none__),__none__),0,1)]",
    "message": {
      "title": "今天${jqT}",
      "body": "${jqB}"
    }
  }
}
