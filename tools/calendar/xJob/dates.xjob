{
  "_note_gen": "tools/infosource/calendar/gen.py",
  "_note": "动态提醒:某条农历日子距今天数 = 它的提前量(0 = 当天)才响;多条同日只报第一条。零网络。",
  "version": 1,
  "id": "dates",
  "title": "农历日子提醒",
  "sub": "早上 9 点，按每条设置的提前天数提醒",
  "i18n": {
    "en-US": {
      "title": "Lunar date reminder",
      "sub": "Reminds you ahead of each lunar date",
      "message": {
        "title": "${hitT}",
        "body": "${hitB}"
      }
    }
  },
  "events": {
    "onClick": "/dates"
  },
  "task": {
    "depends": [
      {
        "flow": "@[file://xWidget/flow/dates.df]",
        "params": {}
      }
    ],
    "refresh": {
      "at": [
        "09:00"
      ]
    }
  },
  "alert": {
    "level": "normal",
    "activeCondition": "$[eq::(findNotEmpty::(${hitK},0),1)]",
    "message": {
      "title": "${hitT}",
      "body": "${hitB}"
    }
  }
}
