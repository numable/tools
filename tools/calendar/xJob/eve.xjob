{
  "_note_gen": "tools/infosource/calendar/gen.py",
  "_note": "动态提醒:每天到点跑 day.df,明天是调休上班日(eveK=1)或放假首日(eveK=2)才响。零网络。放假表外的日期 eveK 恒 0,永不触发(设计 §4.6)。",
  "version": 1,
  "id": "eve",
  "title": "调休与放假提醒",
  "sub": "每晚 8 点看一眼：明天要调休上班，或明天开始放假",
  "i18n": {
    "en-US": {
      "title": "China make-up workday & holiday reminder",
      "sub": "The evening before a China make-up workday or public holiday",
      "message": {
        "title": "${eveT}",
        "body": "${eveB}"
      }
    }
  },
  "events": {
    "onClick": "/holidays"
  },
  "task": {
    "depends": [
      {
        "flow": "@[file://xWidget/flow/day.df]",
        "params": {}
      }
    ],
    "refresh": {
      "at": [
        "20:00"
      ]
    }
  },
  "alert": {
    "level": "normal",
    "activeCondition": "$[gt::(findNotEmpty::(${eveK},0),0)]",
    "message": {
      "title": "${eveT}",
      "body": "${eveB}"
    }
  }
}
