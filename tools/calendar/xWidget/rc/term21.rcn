{
  "_note": "节气(21):当前节气 · 下一个节气与几天后。数据 day.df。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{hd.y}+({hd.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#C8402F|#F2735F",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "hd",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "129pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "${@i18n.term}",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),1,0)]"
        },
        "react": [
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(eq::(findNotEmpty::(${jqNowS},__none__),__none__),0,1)]"
            },
            "react": [
              {
                "id": "jz",
                "type": "txt",
                "x": "10pt",
                "y": "25pt",
                "w": "86pt",
                "h": "-1",
                "maxLines": "1",
                "lineBreak": "0",
                "text": "${jqNowS}",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#128F66|#6FE8BE"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(if::(eq::(findNotEmpty::(${jqNowS},__none__),__none__),0,1),0,1)]"
            },
            "react": [
              {
                "id": "jzE",
                "type": "txt",
                "x": "10pt",
                "y": "31pt",
                "w": "86pt",
                "h": "-1",
                "maxLines": "1",
                "text": "--",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              }
            ]
          }
        ]
      },
