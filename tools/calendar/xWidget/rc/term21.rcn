        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),0,1)]"
        },
        "react": [
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(eq::(findNotEmpty::(${jqNowS},__none__),__none__),0,1)]"
            },
            "react": [
              {
                "id": "je",
                "type": "txt",
                "x": "10pt",
                "y": "28pt",
                "w": "86pt",
                "h": "-1",
                "maxLines": "1",
                "lineBreak": "0",
                "text": "${jqNowS}",
                "fontSize": "15pt",
                "typeface": "System-Bold",
                "textColor": "#128F66|#6FE8BE"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(if::(eq::(findNotEmpty::(${jqNowS},__none__),__none__),0,1),0,1)]"
            },
            "react": [
