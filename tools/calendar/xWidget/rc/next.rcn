            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "text": "$[if::(eq::(${st},2),findNotEmpty::(${nth},--),if::(eq::(${st},1),findNotEmpty::(${name},--),findNotEmpty::(${fbName},--)))]",
            "fontSize": "24pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
