{
  "_note": "农历日子(42):最近 3 条(名称 · 农历 · 今年公历 · 还有几天);空态引导添加。数据 dates.df。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "14.0pt",
        "y": "{hd.y}+({hd.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#C8402F|#F2735F",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "_note": "源色点(card-design-system §2):朱砂,每张组件恰好一次。"
      },
      {
        "id": "hd",
        "type": "txt",
        "x": "23.0pt",
        "y": "12pt",
        "w": "{parent.w}-37.0pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "${@i18n.dates}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "nm0",
        "type": "txt",
        "x": "14.0pt",
        "y": "39pt",
        "w": "{parent.w}-110pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${nm0},--)]",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "hide": "$[if::(eq::(findNotEmpty::(${ok0},0),1),0,1)]"
      },
      {
        "id": "sb0",
        "type": "txt",
        "x": "14.0pt",
        "y": "56pt",
        "w": "{parent.w}-110pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(${sf0},1),${lt0}${@i18n.as29},findNotEmpty::(${lt0},--))] · $[findNotEmpty::(${sd0},)]",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B",
        "hide": "$[if::(eq::(findNotEmpty::(${ok0},0),1),0,1)]"
      },
      {
        "id": "dn0",
        "type": "richText",
        "x": "{parent.w}-{dn0.w}-14.0pt",
        "y": "43pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "hide": "$[if::(eq::(findNotEmpty::(${ok0},0),1),0,1)]",
        "spans": [
          {
            "text": "$[if::(eq::(${dd0},0),${@i18n.isToday},if::(eq::(${dd0},1),${@i18n.tomorrow},findNotEmpty::(${dd0},--)))]",
            "fontSize": "17pt",
            "typeface": "System-Bold",
            "textColor": "$[if::(le::(findNotEmpty::(${dd0},9),1),#C8402F|#F2735F,#0E1116|#F3F4F6)]"
          },
          {
            "text": "$[if::(le::(findNotEmpty::(${dd0},9),1),,${@i18n.daysU})]",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
