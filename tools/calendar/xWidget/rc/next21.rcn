{
  "_note": "下一个假期(21):假期名 · 几天后(放假中 = 第几天)· 共几天。数据 holiday.df。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "10pt",
        "y": "{hd.y}+({hd.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#C8402F|#F2735F",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "hd",
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "129pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[if::(eq::(${st},0),findNotEmpty::(${fbName},--),findNotEmpty::(${name},--))]",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6",
        "_note": "第一行写假期名(这一档没有放「下一个假期」字样的位置;名字本身就回答了「下一个是哪个」)。"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${st},1),if::(eq::(findNotEmpty::(${inD},__none__),__none__),0,1),0)]"
        },
        "react": [
          {
            "id": "n1",
            "spans": [
              {
                "text": "${inD}",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "$[if::(eq::(${inD},1),${@i18n.aft21one},${@i18n.aft21})]",
                "fontSize": "11pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ],
            "type": "richText",
            "x": "10pt",
            "y": "24pt",
            "w": "86pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${st},2),if::(eq::(findNotEmpty::(${nth},__none__),__none__),0,1),0)]"
        },
        "react": [
          {
            "id": "n2",
            "spans": [
              {
                "text": "${@i18n.dayN1}",
                "fontSize": "11pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              },
              {
                "text": "${nth}",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.dayN2}",
                "fontSize": "11pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ],
            "type": "richText",
            "x": "10pt",
            "y": "24pt",
            "w": "86pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${st},0),if::(eq::(findNotEmpty::(${fbIn},-1),0),0,if::(eq::(findNotEmpty::(${fbIn},__none__),__none__),0,1)),0)]"
        },
        "react": [
          {
            "id": "n0",
            "spans": [
              {
                "text": "${fbIn}",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "$[if::(eq::(${fbIn},1),${@i18n.aft21one},${@i18n.aft21})]",
                "fontSize": "11pt",
                "typeface": "System-Bold",
                "textColor": "#6B7280|#8E939B"
              }
            ],
            "type": "richText",
            "x": "10pt",
            "y": "24pt",
            "w": "86pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${st},0),if::(eq::(findNotEmpty::(${fbIn},-1),0),1,0),0)]"
        },
        "react": [
          {
            "id": "n0t",
            "type": "txt",
            "x": "10pt",
            "y": "26pt",
            "w": "86pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${@i18n.isToday}",
            "fontSize": "16pt",
            "typeface": "System-Bold",
            "textColor": "#C8402F|#F2735F"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(or::(eq::(${st},0),or::(eq::(${st},1),eq::(${st},2))),0,1)]"
        },
        "react": [
          {
            "id": "nE",
            "type": "txt",
            "x": "10pt",
            "y": "30pt",
            "w": "86pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${st},2),1,0)]"
        },
        "react": [
          {
            "id": "r2",
            "text": "${@i18n.total1}$[findNotEmpty::(${days},--)]$[if::(eq::(${days},1),${@i18n.total2one},${@i18n.total2})]",
            "type": "txt",
            "x": "96pt",
            "y": "32pt",
            "w": "52pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "alignmentH": "2",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${st},1),1,0)]"
        },
        "react": [
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(startsWith::(${@app.language},zh),1,0)]"
            },
            "react": [
              {
                "id": "r1z",
                "text": "$[findNotEmpty::(${lenT},--)]",
                "type": "txt",
                "x": "96pt",
                "y": "32pt",
                "w": "52pt",
                "h": "-1",
                "maxLines": "1",
                "lineBreak": "0",
                "alignmentH": "2",
                "fontSize": "9pt",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(startsWith::(${@app.language},zh),0,1)]"
            },
            "react": [
              {
                "id": "r1e",
                "text": "$[findNotEmpty::(${days},--)]$[if::(eq::(${days},1),${@i18n.offDay1},${@i18n.offDays})]",
                "type": "txt",
                "x": "96pt",
                "y": "32pt",
                "w": "52pt",
                "h": "-1",
                "maxLines": "1",
                "lineBreak": "0",
                "alignmentH": "2",
                "fontSize": "9pt",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${st},1),0,if::(eq::(${st},2),0,1))]"
        },
        "react": [
          {
            "id": "r0",
            "text": "--",
            "type": "txt",
            "x": "96pt",
            "y": "32pt",
            "w": "52pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "alignmentH": "2",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "dayN1": "假期第 ",
        "dayN2": " 天",
        "total1": "共 ",
        "total2": " 天",
        "isToday": "就是今天",
        "total2one": " 天",
        "offDays": " 天",
        "offDay1": " 天",
        "aft21": " 天后",
        "aft21one": " 天后"
      },
      "en-US": {
        "dayN1": "Day ",
        "dayN2": "",
        "total1": "of ",
        "total2": " days",
        "isToday": "Today",
        "total2one": " day",
        "offDays": " days off",
        "offDay1": " day off",
        "aft21": " days",
        "aft21one": " day"
      }
    },
    "i18nEmptyOk": [
      "dayN2"
    ]
  }
}
