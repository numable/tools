{
  "_note": "今天(11):星期 · 公历日 · 农历日。数据 day.df。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8pt",
        "y": "{hd.y}+({hd.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#C8402F|#F2735F",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "hd",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${wdT},--)]",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${dnum},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "id": "big",
            "type": "txt",
            "x": "8pt",
            "y": "22pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${dnum}",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "$[if::(and::(eq::(findNotEmpty::(${ow},0),1),eq::(findNotEmpty::(${hd},0),1)),#C8402F|#F2735F,#0E1116|#F3F4F6)]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(if::(eq::(findNotEmpty::(${dnum},__none__),__none__),0,1),0,1)]"
        },
        "react": [
          {
            "id": "bigE",
            "type": "txt",
            "x": "8pt",
            "y": "28pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "text": "--",
            "fontSize": "20pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),1,0)]"
        },
        "react": [
          {
            "id": "lz",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[findNotEmpty::(${lmd},--)]",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),0,1)]"
        },
        "react": [
          {
            "id": "le",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "${@i18n.lunarPre} $[findNotEmpty::(${lmd},--)]",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "_note": "英文农历写 Lunar 8/24(day.df 的 lmd):22 档的「Month 8 · Day 24」9pt 要 ~70pt,底行只有 54。"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "lunarPre": "农历"
      },
      "en-US": {
        "lunarPre": "Lunar"
      }
    }
  }
}
