{
  "_note": "今日黄历(42,民俗参考):公历 / 农历 / 干支 / 冲煞 | 宜 4 项 · 忌 4 项 · 值星值神。数据 day.df + yiji.df。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "14.0pt",
        "y": "{hd.y}+({hd.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#C8402F|#F2735F",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "_note": "源色点(card-design-system §2):朱砂,每张组件恰好一次。"
      },
      {
        "id": "hd",
        "type": "txt",
        "x": "23.0pt",
        "y": "12pt",
        "w": "{parent.w}-137.0pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "${@i18n.almanac}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "id": "hdr",
        "type": "txt",
        "x": "{parent.w}-114.0pt",
        "y": "15pt",
        "w": "100pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "text": "${@i18n.folk}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "md",
        "type": "txt",
        "x": "14.0pt",
        "y": "36pt",
        "w": "150pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${mdT},--)] $[findNotEmpty::(${wdT},)]",
        "fontSize": "11.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),1,0)]"
        },
        "react": [
          {
            "id": "ldz",
            "type": "txt",
            "x": "14.0pt",
            "y": "52pt",
            "w": "150pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[findNotEmpty::(${ldate},--)]",
            "fontSize": "26pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),0,1)]"
        },
        "react": [
          {
            "id": "lde",
            "type": "txt",
            "x": "14.0pt",
            "y": "56pt",
            "w": "150pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[findNotEmpty::(${ldate},--)]",
            "fontSize": "16pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "id": "gz",
        "type": "txt",
        "x": "14.0pt",
        "y": "90pt",
        "w": "152pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${gzLine},--)]",
        "fontSize": "11.5pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "id": "cs",
        "type": "txt",
        "x": "14.0pt",
        "y": "124pt",
        "w": "152pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "$[findNotEmpty::(${cs},--)]",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),1,0)]"
        },
        "react": [
          {
            "id": "yiL",
            "type": "txt",
            "x": "176pt",
            "y": "38pt",
            "w": "18pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.yi}",
            "fontSize": "12pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "id": "yiT",
            "type": "txt",
            "x": "196pt",
            "y": "38pt",
            "w": "{parent.w}-210pt",
            "h": "-1",
            "maxLines": "2",
            "lineBreak": "0",
            "text": "$[findNotEmpty::(${yi},--)]",
            "fontSize": "12pt",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "id": "jiL",
            "type": "txt",
            "x": "176pt",
            "y": "80pt",
            "w": "18pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.ji}",
            "fontSize": "12pt",
            "typeface": "System-Bold",
            "textColor": "#0E1116|#F3F4F6"
          },
          {
            "id": "jiT",
            "type": "txt",
            "x": "196pt",
            "y": "80pt",
            "w": "{parent.w}-210pt",
            "h": "-1",
            "maxLines": "2",
            "lineBreak": "0",
            "text": "$[findNotEmpty::(${ji},--)]",
            "fontSize": "12pt",
            "textColor": "#0E1116|#F3F4F6",
            "_note": "宜忌同色(设计 §4.7:不上吉凶色),原表顺序即传统重要度,各取前 4 项"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),0,1)]"
        },
        "react": [
          {
            "id": "yiLe",
            "type": "txt",
            "x": "176pt",
            "y": "38pt",
            "w": "{parent.w}-190pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.yi}",
            "fontSize": "10.5pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B",
            "_note": "英文标签「Good for / Avoid」比「宜 / 忌」宽,改成标签在上、条目在下(条目保留中文,设计 §10)"
          },
          {
            "id": "yiTe",
            "type": "txt",
            "x": "176pt",
            "y": "53pt",
            "w": "{parent.w}-190pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[if::(eq::(${yi},无),${@i18n.none},findNotEmpty::(${yi},--))]",
            "fontSize": "12pt",
            "textColor": "#0E1116|#F3F4F6",
            "_note": "条目保留中文(设计 §10),唯独「无」是词不是条目,英文写 None"
          },
          {
            "id": "jiLe",
            "type": "txt",
            "x": "176pt",
            "y": "80pt",
            "w": "{parent.w}-190pt",
            "h": "-1",
            "maxLines": "1",
            "text": "${@i18n.ji}",
            "fontSize": "10.5pt",
            "typeface": "System-Bold",
            "textColor": "#6B7280|#8E939B"
          },
          {
            "id": "jiTe",
            "type": "txt",
            "x": "176pt",
            "y": "95pt",
            "w": "{parent.w}-190pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[if::(eq::(${ji},无),${@i18n.none},findNotEmpty::(${ji},--))]",
            "fontSize": "12pt",
            "textColor": "#0E1116|#F3F4F6"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),1,0)]"
        },
        "react": [
          {
            "id": "zx",
            "type": "txt",
            "x": "176pt",
            "y": "124pt",
            "w": "{parent.w}-190pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[findNotEmpty::(${zxts},--)]",
            "fontSize": "11pt",
            "textColor": "#6B7280|#8E939B",
            "_note": "值星 · 值神是中文术语,英文界面不放(不译、也不给拼音)"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "almanac": "今日黄历",
        "folk": "民俗参考",
        "yi": "宜",
        "ji": "忌",
        "none": "无"
      },
      "en-US": {
        "almanac": "Chinese almanac",
        "folk": "Folk custom",
        "yi": "Good for",
        "ji": "Avoid",
        "none": "None"
      }
    }
  }
}
