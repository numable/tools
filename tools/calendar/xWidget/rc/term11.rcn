{
  "_note": "节气(11):当前节气 · 下一个节气几天后。数据 day.df。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "8pt",
        "y": "{hd.y}+({hd.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#C8402F|#F2735F",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "hd",
        "type": "txt",
        "x": "17pt",
        "y": "7pt",
        "w": "43pt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "text": "${@i18n.termS}",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),1,0)]"
        },
        "react": [
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(eq::(findNotEmpty::(${jqNowS},__none__),__none__),0,1)]"
            },
            "react": [
              {
                "id": "jz",
                "type": "txt",
                "x": "8pt",
                "y": "22pt",
                "w": "54pt",
                "h": "-1",
                "maxLines": "1",
                "lineBreak": "0",
                "text": "${jqNowS}",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#128F66|#6FE8BE"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(if::(eq::(findNotEmpty::(${jqNowS},__none__),__none__),0,1),0,1)]"
            },
            "react": [
              {
                "id": "jzE",
                "type": "txt",
                "x": "8pt",
                "y": "28pt",
                "w": "54pt",
                "h": "-1",
                "maxLines": "1",
                "text": "--",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),0,1)]"
        },
        "react": [
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(eq::(findNotEmpty::(${jqNowS},__none__),__none__),0,1)]"
            },
            "react": [
              {
                "id": "je",
                "type": "txt",
                "x": "8pt",
                "y": "28pt",
                "w": "54pt",
                "h": "-1",
                "maxLines": "1",
                "lineBreak": "0",
                "text": "${jqNowS}",
                "fontSize": "10pt",
                "typeface": "System-Bold",
                "textColor": "#128F66|#6FE8BE",
                "_note": "英文节气名最长 9 字符(Rainwater 级),20pt 放不下;11pt 在 54pt 里仍截断(渲染台实测),改 10pt"
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(if::(eq::(findNotEmpty::(${jqNowS},__none__),__none__),0,1),0,1)]"
            },
            "react": [
              {
                "id": "jeE",
                "type": "txt",
                "x": "8pt",
                "y": "28pt",
                "w": "54pt",
                "h": "-1",
                "maxLines": "1",
                "text": "--",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),1,0)]"
        },
        "react": [
          {
            "id": "nz",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[findNotEmpty::(${jqNextS},--)] $[findNotEmpty::(${jqIn},--)]${@i18n.aft21}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(startsWith::(${@app.language},zh),0,1)]"
        },
        "react": [
          {
            "id": "ne",
            "type": "txt",
            "x": "8pt",
            "y": "46pt",
            "w": "54pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "text": "$[findNotEmpty::(${jqNextS},--)] $[findNotEmpty::(${jqIn},--)]d",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B"
          }
        ]
      }
    ],
    "i18n": {
      "zh-CN": {
        "aft21": " 天后",
        "termS": "节气"
      },
      "en-US": {
        "aft21": " days",
        "termS": "Term"
      }
    }
  }
}
