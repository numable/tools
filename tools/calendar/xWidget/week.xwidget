{
  "_note": "本周(42)。零网络,数据全部来自包内的表(生成器 tools/infosource/calendar/gen.py,别手改)。",
  "version": 2,
  "title": "本周",
  "sub": "这周哪天休、哪天调休上班",
  "i18n": {
    "en-US": {
      "title": "This week",
      "sub": "China days off and make-up workdays this week"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "本周七天的日期与农历，哪天放假休息、哪天调休上班（按中国放假安排）"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/week.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/week.df]",
        "params": {}
      },
      {
        "flow": "@[file://flow/day.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络组件唯一的刷新理由是跨天:at 00:00 准点翻页,interval 兜底系统没准点回调。",
      "at": [
        "00:00"
      ],
      "interval": [
        "3600"
      ]
    }
  },
  "jobs": [
    {
      "id": "eve",
      "params": {}
    }
  ]
}
