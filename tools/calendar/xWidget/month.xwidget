{
  "_note": "月历(44)。零网络,数据全部来自包内的表(生成器 tools/infosource/calendar/gen.py,别手改)。",
  "version": 2,
  "title": "月历",
  "sub": "整月公历 · 农历 · 节日 · 休班",
  "i18n": {
    "en-US": {
      "title": "Month",
      "sub": "The whole month with lunar dates and China days off"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "本月整月月历：每天的公历与农历、节日节气，以及中国放假「休」/ 调休「班」标记"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/month.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/month.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络组件唯一的刷新理由是跨天:at 00:00 准点翻页,interval 兜底系统没准点回调。",
      "at": [
        "00:00"
      ],
      "interval": [
        "3600"
      ]
    }
  }
}
