{
  "_note": "今天(11)。零网络,数据全部来自包内的表(生成器 tools/infosource/calendar/gen.py,别手改)。",
  "version": 2,
  "title": "今天",
  "sub": "一格 · 日期、星期与农历",
  "i18n": {
    "en-US": {
      "title": "Today",
      "sub": "Tiny · date, weekday and lunar date"
    }
  },
  "layout": 11,
  "params": {},
  "ai": {
    "shows": "今天的公历日期、星期与农历日期（一格小组件）"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/today11.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/day.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络组件唯一的刷新理由是跨天:at 00:00 准点翻页,interval 兜底系统没准点回调。",
      "at": [
        "00:00"
      ],
      "interval": [
        "3600"
      ]
    }
  }
}
