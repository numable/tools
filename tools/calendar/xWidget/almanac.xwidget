{
  "_note": "今日黄历(42)。零网络,数据全部来自包内的表(生成器 tools/infosource/calendar/gen.py,别手改)。",
  "version": 2,
  "title": "今日黄历",
  "sub": "农历干支 · 宜忌 · 冲煞（民俗参考）",
  "i18n": {
    "en-US": {
      "title": "Chinese almanac",
      "sub": "Lunar date, ganzhi and folk almanac (entries in Chinese)"
