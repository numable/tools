{
  "_note": "今天(22)。零网络,数据全部来自包内的表(生成器 tools/infosource/calendar/gen.py,别手改)。",
  "version": 2,
  "title": "今天",
  "sub": "公历 · 农历 · 节日 · 休班",
  "i18n": {
    "en-US": {
      "title": "Today",
      "sub": "Date, lunar date, festival and China day off"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "今天的公历日期、星期、农历日期，当天的节日或节气，以及中国放假「休」/ 调休「班」标记"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/today.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/day.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络组件唯一的刷新理由是跨天:at 00:00 准点翻页,interval 兜底系统没准点回调。",
      "at": [
        "00:00"
      ],
      "interval": [
        "3600"
      ]
    }
  }
}
