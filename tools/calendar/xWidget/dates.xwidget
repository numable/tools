{
  "_note": "农历日子(42)。零网络,数据全部来自包内的表(生成器 tools/infosource/calendar/gen.py,别手改)。",
  "version": 2,
  "title": "农历日子",
  "sub": "家人的农历生日 · 今年是哪天",
  "i18n": {
    "en-US": {
      "title": "Lunar dates",
      "sub": "Lunar birthdays and when they fall this year"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "用户添加的家人农历生日等农历日子，今年对应公历哪天、还有几天"
  },
  "events": {
    "onClick": "numable://self/page/dates"
  },
  "canvas": {
    "source": "@[file://rc/dates.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/dates.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络组件唯一的刷新理由是跨天:at 00:00 准点翻页,interval 兜底系统没准点回调。",
      "at": [
        "00:00"
      ],
      "interval": [
        "3600"
      ]
    }
  },
  "jobs": [
    {
      "id": "dates",
      "params": {}
    }
  ]
}
