{
  "_note": "月历 42 格(入参 ym = yyyy-MM,缺省本月)。每格 n 公历日 / t 标签 / k 类别(1 法定首日 2 传统节日 3 节气 4 公历节日 5 初一月名 6 农历日)/ h 休班(0/1/2)/ o 本月 / w 周末 / c 今天。周首读 data settings.ws。生成器 tools/infosource/calendar/gen.py。",
  "version": 1,
  "actions": [
    {
      "op": "set",
      "props": {
        "key": "at0",
        "value": "${at}"
      },
      "_note": "入参先落地:方法参数里的 ${} 看不见 flow 入参(numable docs df)。"
    },
    {
      "op": "set",
      "props": {
        "key": "today",
        "value": "$[formatDate::(${@time.nowMs},yyyy-MM-dd)]"
      },
      "_note": "本机日期 —— 日历按本地的「今天」对照(设计 §4.8)。"
    },
    {
      "op": "set",
      "props": {
        "key": "D",
        "value": "$[findNotEmpty::(${at0},${today})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "y",
        "value": "$[round::(calc::(subString::(${D},0,4)+0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "m",
        "value": "$[round::(calc::(subString::(${D},5,7)+0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "d",
        "value": "$[round::(calc::(subString::(${D},8,10)+0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tyy",
        "value": "$[calc::(${y}-if::(le::(${m},2),1,0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tmp",
        "value": "$[if::(gt::(${m},2),calc::(${m}-3),calc::(${m}+9))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ter",
        "value": "$[floor::(calc::(${tyy}/400))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tye",
        "value": "$[calc::(${tyy}-${ter}*400)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tdy",
        "value": "$[calc::(floor::(calc::((153*${tmp}+2)/5))+${d}-1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tdn",
        "value": "$[round::(calc::(${ter}*146097+${tye}*365+floor::(calc::(${tye}/4))-floor::(calc::(${tye}/100))+${tdy}-719468))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "wd",
        "value": "$[round::(calc::(${tdn}+4-floor::(calc::((${tdn}+4)/7))*7))]"
      },
      "_note": "0 = 周日 … 6 = 周六(1970-01-01 是周四)"
    },
    {
      "op": "set",
      "props": {
        "key": "zh",
        "value": "$[if::(startsWith::(${@app.language},zh),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "NY",
        "value": "17932;18286;18670;19024;19379;19763;20117;20501;20855;21209;21593;21948;22302;22686;23041;23425;23779;24133;24517;24871;25225;25609;25964;26319;26703;27057;27441;27795;28149;28533;28887;29242;29626;29981;30365;30719;31073;31456;31811;32165;32549;32904;33258"
      }
    },
