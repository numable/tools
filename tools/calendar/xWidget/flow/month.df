    {
      "id": "st",
      "action": "data.get",
      "params": {
        "key": "settings",
        "default": {}
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cnd",
        "value": "$[if::(eq::(${@app.region},cn),1,if::(eq::(${@app.region},overseas),0,if::(startsWith::(${@app.language},zh),1,0)))]"
      },
      "_note": "国内默认判据(doc/overseas-first.md §1)"
    },
    {
      "op": "set",
      "props": {
        "key": "_fw",
        "value": "$[findNotEmpty::(${@app.firstWeekday},none)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "fw",
        "value": "$[if::(eq::(${_fw},none),if::(eq::(${cnd},1),1,7),${_fw})]"
      },
      "_note": "宿主周首(ISO 1 周一 … 7 周日);老宿主没注入 → 国内默认周一、海外默认周日(§6)"
    },
    {
      "op": "set",
      "props": {
        "key": "_wsS",
        "value": "$[findNotEmpty::(${st.ws},none)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ws",
        "value": "$[round::(if::(eq::(${_wsS},none),if::(eq::(${fw},7),0,1),if::(eq::(${_wsS},0),0,1)))]"
      },
      "_note": "周首:1 周一 / 0 周日。用户设置优先;缺省跟随宿主(本包只支持周一 / 周日:7 → 周日,其余 → 周一)"
    },
    {
