        "value": "$[round::(if::(ge::(findNotEmpty::(index::(${x2},0),-1),${tdn}),0,if::(ge::(findNotEmpty::(index::(${x2},1),-1),${tdn}),1,if::(ge::(findNotEmpty::(index::(${x2},2),-1),${tdn}),2,if::(ge::(findNotEmpty::(index::(${x2},3),-1),${tdn}),3,if::(ge::(findNotEmpty::(index::(${x2},4),-1),${tdn}),4,if::(ge::(findNotEmpty::(index::(${x2},5),-1),${tdn}),5,if::(ge::(findNotEmpty::(index::(${x2},6),-1),${tdn}),6,if::(ge::(findNotEmpty::(index::(${x2},7),-1),${tdn}),7,if::(ge::(findNotEmpty::(index::(${x2},8),-1),${tdn}),8,if::(ge::(findNotEmpty::(index::(${x2},9),-1),${tdn}),9,if::(ge::(findNotEmpty::(index::(${x2},10),-1),${tdn}),10,if::(ge::(findNotEmpty::(index::(${x2},11),-1),${tdn}),11,-1)))))))))))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "v2",
        "value": "$[round::(if::(ge::(${j2},0),calc::(index::(${x2},${j2})-${tdn}),99999))]"
