{
  "_note": "我的农历日子(最多 12 条,取最近 3 条)。data.lunarDates 由 /dates 页写入,每条预存未来 12 次的公历日序 nx、显示串 nz/ne、按廿九标记 nf —— 换算在页面(JS 引擎)做,流里只挑选。生成器 tools/infosource/calendar/gen.py。",
  "version": 1,
  "actions": [
    {
      "op": "set",
      "props": {
        "key": "at0",
        "value": "${at}"
      },
      "_note": "入参先落地:方法参数里的 ${} 看不见 flow 入参(numable docs df)。"
    },
    {
      "op": "set",
      "props": {
        "key": "today",
        "value": "$[formatDate::(${@time.nowMs},yyyy-MM-dd)]"
      },
      "_note": "本机日期 —— 日历按本地的「今天」对照(设计 §4.8)。"
    },
    {
      "op": "set",
      "props": {
        "key": "D",
        "value": "$[findNotEmpty::(${at0},${today})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "y",
        "value": "$[round::(calc::(subString::(${D},0,4)+0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "m",
        "value": "$[round::(calc::(subString::(${D},5,7)+0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "d",
        "value": "$[round::(calc::(subString::(${D},8,10)+0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tyy",
        "value": "$[calc::(${y}-if::(le::(${m},2),1,0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tmp",
        "value": "$[if::(gt::(${m},2),calc::(${m}-3),calc::(${m}+9))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ter",
        "value": "$[floor::(calc::(${tyy}/400))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tye",
        "value": "$[calc::(${tyy}-${ter}*400)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tdy",
        "value": "$[calc::(floor::(calc::((153*${tmp}+2)/5))+${d}-1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tdn",
        "value": "$[round::(calc::(${ter}*146097+${tye}*365+floor::(calc::(${tye}/4))-floor::(calc::(${tye}/100))+${tdy}-719468))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "wd",
        "value": "$[round::(calc::(${tdn}+4-floor::(calc::((${tdn}+4)/7))*7))]"
      },
      "_note": "0 = 周日 … 6 = 周六(1970-01-01 是周四)"
    },
    {
      "op": "set",
      "props": {
        "key": "zh",
        "value": "$[if::(startsWith::(${@app.language},zh),1,0)]"
      }
    },
    {
      "id": "L",
      "action": "data.get",
      "params": {
        "key": "lunarDates",
        "default": []
      }
    },
    {
      "op": "set",
      "props": {
        "key": "n",
        "value": "$[length::(${L})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "e0",
        "value": "$[index::(${L},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "x0",
        "value": "$[split::(findNotEmpty::(get::(${e0},nx),),:)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "j0",
        "value": "$[round::(if::(ge::(findNotEmpty::(index::(${x0},0),-1),${tdn}),0,if::(ge::(findNotEmpty::(index::(${x0},1),-1),${tdn}),1,if::(ge::(findNotEmpty::(index::(${x0},2),-1),${tdn}),2,if::(ge::(findNotEmpty::(index::(${x0},3),-1),${tdn}),3,if::(ge::(findNotEmpty::(index::(${x0},4),-1),${tdn}),4,if::(ge::(findNotEmpty::(index::(${x0},5),-1),${tdn}),5,if::(ge::(findNotEmpty::(index::(${x0},6),-1),${tdn}),6,if::(ge::(findNotEmpty::(index::(${x0},7),-1),${tdn}),7,if::(ge::(findNotEmpty::(index::(${x0},8),-1),${tdn}),8,if::(ge::(findNotEmpty::(index::(${x0},9),-1),${tdn}),9,if::(ge::(findNotEmpty::(index::(${x0},10),-1),${tdn}),10,if::(ge::(findNotEmpty::(index::(${x0},11),-1),${tdn}),11,-1)))))))))))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "v0",
        "value": "$[round::(if::(ge::(${j0},0),calc::(index::(${x0},${j0})-${tdn}),99999))]"
      },
      "_note": "距今天数;没有条目 / 预算日期用完 = 99999"
    },
    {
      "op": "set",
      "props": {
        "key": "e1",
        "value": "$[index::(${L},1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "x1",
        "value": "$[split::(findNotEmpty::(get::(${e1},nx),),:)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "j1",
        "value": "$[round::(if::(ge::(findNotEmpty::(index::(${x1},0),-1),${tdn}),0,if::(ge::(findNotEmpty::(index::(${x1},1),-1),${tdn}),1,if::(ge::(findNotEmpty::(index::(${x1},2),-1),${tdn}),2,if::(ge::(findNotEmpty::(index::(${x1},3),-1),${tdn}),3,if::(ge::(findNotEmpty::(index::(${x1},4),-1),${tdn}),4,if::(ge::(findNotEmpty::(index::(${x1},5),-1),${tdn}),5,if::(ge::(findNotEmpty::(index::(${x1},6),-1),${tdn}),6,if::(ge::(findNotEmpty::(index::(${x1},7),-1),${tdn}),7,if::(ge::(findNotEmpty::(index::(${x1},8),-1),${tdn}),8,if::(ge::(findNotEmpty::(index::(${x1},9),-1),${tdn}),9,if::(ge::(findNotEmpty::(index::(${x1},10),-1),${tdn}),10,if::(ge::(findNotEmpty::(index::(${x1},11),-1),${tdn}),11,-1)))))))))))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "v1",
        "value": "$[round::(if::(ge::(${j1},0),calc::(index::(${x1},${j1})-${tdn}),99999))]"
      },
      "_note": "距今天数;没有条目 / 预算日期用完 = 99999"
    },
