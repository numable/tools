32671#端午节#Dragon Boat#6 月 14 日 周六#Jun 14 Sat;32770#中秋节#Mid-Autumn#9 月 21 日 周日#Sep 21 Sun;32780#国庆节#National Day#10 月 1 日 周三#Oct 1 Wed~32872#元旦#New Year#1 月 1 日 周四#Jan 1 Thu;32904#春节#Spring Fest#2 月 2 日 周一#Feb 2 Mon;32966#清明节#Qingming#4 月 4 日 周日#Apr 4 Sun;32993#劳动节#Labour Day#5 月 1 日 周六#May 1 Sat;33026#端午节#Dragon Boat#6 月 3 日 周四#Jun 3 Thu;33124#中秋节#Mid-Autumn#9 月 9 日 周四#Sep 9 Thu;33146#国庆节#National Day#10 月 1 日 周五#Oct 1 Fri"
      },
      "_note": "法定节日当天(公历年 2026–2060,表外回落用)"
    },
    {
      "op": "set",
      "props": {
        "key": "HPA",
        "value": "$[split::(${HP},~)]"
      }
    },
    {
      "id": "stg",
      "action": "data.get",
      "params": {
        "key": "settings",
        "default": {}
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_owS",
        "value": "$[findNotEmpty::(${stg.offwork},none)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ow",
        "value": "$[round::(if::(eq::(${_owS},none),${zh},if::(eq::(${_owS},0),0,1)))]"
      },
      "_note": "1 = 显示休 / 班(芯片、调休上班提示);用户设置优先,缺省跟界面语言"
    },
    {
      "op": "set",
      "props": {
        "key": "pi",
        "value": "$[round::(if::(ge::(index::(split::(index::(${HPA},0),_),1),${tdn}),0,if::(ge::(index::(split::(index::(${HPA},1),_),1),${tdn}),1,if::(ge::(index::(split::(index::(${HPA},2),_),1),${tdn}),2,if::(ge::(index::(split::(index::(${HPA},3),_),1),${tdn}),3,if::(ge::(index::(split::(index::(${HPA},4),_),1),${tdn}),4,if::(ge::(index::(split::(index::(${HPA},5),_),1),${tdn}),5,if::(ge::(index::(split::(index::(${HPA},6),_),1),${tdn}),6,if::(ge::(index::(split::(index::(${HPA},7),_),1),${tdn}),7,if::(ge::(index::(split::(index::(${HPA},8),_),1),${tdn}),8,if::(ge::(index::(split::(index::(${HPA},9),_),1),${tdn}),9,if::(ge::(index::(split::(index::(${HPA},10),_),1),${tdn}),10,if::(ge::(index::(split::(index::(${HPA},11),_),1),${tdn}),11,if::(ge::(index::(split::(index::(${HPA},12),_),1),${tdn}),12,-1))))))))))))))]"
      },
      "_note": "-1 = 表跑完了 → 回落到下一个法定节日"
    },
    {
      "op": "set",
      "props": {
        "key": "R",
        "value": "$[split::(index::(${HPA},${pi}),_)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "R2",
        "value": "$[split::(index::(${HPA},calc::(${pi}+1)),_)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ps",
        "value": "$[index::(${R},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pe",
        "value": "$[index::(${R},1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "st",
        "value": "$[round::(if::(lt::(${pi},0),0,if::(ge::(${tdn},${ps}),2,1)))]"
      },
      "_note": "0 表外回落 / 1 还没开始 / 2 放假中"
    },
    {
      "op": "set",
      "props": {
        "key": "name",
        "value": "$[if::(eq::(${zh},1),index::(${R},3),index::(${R},4))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "range",
        "value": "$[if::(eq::(${zh},1),index::(${R},5),index::(${R},6))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "days",
        "value": "$[index::(${R},2)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lenZ",
        "value": "共 ${days} 天"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lenE1",
        "value": "${days} day"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lenE",
        "value": "${days} days"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lenT",
        "value": "$[if::(eq::(${st},0),,if::(eq::(${zh},1),${lenZ},if::(eq::(${days},1),${lenE1},${lenE})))]"
      },
      "_note": "放假天数(英文按单复数)。st 不匹配的分支键一律置空(2026-10-08:st=0 时曾吐「共  天」「-645 天后」这类垃圾值)"
    },
    {
      "op": "set",
      "props": {
        "key": "inD",
        "value": "$[if::(eq::(${st},1),round::(calc::(${ps}-${tdn})),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "nth",
        "value": "$[if::(eq::(${st},2),round::(calc::(${tdn}-${ps}+1)),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "left",
        "value": "$[if::(eq::(${st},2),round::(calc::(${pe}-${tdn})),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "bar",
        "value": "$[if::(and::(eq::(${st},2),gt::(${days},0)),round::(calc::(${nth}/${days}*100)),)]"
      },
      "_note": "parseNumber 取整四端舍入不一(web 截断 66 / iOS 四舍五入 67),改 round"
    },
    {
      "op": "set",
      "props": {
        "key": "back",
        "value": "$[if::(eq::(${zh},1),index::(${R},10),index::(${R},11))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "WD",
        "value": "$[split::(index::(${R},7),:)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "WZ",
        "value": "$[if::(eq::(${zh},1),split::(index::(${R},8),:),split::(index::(${R},9),:))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "w1",
        "value": "$[if::(ge::(findNotEmpty::(index::(${WD},0),0),${tdn}),index::(${WZ},0),if::(ge::(findNotEmpty::(index::(${WD},1),0),${tdn}),index::(${WZ},1),if::(ge::(findNotEmpty::(index::(${WD},2),0),${tdn}),index::(${WZ},2),)))]"
      },
      "_note": "最近一个还没到的调休上班日(已过的不再列)"
    },
    {
      "op": "set",
      "props": {
        "key": "nx",
        "value": "$[if::(eq::(${zh},1),index::(${R2},3),index::(${R2},4))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "nxD",
        "value": "$[round::(calc::(findNotEmpty::(index::(${R2},0),0)-${tdn}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hasNx",
        "value": "$[if::(and::(eq::(${st},2),if::(eq::(findNotEmpty::(${nx},__none__),__none__),0,1)),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "nxT",
        "value": "$[if::(eq::(${hasNx},1),if::(eq::(${zh},1),接着是${nx} · ${nxD} 天后,Next · ${nx} in ${nxD}d),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "LGA",
        "value": "$[split::(${LG},~)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "yo",
        "value": "$[round::(calc::(${y}-2026))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "FA",
        "value": "$[split::(connect::(index::(${LGA},${yo}),;,index::(${LGA},calc::(${yo}+1))),;)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "fi",
        "value": "$[round::(if::(ge::(findNotEmpty::(index::(split::(index::(${FA},0),#),0),-1),${tdn}),0,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},1),#),0),-1),${tdn}),1,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},2),#),0),-1),${tdn}),2,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},3),#),0),-1),${tdn}),3,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},4),#),0),-1),${tdn}),4,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},5),#),0),-1),${tdn}),5,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},6),#),0),-1),${tdn}),6,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},7),#),0),-1),${tdn}),7,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},8),#),0),-1),${tdn}),8,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},9),#),0),-1),${tdn}),9,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},10),#),0),-1),${tdn}),10,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},11),#),0),-1),${tdn}),11,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},12),#),0),-1),${tdn}),12,if::(ge::(findNotEmpty::(index::(split::(index::(${FA},13),#),0),-1),${tdn}),13,-1)))))))))))))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "FR",
        "value": "$[split::(index::(${FA},${fi}),#)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "fbName",
        "value": "$[if::(eq::(${zh},1),index::(${FR},1),index::(${FR},2))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "fbDate",
        "value": "$[if::(eq::(${zh},1),index::(${FR},3),index::(${FR},4))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "fbIn",
        "value": "$[round::(calc::(index::(${FR},0)-${tdn}))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "pendT",
        "value": "$[if::(eq::(${zh},1),2027 年放假安排尚未公布,2027 holiday schedule not yet published)]"
      }
    },
    {
      "action": "resultFilter",
      "params": {
