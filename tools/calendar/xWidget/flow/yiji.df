      }
    },
    {
      "op": "set",
      "props": {
        "key": "dz",
        "value": "$[round::(calc::(${di}-floor::(calc::((${di})/12))*12))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "cs",
        "value": "$[if::(eq::(${zh},1),index::(split::(${CS},;),${dz}),index::(split::(${CSE},;),${dz}))]"
