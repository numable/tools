{
  "_note": "黄历(民俗参考):宜 / 忌各前 4 项 + 值星 · 值神 + 冲煞。键 = 月支(节当天换月)+ 日干支,720 键固定表,永不过期。入参 at 缺省今天。宜忌词条不译(设计 §10)。生成器 tools/infosource/calendar/gen.py。",
  "version": 1,
  "actions": [
    {
      "op": "set",
      "props": {
        "key": "at0",
        "value": "${at}"
      },
      "_note": "入参先落地:方法参数里的 ${} 看不见 flow 入参(numable docs df)。"
    },
    {
      "op": "set",
      "props": {
        "key": "today",
        "value": "$[formatDate::(${@time.nowMs},yyyy-MM-dd)]"
      },
      "_note": "本机日期 —— 日历按本地的「今天」对照(设计 §4.8)。"
    },
    {
      "op": "set",
      "props": {
        "key": "D",
        "value": "$[findNotEmpty::(${at0},${today})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "y",
        "value": "$[round::(calc::(subString::(${D},0,4)+0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "m",
        "value": "$[round::(calc::(subString::(${D},5,7)+0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "d",
        "value": "$[round::(calc::(subString::(${D},8,10)+0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tyy",
        "value": "$[calc::(${y}-if::(le::(${m},2),1,0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tmp",
        "value": "$[if::(gt::(${m},2),calc::(${m}-3),calc::(${m}+9))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ter",
        "value": "$[floor::(calc::(${tyy}/400))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tye",
        "value": "$[calc::(${tyy}-${ter}*400)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tdy",
        "value": "$[calc::(floor::(calc::((153*${tmp}+2)/5))+${d}-1)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tdn",
        "value": "$[round::(calc::(${ter}*146097+${tye}*365+floor::(calc::(${tye}/4))-floor::(calc::(${tye}/100))+${tdy}-719468))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "wd",
        "value": "$[round::(calc::(${tdn}+4-floor::(calc::((${tdn}+4)/7))*7))]"
      },
      "_note": "0 = 周日 … 6 = 周六(1970-01-01 是周四)"
    },
    {
      "op": "set",
      "props": {
        "key": "zh",
        "value": "$[if::(startsWith::(${@app.language},zh),1,0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "JQ",
        "value": "18267_18281_18296_18311_18326_18341_18356_18371_18387_18402_18418_18434_18449_18465_18481_18496_18512_18527_18543_18558_18573_18588_18603_18617~18632_18647_18661_18676_18691_18706_18721_18737_18752_18768_18783_18799_18815_18830_18846_18862_18877_18893_18908_18923_18938_18953_18968_18982~18997_19012_19027_19042_19056_19071_19087_19102_19117_19133_19149_19164_19180_19196_19211_19227_19242_19258_19273_19288_19303_19318_19333_19348~19362_19377_19392_19407_19422_19437_19452_19467_19483_19498_19514_19529_19545_19561_19577_19592_19608_19623_19638_19654_19669_19683_19698_19713~19728_19742_19757_19772_19787_19802_19817_19832_19848_19863_19879_19895_19910_19926_19942_19957_19973_19988_20004_20019_20034_20049_20063_20078~20093_20108_20122_20137_20152_20167_20182_20198_20213_20229_20244_20260_20276_20291_20307_20323_20338_20354_20369_20384_20399_20414_20429_20443~20458_20473_20488_20502_20517_20532_20548_20563_20578_20594_20609_20625_20641_20657_20672_20688_20703_20719_20734_20749_20764_20779_20794_20809~20823_20838_20853_20868_20883_20898_20913_20928_20944_20959_20975_20990_21006_21022_21038_21053_21069_21084_21099_21114_21129_21144_21159_21174~21189_21203_21218_21233_21248_21263_21278_21293_21309_21324_21340_21356_21371_21387_21403_21418_21434_21449_21465_21480_21495_21510_21524_21539~21554_21569_21583_21598_21613_21628_21643_21659_21674_21690_21705_21721_21737_21752_21768_21784_21799_21815_21830_21845_21860_21875_21890_21904~21919_21934_21949_21963_21978_21993_22009_22024_22039_22055_22070_22086_22102_22118_22133_22149_22164_22180_22195_22210_22225_22240_22255_22270~22284_22299_22314_22329_22344_22359_22374_22389_22405_22420_22436_22451_22467_22483_22499_22514_22530_22545_22560_22575_22590_22605_22620_22635~22650_22664_22679_22694_22709_22724_22739_22754_22770_22785_22801_22817_22832_22848_22864_22879_22895_22910_22926_22941_22956_22971_22985_23000~23015_23030_23044_23059_23074_23089_23104_23120_23135_23151_23166_23182_23198_23213_23229_23245_23260_23276_23