    {
      "op": "set",
      "props": {
        "key": "hou",
        "value": "$[index::(if::(eq::(${zh},1),split::(${HOU},;),split::(${HOUE},;)),calc::(${ci}*3+${houI}))]"
      },
      "_note": "三候:中文原文 / 英文意译(cncal HOU_EN,2026-09-30 起;此前英文界面也显示原文)"
    },
    {
      "op": "set",
      "props": {
        "key": "jqBZ",
        "value": "${jqAtL} 交节 · ${hou}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "jqBE1",
        "value": "Begins at ${jqAtL} · ${hou}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "jqBE2",
        "value": "${jqAtL} · ${hou}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "jqB",
        "value": "$[if::(eq::(${jqHas},0),${hou},if::(eq::(${zh},1),${jqBZ},if::(eq::(${jqLK},${tK}),${jqBE1},${jqBE2})))]"
      },
      "_note": "节气提醒正文(term.xjob;排在 hou 之后):本地时刻 + 三候;没有交节时刻的那几处只放三候"
    },
    {
      "op": "set",
      "props": {
        "key": "tg",
        "value": "$[if::(eq::(${zh},1),index::(split::(index::(split::(${TG},~${tdn}=),1),~),0),index::(split::(index::(split::(${TGE},~${tdn}=),1),~),0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tgk",
        "value": "$[round::(findNotEmpty::(subString::(${tg},0,1),9))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tgn",
        "value": "$[subString::(${tg},1,40)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tag",
        "value": "$[if::(le::(${tgk},4),${tgn},if::(eq::(${ld},1),${lmon},${lday}))]"
      },
      "_note": "§4.2:传统节日 > 节气 > 公历节日 > 初一月名 > 农历日(优先级已在生成器里归并进 TG)"
    },
    {
      "op": "set",
      "props": {
        "key": "tagK",
        "value": "$[round::(if::(le::(${tgk},4),${tgk},if::(eq::(${ld},1),5,6)))]"
      },
      "_note": "1 法定首日 / 2 传统节日 / 3 节气 / 4 公历节日 / 5 初一月名 / 6 农历日"
    },
    {
      "id": "stg",
      "action": "data.get",
      "params": {
        "key": "settings",
        "default": {}
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_owS",
        "value": "$[findNotEmpty::(${stg.offwork},none)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ow",
        "value": "$[round::(if::(eq::(${_owS},none),${zh},if::(eq::(${_owS},0),0,1)))]"
      },
      "_note": "1 = 显示休 / 班(芯片、调休上班提示);用户设置优先,缺省跟界面语言"
    },
    {
      "op": "set",
      "props": {
        "key": "hdv",
        "value": "$[index::(split::(index::(split::(${HD},~${tdn}=),1),~),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hd0",
        "value": "$[round::(findNotEmpty::(subString::(${hdv},0,1),0))]"
      },
      "_note": "0 无 / 1 休 / 2 班(原值)"
    },
    {
      "op": "set",
      "props": {
        "key": "hd",
        "value": "$[round::(if::(eq::(${ow},1),${hd0},0))]"
      },
      "_note": "组件用:休 / 班标记关掉时恒 0(芯片整个隐藏)"
    },
    {
      "op": "set",
      "props": {
        "key": "hdName",
        "value": "$[if::(eq::(${zh},1),index::(split::(subString::(${hdv},1,60),#),0),index::(split::(subString::(${hdv},1,60),#),1))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hdT",
        "value": "$[if::(eq::(${hd},1),${@i18n.off},if::(eq::(${hd},2),${@i18n.work},))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "tdn1",
        "value": "$[round::(calc::(${tdn}+1))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hdv1",
        "value": "$[index::(split::(index::(split::(${HD},~${tdn1}=),1),~),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hd1",
        "value": "$[round::(findNotEmpty::(subString::(${hdv1},0,1),0))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hs1",
        "value": "$[index::(split::(index::(split::(${HS},~${tdn1}=),1),~),0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "wdA",
        "value": "$[if::(eq::(${zh},1),split::(${WDZ},;),split::(${WDE},;))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "wdT",
        "value": "$[index::(${wdA},${wd})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "wd1T",
        "value": "$[index::(${wdA},calc::(${wd}+1-floor::(calc::((${wd}+1)/7))*7))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hs1n",
        "value": "$[if::(eq::(${zh},1),index::(split::(${hs1},#),0),index::(split::(${hs1},#),1))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hs1d",
        "value": "$[index::(split::(${hs1},#),2)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "eveK",
        "value": "$[round::(if::(eq::(${hd1},2),1,if::(if::(eq::(findNotEmpty::(${hs1},__none__),__none__),0,1),2,0)))]"
      },
      "_note": "明天是调休上班日 = 1 / 明天开始放假 = 2 / 否 = 0(eve.xjob 的判据;用户自己开的提醒,不受 ow 管)"
    },
    {
      "op": "set",
      "props": {
        "key": "eveS",
        "value": "$[round::(if::(eq::(${ow},1),${eveK},0))]"
      },
      "_note": "组件里「明天要上班」那一行:休 / 班标记关掉时不显示"
    },
    {
      "op": "set",
      "props": {
        "key": "eveZ1",
        "value": "明天（${wd1T}）要上班"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "eveE1",
        "value": "Workday tomorrow · ${wd1T}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "eveZ2",
        "value": "明天开始放假 · ${hs1n}共 ${hs1d} 天"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "eveE2",
        "value": "Holiday starts tomorrow · ${hs1n}"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "eveT",
        "value": "$[if::(eq::(${eveK},1),if::(eq::(${zh},1),${eveZ1},${eveE1}),if::(eq::(${eveK},2),if::(eq::(${zh},1),${eveZ2},${eveE2}),))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "hdn1",
        "value": "$[if::(eq::(${zh},1),index::(split::(subString::(${hdv1},1,60),#),0),index::(split::(subString::(${hdv1},1,60),#),1))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "eveB",
        "value": "$[if::(eq::(${eveK},1),${hdn1} · ${@i18n.eveWorkB},if::(eq::(${eveK},2),${@i18n.eveOffB},))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "inR",
        "value": "$[if::(and::(ge::(${y},2021),le::(${y},2026)),1,0)]"
      },
      "_note": "这一天是否在已公布的放假安排年份内;不在 = 不显示休 / 班(设计 §4.6)"
    },
    {
      "op": "set",
      "props": {
        "key": "lcY",
        "value": "$[round::(if::(ge::(${tdn},index::(${JQA},2)),${y},calc::(${y}-1)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lci",
        "value": "$[round::(calc::(calc::(${lcY}-4)-floor::(calc::((calc::(${lcY}-4))/60))*60))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lcG",
        "value": "$[index::(${GAN},round::(calc::(${lci}-floor::(calc::((${lci})/10))*10)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lcZ",
        "value": "$[index::(${ZHI},round::(calc::(${lci}-floor::(calc::((${lci})/12))*12)))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lcAltZ",
        "value": "按立春换年为${lcG}${lcZ}年"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "lcAlt",
        "value": "$[if::(eq::(${lcY},${ly}),,if::(eq::(${zh},1),${lcAltZ},))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "dnum",
        "value": "$[parseNumber::(${d},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "mnum",
        "value": "$[parseNumber::(${m},0)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "ymT",
        "value": "$[if::(eq::(${zh},1),${y} 年 ${mnum} 月,index::(split::(${MOE},;),calc::(${m}-1)) ${y})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "mdT",
        "value": "$[if::(eq::(${zh},1),${mnum} 月 ${dnum} 日,index::(split::(${MOE},;),calc::(${m}-1)) ${dnum})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "monT",
        "value": "$[if::(eq::(${zh},1),${mnum} 月,index::(split::(${MOE},;),calc::(${m}-1)))]"
      },
      "_note": "今天(22)大号日旁的月份(2026-10-08 追加)"
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "D",
          "dnum",
          "mnum",
          "monT",
          "ymT",
          "mdT",
          "wd",
          "wdT",
          "ldate",
          "lmon",
          "lday",
          "lsize",
          "ld",
          "lyr",
          "sx",
          "gzLine",
          "jqT",
          "jqTime",
          "jqNow",
          "jqNext",
          "jqIn",
          "jqNowS",
          "jqNextS",
          "hou",
          "houI",
          "tag",
          "tagK",
          "hd",
          "hdT",
          "hdName",
          "hd1",
          "eveK",
          "eveS",
          "eveT",
          "eveB",
          "inR",
          "lcAlt",
          "tdn",
          "ow",
          "jqAtL",
          "jqB",
          "lmd"
        ]
      }
    }
  ]
}
