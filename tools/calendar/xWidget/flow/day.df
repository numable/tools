        "value": "$[if::(ge::(${off},index::(${OF},12)),12,if::(ge::(${off},index::(${OF},11)),11,if::(ge::(${off},index::(${OF},10)),10,if::(ge::(${off},index::(${OF},9)),9,if::(ge::(${off},index::(${OF},8)),8,if::(ge::(${off},index::(${OF},7)),7,if::(ge::(${off},index::(${OF},6)),6,if::(ge::(${off},index::(${OF},5)),5,if::(ge::(${off},index::(${OF},4)),4,if::(ge::(${off},index::(${OF},3)),3,if::(ge::(${off},index::(${OF},2)),2,if::(ge::(${off},index::(${OF},1)),1,0))))))))))))]"
      },
