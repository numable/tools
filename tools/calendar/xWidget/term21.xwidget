{
  "_note": "节气(21)。零网络,数据全部来自包内的表(生成器 tools/infosource/calendar/gen.py,别手改)。",
  "version": 2,
  "title": "节气",
  "sub": "迷你 · 现在的节气、下一个几天后",
  "i18n": {
    "en-US": {
      "title": "Solar term",
      "sub": "Mini · current term and days to the next"
    }
  },
  "layout": 21,
  "params": {},
  "ai": {
    "shows": "现在所处的二十四节气，以及下一个节气是什么、还有几天（一行迷你）"
  },
  "events": {
    "onClick": "numable://self/page/terms"
  },
  "canvas": {
    "source": "@[file://rc/term21.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/day.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络组件唯一的刷新理由是跨天:at 00:00 准点翻页,interval 兜底系统没准点回调。",
      "at": [
        "00:00"
      ],
      "interval": [
        "3600"
      ]
    }
  },
  "jobs": [
    {
      "id": "term",
      "params": {}
    }
  ]
}
