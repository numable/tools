{
  "_note": "动态 banner。生成器 tools/banner/gen_dyn_banners.py(公共件 dynkit.py);规则见 Numable/doc/dynamic-banner-ui.html。取不到数时整张退回静态图(静态快照 tools/banner/static/)。",
  "version": 2,
  "id": "banner",
  "ratio": "16:9",
  "theme": "auto",
  "scene": {
    "width": 338,
    "height": 190,
    "corner": 18
  },
  "params": {},
  "canvas": {
    "source": "@[file://xWidget/rc/banner.rcn]",
    "depends": [
      {
        "flow": "@[file://xWidget/flow/day.df]",
        "params": {}
      },
      {
        "flow": "@[file://xWidget/flow/month.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络:唯一的刷新理由是跨天(与组件同)。",
      "at": [
        "00:00"
      ],
      "interval": [
        "3600"
      ]
    }
  }
}
