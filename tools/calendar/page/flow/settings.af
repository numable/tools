{
  "_note": "写设置(周首 / 黄历显隐)。月历、本周组件读 settings.ws → 必须 widget.refresh。",
  "version": 1,
  "actions": [
    {
      "_note": "写盘流的第一步恒是触觉反馈(G22)。",
      "action": "ui.haptic",
      "params": {
        "type": "tap"
      }
    },
    {
      "action": "data.set",
      "params": {
        "key": "settings",
        "value": "${settings}"
      }
    },
    {
      "_note": "月历 / 本周组件读 settings.ws,改完立刻真取数重渲(不是 reload)。",
      "action": "widget.refresh"
    }
  ]
}
