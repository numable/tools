{
  "_note": "写我的农历日子(整份列表,页面已预算好未来 12 次的公历日期)。农历日子组件与提醒读它 → widget.refresh。",
  "version": 1,
  "actions": [
    {
      "_note": "写盘流的第一步恒是触觉反馈(G22)。",
      "action": "ui.haptic",
      "params": {
        "type": "tap"
      }
    },
    {
      "action": "data.set",
      "params": {
        "key": "lunarDates",
        "value": "${list}"
      }
    },
    {
      "action": "widget.refresh"
    }
  ]
}
