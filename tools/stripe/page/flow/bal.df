{
  "_note": "页面用:余额原样取回(解析与首屏缓存在页面 JS 里做)。取不到 = 失败。",
  "_lintCache": "exempt",
  "version": 1,
  "actions": [
    {
      "id": "bal",
      "action": "request",
      "params": {
        "url": "https://api.stripe.com/v1/balance",
        "method": "GET",
        "formatType": "json",
        "timeout": "15000",
        "credential": "stripe",
        "header": {
          "User-Agent": "Numable/1.0",
          "Accept": "application/json"
        }
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_b",
        "value": "1"
      },
      "_note": "屏障(勿删):request / concurrent / credential.state 之后紧邻的节点读不到结果(老宿主晚一拍合并)。"
    },
    {
      "op": "set",
      "props": {
        "key": "_f",
        "value": "$[if::(eq::(findNotEmpty::(${bal.object},x),balance),0,1)]"
      }
    },
    {
      "op": "if",
      "props": {
        "val": "${_f}"
      },
      "items": [
        {
          "action": "error",
          "params": {
            "errorMsg": "stripe unavailable"
          }
        }
      ]
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "bal"
        ]
      }
    }
  ]
}
