{"version":1,"_note":"信息源页海报专用(tools/banner/dyn_personal.py 生成,不要手改),组件不用。","actions":[{"id":"_cs","action":"credential.state","params":{"id":"stripe"}},{"op":"set","props":{"key":"_bcs","value":"1"},"_note":"⚠️ 读取屏障(勿删):credential.state 之后紧邻的节点读不到结果。"},{"op":"set","props":{"key":"demo","value":"$[if::(eq::(${_cs.state},unbound),1,0)]"},"_note":"只认 unbound 画示例;expired / 绑了但被拒照旧走真请求 → 失败退回上次的图或静态图。"},{"op":"set","props":{"key":"live","value":"$[if::(eq::(${demo},1),0,1)]"}},{"op":"if","props":{"val":"${live}"},"items":[{"op":"set","props":{"key":"nowMs","value":"${@time.nowMs}"}},{"op":"set","props":{"key":"zh","value":"$[if::(startsWith::(${@app.language},zh),1,0)]"},"_note":"语言:文案在取数层按语言出(切语言 = 整盘重取,数据缓存含 locale)。没注入 @app 时按英文(overseas-first §2)。"},{"op":"set","props":{"key":"t0","value":"$[parseNumber::(calc::(parseDate::(formatDate::(${nowMs},yyyy-MM-dd),yyyy-MM-dd)/1000),0)]"}},{"action":"concurrent","items":[{"id":"bal","action":"request","params":{"url":"https://api.stripe.com/v1/balance","method":"GET","formatType":"json","timeout":"15000","header":{"User-Agent":"Numable/1.0","Accept":"application/json"},"credential":"stripe"}},{"id":"p1","action":"request","params":{"url":"https://api.stripe.com/v1/balance_transactions?created%5Bgte%5D=${t0}&limit=100","method":"GET","formatType":"json","timeout":"15000","header":{"User-Agent":"Numable/1.0","Accept":"application/json"},"credential":"stripe"}}]},{"op":"set","props":{"key":"_b","value":"1"},"_note":"⚠️ 请求屏障(勿删):request 之后紧邻的节点读不到响应(晚一拍合并)。"},{"op":"set","props":{"key":"_fail","value":"$[if::(and::(eq::(findNotEmpty::(${bal.object},x),balance),eq::(findNotEmpty::(${p1.object},x),list)),0,1)]"}},{"op":"if","props":{"val":"${_fail}"},"items":[{"action":"error","params":{"errorMsg":"stripe unavailable"}}]},{"op":"set","props":{"key":"_SYM","value":{"usd":"$","eur":"€","gbp":"£","jpy":"¥","cny":"¥","krw":"₩","inr":"₹","hkd":"HK$","twd":"NT$","aud":"A$","cad":"CA$","nzd":"NZ$","sgd":"S$","mxn":"MX$","brl":"R$","ils":"₪","php":"₱","thb":"฿","vnd":"₫","try":"₺","pln":"zł ","uah":"₴"}},"_note":"币种符号表(只收写成符号不歧义的;其余写 ISO 代码)。"},{"op":"set","props":{"key":"_DEC","value":{"bif":"0","clp":"0","djf":"0","gnf":"0","jpy":"0","kmf":"0","krw":"0","mga":"0","pyg":"0","rwf":"0","ugx":"0","vnd":"0","vuv":"0","xaf":"0","xof":"0","xpf":"0","bhd":"3","jod":"3","kwd":"3","omr":"3","tnd":"3"}},"_note":"Stripe 零小数位 / 三位小数币种(其余 2 位)。"},{"op":"set","props":{"key":"cur","value":"$[toLowerCase::(findNotEmpty::(${bal.available[0].currency},usd))]"}},{"op":"set","props":{"key":"curU","value":"$[toUpperCase::(${cur})]"}},{"op":"set","props":{"key":"curS","value":"${curU} "},"_note":"没有符号的币种写大写代码 + 不换行空格(模板拼,不经方法 —— 方法参数两端的空白会被吃掉)。"},{"op":"set","props":{"key":"curY","value":"$[findNotEmpty::(get::(${_SYM},${cur}),)]"}},{"op":"if","props":{"val":"$[if::(eq::(findNotEmpty::(${curY},__none__),__none__),0,1)]"},"items":[{"op":"set","props":{"key":"curS","value":"${curY}"}}]},{"op":"set","props":{"key":"curD","value":"$[findNotEmpty::(get::(${_DEC},${cur}),2)]"}},{"op":"set","props":{"key":"curV","value":"$[if::(eq::(1,1),if::(eq::(${curD},0),1,if::(eq::(${curD},3),1000,100)),1)]"},"_note":"最小单位 → 主单位:Stripe 金额是最小单位(美分),零小数位币种(日元)本身就是主单位。"},{"op":"remove","props":{"key":"_SYM"}},{"op":"remove","props":{"key":"_DEC"}},{"op":"set","props":{"key":"KS","value":["currency","reporting_category"]}},{"op":"set","props":{"key":"ONE","value":{"balance_transaction":"1"}}},{"op":"set","props":{"key":"R","value":"$[mapField::(${p1.data},object,${ONE},one,0)]"}},{"op":"set","props":{"key":"g","value":"$[groupSum::(${R},${KS},amount)]"}},{"op":"set","props":{"key":"c","value":"$[groupSum::(${R},${KS},one)]"}},{"op":"set","props":{"key":"kCh","value":"$[connect::(${cur},.charge)]"}},{"op":"set","props":{"key":"gross","value":"$[findNotEmpty::(get::(${g},${kCh}),0)]"}},{"op":"set","props":{"key":"cnt","value":"$[parseNumber::(findNotEmpty::(get::(${c},${kCh}),0),#\\,##0)]"}},{"op":"set","props":{"key":"more","value":"$[if::(eq::(findNotEmpty::(${p1.has_more},false),true),+,)]"}},{"op":"set","props":{"key":"AV","value":"$[groupSum::(${bal.available},currency,amount)]"}},{"op":"set","props":{"key":"PD","value":"$[groupSum::(${bal.pending},currency,amount)]"}},{"op":"set","props":{"key":"bigTN","value":"$[calc::(findNotEmpty::(${gross},0)/${curV})]"}},{"op":"set","props":{"key":"bigTA","value":"$[if::(ge::(${bigTN},0),${bigTN},calc::(0-${bigTN}))]"}},{"op":"set","props":{"key":"bigTs","value":"$[if::(lt::(${bigTN},0),−,)]"}},{"op":"set","props":{"key":"bigTb","value":"$[if::(lt::(${bigTA},10000),if::(lt::(${bigTA},1000),if::(eq::(${curD},0),parseNumber::(${bigTA},#\\,##0),if::(eq::(${curD},3),parseNumber::(${bigTA},#\\,##0.000),parseNumber::(${bigTA},#\\,##0.00))),parseNumber::(${bigTA},#\\,##0)),if::(eq::(${zh},1),if::(ge::(${bigTA},100000000),connect::(parseNumber::(calc::(${bigTA}/100000000),0.##), 亿),connect::(parseNumber::(calc::(${bigTA}/10000),0.##), 万)),if::(ge::(${bigTA},1000000000),connect::(parseNumber::(calc::(${bigTA}/1000000000),0.##),B),if::(ge::(${bigTA},1000000),connect::(parseNumber::(calc::(${bigTA}/1000000),0.##),M),connect::(parseNumber::(calc::(${bigTA}/1000),0.#),K)))))]"}},{"op":"set","props":{"key":"bigT","value":"${bigTs}${curS}${bigTb}"},"_note":"⚠️ 拼接用模板、不用 connect::——connect 会吃掉每段两端的空白(含不换行空格),「CHF 12.00」会变成「CHF12.00」。"},{"op":"set","props":{"key":"bigTZ","value":"$[if::(eq::(${bigTA},0),1,0)]"}},{"op":"remove","props":{"key":"bigTA"}},{"op":"remove","props":{"key":"bigTs"}},{"op":"remove","props":{"key":"bigTb"}},{"op":"set","props":{"key":"avTN","value":"$[calc::(findNotEmpty::(findNotEmpty::(get::(${AV},${cur}),0),0)/${curV})]"}},{"op":"set","props":{"key":"avTA","value":"$[if::(ge::(${avTN},0),${avTN},calc::(0-${avTN}))]"}},{"op":"set","props":{"key":"avTs","value":"$[if::(lt::(${avTN},0),−,)]"}},{"op":"set","props":{"key":"avTb","value":"$[if::(lt::(${avTA},10000),if::(lt::(${avTA},1000),if::(eq::(${curD},0),parseNumber::(${avTA},#\\,##0),if::(eq::(${curD},