{
  "_note": "今日收入(22):收款金额(≥1 万压成万 / K)+ 笔数 + 退款与净入账。按设备时区的今天。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "id": "bg"
      },
      {
        "type": "layer",
        "x": "12pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#635BFF|#9B95FF",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot"
      },
      {
        "type": "txt",
        "x": "21pt",
        "y": "11pt",
        "w": "{parent.w}-79pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "txt",
        "x": "{parent.w}-68pt",
        "y": "14pt",
        "w": "56pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "id": "at"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${grossT},__none__),__none__),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "42pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "--",
            "fontSize": "26pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${grossT},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "38pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${grossT}",
            "fontSize": "26pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "72pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${cntT},--)]",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "108pt",
        "w": "64pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${refTX},--)]",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "125.0pt",
        "w": "64pt",
        "h": "-1",
        "text": "${@i18n.k1}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "82pt",
        "y": "108pt",
        "w": "64pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${netTX},--)]",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "82pt",
        "y": "125.0pt",
        "w": "64pt",
        "h": "-1",
        "text": "${@i18n.k2}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      }
    ],
    "i18n": {
      "zh-CN": {
        "brand": "今日收入",
        "k1": "退款",
        "k2": "净入账"
      },
      "en-US": {
        "brand": "Today",
        "k1": "Refunds",
        "k2": "Net"
      }
    }
  }
}
