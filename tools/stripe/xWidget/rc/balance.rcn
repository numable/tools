{
  "_note": "余额(22):可用余额大字 + 币种(多币种时说另有几种)+ 待入账。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "id": "bg"
      },
      {
        "type": "layer",
        "x": "12pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#635BFF|#9B95FF",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot"
      },
      {
        "type": "txt",
        "x": "21pt",
        "y": "11pt",
        "w": "{parent.w}-79pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "txt",
        "x": "{parent.w}-68pt",
        "y": "14pt",
        "w": "56pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "id": "at"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${avT},__none__),__none__),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "42pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "--",
            "fontSize": "26pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${avT},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "38pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${avT}",
            "fontSize": "26pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "72pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${avL},--)]",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "108pt",
        "w": "134pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${pdT},--)]",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "125.0pt",
        "w": "134pt",
        "h": "-1",
        "text": "${@i18n.pd}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      }
    ],
    "i18n": {
      "zh-CN": {
        "brand": "Stripe 余额",
        "pd": "待入账 · 尚不可提现"
      },
      "en-US": {
        "brand": "Balance",
        "pd": "Pending · not yet available"
      }
    }
  }
}
