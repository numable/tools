{
  "_note": "今日收入(21,card-design-system §8.1):收款金额 + 笔数,右侧净入账。与 22 档同一条 rev.df(mode=today)。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "id": "bg"
      },
      {
        "type": "txt",
        "x": "19pt",
        "y": "9pt",
        "w": "84pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "11pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "layer",
        "x": "10pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#635BFF|#9B95FF",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot"
      },
      {
        "type": "txt",
        "x": "104pt",
        "y": "10.5pt",
        "w": "44pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "id": "at"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${grossT},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "10pt",
            "y": "25pt",
            "w": "92pt",
            "h": "-1",
            "text": "${grossT}",
            "fontSize": "17pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${grossT},__none__),__none__),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "10pt",
            "y": "26pt",
            "w": "70pt",
            "h": "-1",
            "text": "--",
            "fontSize": "17pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "txt",
        "x": "10pt",
        "y": "45pt",
        "w": "92pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${cntT},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "100pt",
        "y": "28pt",
        "w": "48pt",
        "h": "-1",
        "text": "${@i18n.net}",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2"
      },
      {
        "type": "txt",
        "x": "92pt",
        "y": "41pt",
        "w": "56pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${netTX},--)]",
        "fontSize": "10pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "alignmentH": "2"
      }
    ],
    "i18n": {
      "zh-CN": {
        "brand": "今日收入",
        "net": "净入账"
      },
      "en-US": {
        "brand": "Today",
        "net": "Net"
      }
    }
  }
}
