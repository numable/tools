{
  "_note": "近 30 天(42):左收款与日均,右净入账 / 退款 / 争议(有争议时琥珀色)。翻页到上限时底行说只统计了最近 N 笔。",
  "rc": {
    "cells": [
      {
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A",
        "id": "bg"
      },
      {
        "type": "layer",
        "x": "14pt",
        "y": "{brand.y}+({brand.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "#635BFF|#9B95FF",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "id": "srcdot"
      },
      {
        "type": "txt",
        "x": "23pt",
        "y": "12pt",
        "w": "{parent.w}-83pt",
        "h": "-1",
        "text": "${@i18n.brand}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "id": "brand"
      },
      {
        "type": "txt",
        "x": "{parent.w}-70pt",
        "y": "15pt",
        "w": "56pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},--)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0",
        "alignmentH": "2",
        "id": "at"
      },
      {
        "type": "txt",
        "x": "14pt",
        "y": "36pt",
        "w": "150pt",
        "h": "-1",
        "text": "${@i18n.gross}",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(findNotEmpty::(${grossT},__none__),__none__),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "14pt",
            "y": "50pt",
            "w": "{parent.w}-28pt",
            "h": "-1",
            "text": "--",
            "fontSize": "24pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${grossT},__none__),__none__),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "14pt",
            "y": "50pt",
            "w": "160pt",
            "h": "-1",
            "text": "${grossT}",
            "fontSize": "24pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold",
            "lineBreak": "0"
          }
        ]
      },
      {
        "type": "txt",
        "x": "14pt",
        "y": "82pt",
        "w": "160pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${cntT},--)]",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "14pt",
        "y": "112pt",
        "w": "150pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${avgT},--)]",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "14pt",
        "y": "129.0pt",
        "w": "150pt",
        "h": "-1",
        "text": "${@i18n.avg}",
        "fontSize": "9.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "184pt",
        "y": "39pt",
        "w": "84pt",
        "h": "-1",
        "text": "${@i18n.net}",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "{parent.w}-84pt",
        "y": "38pt",
        "w": "70pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${netT},--)]",
        "fontSize": "11.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "alignmentH": "2"
      },
      {
        "type": "layer",
        "x": "184pt",
        "y": "58pt",
        "w": "{parent.w}-198pt",
        "h": "1pt",
        "bgColor": "#E4E7EC|#262A31"
      },
      {
        "type": "txt",
        "x": "184pt",
        "y": "67pt",
        "w": "84pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${rlab},${@i18n.ref})]",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "{parent.w}-84pt",
        "y": "66pt",
        "w": "70pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${refT},--)]",
        "fontSize": "11.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "alignmentH": "2"
      },
      {
        "type": "layer",
        "x": "184pt",
        "y": "86pt",
        "w": "{parent.w}-198pt",
        "h": "1pt",
        "bgColor": "#E4E7EC|#262A31"
      },
      {
        "type": "txt",
        "x": "184pt",
        "y": "95pt",
        "w": "84pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${dlab},${@i18n.dsp})]",
        "fontSize": "10.5pt",
        "textColor": "$[if::(eq::(findNotEmpty::(${dw},0),1),#B45309|#F5B454,#0E1116|#F3F4F6)]",
        "maxLines": "1",
        "lineBreak": "0"
      },
      {
        "type": "txt",
        "x": "{parent.w}-84pt",
        "y": "94pt",
        "w": "70pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${dispT},--)]",
        "fontSize": "11.5pt",
        "textColor": "$[if::(eq::(findNotEmpty::(${dw},0),1),#B45309|#F5B454,#0E1116|#F3F4F6)]",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "alignmentH": "2"
      },
      {
        "type": "txt",
        "x": "184pt",
        "y": "126pt",
        "w": "{parent.w}-198pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${noteT},)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
      }
    ],
    "i18n": {
      "zh-CN": {
        "brand": "近 30 天",
        "gross": "收款",
        "avg": "日均收款",
        "net": "净入账",
        "ref": "退款",
        "dsp": "争议"
      },
      "en-US": {
        "brand": "Last 30 days",
        "gross": "Payments",
        "avg": "Daily average",
        "net": "Net",
        "ref": "Refunds",
        "dsp": "Disputes"
      }
    }
  }
}
