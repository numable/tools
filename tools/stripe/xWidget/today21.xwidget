{
  "_note": "今日收入(21):与 22 档同一条 rev.df。",
  "version": 2,
  "title": "今日收入 · 迷你",
  "sub": "收款与净入账",
  "i18n": {
    "en-US": {
      "title": "Today · mini",
      "sub": "Payments and net"
    }
  },
  "layout": 21,
  "params": {},
  "ai": {
    "shows": "Stripe 账户今天的收款金额、笔数与净入账(迷你尺寸)"
  },
  "events": {
    "onClick": "numable://self"
  },
