{
  "_note": "今日收入(22):十分钟一刷(流水实时;失败短退避由引擎管)。",
  "version": 2,
  "title": "今日收入",
  "sub": "今天的收款、退款与净入账",
  "i18n": {
    "en-US": {
      "title": "Today",
      "sub": "Today's payments, refunds and net"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "Stripe 账户今天(按设备时区)的收款金额与笔数、退款金额和净入账"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/today.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/rev.df]",
        "params": {
          "mode": "today"
        }
      }
    ],
    "refresh": {
      "interval": [
        "600"
      ]
    }
  }
}
