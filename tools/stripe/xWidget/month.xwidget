{
  "_note": "本月收入(22):半小时一刷。",
  "version": 2,
  "title": "本月收入",
  "sub": "本月的收款、净入账与手续费",
  "i18n": {
    "en-US": {
      "title": "This month",
      "sub": "Month-to-date payments, net and fees"
    }
  },
  "layout": 22,
  "params": {},
  "ai": {
    "shows": "Stripe 账户本月(1 日至今)的收款金额与笔数、净入账和 Stripe 手续费"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/month.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/rev.df]",
        "params": {
          "mode": "month"
        }
      }
    ],
    "refresh": {
      "interval": [
        "1800"
      ]
    }
  }
}
