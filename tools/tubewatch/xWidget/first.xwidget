{
  "version": 2,
  "title": "新片首日",
  "sub": "某个频道最新一条发布后 24 小时的播放曲线",
  "i18n": {
    "en-US": {
      "title": "First day",
      "sub": "One channel's newest video over its first 24 hours"
    }
  },
  "layout": 22,
  "_note": "v52:点是这台设备取到数的那些时刻(组件刷新 / 打开 App);灰线是上一条同样记到的曲线,用来比「同期」。",
  "params": {
    "cid": ""
  },
  "events": {
    "onClick": "/channel?cid=${cid}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/first.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/channel.df]",
        "params": {
          "cid": "${cid}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "某个频道最新一条视频发布后 24 小时的播放曲线,与上一条同期对比",
    "params": {
      "cid": {
        "kind": "value",
        "format": "YouTube 频道 ID:UC 开头共 24 位(不是 @用户名,也不是频道网址)",
        "hint": "留空 = 用户关注列表里的第一个频道;不确知频道 ID 就留空,别猜",
        "examples": [
          "UCX6OQ3DkcsbYNE6H8uQQuVA",
          "UCBJycsmduvYEL83R_U4JriQ",
          "UCsXVk37bltHxD1rDPwtNM8Q"
        ]
      }
    }
  }
}
