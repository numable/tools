{
  "version": 2,
  "title": "频道概况",
  "sub": "订阅数 · 总播放 · 更新量",
  "i18n": { "en-US": { "title": "Channel overview", "sub": "Subscribers, total views, output" } },
  "layout": 42,
  "params": { "cid": "" },
  "_note": "混合档:绑了密钥显示订阅数/总播放三格,没绑则**换一套** RSS 自己算得出的两格(近 15 条 / Shorts 占比)——不是三格里空着两格(§3.11 第 3 条)。",
  "events": { "onClick": "/channel?cid=${cid}", "onEdit": "/edit", "_note": "单对象卡点击带对象参数进详情页(2026-08-27 深链评审第二批)。参数名抄自本包首页同路由跳转串;cid 为空时详情页渲 p-unbound 兜底(同日新增),不再是死页。" },
  "canvas": {
    "source": "@[file://rc/channel.rcn]",
    "depends": [ { "flow": "@[file://flow/channel.df]", "params": { "cid": "${cid}" } } ],
    "refresh": { "interval": ["300"] }
  },
  "ai": {
    "shows": "某个频道的订阅数、总播放与平均发片间隔;没绑 YouTube API 密钥时改显示近 15 条与 Shorts 占比",
    "params": {
      "cid": {
        "kind": "value",
        "format": "YouTube 频道 ID:UC 开头共 24 位(不是 @用户名,也不是频道网址)",
        "hint": "留空 = 用户关注列表里的第一个频道;不确知频道 ID 就留空,别猜",
        "examples": [
          "UCX6OQ3DkcsbYNE6H8uQQuVA",
          "UCBJycsmduvYEL83R_U4JriQ",
          "UCsXVk37bltHxD1rDPwtNM8Q"
        ]
      }
    }
  }
}
