{
  "version": 2,
  "title": "新片赛跑",
  "sub": "某个频道最新一条跑得怎么样",
  "i18n": {
    "en-US": {
      "title": "New video race",
      "sub": "How one channel's newest video is doing"
    }
  },
  "layout": 42,
  "_note": "v48 起由「最新视频」升级而来:**id 刻意沿用 latest**,存量用户盘上那张原地换成新画法,不掉卡。",
  "params": {
    "cid": ""
  },
  "events": {
    "onClick": "/channel?cid=${cid}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/latest.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/channel.df]",
        "params": {
          "cid": "${cid}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "某个频道最新一条视频跑得怎样:每小时播放、点赞率、达到近作中位数的几成",
    "params": {
      "cid": {
        "kind": "value",
        "format": "YouTube 频道 ID:UC 开头共 24 位(不是 @用户名,也不是频道网址)",
        "hint": "留空 = 用户关注列表里的第一个频道;不确知频道 ID 就留空,别猜",
        "examples": [
          "UCX6OQ3DkcsbYNE6H8uQQuVA",
          "UCBJycsmduvYEL83R_U4JriQ",
          "UCsXVk37bltHxD1rDPwtNM8Q"
        ]
      }
    }
  }
}
