{
  "version": 2,
  "title": "新片速度",
  "sub": "最新一条每小时的播放",
  "i18n": {
    "en-US": {
      "title": "Views per hour",
      "sub": "Hourly views of one channel's newest video"
    }
  },
  "layout": 22,
  "_note": "v48 起由「频道脉搏」升级而来:**id 刻意沿用 pulse**,理由同 latest。",
  "params": {
    "cid": ""
  },
  "events": {
    "onClick": "/channel?cid=${cid}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/pulse.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/channel.df]",
        "params": {
          "cid": "${cid}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "某个频道最新一条视频每小时的播放量",
    "params": {
      "cid": {
        "kind": "value",
        "format": "YouTube 频道 ID:UC 开头共 24 位(不是 @用户名,也不是频道网址)",
        "hint": "留空 = 用户关注列表里的第一个频道;不确知频道 ID 就留空,别猜",
        "examples": [
          "UCX6OQ3DkcsbYNE6H8uQQuVA",
          "UCBJycsmduvYEL83R_U4JriQ",
          "UCsXVk37bltHxD1rDPwtNM8Q"
        ]
      }
    }
  }
}
