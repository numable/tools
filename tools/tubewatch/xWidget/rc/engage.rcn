 {"id":"bg","type":"layer","x":"0pt","y":"0pt","w":"{parent.w}","h":"{parent.h}","bgColor":"linear(#FFFFFF\\,#FEFBFB\\,#FDF3F3)@90|linear(#15171A\\,#1C191B\\,#2A1C1E)@90"},
