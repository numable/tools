 {"id":"rv","type":"arc","startAngle":"135","sweepAngle":"$[findNotEmpty::(${Y.egSw},0)]","strokeColor":"#CC0000|#FF4E45","x":"35pt","y":"36pt","w":"88pt","h":"88pt","useCenter":"0","lineWidth":"8pt","lineCap":"round"},
 {"id":"rk","type":"layer","x":"78pt","y":"32pt","w":"2pt","h":"14pt","bgColor":"#0E1116|#F3F4F6","cornerRadius":{"leftT":"1pt","leftB":"1pt","rightT":"1pt","rightB":"1pt"}},
