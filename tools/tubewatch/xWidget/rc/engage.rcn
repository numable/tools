 {"id":"foot","type":"txt","x":"12pt","y":"{parent.h}-{foot.h}-12pt","w":"134pt","h":"-1","maxLines":"1","text":"${@i18n.tickEq}$[if::(eq::(${sh0},1),${@i18n.refSh},${@i18n.refLg})] $[findNotEmpty::(${Y.lrRef},--)]%","fontSize":"9pt","textColor":"#6B7280|#8E939B"}
