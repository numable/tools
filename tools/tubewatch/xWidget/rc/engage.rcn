 {"id":"ch","type":"txt","x":"21pt","y":"11pt","w":"{at.x}-21pt-6pt","h":"-1","maxLines":"1","lineBreak":"0","text":"$[findNotEmpty::(${ch},--)]","fontSize":"13pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6","hide":"$[if::(gt::(length::(findNotEmpty::(${ch},)),0),0,1)]"},
