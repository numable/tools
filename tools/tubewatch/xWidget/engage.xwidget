{
  "version": 2,
  "title": "点赞率",
  "sub": "最新一条对比同类近作",
  "i18n": {
    "en-US": {
      "title": "Like rate",
      "sub": "Newest video vs. the channel's usual"
    }
  },
  "layout": 22,
  "_note": "点赞数来自 RSS 的 starRating count(匿名可得)。参照按类型分开:Shorts 比 Shorts、长视频比长视频。",
  "params": {
    "cid": ""
  },
  "events": {
    "onClick": "/channel?cid=${cid}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/engage.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/channel.df]",
        "params": {
          "cid": "${cid}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "某个频道最新一条视频的点赞率,与同类型近作对比",
    "params": {
      "cid": {
        "kind": "value",
        "format": "YouTube 频道 ID:UC 开头共 24 位(不是 @用户名,也不是频道网址)",
        "hint": "留空 = 用户关注列表里的第一个频道;不确知频道 ID 就留空,别猜",
        "examples": [
          "UCX6OQ3DkcsbYNE6H8uQQuVA",
          "UCBJycsmduvYEL83R_U4JriQ",
          "UCsXVk37bltHxD1rDPwtNM8Q"
        ]
      }
    }
  }
}
