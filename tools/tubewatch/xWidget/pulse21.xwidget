{
  "version": 2,
  "title": "新片速度 · 迷你",
  "sub": "最新一条每小时的播放 · 一行",
  "i18n": {
    "en-US": {
      "title": "Views per hour mini",
      "sub": "One line · hourly views of the newest video"
    }
  },
  "layout": 21,
  "_note": "21 档迷你版:与 22 档 pulse 回答同一个问题、读同一份 channel.df(X.vphK1 / X.pct1 / X.sp21)。",
  "params": {
    "cid": ""
  },
  "events": {
    "onClick": "/channel?cid=${cid}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/pulse21.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/channel.df]",
        "params": {
          "cid": "${cid}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "某个频道最新一条视频每小时的播放量(一行)",
    "params": {
      "cid": {
        "kind": "value",
        "format": "YouTube 频道 ID:UC 开头共 24 位(不是 @用户名,也不是频道网址)",
        "hint": "留空 = 用户关注列表里的第一个频道;不确知频道 ID 就留空,别猜",
        "examples": [
          "UCX6OQ3DkcsbYNE6H8uQQuVA",
          "UCBJycsmduvYEL83R_U4JriQ",
          "UCsXVk37bltHxD1rDPwtNM8Q"
        ]
      }
    }
  }
}
