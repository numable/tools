{
  "version": 2,
  "title": "日增榜",
  "sub": "关注的频道按昨天新增播放排名",
  "i18n": {
    "en-US": {
      "title": "Daily gains",
      "sub": "Your channels ranked by views gained yesterday"
    }
  },
  "layout": 44,
  "_note": "v52:与 board 共用 board.df,读排好序的 brdD。刚装上谁都还没有昨天那格时整榜退回本周序。",
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/rank.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/board.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "用户关注的频道按昨天新增播放量排名"
  }
}
