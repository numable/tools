{
  "version": 2,
  "title": "日增播放",
  "sub": "某个频道近 15 条视频每天新增多少播放",
  "i18n": {
    "en-US": {
      "title": "Daily views",
      "sub": "Daily views gained by one channel's latest 15 videos"
    }
  },
  "layout": 22,
  "_note": "P1 本地快照:数据是这台设备自己按天记的(YouTube 不给历史),装上当天是「从今天开始记录」,第二天起有数。",
  "params": {
    "cid": ""
  },
  "events": {
    "onClick": "/channel?cid=${cid}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/growth.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/channel.df]",
        "params": {
          "cid": "${cid}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "某个频道近 15 条视频每天新增多少播放(本机按天记录,装上次日起有数)",
    "params": {
      "cid": {
        "kind": "value",
        "format": "YouTube 频道 ID:UC 开头共 24 位(不是 @用户名,也不是频道网址)",
        "hint": "留空 = 用户关注列表里的第一个频道;不确知频道 ID 就留空,别猜",
        "examples": [
          "UCX6OQ3DkcsbYNE6H8uQQuVA",
          "UCBJycsmduvYEL83R_U4JriQ",
          "UCsXVk37bltHxD1rDPwtNM8Q"
        ]
      }
    }
  }
}
