{
  "version": 2,
  "title": "关注榜",
  "sub": "关注的频道按本周新片播放排名",
  "i18n": {
    "en-US": {
      "title": "Leaderboard",
      "sub": "Your channels ranked by this week's new-video views"
    }
  },
  "layout": 44,
  "_note": "无参数卡。与 overview 共用 board.df(同一条流、同一组参数)。",
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/board.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/board.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "用户关注的频道按本周新片播放量排名,带本周发片条数与日增"
  }
}
