{
  "version": 2,
  "title": "内容构成",
  "sub": "Shorts 与长视频各占多少",
  "i18n": {
    "en-US": {
      "title": "Content mix",
      "sub": "Shorts vs. long-form, by count and by views"
    }
  },
  "layout": 42,
  "params": {
    "cid": ""
  },
  "events": {
    "onClick": "/channel?cid=${cid}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/mix.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/channel.df]",
        "params": {
          "cid": "${cid}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "某个频道 Shorts 与长视频的条数占比和播放占比",
    "params": {
      "cid": {
        "kind": "value",
        "format": "YouTube 频道 ID:UC 开头共 24 位(不是 @用户名,也不是频道网址)",
        "hint": "留空 = 用户关注列表里的第一个频道;不确知频道 ID 就留空,别猜",
        "examples": [
          "UCX6OQ3DkcsbYNE6H8uQQuVA",
          "UCBJycsmduvYEL83R_U4JriQ",
          "UCsXVk37bltHxD1rDPwtNM8Q"
        ]
      }
    }
  }
}
