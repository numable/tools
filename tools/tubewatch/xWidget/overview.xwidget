{
  "version": 2,
  "title": "关注总览",
  "sub": "关注的频道本周新片合计播放",
  "i18n": {
    "en-US": {
      "title": "Following",
      "sub": "This week's new-video views across your channels"
    }
  },
  "layout": 22,
  "_note": "无参数卡:关注列表由 board.df 自己从 data.* 读。⚠️ 这是「新片热度」,不是频道增长(那要密钥 + 快照,P2)。",
  "params": {},
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/overview.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/board.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "用户关注的所有频道本周新片的合计播放量"
  }
}
