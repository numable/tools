{
  "version": 2,
  "title": "订阅数",
  "sub": "某个频道的订阅数",
  "i18n": {
    "en-US": {
      "title": "Subscribers",
      "sub": "One channel's subscriber count"
    }
  },
  "layout": 11,
  "_note": "11 档:订阅数来自 Data API(需密钥),读 channel.df 的 subs11 / vf11;没绑密钥时值位 `--`。参数 / 事件同 channel.xwidget。",
  "params": {
    "cid": ""
  },
  "events": {
    "onClick": "/channel?cid=${cid}",
    "onEdit": "/edit"
  },
  "canvas": {
    "source": "@[file://rc/channel11.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/channel.df]",
        "params": {
          "cid": "${cid}"
        }
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  },
  "ai": {
    "shows": "某个频道的订阅数(一格小号;需绑 YouTube API 密钥,否则显示 --)",
    "params": {
      "cid": {
        "kind": "value",
        "format": "YouTube 频道 ID:UC 开头共 24 位(不是 @用户名,也不是频道网址)",
        "hint": "留空 = 用户关注列表里的第一个频道;不确知频道 ID 就留空,别猜",
        "examples": [
          "UCX6OQ3DkcsbYNE6H8uQQuVA",
          "UCBJycsmduvYEL83R_U4JriQ",
          "UCsXVk37bltHxD1rDPwtNM8Q"
        ]
      }
    }
  }
}
