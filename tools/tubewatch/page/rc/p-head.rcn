 {"id":"s","type":"txt","x":"0pt","y":"{t.b}+4pt","w":"{parent.w}-112pt","h":"-1","maxLines":"1","text":"$[findNotEmpty::(${total},0)] ${@i18n.chans}","fontSize":"12.5pt","textColor":"#6B7280|#8E939B","hide":"$[if::(eq::(${cst},1),1,if::(eq::(${cst},2),1,0))]"},
