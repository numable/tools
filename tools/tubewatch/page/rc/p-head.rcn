 {"id":"stn","type":"txt","x":"0pt","y":"{t.b}+4pt","w":"{parent.w}-112pt","h":"-1","maxLines":"1","text":"${@i18n.noneToday}","fontSize":"12.5pt","textColor":"#6B7280|#8E939B","hide":"$[if::(eq::(${cst},2),0,1)]"}
