  "rc": {
    "cells": [
 {"id":"dv","type":"layer","x":"104pt","y":"0pt","w":"{parent.w}-116pt","h":"0.5pt","bgColor":"#E4E7EC|#262A31","hide":"$[if::(eq::(${i},0),1,0)]"},
 {"id":"th","type":"img","x":"12pt","y":"23.5pt","w":"80pt","h":"45pt","cornerRadius":{"leftT":"8pt","leftB":"8pt","rightT":"8pt","rightB":"8pt"},"bgColor":"#E7E9EE|#20232A","scaleType":"centerCrop","url":"https://i.ytimg.com/vi/${vid}/mqdefault.jpg"},
 {"id":"thS","type":"txt","x":"{th.r}-{thS.w}-4pt","y":"{th.b}-{thS.h}-4pt","w":"-1","h":"-1","maxLines":"1","text":"▷","fontSize":"8.5pt","typeface":"System-Bold","textColor":"#FFFFFF|#FFFFFF","bgColor":"#9E000000|#9E000000","cornerRadius":{"leftT":"4pt","leftB":"4pt","rightT":"4pt","rightB":"4pt"},"paddingLeft":"4pt","paddingRight":"4pt","paddingTop":"1pt","paddingBottom":"1pt","hide":"$[if::(eq::(${sh},1),0,1)]"},
 {"id":"ti","type":"txt","x":"104pt","y":"18pt","w":"{parent.w}-116pt","h":"-1","maxLines":"2","lineBreak":"1","text":"$[findNotEmpty::(${t},--)]","fontSize":"12.5pt","textColor":"#0E1116|#F3F4F6"},
 {"id":"sb","type":"txt","x":"104pt","y":"{ti.b}+4pt","w":"-1","h":"-1","maxLines":"1","text":"$[if::(eq::(${td},1),${@i18n.today},if::(eq::(${dd},1),${@i18n.yesterday},if::(le::(${dd},7),connect::(${dd},${@i18n.daysAgo}),${dt})))] · $[findNotEmpty::(${vw},--)]${@i18n.views}","fontSize":"10.5pt","textColor":"#6B7280|#8E939B"},
 {"id":"tagT","type":"txt","x":"{sb.r}+8pt","y":"{ti.b}+3pt","w":"-1","h":"-1","maxLines":"1","text":"${@i18n.topTag}","fontSize":"9.5pt","typeface":"System-Bold","textColor":"#CC0000|#FF4E45","bgColor":"#1ACC0000|#24FF4E45","cornerRadius":{"leftT":"5pt","leftB":"5pt","rightT":"5pt","rightB":"5pt"},"paddingLeft":"5pt","paddingRight":"5pt","paddingTop":"1.5pt","paddingBottom":"1.5pt","hide":"$[if::(eq::(${c},2),0,2)]"},
 {"id":"mx","type":"txt","x":"104pt","y":"{sb.b}+5pt","w":"{parent.w}-116pt","h":"-1","maxLines":"1","text":"$[findNotEmpty::(${vph},--)]${@i18n.perHr} · ${@i18n.lrLbl} $[findNotEmpty::(${lr},--)]% · $[findNotEmpty::(${xs},--)]×","fontSize":"10.5pt","textColor":"#0E1116|#F3F4F6"}
    ],
