{
  "rc": {
    "cells": [
 {"id":"th","type":"img","x":"0pt","y":"0pt","w":"{parent.w}","h":"${thH}pt","cornerRadius":{"leftT":"8pt","leftB":"8pt","rightT":"8pt","rightB":"8pt"},"bgColor":"#E7E9EE|#20232A","scaleType":"centerCrop","url":"https://i.ytimg.com/vi/${vid}/mqdefault.jpg"},
 {"id":"thS","type":"txt","x":"{th.r}-{thS.w}-4pt","y":"{th.b}-{thS.h}-4pt","w":"-1","h":"-1","maxLines":"1","text":"▷","fontSize":"8.5pt","typeface":"System-Bold","textColor":"#FFFFFF|#FFFFFF","bgColor":"#9E000000|#9E000000","cornerRadius":{"leftT":"4pt","leftB":"4pt","rightT":"4pt","rightB":"4pt"},"paddingLeft":"4pt","paddingRight":"4pt","paddingTop":"1pt","paddingBottom":"1pt","hide":"$[if::(eq::(${sh},1),0,1)]"},
 {"id":"ti","type":"txt","x":"0pt","y":"{th.b}+5pt","w":"{parent.w}","h":"-1","maxLines":"2","lineBreak":"1","text":"$[findNotEmpty::(${t},--)]","fontSize":"10.5pt","textColor":"#0E1116|#F3F4F6"},
 {"id":"mt","type":"txt","x":"0pt","y":"{th.b}+38pt","w":"{parent.w}","h":"-1","maxLines":"1","text":"$[if::(eq::(${td},1),${@i18n.today},if::(eq::(${dd},1),${@i18n.yesterday},if::(le::(${dd},7),connect::(${dd},${@i18n.daysAgo}),${dt})))] · $[findNotEmpty::(${vw},--)]${@i18n.views}","fontSize":"9.5pt","textColor":"#6B7280|#8E939B"}
    ],
    "i18n": {"zh-CN":{"today":"今天","yesterday":"昨天","daysAgo":" 天前","views":"次"},"en-US":{"today":"Today","yesterday":"Yesterday","daysAgo":"d ago","views":" views"}}
  }
}
