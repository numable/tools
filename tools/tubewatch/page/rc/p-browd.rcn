{
  "rc": {
    "cells": [
 {"id":"dv","type":"layer","x":"12pt","y":"0pt","w":"{parent.w}-24pt","h":"0.5pt","bgColor":"#E4E7EC|#262A31","hide":"$[if::(eq::(${i},0),1,0)]"},
 {"id":"rk","type":"txt","x":"10pt","y":"24pt","w":"16pt","h":"-1","maxLines":"1","alignmentH":"1","text":"$[calc::(${i}+1)]","fontSize":"13pt","typeface":"System-Bold","textColor":"$[if::(eq::(${i},0),#EF3B33,#8E939B)]"},
 {"id":"avBg","type":"layer","x":"32pt","y":"14pt","w":"30pt","h":"30pt","bgColor":"#E7E9EE|#20232A","cornerRadius":{"leftT":"15pt","leftB":"15pt","rightT":"15pt","rightB":"15pt"}},
 {"id":"avIni","type":"txt","x":"32pt","y":"14pt","w":"30pt","h":"30pt","alignmentH":"1","alignmentV":"1","maxLines":"1","text":"$[subString::(${ch},0,1)]","fontSize":"12pt","typeface":"System-Bold","textColor":"#6B7280|#8E939B","hide":"$[if::(gt::(length::(${av}),0),1,0)]"},
 {"id":"avImg","type":"img","x":"32pt","y":"14pt","w":"30pt","h":"30pt","cornerRadius":{"leftT":"15pt","leftB":"15pt","rightT":"15pt","rightB":"15pt"},"scaleType":"centerCrop","url":"${av}","hide":"$[if::(gt::(length::(${av}),0),0,1)]"},
 {"id":"nm","type":"txt","x":"72pt","y":"17pt","w":"{parent.w}-220pt","h":"-1","maxLines":"1","lineBreak":"0","text":"$[findNotEmpty::(${ch},--)]","fontSize":"12.5pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6"},
 {"id":"ns","type":"txt","x":"72pt","y":"{nm.b}+3pt","w":"{parent.w}-220pt","h":"-1","maxLines":"1","text":"${@i18n.bdN1}$[findNotEmpty::(${wn},0)]${@i18n.bdN2} · $[findNotEmpty::(${wv},0)]","fontSize":"10pt","textColor":"#6B7280|#8E939B"},
 {"id":"v","type":"txt","x":"{parent.w}-{v.w}-12pt","y":"17pt","w":"-1","h":"-1","maxLines":"1","text":"$[if::(gt::(length::(findNotEmpty::(${dg},)),0),connect::(+,${dg}),--)]","fontSize":"14pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6"},
 {"id":"rt","type":"line","points":"[2,2,122,2]","x":"{parent.w}-136pt","y":"37pt","w":"124pt","h":"4pt","lineWidth":"4pt","lineCap":"round","strokeColor":"#E4E7EC|#262A31"},
 {"id":"rf","type":"line","points":"[2,2,$[if::(gt::(findNotEmpty::(${bp},0),4),calc::(${bp}-2),2)],2]","x":"{parent.w}-136pt","y":"37pt","w":"124pt","h":"4pt","lineWidth":"4pt","lineCap":"round","strokeColor":"#CC0000|#FF4E45","hide":"$[if::(gt::(findNotEmpty::(${bp},0),0),0,1)]"}
    ],
    "i18n": {"zh-CN":{"bdN1":"本周 ","bdN2":" 条"},"en-US":{"bdN1":"","bdN2":" new"}},
    "i18nEmptyOk": ["bdN1"]
  }
}
