{
  "rc": {
    "cells": [
 {"id":"avBg","type":"layer","x":"0pt","y":"1pt","w":"48pt","h":"48pt","bgColor":"#E7E9EE|#20232A","cornerRadius":{"leftT":"24pt","leftB":"24pt","rightT":"24pt","rightB":"24pt"}},
 {"id":"avIni","type":"txt","x":"0pt","y":"1pt","w":"48pt","h":"48pt","alignmentH":"1","alignmentV":"1","maxLines":"1","text":"$[subString::(${ch},0,1)]","fontSize":"18pt","typeface":"System-Bold","textColor":"#6B7280|#8E939B","hide":"$[if::(gt::(length::(${av}),0),1,0)]"},
 {"id":"avImg","type":"img","x":"0pt","y":"1pt","w":"48pt","h":"48pt","cornerRadius":{"leftT":"24pt","leftB":"24pt","rightT":"24pt","rightB":"24pt"},"scaleType":"centerCrop","url":"${av}","hide":"$[if::(gt::(length::(${av}),0),0,1)]"},
 {"id":"t","type":"txt","x":"60pt","y":"0pt","w":"{parent.w}-60pt","h":"-1","maxLines":"1","text":"$[findNotEmpty::(${ch},--)]","fontSize":"21pt","typeface":"System-Bold","textColor":"#0E1116|#F3F4F6"},
 {"id":"s","type":"txt","x":"60pt","y":"{t.b}+5pt","w":"{parent.w}-60pt","h":"-1","maxLines":"1","text":"${@i18n.updated} $[findNotEmpty::(${at},--)]","fontSize":"12pt","textColor":"#6B7280|#8E939B","hide":"$[if::(eq::(${apiOk},1),1,0)]"},
 {"id":"sk","type":"txt","x":"60pt","y":"{t.b}+5pt","w":"{parent.w}-60pt","h":"-1","maxLines":"1","text":"${@i18n.chSub} $[findNotEmpty::(${subs},--)] · ${@i18n.tvSub} $[findNotEmpty::(${tviews},--)] · ${@i18n.updated} $[findNotEmpty::(${at},--)]","fontSize":"12pt","textColor":"#6B7280|#8E939B","hide":"$[if::(eq::(${apiOk},1),0,1)]"}
    ],
    "i18n": {"zh-CN":{"updated":"更新于","chSub":"订阅","tvSub":"总播放"},"en-US":{"updated":"Updated","chSub":"Subs","tvSub":"Views"}}
  }
