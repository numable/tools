    {"type":"Canvas","id":"chRace","h":"124pt","canvas":{"source":"@[file://page/rc/p-ch-race.rcn]"}},
    {"type":"Canvas","id":"secShape","h":"26pt","canvas":{"source":"@[file://page/rc/p-sec-shape.rcn]"}},
