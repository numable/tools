  "root": {"type":"container","id":"root","title":"${ch}","paddingTop":"${@contentInset.top}pt","paddingBottom":"${@contentInset.bottom}pt","layout":"list","direction":"vertical","gap":"12pt","padding":"16pt","depends":[{"flow":"@[file://xWidget/flow/channel.df]","params":{"cid":"${cid}","_cache":"1","w":"${@window.width}"}}],"events":{"onLoad":{"flow":"@[file://page/flow/revalidate.af]","params":{"stale":"${_stale}","ckey":"${ckey}"}},"onRefresh":"@[file://page/flow/channel-refresh.af]"},"items":[
