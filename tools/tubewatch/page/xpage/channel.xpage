    {"type":"Canvas","id":"secAll","h":"26pt","canvas":{"source":"@[file://page/rc/p-sec-all.rcn]"}},
    {"type":"container","id":"vgroup","layout":"stack","h":"${listH}pt","items":[
     {"type":"Canvas","id":"vbg","align":"fill","h":"${listH}pt","canvas":{"source":"@[file://page/rc/p-group-bg.rcn]"}},
