{
  "_note": "读关注列表。页面首屏与 /edit 选择页共用。",
  "version": 1,
  "actions": [
    { "id": "chans", "action": "data.get", "params": { "key": "tw_chans", "default": [] } },
    { "op": "set", "props": { "key": "list", "value": "${chans}" } },
    { "op": "set", "props": { "key": "n", "value": "$[length::(${chans})]" } },
    { "action": "resultFilter", "params": { "keys": ["list", "n"] } }
  ]
}
