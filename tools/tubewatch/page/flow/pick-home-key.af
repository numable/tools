{
  "_note": "首页加卡(已绑 key 档):多列一张直播哨。",
  "version": 1,
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "op": "set",
      "props": {
        "key": "picks",
        "value": [
          {
            "id": "feed"
          },
          {
            "id": "board"
          },
          {
            "id": "rank"
          },
          {
            "id": "overview"
          },
          {
            "id": "live"
          }
        ]
      }
    },
    {
      "action": "widget.pick",
      "params": {
        "items": "${picks}"
      }
    }
  ]
}
