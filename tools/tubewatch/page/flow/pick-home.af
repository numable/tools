{
  "_note": "首页加卡:只列**不需要先指定对象**的卡。没绑 key 时直播哨不进候选 —— 加一张永远显示「请绑定密钥」的卡对用户没有意义(§3.11 第 3 条 / G12)。",
  "version": 1,
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "op": "set",
      "props": {
        "key": "picks",
        "value": [
          {
            "id": "feed"
          },
          {
            "id": "board"
          },
          {
            "id": "rank"
          },
          {
            "id": "overview"
          }
        ]
      }
    },
    {
      "action": "widget.pick",
      "params": {
        "items": "${picks}"
      }
    }
  ]
}
