{
  "_note": "频道详情页加卡:三张卡**各带这个频道的 cid**。\n⚠️ per-item params 不是可有可无 —— 一份共享 override 只能喂给「当前那一张」,用户在面板里翻到第二张再加,加出来的就是一张没有参数的空卡。\n⚠️ `${cid}` 来自节点 events 的 params(页面 ambient scope 里的路由 query)。",
  "version": 1,
  "actions": [
    {
      "action": "ui.haptic"
    },
    {
      "op": "set",
      "props": {
        "key": "picks",
        "value": [
          {
            "id": "latest",
            "params": {
              "cid": "${cid}"
            }
          },
          {
            "id": "pulse",
            "params": {
              "cid": "${cid}"
            }
          },
          {
            "id": "growth",
            "params": {
              "cid": "${cid}"
            }
          },
          {
            "id": "first",
            "params": {
              "cid": "${cid}"
            }
          },
          {
            "id": "engage",
            "params": {
              "cid": "${cid}"
            }
          },
          {
            "id": "cadence",
            "params": {
              "cid": "${cid}"
            }
          },
          {
            "id": "mix",
            "params": {
              "cid": "${cid}"
            }
          },
          {
            "id": "shape",
            "params": {
              "cid": "${cid}"
            }
          },
          {
            "id": "channel",
            "params": {
              "cid": "${cid}"
            }
          }
        ]
      }
    },
    {
      "action": "widget.pick",
      "params": {
        "items": "${picks}"
      }
    }
  ]
}
