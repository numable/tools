{
 "_note": "这台手机的服务器通知是否开着(入参 id = 页面在本机存的随机编号)。",
 "version": 1,
 "actions": [
  {
   "id": "resp",
   "action": "request",
   "params": {
    "url": "https://usage.numable.app/live/notify?id=${id}",
    "method": "GET",
    "formatType": "json",
    "header": {
     "User-Agent": "Numable"
    },
    "credential": "nu"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "r",
    "value": "${resp}"
   }
  },
  {
   "action": "resultFilter",
   "params": {
    "keys": [
     "r"
    ]
   }
  }
 ]
}
