{
 "_note": "服务器通知登记 / 取消(doc/push-relay.md §4)。页面先经 xbridge.pushGrant 拿到通知中继发的凭据,再把 {id, on, handle, perm, long, wait, done, stuck, lang} 整段(JSON 串,入参 body)交给 usage 服务;读令牌由凭证注入(页面拿不到令牌)。",
 "version": 1,
 "actions": [
  {
   "id": "resp",
   "action": "request",
   "params": {
    "url": "https://usage.numable.app/live/notify",
    "method": "POST",
    "formatType": "json",
    "header": {
     "Content-Type": "application/json",
     "User-Agent": "Numable"
    },
    "body": "${body}",
    "credential": "nu"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "r",
    "value": "${resp}"
   }
  },
  {
   "action": "resultFilter",
   "params": {
    "keys": [
     "r"
    ]
   }
  }
 ]
}
