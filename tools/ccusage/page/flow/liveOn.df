{
 "_note": "手机请求「在电脑上打开实时会话」(doc/ccusage-live-timeline.md §10)。读令牌由凭证注入;服务端只记一个时刻,电脑下一次采集时取走,插件 0.10.0+ 据此打开实时会话 + 同步(只开匿名那一档)。返回 {ok, at}。",
 "version": 1,
 "actions": [
  {
   "id": "resp",
   "action": "request",
   "params": {
    "url": "https://usage.numable.app/live/enable",
    "method": "POST",
    "formatType": "json",
    "header": {
     "Content-Type": "application/json",
     "User-Agent": "Numable"
    },
    "body": "{}",
    "credential": "nu"
   }
  },
  {
   "op": "set",
   "props": {
    "key": "r",
    "value": "${resp}"
   }
  },
  {
   "action": "resultFilter",
   "params": {
    "keys": [
     "r"
    ]
   }
  }
 ]
}