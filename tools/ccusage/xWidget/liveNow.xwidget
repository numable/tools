{
 "version": 2,
 "title": "实时",
 "sub": "几路 Claude Code 在跑、几个在等你",
 "i18n": {
  "en-US": {
   "title": "Live",
   "sub": "How many Claude Code sessions are running or waiting"
  }
 },
 "layout": 22,
 "events": {
  "onClick": "/live"
 },
 "canvas": {
  "source": "@[file://rc/liveNow.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/live.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "此刻有几路 Claude Code 会话在并行、几个在等你授权或等你回复"
 },
 "_note_jobs": "长按 → 「添加提醒」:等你授权提醒 / 长任务跑完提醒 / 可能卡住提醒(xJob/,§6.1–6.2)。",
 "jobs": [
  {
   "id": "waiting",
   "params": {}
  },
  {
   "id": "finished",
   "params": {}
  },
  {
   "id": "stuck",
   "params": {}
  }
 ]
}