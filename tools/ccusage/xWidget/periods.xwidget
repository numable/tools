{
 "version": 2,
 "title": "周期对比",
 "sub": "今天、近 7 天、近 30 天",
 "i18n": {
  "en-US": {
   "title": "Periods",
   "sub": "Today, 7 days and 30 days"
  }
 },
 "layout": 42,
 "events": {
  "onClick": "/period?r=d7"
 },
 "canvas": {
  "source": "@[file://rc/periods.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "今天、近 7 天、近 30 天的费用、输出 token 与活跃小时,带对比上一段的变化"
 }
}