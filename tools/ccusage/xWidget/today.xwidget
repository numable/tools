{
 "version": 2,
 "title": "今日用量",
 "sub": "今天的会话与消息",
 "i18n": {
  "en-US": {
   "title": "Today",
   "sub": "Sessions and messages today"
  }
 },
 "layout": 22,
 "events": {
  "onClick": "/day"
 },
 "canvas": {
  "source": "@[file://rc/today.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "今天的 Claude Code 会话数、消息数与输出,与日均相比"
 }
}
