{"version":1,"_note":"信息源页海报专用(tools/banner/dyn_personal.py 生成,不要手改),组件不用。","actions":[{"id":"_cs","action":"credential.state","params":{"id":"nu"}},{"op":"set","props":{"key":"_bcs","value":"1"},"_note":"⚠️ 读取屏障(勿删):credential.state 之后紧邻的节点读不到结果。"},{"op":"set","props":{"key":"demo","value":"$[if::(eq::(${_cs.state},unbound),1,0)]"},"_note":"只认 unbound 画示例;expired / 绑了但被拒照旧走真请求 → 失败退回上次的图或静态图。"},{"op":"set","props":{"key":"live","value":"$[if::(eq::(${demo},1),0,1)]"}},{"op":"if","props":{"val":"${live}"},"items":[{"op":"set","props":{"key":"todayQ","value":"$[formatDate::(${@time.nowMs},yyyy-MM-dd)]"},"_note":"同 summary.df:「今天」以看的人这台设备的日期为锚。"},{"id":"resp","action":"request","params":{"url":"https://usage.numable.app/s?today=${todayQ}&lite=1","method":"GET","header":{"User-Agent":"Numable"},"formatType":"json","credential":"nu"}},{"op":"set","props":{"key":"_b","value":"1"},"_note":"⚠️ 请求屏障(勿删):request 之后紧邻的节点读不到响应(晚一拍合并)。"},{"op":"set","props":{"key":"_fail","value":"$[if::(eq::(${resp},),1,0)]"}},{"op":"if","props":{"val":"${_fail}"},"items":[{"action":"error","params":{"errorMsg":"ccusage_unreachable"}}]},{"op":"set","props":{"key":"ok","value":"$[if::(eq::(connect::(k,${resp.merged.totals.activeDays}),k),0,1)]"},"_note":"令牌被拒 / 未接入 → totals 取不到 → ok=0 → 静态图(不是取数失败,不抛错)。"},{"op":"set","props":{"key":"td","value":"${resp.merged.today}"}},{"op":"set","props":{"key":"oRaw","value":"$[findNotEmpty::(${td.out},0)]"}},{"op":"set","props":{"key":"big","value":"$[if::(ge::(${oRaw},1000000),connect::(parseNumber::(calc::(${oRaw}/1000000),0.0),M),if::(ge::(${oRaw},1000),connect::(parseNumber::(calc::(${oRaw}/1000),0.0),k),parseNumber::(${oRaw},0)))]"}},{"op":"set","props":{"key":"wk","value":"$[findNotEmpty::(${resp.merged.w.per.r1.out},--)]"},"_note":"近 7 天输出 token(服务端已格式化,如 9.3M)。"},{"op":"set","props":{"key":"sess","value":"$[parseNumber::(findNotEmpty::(${td.sessions},0),0)]"}},{"op":"set","props":{"key":"msgs","value":"$[parseNumber::(findNotEmpty::(${td.msgs},0),0)]"}},{"op":"set","props":{"key":"bars","value":"${resp.merged.w.active.bars}"}},{"op":"set","props":{"key":"barsOk","value":"$[if::(ge::(length::(${bars}),7),1,0)]"},"_note":"老服务端没有 w.active → 不画柱。"},{"op":"set","props":{"key":"BY","value":{"y0":"$[parseNumber::(calc::(150-max::(1.5,calc::(findNotEmpty::(${bars[0].v},0)*40))),0.0)]","y1":"$[parseNumber::(calc::(150-max::(1.5,calc::(findNotEmpty::(${bars[1].v},0)*40))),0.0)]","y2":"$[parseNumber::(calc::(150-max::(1.5,calc::(findNotEmpty::(${bars[2].v},0)*40))),0.0)]","y3":"$[parseNumber::(calc::(150-max::(1.5,calc::(findNotEmpty::(${bars[3].v},0)*40))),0.0)]","y4":"$[parseNumber::(calc::(150-max::(1.5,calc::(findNotEmpty::(${bars[4].v},0)*40))),0.0)]","y5":"$[parseNumber::(calc::(150-max::(1.5,calc::(findNotEmpty::(${bars[5].v},0)*40))),0.0)]","y6":"$[parseNumber::(calc::(150-max::(1.5,calc::(findNotEmpty::(${bars[6].v},0)*40))),0.0)]"}}},{"op":"set","props":{"key":"BA","value":{"b0":"M24.0 150 V${BY.y0} H50.0 V150 Z","b1":"M68.0 150 V${BY.y1} H94.0 V150 Z","b2":"M112.0 150 V${BY.y2} H138.0 V150 Z","b3":"M156.0 150 V${BY.y3} H182.0 V150 Z","b4":"M200.0 150 V${BY.y4} H226.0 V150 Z","b5":"M244.0 150 V${BY.y5} H270.0 V150 Z","b6":"M288.0 150 V${BY.y6} H314.0 V150 Z"}},"_note":"每根柱一段 path(M x 底 V 顶 H 右 V 底 Z);模板串不经方法,空格保得住。"},{"op":"set","props":{"key":"_dn","value":["$[if::(eq::(findNotEmpty::(${bars[0].t},0),1),,${BA.b0})]","$[if::(eq::(findNotEmpty::(${bars[1].t},0),1),,${BA.b1})]","$[if::(eq::(findNotEmpty::(${bars[2].t},0),1),,${BA.b2})]","$[if::(eq::(findNotEmpty::(${bars[3].t},0),1),,${BA.b3})]","$[if::(eq::(findNotEmpty::(${bars[4].t},0),1),,${BA.b4})]","$[if::(eq::(findNotEmpty::(${bars[5].t},0),1),,${BA.b5})]","$[if::(eq::(findNotEmpty::(${bars[6].t},0),1),,${BA.b6})]"]}},{"op":"set","props":{"key":"_dt","value":["$[if::(eq::(findNotEmpty::(${bars[0].t},0),1),${BA.b0},)]","$[if::(eq::(findNotEmpty::(${bars[1].t},0),1),${BA.b1},)]","$[if::(eq::(findNotEmpty::(${bars[2].t},0),1),${BA.b2},)]","$[if::(eq::(findNotEmpty::(${bars[3].t},0),1),${BA.b3},)]","$[if::(eq::(findNotEmpty::(${bars[4].t},0),1),${BA.b4},)]","$[if::(eq::(findNotEmpty::(${bars[5].t},0),1),${BA.b5},)]","$[if::(eq::(findNotEmpty::(${bars[6].t},0),1),${BA.b6},)]"]}},{"op":"set","props":{"key":"dN","value":"$[findNotEmpty::(join::(${_dn}),M0 0)]"},"_note":"空串兜成只有 moveto 的 path(不画任何东西),防 path 解析失败整图白屏。"},{"op":"set","props":{"key":"dT","value":"$[findNotEmpty::(join::(${_dt}),M0 0)]"}},{"op":"set","props":{"key":"at","value":"$[if::(eq::(findNotEmpty::(${resp.updatedAt},__none__),__none__),,formatDate::(${resp.updatedAt},HH:mm))]"},"_note":"时效锚 = 采集侧最后一次上传的时刻。"}]},{"op":"if","props":{"val":"${demo}"},"items":[{"op":"set","props":{"key":"big","value":"100k"}},{"op":"set","props":{"key":"wk","value":"1.0M"}},{"op":"set","props":{"key":"sess","value":"10"}},{"op":"set","props":{"key":"msgs","value":"500"}},{"op":"set","props":{"key":"barsOk","value":"1"}},{"op":"set","props":{"key":"dN","value":"M24.0 150 V128.0 H50.0 V150 ZM68.0 150 V118.0 H94.0 V150 ZM112.0 150 V124.0 H138.0 V150 ZM156.0 150 V110.0 H182.0 V150 ZM200.0 150 V122.0 H226.0 V150 ZM244.0 150 V140.0 H270.0 V150 Z"}},{"op":"set","props":{"key":"dT","value":"M288.0 150 V132.0 H314.0 V150 Z"}},{"op":"set","props":{"key":"ok","value":"1"}}]},{"action":"resultFilter","params":{"keys":["ok","demo","at","big","wk","sess","msgs","barsOk","dN","dT"]}}]}
