{
 "version": 2,
 "title": "费用估算",
 "sub": "今天、近 7 天、近 30 天与本月",
 "i18n": {
  "en-US": {
   "title": "Est. cost",
   "sub": "Today, 7 days, 30 days and this month"
  }
 },
 "layout": 42,
 "events": {
  "onClick": "/period?r=d30"
 },
 "canvas": {
