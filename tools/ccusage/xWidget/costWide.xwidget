    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "按 API 标价折算的今天、近 7 天、近 30 天与本月费用,带 14 天每日柱"
 }
}