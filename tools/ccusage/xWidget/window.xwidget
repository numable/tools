{
 "version": 2,
 "title": "5 小时窗口",
 "sub": "当前窗口用了多少、几点重置",
 "i18n": {
  "en-US": {
   "title": "5-hour window",
   "sub": "Usage in the current window and when it resets"
  }
 },
 "layout": 22,
 "events": {
  "onClick": "/window"
 },
 "canvas": {
  "source": "@[file://rc/window.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "当前 5 小时窗口已用多少(按 API 标价)、几点重置与时间进度"
 }
}