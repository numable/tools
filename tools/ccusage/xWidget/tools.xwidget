{
 "version": 2,
 "title": "工具排行",
 "sub": "近 30 天调用最多的工具",
 "i18n": {
  "en-US": {
   "title": "Top tools",
   "sub": "Most-used tools, last 30 days"
  }
 },
 "layout": 42,
 "events": {
  "onClick": "/tool"
 },
 "canvas": {
  "source": "@[file://rc/tools.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "Claude Code 近 30 天调用次数前 5 的工具,与前 30 天对比"
 }
}