                        "y": "62pt+${_it.i}*34pt+9pt+1pt",
                        "w": "8pt",
                        "h": "8pt",
                        "bgColor": "#A1A1AA|#5B5B63",
                        "cornerRadius": {
                          "leftT": "1.5pt",
                          "leftB": "1.5pt",
                          "rightT": "1.5pt",
                          "rightB": "1.5pt"
                        }
                      }
                    ]
                  },
                  {
                    "type": "txt",
                    "x": "31pt",
                    "y": "62pt+${_it.i}*34pt",
                    "w": "{parent.w}-141pt",
                    "h": "-1",
                    "text": "$[if::(eq::(${@i18n.lang},en),${_it.pe},${_it.pz})] ${_it.lab} · ${_it.turns}${@i18n.turns}",
                    "fontSize": "9pt",
                    "textColor": "#6B7280|#8E939B",
                    "maxLines": "1"
                  },
                  {
                    "type": "txt",
                    "x": "31pt",
                    "y": "62pt+${_it.i}*34pt+12pt",
                    "w": "{parent.w}-141pt",
                    "h": "-1",
                    "text": "$[if::(eq::(${@i18n.lang},en),${_it.te},${_it.tz})]",
                    "fontSize": "11pt",
                    "textColor": "$[if::(eq::(${_it.warn},1),#C98A00|#F5C242,if::(eq::(${_it.dim},1),#6B7280|#8E939B,#0E1116|#F3F4F6))]",
                    "maxLines": "1"
                  },
                  {
                    "type": "txt",
                    "x": "{parent.w}-106pt",
                    "y": "62pt+${_it.i}*34pt+6pt",
                    "w": "46pt",
                    "h": "-1",
                    "text": "${_it.run}",
                    "fontSize": "11pt",
                    "textColor": "$[if::(eq::(${_it.dim},1),#6B7280|#8E939B,#0E1116|#F3F4F6)]",
                    "maxLines": "1",
                    "typeface": "System-Bold",
                    "alignmentH": "2"
                  },
                  {
                    "type": "txt",
                    "x": "{parent.w}-56pt",
                    "y": "62pt+${_it.i}*34pt+7pt",
                    "w": "42pt",
                    "h": "-1",
                    "text": "${_it.tok}",
                    "fontSize": "10pt",
                    "textColor": "#6B7280|#8E939B",
                    "maxLines": "1",
                    "alignmentH": "2"
                  },
                  {
                    "type": "layer",
                    "x": "31pt",
                    "y": "62pt+${_it.i}*34pt+31pt",
                    "w": "{parent.w}-45pt",
                    "h": "0.5pt",
                    "bgColor": "#F1EEEC|#2A2725"
                  }
                ]
              }
            ]
          },
          {
            "type": "op",
            "action": "if",
            "props": {
              "val": "$[if::(gt::(${w.m44},0),1,0)]"
            },
            "react": [
              {
                "type": "txt",
                "x": "31pt",
                "y": "62pt+7*34pt+8pt",
                "w": "{parent.w}-45pt",
                "h": "-1",
                "text": "${@i18n.more}${w.m44}${@i18n.moreB}",
                "fontSize": "10pt",
                "textColor": "#6B7280|#8E939B",
                "maxLines": "1"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(connect::(k,${w.devs}),k),0,1),1),if::(eq::(${w.devs},0),1,0),0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "14pt",
            "y": "{parent.h}*0.40",
            "w": "{parent.w}-28pt",
