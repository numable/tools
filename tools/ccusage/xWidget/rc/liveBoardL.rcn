{
  "rc": {
    "_note": "并行概况 · 44(2026-10-11):同 42,多一行汇总(工程数 · 在跑 · 等你),放 8 行。",
    "i18n": {
      "zh-CN": {
        "title": "并行概况",
        "empty": "等待首次同步",
        "asof": "截至 ",
        "lang": "zh",
        "off": "还没打开同步",
        "offHint": "在 Claude Code 里运行 /numable-usage，说「打开实时会话并同步到手机」",
        "none": "没有在跑的会话",
        "turns": " 轮",
        "more": "还有 ",
        "moreB": " 路 · 点开看全部",
        "proj": " 个工程",
        "run": " 在跑",
        "wait": " 等你"
      },
      "en-US": {
        "title": "Sessions",
        "empty": "Not synced yet",
        "asof": "As of ",
        "lang": "en",
        "off": "Sync is off",
        "offHint": "In Claude Code, run /numable-usage and ask to turn on live sessions with sync",
        "none": "No active sessions",
        "turns": " turns",
        "more": "",
        "moreB": " more · tap to see all",
        "proj": " projects",
        "run": " running",
        "wait": " waiting"
      }
    },
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FDFBFA\\,#FBF3F1)@90|linear(#15171A\\,#1A1A1C\\,#221E1F)@90",
        "_note": "并行概况 · 44(2026-10-11):同 42,多一行汇总(工程数 · 在跑 · 等你),放 8 行。"
      },
      {
        "_note": "源色身份点:本包统一用 Claude 暖橙两档。",
        "id": "dot",
        "type": "layer",
        "x": "14pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#C15F3C|#E8916B"
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "23pt",
        "y": "12pt",
        "w": "{parent.w}-94pt",
        "h": "-1",
        "text": "${@i18n.title}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(if::(eq::(connect::(k,${w.devs}),k),0,1),1),if::(gt::(${w.devs},0),1,0),0),1),if::(eq::(${w.has},1),1,0),0)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "14pt",
            "y": "36pt",
            "w": "{parent.w}-28pt",
            "h": "-1",
            "text": "${w.n.proj}${@i18n.proj} · ${w.n.run}${@i18n.run} · ${w.n.wait}${@i18n.wait}",
            "fontSize": "12pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          },
          {
            "type": "op",
            "action": "forEach",
            "props": {
              "items": "${w.board}",
              "key": "_it",
              "index": "_i"
            },
            "react": [
              {
                "type": "op",
                "action": "if",
                "props": {
                  "val": "$[if::(lt::(${_it.i},if::(gt::(${w.m44},0),7,8)),1,0)]"
                },
                "react": [
                  {
                    "type": "op",
                    "action": "if",
                    "props": {
                      "val": "$[if::(eq::(${_it.st},running),1,0)]"
                    },
                    "react": [
                      {
                        "type": "path",
                        "x": "14pt",
                        "y": "62pt+${_it.i}*34pt+9pt",
                        "w": "8pt",
                        "h": "9pt",
                        "d": "M0 0 L8 4.5 L0 9 Z",
                        "viewBox": "0 0 8 9",
                        "scaleType": "fitXY",
                        "fillColor": "#C15F3C|#E8916B"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "action": "if",
                    "props": {
                      "val": "$[if::(eq::(${_it.st},perm),1,0)]"
                    },
                    "react": [
                      {
                        "type": "txt",
                        "x": "14pt-1pt",
                        "y": "62pt+${_it.i}*34pt+9pt-2pt",
                        "w": "14pt",
                        "h": "-1",
                        "text": "⚠",
                        "fontSize": "11pt",
                        "textColor": "#C98A00|#F5C242",
                        "maxLines": "1",
                        "typeface": "System-Bold"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "action": "if",
                    "props": {
                      "val": "$[if::(eq::(${_it.st},input),1,0)]"
                    },
                    "react": [
                      {
                        "type": "layer",
                        "x": "14pt",
                        "y": "62pt+${_it.i}*34pt+9pt",
                        "w": "2.5pt",
                        "h": "9pt",
                        "bgColor": "#C98A00|#F5C242",
                        "cornerRadius": {
                          "leftT": "1pt",
                          "leftB": "1pt",
                          "rightT": "1pt",
                          "rightB": "1pt"
                        }
                      },
                      {
                        "type": "layer",
                        "x": "14pt+5pt",
                        "y": "62pt+${_it.i}*34pt+9pt",
                        "w": "2.5pt",
                        "h": "9pt",
                        "bgColor": "#C98A00|#F5C242",
                        "cornerRadius": {
                          "leftT": "1pt",
                          "leftB": "1pt",
                          "rightT": "1pt",
                          "rightB": "1pt"
                        }
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "action": "if",
                    "props": {
                      "val": "$[if::(eq::(${_it.st},parked),1,0)]"
                    },
                    "react": [
                      {
                        "type": "layer",
                        "x": "14pt",
                        "y": "62pt+${_it.i}*34pt+9pt",
                        "w": "2.5pt",
                        "h": "9pt",
                        "bgColor": "#A1A1AA|#5B5B63",
                        "cornerRadius": {
                          "leftT": "1pt",
                          "leftB": "1pt",
                          "rightT": "1pt",
                          "rightB": "1pt"
                        }
                      },
                      {
                        "type": "layer",
                        "x": "14pt+5pt",
                        "y": "62pt+${_it.i}*34pt+9pt",
                        "w": "2.5pt",
                        "h": "9pt",
                        "bgColor": "#A1A1AA|#5B5B63",
                        "cornerRadius": {
                          "leftT": "1pt",
                          "leftB": "1pt",
                          "rightT": "1pt",
                          "rightB": "1pt"
                        }
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "action": "if",
                    "props": {
                      "val": "$[if::(eq::(${_it.st},lost),1,0)]"
                    },
                    "react": [
                      {
                        "type": "txt",
                        "x": "14pt-1pt",
                        "y": "62pt+${_it.i}*34pt+9pt-4pt",
                        "w": "12pt",
                        "h": "-1",
                        "text": "×",
                        "fontSize": "14pt",
                        "textColor": "#A1A1AA|#5B5B63",
                        "maxLines": "1",
                        "typeface": "System-Bold"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "action": "if",
                    "props": {
                      "val": "$[if::(eq::(${_it.st},ended),1,0)]"
                    },
                    "react": [
                      {
                        "type": "layer",
