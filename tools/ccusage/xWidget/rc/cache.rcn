{
  "rc": {
    "_note": "缓存与思考(2026-09-24):近 30 天。缓存命中 = 输入侧里直接读缓存的比例;思考 / 子代理 = 占输出 token 的比例。\n变化对比前 30 天,比例的变化说「点」不说「%」(98% → 99% 是 +1 点)。",
    "i18n": {
      "zh-CN": {
        "title": "缓存与思考",
        "empty": "等待首次同步",
        "hit": "缓存命中",
        "think": "思考占输出",
        "side": "子代理占输出",
        "pt": " 点"
      },
      "en-US": {
        "title": "Cache",
        "empty": "Not synced yet",
        "hit": "Cache hit rate",
        "think": "Thinking of output",
        "side": "Agents of output",
        "pt": " pt"
      }
    },
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FDFBFA\\,#FBF3F1)@90|linear(#15171A\\,#1A1A1C\\,#221E1F)@90",
        "_note": "缓存与思考(2026-09-24):近 30 天。缓存命中 = 输入侧里直接读缓存的比例;思考 / 子代理 = 占输出 token 的比例。"
      },
      {
        "_note": "源色身份点:本包统一用 Claude 暖橙两档。",
        "id": "dot",
        "type": "layer",
        "x": "12pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#C15F3C|#E8916B"
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "21pt",
        "y": "11pt",
        "w": "{parent.w}-92pt",
        "h": "-1",
        "text": "${@i18n.title}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "33pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${@i18n.hit}",
        "fontSize": "10pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(connect::(k,${w.cache.hit.v}),k),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "33pt+14pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${w.cache.hit.v}",
            "fontSize": "18pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(connect::(k,${w.cache.hit.v}),k),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "33pt+14pt+5.4pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "--",
            "fontSize": "18pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(connect::(k,${w.cache.hit.c}),k),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "33pt+20.5pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${w.cache.hit.c}${@i18n.pt}",
            "fontSize": "9pt",
            "textColor": "$[if::(eq::(${w.cache.hit.u},1),#C15F3C|#E8916B,#6B7280|#8E939B)]",
            "maxLines": "1",
            "alignmentH": "2"
          }
        ]
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "72pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${@i18n.think}",
        "fontSize": "10pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(connect::(k,${w.cache.think.v}),k),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "72pt+14pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${w.cache.think.v}",
            "fontSize": "18pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(connect::(k,${w.cache.think.v}),k),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "72pt+14pt+5.4pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "--",
            "fontSize": "18pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(connect::(k,${w.cache.think.c}),k),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "72pt+20.5pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${w.cache.think.c}${@i18n.pt}",
            "fontSize": "9pt",
            "textColor": "$[if::(eq::(${w.cache.think.u},1),#C15F3C|#E8916B,#6B7280|#8E939B)]",
            "maxLines": "1",
            "alignmentH": "2"
          }
        ]
      },
      {
        "type": "txt",
        "x": "12pt",
        "y": "111pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${@i18n.side}",
        "fontSize": "10pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(connect::(k,${w.cache.side.v}),k),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "111pt+14pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${w.cache.side.v}",
            "fontSize": "18pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(connect::(k,${w.cache.side.v}),k),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "111pt+14pt+5.4pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "--",
            "fontSize": "18pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(connect::(k,${w.cache.side.c}),k),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "111pt+20.5pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${w.cache.side.c}${@i18n.pt}",
            "fontSize": "9pt",
            "textColor": "$[if::(eq::(${w.cache.side.u},1),#C15F3C|#E8916B,#6B7280|#8E939B)]",
            "maxLines": "1",
            "alignmentH": "2"
          }
        ]
      },
      {
        "_note": "时效锚:右上角、与卡名同一基线、9pt、右对齐(卡片设计系统 §3)。",
        "id": "at",
        "type": "txt",
        "x": "12pt",
        "y": "14pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},${@i18n.empty})]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "alignmentH": "2"
      }
    ]
  }
}