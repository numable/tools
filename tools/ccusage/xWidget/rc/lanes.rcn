                        "w": "2.5pt",
                        "h": "9pt",
                        "bgColor": "#A1A1AA|#5B5B63",
                        "cornerRadius": {
                          "leftT": "1pt",
                          "leftB": "1pt",
                          "rightT": "1pt",
                          "rightB": "1pt"
                        }
                      },
                      {
                        "type": "layer",
                        "x": "{parent.w}-62pt+5pt",
                        "y": "34pt+${_it.i}*25pt+2.5pt",
