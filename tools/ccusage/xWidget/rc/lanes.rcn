                        "w": "2.5pt",
                        "h": "9pt",
                        "bgColor": "#C98A00|#F5C242",
                        "cornerRadius": {
                          "leftT": "1pt",
                          "leftB": "1pt",
                          "rightT": "1pt",
                          "rightB": "1pt"
