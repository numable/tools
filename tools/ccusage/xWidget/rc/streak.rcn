            }
          },
          {
            "type": "txt",
            "x": "12pt",
            "y": "{parent.h}-26pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${@i18n.last14}",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "_note": "时效锚:右上角、与卡名同一基线、9pt、右对齐(卡片设计系统 §3)。",
        "id": "at",
        "type": "txt",
        "x": "12pt",
        "y": "14pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "$[findNotEmpty::(${at},${@i18n.empty})]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "alignmentH": "2"
      }
    ]
  }
}