            }
          },
          {
            "type": "layer",
            "x": "12pt+8*({parent.w}-24pt)/14",
            "y": "{parent.h}-44pt",
            "w": "({parent.w}-24pt)/14-2.5pt",
            "h": "({parent.w}-24pt)/14-2.5pt",
            "bgColor": "#EEE4E0|#2A2522",
