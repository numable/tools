{
  "rc": {
    "_note": "连续打卡(2026-09-24):大数 = 连续有用量的天数(今天还没用不算断,从昨天往回数);点阵 = 近 14 天,今天在最右、用源色。\n多台电脑轮流用按合并后的日期算。",
    "i18n": {
      "zh-CN": {
        "title": "连续打卡",
        "empty": "等待首次同步",
        "days": " 天",
        "sub": "连续活跃 · 最长 ",
        "last14": "近 14 天",
        "todayOn": " · 今天已打卡",
        "todayOff": " · 今天还没用"
      },
      "en-US": {
        "title": "Streak",
        "empty": "Not synced yet",
        "days": " days",
        "sub": "In a row · best ",
        "last14": "Last 14 days",
        "todayOn": " · done today",
        "todayOff": " · not yet today"
      }
    },
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FDFBFA\\,#FBF3F1)@90|linear(#15171A\\,#1A1A1C\\,#221E1F)@90",
        "_note": "连续打卡(2026-09-24):大数 = 连续有用量的天数(今天还没用不算断,从昨天往回数);点阵 = 近 14 天,今天在最右、用源色。"
      },
      {
        "_note": "源色身份点:本包统一用 Claude 暖橙两档。",
        "id": "dot",
        "type": "layer",
        "x": "12pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        },
        "bgColor": "#C15F3C|#E8916B"
      },
      {
        "id": "ttl",
        "type": "txt",
        "x": "21pt",
        "y": "11pt",
        "w": "{parent.w}-92pt",
        "h": "-1",
        "text": "${@i18n.title}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(connect::(k,${w.streak.n}),k),0,1)]"
        },
        "react": [
          {
            "id": "big",
            "type": "txt",
            "x": "12pt",
            "y": "{parent.h}*0.26",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${w.streak.n}${@i18n.days}",
            "fontSize": "28pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(connect::(k,${w.streak.n}),k),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "{parent.h}*0.26+8.4pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "--",
            "fontSize": "28pt",
            "textColor": "#0E1116|#F3F4F6",
            "maxLines": "1",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(connect::(k,${w.streak.longest}),k),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "{parent.h}*0.26+32pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${@i18n.sub}${w.streak.longest}${@i18n.days}",
            "fontSize": "10pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "forEach",
        "props": {
          "items": "${w.streak.dots}",
          "key": "_it",
          "index": "_i"
        },
        "react": [
          {
            "type": "layer",
            "x": "12pt+${_it.i}*({parent.w}-24pt)/14",
            "y": "{parent.h}-44pt",
            "w": "({parent.w}-24pt)/14-2.5pt",
            "h": "({parent.w}-24pt)/14-2.5pt",
            "cornerRadius": {
              "leftT": "2pt",
              "leftB": "2pt",
              "rightT": "2pt",
              "rightB": "2pt"
            },
            "bgColor": "$[if::(eq::(${_it.on},1),if::(eq::(${_it.t},1),#C15F3C|#E8916B,#E9D5CD|#3B302B),#EEE4E0|#2A2522)]"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(connect::(k,${w.streak.todayOn}),k),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "x": "12pt",
            "y": "{parent.h}-26pt",
            "w": "{parent.w}-24pt",
            "h": "-1",
            "text": "${@i18n.last14}$[if::(eq::(${w.streak.todayOn},1),${@i18n.todayOn},${@i18n.todayOff})]",
            "fontSize": "9pt",
            "textColor": "#6B7280|#8E939B",
            "maxLines": "1"
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(if::(eq::(connect::(k,${w.streak.n}),k),0,1),1),0,1)]"
        },
        "react": [
          {
            "type": "layer",
            "x": "12pt+0*({parent.w}-24pt)/14",
            "y": "{parent.h}-44pt",
            "w": "({parent.w}-24pt)/14-2.5pt",
            "h": "({parent.w}-24pt)/14-2.5pt",
            "bgColor": "#EEE4E0|#2A2522",
            "cornerRadius": {
              "leftT": "2pt",
              "leftB": "2pt",
              "rightT": "2pt",
              "rightB": "2pt"
            }
          },
          {
            "type": "layer",
            "x": "12pt+1*({parent.w}-24pt)/14",
            "y": "{parent.h}-44pt",
            "w": "({parent.w}-24pt)/14-2.5pt",
            "h": "({parent.w}-24pt)/14-2.5pt",
            "bgColor": "#EEE4E0|#2A2522",
            "cornerRadius": {
              "leftT": "2pt",
              "leftB": "2pt",
              "rightT": "2pt",
              "rightB": "2pt"
            }
          },
          {
            "type": "layer",
            "x": "12pt+2*({parent.w}-24pt)/14",
            "y": "{parent.h}-44pt",
            "w": "({parent.w}-24pt)/14-2.5pt",
            "h": "({parent.w}-24pt)/14-2.5pt",
            "bgColor": "#EEE4E0|#2A2522",
            "cornerRadius": {
              "leftT": "2pt",
              "leftB": "2pt",
              "rightT": "2pt",
              "rightB": "2pt"
            }
          },
          {
            "type": "layer",
            "x": "12pt+3*({parent.w}-24pt)/14",
            "y": "{parent.h}-44pt",
            "w": "({parent.w}-24pt)/14-2.5pt",
            "h": "({parent.w}-24pt)/14-2.5pt",
            "bgColor": "#EEE4E0|#2A2522",
            "cornerRadius": {
              "leftT": "2pt",
              "leftB": "2pt",
              "rightT": "2pt",
              "rightB": "2pt"
            }
          },
          {
            "type": "layer",
            "x": "12pt+4*({parent.w}-24pt)/14",
            "y": "{parent.h}-44pt",
            "w": "({parent.w}-24pt)/14-2.5pt",
            "h": "({parent.w}-24pt)/14-2.5pt",
            "bgColor": "#EEE4E0|#2A2522",
            "cornerRadius": {
              "leftT": "2pt",
