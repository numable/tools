{
  "rc": {
    "_note": "周期对比(2026-09-24):三行(今天 / 近 7 天 / 近 30 天)× 三列(费用 / 输出 token / 活跃小时),近 7 / 30 天带对比上一段等长时间的变化(今天那行不给)。\n与首页「周期对比」表同一口径,数全由服务端 w.per 给好。",
    "i18n": {
      "zh-CN": {
        "title": "周期对比",
        "empty": "等待首次同步",
        "r0": "今天",
        "r1": "近 7 天",
        "r2": "近 30 天",
        "cUsd": "费用",
        "cOut": "输出",
        "cAm": "活跃",
        "hr": " 小时",
        "avgA": "日均的 ",
        "avgB": "%"
      },
      "en-US": {
        "title": "Periods",
        "empty": "Not synced yet",
        "r0": "Today",
        "r1": "7 days",
        "r2": "30 days",
        "cUsd": "Cost",
        "cOut": "Output",
        "cAm": "Active",
        "hr": "h",
        "avgA": "",
        "avgB": "% of avg"
      }
    },
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "linear(#FFFFFF\\,#FDFBFA\\,#FBF3F1)@90|linear(#15171A\\,#1A1A1C\\,#221E1F)@90",
        "_note": "周期对比(2026-09-24):三行(今天 / 近 7 天 / 近 30 天)× 三列(费用 / 输出 token / 活跃小时),近 7 / 30 天带对比上一段等长时间的变化(今天那行不给)。"
      },
      {
        "_note": "源色身份点:本包统一用 Claude 暖橙两档。",
        "id": "dot",
        "type": "layer",
        "x": "14pt",
        "y": "{ttl.y}+({ttl.h}-5pt)/2",
