{
 "version": 2,
 "title": "5 小时窗口",
 "sub": "迷你 · 当前窗口已用多少、几点重置",
 "i18n": {
  "en-US": {
   "title": "5-hour window",
   "sub": "Mini · spend in the current window and reset time"
  }
 },
 "layout": 21,
 "events": {
  "onClick": "/window"
 },
 "canvas": {
  "source": "@[file://rc/windowmini.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "当前 5 小时窗口已用多少(按 API 标价)与几点重置(一行)"
 }
}