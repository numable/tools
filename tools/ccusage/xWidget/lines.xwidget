{
 "version": 2,
 "title": "代码改动",
 "sub": "今天新增与删除的代码行",
 "i18n": {
  "en-US": {
   "title": "Lines changed",
   "sub": "Lines added and removed today"
  }
 },
 "layout": 22,
 "events": {
  "onClick": "/period?r=d7&m=lines"
 },
 "canvas": {
  "source": "@[file://rc/lines.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "今天 Claude Code 新增与删除的代码行数,近 7 天每天柱与合计对比"
 }
}