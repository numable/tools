{
 "version": 2,
 "title": "缓存与思考",
 "sub": "缓存命中、思考与子代理的占比",
 "i18n": {
  "en-US": {
   "title": "Cache & thinking",
   "sub": "Cache hits, thinking and agents"
  }
 },
 "layout": 22,
 "events": {
  "onClick": "/tokens"
 },
 "canvas": {
  "source": "@[file://rc/cache.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "近 30 天缓存命中率,以及思考与子代理占输出 token 的比例"
 }
}