{
 "version": 2,
 "title": "每日费用",
 "sub": "近 30 天，按模型分色",
 "i18n": {
  "en-US": {
   "title": "Daily cost",
   "sub": "Last 30 days, by model"
  }
 },
 "layout": 42,
 "events": {
  "onClick": "/period?r=d30"
 },
 "canvas": {
  "source": "@[file://rc/trend.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "Claude Code 近 30 天每日费用(按 API 标价)柱,按模型分色,带日均线"
 }
}