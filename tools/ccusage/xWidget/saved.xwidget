{
 "version": 2,
 "title": "缓存省了多少",
 "sub": "近 30 天读缓存比按原价省下的钱",
 "i18n": {
  "en-US": {
   "title": "Cache savings",
   "sub": "What prompt caching saved you, last 30 days"
  }
 },
 "layout": 22,
 "events": {
  "onClick": "/tokens"
 },
 "canvas": {
  "source": "@[file://rc/saved.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "近 30 天 Claude Code 读缓存比按原价省下的钱,缓存命中率,实付占原价的比例"
 }
}