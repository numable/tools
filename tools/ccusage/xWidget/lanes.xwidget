{
 "version": 2,
 "title": "多泳道",
 "sub": "最近 2 小时各工程、各会话的时间轴",
 "i18n": {
  "en-US": {
   "title": "Lanes",
   "sub": "Each project and session over the last 2 hours"
  }
 },
 "layout": 42,
 "events": {
  "onClick": "/live"
 },
 "canvas": {
  "source": "@[file://rc/lanes.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/live.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "最近 2 小时每个工程、每路 Claude Code 会话的时间轴,颜色是在做什么,右侧是现在的状态"
 },
 "_note_jobs": "长按 → 「添加提醒」:等你授权提醒 / 长任务跑完提醒 / 可能卡住提醒(xJob/,§6.1–6.2)。",
 "jobs": [
  {
   "id": "waiting",
   "params": {}
  },
  {
   "id": "finished",
   "params": {}
  },
  {
   "id": "stuck",
   "params": {}
  }
 ]
}