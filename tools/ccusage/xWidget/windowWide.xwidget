{
 "version": 2,
 "title": "5 小时窗口",
 "sub": "已用、几点重置、按速度预计",
 "i18n": {
  "en-US": {
   "title": "5-hour window",
   "sub": "Used, reset time and pace"
  }
 },
 "layout": 42,
 "events": {
  "onClick": "/window"
 },
 "canvas": {
  "source": "@[file://rc/windowWide.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "当前 5 小时窗口已用费用、输出 token、几点重置与按速度预计的用量"
 }
}