{
 "version": 2,
 "title": "活跃时长",
 "sub": "今天实际在用的时间",
 "i18n": {
  "en-US": {
   "title": "Active time",
   "sub": "Time actually spent today"
  }
 },
 "layout": 22,
 "events": {
  "onClick": "/period?r=d7&m=am"
 },
 "canvas": {
  "source": "@[file://rc/active.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "今天实际在用 Claude Code 的时长,近 7 天每天活跃时长柱与日均"
 }
}