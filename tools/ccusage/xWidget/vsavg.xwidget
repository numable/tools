{
 "version": 2,
 "title": "今天与日均",
 "sub": "今天的费用到了日均的多少",
 "i18n": {
  "en-US": {
   "title": "Today vs average",
   "sub": "How today compares with a usual day"
  }
 },
 "layout": 22,
 "events": {
  "onClick": "/day"
 },
 "canvas": {
  "source": "@[file://rc/vsavg.rcn]",
