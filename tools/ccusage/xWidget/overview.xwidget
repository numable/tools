{
 "version": 2,
 "title": "用量总览",
 "sub": "会话 · 消息 · token · 活跃天",
 "i18n": {
  "en-US": {
   "title": "Usage overview",
   "sub": "Sessions · messages · tokens · active days"
  }
 },
 "layout": 42,
 "events": {
  "onClick": "numable://self"
 },
 "canvas": {
  "source": "@[file://rc/overview.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "Claude Code 用量总览:会话、消息、输出 token、活跃天数、连续天数与高峰时段"
 }
}
