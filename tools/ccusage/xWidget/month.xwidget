{
 "version": 2,
 "title": "本月账单",
 "sub": "本月至今，与上月同期对比",
 "i18n": {
  "en-US": {
   "title": "This month",
   "sub": "Month to date vs last month"
  }
 },
 "layout": 22,
 "events": {
  "onClick": "/period?r=month"
 },
 "canvas": {
  "source": "@[file://rc/month.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "本月至今按 API 标价折算的 Claude Code 费用,比上月同期,已到上月全月的多少"
 }
}