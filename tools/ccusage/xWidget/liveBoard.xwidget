{
 "version": 2,
 "title": "并行概况",
 "sub": "每路 Claude Code 在做什么、什么状态",
 "i18n": {
  "en-US": {
   "title": "Sessions",
   "sub": "What each Claude Code session is doing"
  }
 },
 "layout": 42,
 "events": {
  "onClick": "/live"
 },
 "canvas": {
  "source": "@[file://rc/liveBoard.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/live.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "每路 Claude Code 会话的状态、在做什么、实跑时长与 token,等你的排在最前"
 },
 "_note_jobs": "长按 → 「添加提醒」:等你授权提醒 / 长任务跑完提醒 / 可能卡住提醒(xJob/,§6.1–6.2)。",
 "jobs": [
  {
   "id": "waiting",
   "params": {}
  },
  {
   "id": "finished",
   "params": {}
  },
  {
   "id": "stuck",
   "params": {}
  }
 ]
}