{
 "version": 2,
 "title": "活跃热力图",
 "sub": "最近十周的每日活跃",
 "i18n": {
  "en-US": {
   "title": "Activity heatmap",
   "sub": "Daily activity over the last ten weeks"
  }
 },
 "layout": 44,
 "events": {
  "onClick": "numable://self"
 },
 "canvas": {
  "source": "@[file://rc/heatmap.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/heatmap.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "最近十周每天的 Claude Code 活跃热力图,带活跃天数、连续与最长连续天数"
 }
}
