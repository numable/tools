{
 "version": 2,
 "title": "按模型费用",
 "sub": "近 30 天各模型花了多少，比前 30 天",
 "i18n": {
  "en-US": {
   "title": "Cost by model",
   "sub": "What each model cost in the last 30 days"
  }
 },
 "layout": 42,
 "events": {
  "onClick": "/model"
 },
 "canvas": {
  "source": "@[file://rc/modelCost.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "Claude Code 近 30 天按费用排的前 3 个模型、各自花了多少与较前 30 天的变化,带合计"
 }
}