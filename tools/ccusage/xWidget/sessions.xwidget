{
 "version": 2,
 "title": "会话习惯",
 "sub": "一次会话通常多长",
 "i18n": {
  "en-US": {
   "title": "Sessions",
   "sub": "How long a session usually runs"
  }
 },
 "layout": 22,
 "events": {
  "onClick": "/hours"
 },
 "canvas": {
  "source": "@[file://rc/sessions.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "平均一次 Claude Code 会话多长、最长一次,今天与近 7 天的会话数"
 }
}