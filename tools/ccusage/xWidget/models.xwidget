{
 "version": 2,
 "title": "模型分布",
 "sub": "按输出 token 占比",
 "i18n": {
  "en-US": {
   "title": "Model split",
   "sub": "Share of output tokens"
  }
 },
 "layout": 42,
 "events": {
  "onClick": "/model"
 },
 "canvas": {
  "source": "@[file://rc/models.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "Claude Code 各模型按输出 token 的占比"
 }
}
