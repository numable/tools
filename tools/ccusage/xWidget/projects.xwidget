{
 "version": 2,
 "title": "项目分布",
 "sub": "各项目的输出占比",
 "i18n": {
  "en-US": {
   "title": "Projects",
   "sub": "Output share by project"
  }
 },
 "layout": 42,
 "events": {
  "onClick": "/project"
 },
 "canvas": {
  "source": "@[file://rc/projects.rcn]",
  "depends": [
   {
    "flow": "@[file://flow/summary.df]",
    "params": {}
   }
  ],
  "refresh": {
   "interval": [
    "300"
   ]
  }
 },
 "ai": {
  "shows": "Claude Code 按输出 token 排的前 5 个项目及占比"
 }
}