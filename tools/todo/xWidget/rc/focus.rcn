{
 "rc": {
  "_note": "单件待办(22):图标 + 清单 / 标题两行 / 进度环 + 截止。长按「编辑参数」换一件。",
  "i18n": {
   "zh-CN": {
    "today": "今天",
    "tmr": "明天",
    "empty": "这里没有待办",
    "pickOne": "还没选待办",
    "pickHint": "长按选一件",
    "doneTag": "已完成",
    "steps": "步骤",
    "od1": "逾期 ",
    "od2": " 天"
   },
   "en-US": {
    "today": "Today",
    "tmr": "Tomorrow",
    "empty": "Nothing here",
    "pickOne": "No to-do picked",
    "pickHint": "Long-press to pick one",
    "doneTag": "Done",
    "steps": "Steps",
    "od1": "",
    "od2": "d overdue"
   }
  },
  "i18nEmptyOk": [
   "od1"
  ],
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[eq::(${has},1)]"
    },
    "react": [
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.hic},1)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "12pt",
        "y": "12pt",
        "w": "30pt",
        "h": "30pt",
        "bgColor": "${f.cw}",
        "cornerRadius": {
         "leftT": "9pt",
         "leftB": "9pt",
         "rightT": "9pt",
         "rightB": "9pt"
        }
       },
       {
        "type": "path",
        "x": "19pt",
        "y": "19pt",
        "w": "16pt",
        "h": "16pt",
        "d": "$[get::(${ic},${f.ic})]",
        "viewBox": "0 0 256 256",
        "scaleType": "fitCenter",
        "fillColor": "${f.c}"
       }
      ]
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.hic},0)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "12pt",
        "y": "12pt",
        "w": "30pt",
        "h": "30pt",
        "bgColor": "${f.cw}",
        "cornerRadius": {
         "leftT": "9pt",
         "leftB": "9pt",
         "rightT": "9pt",
         "rightB": "9pt"
        }
       },
       {
        "type": "layer",
        "x": "22pt",
        "y": "22pt",
        "w": "10pt",
        "h": "10pt",
        "bgColor": "${f.c}",
        "cornerRadius": {
         "leftT": "5pt",
         "leftB": "5pt",
         "rightT": "5pt",
         "rightB": "5pt"
        }
       }
      ]
     },
     {
      "type": "txt",
      "x": "50pt",
      "y": "22pt",
      "w": "{parent.w}-62pt",
      "h": "-1",
      "text": "${f.ln}",
      "fontSize": "10.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.st},0)]"
      },
      "react": [
       {
        "type": "txt",
        "x": "12pt",
        "y": "52pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${f.t}",
        "fontSize": "14pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "2",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "lineSpacing": "2pt"
       }
      ]
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.st},1)]"
      },
      "react": [
       {
        "type": "txt",
        "x": "12pt",
        "y": "52pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${f.t}",
        "fontSize": "14pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "2",
        "typeface": "System-Bold",
        "lineBreak": "0",
        "lineSpacing": "2pt"
       }
      ]
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.hnote},1)]"
      },
      "react": [
       {
        "type": "txt",
        "x": "12pt",
        "y": "93pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${f.note}",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
       }
      ]
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[and::(ne::(${f.hnote},1),gt::(findNotEmpty::(${f.sn},0),0))]"
      },
      "react": [
       {
        "type": "txt",
        "x": "12pt",
        "y": "93pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${@i18n.steps} ${f.sd}/${f.sn}",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
       }
      ]
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.st},0)]"
      },
      "react": [
       {
        "type": "arc",
        "x": "12pt",
        "y": "112pt",
        "w": "32pt",
        "h": "32pt",
        "startAngle": "0",
        "sweepAngle": "360",
        "useCenter": "0",
        "lineWidth": "4pt",
        "strokeColor": "#E7E9EE|#20232A"
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[gt::(${sweep},0)]"
        },
        "react": [
         {
          "type": "arc",
          "x": "12pt",
          "y": "112pt",
          "w": "32pt",
          "h": "32pt",
          "startAngle": "-90",
          "sweepAngle": "$[findNotEmpty::(${sweep},0)]",
          "useCenter": "0",
          "lineWidth": "4pt",
          "lineCap": "round",
          "strokeColor": "${f.c}"
         }
        ]
       },
       {
        "type": "txt",
        "x": "52pt",
        "y": "115.5pt",
        "w": "{parent.w}-64pt",
        "h": "-1",
        "text": "${f.pg}%",
        "fontSize": "12pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
       },
       {
        "type": "txt",
        "x": "52pt",
        "y": "132.5pt",
        "w": "{parent.w}-64pt",
        "h": "-1",
        "text": "$[if::(eq::(${f.hdm},0),,if::(lt::(round::(calc::((${f.dm}-${tdm})/86400000)),0),${@i18n.od1}round::(calc::((${tdm}-${f.dm})/86400000))${@i18n.od2},if::(eq::(round::(calc::((${f.dm}-${tdm})/86400000)),0),if::(eq::(${f.htm},1),${f.tm},${@i18n.today}),if::(eq::(round::(calc::((${f.dm}-${tdm})/86400000)),1),${@i18n.tmr},if::(lt::(round::(calc::((${f.dm}-${tdm})/86400000)),7),if::(startsWith::(${@app.language},zh),${f.wdz},${f.wde}),if::(startsWith::(${@app.language},zh),${f.mdz},${f.mde}))))))]",
        "fontSize": "10pt",
        "textColor": "$[if::(eq::(${f.hdm},0),if::(eq::(${theme},dark),#8E939B,#6B7280),if::(lt::(round::(calc::((${f.dm}-${tdm})/86400000)),0),if::(eq::(${theme},dark),#FF6369,#E5484D),if::(eq::(round::(calc::((${f.dm}-${tdm})/86400000)),0),if::(eq::(${theme},dark),#F06595,#D6336C),if::(eq::(${theme},dark),#8E939B,#6B7280))))]",
        "maxLines": "1",
        "lineBreak": "0"
       }
      ]
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.st},1)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "12pt",
        "y": "116pt",
        "w": "{parent.w}-24pt",
        "h": "26pt",
        "bgColor": "#2E9E6B|#45C793",
        "cornerRadius": {
         "leftT": "13pt",
         "leftB": "13pt",
         "rightT": "13pt",
         "rightB": "13pt"
        },
        "alpha": "0.14"
       },
       {
        "type": "txt",
        "x": "12pt",
        "y": "122pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${@i18n.doneTag}",
        "fontSize": "11.5pt",
        "textColor": "#2E9E6B|#45C793",
        "maxLines": "1",
        "typeface": "System-Bold",
        "alignmentH": "1",
        "lineBreak": "0"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${has},1)]"
    },
    "react": [
     {
      "type": "layer",
      "x": "12pt",
      "y": "12pt",
      "w": "30pt",
      "h": "30pt",
      "bgColor": "#EEF0F4|#252930",
      "cornerRadius": {
       "leftT": "9pt",
       "leftB": "9pt",
       "rightT": "9pt",
       "rightB": "9pt"
      }
     },
     {
      "type": "txt",
      "x": "12pt",
      "y": "56pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "$[if::(eq::(${picked},1),${@i18n.empty},${@i18n.pickOne})]",
      "fontSize": "14pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "2",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "12pt",
      "y": "{parent.h}-30pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.pickHint}",
      "fontSize": "10.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}