{
 "rc": {
  "_note": "今天(11):还剩几件(含逾期)+ 一句状态(逾期 / 都做完了 / 没有要做的)。",
  "i18n": {
   "zh-CN": {
    "tToday": "今天",
    "unitLeft": "件待办",
    "over11": " 件逾期",
    "done11": "都做完了",
    "free11": "没有要做的"
   },
   "en-US": {
    "tToday": "Today",
    "unitLeft": "left",
    "over11": " overdue",
    "done11": "All done",
    "free11": "Nothing due"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "8pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "17pt",
    "y": "7pt",
    "w": "43pt",
    "h": "-1",
    "text": "${@i18n.tToday}",
    "fontSize": "10pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[eq::(${ok},1)]"
    },
    "react": [
     {
      "id": "num",
      "type": "txt",
      "x": "8pt",
      "y": "22pt",
      "w": "54pt",
      "h": "-1",
      "text": "${rem}",
      "fontSize": "20pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${ok},1)]"
    },
    "react": [
     {
      "id": "numE",
      "type": "txt",
      "x": "8pt",
      "y": "28pt",
      "w": "54pt",
      "h": "-1",
      "text": "--",
      "fontSize": "20pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${ok},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${@i18n.unitLeft}",
      "fontSize": "9pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),gt::(${ovr},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${ovr}${@i18n.over11}",
      "fontSize": "9pt",
      "textColor": "#E5484D|#FF6369",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),gt::(${rem},0),eq::(${ovr},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${@i18n.unitLeft}",
      "fontSize": "9pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${rem},0),gt::(${doneT},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${@i18n.done11}",
      "fontSize": "9pt",
      "textColor": "#2E9E6B|#45C793",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${rem},0),eq::(${doneT},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${@i18n.free11}",
      "fontSize": "9pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}