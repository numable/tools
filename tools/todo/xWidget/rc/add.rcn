{
 "rc": {
  "_note": "添加待办(21):一点就开添加面板。副行 = 今天还剩几件。",
  "i18n": {
   "zh-CN": {
    "tToday": "今天",
    "free": "今天没有要做的事",
    "addHint": "添加待办",
    "open": " 件待办"
   },
   "en-US": {
    "tToday": "Today",
    "free": "Nothing due today",
    "addHint": "Add a to-do",
    "open": " open"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "type": "layer",
    "x": "12pt",
    "y": "({parent.h}-30pt)/2",
    "w": "30pt",
    "h": "30pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "15pt",
     "leftB": "15pt",
     "rightT": "15pt",
     "rightB": "15pt"
    }
   },
   {
    "type": "path",
    "x": "20pt",
    "y": "({parent.h}-14pt)/2",
    "w": "14pt",
    "h": "14pt",
    "d": "M224 128a8 8 0 0 1-8 8H136v80a8 8 0 0 1-16 0V136H40a8 8 0 0 1 0-16h80V40a8 8 0 0 1 16 0v80h80A8 8 0 0 1 224 128Z",
    "viewBox": "0 0 256 256",
    "scaleType": "fitCenter",
    "fillColor": "#FFFFFF|#0B0C0E"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[eq::(${ok},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "52pt",
      "y": "({parent.h}-26pt)/2",
      "w": "{parent.w}-64pt",
      "h": "-1",
      "text": "${@i18n.addHint}",
      "fontSize": "13pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "52pt",
      "y": "({parent.h}-26pt)/2+17pt",
      "w": "{parent.w}-64pt",
      "h": "-1",
      "text": "$[if::(gt::(${rem},0),${@i18n.tToday} · ${rem}${@i18n.open},${@i18n.free})]",
      "fontSize": "10.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${ok},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "52pt",
      "y": "({parent.h}-12pt)/2",
      "w": "{parent.w}-64pt",
      "h": "-1",
      "text": "${@i18n.addHint}",
      "fontSize": "13pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}