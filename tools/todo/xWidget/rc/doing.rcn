{
 "rc": {
  "_note": "进行中(42):有进度、还没做完的前 3 件,按进度从高到低。",
  "i18n": {
   "zh-CN": {
    "tDoing": "进行中",
    "none": "还没有待办",
    "empty": "这里没有待办",
    "addHint": "添加待办",
    "open": " 件待办"
   },
   "en-US": {
    "tDoing": "In progress",
    "none": "No to-dos yet",
    "empty": "Nothing here",
    "addHint": "Add a to-do",
    "open": " open"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "14pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "23pt",
    "y": "12pt",
    "w": "{parent.w}-133pt",
    "h": "-1",
    "text": "${@i18n.tDoing}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "id": "hr",
    "type": "txt",
    "x": "14pt",
    "y": "13.5pt",
    "w": "{parent.w}-28pt",
    "h": "-1",
    "text": "$[if::(gt::(${n},0),${n}${@i18n.open},)]",
    "fontSize": "11pt",
    "textColor": "#6B7280|#8E939B",
    "maxLines": "1",
    "alignmentH": "2",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "forEach",
    "props": {
     "items": "${rows}",
     "key": "_it",
     "index": "_i"
    },
    "react": [
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[lt::(${_it.i},3)]"
      },
      "react": [
       {
        "type": "txt",
        "x": "14pt",
        "y": "40pt+${_it.i}*36pt+2pt",
        "w": "{parent.w}-72pt",
        "h": "-1",
        "text": "${_it.t}",
        "fontSize": "13pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "lineBreak": "0"
       },
       {
        "type": "txt",
        "x": "{parent.w}-56pt",
        "y": "40pt+${_it.i}*36pt+3.7pt",
        "w": "42pt",
        "h": "-1",
        "text": "${_it.pg}%",
        "fontSize": "12pt",
        "textColor": "${_it.c}",
        "maxLines": "1",
        "typeface": "System-Bold",
        "alignmentH": "2",
        "lineBreak": "0"
       },
       {
        "type": "layer",
        "x": "14pt",
        "y": "40pt+${_it.i}*36pt+22pt",
        "w": "{parent.w}-28pt",
        "h": "5pt",
        "bgColor": "#D6DAE1|#2C313A",
        "cornerRadius": {
         "leftT": "2.5pt",
         "leftB": "2.5pt",
         "rightT": "2.5pt",
         "rightB": "2.5pt"
        }
       },
       {
        "type": "layer",
        "x": "14pt",
        "y": "40pt+${_it.i}*36pt+22pt",
        "w": "({parent.w}-28pt)*${_it.pgf}",
        "h": "5pt",
        "bgColor": "${_it.c}",
        "cornerRadius": {
         "leftT": "2.5pt",
         "leftB": "2.5pt",
         "rightT": "2.5pt",
         "rightB": "2.5pt"
        }
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${any},1),eq::(${n},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "66pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.empty}",
      "fontSize": "13pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${any},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "64pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.none}",
      "fontSize": "13pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "14pt",
      "y": "84pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.addHint}",
      "fontSize": "11pt",
      "textColor": "#D6336C|#F06595",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}