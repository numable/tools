{
 "rc": {
  "_note": "完成连胜(21):连续几天有完成 + 近 7 天完成柱(今天实色)。",
  "i18n": {
   "zh-CN": {
    "nbsp": " ",
    "tStreak": "完成连胜",
    "stkU": "天"
   },
   "en-US": {
    "nbsp": " ",
    "tStreak": "Done streak",
    "stkU": "days"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "10pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "19pt",
    "y": "9pt",
    "w": "{parent.w}-29pt",
    "h": "-1",
    "text": "${@i18n.tStreak}",
    "fontSize": "11pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[eq::(${ok},1)]"
    },
    "react": [
     {
      "type": "richText",
      "x": "10pt",
      "y": "29pt",
      "w": "78pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "${stk}",
        "fontSize": "16.5pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${@i18n.nbsp}",
        "fontSize": "4.5pt"
       },
       {
        "text": "${@i18n.stkU}",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#6B7280|#8E939B"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${ok},1)]"
    },
    "react": [
     {
      "id": "numE",
      "type": "txt",
      "x": "10pt",
      "y": "34pt",
      "w": "78pt",
      "h": "-1",
      "text": "--",
      "fontSize": "16.5pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "forEach",
    "props": {
     "items": "${bars}",
     "key": "_it",
     "index": "_i"
    },
    "react": [
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${ok},1)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "90pt+${_it.i}*58pt/7+(58pt/7-6pt)/2",
        "y": "30pt+22pt*(1-${_it.f})",
        "w": "6pt",
        "h": "22pt*${_it.f}",
        "bgColor": "$[if::(eq::(${_it.t},1),if::(eq::(${theme},dark),#F06595,#D6336C),if::(eq::(${_it.z},1),if::(eq::(${theme},dark),#2C313A,#D6DAE1),if::(eq::(${theme},dark),#7A3D55,#F0A9C1)))]",
        "cornerRadius": {
         "leftT": "2pt",
         "leftB": "2pt",
         "rightT": "2pt",
         "rightB": "2pt"
        }
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${ok},1)]"
    },
    "react": [
     {
      "type": "layer",
      "x": "90pt",
      "y": "50pt",
      "w": "58pt",
      "h": "2pt",
      "bgColor": "#D6DAE1|#2C313A",
      "cornerRadius": {
       "leftT": "1pt",
       "leftB": "1pt",
       "rightT": "1pt",
       "rightB": "1pt"
      }
     }
    ]
   }
  ]
 }
}