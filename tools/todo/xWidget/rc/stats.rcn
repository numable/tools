{
 "rc": {
  "_note": "完成(22):近 7 天完成几件 + 每天的柱 + 连续天数。",
  "i18n": {
   "zh-CN": {
    "nbsp": " ",
    "tStats": "完成",
    "unitDone": "件",
    "none": "还没有待办",
    "stale": "数据未更新",
    "near7": "近 7 天完成",
    "streak1": "连续 ",
    "streak2": " 天",
    "noStreak": "今天还没完成",
    "best1": "最长 ",
    "best2": " 天",
    "best2s": " 天"
   },
   "en-US": {
    "nbsp": " ",
    "tStats": "Done",
    "unitDone": "done",
    "none": "No to-dos yet",
    "stale": "Not up to date",
    "near7": "Done in 7 days",
    "streak1": "",
    "streak2": "-day streak",
    "noStreak": "None done today",
    "best1": "Best ",
    "best2": " days",
    "best2s": " day"
   }
  },
  "i18nEmptyOk": [
   "streak1"
  ],
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "12pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "21pt",
    "y": "11pt",
    "w": "{parent.w}-33pt",
    "h": "-1",
    "text": "${@i18n.tStats}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[eq::(${ok},1)]"
    },
    "react": [
     {
      "type": "richText",
      "x": "12pt",
      "y": "34pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "${done7}",
        "fontSize": "30pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${@i18n.nbsp}",
        "fontSize": "4pt"
       },
       {
        "text": "${@i18n.unitDone}",
        "fontSize": "12pt",
        "typeface": "System-Bold",
        "textColor": "#6B7280|#8E939B"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${ok},1)]"
    },
    "react": [
     {
      "type": "richText",
      "x": "12pt",
      "y": "43pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "--",
        "fontSize": "30pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${@i18n.nbsp}",
        "fontSize": "4pt"
       },
       {
        "text": "${@i18n.unitDone}",
        "fontSize": "12pt",
        "typeface": "System-Bold",
        "textColor": "#6B7280|#8E939B"
       }
      ]
     }
    ]
   },
   {
    "type": "txt",
    "x": "12pt",
    "y": "72pt",
    "w": "{parent.w}-24pt",
    "h": "-1",
    "text": "${@i18n.near7}",
    "fontSize": "10.5pt",
    "textColor": "#6B7280|#8E939B",
    "maxLines": "1",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "forEach",
    "props": {
     "items": "${bars}",
     "key": "_it",
     "index": "_i"
    },
    "react": [
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${ok},1)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "12pt+${_it.i}*({parent.w}-24pt)/7+(({parent.w}-24pt)/7-10pt)/2",
        "y": "92pt+36pt*(1-${_it.f})",
        "w": "10pt",
        "h": "36pt*${_it.f}",
        "bgColor": "$[if::(eq::(${_it.t},1),if::(eq::(${theme},dark),#F06595,#D6336C),if::(eq::(${_it.z},1),if::(eq::(${theme},dark),#2C313A,#D6DAE1),if::(eq::(${theme},dark),#7A3D55,#F0A9C1)))]",
        "cornerRadius": {
         "leftT": "3pt",
         "leftB": "3pt",
         "rightT": "3pt",
         "rightB": "3pt"
        }
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),gt::(${stk},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "136pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.streak1}${stk}${@i18n.streak2}",
      "fontSize": "10.5pt",
      "textColor": "#D6336C|#F06595",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${stk},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "136pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "$[if::(gt::(${best},0),if::(eq::(${best},1),${@i18n.best1}${best}${@i18n.best2s},${@i18n.best1}${best}${@i18n.best2}),${@i18n.noStreak})]",
      "fontSize": "10.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${ok},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "104pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "$[if::(ne::(${any},1),${@i18n.none},${@i18n.stale})]",
      "fontSize": "11.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}