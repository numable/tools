{
 "rc": {
  "_note": "日程(44):已逾期 + 今天起 7 天里有事的日子,日期头 + 当天各条(色条 = 清单色)。",
  "i18n": {
   "zh-CN": {
    "tAgenda": "日程",
    "none": "还没有待办",
    "stale": "数据未更新",
    "weekFree": "这一周很空",
    "hOver": "已逾期",
    "hToday": "今天",
    "hTmr": "明天"
   },
   "en-US": {
    "tAgenda": "Agenda",
    "none": "No to-dos yet",
    "stale": "Not up to date",
    "weekFree": "A quiet week",
    "hOver": "Overdue",
    "hToday": "Today",
    "hTmr": "Tomorrow"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "14pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "23pt",
    "y": "12pt",
    "w": "{parent.w}-37pt",
    "h": "-1",
    "text": "${@i18n.tAgenda}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "forEach",
    "props": {
     "items": "${ag}",
     "key": "_it",
     "index": "_i"
    },
    "react": [
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${ok},1)]"
      },
      "react": [
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[eq::(${_it.h},1)]"
        },
        "react": [
         {
          "type": "txt",
          "x": "14pt",
          "y": "40pt+${_it.i}*34pt+12pt",
          "w": "{parent.w}-68pt",
          "h": "-1",
          "text": "$[if::(eq::(${_it.dk},1),${@i18n.hOver},if::(eq::(${_it.dk},2),${@i18n.hToday},if::(eq::(${_it.dk},3),${@i18n.hTmr},if::(startsWith::(${@app.language},zh),${_it.wdz} · ${_it.mdz},${_it.wde} · ${_it.mde}))))]",
          "fontSize": "11.5pt",
          "textColor": "$[if::(eq::(${_it.dk},1),if::(eq::(${theme},dark),#FF6369,#E5484D),if::(eq::(${_it.dk},2),if::(eq::(${theme},dark),#F06595,#D6336C),if::(eq::(${theme},dark),#8E939B,#6B7280)))]",
          "maxLines": "1",
          "typeface": "System-Bold",
          "lineBreak": "0"
         },
         {
          "type": "txt",
          "x": "{parent.w}-54pt",
          "y": "40pt+${_it.i}*34pt+12.5pt",
          "w": "40pt",
          "h": "-1",
          "text": "${_it.n}",
          "fontSize": "11pt",
          "textColor": "#6B7280|#8E939B",
          "maxLines": "1",
          "alignmentH": "2",
          "lineBreak": "0"
         },
         {
          "type": "layer",
          "x": "14pt",
          "y": "40pt+${_it.i}*34pt+33pt",
          "w": "{parent.w}-28pt",
          "h": "0.5pt",
          "bgColor": "#D6DAE1|#2C313A"
         }
        ]
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[eq::(${_it.h},0)]"
        },
        "react": [
         {
          "type": "layer",
          "x": "16pt",
          "y": "40pt+${_it.i}*34pt+8.0pt",
          "w": "3pt",
          "h": "18pt",
          "bgColor": "${_it.c}",
          "cornerRadius": {
           "leftT": "1.5pt",
           "leftB": "1.5pt",
           "rightT": "1.5pt",
           "rightB": "1.5pt"
          }
         },
         {
          "type": "txt",
          "x": "28pt",
          "y": "40pt+${_it.i}*34pt+11.0pt",
          "w": "{parent.w}-92pt",
          "h": "-1",
          "text": "${_it.t}",
          "fontSize": "13pt",
          "textColor": "#0E1116|#F3F4F6",
          "maxLines": "1",
          "lineBreak": "0"
         },
         {
          "type": "txt",
          "x": "{parent.w}-64pt",
          "y": "40pt+${_it.i}*34pt+13.3pt",
          "w": "50pt",
          "h": "-1",
          "text": "${_it.tm}",
          "fontSize": "11.5pt",
          "textColor": "#6B7280|#8E939B",
          "maxLines": "1",
          "alignmentH": "2",
          "lineBreak": "0"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(length::(${ag}),0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "{parent.h}*0.44",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.weekFree}",
      "fontSize": "13pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${ok},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "{parent.h}*0.44",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "$[if::(ne::(${any},1),${@i18n.none},${@i18n.stale})]",
      "fontSize": "13pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "1",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}