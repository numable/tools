{
 "rc": {
  "_note": "待办清单(42):3 行单行制。",
  "i18n": {
   "zh-CN": {
    "tToday": "今天",
    "tAll": "全部待办",
    "tOver": "已逾期",
    "tDoing": "进行中",
    "tStar": "高优先级",
    "tNodate": "没有日期",
    "tInbox": "收件箱",
    "tFocus": "待办",
    "tGone": "清单已删除",
    "today": "今天",
    "tmr": "明天",
    "none": "还没有待办",
    "empty": "这里没有待办",
    "free": "今天没有要做的事",
    "more1": "还有 ",
    "more2": " 件",
    "addHint": "添加待办",
    "open": " 件待办",
    "od1": "逾期 ",
    "od2": " 天"
   },
   "en-US": {
    "tToday": "Today",
    "tAll": "All to-dos",
    "tOver": "Overdue",
    "tDoing": "In progress",
    "tStar": "High priority",
    "tNodate": "No date",
    "tInbox": "Inbox",
    "tFocus": "To-do",
    "tGone": "List deleted",
    "today": "Today",
    "tmr": "Tomorrow",
    "none": "No to-dos yet",
    "empty": "Nothing here",
    "free": "Nothing due today",
    "more1": "+",
    "more2": " more",
    "addHint": "Add a to-do",
    "open": " open",
    "od1": "",
    "od2": "d overdue"
   }
  },
  "i18nEmptyOk": [
   "od1"
  ],
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "14pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "23pt",
    "y": "12pt",
    "w": "{parent.w}-140pt",
    "h": "-1",
    "text": "$[if::(eq::(${isLG},1),if::(eq::(${gone},1),${@i18n.tGone},if::(eq::(${isG},1),#,)),if::(eq::(${sc},today),${@i18n.tToday},if::(eq::(${sc},over),${@i18n.tOver},if::(eq::(${sc},doing),${@i18n.tDoing},if::(eq::(${sc},star),${@i18n.tStar},if::(eq::(${sc},nodate),${@i18n.tNodate},if::(eq::(${sc},inbox),${@i18n.tInbox},if::(eq::(findNotEmpty::(${sc},__none__),__none__),${@i18n.tFocus},${@i18n.tAll}))))))))]${sname}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${hn},1),gt::(${n},0))]"
    },
    "react": [
     {
      "id": "hr",
      "type": "txt",
      "x": "14pt",
      "y": "13.5pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "$[if::(gt::(${n},3),${@i18n.more1}calc::(${n}-3)${@i18n.more2},${n}${@i18n.open})]",
      "fontSize": "11pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "2",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "forEach",
    "props": {
     "items": "${rows}",
     "key": "_it",
     "index": "_i"
    },
    "react": [
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[and::(le::(${_it.dm},${lim}),lt::(${_it.i},3))]"
      },
      "react": [
       {
        "type": "layer",
        "x": "14pt",
        "y": "40pt+${_it.i}*36pt+10.5pt",
        "w": "15pt",
        "h": "15pt",
        "borderColor": "${_it.pc}",
        "borderWidth": "1.6pt",
        "cornerRadius": {
         "leftT": "7.5pt",
         "leftB": "7.5pt",
         "rightT": "7.5pt",
         "rightB": "7.5pt"
        }
       },
       {
        "type": "txt",
        "x": "{parent.w}-88pt",
        "y": "40pt+${_it.i}*36pt+14.3pt",
        "w": "74pt",
        "h": "-1",
        "text": "$[if::(eq::(${_it.hdm},0),,if::(lt::(round::(calc::((${_it.dm}-${tdm})/86400000)),0),${@i18n.od1}round::(calc::((${tdm}-${_it.dm})/86400000))${@i18n.od2},if::(eq::(round::(calc::((${_it.dm}-${tdm})/86400000)),0),if::(eq::(${_it.htm},1),${_it.tm},${@i18n.today}),if::(eq::(round::(calc::((${_it.dm}-${tdm})/86400000)),1),${@i18n.tmr},if::(lt::(round::(calc::((${_it.dm}-${tdm})/86400000)),7),if::(startsWith::(${@app.language},zh),${_it.wdz},${_it.wde}),if::(startsWith::(${@app.language},zh),${_it.mdz},${_it.mde}))))))]",
        "fontSize": "11pt",
        "textColor": "$[if::(eq::(${_it.hdm},0),if::(eq::(${theme},dark),#8E939B,#6B7280),if::(lt::(round::(calc::((${_it.dm}-${tdm})/86400000)),0),if::(eq::(${theme},dark),#FF6369,#E5484D),if::(eq::(round::(calc::((${_it.dm}-${tdm})/86400000)),0),if::(eq::(${theme},dark),#F06595,#D6336C),if::(eq::(${theme},dark),#8E939B,#6B7280))))]",
        "maxLines": "1",
        "alignmentH": "2",
        "lineBreak": "0"
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[eq::(${_it.hic},1)]"
        },
        "react": [
         {
          "type": "layer",
          "x": "37pt",
          "y": "40pt+${_it.i}*36pt+7.0pt",
          "w": "22pt",
          "h": "22pt",
          "bgColor": "${_it.cw}",
          "cornerRadius": {
           "leftT": "6pt",
           "leftB": "6pt",
           "rightT": "6pt",
           "rightB": "6pt"
          }
         },
         {
          "type": "path",
          "x": "41.5pt",
          "y": "40pt+${_it.i}*36pt+11.5pt",
          "w": "13pt",
          "h": "13pt",
          "d": "$[get::(${ic},${_it.ic})]",
          "viewBox": "0 0 256 256",
          "scaleType": "fitCenter",
          "fillColor": "${_it.c}"
         },
         {
          "type": "txt",
          "x": "67pt",
          "y": "40pt+${_it.i}*36pt+12.0pt",
          "w": "{parent.w}-161pt",
          "h": "-1",
          "text": "${_it.t}",
          "fontSize": "13pt",
          "textColor": "#0E1116|#F3F4F6",
          "maxLines": "1",
          "lineBreak": "0"
         }
        ]
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[eq::(${_it.hic},0)]"
        },
        "react": [
         {
          "type": "txt",
          "x": "37pt",
          "y": "40pt+${_it.i}*36pt+12.0pt",
          "w": "{parent.w}-131pt",
          "h": "-1",
          "text": "${_it.t}",
          "fontSize": "13pt",
          "textColor": "#0E1116|#F3F4F6",
          "maxLines": "1",
          "lineBreak": "0"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${any},1),eq::(${hn},1),eq::(${n},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "{parent.h}*0.5",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "$[if::(eq::(${sc},today),${@i18n.free},${@i18n.empty})]",
      "fontSize": "13pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${any},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "64pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.none}",
      "fontSize": "13pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "14pt",
      "y": "84pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.addHint}",
      "fontSize": "11pt",
      "textColor": "#D6336C|#F06595",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}