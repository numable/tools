{
 "rc": {
  "_note": "今天(22):还剩几件(含逾期)+ 一句结论 + 下一件。",
  "i18n": {
   "zh-CN": {
    "nbsp": " ",
    "tToday": "今天",
    "today": "今天",
    "tmr": "明天",
    "unitLeft": "件待办",
    "none": "还没有待办",
    "stale": "数据未更新",
    "allDone": "今天的都做完了",
    "free": "今天没有要做的事",
    "overN1": "其中 ",
    "overN2": " 件已逾期",
    "doneN1": "已完成 ",
    "doneN2": " 件",
    "addHint": "添加待办",
    "od1": "逾期 ",
    "od2": " 天"
   },
   "en-US": {
    "nbsp": " ",
    "tToday": "Today",
    "today": "Today",
    "tmr": "Tomorrow",
    "unitLeft": "left",
    "none": "No to-dos yet",
    "stale": "Not up to date",
    "allDone": "All done for today",
    "free": "Nothing due today",
    "overN1": "",
    "overN2": " overdue",
    "doneN1": "",
    "doneN2": " done",
    "addHint": "Add a to-do",
    "od1": "",
    "od2": "d overdue"
   }
  },
  "i18nEmptyOk": [
   "doneN1",
   "od1",
   "overN1"
  ],
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "12pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "21pt",
    "y": "11pt",
    "w": "{parent.w}-33pt",
    "h": "-1",
    "text": "${@i18n.tToday}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[eq::(${ok},1)]"
    },
    "react": [
     {
      "type": "richText",
      "x": "12pt",
      "y": "36pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "${rem}",
        "fontSize": "34pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${@i18n.nbsp}",
        "fontSize": "5pt"
       },
       {
        "text": "${@i18n.unitLeft}",
        "fontSize": "12pt",
        "typeface": "System-Bold",
        "textColor": "#6B7280|#8E939B"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${ok},1)]"
    },
    "react": [
     {
      "type": "richText",
      "x": "12pt",
      "y": "46.2pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "--",
        "fontSize": "34pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${@i18n.nbsp}",
        "fontSize": "5pt"
       },
       {
        "text": "${@i18n.unitLeft}",
        "fontSize": "12pt",
        "typeface": "System-Bold",
        "textColor": "#6B7280|#8E939B"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${any},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "80pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.none}",
      "fontSize": "11.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${any},1),ne::(${ok},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "80pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.stale}",
      "fontSize": "11.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${rem},0),gt::(${doneT},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "80pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.allDone}",
      "fontSize": "11.5pt",
      "textColor": "#2E9E6B|#45C793",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${rem},0),eq::(${doneT},0),eq::(${any},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "80pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.free}",
      "fontSize": "11.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),gt::(${ovr},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "80pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.overN1}${ovr}${@i18n.overN2}",
      "fontSize": "11.5pt",
      "textColor": "#E5484D|#FF6369",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),gt::(${rem},0),eq::(${ovr},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "80pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.doneN1}${doneT}${@i18n.doneN2}",
      "fontSize": "11.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[or::(ne::(${ok},1),eq::(${rem},0))]"
    },
    "react": [
     {
      "type": "layer",
      "x": "12pt",
      "y": "104pt",
      "w": "{parent.w}-24pt",
      "h": "42pt",
      "bgColor": "#EEF0F4|#252930",
      "cornerRadius": {
       "leftT": "12pt",
       "leftB": "12pt",
       "rightT": "12pt",
       "rightB": "12pt"
      }
     },
     {
      "type": "txt",
      "x": "22pt",
      "y": "120pt",
      "w": "{parent.w}-44pt",
      "h": "-1",
      "text": "+ ${@i18n.addHint}",
      "fontSize": "12pt",
      "textColor": "#D6336C|#F06595",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "forEach",
    "props": {
     "items": "${rows}",
     "key": "_it",
     "index": "_i"
    },
    "react": [
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[and::(eq::(${_it.i},0),le::(${_it.dm},${tdm}),eq::(${ok},1))]"
      },
      "react": [
       {
        "type": "layer",
        "x": "12pt",
        "y": "104pt",
        "w": "{parent.w}-24pt",
        "h": "42pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
         "leftT": "12pt",
         "leftB": "12pt",
         "rightT": "12pt",
         "rightB": "12pt"
        }
       },
       {
        "type": "txt",
        "x": "22pt",
        "y": "111pt",
        "w": "{parent.w}-44pt",
        "h": "-1",
        "text": "$[if::(eq::(${_it.hdm},0),,if::(lt::(round::(calc::((${_it.dm}-${tdm})/86400000)),0),${@i18n.od1}round::(calc::((${tdm}-${_it.dm})/86400000))${@i18n.od2},if::(eq::(round::(calc::((${_it.dm}-${tdm})/86400000)),0),if::(eq::(${_it.htm},1),${_it.tm},${@i18n.today}),if::(eq::(round::(calc::((${_it.dm}-${tdm})/86400000)),1),${@i18n.tmr},if::(lt::(round::(calc::((${_it.dm}-${tdm})/86400000)),7),if::(startsWith::(${@app.language},zh),${_it.wdz},${_it.wde}),if::(startsWith::(${@app.language},zh),${_it.mdz},${_it.mde}))))))]",
        "fontSize": "10pt",
        "textColor": "$[if::(eq::(${_it.hdm},0),if::(eq::(${theme},dark),#8E939B,#6B7280),if::(lt::(round::(calc::((${_it.dm}-${tdm})/86400000)),0),if::(eq::(${theme},dark),#FF6369,#E5484D),if::(eq::(round::(calc::((${_it.dm}-${tdm})/86400000)),0),if::(eq::(${theme},dark),#F06595,#D6336C),if::(eq::(${theme},dark),#8E939B,#6B7280))))]",
        "maxLines": "1",
        "lineBreak": "0"
       },
       {
        "type": "txt",
        "x": "22pt",
        "y": "126pt",
        "w": "{parent.w}-44pt",
        "h": "-1",
        "text": "${_it.t}",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
       }
      ]
     }
    ]
   }
  ]
 }
}