{
 "rc": {
  "_note": "逾期(11):几件已过截止日;0 件时写「✓ 没有逾期」。",
  "i18n": {
   "zh-CN": {
    "tOverdue": "逾期",
    "ovrU": "件逾期",
    "noOvr": "没有逾期"
   },
   "en-US": {
    "tOverdue": "Overdue",
    "ovrU": "overdue",
    "noOvr": "All on time"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "8pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "17pt",
    "y": "7pt",
    "w": "43pt",
    "h": "-1",
    "text": "${@i18n.tOverdue}",
    "fontSize": "10pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),gt::(${ovr},0))]"
    },
    "react": [
     {
      "id": "num",
      "type": "txt",
      "x": "8pt",
      "y": "22pt",
      "w": "54pt",
      "h": "-1",
      "text": "${ovr}",
      "fontSize": "20pt",
      "textColor": "#E5484D|#FF6369",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${@i18n.ovrU}",
      "fontSize": "9pt",
      "textColor": "#E5484D|#FF6369",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${ovr},0))]"
    },
    "react": [
     {
      "id": "chk",
      "type": "txt",
      "x": "8pt",
      "y": "22pt",
      "w": "54pt",
      "h": "-1",
      "text": "✓",
      "fontSize": "20pt",
      "textColor": "#2E9E6B|#45C793",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${@i18n.noOvr}",
      "fontSize": "9pt",
      "textColor": "#2E9E6B|#45C793",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${ok},1)]"
    },
    "react": [
     {
      "id": "numE",
      "type": "txt",
      "x": "8pt",
      "y": "28pt",
      "w": "54pt",
      "h": "-1",
      "text": "--",
      "fontSize": "20pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${@i18n.ovrU}",
      "fontSize": "9pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}