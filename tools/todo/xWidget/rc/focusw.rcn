{
 "rc": {
  "_note": "单件待办(42):图标 + 标题 + 清单 · 步骤 · 标签 / 截止 / 进度条 / 最新备注。",
  "i18n": {
   "zh-CN": {
    "tFocus": "待办",
    "today": "今天",
    "tmr": "明天",
    "empty": "这里没有待办",
    "pickOne": "还没选待办",
    "pickHint": "长按选一件",
    "doneTag": "已完成",
    "steps": "步骤",
    "lastNote": "最新备注",
    "od1": "逾期 ",
    "od2": " 天"
   },
   "en-US": {
    "tFocus": "To-do",
    "today": "Today",
    "tmr": "Tomorrow",
    "empty": "Nothing here",
    "pickOne": "No to-do picked",
    "pickHint": "Long-press to pick one",
    "doneTag": "Done",
    "steps": "Steps",
    "lastNote": "Latest note",
    "od1": "",
    "od2": "d overdue"
   }
  },
  "i18nEmptyOk": [
   "od1"
  ],
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[eq::(${has},1)]"
    },
    "react": [
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.hic},1)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "14pt",
        "y": "14pt",
        "w": "36pt",
        "h": "36pt",
        "bgColor": "${f.cw}",
        "cornerRadius": {
         "leftT": "10pt",
         "leftB": "10pt",
         "rightT": "10pt",
         "rightB": "10pt"
        }
       },
       {
        "type": "path",
        "x": "22pt",
        "y": "22pt",
        "w": "20pt",
        "h": "20pt",
        "d": "$[get::(${ic},${f.ic})]",
        "viewBox": "0 0 256 256",
        "scaleType": "fitCenter",
        "fillColor": "${f.c}"
       }
      ]
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.hic},0)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "14pt",
        "y": "14pt",
        "w": "36pt",
        "h": "36pt",
        "bgColor": "${f.cw}",
        "cornerRadius": {
         "leftT": "10pt",
         "leftB": "10pt",
         "rightT": "10pt",
         "rightB": "10pt"
        }
       },
       {
        "type": "layer",
        "x": "26pt",
        "y": "26pt",
        "w": "12pt",
        "h": "12pt",
        "bgColor": "${f.c}",
        "cornerRadius": {
         "leftT": "6pt",
         "leftB": "6pt",
         "rightT": "6pt",
         "rightB": "6pt"
        }
       }
      ]
     },
     {
      "type": "txt",
      "x": "60pt",
      "y": "16pt",
      "w": "{parent.w}-144pt",
      "h": "-1",
      "text": "${f.t}",
      "fontSize": "15pt",
      "textColor": "$[if::(eq::(${f.st},1),if::(eq::(${theme},dark),#8E939B,#6B7280),if::(eq::(${theme},dark),#F3F4F6,#0E1116))]",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "60pt",
      "y": "37pt",
      "w": "{parent.w}-144pt",
      "h": "-1",
      "text": "${f.meta}",
      "fontSize": "11pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "{parent.w}-84pt",
      "y": "19.5pt",
      "w": "70pt",
      "h": "-1",
      "text": "$[if::(eq::(${f.hdm},0),,if::(lt::(round::(calc::((${f.dm}-${tdm})/86400000)),0),${@i18n.od1}round::(calc::((${tdm}-${f.dm})/86400000))${@i18n.od2},if::(eq::(round::(calc::((${f.dm}-${tdm})/86400000)),0),if::(eq::(${f.htm},1),${f.tm},${@i18n.today}),if::(eq::(round::(calc::((${f.dm}-${tdm})/86400000)),1),${@i18n.tmr},if::(lt::(round::(calc::((${f.dm}-${tdm})/86400000)),7),if::(startsWith::(${@app.language},zh),${f.wdz},${f.wde}),if::(startsWith::(${@app.language},zh),${f.mdz},${f.mde}))))))]",
      "fontSize": "11.5pt",
      "textColor": "$[if::(eq::(${f.hdm},0),if::(eq::(${theme},dark),#8E939B,#6B7280),if::(lt::(round::(calc::((${f.dm}-${tdm})/86400000)),0),if::(eq::(${theme},dark),#FF6369,#E5484D),if::(eq::(round::(calc::((${f.dm}-${tdm})/86400000)),0),if::(eq::(${theme},dark),#F06595,#D6336C),if::(eq::(${theme},dark),#8E939B,#6B7280))))]",
      "maxLines": "1",
      "alignmentH": "2",
      "lineBreak": "0",
      "typeface": "System-Bold"
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.st},0)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "14pt",
        "y": "66pt",
        "w": "{parent.w}-74pt",
        "h": "6pt",
        "bgColor": "#D6DAE1|#2C313A",
        "cornerRadius": {
         "leftT": "3pt",
         "leftB": "3pt",
         "rightT": "3pt",
         "rightB": "3pt"
        }
       },
       {
        "type": "layer",
        "x": "14pt",
        "y": "66pt",
        "w": "({parent.w}-74pt)*${f.pgf}",
        "h": "6pt",
        "bgColor": "${f.c}",
        "cornerRadius": {
         "leftT": "3pt",
         "leftB": "3pt",
         "rightT": "3pt",
         "rightB": "3pt"
        }
       },
       {
        "type": "txt",
        "x": "{parent.w}-54pt",
        "y": "64.5pt",
        "w": "40pt",
        "h": "-1",
        "text": "${f.pg}%",
        "fontSize": "12pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "alignmentH": "2",
        "lineBreak": "0"
       }
      ]
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.st},1)]"
      },
      "react": [
       {
        "type": "txt",
        "x": "14pt",
        "y": "62pt",
        "w": "{parent.w}-28pt",
        "h": "-1",
        "text": "${@i18n.doneTag}",
        "fontSize": "12pt",
        "textColor": "#2E9E6B|#45C793",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
       }
      ]
     },
     {
      "type": "layer",
      "x": "14pt",
      "y": "86pt",
      "w": "{parent.w}-28pt",
      "h": "58pt",
      "bgColor": "#E7E9EE|#20232A",
      "cornerRadius": {
       "leftT": "12pt",
       "leftB": "12pt",
       "rightT": "12pt",
       "rightB": "12pt"
      }
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.hnote},1)]"
      },
      "react": [
       {
        "type": "txt",
        "x": "24pt",
        "y": "94pt",
        "w": "{parent.w}-48pt",
        "h": "-1",
        "text": "${@i18n.lastNote} · ${f.nn}",
        "fontSize": "10pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
       },
       {
        "type": "txt",
        "x": "24pt",
        "y": "110pt",
        "w": "{parent.w}-48pt",
        "h": "-1",
        "text": "${f.note}",
        "fontSize": "12pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "2",
        "lineBreak": "0"
       }
      ]
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${f.hnote},0)]"
      },
      "react": [
       {
        "type": "txt",
        "x": "24pt",
        "y": "109.5pt",
        "w": "{parent.w}-48pt",
        "h": "-1",
        "text": "$[if::(gt::(${f.sn},0),${@i18n.steps} ${f.sd}/${f.sn},${@i18n.tFocus})]",
        "fontSize": "12pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${has},1)]"
    },
    "react": [
     {
      "type": "layer",
      "x": "14pt",
      "y": "14pt",
      "w": "36pt",
      "h": "36pt",
      "bgColor": "#EEF0F4|#252930",
      "cornerRadius": {
       "leftT": "10pt",
       "leftB": "10pt",
       "rightT": "10pt",
       "rightB": "10pt"
      }
     },
     {
      "type": "txt",
      "x": "60pt",
      "y": "16pt",
      "w": "{parent.w}-74pt",
      "h": "-1",
      "text": "$[if::(eq::(${picked},1),${@i18n.empty},${@i18n.pickOne})]",
      "fontSize": "15pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "60pt",
      "y": "37pt",
      "w": "{parent.w}-74pt",
      "h": "-1",
      "text": "${@i18n.pickHint}",
      "fontSize": "11pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     },
     {
      "type": "layer",
      "x": "14pt",
      "y": "66pt",
      "w": "{parent.w}-74pt",
      "h": "6pt",
      "bgColor": "#D6DAE1|#2C313A",
      "cornerRadius": {
       "leftT": "3pt",
       "leftB": "3pt",
       "rightT": "3pt",
       "rightB": "3pt"
      }
     },
     {
      "type": "layer",
      "x": "14pt",
      "y": "86pt",
      "w": "{parent.w}-28pt",
      "h": "58pt",
      "bgColor": "#EEF0F4|#252930",
      "cornerRadius": {
       "leftT": "12pt",
       "leftB": "12pt",
       "rightT": "12pt",
       "rightB": "12pt"
      }
     }
    ]
   }
  ]
 }
}