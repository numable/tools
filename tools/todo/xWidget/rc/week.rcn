{
 "rc": {
  "_note": "未来 7 天(42):每天到期几件(未完成),今天那列有源色淡底。",
  "i18n": {
   "zh-CN": {
    "tWeek": "未来 7 天",
    "none": "还没有待办",
    "stale": "数据未更新",
    "weekSum2": " 件到期",
    "weekFree": "这一周很空"
   },
   "en-US": {
    "tWeek": "Next 7 days",
    "none": "No to-dos yet",
    "stale": "Not up to date",
    "weekSum2": " due",
    "weekFree": "A quiet week"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "14pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "23pt",
    "y": "12pt",
    "w": "{parent.w}-133pt",
    "h": "-1",
    "text": "${@i18n.tWeek}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "id": "hr",
    "type": "txt",
    "x": "14pt",
    "y": "13.5pt",
    "w": "{parent.w}-28pt",
    "h": "-1",
    "text": "$[if::(eq::(${ok},1),if::(gt::(${wkN},0),${wkN}${@i18n.weekSum2},${@i18n.weekFree}),)]",
    "fontSize": "11pt",
    "textColor": "#6B7280|#8E939B",
    "maxLines": "1",
    "alignmentH": "2",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "forEach",
    "props": {
     "items": "${wk}",
     "key": "_it",
     "index": "_i"
    },
    "react": [
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${ok},1)]"
      },
      "react": [
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[eq::(${_it.t},1)]"
        },
        "react": [
         {
          "type": "layer",
          "x": "14pt+${_it.i}*({parent.w}-28pt)/7",
          "y": "36pt",
          "w": "({parent.w}-28pt)/7",
          "h": "112pt",
          "bgColor": "#D6336C|#F06595",
          "cornerRadius": {
           "leftT": "12pt",
           "leftB": "12pt",
           "rightT": "12pt",
           "rightB": "12pt"
          },
          "alpha": "0.10"
         }
        ]
       },
       {
        "type": "txt",
        "x": "14pt+${_it.i}*({parent.w}-28pt)/7",
        "y": "44pt",
        "w": "({parent.w}-28pt)/7",
        "h": "-1",
        "text": "$[if::(startsWith::(${@app.language},zh),${_it.wdz},${_it.wde})]",
        "fontSize": "10.5pt",
        "textColor": "$[if::(eq::(${_it.t},1),if::(eq::(${theme},dark),#F06595,#D6336C),if::(eq::(${theme},dark),#8E939B,#6B7280))]",
        "maxLines": "1",
        "alignmentH": "1",
        "lineBreak": "0"
       },
       {
        "type": "txt",
        "x": "14pt+${_it.i}*({parent.w}-28pt)/7",
        "y": "60pt",
        "w": "({parent.w}-28pt)/7",
        "h": "-1",
        "text": "${_it.da}",
        "fontSize": "15pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "alignmentH": "1",
        "lineBreak": "0"
       },
       {
        "type": "layer",
        "x": "14pt+${_it.i}*({parent.w}-28pt)/7+(({parent.w}-28pt)/7-6pt)/2",
        "y": "84pt",
        "w": "6pt",
        "h": "44pt",
        "bgColor": "#D6DAE1|#2C313A",
        "cornerRadius": {
         "leftT": "3pt",
         "leftB": "3pt",
         "rightT": "3pt",
         "rightB": "3pt"
        }
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[eq::(${_it.hn},1)]"
        },
        "react": [
         {
          "type": "layer",
          "x": "14pt+${_it.i}*({parent.w}-28pt)/7+(({parent.w}-28pt)/7-6pt)/2",
          "y": "84pt+44pt*(1-${_it.f})",
          "w": "6pt",
          "h": "44pt*${_it.f}",
          "bgColor": "$[if::(eq::(${_it.t},1),if::(eq::(${theme},dark),#F06595,#D6336C),if::(eq::(${theme},dark),#7A3D55,#F0A9C1))]",
          "cornerRadius": {
           "leftT": "3pt",
           "leftB": "3pt",
           "rightT": "3pt",
           "rightB": "3pt"
          }
         }
        ]
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[eq::(${_it.hn},1)]"
        },
        "react": [
         {
          "type": "txt",
          "x": "14pt+${_it.i}*({parent.w}-28pt)/7",
          "y": "133pt",
          "w": "({parent.w}-28pt)/7",
          "h": "-1",
          "text": "${_it.n}",
          "fontSize": "10.5pt",
          "textColor": "#0E1116|#F3F4F6",
          "maxLines": "1",
          "typeface": "System-Bold",
          "alignmentH": "1",
          "lineBreak": "0"
         }
        ]
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[ne::(${_it.hn},1)]"
        },
        "react": [
         {
          "type": "txt",
          "x": "14pt+${_it.i}*({parent.w}-28pt)/7",
          "y": "136.1pt",
          "w": "({parent.w}-28pt)/7",
          "h": "-1",
          "text": "·",
          "fontSize": "10.5pt",
          "textColor": "#6B7280|#8E939B",
          "maxLines": "1",
          "typeface": "System-Bold",
          "alignmentH": "1",
          "lineBreak": "0"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${ok},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "49pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "$[if::(ne::(${any},1),${@i18n.none},${@i18n.stale})]",
      "fontSize": "13pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "1",
      "lineBreak": "0"
     },
     {
      "type": "layer",
      "x": "14pt+0*({parent.w}-28pt)/7+(({parent.w}-28pt)/7-6pt)/2",
      "y": "84pt",
      "w": "6pt",
      "h": "44pt",
      "bgColor": "#D6DAE1|#2C313A",
      "cornerRadius": {
       "leftT": "3pt",
       "leftB": "3pt",
       "rightT": "3pt",
       "rightB": "3pt"
      }
     },
     {
      "type": "layer",
      "x": "14pt+1*({parent.w}-28pt)/7+(({parent.w}-28pt)/7-6pt)/2",
      "y": "84pt",
      "w": "6pt",
      "h": "44pt",
      "bgColor": "#D6DAE1|#2C313A",
      "cornerRadius": {
       "leftT": "3pt",
       "leftB": "3pt",
       "rightT": "3pt",
       "rightB": "3pt"
      }
     },
     {
      "type": "layer",
      "x": "14pt+2*({parent.w}-28pt)/7+(({parent.w}-28pt)/7-6pt)/2",
      "y": "84pt",
      "w": "6pt",
      "h": "44pt",
      "bgColor": "#D6DAE1|#2C313A",
      "cornerRadius": {
       "leftT": "3pt",
       "leftB": "3pt",
       "rightT": "3pt",
       "rightB": "3pt"
      }
     },
     {
      "type": "layer",
      "x": "14pt+3*({parent.w}-28pt)/7+(({parent.w}-28pt)/7-6pt)/2",
      "y": "84pt",
      "w": "6pt",
      "h": "44pt",
      "bgColor": "#D6DAE1|#2C313A",
      "cornerRadius": {
       "leftT": "3pt",
       "leftB": "3pt",
       "rightT": "3pt",
       "rightB": "3pt"
      }
     },
     {
      "type": "layer",
      "x": "14pt+4*({parent.w}-28pt)/7+(({parent.w}-28pt)/7-6pt)/2",
      "y": "84pt",
      "w": "6pt",
      "h": "44pt",
      "bgColor": "#D6DAE1|#2C313A",
      "cornerRadius": {
       "leftT": "3pt",
       "leftB": "3pt",
       "rightT": "3pt",
       "rightB": "3pt"
      }
     },
     {
      "type": "layer",
      "x": "14pt+5*({parent.w}-28pt)/7+(({parent.w}-28pt)/7-6pt)/2",
      "y": "84pt",
      "w": "6pt",
      "h": "44pt",
      "bgColor": "#D6DAE1|#2C313A",
      "cornerRadius": {
       "leftT": "3pt",
       "leftB": "3pt",
       "rightT": "3pt",
       "rightB": "3pt"
      }
     },
     {
      "type": "layer",
      "x": "14pt+6*({parent.w}-28pt)/7+(({parent.w}-28pt)/7-6pt)/2",
      "y": "84pt",
      "w": "6pt",
      "h": "44pt",
      "bgColor": "#D6DAE1|#2C313A",
      "cornerRadius": {
       "leftT": "3pt",
       "leftB": "3pt",
       "rightT": "3pt",
       "rightB": "3pt"
      }
     }
    ]
   }
  ]
 }
}