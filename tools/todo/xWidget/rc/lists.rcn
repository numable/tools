   {
    "type": "op",
    "action": "forEach",
    "props": {
     "items": "${tiles}",
     "key": "_it",
     "index": "_i"
    },
    "react": [
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${_it.i},0)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "14pt",
        "y": "40pt",
        "w": "({parent.w}-36pt)/2",
        "h": "94pt",
        "bgColor": "${_it.cw}",
        "cornerRadius": {
         "leftT": "12pt",
         "leftB": "12pt",
         "rightT": "12pt",
         "rightB": "12pt"
        }
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[eq::(${_it.hic},1)]"
        },
        "react": [
         {
          "type": "path",
          "x": "14pt+10pt",
          "y": "50pt",
          "w": "20pt",
          "h": "20pt",
          "d": "$[get::(${ic},${_it.ic})]",
          "viewBox": "0 0 256 256",
          "scaleType": "fitCenter",
          "fillColor": "${_it.c}"
         }
        ]
       },
