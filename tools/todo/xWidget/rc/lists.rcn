{
 "rc": {
  "_note": "清单(44):收件箱 + 各清单,每格 = 图标 / 名字 / 未完成件数 / 完成比例条。",
  "i18n": {
   "zh-CN": {
    "nbsp": " ",
    "tInbox": "收件箱",
    "tLists": "清单",
    "none": "还没有待办",
    "addHint": "添加待办",
    "open": " 件待办",
    "openU": "件待办",
    "newList": "点开新建清单"
   },
   "en-US": {
    "nbsp": " ",
    "tInbox": "Inbox",
    "tLists": "Lists",
    "none": "No to-dos yet",
    "addHint": "Add a to-do",
    "open": " open",
    "openU": "open",
    "newList": "Tap to add a list"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "14pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "23pt",
    "y": "12pt",
    "w": "{parent.w}-133pt",
    "h": "-1",
    "text": "${@i18n.tLists}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "id": "hr",
    "type": "txt",
    "x": "14pt",
    "y": "13.5pt",
    "w": "{parent.w}-28pt",
    "h": "-1",
    "text": "$[if::(gt::(${nOpen},0),${nOpen}${@i18n.open},)]",
    "fontSize": "11pt",
    "textColor": "#6B7280|#8E939B",
    "maxLines": "1",
    "alignmentH": "2",
    "lineBreak": "0"
   },
   {
    "type": "layer",
    "x": "14pt",
    "y": "40pt",
