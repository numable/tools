{
 "rc": {
  "_note": "待办清单(44):按 scope 显示最多 6 行,两行制(标题 / 清单 · 步骤 · 标签 + 进度条),右侧日期标签相对今天现算。",
  "i18n": {
   "zh-CN": {
    "tToday": "今天",
    "tAll": "全部待办",
    "tOver": "已逾期",
    "tDoing": "进行中",
    "tStar": "高优先级",
    "tNodate": "没有日期",
    "tInbox": "收件箱",
    "tFocus": "待办",
    "tGone": "清单已删除",
    "today": "今天",
    "tmr": "明天",
    "none": "还没有待办",
    "empty": "这里没有待办",
    "free": "今天没有要做的事",
    "more1": "还有 ",
    "more2": " 件",
    "addHint": "添加待办",
    "open": " 件待办",
    "od1": "逾期 ",
    "od2": " 天"
   },
   "en-US": {
    "tToday": "Today",
    "tAll": "All to-dos",
    "tOver": "Overdue",
    "tDoing": "In progress",
    "tStar": "High priority",
    "tNodate": "No date",
    "tInbox": "Inbox",
    "tFocus": "To-do",
    "tGone": "List deleted",
    "today": "Today",
    "tmr": "Tomorrow",
    "none": "No to-dos yet",
    "empty": "Nothing here",
    "free": "Nothing due today",
    "more1": "+",
    "more2": " more",
    "addHint": "Add a to-do",
    "open": " open",
    "od1": "",
    "od2": "d overdue"
   }
  },
  "i18nEmptyOk": [
   "od1"
  ],
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FEFBFC\\,#FCF3F6)@90|linear(#15171A\\,#1B191D\\,#251D23)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "14pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#D6336C|#F06595",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "23pt",
    "y": "12pt",
    "w": "{parent.w}-140pt",
    "h": "-1",
    "text": "$[if::(eq::(${isLG},1),if::(eq::(${gone},1),${@i18n.tGone},if::(eq::(${isG},1),#,)),if::(eq::(${sc},today),${@i18n.tToday},if::(eq::(${sc},over),${@i18n.tOver},if::(eq::(${sc},doing),${@i18n.tDoing},if::(eq::(${sc},star),${@i18n.tStar},if::(eq::(${sc},nodate),${@i18n.tNodate},if::(eq::(${sc},inbox),${@i18n.tInbox},if::(eq::(findNotEmpty::(${sc},__none__),__none__),${@i18n.tFocus},${@i18n.tAll}))))))))]${sname}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${hn},1),gt::(${n},0))]"
    },
    "react": [
     {
      "id": "hr",
      "type": "txt",
      "x": "14pt",
      "y": "13.5pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${n}${@i18n.open}",
      "fontSize": "11pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "2",
      "lineBreak": "0"
     }
    ]
   },
