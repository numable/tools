{
  "version": 2,
  "title": "今天 · 宽",
  "sub": "完成环 + 今天的前 3 件",
  "i18n": {
    "en-US": {
      "title": "Today · wide",
      "sub": "Progress ring + next 3"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "今天的完成环,加今天要做的前 3 件待办"
  },
  "events": {
    "onClick": "numable://self/page/view?f=today"
  },
  "_note_jobs": "长按组件 →「添加提醒」列出这两条(doc/alert-design.md §6 ③)。两条都没有参数映射:每日提醒的时间由用户在面板里填,到点提醒是包级单实例。",
  "jobs": [
    {
      "id": "daily",
      "params": {}
    },
    {
      "id": "due",
      "params": {}
    }
  ],
  "canvas": {
    "source": "@[file://rc/todayw.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/list.df]",
        "params": {
          "scope": "today"
        }
      }
    ],
    "refresh": {
      "_note": "数据只在两件事上变:① 用户在页面里改了(页面写完会主动刷新本包组件);② 跨过零点(今天 / 逾期 / 七日窗口挪一格)。所以半小时一拍足够;零点那一拍由 at 钉住,不等下一个半小时。",
      "interval": [
        "1800"
      ],
      "at": [
        "00:01"
      ]
    }
  }
}