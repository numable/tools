{
  "version": 2,
  "title": "添加待办",
  "sub": "一点就记一件",
  "i18n": {
    "en-US": {
      "title": "Add to-do",
      "sub": "Tap to jot one down"
    }
  },
  "layout": 21,
  "params": {},
  "ai": {
    "shows": "添加待办的快捷入口,附今天还有几件待办;点一下直接新增"
  },
  "events": {
    "onClick": "numable://self/page/add"
  },
  "canvas": {
    "source": "@[file://rc/add.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/day.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "数据只在两件事上变:① 用户在页面里改了(页面写完会主动刷新本包组件);② 跨过零点(今天 / 逾期 / 七日窗口挪一格)。所以半小时一拍足够;零点那一拍由 at 钉住,不等下一个半小时。",
      "interval": [
        "1800"
      ],
      "at": [
        "00:01"
      ]
    }
  }
}