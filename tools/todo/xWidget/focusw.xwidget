{
  "version": 2,
  "title": "一件待办 · 宽",
  "sub": "进度 + 截止 + 最新备注",
  "i18n": {
    "en-US": {
      "title": "One to-do · wide",
      "sub": "Progress, due date, latest note"
    }
  },
  "layout": 42,
  "params": {
    "id": ""
  },
  "ai": {
    "shows": "盯住的一件待办:进度、截止日期、步骤与最新一条备注",
    "params": {
      "id": {
        "kind": "user",
        "hint": "用户某一件待办的 id;留空时组件显示「还没选待办 · 长按选一件」"
      }
    }
  },
  "events": {
    "onClick": "numable://self/page/item?id=${id}",
    "onEdit": "/pick"
  },
  "_note_jobs": "长按组件 →「添加提醒」列出这两条(doc/alert-design.md §6 ③)。两条都没有参数映射:每日提醒的时间由用户在面板里填,到点提醒是包级单实例。",
  "jobs": [
    {
      "id": "daily",
      "params": {}
    },
    {
      "id": "due",
      "params": {}
    }
  ],
  "canvas": {
    "source": "@[file://rc/focusw.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/focus.df]",
        "params": {
          "id": "${id}"
        }
      }
    ],
    "refresh": {
      "_note": "数据只在两件事上变:① 用户在页面里改了(页面写完会主动刷新本包组件);② 跨过零点(今天 / 逾期 / 七日窗口挪一格)。所以半小时一拍足够;零点那一拍由 at 钉住,不等下一个半小时。",
      "interval": [
        "1800"
      ],
      "at": [
        "00:01"
      ]
    }
  }
}