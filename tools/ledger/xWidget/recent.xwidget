{
  "version": 2,
  "title": "最近记账",
  "sub": "最近 6 笔",
  "i18n": {
    "en-US": {
      "title": "Recent entries",
      "sub": "Your last 6 entries"
    }
  },
  "layout": 44,
  "params": {},
  "ai": {
    "shows": "最近记的 6 笔账:分类、备注、日期与金额(收入以 + 标出),右上角是本月支出"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/recent.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/main.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络,数据只在两件事上变:① 用户在页面里记 / 改 / 删(页面写完会主动刷新本包组件);② 跨过零点(今天归零、近 30 天挪一格、月初换月)。所以半小时一拍足够;零点那一拍由 at 钉住。",
      "interval": [
        "1800"
      ],
      "at": [
        "00:01"
      ]
    }
  }
}