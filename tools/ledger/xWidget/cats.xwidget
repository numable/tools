{
  "version": 2,
  "title": "分类占比",
  "sub": "本月钱花在哪",
  "i18n": {
    "en-US": {
      "title": "By category",
      "sub": "Where this month's money went"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "本月支出按分类(餐饮、交通、住房等)的占比分段条,以及前几个分类的金额与百分比"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/cats.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/main.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络,数据只在两件事上变:① 用户在页面里记 / 改 / 删(页面写完会主动刷新本包组件);② 跨过零点(今天归零、近 30 天挪一格、月初换月)。所以半小时一拍足够;零点那一拍由 at 钉住。",
      "interval": [
        "1800"
      ],
      "at": [
        "00:01"
      ]
    }
  }
}