{
  "version": 2,
  "title": "本月支出 · 迷你",
  "sub": "金额 + 预算百分比",
  "i18n": {
    "en-US": {
      "title": "Spent this month · mini",
      "sub": "Total + budget used"
    }
  },
  "layout": 21,
  "params": {},
  "ai": {
    "shows": "本月一共花了多少,右侧是预算用了百分之几(没设预算时显示本月几笔)"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/month21.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/main.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络,数据只在两件事上变:① 用户在页面里记 / 改 / 删(页面写完会主动刷新本包组件);② 跨过零点(今天归零、近 30 天挪一格、月初换月)。所以半小时一拍足够;零点那一拍由 at 钉住。",
      "interval": [
        "1800"
      ],
      "at": [
        "00:01"
      ]
    }
  }
}