{
  "version": 2,
  "title": "近 30 天",
  "sub": "每天花了多少",
  "i18n": {
    "en-US": {
      "title": "Last 30 days",
      "sub": "Spending by day"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "近 30 天每天支出的柱状图,以及这 30 天的日均与合计"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/daily.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/main.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络,数据只在两件事上变:① 用户在页面里记 / 改 / 删(页面写完会主动刷新本包组件);② 跨过零点(今天归零、近 30 天挪一格、月初换月)。所以半小时一拍足够;零点那一拍由 at 钉住。",
      "interval": [
        "1800"
      ],
      "at": [
        "00:01"
      ]
    }
  }
}