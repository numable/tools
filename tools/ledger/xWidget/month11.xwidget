{
  "version": 2,
  "title": "本月支出 · 小",
  "sub": "压缩金额 + 预算",
  "i18n": {
    "en-US": {
      "title": "Spent this month · tiny",
      "sub": "Compact total + budget"
    }
  },
  "layout": 11,
  "params": {},
  "ai": {
    "shows": "本月花了多少(压缩写法,如 1.2万 / 12K),底行是预算用了百分之几"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/month11.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/main.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络,数据只在两件事上变:① 用户在页面里记 / 改 / 删(页面写完会主动刷新本包组件);② 跨过零点(今天归零、近 30 天挪一格、月初换月)。所以半小时一拍足够;零点那一拍由 at 钉住。",
      "interval": [
        "1800"
      ],
      "at": [
        "00:01"
      ]
    }
  }
}