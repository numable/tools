{
 "rc": {
  "_note": "分类占比(42):本月支出按分类的分段条 + 前 4 格图例(第 4 格起合成「其他」)。",
  "i18n": {
   "zh-CN": {
    "tCats": "分类占比",
    "none": "还没有记账",
    "stale": "数据未更新",
    "hintFirst": "点开记下第一笔",
    "hintAdd": "点开记账",
    "monthNone": "本月还没有支出"
   },
   "en-US": {
    "tCats": "By category",
    "none": "Nothing recorded yet",
    "stale": "Not up to date",
    "hintFirst": "Tap to add one",
    "hintAdd": "Tap to add",
    "monthNone": "No spending this month"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FBFCF9\\,#F3F6ED)@90|linear(#15171A\\,#181A1B\\,#1C211D)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "14pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#5C8A0A|#A6D65A",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "23pt",
    "y": "12pt",
    "w": "{parent.w}-195pt",
    "h": "-1",
    "text": "${@i18n.tCats}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "id": "hr",
    "type": "txt",
    "x": "{parent.w}-164pt",
    "y": "13.5pt",
    "w": "150pt",
    "h": "-1",
    "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]${mt}",
    "fontSize": "11pt",
    "textColor": "#6B7280|#8E939B",
    "maxLines": "1",
    "alignmentH": "2",
    "lineBreak": "0"
   },
   {
    "type": "layer",
    "x": "14pt",
    "y": "40pt",
    "w": "{parent.w}-28pt",
    "h": "10pt",
    "bgColor": "#E7E9EE|#20232A",
    "cornerRadius": {
     "leftT": "4pt",
     "leftB": "4pt",
     "rightT": "4pt",
     "rightB": "4pt"
    }
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),gt::(${catN},0))]"
    },
    "react": [
     {
      "type": "op",
      "action": "forEach",
      "props": {
       "items": "${cat}",
       "key": "_it",
       "index": "_i"
      },
      "react": [
       {
        "type": "layer",
        "x": "14pt+({parent.w}-28pt)*${_it.x}",
        "y": "40pt",
        "w": "({parent.w}-28pt)*${_it.g}",
        "h": "10pt",
        "bgColor": "${_it.c}",
        "cornerRadius": {
         "leftT": "2pt",
         "leftB": "2pt",
         "rightT": "2pt",
         "rightB": "2pt"
        }
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${any},1))]"
    },
    "react": [
     {
      "type": "op",
      "action": "forEach",
      "props": {
       "items": "${cat}",
       "key": "_it",
       "index": "_i"
      },
      "react": [
       {
        "type": "layer",
        "x": "14pt+${_it.cx}*(({parent.w}-36pt)/2+8pt)",
        "y": "62pt+${_it.ry}*46pt+0pt",
        "w": "({parent.w}-36pt)/2",
        "h": "40pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
         "leftT": "12pt",
         "leftB": "12pt",
         "rightT": "12pt",
         "rightB": "12pt"
        }
       },
       {
        "type": "layer",
        "x": "14pt+${_it.cx}*(({parent.w}-36pt)/2+8pt)+8pt",
        "y": "62pt+${_it.ry}*46pt+7pt",
        "w": "26pt",
        "h": "26pt",
        "bgColor": "${_it.cw}",
        "cornerRadius": {
         "leftT": "8pt",
         "leftB": "8pt",
         "rightT": "8pt",
         "rightB": "8pt"
        }
       },
       {
        "type": "path",
        "x": "14pt+${_it.cx}*(({parent.w}-36pt)/2+8pt)+13pt",
        "y": "62pt+${_it.ry}*46pt+12pt",
        "w": "16pt",
        "h": "16pt",
        "d": "$[get::(${ic},${_it.ic})]",
        "viewBox": "0 0 256 256",
        "scaleType": "fitCenter",
        "fillColor": "${_it.c}"
       },
       {
        "type": "txt",
        "x": "14pt+${_it.cx}*(({parent.w}-36pt)/2+8pt)+42pt",
        "y": "62pt+${_it.ry}*46pt+6pt",
        "w": "({parent.w}-36pt)/2-92pt",
        "h": "-1",
        "text": "$[if::(startsWith::(${@app.language},zh),${_it.nz},${_it.ne})]",
        "fontSize": "12pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
       },
       {
        "type": "txt",
        "x": "14pt+${_it.cx}*(({parent.w}-36pt)/2+8pt)+({parent.w}-36pt)/2-50pt",
        "y": "62pt+${_it.ry}*46pt+7pt",
        "w": "40pt",
        "h": "-1",
        "text": "${_it.p}%",
        "fontSize": "11pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "typeface": "System-Bold",
        "alignmentH": "2",
        "lineBreak": "0"
       },
       {
        "type": "txt",
        "x": "14pt+${_it.cx}*(({parent.w}-36pt)/2+8pt)+42pt",
        "y": "62pt+${_it.ry}*46pt+23pt",
        "w": "({parent.w}-36pt)/2-52pt",
        "h": "-1",
        "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]${_it.a}",
        "fontSize": "10.5pt",
        "textColor": "#6B7280|#8E939B",
        "maxLines": "1",
        "lineBreak": "0"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${catN},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "74pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.monthNone}",
      "fontSize": "12pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "14pt",
      "y": "92pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.hintAdd}",
      "fontSize": "11pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${any},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "74pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.none}",
      "fontSize": "12pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "14pt",
      "y": "92pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.hintFirst}",
      "fontSize": "11pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${any},1),ne::(${ok},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "74pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.stale}",
      "fontSize": "12pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}