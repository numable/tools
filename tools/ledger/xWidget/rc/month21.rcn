{
 "rc": {
  "_note": "本月支出(21):金额 + 右侧预算百分比与细进度条(没设预算写本月几笔)。",
  "i18n": {
   "zh-CN": {
    "tMonth": "本月支出",
    "hintAdd": "点开记账",
    "nRecU": " 笔",
    "nRec1u": " 笔"
   },
   "en-US": {
    "tMonth": "Spent this month",
    "hintAdd": "Tap to add",
    "nRecU": " entries",
    "nRec1u": " entry"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FBFCF9\\,#F3F6ED)@90|linear(#15171A\\,#181A1B\\,#1C211D)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "10pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#5C8A0A|#A6D65A",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "19pt",
    "y": "9pt",
    "w": "{parent.w}-29pt",
    "h": "-1",
    "text": "${@i18n.tMonth}",
    "fontSize": "11pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${mtF2},0))]"
    },
    "react": [
     {
      "type": "richText",
      "x": "10pt",
      "y": "29pt",
      "w": "78pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${mtB}",
        "fontSize": "16.5pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${mtF2},1))]"
    },
    "react": [
     {
      "type": "richText",
      "x": "10pt",
      "y": "31.5pt",
      "w": "78pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]",
        "fontSize": "9.5pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${mtB}",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${mtF2},2))]"
    },
    "react": [
     {
      "type": "richText",
      "x": "10pt",
      "y": "29pt",
      "w": "78pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "$[if::(startsWith::(${@app.language},zh),${mcz},${mce})]",
        "fontSize": "16.5pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[or::(ne::(${ok},1),ne::(${any},1))]"
    },
    "react": [
     {
      "id": "numE",
      "type": "txt",
      "x": "10pt",
      "y": "34pt",
      "w": "78pt",
      "h": "-1",
      "text": "--",
      "fontSize": "16.5pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${bud},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "90pt",
      "y": "28pt",
      "w": "58pt",
      "h": "-1",
      "text": "${bpc}%",
      "fontSize": "10pt",
      "textColor": "$[if::(eq::(${bst},3),if::(eq::(${theme},dark),#FF6369,#E5484D),if::(eq::(${bst},2),if::(eq::(${theme},dark),#F5C23B,#B37A00),if::(eq::(${theme},dark),#A6D65A,#5C8A0A)))]",
      "maxLines": "1",
      "typeface": "System-Bold",
      "alignmentH": "2",
      "lineBreak": "0"
     },
     {
      "type": "layer",
      "x": "90pt",
      "y": "45pt",
      "w": "58pt",
      "h": "4pt",
      "bgColor": "#D6DAE1|#2C313A",
      "cornerRadius": {
       "leftT": "2pt",
       "leftB": "2pt",
       "rightT": "2pt",
       "rightB": "2pt"
      }
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${ex},1)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "90pt",
        "y": "45pt",
        "w": "58pt*${bp}",
        "h": "4pt",
        "bgColor": "$[if::(eq::(${bst},3),if::(eq::(${theme},dark),#FF6369,#E5484D),if::(eq::(${bst},2),if::(eq::(${theme},dark),#F5C23B,#B37A00),if::(eq::(${theme},dark),#A6D65A,#5C8A0A)))]",
        "cornerRadius": {
         "leftT": "2pt",
         "leftB": "2pt",
         "rightT": "2pt",
         "rightB": "2pt"
        }
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),ne::(${bud},1),ne::(${n},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "90pt",
      "y": "34pt",
      "w": "58pt",
      "h": "-1",
      "text": "${n}${@i18n.nRecU}",
      "fontSize": "10pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "2",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),ne::(${bud},1),eq::(${n},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "90pt",
      "y": "34pt",
      "w": "58pt",
      "h": "-1",
      "text": "${n}${@i18n.nRec1u}",
      "fontSize": "10pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "2",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${any},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "90pt",
      "y": "34pt",
      "w": "58pt",
      "h": "-1",
      "text": "${@i18n.hintAdd}",
      "fontSize": "10pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "2",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}