{
 "rc": {
  "_note": "最近记账(44):最近 6 笔(分类图标 / 备注或分类 / 日期 / 金额,收入绿色带 +);不满 6 笔的槽位留浅底。",
  "i18n": {
   "zh-CN": {
    "tRecent": "最近记账",
    "none": "还没有记账",
    "hintFirst": "点开记下第一笔",
    "today": "今天",
    "yday": "昨天",
    "monthP": "本月 ",
    "sep": " · ",
    "plus": "+"
   },
   "en-US": {
    "tRecent": "Recent entries",
    "none": "Nothing recorded yet",
    "hintFirst": "Tap to add one",
    "today": "Today",
    "yday": "Yesterday",
    "monthP": "This month ",
    "sep": " · ",
    "plus": "+"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FBFCF9\\,#F3F6ED)@90|linear(#15171A\\,#181A1B\\,#1C211D)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "14pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#5C8A0A|#A6D65A",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "23pt",
    "y": "12pt",
    "w": "{parent.w}-195pt",
    "h": "-1",
    "text": "${@i18n.tRecent}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${any},1))]"
    },
    "react": [
     {
      "id": "hr",
      "type": "txt",
      "x": "{parent.w}-164pt",
      "y": "13.5pt",
      "w": "150pt",
      "h": "-1",
      "text": "${@i18n.monthP}$[if::(startsWith::(${@app.language},zh),${cz},${ce})]${mt}",
      "fontSize": "11pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "2",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "layer",
    "x": "14pt",
    "y": "36pt",
    "w": "{parent.w}-28pt",
    "h": "44pt",
    "bgColor": "#EEF0F4|#252930",
    "cornerRadius": {
     "leftT": "12pt",
     "leftB": "12pt",
     "rightT": "12pt",
     "rightB": "12pt"
    }
   },
   {
    "type": "layer",
    "x": "14pt",
    "y": "84pt",
    "w": "{parent.w}-28pt",
    "h": "44pt",
    "bgColor": "#EEF0F4|#252930",
    "cornerRadius": {
     "leftT": "12pt",
     "leftB": "12pt",
     "rightT": "12pt",
     "rightB": "12pt"
    }
   },
   {
    "type": "layer",
    "x": "14pt",
    "y": "132pt",
    "w": "{parent.w}-28pt",
    "h": "44pt",
    "bgColor": "#EEF0F4|#252930",
    "cornerRadius": {
     "leftT": "12pt",
     "leftB": "12pt",
     "rightT": "12pt",
     "rightB": "12pt"
    }
   },
   {
    "type": "layer",
    "x": "14pt",
    "y": "180pt",
    "w": "{parent.w}-28pt",
    "h": "44pt",
    "bgColor": "#EEF0F4|#252930",
    "cornerRadius": {
     "leftT": "12pt",
     "leftB": "12pt",
     "rightT": "12pt",
     "rightB": "12pt"
    }
   },
   {
    "type": "layer",
    "x": "14pt",
    "y": "228pt",
    "w": "{parent.w}-28pt",
    "h": "44pt",
    "bgColor": "#EEF0F4|#252930",
    "cornerRadius": {
     "leftT": "12pt",
     "leftB": "12pt",
     "rightT": "12pt",
     "rightB": "12pt"
    }
   },
   {
    "type": "layer",
    "x": "14pt",
    "y": "276pt",
    "w": "{parent.w}-28pt",
    "h": "44pt",
    "bgColor": "#EEF0F4|#252930",
    "cornerRadius": {
     "leftT": "12pt",
     "leftB": "12pt",
     "rightT": "12pt",
     "rightB": "12pt"
    }
   },
   {
    "type": "op",
    "action": "forEach",
    "props": {
     "items": "${rec}",
     "key": "_it",
     "index": "_i"
    },
    "react": [
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[lt::(${_it.i},6)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "14pt",
        "y": "36pt+${_it.i}*48pt+0pt",
        "w": "{parent.w}-28pt",
        "h": "44pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
         "leftT": "12pt",
         "leftB": "12pt",
         "rightT": "12pt",
         "rightB": "12pt"
        }
       },
       {
        "type": "layer",
        "x": "22pt",
        "y": "36pt+${_it.i}*48pt+8pt",
        "w": "28pt",
        "h": "28pt",
        "bgColor": "${_it.cw}",
        "cornerRadius": {
         "leftT": "9pt",
         "leftB": "9pt",
         "rightT": "9pt",
         "rightB": "9pt"
        }
       },
       {
        "type": "path",
        "x": "28pt",
        "y": "36pt+${_it.i}*48pt+14pt",
        "w": "16pt",
        "h": "16pt",
        "d": "$[get::(${ic},${_it.ic})]",
        "viewBox": "0 0 256 256",
        "scaleType": "fitCenter",
        "fillColor": "${_it.c}"
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[eq::(${_it.hn},1)]"
        },
        "react": [
         {
          "type": "txt",
          "x": "58pt",
          "y": "36pt+${_it.i}*48pt+7pt",
          "w": "{parent.w}-184pt",
          "h": "-1",
          "text": "${_it.nt}",
          "fontSize": "13pt",
          "textColor": "#0E1116|#F3F4F6",
          "maxLines": "1",
          "typeface": "System-Bold",
          "lineBreak": "0"
         },
         {
          "type": "txt",
          "x": "58pt",
          "y": "36pt+${_it.i}*48pt+25pt",
          "w": "{parent.w}-184pt",
          "h": "-1",
          "text": "$[if::(startsWith::(${@app.language},zh),${_it.nz},${_it.ne})]${@i18n.sep}$[if::(le::(round::(calc::((${tdm}-${_it.dm})/86400000)),0),${@i18n.today},if::(eq::(round::(calc::((${tdm}-${_it.dm})/86400000)),1),${@i18n.yday},if::(lt::(round::(calc::((${tdm}-${_it.dm})/86400000)),7),if::(startsWith::(${@app.language},zh),${_it.wdz},${_it.wde}),if::(startsWith::(${@app.language},zh),${_it.mdz},${_it.mde}))))]",
          "fontSize": "10.5pt",
          "textColor": "#6B7280|#8E939B",
          "maxLines": "1",
          "lineBreak": "0"
         }
        ]
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[ne::(${_it.hn},1)]"
        },
        "react": [
         {
          "type": "txt",
          "x": "58pt",
          "y": "36pt+${_it.i}*48pt+7pt",
          "w": "{parent.w}-184pt",
          "h": "-1",
          "text": "$[if::(startsWith::(${@app.language},zh),${_it.nz},${_it.ne})]",
          "fontSize": "13pt",
          "textColor": "#0E1116|#F3F4F6",
          "maxLines": "1",
          "typeface": "System-Bold",
          "lineBreak": "0"
         },
         {
          "type": "txt",
          "x": "58pt",
          "y": "36pt+${_it.i}*48pt+25pt",
          "w": "{parent.w}-184pt",
          "h": "-1",
          "text": "$[if::(le::(round::(calc::((${tdm}-${_it.dm})/86400000)),0),${@i18n.today},if::(eq::(round::(calc::((${tdm}-${_it.dm})/86400000)),1),${@i18n.yday},if::(lt::(round::(calc::((${tdm}-${_it.dm})/86400000)),7),if::(startsWith::(${@app.language},zh),${_it.wdz},${_it.wde}),if::(startsWith::(${@app.language},zh),${_it.mdz},${_it.mde}))))]",
          "fontSize": "10.5pt",
          "textColor": "#6B7280|#8E939B",
          "maxLines": "1",
          "lineBreak": "0"
         }
        ]
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[ne::(${_it.inc},1)]"
        },
        "react": [
         {
          "type": "txt",
          "x": "{parent.w}-130pt",
          "y": "36pt+${_it.i}*48pt+14pt",
          "w": "106pt",
          "h": "-1",
          "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]${_it.a}",
          "fontSize": "13.5pt",
          "textColor": "#0E1116|#F3F4F6",
          "maxLines": "1",
          "typeface": "System-Bold",
          "alignmentH": "2",
          "lineBreak": "0"
         }
        ]
       },
       {
        "type": "op",
        "action": "if",
        "props": {
         "val": "$[eq::(${_it.inc},1)]"
        },
        "react": [
         {
          "type": "txt",
          "x": "{parent.w}-130pt",
          "y": "36pt+${_it.i}*48pt+14pt",
          "w": "106pt",
          "h": "-1",
          "text": "${@i18n.plus}$[if::(startsWith::(${@app.language},zh),${cz},${ce})]${_it.a}",
          "fontSize": "13.5pt",
          "textColor": "#2E9E6B|#45C793",
          "maxLines": "1",
          "typeface": "System-Bold",
          "alignmentH": "2",
          "lineBreak": "0"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${any},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "138pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.none}",
      "fontSize": "12.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "alignmentH": "1",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "14pt",
      "y": "157pt",
      "w": "{parent.w}-28pt",
      "h": "-1",
      "text": "${@i18n.hintFirst}",
      "fontSize": "11pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "1",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}