{
 "rc": {
  "_note": "记一笔(21):点开就是记账面板;第二行是今天已经花了多少。",
  "i18n": {
   "zh-CN": {
    "tAdd": "记一笔",
    "stale": "数据未更新",
    "hintAdd": "点开记账",
    "spentToday": "今天已花",
    "none11": "还没有记账"
   },
   "en-US": {
    "tAdd": "Add entry",
    "stale": "Not up to date",
    "hintAdd": "Tap to add",
    "spentToday": "today",
    "none11": "No entries"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FBFCF9\\,#F3F6ED)@90|linear(#15171A\\,#181A1B\\,#1C211D)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "10pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#5C8A0A|#A6D65A",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "19pt",
    "y": "9pt",
    "w": "{parent.w}-29pt",
    "h": "-1",
    "text": "${@i18n.tAdd}",
    "fontSize": "11pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${any},1))]"
    },
    "react": [
     {
      "type": "richText",
      "x": "10pt",
      "y": "30pt",
      "w": "92pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]",
        "fontSize": "11pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${td}",
        "fontSize": "16pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       }
      ]
     },
     {
      "type": "txt",
      "x": "{parent.w}-60pt",
      "y": "34pt",
      "w": "50pt",
      "h": "-1",
      "text": "${@i18n.spentToday}",
      "fontSize": "10pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "2",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${any},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "10pt",
      "y": "33pt",
      "w": "76pt",
      "h": "-1",
      "text": "${@i18n.none11}",
      "fontSize": "10.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "{parent.w}-68pt",
      "y": "34pt",
      "w": "58pt",
      "h": "-1",
      "text": "${@i18n.hintAdd}",
      "fontSize": "10pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "2",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${any},1),ne::(${ok},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "10pt",
      "y": "33pt",
      "w": "{parent.w}-20pt",
      "h": "-1",
      "text": "${@i18n.stale}",
      "fontSize": "10.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}