{
 "rc": {
  "_note": "本月支出(22):大数字 + 预算进度(用了多少 / 还剩或超出)或日均;底行今天花了多少。",
  "i18n": {
   "zh-CN": {
    "tMonth": "本月支出",
    "none": "还没有记账",
    "stale": "数据未更新",
    "hintFirst": "点开记下第一笔",
    "used": "已用 ",
    "pct": "%",
    "budget": "预算 ",
    "left": "还剩 ",
    "over": "超出 ",
    "avg": "日均 ",
    "nRec1": "本月 ",
    "nRec2": " 笔",
    "todayP": "今天 ",
    "todayNone": "今天还没记账"
   },
   "en-US": {
    "tMonth": "Spent this month",
    "none": "Nothing recorded yet",
    "stale": "Not up to date",
    "hintFirst": "Tap to add one",
    "used": "",
    "pct": "% used",
    "budget": "of ",
    "left": "Left: ",
    "over": "Over by ",
    "avg": "Avg ",
    "nRec1": "",
    "nRec2": " entries this month",
    "todayP": "Today ",
    "todayNone": "Nothing yet today"
   }
  },
  "i18nEmptyOk": [
   "nRec1",
   "used"
  ],
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FBFCF9\\,#F3F6ED)@90|linear(#15171A\\,#181A1B\\,#1C211D)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "12pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#5C8A0A|#A6D65A",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "21pt",
    "y": "11pt",
    "w": "{parent.w}-33pt",
    "h": "-1",
    "text": "${@i18n.tMonth}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${mtF},0))]"
    },
    "react": [
     {
      "type": "richText",
      "x": "12pt",
      "y": "34.0pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]",
        "fontSize": "18pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${mtB}",
        "fontSize": "30pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${mtF},1))]"
    },
    "react": [
     {
      "type": "richText",
      "x": "12pt",
      "y": "38.3pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]",
        "fontSize": "15pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${mtB}",
        "fontSize": "24pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${mtF},2))]"
    },
    "react": [
     {
      "type": "richText",
      "x": "12pt",
      "y": "41.2pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${mtB}",
        "fontSize": "20pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[or::(ne::(${ok},1),ne::(${any},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "43.0pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "--",
      "fontSize": "30pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${bud},1))]"
    },
    "react": [
     {
      "type": "layer",
      "x": "12pt",
      "y": "70pt",
      "w": "{parent.w}-24pt",
      "h": "6pt",
      "bgColor": "#D6DAE1|#2C313A",
      "cornerRadius": {
       "leftT": "3pt",
       "leftB": "3pt",
       "rightT": "3pt",
       "rightB": "3pt"
      }
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${ex},1)]"
      },
      "react": [
       {
        "type": "layer",
        "x": "12pt",
        "y": "70pt",
        "w": "({parent.w}-24pt)*${bp}",
        "h": "6pt",
        "bgColor": "$[if::(eq::(${bst},3),if::(eq::(${theme},dark),#FF6369,#E5484D),if::(eq::(${bst},2),if::(eq::(${theme},dark),#F5C23B,#B37A00),if::(eq::(${theme},dark),#A6D65A,#5C8A0A)))]",
        "cornerRadius": {
         "leftT": "3pt",
         "leftB": "3pt",
         "rightT": "3pt",
         "rightB": "3pt"
        }
       }
      ]
     },
     {
      "type": "txt",
      "x": "12pt",
      "y": "83pt",
      "w": "60pt",
      "h": "-1",
      "text": "${@i18n.used}${bpc}${@i18n.pct}",
      "fontSize": "10.5pt",
      "textColor": "$[if::(eq::(${bst},3),if::(eq::(${theme},dark),#FF6369,#E5484D),if::(eq::(${bst},2),if::(eq::(${theme},dark),#F5C23B,#B37A00),if::(eq::(${theme},dark),#A6D65A,#5C8A0A)))]",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "{parent.w}-86pt",
      "y": "83.5pt",
      "w": "74pt",
      "h": "-1",
      "text": "${@i18n.budget}$[if::(startsWith::(${@app.language},zh),${cz},${ce})]${budS}",
      "fontSize": "10pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "2",
      "lineBreak": "0"
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[ne::(${bst},3)]"
      },
      "react": [
       {
        "type": "txt",
        "x": "12pt",
        "y": "104pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${@i18n.left}$[if::(startsWith::(${@app.language},zh),${cz},${ce})]${brm}",
        "fontSize": "12.5pt",
        "textColor": "#0E1116|#F3F4F6",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
       }
      ]
     },
     {
      "type": "op",
      "action": "if",
      "props": {
       "val": "$[eq::(${bst},3)]"
      },
      "react": [
       {
        "type": "txt",
        "x": "12pt",
        "y": "104pt",
        "w": "{parent.w}-24pt",
        "h": "-1",
        "text": "${@i18n.over}$[if::(startsWith::(${@app.language},zh),${cz},${ce})]${brm}",
        "fontSize": "12.5pt",
        "textColor": "#E5484D|#FF6369",
        "maxLines": "1",
        "typeface": "System-Bold",
        "lineBreak": "0"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),ne::(${bud},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "74pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.avg}$[if::(startsWith::(${@app.language},zh),${cz},${ce})]${avg}",
      "fontSize": "12.5pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "12pt",
      "y": "93pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.nRec1}${n}${@i18n.nRec2}",
      "fontSize": "10.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),gt::(${tdn},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "134pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.todayP}$[if::(startsWith::(${@app.language},zh),${cz},${ce})]${td}",
      "fontSize": "10.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${tdn},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "134pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.todayNone}",
      "fontSize": "10.5pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${any},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "80pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.none}",
      "fontSize": "12pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "12pt",
      "y": "98pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.hintFirst}",
      "fontSize": "11pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${any},1),ne::(${ok},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "12pt",
      "y": "80pt",
      "w": "{parent.w}-24pt",
      "h": "-1",
      "text": "${@i18n.stale}",
      "fontSize": "12pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}