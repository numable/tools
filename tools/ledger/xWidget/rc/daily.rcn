{
 "rc": {
  "_note": "近 30 天(42):日均 + 合计 + 每天支出的柱(今天实色,没花的天画一截桩)。",
  "i18n": {
   "zh-CN": {
    "tDaily": "近 30 天",
    "none": "还没有记账",
    "stale": "数据未更新",
    "hintFirst": "点开记下第一笔",
    "avgL": "日均",
    "sumL": "合计",
    "today": "今天"
   },
   "en-US": {
    "tDaily": "Last 30 days",
    "none": "Nothing recorded yet",
    "stale": "Not up to date",
    "hintFirst": "Tap to add one",
    "avgL": "Daily avg",
    "sumL": "Total",
    "today": "Today"
   }
  },
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FBFCF9\\,#F3F6ED)@90|linear(#15171A\\,#181A1B\\,#1C211D)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "14pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#5C8A0A|#A6D65A",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "23pt",
    "y": "12pt",
    "w": "{parent.w}-37pt",
    "h": "-1",
    "text": "${@i18n.tDaily}",
    "fontSize": "13pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "txt",
    "x": "14pt",
    "y": "40pt",
    "w": "96pt",
    "h": "-1",
    "text": "${@i18n.avgL}",
    "fontSize": "10.5pt",
    "textColor": "#6B7280|#8E939B",
    "maxLines": "1",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${any},1))]"
    },
    "react": [
     {
      "type": "richText",
      "x": "14pt",
      "y": "56pt",
      "w": "100pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]",
        "fontSize": "12pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${b30a}",
        "fontSize": "18pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[or::(ne::(${ok},1),ne::(${any},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "61.4pt",
      "w": "96pt",
      "h": "-1",
      "text": "--",
      "fontSize": "18pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "txt",
    "x": "14pt",
    "y": "92pt",
    "w": "96pt",
    "h": "-1",
    "text": "${@i18n.sumL}",
    "fontSize": "10.5pt",
    "textColor": "#6B7280|#8E939B",
    "maxLines": "1",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${any},1))]"
    },
    "react": [
     {
      "type": "richText",
      "x": "14pt",
      "y": "108pt",
      "w": "100pt",
      "h": "-1",
      "maxLines": "1",
      "spans": [
       {
        "text": "$[if::(startsWith::(${@app.language},zh),${cz},${ce})]",
        "fontSize": "10pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       },
       {
        "text": "${b30}",
        "fontSize": "14pt",
        "typeface": "System-Bold",
        "textColor": "#0E1116|#F3F4F6"
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[or::(ne::(${ok},1),ne::(${any},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "14pt",
      "y": "112.2pt",
      "w": "96pt",
      "h": "-1",
      "text": "--",
      "fontSize": "14pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "layer",
    "x": "{parent.w}-218pt",
    "y": "128pt",
    "w": "204pt",
    "h": "1pt",
    "bgColor": "#D6DAE1|#2C313A"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${any},1))]"
    },
    "react": [
     {
      "type": "op",
      "action": "forEach",
      "props": {
       "items": "${bars}",
       "key": "_it",
       "index": "_i"
      },
      "react": [
       {
        "type": "layer",
        "x": "{parent.w}-218pt+${_it.i}*6.8pt+1.2pt",
        "y": "36pt+92pt*(1-${_it.f})",
        "w": "4.4pt",
        "h": "92pt*${_it.f}",
        "bgColor": "$[if::(eq::(${_it.t},1),if::(eq::(${theme},dark),#A6D65A,#5C8A0A),if::(eq::(${_it.z},1),if::(eq::(${theme},dark),#2C313A,#D6DAE1),if::(eq::(${theme},dark),#4F6A2A,#B9D48C)))]",
        "cornerRadius": {
         "leftT": "1.5pt",
         "leftB": "1.5pt",
         "rightT": "1.5pt",
         "rightB": "1.5pt"
        }
       }
      ]
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${ok},1),eq::(${any},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "{parent.w}-218pt",
      "y": "134pt",
      "w": "100pt",
      "h": "-1",
      "text": "$[if::(startsWith::(${@app.language},zh),${b30z},${b30e})]",
      "fontSize": "9pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "{parent.w}-114pt",
      "y": "134pt",
      "w": "100pt",
      "h": "-1",
      "text": "${@i18n.today}",
      "fontSize": "9pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "alignmentH": "2",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[ne::(${any},1)]"
    },
    "react": [
     {
      "type": "txt",
      "x": "{parent.w}-218pt",
      "y": "70pt",
      "w": "204pt",
      "h": "-1",
      "text": "${@i18n.none}",
      "fontSize": "12pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     },
     {
      "type": "txt",
      "x": "{parent.w}-218pt",
      "y": "88pt",
      "w": "204pt",
      "h": "-1",
      "text": "${@i18n.hintFirst}",
      "fontSize": "11pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(eq::(${any},1),ne::(${ok},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "{parent.w}-218pt",
      "y": "70pt",
      "w": "204pt",
      "h": "-1",
      "text": "${@i18n.stale}",
      "fontSize": "12pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}