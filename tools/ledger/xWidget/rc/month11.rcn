{
 "rc": {
  "_note": "本月支出(11):压缩金额 + 底行预算百分比(没设预算写符号与笔数)。",
  "i18n": {
   "zh-CN": {
    "tMonth11": "本月",
    "hintAdd": "点开记账",
    "nRecU": " 笔",
    "nRec1u": " 笔",
    "b11": "预算 ",
    "b11s": "%"
   },
   "en-US": {
    "tMonth11": "Month",
    "hintAdd": "Tap to add",
    "nRecU": " entries",
    "nRec1u": " entry",
    "b11": "",
    "b11s": "% used"
   }
  },
  "i18nEmptyOk": [
   "b11"
  ],
  "cells": [
   {
    "id": "bg",
    "type": "layer",
    "x": "0pt",
    "y": "0pt",
    "w": "{parent.w}",
    "h": "{parent.h}",
    "bgColor": "linear(#FFFFFF\\,#FBFCF9\\,#F3F6ED)@90|linear(#15171A\\,#181A1B\\,#1C211D)@90"
   },
   {
    "id": "dot",
    "type": "layer",
    "x": "8pt",
    "y": "{ttl.y}+({ttl.h}-5pt)/2",
    "w": "5pt",
    "h": "5pt",
    "bgColor": "#5C8A0A|#A6D65A",
    "cornerRadius": {
     "leftT": "2.5pt",
     "leftB": "2.5pt",
     "rightT": "2.5pt",
     "rightB": "2.5pt"
    }
   },
   {
    "id": "ttl",
    "type": "txt",
    "x": "17pt",
    "y": "7pt",
    "w": "43pt",
    "h": "-1",
    "text": "${@i18n.tMonth11}",
    "fontSize": "10pt",
    "textColor": "#0E1116|#F3F4F6",
    "maxLines": "1",
    "typeface": "System-Bold",
    "lineBreak": "0"
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${mcF},0))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "22pt",
      "w": "54pt",
      "h": "-1",
      "text": "$[if::(startsWith::(${@app.language},zh),${mcz},${mce})]",
      "fontSize": "20pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${mcF},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "23.5pt",
      "w": "54pt",
      "h": "-1",
      "text": "$[if::(startsWith::(${@app.language},zh),${mcz},${mce})]",
      "fontSize": "17pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[or::(ne::(${ok},1),ne::(${any},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "28pt",
      "w": "54pt",
      "h": "-1",
      "text": "--",
      "fontSize": "20pt",
      "textColor": "#0E1116|#F3F4F6",
      "maxLines": "1",
      "typeface": "System-Bold",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),eq::(${bud},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${@i18n.b11}${bpc}${@i18n.b11s}",
      "fontSize": "9pt",
      "textColor": "$[if::(eq::(${bst},3),if::(eq::(${theme},dark),#FF6369,#E5484D),if::(eq::(${bst},2),if::(eq::(${theme},dark),#F5C23B,#B37A00),if::(eq::(${theme},dark),#A6D65A,#5C8A0A)))]",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),ne::(${bud},1),ne::(${n},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${n}${@i18n.nRecU}",
      "fontSize": "9pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[and::(and::(eq::(${ok},1),eq::(${any},1)),ne::(${bud},1),eq::(${n},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${n}${@i18n.nRec1u}",
      "fontSize": "9pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   },
   {
    "type": "op",
    "action": "if",
    "props": {
     "val": "$[or::(ne::(${ok},1),ne::(${any},1))]"
    },
    "react": [
     {
      "type": "txt",
      "x": "8pt",
      "y": "46pt",
      "w": "54pt",
      "h": "-1",
      "text": "${@i18n.hintAdd}",
      "fontSize": "9pt",
      "textColor": "#6B7280|#8E939B",
      "maxLines": "1",
      "lineBreak": "0"
     }
    ]
   }
  ]
 }
}