{
  "version": 2,
  "title": "记一笔",
  "sub": "一点就记账",
  "i18n": {
    "en-US": {
      "title": "Add entry",
      "sub": "Tap to log spending"
    }
  },
  "layout": 21,
  "params": {},
  "ai": {
    "shows": "记账的快捷入口,附今天已经花了多少;点一下直接打开记账面板"
  },
  "events": {
    "onClick": "numable://self/page/add"
  },
  "canvas": {
    "source": "@[file://rc/add.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/main.df]",
        "params": {}
      }
    ],
    "refresh": {
      "_note": "零网络,数据只在两件事上变:① 用户在页面里记 / 改 / 删(页面写完会主动刷新本包组件);② 跨过零点(今天归零、近 30 天挪一格、月初换月)。所以半小时一拍足够;零点那一拍由 at 钉住。",
      "interval": [
        "1800"
      ],
      "at": [
        "00:01"
      ]
    }
  }
}