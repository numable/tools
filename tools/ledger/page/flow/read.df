{
  "_note": "页面读整份原始数据。派生视图 w 不读 —— 那是写给组件的,页面每次都按原始数据重算。",
  "version": 1,
  "actions": [
    {
      "id": "recs",
      "action": "data.get",
      "params": {
        "key": "recs",
        "default": []
      }
    },
    {
      "id": "cfg",
      "action": "data.get",
      "params": {
        "key": "cfg",
        "default": {}
      }
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "recs",
          "cfg"
        ]
      }
    }
  ]
}
